<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Mirrors the app project's conditional TFM: a net10.0 test project cannot
         reference the net10.0-windows app assembly Windows builds produce. -->
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Headless UI harness (same version as the app's Avalonia pin): lets tests
         mount real views, run layout + the frame-clock scroll animations, and
         assert on geometry — used by the lyrics-panel overlap regression tests. -->
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <!-- Matches the app's pin so the test run doesn't drag in the pre-fix native SQLite
         (CVE-2025-6965 / GHSA-2m69-gcr7-jv3q). See Noctis.csproj for the rationale. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recorded API responses (metadata search engine tests run without the network). -->
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Noctis\Noctis.csproj" />
    <ProjectReference Include="..\..\src\Noctis.Core\Noctis.Core.csproj" />
    <ProjectReference Include="..\..\src\Noctis.Core.Server\Noctis.Core.Server.csproj" />
    <ProjectReference Include="..\..\src\Noctis.UI\Noctis.UI.csproj" />
    <ProjectReference Include="..\..\src\Noctis.Mobile\Noctis.Mobile.csproj" />
    <!-- The sample plugin is the plugin host's integration fixture (PluginHostTests). -->
    <ProjectReference Include="..\..\samples\Noctis.SamplePlugin\Noctis.SamplePlugin.csproj" />
    <ProjectReference Include="..\..\samples\Noctis.SamplePlugin.TrackTools\Noctis.SamplePlugin.TrackTools.csproj" />
    <ProjectReference Include="..\..\plugins\Noctis.Plugins.Kawarp\Noctis.Plugins.Kawarp.csproj" />
    <ProjectReference Include="..\..\plugins\Noctis.Plugins.Mixxx\Noctis.Plugins.Mixxx.csproj" />
    <ProjectReference Include="..\..\plugins\Noctis.Plugins.AlbumTown\Noctis.Plugins.AlbumTown.csproj" />
    <ProjectReference Include="..\..\plugins\Noctis.Plugins.AlbumRoulette\Noctis.Plugins.AlbumRoulette.csproj" />
    <ProjectReference Include="..\..\plugins\Noctis.Plugins.ABLoop\Noctis.Plugins.ABLoop.csproj" />
    <ProjectReference Include="..\..\plugins\Noctis.Plugins.TrueShuffle\Noctis.Plugins.TrueShuffle.csproj" />
    <ProjectReference Include="..\..\plugins\Noctis.Plugins.LyricMotion\Noctis.Plugins.LyricMotion.csproj" />
    <ProjectReference Include="..\..\plugins\Noctis.Plugins.YouTubeImport\Noctis.Plugins.YouTubeImport.csproj" />
  </ItemGroup>

  <!-- The plugin submission checker's logic (PluginSubmissionCheckTests), compiled in rather than
       referenced: tools/Noctis.PluginCheck is an exe, and only its Review folder is under test. -->
  <ItemGroup>
    <Compile Include="..\..\tools\Noctis.PluginCheck\Review\*.cs" Link="PluginCheck\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

