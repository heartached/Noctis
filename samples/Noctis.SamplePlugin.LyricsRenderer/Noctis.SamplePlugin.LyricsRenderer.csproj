<Project Sdk="Microsoft.NET.Sdk">
  <!--
    API 1.8 reference plugin: a lyrics renderer. It draws each lyric line itself (the words
    light up as they are sung) in place of Noctis's own lines, once picked in
    Settings → Lyrics → Lyrics Renderer.
    `dotnet build -c Release` writes bin/Release/Noctis.SamplePlugin.LyricsRenderer-<version>.zip.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Noctis.SamplePlugin.LyricsRenderer</RootNamespace>
    <Version>1.0.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- Outside this repo: <PackageReference Include="Noctis.Plugins.Abstractions" Version="1.8.*" ExcludeAssets="runtime" PrivateAssets="all" /> -->
    <ProjectReference Include="..\..\src\Noctis.Plugins.Abstractions\Noctis.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
  <Import Project="..\PluginPackage.targets" />
</Project>
