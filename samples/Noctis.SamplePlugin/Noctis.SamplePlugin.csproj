<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Reference plugin. `dotnet build -c Release` also writes bin/Release/Noctis.SamplePlugin-<version>.zip
    (the DLL + plugin.json): install it from Settings → Plugins → "Install from file…".
    Only the plugin DLL goes in the package: Noctis.Plugins.Abstractions and Avalonia come
    from the app itself. See docs/PLUGINS.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Noctis.SamplePlugin</RootNamespace>
    <Version>1.0.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Noctis.Plugins.Abstractions\Noctis.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
  <Import Project="..\PluginPackage.targets" />
</Project>
