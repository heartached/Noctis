<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Add from YouTube, the official Noctis plugin: search YouTube or paste a link, pick a format,
    and the audio lands in your library folder, tagged and with its cover. Moved out of the app
    on 10-29 (it was Settings → Library → Add songs from YouTube). Uses plugin API 1.5
    ("library.import") and a view of its own (1.3). yt-dlp runs as an external tool, installed
    and kept current by the plugin; ffmpeg (bundled with Noctis) converts when found.
    `dotnet build -c Release` writes bin/Release/Noctis.Plugins.YouTubeImport-<version>.zip.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Noctis.Plugins.YouTubeImport</RootNamespace>
    <Version>1.0.1</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Noctis.Plugins.Abstractions\Noctis.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <!-- Compile-time only: Noctis ships these exact versions (TagLib# for its tags, the MVVM
         toolkit for its view models), and a plugin's load context resolves assemblies the app
         has to the app's copy, so the package carries neither. -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" ExcludeAssets="runtime" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <!-- The yt-dlp seams (process runner, update lookup, clock) are internal; the app's tests drive them. -->
    <InternalsVisibleTo Include="Noctis.Tests" />
  </ItemGroup>
  <!-- Release builds also write bin/Release/Noctis.Plugins.YouTubeImport-<version>.zip (DLL + plugin.json + icon.png). -->
  <Import Project="..\..\samples\PluginPackage.targets" />
</Project>
