<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Chords for Noctis (official): estimates the chords of the playing song from its audio, offline,
    and shows them in time with the song (the chord now, the ones coming up, the key). Uses plugin
    API 1.6 ("audio.decode": Noctis decodes the song with the ffmpeg it ships), a view of its own
    and a track command. No chord website is asked: everything is worked out on this computer.
    docs/PLUGINS.md (Chords) has the method and the measured accuracy.
    `dotnet build -c Release` writes bin/Release/Noctis.Plugins.Chords-<version>.zip.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Noctis.Plugins.Chords</RootNamespace>
    <Version>1.0.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Noctis.Plugins.Abstractions\Noctis.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
  <!-- Release builds also write bin/Release/Noctis.Plugins.Chords-<version>.zip (DLL + plugin.json + icon.png). -->
  <Import Project="..\..\samples\PluginPackage.targets" />
</Project>
