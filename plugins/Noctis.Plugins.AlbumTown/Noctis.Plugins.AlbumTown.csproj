<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Album Town for Noctis: your albums live in a little town as square creatures with nub arms
    and feet. Call a crowd of them to the plaza, watch them wander and chat, and visit the
    Apartments where every artist has a home that grows with their albums. Idea by Jafezy JD.
    Uses plugin API 1.3 (a view of its own, PlayTracks, ShowAlbum, the album fields on TrackInfo).
    `dotnet build -c Release` writes bin/Release/Noctis.Plugins.AlbumTown-<version>.zip.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Noctis.Plugins.AlbumTown</RootNamespace>
    <Version>1.0.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Noctis.Plugins.Abstractions\Noctis.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
  <!-- Release builds also write bin/Release/Noctis.Plugins.AlbumTown-<version>.zip (DLL + plugin.json). -->
  <Import Project="..\..\samples\PluginPackage.targets" />
</Project>
