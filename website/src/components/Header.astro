---
import Logo from './Logo.astro';
import BrandIcon from './BrandIcon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { links } from '../config/site';

/**
 * A floating glass pill, centred at the top of the viewport. Brand on the
 * left, the page links in the middle, the actions on the right, ending in the
 * white "Get the App" button. Below 900px only the brand and a burger stay in
 * the pill; everything else moves into the sheet.
 */
const nav = [
  { label: 'Features', href: '/#showcase' },
  { label: 'Compare', href: '/#compare' },
  { label: 'FAQ', href: '/#faq' },
  { label: 'Plugins', href: '/plugins' },
  { label: 'Changelog', href: '/changelog' },
];
---

<header class="hdr" id="site-header">
  <div class="hdr__pill">
    <a class="brand" href="/" aria-label="Noctis — home">
      <Logo size={28} />
      <span class="brand__name">Noctis</span>
    </a>

    <nav class="hdr__nav" aria-label="Primary">
      {nav.map((item) => (
        <a class="hdr__link" href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hdr__actions">
      <a
        class="hdr__icon hdr__icon--support"
        href={links.support}
        target="_blank"
        rel="noopener"
        aria-label="Support Noctis on Buy Me a Coffee"
      >
        <BrandIcon brand="buymeacoffee" />
      </a>
      <a
        class="hdr__icon hdr__icon--discord"
        href={links.discord}
        target="_blank"
        rel="noopener"
        aria-label="Join the Noctis Discord"
      >
        <BrandIcon brand="discord" />
      </a>
      <a
        class="hdr__icon hdr__icon--github"
        href={links.repo}
        target="_blank"
        rel="noopener"
        aria-label="Noctis on GitHub"
      >
        <BrandIcon brand="github" />
      </a>

      <ThemeToggle />

      <a class="btn btn--primary hdr__cta" href="/#download">
        Get the App
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>

      <button
        class="hdr__burger"
        id="menu-btn"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<div class="sheet" id="mobile-menu" hidden>
  <div class="sheet__backdrop" data-close-menu></div>
  <nav class="sheet__panel" aria-label="Menu">
    <button class="icon-btn sheet__close" type="button" aria-label="Close menu" data-close-menu>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
    {nav.map((item) => (
      <a class="sheet__link" href={item.href}>
        {item.label}
      </a>
    ))}
    <a class="sheet__link" href="/#download">Download</a>

    <div class="sheet__foot">
      <a class="sheet__action sheet__action--support" href={links.support} target="_blank" rel="noopener">
        <BrandIcon brand="buymeacoffee" />
        Buy me a coffee
      </a>
      <a class="sheet__action sheet__action--discord" href={links.discord} target="_blank" rel="noopener">
        <BrandIcon brand="discord" />
        Join Discord
      </a>
      <a class="sheet__action sheet__action--github" href={links.repo} target="_blank" rel="noopener">
        <BrandIcon brand="github" />
        Source on GitHub
      </a>
      <div class="sheet__theme">
        <span class="sheet__theme-label">Theme</span>
        <ThemeToggle />
      </div>
    </div>
  </nav>
</div>

<style>
  .hdr {
    position: fixed;
    inset-inline: 0;
    top: max(16px, env(safe-area-inset-top));
    z-index: 100;
    display: flex;
    justify-content: center;
    padding-inline: var(--gutter);
    pointer-events: none;
  }

  .hdr__pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--s-4);
    height: 56px;
    max-width: 100%;
    padding: 6px 6px 6px 14px;
    position: relative;
    isolation: isolate;
    border: 1px solid transparent;
    border-radius: var(--r-pill);
    /* Smoked liquid glass. A dark tint over a heavily blurred backdrop, so
       whatever scrolls underneath shows as soft coloured light rather than
       shapes. The two ends are darker than the middle, which is what gives
       the capsule its rounded, lens-like depth; the edge is a faint hairline,
       not a bright rim. */
    background:
      radial-gradient(
        ellipse 60% 140% at 50% 50%,
        rgb(20 20 24 / 0.1) 0%,
        rgb(8 8 10 / 0.45) 100%
      ),
      linear-gradient(180deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.01)),
      rgb(12 12 14 / 0.42);
    /* Through a custom property: the CSS minifier otherwise merges the two
       declarations and keeps only one of them. */
    --glass: blur(22px) saturate(160%) brightness(0.95);
    backdrop-filter: var(--glass);
    box-shadow:
      inset 0 1px 0 0 rgb(255 255 255 / 0.1),
      inset 0 0 0 1px rgb(255 255 255 / 0.06),
      inset 0 -10px 24px -12px rgb(0 0 0 / 0.5),
      0 16px 44px -14px rgb(0 0 0 / 0.7),
      0 2px 8px rgb(0 0 0 / 0.3);
  }

  /* Safari before 18 only knows the prefixed property. It lives in its own
     rule because the minifier merges the two when they share one, keeping
     only whichever comes last. */
  @supports (-webkit-backdrop-filter: blur(1px)) and (not (backdrop-filter: blur(1px))) {
    .hdr__pill {
      -webkit-backdrop-filter: var(--glass);
    }
  }

  /* Specular highlight: a curved sheen across the upper half, the way light
     pools on the top of a glass capsule. */
  .hdr__pill::before {
    content: '';
    position: absolute;
    inset: 1px 1px 50% 1px;
    z-index: -1;
    border-radius: var(--r-pill) var(--r-pill) 40% 40% / var(--r-pill) var(--r-pill) 100% 100%;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0));
    pointer-events: none;
  }

  /* A thin gradient border: brighter along the top-left, fading around the
     bottom-right, masked so only the 1px ring paints. */
  .hdr__pill::after {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: -1;
    padding: 1px;
    border-radius: inherit;
    background: linear-gradient(
      135deg,
      rgb(255 255 255 / 0.2),
      rgb(255 255 255 / 0.04) 40%,
      rgb(255 255 255 / 0.03) 60%,
      rgb(255 255 255 / 0.12)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    pointer-events: none;
  }

  /* On the white page the glass needs a touch of darkness at the edge to hold
     its shape, and less lift so white content under it does not blow out. */
  :global(html[data-theme='light']) .hdr__pill {
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0.25)),
      rgb(255 255 255 / 0.2);
    --glass: blur(14px) saturate(190%) brightness(1.02);
    box-shadow:
      inset 0 1px 0 0 rgb(255 255 255 / 0.9),
      inset 0 -1px 0 0 rgb(0 0 0 / 0.04),
      inset 0 0 0 1px rgb(0 0 0 / 0.06),
      0 12px 36px -14px rgb(0 0 0 / 0.28),
      0 2px 6px rgb(0 0 0 / 0.06);
  }

  :global(html[data-theme='light']) .hdr__pill::after {
    background: linear-gradient(
      135deg,
      rgb(255 255 255 / 1),
      rgb(0 0 0 / 0.06) 45%,
      rgb(0 0 0 / 0.04) 60%,
      rgb(255 255 255 / 0.8)
    );
  }

  /* Where backdrop-filter is missing, fall back to an opaque bar so the nav
     text never sits unreadably over busy content. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .hdr__pill {
      background: var(--bg-1);
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    text-decoration: none;
    flex: none;
  }

  .brand__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }

  .hdr__nav {
    display: flex;
    gap: 2px;
    margin-inline: var(--s-3);
  }

  .hdr__link {
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-pill);
    color: var(--ink-1);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color var(--t-instant) var(--ease),
      background-color var(--t-instant) var(--ease);
  }

  .hdr__link:hover {
    color: var(--ink-0);
    background: color-mix(in srgb, var(--ink-0) 7%, transparent);
  }

  .hdr__actions {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex: none;
  }

  /* Small, filled, brand-coloured — the vendor's own ground under its mark. */
  .hdr__icon {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 50%;
    text-decoration: none;
    transition:
      transform var(--t-base) var(--ease),
      filter var(--t-instant) var(--ease);
  }

  .hdr__icon :global(svg) {
    width: 17px;
    height: 17px;
  }

  .hdr__icon--support {
    background: #ffdd00;
    color: #0d0c22;
  }

  .hdr__icon--discord {
    background: #5865f2;
    color: #fff;
  }

  .hdr__icon--github {
    background: var(--ink-0);
    color: var(--bg-0);
  }

  .hdr__icon:hover {
    filter: brightness(0.92);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hdr__icon:hover {
      transform: scale(1.08);
    }
  }

  /* The switch is a 40px control in a 44px row — pull it in a touch. */
  .hdr__actions :global([data-theme-toggle]) {
    margin-inline: var(--s-1);
  }

  .hdr__cta {
    min-height: 42px;
    padding-inline: var(--s-4) 14px;
    font-weight: 600;
    --btn-icon: 15px;
  }

  .hdr__burger {
    display: none;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: var(--ink-0);
  }

  .hdr__burger svg {
    width: 20px;
    height: 20px;
  }

  /* --- Mobile sheet ------------------------------------------------------ */

  .sheet {
    position: fixed;
    inset: 0;
    z-index: 150;
  }

  .sheet__backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--bg-0) 60%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
  }

  .sheet__panel {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    width: min(320px, 84vw);
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-5);
    padding-top: max(var(--s-5), env(safe-area-inset-top));
    padding-bottom: max(var(--s-5), env(safe-area-inset-bottom));
    background: var(--bg-1);
    border-inline-start: 1px solid var(--line);
    transform: translateX(100%);
    overflow-y: auto;
  }

  .sheet__close {
    align-self: flex-end;
    margin-bottom: var(--s-4);
  }

  .sheet__link {
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-nested);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    min-height: 44px;
  }

  .sheet__link:hover {
    background: var(--bg-2);
  }

  .sheet__foot {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-top: auto;
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }

  .sheet__action {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    min-height: 48px;
    border-radius: var(--r-pill);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .sheet__action :global(svg) {
    width: 20px;
    height: 20px;
    flex: none;
  }

  .sheet__action--support {
    background: #ffdd00;
    color: #0d0c22;
  }

  .sheet__action--discord {
    background: #5865f2;
    color: #fff;
  }

  .sheet__action--github {
    background: var(--ink-0);
    color: var(--bg-0);
  }

  .sheet__theme {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding-inline: var(--s-2);
  }

  .sheet__theme-label {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-1);
  }

  .sheet[data-open] .sheet__backdrop {
    opacity: 1;
  }

  .sheet[data-open] .sheet__panel {
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sheet__backdrop {
      transition: opacity var(--t-base) var(--ease);
    }
    .sheet__panel {
      transition: transform var(--t-base) var(--ease);
    }
  }

  /* --- Responsive --------------------------------------------------------- */

  @media (max-width: 1080px) {
    .hdr__icon--support,
    .hdr__icon--discord {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .hdr__nav,
    .hdr__icon,
    .hdr__actions :global([data-theme-toggle]) {
      display: none;
    }

    .hdr__pill {
      width: 100%;
      justify-content: space-between;
      height: 52px;
      padding: 5px 5px 5px 14px;
    }

    .hdr__cta {
      min-height: 40px;
    }

    .hdr__burger {
      display: grid;
    }
  }

  @media (max-width: 400px) {
    .hdr__cta {
      display: none;
    }
  }

  @media (min-width: 901px) {
    .sheet {
      display: none;
    }
  }
</style>
