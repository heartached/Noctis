---
import Logo from './Logo.astro';
import BrandIcon from './BrandIcon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { links } from '../config/site';

/**
 * A floating frosted pill, centred at the top of the viewport. Brand on the
 * left, the page links in the middle, then GitHub, the theme switch and the
 * "Get the App" button. Discord and Buy Me a Coffee live in the Community
 * section and the mobile sheet rather than here. Below 900px only the brand,
 * the button and a burger stay in the pill; everything else moves into the
 * sheet.
 */
const nav = [
  { label: 'Features', href: '/#showcase' },
  { label: 'Compare', href: '/#compare' },
  { label: 'FAQ', href: '/#faq' },
  { label: 'Plugins', href: '/plugins' },
  { label: 'Changelog', href: '/changelog' },
];
---

<header class="hdr" id="site-header">
  <div class="hdr__pill">
    <a class="brand" href="/" aria-label="Noctis — home">
      <Logo size={28} />
      <span class="brand__name">Noctis</span>
    </a>

    <nav class="hdr__nav" aria-label="Primary">
      {nav.map((item) => (
        <a class="hdr__link" href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hdr__actions">
      <a
        class="hdr__icon"
        href={links.repo}
        target="_blank"
        rel="noopener"
        aria-label="Noctis on GitHub"
      >
        <BrandIcon brand="github" />
      </a>

      <ThemeToggle />

      <a class="btn btn--primary hdr__cta" href="/#download">Get the App</a>

      <button
        class="hdr__burger"
        id="menu-btn"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<div class="sheet" id="mobile-menu" hidden>
  <div class="sheet__backdrop" data-close-menu></div>
  <nav class="sheet__panel" aria-label="Menu">
    <button class="icon-btn sheet__close" type="button" aria-label="Close menu" data-close-menu>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
    {nav.map((item) => (
      <a class="sheet__link" href={item.href}>
        {item.label}
      </a>
    ))}
    <a class="sheet__link" href="/#download">Download</a>

    <div class="sheet__foot">
      <a class="sheet__action sheet__action--support" href={links.support} target="_blank" rel="noopener">
        <BrandIcon brand="buymeacoffee" />
        Buy me a coffee
      </a>
      <a class="sheet__action sheet__action--discord" href={links.discord} target="_blank" rel="noopener">
        <BrandIcon brand="discord" />
        Join Discord
      </a>
      <a class="sheet__action sheet__action--github" href={links.repo} target="_blank" rel="noopener">
        <BrandIcon brand="github" />
        Source on GitHub
      </a>
      <div class="sheet__theme">
        <span class="sheet__theme-label">Theme</span>
        <ThemeToggle />
      </div>
    </div>
  </nav>
</div>

<style>
  .hdr {
    position: fixed;
    inset-inline: 0;
    top: max(16px, env(safe-area-inset-top));
    z-index: 100;
    display: flex;
    justify-content: center;
    padding-inline: var(--gutter);
    pointer-events: none;
  }

  .hdr__pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    height: 52px;
    max-width: 100%;
    padding: 6px 6px 6px 16px;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: var(--r-pill);
    /* Plain frosted glass: one tint over a blurred backdrop, a hairline edge
       and a soft drop shadow. */
    background: color-mix(in srgb, var(--bg-1) 72%, transparent);
    /* Through a custom property: the CSS minifier otherwise merges the two
       declarations and keeps only one of them. */
    --glass: blur(20px) saturate(160%);
    backdrop-filter: var(--glass);
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.6);
  }

  /* Safari before 18 only knows the prefixed property. It lives in its own
     rule because the minifier merges the two when they share one, keeping
     only whichever comes last. */
  @supports (-webkit-backdrop-filter: blur(1px)) and (not (backdrop-filter: blur(1px))) {
    .hdr__pill {
      -webkit-backdrop-filter: var(--glass);
    }
  }

  :global(html[data-theme='light']) .hdr__pill {
    border-color: rgb(0 0 0 / 0.08);
    background: rgb(255 255 255 / 0.72);
    box-shadow: 0 8px 24px -12px rgb(0 0 0 / 0.18);
  }

  /* Where backdrop-filter is missing, fall back to an opaque bar so the nav
     text never sits unreadably over busy content. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .hdr__pill {
      background: var(--bg-1);
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 40px;
    text-decoration: none;
    flex: none;
  }

  .brand__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .hdr__nav {
    display: flex;
    gap: 2px;
    margin-inline: var(--s-4);
  }

  .hdr__link {
    padding: 6px var(--s-3);
    border-radius: var(--r-pill);
    color: var(--ink-2);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color var(--t-instant) var(--ease),
      background-color var(--t-instant) var(--ease);
  }

  .hdr__link:hover {
    color: var(--ink-0);
    background: color-mix(in srgb, var(--ink-0) 7%, transparent);
  }

  .hdr__actions {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex: none;
  }

  /* Monochrome and unfilled, so it reads as part of the bar, not a badge. */
  .hdr__icon {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 50%;
    color: var(--ink-2);
    text-decoration: none;
    transition:
      color var(--t-instant) var(--ease),
      background-color var(--t-instant) var(--ease);
  }

  .hdr__icon :global(svg) {
    width: 18px;
    height: 18px;
  }

  .hdr__icon:hover {
    color: var(--ink-0);
    background: color-mix(in srgb, var(--ink-0) 7%, transparent);
  }

  /* A smaller, neutral switch in the bar: the accent stays on the CTA alone. */
  .hdr__actions :global([data-theme-toggle]) {
    --tsw-w: 56px;
    --tsw-h: 32px;
    --tsw-knob: color-mix(in srgb, var(--ink-0) 14%, transparent);
    --tsw-knob-shadow: none;
    --tsw-on: var(--ink-0);
    --tsw-track: transparent;
    --tsw-hover: color-mix(in srgb, var(--ink-0) 24%, transparent);
    margin-inline: var(--s-1);
  }

  .hdr__cta {
    min-height: 38px;
    padding-inline: var(--s-4);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .hdr__burger {
    display: none;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: var(--ink-0);
  }

  .hdr__burger svg {
    width: 20px;
    height: 20px;
  }

  /* --- Mobile sheet ------------------------------------------------------ */

  .sheet {
    position: fixed;
    inset: 0;
    z-index: 150;
  }

  .sheet__backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--bg-0) 60%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
  }

  .sheet__panel {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    width: min(320px, 84vw);
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-5);
    padding-top: max(var(--s-5), env(safe-area-inset-top));
    padding-bottom: max(var(--s-5), env(safe-area-inset-bottom));
    background: var(--bg-1);
    border-inline-start: 1px solid var(--line);
    transform: translateX(100%);
    overflow-y: auto;
  }

  .sheet__close {
    align-self: flex-end;
    margin-bottom: var(--s-4);
  }

  .sheet__link {
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-nested);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    min-height: 44px;
  }

  .sheet__link:hover {
    background: var(--bg-2);
  }

  .sheet__foot {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-top: auto;
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }

  .sheet__action {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    min-height: 48px;
    border-radius: var(--r-pill);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .sheet__action :global(svg) {
    width: 20px;
    height: 20px;
    flex: none;
  }

  .sheet__action--support {
    background: #ffdd00;
    color: #0d0c22;
  }

  .sheet__action--discord {
    background: #5865f2;
    color: #fff;
  }

  .sheet__action--github {
    background: var(--ink-0);
    color: var(--bg-0);
  }

  .sheet__theme {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding-inline: var(--s-2);
  }

  .sheet__theme-label {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-1);
  }

  .sheet[data-open] .sheet__backdrop {
    opacity: 1;
  }

  .sheet[data-open] .sheet__panel {
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sheet__backdrop {
      transition: opacity var(--t-base) var(--ease);
    }
    .sheet__panel {
      transition: transform var(--t-base) var(--ease);
    }
  }

  /* --- Responsive --------------------------------------------------------- */

  @media (max-width: 900px) {
    .hdr__nav,
    .hdr__icon,
    .hdr__actions :global([data-theme-toggle]) {
      display: none;
    }

    .hdr__pill {
      width: 100%;
      justify-content: space-between;
      padding: 5px 5px 5px 14px;
    }

    .hdr__burger {
      display: grid;
    }
  }

  @media (max-width: 400px) {
    .hdr__cta {
      display: none;
    }
  }

  @media (min-width: 901px) {
    .sheet {
      display: none;
    }
  }
</style>
