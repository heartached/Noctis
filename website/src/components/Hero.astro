---
import Screenshot from './Screenshot.astro';
import PackageManagers from './PackageManagers.astro';
import PlatformIcon from './PlatformIcon.astro';
import { versionLabel, release } from '../lib/release';
import { assetUrl } from '../lib/release';

/**
 * Centred poster hero: version badge, two-line headline, lede, the download
 * button beside the package-manager menu, then the app window bleeding off
 * the bottom of the section.
 *
 * The primary CTA is rendered once per platform and the non-matching two are
 * removed by CSS off a `data-os` attribute set before first paint.
 */
const ctas = [
  { os: 'windows', label: 'Windows', href: assetUrl('windowsInstaller') },
  { os: 'macos', label: 'macOS', href: assetUrl('macosArm') },
  { os: 'linux', label: 'Linux', href: assetUrl('linuxAppImage') },
] as const;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__copy">
    <a
      class="verpill hero-in"
      style="--i:0"
      href={release.latestUrl}
      target="_blank"
      rel="noopener"
      data-release-link
    >
      <span class="verpill__ver" data-release-version>{versionLabel ?? 'Latest'}</span>
      <span class="verpill__sep" aria-hidden="true"></span>
      <span class="verpill__tag">What’s new</span>
      <span class="verpill__arw" aria-hidden="true">→</span>
    </a>

    <h1 class="display hero__title" id="hero-title">
      <span class="reveal-line" style="--line-i:0"><span>A music player that</span></span>
      <span class="reveal-line" style="--line-i:1"><span>respects what’s <em>yours</em>.</span></span>
    </h1>

    <p class="lede hero__lede hero-in" style="--i:1">
      Your lossless library, played gapless on Windows, macOS and Linux.
      No account, no tracking.
    </p>

    <div class="hero__cta hero-in" style="--i:2">
      {ctas.map((c) => (
        <a class="btn btn--primary btn--lg hero__dl" data-os-cta={c.os} href={c.href}>
          <PlatformIcon os={c.os} />
          Download for {c.label}
        </a>
      ))}
      <PackageManagers />
    </div>
  </div>

  <div class="hero__stage">
    <div class="hero__window rise">
      <div class="hero__chrome" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <Screenshot name="home" eager sizes="(min-width: 1280px) 1180px, 100vw" class="hero__shot" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(2.5rem, 7vw, 6rem);
    overflow: clip;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* --- Version badge ------------------------------------------------------ */

  .verpill {
    position: relative;
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 10px;
    margin-bottom: var(--s-6);
    padding: 5px 14px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color var(--t-instant) var(--ease),
      color var(--t-instant) var(--ease);
  }

  /* Invisible hit area: the pill is drawn at 32px but taps land on 44px. */
  .verpill::after {
    content: '';
    position: absolute;
    inset: -6px -4px;
  }

  .verpill:hover {
    border-color: color-mix(in srgb, var(--ink-0) 24%, transparent);
    color: var(--ink-0);
  }

  .verpill__ver {
    font-weight: 600;
    color: var(--ink-0);
  }

  /* The one coloured phrase: marks the pill as a link, in the page's link red. */
  .verpill__tag,
  .verpill__arw {
    color: var(--accent-text);
    font-weight: 500;
  }

  .verpill__sep {
    width: 1px;
    height: 0.9em;
    background: var(--line);
  }

  .verpill__arw {
    transition: transform var(--t-base) var(--ease);
  }

  @media (prefers-reduced-motion: no-preference) {
    .verpill:hover .verpill__arw {
      transform: translateX(2px);
    }
  }

  /* --- Copy --------------------------------------------------------------- */

  .hero__title {
    max-width: 22ch;
  }

  .hero__lede {
    margin-top: var(--s-6);
    max-width: 48ch;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--s-4) var(--s-5);
    margin-top: var(--s-7);
  }

  .hero__dl {
    display: none;
    --btn-icon: 22px;
  }

  :global(html:not([data-os])) .hero__dl[data-os-cta='windows'],
  :global(html[data-os='windows']) .hero__dl[data-os-cta='windows'],
  :global(html[data-os='macos']) .hero__dl[data-os-cta='macos'],
  :global(html[data-os='linux']) .hero__dl[data-os-cta='linux'] {
    display: inline-flex;
  }

  /* --- The window --------------------------------------------------------- */

  .hero__stage {
    position: relative;
    max-width: 1180px;
    margin: clamp(3rem, 6vw, 5rem) auto 0;
    padding-inline: var(--gutter);
    perspective: 1600px;
    /* Bleeds off the bottom: the last quarter fades into the page rather than
       ending on a hard edge. The format strip starts below the fade instead of
       sitting over it, where its names collided with the screenshot. */
    mask-image: linear-gradient(to bottom, #000 0, #000 70%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 70%, transparent 100%);
  }

  .hero__window {
    position: relative;
    border: 1px solid color-mix(in srgb, var(--ink-0) 12%, transparent);
    border-radius: 22px;
    background: var(--bg-1);
    box-shadow: var(--shadow-window);
    overflow: hidden;
  }

  .hero__chrome {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px var(--s-4);
    border-bottom: 1px solid var(--line);
    background: var(--bg-2);
  }

  .hero__chrome span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink-0) 18%, transparent);
  }

  .hero__window :global(.hero__shot img) {
    width: 100%;
    height: auto;
  }

  /* --- Responsive --------------------------------------------------------- */

  @media (max-width: 640px) {
    .hero__title {
      font-size: clamp(2.5rem, 10vw, 3.4rem);
    }

    .hero__cta {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .hero__cta > :global(*) {
      width: 100%;
      justify-content: center;
    }

    .hero__stage {
      padding-inline: var(--s-3);
    }

    .hero__window {
      border-radius: 14px;
    }

  }
</style>
