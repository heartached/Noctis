---
/**
 * Official Discord, GitHub and Buy Me a Coffee marks, shared by the header
 * and the footer.
 *
 * Both paths are the vendors' own current artwork at full precision (Simple
 * Icons, CC0), not the rounded approximations that used to sit inline in both
 * components — the previous GitHub octocat in particular was a hand-simplified
 * silhouette with the tail and ears visibly wrong at 18px.
 *
 * COLOUR. Discord has one brand colour and this is it: #5865F2, "Blurple",
 * from Discord's own brand guidelines. GitHub deliberately has none — its mark
 * is specified as solid black on light backgrounds and solid white on dark, so
 * it takes currentColor and follows the theme. Pinning it to #181717 would
 * erase it on the dark theme, which is the same trap AppMark.astro documents
 * for foobar2000 and the Apple mark. Buy Me a Coffee's #FFDD00 is a background
 * colour in their kit, never a glyph colour — the cup also rides currentColor.
 *
 * The colour lives on the *button*, not on the path, so `.icon-btn:hover` can
 * override it to --on-accent when the button fills with accent.
 */
interface Props {
  brand: 'discord' | 'github' | 'buymeacoffee';
  size?: number;
}

