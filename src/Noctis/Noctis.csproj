<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows builds target the Windows TFM so WinRT projections are available
         (SMTC media overlay); macOS/Linux stay on plain net10.0. CI builds each
         OS artifact on its own runner, so the host-OS condition is safe. -->
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::IsOSPlatform('Windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows')) And Exists('Assets\Icons\Noctis.ico')">Assets\Icons\Noctis.ico</ApplicationIcon>
    <AssemblyName>Noctis</AssemblyName>
    <RootNamespace>Noctis</RootNamespace>
    <Product>Noctis</Product>
    <Company>Noctis</Company>
    <Version>1.4.7</Version>
    <!-- Pre-release marker: numeric Version stays 1.1.16 (update checks + the
         displayed number are unchanged); the "-prerelease" SemVer suffix on the
         informational version is what lights the "Pre-release" badge in Settings.
         Remove this line (or drop the suffix) when cutting a stable release. -->
    <InformationalVersion>1.4.7</InformationalVersion>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>

    <!-- Avalonia requires this for XAML compilation -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Suppress build warnings.
         CS8625 was dropped: it was a project-wide nullability switch kept on for exactly
         two warnings at one interop call, which now carries a scoped #pragma instead
         (Controls/AnimatedCoverImage.axaml.cs).
         CA1416 stays for now — it produces 0 warnings on the Windows TFM, and the
         non-Windows TFM has never been built with it visible, so removing it here is a
         change that has to be evaluated against a real linux-x64/osx build. -->
    <NoWarn>CS0067;MVVMTK0039;CA1416</NoWarn>
  </PropertyGroup>

  <!-- Expose internal services (e.g. the Core Audio COM interop) to the test project. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Noctis.Tests" />
  </ItemGroup>

  <!-- Avalonia UI -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Labs.Lottie" Version="12.0.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.18" Condition="'$(Configuration)' == 'Debug'" />
    <!-- MPRIS media keys on Linux (MprisService). Same version Avalonia's
         FreeDesktop backend already ships transitively — no new vendor. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
  </ItemGroup>

  <!-- MVVM -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Dependency Injection -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <!-- Audio playback via libVLC -->
  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.10.0" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <!-- macOS gets NO libvlc NuGet on purpose: VideoLAN.LibVLC.Mac's 3.0.21 pin
         never existed on nuget.org, so restore floated to the abandoned 2019-era
         3.1.3.1 payload (x86_64-only, no plugins, pre-3.0.8 security state).
         The CI .app packaging step bundles official VLC 3.0.23 universal dylibs
         + plugins at Contents/MacOS/libvlc instead; VlcAudioPlayer probes that
         path (after a user-installed VLC.app). AUDIT H7/H8. -->
    <!-- WASAPI output for click-free per-sample-gain volume (NOCTIS_WASAPI=1,
         Windows-only at runtime; managed packages restore on all build hosts).
         Core+Wasapi only: the NAudio meta-package drags in NAudio.WinForms,
         whose WindowsDesktop framework reference breaks restore for the
         non-Windows RIDs now that Windows builds use a windows TFM. -->
    <PackageReference Include="NAudio.Core" Version="2.3.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
  </ItemGroup>

  <!-- Metadata reading -->
  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <!-- Image color extraction (transitive dep of Avalonia.Skia, explicit for compile-time access) -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.3-preview.1.1" />
  </ItemGroup>

  <!-- JSON persistence. System.Text.Json needs no PackageReference on net10.0:
       the framework's in-box copy (10.0.x) supersedes any 8.x package and the
       SDK flags the reference as inert (NU1510). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.29" />
    <!-- Floats the native SQLite past CVE-2025-6965 / GHSA-2m69-gcr7-jv3q (High).
         Microsoft.Data.Sqlite 8.0.11 pins SQLitePCLRaw.lib.e_sqlite3 2.1.6, which
         bundles SQLite < 3.50.2 and shipped e_sqlite3.dll in every release. This
         explicit reference wins over the transitive pin without moving off the 8.0.x
         Microsoft.Data.Sqlite line. Verify with a vulnerable/transitive package audit. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <!-- Windows DPAPI: scrobbler tokens encrypted at rest in settings.json (runtime-guarded, no-op elsewhere) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- YAML: Lyricsfile (word-level sync) parsing -->
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="15.3.0" />
  </ItemGroup>

  <!-- Web Remote QR code (Settings → Integrations). Pure managed MIT port of
       Nayuki's QR generator; zero transitive dependencies. -->
  <ItemGroup>
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.1.0" />
  </ItemGroup>

  <!-- Embedded assets -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Controls\EqVisualizer.axaml" />
  </ItemGroup>

</Project>
