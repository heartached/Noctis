<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows builds target the Windows TFM so WinRT projections are available
         (SMTC media overlay); macOS/Linux stay on plain net10.0. CI builds each
         OS artifact on its own runner, so the host-OS condition is safe. -->
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::IsOSPlatform('Windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows')) And Exists('Assets\Icons\Noctis.ico')">Assets\Icons\Noctis.ico</ApplicationIcon>
    <AssemblyName>Noctis</AssemblyName>
    <RootNamespace>Noctis</RootNamespace>
    <Product>Noctis</Product>
    <Company>Noctis</Company>
    <Version>1.6.6</Version>
    <!-- Pre-release marker: numeric Version stays 1.1.16 (update checks + the
         displayed number are unchanged); the "-prerelease" SemVer suffix on the
         informational version is what lights the "Pre-release" badge in Settings.
         Remove this line (or drop the suffix) when cutting a stable release. -->
    <InformationalVersion>1.6.6</InformationalVersion>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>

    <!-- Avalonia requires this for XAML compilation -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Startup: precompile IL to native code at publish time (ReadyToRun). A cold
         launch otherwise JITs Avalonia, Skia bindings, System.Text.Json and the
         large view models from tier-0 IL before the first frame. Publish-only;
         plain builds and tests are unaffected. Every CI leg publishes with a RID
         and self-contained, which is what crossgen2 needs. -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Suppress build warnings.
         CS8625 was dropped: it was a project-wide nullability switch kept on for exactly
         two warnings at one interop call, which now carries a scoped #pragma instead
         (Controls/AnimatedCoverFeed.cs).
         CA1416 stays for now — it produces 0 warnings on the Windows TFM, and the
         non-Windows TFM has never been built with it visible, so removing it here is a
         change that has to be evaluated against a real linux-x64/osx build. -->
    <NoWarn>CS0067;MVVMTK0039;CA1416</NoWarn>
  </PropertyGroup>

  <!-- Expose internal services (e.g. the Core Audio COM interop) to the test project. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Noctis.Tests" />
    <!-- The plugin submission check (tools/Noctis.PluginCheck) validates with the app's own plugin rules. -->
    <InternalsVisibleTo Include="Noctis.PluginCheck" />
  </ItemGroup>
  <!-- Built-in Noctis server (Settings → Integrations): OpenSubsonic API over Kestrel.
       The shared framework is only loaded when the server is switched on. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <!-- Plugin SDK: the public surface plugins compile against (Settings → Plugins). -->
  <ItemGroup>
    <ProjectReference Include="..\Noctis.Plugins.Abstractions\Noctis.Plugins.Abstractions.csproj" />
    <!-- UI-free core (models, persistence, library, server, sync); shared with noctis-server. -->
    <ProjectReference Include="..\Noctis.Core\Noctis.Core.csproj" />
    <ProjectReference Include="..\Noctis.Core.Server\Noctis.Core.Server.csproj" />
    <ProjectReference Include="..\Noctis.UI\Noctis.UI.csproj" />
  </ItemGroup>
  <!-- arm64 (Apple Silicon, Linux arm64): leave Noctis.dll itself out of ReadyToRun. crossgen2
       miscompiles SettingsView's generated XAML method (~320 KB of IL, the largest in the app):
       the precompiled code reads a garbage GridLength and throws "Invalid value" building the
       view, so Settings never opened on macOS 1.6.4. The same publish with this assembly
       JIT-compiled opens it fine, and x64 (Windows) is unaffected. Avalonia, Skia and the
       other dependencies stay precompiled. -->
  <ItemGroup Condition="$(RuntimeIdentifier.EndsWith('-arm64'))">
    <PublishReadyToRunExclude Include="Noctis.dll" />
    <!-- Mitigation, root cause not found: with these two precompiled, osx-arm64 builds died
         at startup in roughly a third of cold launches (SIGSEGV in libSkiaSharp
         sk_codec_new_from_stream on a thread-pool artwork decode, the stream's vtable
         already freed): 18 of 52 launches across the shipped-1.6.4 config and this one.
         With both JIT-compiled: 0 of 24. Same code either way, only precompiled or not. -->
    <PublishReadyToRunExclude Include="SkiaSharp.dll" />
    <PublishReadyToRunExclude Include="Avalonia.Skia.dll" />
  </ItemGroup>

  <!-- The official plugin list (plugins/index.json), used by Settings → Plugins → Get plugins
       when the live copy on GitHub cannot be fetched. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\plugins\index.json" LogicalName="Noctis.Plugins.index.json" Link="Assets\plugins-index.json" />
    <!-- Each repo plugin's icon (plugins/<folder>/icon.png), so a listed plugin's card shows its
         icon offline and without a fetch (PluginCatalog.ReadEmbeddedIcon). -->
    <EmbeddedResource Include="..\..\plugins\*\icon.png" LogicalName="Noctis.PluginIcons/%(RelativeDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Avalonia UI -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.3" />
    <PackageReference Include="Avalonia.Labs.Lottie" Version="12.0.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <!-- MPRIS media keys on Linux (MprisService). Same version Avalonia's
         FreeDesktop backend already ships transitively — no new vendor. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.NoAvx" Version="1.9.1" />
    <!-- Experimental: Lyrics Studio on the graphics card (WhisperGpu, off by default in the app).
         Only in builds made with -p:LyricsGpu=true: win-x64 + linux-x64 Vulkan builds, ~60 MB per
         platform unpacked. Owner decision before it ships (l2-speed report, 10-20). -->
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" Condition="'$(LyricsGpu)' == 'true'" />
  </ItemGroup>

  <!-- Whisper.net.Runtime.Vulkan copies its win-x64 AND linux-x64 libraries (58 MB each) into every
       build, whatever the target. Keep only the one the target can load: by -r, else by the build
       host; none for macOS or arm64 (WhisperGpu offers Vulkan on win-x64 / linux-x64 only). -->
  <Target Name="KeepOnlyTargetVulkanRuntime" BeforeTargets="AssignTargetPaths" Condition="'$(LyricsGpu)' == 'true'">
    <PropertyGroup>
      <_VulkanRid>$(RuntimeIdentifier)</_VulkanRid>
      <_VulkanRid Condition="'$(_VulkanRid)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</_VulkanRid>
      <_VulkanRid Condition="'$(_VulkanRid)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</_VulkanRid>
    </PropertyGroup>
    <ItemGroup>
      <_OtherVulkanRuntime Include="@(None)" Condition="$([System.String]::Copy('%(None.Identity)').ToLowerInvariant().Contains('whisper.net.runtime.vulkan')) and !$([System.String]::Copy('%(None.Identity)').Replace('\','/').Contains('/$(_VulkanRid)/'))" />
      <None Remove="@(_OtherVulkanRuntime)" />
    </ItemGroup>
  </Target>

  <!-- MVVM -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Dependency Injection -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <!-- Audio playback via libVLC -->
  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <!-- macOS gets NO libvlc NuGet on purpose: VideoLAN.LibVLC.Mac's 3.0.21 pin
         never existed on nuget.org, so restore floated to the abandoned 2019-era
         3.1.3.1 payload (x86_64-only, no plugins, pre-3.0.8 security state).
         The CI .app packaging step bundles official VLC 3.0.23 universal dylibs
         + plugins at Contents/MacOS/libvlc instead; VlcAudioPlayer probes that
         path (before any user-installed VLC.app). AUDIT H7/H8. -->
    <!-- WASAPI output for click-free per-sample-gain volume (NOCTIS_WASAPI=1,
         Windows-only at runtime; managed packages restore on all build hosts).
         Core+Wasapi only: the NAudio meta-package drags in NAudio.WinForms,
         whose WindowsDesktop framework reference breaks restore for the
         non-Windows RIDs now that Windows builds use a windows TFM. -->
    <PackageReference Include="NAudio.Core" Version="2.3.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
  </ItemGroup>

  <!-- Metadata reading -->
  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <!-- Image color extraction (transitive dep of Avalonia.Skia, explicit for compile-time access) -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <!-- JSON persistence. System.Text.Json needs no PackageReference on net10.0:
       the framework's in-box copy (10.0.x) supersedes any 8.x package and the
       SDK flags the reference as inert (NU1510). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <!-- Floats the native SQLite past CVE-2025-6965 / GHSA-2m69-gcr7-jv3q (High).
         Microsoft.Data.Sqlite 8.0.11 pins SQLitePCLRaw.lib.e_sqlite3 2.1.6, which
         bundles SQLite < 3.50.2 and shipped e_sqlite3.dll in every release. This
         explicit reference wins over the transitive pin without moving off the 8.0.x
         Microsoft.Data.Sqlite line. Verify with a vulnerable/transitive package audit. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <!-- Windows DPAPI: scrobbler tokens encrypted at rest in settings.json (runtime-guarded, no-op elsewhere) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- YAML: Lyricsfile (word-level sync) parsing -->
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="15.3.0" />
  </ItemGroup>

  <!-- Web Remote QR code (Settings → Integrations). Pure managed MIT port of
       Nayuki's QR generator; zero transitive dependencies. -->
  <ItemGroup>
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
  </ItemGroup>

  <!-- Embedded assets -->
  <ItemGroup>
    <!-- Shared assets (themes, styles, icons, fonts) live in Noctis.UI; only the
         exe icon stays here for ApplicationIcon and the installer. -->
    <AvaloniaResource Include="Controls\EqVisualizer.axaml" />
    <!-- Settings › Appearance › App Icon: desktop-only window/tray icons + previews
         (scripts/app-icons/generate_app_icons.py). Kept out of Noctis.UI so the phone
         builds don't carry them. -->
    <AvaloniaResource Include="Assets\AppIcons\*.ico;Assets\AppIcons\*.png" />
  </ItemGroup>

</Project>
