<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Noctis.Localization"
        xmlns:vm="using:Noctis.ViewModels"
        xmlns:controls="using:Noctis.Controls"
        x:Class="Noctis.Views.LyricsStudioPickerDialog"
        x:DataType="vm:LyricsStudioPickerViewModel"
        Title="{loc:T LyricsStudioPicker.Title}"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- Small caps over the list ("WITHOUT WORD TIMINGS"), as View Options' section labels. -->
        <Style Selector="TextBlock.lsp-section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.1" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- Format: a two-segment pill, the recipe of Create Smart Playlist's Match All / Any
             (sp-seg) and View Options' pairs (vo-seg). Segments, not toggle chips: a click on
             the chosen side keeps it (a chip un-toggled and switched the format). -->
        <Style Selector="RadioButton.lsp-seg">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="SegFill"
                            Background="{TemplateBinding Background}"
                            CornerRadius="999"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.lsp-seg:pointerover">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="RadioButton.lsp-seg:checked">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="{DynamicResource PillFieldBackgroundPointerOver}" />
        </Style>

        <!-- Rows highlight in place, never zoom (same as Add Songs). -->
        <Style Selector="Button.pick-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.pick-row:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="Button.pick-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PillFieldBackground}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.pick-row:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PillFieldBackgroundPointerOver}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- What a song has now (No lyrics / LRC / Plain), or an album's song count: one filled
             tag size, so tags and checks line up down the list. -->
        <Style Selector="Border.state-pill">
            <Setter Property="Background" Value="{DynamicResource PillFieldBackgroundPointerOver}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Selection circle: the Add Songs recipe (brushes in styles so .selected wins). -->
        <Style Selector="Border.selection-circle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>
        <Style Selector="Border.selection-circle.selected">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
        </Style>
    </Window.Styles>

    <!-- Owner 10-08: the rounded pill pop-up of the Metadata editor, with the blurred app
         behind, and less clutter: the format as one segmented pill with a one-line hint, a
         filled search pill, tidy rows (tag and check in line), the count in the footer.
         PillDialogHost draws the blurred, dimmed owner and the card, and plays the open/close
         animation (every close path — Cancel, Add, Esc, Alt+F4 — animates out once). The pick
         reaches the caller through the view model's Confirmed event, never Close(result).
         A fixed height: the card does not jump as a search narrows the list. -->
    <controls:PillDialogHost>

    <Grid Width="640" Height="660" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header: what this is and what it decides. -->
        <Border Grid.Row="0"
                Padding="28,22,28,16"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="56,16,*">
                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="18" Classes="pill-well">
                    <PathIcon Data="{StaticResource SidebarLyricsStudioIcon}" Width="22" Height="22" Opacity="0.6"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T LyricsStudioPicker.Title}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="{loc:T LyricsStudioPicker.Subtitle}"
                               FontSize="13" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Format (one setting, the same as the Studio's) and the search. -->
        <StackPanel Grid.Row="1" Margin="28,16,28,6" Spacing="12">
            <Grid ColumnDefinitions="Auto,14,*">
                <Border Grid.Column="0" Classes="pill-well" CornerRadius="999" Padding="3">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <RadioButton x:Name="WordTimingsSegment" Classes="lsp-seg"
                                     Content="{loc:T LyricsStudioPicker.WordTimings}"
                                     IsChecked="{Binding WordTimings}" />
                        <RadioButton x:Name="LineTimingsSegment" Classes="lsp-seg"
                                     Content="{loc:T LyricsStudioPicker.LineTimings}"
                                     IsChecked="{Binding LineTimings}" />
                    </StackPanel>
                </Border>
                <!-- One line; the full explanation is the tooltip. -->
                <TextBlock x:Name="FormatHintText" Grid.Column="2"
                           Text="{Binding FormatHint}"
                           ToolTip.Tip="{loc:T LyricsStudioPicker.FormatHint}"
                           FontSize="12.5" Opacity="0.55"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>

            <TextBox x:Name="SearchBox"
                     Classes="pill-field"
                     Text="{Binding SearchText}"
                     PlaceholderText="{loc:T LyricsStudioPicker.Search}"
                     Padding="10,10,16,10">
                <TextBox.InnerLeftContent>
                    <PathIcon Data="{StaticResource SearchIcon}" Width="13" Height="13" Opacity="0.5"
                              Margin="16,0,0,0" VerticalAlignment="Center" />
                </TextBox.InnerLeftContent>
            </TextBox>
        </StackPanel>

        <!-- Body: the list (suggestions or search results), or what to do when there is none.
             20 + the row's 8 padding = the 28 inset of everything above. -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="20,4,20,4">
            <Panel Grid.Row="0" Margin="8,4,8,6">
                <TextBlock Classes="lsp-section" Text="{Binding SuggestionsHeader}">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsSuggesting" />
                            <Binding Path="!ShowLoading" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
                <TextBlock x:Name="LoadingText" Text="{loc:T LyricsStudioPicker.Scanning}"
                           FontSize="12" Opacity="0.55" IsVisible="{Binding ShowLoading}" />
            </Panel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ResultsList" ItemsSource="{Binding Results}">
                    <!-- Virtualized: only the rows in view are built (up to 20 albums + 80 songs). -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LyricsStudioPickRow">
                            <Button Classes="pick-row"
                                    Command="{Binding $parent[ItemsControl].((vm:LyricsStudioPickerViewModel)DataContext).ToggleSelectCommand}"
                                    CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="40,*,Auto,Auto">
                                    <Border Grid.Column="0"
                                            Classes="pill-well"
                                            Width="40" Height="40"
                                            CornerRadius="8"
                                            ClipToBounds="True"
                                            VerticalAlignment="Center">
                                        <controls:CachedImage SourcePath="{Binding ArtworkPath}"
                                                              DecodeWidth="128"
                                                              Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="1">
                                        <!-- The Add Songs title cell: Auto,Auto keeps the E badge hugging the
                                             title; the LayoutUpdated handler caps the title's MaxWidth so a
                                             long title trims instead of pushing the badge out of the row. -->
                                        <Grid ColumnDefinitions="Auto,Auto"
                                              ClipToBounds="True"
                                              LayoutUpdated="OnTitleCellLayoutUpdated">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            <Border Grid.Column="1"
                                                    Classes="explicit-badge compact"
                                                    Margin="6,0,0,0"
                                                    IsVisible="{Binding IsExplicit}"
                                                    ToolTip.Tip="{loc:T AddSongs.ExplicitTip}">
                                                <TextBlock Text="E"
                                                           Classes="explicit-badge-text compact"
                                                           FontSize="8"
                                                           Opacity="0.9" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="11.5" Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    </StackPanel>
                                    <!-- Song rows: what the song has now. Album rows: how many songs it adds. -->
                                    <Border Grid.Column="2" Classes="state-pill" Margin="0,0,14,0"
                                            IsVisible="{Binding StateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding StateText}" FontSize="10.5" FontWeight="SemiBold" Opacity="0.75"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="3"
                                            Classes="selection-circle"
                                            Classes.selected="{Binding IsSelected}"
                                            Width="22" Height="22"
                                            CornerRadius="11"
                                            BorderThickness="1.5"
                                            UseLayoutRounding="True"
                                            VerticalAlignment="Center">
                                        <Border.Transitions>
                                            <Transitions>
                                                <BrushTransition Property="Background" Duration="0:0:0.18">
                                                    <BrushTransition.Easing>
                                                        <CubicEaseOut />
                                                    </BrushTransition.Easing>
                                                </BrushTransition>
                                                <BrushTransition Property="BorderBrush" Duration="0:0:0.18">
                                                    <BrushTransition.Easing>
                                                        <CubicEaseOut />
                                                    </BrushTransition.Easing>
                                                </BrushTransition>
                                            </Transitions>
                                        </Border.Transitions>
                                        <Path Data="M 0 3.5 L 3 7 L 9 0"
                                              Stroke="{DynamicResource AccentForegroundBrush}"
                                              StrokeThickness="1.5"
                                              StrokeLineCap="Round"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsVisible="{Binding IsSelected}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Nothing missing the format (or nothing to suggest): search instead. -->
            <StackPanel x:Name="PromptState" Grid.Row="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="6" IsVisible="{Binding ShowPrompt}">
                <TextBlock Text="{loc:T LyricsStudioPicker.PromptTitle}"
                           FontSize="15" FontWeight="SemiBold" Opacity="0.7"
                           HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock Text="{loc:T LyricsStudioPicker.PromptBody}"
                           FontSize="12.5" Opacity="0.5"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
            </StackPanel>

            <!-- A search that found nothing local. -->
            <StackPanel x:Name="NoResultsState" Grid.Row="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="6" IsVisible="{Binding ShowNoResults}">
                <TextBlock Text="{loc:T AddSongs.NoMatches}"
                           FontSize="15" FontWeight="SemiBold" Opacity="0.7"
                           HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock Text="{loc:T AddSongs.NothingLibraryMatchesSearch}"
                           FontSize="12.5" Opacity="0.5"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
            </StackPanel>
        </Grid>

        <!-- Footer: Select all / Clear and the count on the left, Cancel / Add on the right. -->
        <Border Grid.Row="3"
                Padding="28,14"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <Button x:Name="SelectAllButton"
                        Grid.Column="0"
                        Classes="pill-secondary"
                        MinHeight="34"
                        Padding="16,0"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Margin="0,0,12,0"
                        Content="{Binding SelectAllText}"
                        Command="{Binding ToggleSelectAllCommand}"
                        IsVisible="{Binding HasSelectableResults}" />
                <TextBlock x:Name="SelectionCount"
                           Grid.Column="1"
                           Text="{Binding SelectionText}"
                           FontSize="12.5" Opacity="0.6"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasSelection}" />
                <Button Grid.Column="3"
                        Classes="pill-secondary"
                        Content="{loc:T AddSongs.Cancel}"
                        Command="{Binding CancelCommand}"
                        MinWidth="108"
                        Margin="0,0,10,0" />
                <Button Grid.Column="4"
                        Classes="pill-primary"
                        Content="{Binding AddButtonText}"
                        Command="{Binding ConfirmCommand}"
                        IsEnabled="{Binding HasSelection}"
                        MinWidth="140" />
            </Grid>
        </Border>
    </Grid>

    </controls:PillDialogHost>
</Window>
