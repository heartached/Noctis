<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
        xmlns:sys="using:System"
        x:Class="Noctis.Views.ConfirmationDialog"
        Title="{loc:T Confirmation.Confirm}"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False">

    <!-- Full-window dimmed overlay that captures all input.
         Starts transparent; code-behind fades it in on open and back out
         before closing (mirrors the Settings modal animation). -->
    <Border x:Name="DialogOverlay"
            Background="#50000000"
            Opacity="0"
            PointerPressed="OnOverlayPointerPressed"
            PointerWheelChanged="OnOverlayWheel">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18">
                    <DoubleTransition.Easing>
                        <CubicEaseOut/>
                    </DoubleTransition.Easing>
                </DoubleTransition>
            </Transitions>
        </Border.Transitions>

        <!-- Centered dialog card -->
        <Border x:Name="DialogCard"
                Background="{DynamicResource AppMainBackground}"
                CornerRadius="24"
                ClipToBounds="True"
                Width="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="50%,50%"
                RenderTransform="scale(0.96)"
                BoxShadow="0 8 32 0 #80000000, 0 0 0 1 #33FFFFFF">
            <Border.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18">
                        <TransformOperationsTransition.Easing>
                            <CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Border.Transitions>
        <DockPanel Margin="0">

            <!-- Bottom: Confirm / Cancel buttons -->
            <Border DockPanel.Dock="Bottom"
                    Padding="24,12,24,16">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Button Grid.Column="1"
                            Content="{loc:T Confirmation.Cancel}"
                            Click="OnCancelClick"
                            Width="100"
                            Padding="0,8"
                            FontWeight="Bold"
                            HorizontalContentAlignment="Center"
                            CornerRadius="999"
                            Margin="0,0,8,0"
                            Cursor="Hand" />
                    <Button Grid.Column="2"
                            x:Name="ConfirmButton"
                            Content="{loc:T Confirmation.Confirm}"
                            Click="OnConfirmClick"
                            MinWidth="100"
                            Padding="0,8"
                            Classes="accent-btn"
                            Background="{DynamicResource AccentButtonBackground}"
                            Foreground="{DynamicResource AccentForegroundBrush}"
                            FontWeight="Bold"
                            HorizontalContentAlignment="Center"
                            CornerRadius="999"
                            Cursor="Hand" />
                </Grid>
            </Border>

            <!-- Message (+ optional title, detail lines, note and checkbox; see ConfirmationRequest) -->
            <StackPanel Margin="24,16,24,8" VerticalAlignment="Center" Spacing="10">
                <TextBlock x:Name="TitleText"
                           IsVisible="False"
                           FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText"
                           Text="{loc:T Confirmation.AreYouSure}"
                           FontSize="14"
                           TextWrapping="Wrap" />
                <ItemsControl x:Name="DetailsList" IsVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sys:String">
                            <Grid ColumnDefinitions="Auto,*">
                                <Ellipse Width="5" Height="5" Margin="2,7,10,0" VerticalAlignment="Top"
                                         Fill="{DynamicResource AccentColorBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoteText"
                           IsVisible="False"
                           FontSize="12" Opacity="0.65"
                           TextWrapping="Wrap" />
                <CheckBox x:Name="OptionCheck" IsVisible="False" FontSize="13"/>
            </StackPanel>
        </DockPanel>
        </Border>
    </Border>
</Window>
