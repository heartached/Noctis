                            IsVisible="{Binding Next31Track, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Panel>
                            <ctrl:CachedImage SourcePath="{Binding Next31Track.AlbumArtworkPath}" Stretch="UniformToFill"/>
                            <ctrl:HeartIcon Size="11" ShowWhenOff="False"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5"
                                            IsFavorite="{Binding Next31Track.IsFavorite, FallbackValue=False}"/>
                        </Panel>
                    </Border>
                </Canvas>
            </Viewbox>

            <!-- ═══ CAROUSEL: five glass cards (queue-driven; hidden in collage mode) ═══
                 Centre = the playing track, −1/−2 = history to its left, +1/+2 = up next
                 to its right. Every slot is a CoverFlowCard (light frosted slab, cover
                 inset on top, title/artist caption inside), all 300px so the caption type
                 matches. The slot GEOMETRY lives in CoverFlowCarouselGeometry and is applied
                 by the code-behind (SetPose): a 3D tilt turning each side card's OUTER
                 edge toward the viewer (Rotate3DTransform + perspective Depth), a
                 scale-down, a slide out, a dim and an opacity per slot, every card SIDE BY
                 SIDE with a fixed gap, never overlapping (09-22 mockup). On a skip the content swaps one slot over
                 by binding and the code-behind slides every card from its previous slot's
                 pose to its own (ease-out cubic, ~360ms). Wheel / ← → move the carousel by
                 really changing the track. The artwork is NOT a button (09-17): the caption's
                 title link plays a side card's track / opens the centre card's album, and
                 the artist link opens the artist. Only these five controls exist — nothing
                 further out is realised. The host cancels the page inset (24 top / 12
                 bottom) with negative margins so the midline is the true page centre. -->
            <Grid x:Name="CarouselHost"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  Height="420"
                  Margin="0,-24,0,-12"
                  Background="Transparent"
                  IsVisible="{Binding ShowCarousel}">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      ClipToBounds="False">







                    <!-- −7..−5 (history): drawn small, so decoded small -->
                    <ctrl:CoverFlowCard x:Name="SlotPrev7"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        DecodeWidth="256"
                                        ArtworkPath="{Binding Prev7ArtworkPath}"
                                        Title="{Binding Prev7Track.Title, FallbackValue=''}"
                                        Artist="{Binding Prev7Track.Artist, FallbackValue=''}"
                                        IsExplicit="{Binding Prev7Track.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding Prev7Track, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ctrl:CoverFlowCard x:Name="SlotPrev6"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        DecodeWidth="256"
                                        ArtworkPath="{Binding Prev6ArtworkPath}"
                                        Title="{Binding Prev6Track.Title, FallbackValue=''}"
                                        Artist="{Binding Prev6Track.Artist, FallbackValue=''}"
                                        IsExplicit="{Binding Prev6Track.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding Prev6Track, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ctrl:CoverFlowCard x:Name="SlotPrev5"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        DecodeWidth="256"
                                        ArtworkPath="{Binding Prev5ArtworkPath}"
                                        Title="{Binding Prev5Track.Title, FallbackValue=''}"
                                        Artist="{Binding Prev5Track.Artist, FallbackValue=''}"
                                        IsExplicit="{Binding Prev5Track.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding Prev5Track, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <!-- −4 (history) -->
                    <ctrl:CoverFlowCard x:Name="SlotPrev4"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        ArtworkPath="{Binding OffPreviousArtworkPath}"
                                        Title="{Binding OffPreviousTrack.Title, FallbackValue=''}"
                                        Artist="{Binding OffPreviousTrack.Artist, FallbackValue=''}"
                                        IsExplicit="{Binding OffPreviousTrack.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding OffPreviousTrack, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <!-- −3 (history) -->
                    <ctrl:CoverFlowCard x:Name="SlotPrev3"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        ArtworkPath="{Binding EdgePreviousArtworkPath}"
                                        Title="{Binding EdgePreviousTrack.Title, FallbackValue=''}"
                                        Artist="{Binding EdgePreviousTrack.Artist, FallbackValue=''}"
                                        IsExplicit="{Binding EdgePreviousTrack.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding EdgePreviousTrack, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <!-- −2 (history) -->
                    <ctrl:CoverFlowCard x:Name="SlotPrev2"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        ArtworkPath="{Binding FarPreviousArtworkPath}"
                                        Title="{Binding FarPreviousTrack.Title, FallbackValue=''}"
                                        Artist="{Binding FarPreviousTrack.Artist, FallbackValue=''}"
                                        IsExplicit="{Binding FarPreviousTrack.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding FarPreviousTrack, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <!-- −1 (history) -->
                    <ctrl:CoverFlowCard x:Name="SlotPrev1"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        ArtworkPath="{Binding PreviousArtworkPath}"
                                        Title="{Binding PreviousTrack.Title, FallbackValue=''}"
                                        Artist="{Binding PreviousTrack.Artist, FallbackValue=''}"
                                        IsExplicit="{Binding PreviousTrack.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding PreviousTrack, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <!-- 0 (playing) -->
                    <ctrl:CoverFlowCard x:Name="CenterCard"
                                        Classes="flow-card centre"
                                        ArtworkSize="300"
                                        DecodeWidth="768"
                                        ArtworkPath="{Binding CenterArtworkPath}"
                                        Title="{Binding CenterTitle}"
                                        Artist="{Binding CenterArtist}"
                                        IsExplicit="{Binding CenterIsExplicit}"
                                        TitleToolTip="{loc:T PlaybackBar.ViewAlbumTip}"
                                        ArtistCommand="{Binding GoToArtistCommand}">
                        <ctrl:CoverFlowCard.Overlay>
                            <Panel>
                                <ctrl:AnimatedCoverImage
                                    Source="{Binding Player.CurrentAnimatedCoverPath}"
                                    IsActive="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Settings.EnableAnimatedCovers, FallbackValue=False}" />
                                <!-- Favorite heart overlay on the centre cover -->
                                <ctrl:HeartIcon Size="24" ShowWhenOff="False"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"
                                                IsFavorite="{Binding CenterIsFavorite}" />
                            </Panel>
                        </ctrl:CoverFlowCard.Overlay>
                    </ctrl:CoverFlowCard>

                    <!-- +1 (up next) -->
                    <ctrl:CoverFlowCard x:Name="SlotNext1"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        ArtworkPath="{Binding NextArtworkPath}"
                                        Title="{Binding NextTrack.Title, FallbackValue=''}"
                                        Artist="{Binding NextTrack.Artist, FallbackValue=''}"
                                        IsExplicit="{Binding NextTrack.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding NextTrack, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <!-- +2 (up next) -->
                    <ctrl:CoverFlowCard x:Name="SlotNext2"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        ArtworkPath="{Binding FarNextArtworkPath}"
                                        Title="{Binding FarNextTrack.Title, FallbackValue=''}"
                                        Artist="{Binding FarNextTrack.Artist, FallbackValue=''}"
                                        IsExplicit="{Binding FarNextTrack.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding FarNextTrack, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <!-- +3 (up next) -->
                    <ctrl:CoverFlowCard x:Name="SlotNext3"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        ArtworkPath="{Binding EdgeNextArtworkPath}"
                                        Title="{Binding EdgeNextTrack.Title, FallbackValue=''}"
                                        Artist="{Binding EdgeNextTrack.Artist, FallbackValue=''}"
                                        IsExplicit="{Binding EdgeNextTrack.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding EdgeNextTrack, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <!-- +4 (up next) -->
                    <ctrl:CoverFlowCard x:Name="SlotNext4"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        ArtworkPath="{Binding OffNextArtworkPath}"
                                        Title="{Binding OffNextTrack.Title, FallbackValue=''}"
                                        Artist="{Binding OffNextTrack.Artist, FallbackValue=''}"
                                        IsExplicit="{Binding OffNextTrack.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding OffNextTrack, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <!-- +5..+7 (up next): drawn small, so decoded small -->
                    <ctrl:CoverFlowCard x:Name="SlotNext5"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        DecodeWidth="256"
                                        ArtworkPath="{Binding Next5ArtworkPath}"
                                        Title="{Binding Next5Track.Title, FallbackValue=''}"
                                        Artist="{Binding Next5Track.Artist, FallbackValue=''}"
                                        IsExplicit="{Binding Next5Track.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding Next5Track, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ctrl:CoverFlowCard x:Name="SlotNext6"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        DecodeWidth="256"
                                        ArtworkPath="{Binding Next6ArtworkPath}"
                                        Title="{Binding Next6Track.Title, FallbackValue=''}"
                                        Artist="{Binding Next6Track.Artist, FallbackValue=''}"
                                        IsExplicit="{Binding Next6Track.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding Next6Track, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ctrl:CoverFlowCard x:Name="SlotNext7"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        DecodeWidth="256"
                                        ArtworkPath="{Binding Next7ArtworkPath}"
                                        Title="{Binding Next7Track.Title, FallbackValue=''}"
                                        Artist="{Binding Next7Track.Artist, FallbackValue=''}"
                                        IsExplicit="{Binding Next7Track.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding Next7Track, Converter={x:Static ObjectConverters.IsNotNull}}" />






                </Grid>
            </Grid>

            <!-- ═══ CASCADE: diagonal path + now-playing column ═══
                 Community mockup (Mistery, Discord 2026-08-29). The covers sit on ONE
                 ordered path that bows out to the right: history climbs away above the
                 playing cover toward the top-left corner, up-next falls away below it
                 toward the bottom-left corner. Skipping a track therefore moves every
                 card one step along the path (down for next, up for previous) — the same
                 fixed-slot content swap the carousel does, just on a curve. Nothing is
                 random. On a skip the code-behind slides every card along the path from
                 the slot it came from to its own (CoverFlowCascadeGeometry, same RAF loop
                 and ease as the carousel; the old Avalonia transitions were removed for
                 lag). No hover, pile not hit-testable.

                 Geometry: a 1000×1000 design canvas whose RIGHT edge is the playing
                 cover's right edge, so the text column hugs the cover like the mockup.
                 Code-behind sizes the Viewbox to a SQUARE as tall as the page (negative
                 margins cancel the page inset), so the canvas maps 1:1 onto the column
                 and the outer cards run off the top and in from the bottom, cut by the
                 page edge itself — nothing clips in mid-air (no Canvas/Viewbox clip; the
                 UserControl's ClipToBounds does it). StageGrid: pile | text; code-behind
                 drops the text under the pile below ~1040px (see OnSizeChanged). -->
            <Grid x:Name="StageGrid"
                  ColumnDefinitions="Auto,*" RowDefinitions="*,Auto"
                  IsVisible="{Binding ShowCascade}">

                <Viewbox x:Name="PileViewbox"
                         Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                         Stretch="Uniform"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         Margin="0,-24,0,-12">
                    <Canvas Width="1000" Height="1000">

                        <!-- ── History: climbs away above the playing cover, off the top ── -->
                        <!-- −3: top-left, mostly out of frame -->
                        <Border x:Name="CascadeSlotM3" Classes="pile-card" Canvas.Left="-31" Canvas.Top="-96" Width="208" Height="208" ZIndex="2"
                                RenderTransform="rotate(-18deg)"
                                IsVisible="{Binding EdgePreviousArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding EdgePreviousArtworkPath}" DecodeWidth="256" Stretch="UniformToFill"/>
                                <Border x:Name="CascadeWashM3" Background="#000" Opacity="0.30"/>
                            </Panel>
                        </Border>
                        <!-- −2: top, leaning hard, cut by the page edge -->
                        <Border x:Name="CascadeSlotM2" Classes="pile-card" Canvas.Left="198" Canvas.Top="-65" Width="250" Height="250" ZIndex="4"
                                RenderTransform="rotate(-33deg)"
                                IsVisible="{Binding FarPreviousArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding FarPreviousArtworkPath}" DecodeWidth="512" Stretch="UniformToFill"/>
                                <Border x:Name="CascadeWashM2" Background="#000" Opacity="0.18"/>
                            </Panel>
                        </Border>
                        <!-- −1: tucked under the playing cover's top-left corner -->
                        <Border x:Name="CascadeSlotM1" Classes="pile-card" Canvas.Left="432" Canvas.Top="76" Width="260" Height="260" ZIndex="6"
                                RenderTransform="rotate(-20deg)"
                                IsVisible="{Binding PreviousArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding PreviousArtworkPath}" DecodeWidth="512" Stretch="UniformToFill"/>
                                <Border x:Name="CascadeWashM1" Background="#000" Opacity="0.08"/>
                            </Panel>
                        </Border>

                        <!-- ── Up next: falls away below the playing cover, in from the bottom ── -->
                        <!-- +1: tucked under the playing cover's bottom-left corner -->
                        <Border x:Name="CascadeSlotP1" Classes="pile-card" Canvas.Left="427" Canvas.Top="685" Width="250" Height="250" ZIndex="6"
                                RenderTransform="rotate(25deg)"
                                IsVisible="{Binding NextArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding NextArtworkPath}" DecodeWidth="512" Stretch="UniformToFill"/>
                                <Border x:Name="CascadeWashP1" Background="#000" Opacity="0.08"/>
                            </Panel>
                        </Border>
                        <!-- +2: bottom, drifting left, cut by the page edge -->
                        <Border x:Name="CascadeSlotP2" Classes="pile-card" Canvas.Left="209" Canvas.Top="832" Width="270" Height="270" ZIndex="4"
                                RenderTransform="rotate(-18deg)"
                                IsVisible="{Binding FarNextArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding FarNextArtworkPath}" DecodeWidth="512" Stretch="UniformToFill"/>
                                <Border x:Name="CascadeWashP2" Background="#000" Opacity="0.18"/>
                            </Panel>
                        </Border>
                        <!-- +3: bottom-left, mostly out of frame -->
                        <Border x:Name="CascadeSlotP3" Classes="pile-card" Canvas.Left="-52" Canvas.Top="873" Width="250" Height="250" ZIndex="2"
                                RenderTransform="rotate(12deg)"
                                IsVisible="{Binding EdgeNextArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding EdgeNextArtworkPath}" DecodeWidth="256" Stretch="UniformToFill"/>
                                <Border x:Name="CascadeWashP3" Background="#000" Opacity="0.30"/>
                            </Panel>
                        </Border>

                        <!-- ═══ NOW PLAYING: straight, largest, on top; its right edge IS the canvas edge ═══ -->
                        <Border x:Name="CascadeCenterCover"
                                Canvas.Left="520" Canvas.Top="268" Width="480" Height="480" ZIndex="15"
                                CornerRadius="14" ClipToBounds="True"
                                BoxShadow="0 24 70 0 #80000000">
                            <Panel>
                                <TextBlock Text="{loc:T CoverFlow.Text}"
                                           FontSize="100"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.15"
                                           IsVisible="{Binding CenterArtworkPath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                <ctrl:CachedImage SourcePath="{Binding CenterArtworkPath}"
                                                  DecodeWidth="768"
                                                  Stretch="UniformToFill"
                                                  RenderOptions.BitmapInterpolationMode="HighQuality"
                                                  IsVisible="{Binding CenterArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <ctrl:AnimatedCoverImage
                                    Source="{Binding Player.CurrentAnimatedCoverPath}"
                                    IsActive="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Settings.EnableAnimatedCovers, FallbackValue=False}" />
                                <Border x:Name="CascadeWash0" Background="#000" Opacity="0" IsHitTestVisible="False"/>
                                <!-- Favorite heart overlay on the playing cover -->
                                <ctrl:HeartIcon Size="24" ShowWhenOff="False"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"
                                                IsFavorite="{Binding CenterIsFavorite}" />
                            </Panel>
                        </Border>
                    </Canvas>
                </Viewbox>

                <!-- ═══ NOW-PLAYING COLUMN ═══ -->
                <StackPanel x:Name="InfoStack"
                            Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            MaxWidth="600"
                            Margin="48,0,40,0"
                            Spacing="6">
                    <TextBlock Text="{loc:T CoverFlow.NOWPLAYING}"
                               FontSize="11" FontWeight="SemiBold"
                               LetterSpacing="2" Opacity="0.45"
                               Margin="1,0,0,6"/>
                    <ctrl:MarqueeTextBlock x:Name="TitleMarquee"
                                           Text="{Binding CenterTitle}"
                                           FontSize="40"
                                           FontWeight="Bold"
                                           MaxDisplayWidth="540"
                                           HorizontalAlignment="Left"
                                           IsCoverFlow="True">
                        <ctrl:MarqueeTextBlock.InlineContent>
                            <Border Classes="explicit-badge compact"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding CenterIsExplicit}"
                                    ToolTip.Tip="{loc:T CoverFlow.ExplicitTip}">
                                <TextBlock Text="E"
                                           Classes="explicit-badge-text compact"
                                           FontSize="8"
                                           Opacity="0.9" />
                            </Border>
                        </ctrl:MarqueeTextBlock.InlineContent>
                    </ctrl:MarqueeTextBlock>
                    <Button x:Name="ArtistLink"
                            Classes="link-btn"
                            Command="{Binding GoToArtistCommand}"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding CenterArtist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <ctrl:MarqueeTextBlock Text="{Binding CenterArtist}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentColorBrush}"
                                               MaxDisplayWidth="540"
                                               IsCoverFlow="True"
                                               IsForArtist="True" />
                    </Button>
                    <Button x:Name="AlbumLink"
                            Classes="link-btn"
                            Command="{Binding GoToAlbumCommand}"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding CenterAlbum.Length}">
                        <ctrl:MarqueeTextBlock Text="{Binding CenterAlbum}"
                                               FontSize="17"
                                               Foreground="{DynamicResource AccentColorBrush}"
                                               Opacity="0.85"
                                               MaxDisplayWidth="540"
                                               IsCoverFlow="True"
                                               IsForAlbum="True" />
                    </Button>

                    <!-- Up next: the +1 card's track, so the pile has a caption. -->
                    <StackPanel x:Name="UpNextStack"
                                Spacing="2" Margin="1,26,0,0"
                                IsVisible="{Binding NextTrack, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{loc:T CoverFlow.UPNEXT}"
                                   FontSize="11" FontWeight="SemiBold"
                                   LetterSpacing="2" Opacity="0.45"/>
                        <TextBlock FontSize="14" Opacity="0.75"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="540" HorizontalAlignment="Left">
                            <Run Text="{Binding NextTrack.TitleDisplay, FallbackValue=''}" FontWeight="SemiBold"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding NextTrack.ArtistDisplay, FallbackValue=''}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

            </Grid>

            <!-- Empty state when nothing is playing -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        IsVisible="{Binding ShowEmptyState}">
                <TextBlock Text="{loc:T CoverFlow.NothingPlaying}"
                           FontSize="20"
                           Opacity="0.4"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <TextBlock Text="{loc:T CoverFlow.PlaySomeMusicSee}"
                           FontSize="13"
                           Opacity="0.25"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>

        </Grid>

    </Grid>

</UserControl>
