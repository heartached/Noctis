<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:vm="using:Noctis.ViewModels"
             xmlns:m="using:Noctis.Models"
             xmlns:ctrl="using:Noctis.Controls"
             x:Class="Noctis.Views.CoverFlowView"
             x:DataType="vm:CoverFlowViewModel"
             Background="{DynamicResource AppMainBackground}"
             Focusable="True"
             ClipToBounds="True">

    <UserControl.Styles>
        <Style Selector="Button.link-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.link-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <!-- Kill the default Fluent hover/press square behind the arrow glyph -->
        <Style Selector="Button.link-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.link-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <!-- Override global Button:pointerover zoom — link buttons in cover flow stay still on hover -->
        <Style Selector="Button.link-btn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.link-btn:pressed">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>

        <!-- Carousel cards (CoverFlowCard): pivot tilt/scale about the card centre. -->
        <Style Selector="ctrl|CoverFlowCard.flow-card">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Collage up-next tiles (GitHub #153): the cover, its heart, and a title/artist
             caption that shows on hover; a click plays the track (code-behind, Tag). -->
        <Style Selector="Button.collage-tile">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="TileFrame" CornerRadius="6" ClipToBounds="True"
                            BoxShadow="0 8 22 0 #5E000000">
                        <ContentPresenter x:Name="TileContent"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="ContentTemplate">
                <DataTemplate x:DataType="m:Track">
                    <Panel>
                        <Border Background="#2A2A31"/>
                        <ctrl:CachedImage SourcePath="{Binding AlbumArtworkPath}" Stretch="UniformToFill"/>
                        <!-- Long names scroll like the player bar's (Cover Flow text-animation
                             settings); the caption is hidden off-hover, which also pauses them. -->
                        <Border Classes="collage-caption">
                            <StackPanel Spacing="1">
                                <ctrl:MarqueeTextBlock Text="{Binding TitleDisplay}" HorizontalAlignment="Left" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="White" IsCoverFlow="True">
                                    <ctrl:MarqueeTextBlock.InlineContent>
                                        <Border Classes="explicit-badge compact" VerticalAlignment="Center"
                                                IsVisible="{Binding IsExplicit}">
                                            <TextBlock Text="E" Classes="explicit-badge-text compact" FontSize="8" Opacity="0.9"/>
                                        </Border>
                                    </ctrl:MarqueeTextBlock.InlineContent>
                                </ctrl:MarqueeTextBlock>
                                <ctrl:MarqueeTextBlock Text="{Binding ArtistDisplay}" HorizontalAlignment="Left" FontSize="11"
                                                       Foreground="White" Opacity="0.8"
                                                       IsCoverFlow="True" IsForArtist="True"/>
                            </StackPanel>
                        </Border>
                        <!-- Size / Margin per tile size: the s* styles below -->
                        <ctrl:HeartIcon ShowWhenOff="False"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        IsFavorite="{Binding IsFavorite}"/>
                    </Panel>
                </DataTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.collage-tile.s140 /template/ Border#TileFrame, Button.collage-tile.s110 /template/ Border#TileFrame">
            <Setter Property="BoxShadow" Value="0 7 20 0 #5A000000"/>
        </Style>
        <Style Selector="Button.collage-tile.s90 /template/ Border#TileFrame">
            <Setter Property="BoxShadow" Value="0 6 18 0 #5A000000"/>
        </Style>
        <Style Selector="Button.collage-tile ctrl|HeartIcon">
            <Setter Property="Size" Value="16"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style Selector="Button.collage-tile.s200 ctrl|HeartIcon">
            <Setter Property="Size" Value="18"/>
            <Setter Property="Margin" Value="0,0,9,9"/>
        </Style>
        <Style Selector="Button.collage-tile.s140 ctrl|HeartIcon">
            <Setter Property="Size" Value="14"/>
            <Setter Property="Margin" Value="0,0,7,7"/>
        </Style>
        <Style Selector="Button.collage-tile.s110 ctrl|HeartIcon">
            <Setter Property="Size" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style Selector="Button.collage-tile.s90 ctrl|HeartIcon">
            <Setter Property="Size" Value="11"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
        </Style>
        <Style Selector="Button.collage-tile:pointerover ctrl|HeartIcon, Button.collage-tile:focus-visible ctrl|HeartIcon">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <!-- Caption width per tile size (tile minus the caption's 8 px sides) -->
        <Style Selector="Button.collage-tile ctrl|MarqueeTextBlock">
            <Setter Property="MaxDisplayWidth" Value="154"/>
        </Style>
        <Style Selector="Button.collage-tile.s200 ctrl|MarqueeTextBlock">
            <Setter Property="MaxDisplayWidth" Value="184"/>
        </Style>
        <Style Selector="Button.collage-tile.s140 ctrl|MarqueeTextBlock">
            <Setter Property="MaxDisplayWidth" Value="124"/>
        </Style>
        <Style Selector="Button.collage-tile.s110 ctrl|MarqueeTextBlock">
            <Setter Property="MaxDisplayWidth" Value="94"/>
        </Style>
        <Style Selector="Button.collage-tile.s90 ctrl|MarqueeTextBlock">
            <Setter Property="MaxDisplayWidth" Value="74"/>
        </Style>
        <Style Selector="Border.collage-caption">
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Padding" Value="8,20,8,7"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#C8000000" Offset="1"/>
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.collage-caption.playing, Button.collage-tile:pointerover Border.collage-caption, Button.collage-tile:focus-visible Border.collage-caption">
            <Setter Property="IsVisible" Value="True"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Tilted cards in the now-playing pile. Rotation is per-card (RenderTransform
             on the element); this holds the shared shape. No hover/transition on purpose. -->
        <Style Selector="Border.pile-card">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="BoxShadow" Value="0 14 40 0 #70000000"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*">

        <!-- Blurred background: the CURRENT cover, heavily blurred and darkened, behind
             every layout (carousel, cascade and, since GitHub #153, the collage). Two
             stacked copies: on a track change the code-behind points the hidden one at the new cover and swaps their opacities,
             and the Opacity transitions crossfade them (CrossfadeBackground). Both decode
             at 768 so they share the centre card's ArtworkCache entry. -->
        <Panel x:Name="BlurredBackground" Grid.Row="0" IsHitTestVisible="False">
            <ctrl:CachedImage x:Name="BackgroundArtA"
                              DecodeWidth="768"
                              Stretch="UniformToFill"
                              Opacity="0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                <ctrl:CachedImage.Effect>
                    <BlurEffect Radius="48" />
                </ctrl:CachedImage.Effect>
                <ctrl:CachedImage.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.4" />
                    </Transitions>
                </ctrl:CachedImage.Transitions>
            </ctrl:CachedImage>
            <ctrl:CachedImage x:Name="BackgroundArtB"
                              DecodeWidth="768"
                              Stretch="UniformToFill"
                              Opacity="0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                <ctrl:CachedImage.Effect>
                    <BlurEffect Radius="48" />
                </ctrl:CachedImage.Effect>
                <ctrl:CachedImage.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.4" />
                    </Transitions>
                </ctrl:CachedImage.Transitions>
            </ctrl:CachedImage>
            <!-- Darkening wash so the light glass cards pop (both themes: the page is a
                 cover-art hero, so it darkens rather than whitens on the light theme). -->
            <Border x:Name="BackgroundOverlay" Background="#000000" Opacity="0.45" />
        </Panel>

        <!-- Main content: carousel + text stacked vertically. The four layouts (CollageViewbox,
             CarouselHost, StageGrid, EmptyState) and the two backgrounds have no IsVisible
             bindings: the code-behind shows them so a layout switch can morph old into new
             (SwitchLayout / CoverFlowLayoutMorph). -->
        <Grid Grid.Row="0" Margin="0,24,0,12">

            <!-- ══ Album-art collage of the queue ══
                 Fixed 1410×540 design canvas, scaled down to fit on smaller windows and centred.
                 A tidy column masonry of up to 32 covers: covers in a column share a width and
                 left edge (so they line up), columns get larger toward the centre and smaller
                 toward the edges. Slots fill from the now-playing track outward through UpNext.
                 GitHub #153: the playing tile carries an accent ring, a "now playing" mark and
                 its title/artist; every up-next tile (Button.collage-tile, Tag = its place in
                 the queue) shows its title/artist on hover and plays that track on click. -->
            <Viewbox x:Name="CollageViewbox"
                     Stretch="Uniform"
                     MaxWidth="1900" MaxHeight="760"
                     Margin="24,24,24,140"
                     IsVisible="False">
                <Canvas Width="1410" Height="540">

                    <!-- ═══ Centre column (200): now-playing + next ═══ -->
                    <Border x:Name="CollageCenterCover" Canvas.Left="604" Canvas.Top="62" Width="200" Height="200" CornerRadius="6" ClipToBounds="True"
                            BoxShadow="0 8 22 0 #5E000000"
                            IsVisible="{Binding CenterTrack, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Panel>
                            <Border Background="#2A2A31"/>
                            <ctrl:CachedImage SourcePath="{Binding CenterTrack.AlbumArtworkPath}" Stretch="UniformToFill"/>
                            <!-- Animated cover for the now-playing tile (same control/setting as the carousel) -->
                            <ctrl:AnimatedCoverImage
                                Source="{Binding Player.CurrentAnimatedCoverPath}"
                                IsActive="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Settings.EnableAnimatedCovers, FallbackValue=False}" />
                            <!-- GitHub #153: the playing tile says so and names its song -->
                            <Border Classes="collage-caption playing">
                                <StackPanel Spacing="1">
                                    <ctrl:MarqueeTextBlock Text="{Binding CenterTrack.TitleDisplay, FallbackValue=''}" HorizontalAlignment="Left" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="White" MaxDisplayWidth="184" IsCoverFlow="True">
                                        <ctrl:MarqueeTextBlock.InlineContent>
                                            <Border Classes="explicit-badge compact" VerticalAlignment="Center"
                                                    IsVisible="{Binding CenterTrack.IsExplicit, FallbackValue=False}">
                                                <TextBlock Text="E" Classes="explicit-badge-text compact" FontSize="8" Opacity="0.9"/>
                                            </Border>
                                        </ctrl:MarqueeTextBlock.InlineContent>
                                    </ctrl:MarqueeTextBlock>
                                    <ctrl:MarqueeTextBlock Text="{Binding CenterTrack.ArtistDisplay, FallbackValue=''}" HorizontalAlignment="Left" FontSize="12"
                                                           Foreground="White" Opacity="0.8" MaxDisplayWidth="184"
                                                           IsCoverFlow="True" IsForArtist="True"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource AccentColorBrush}" CornerRadius="8" Padding="7,2"
                                    Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    BoxShadow="0 2 8 0 #66000000">
                                <TextBlock Text="{loc:T CoverFlow.NOWPLAYING}" FontSize="9" FontWeight="SemiBold"
                                           LetterSpacing="1.2" Foreground="White"/>
                            </Border>
                            <ctrl:HeartIcon Size="18" ShowWhenOff="False"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,9,0"
                                            IsFavorite="{Binding CenterTrack.IsFavorite, FallbackValue=False}"/>
                            <Border CornerRadius="6" BorderThickness="3" BorderBrush="{DynamicResource AccentColorBrush}"/>
                        </Panel>
                    </Border>
                    <Button Classes="collage-tile s200" Tag="1"
                            Canvas.Left="604" Canvas.Top="278" Width="200" Height="200"
                            Content="{Binding NextTrack}"
                            AutomationProperties.Name="{Binding NextTrack.Title, FallbackValue=''}"
                            IsVisible="{Binding NextTrack, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                    <!-- ═══ Inner columns (170) ═══ -->
                    <Button Classes="collage-tile s170" Tag="2"
                            Canvas.Left="418" Canvas.Top="1" Width="170" Height="170"
                            Content="{Binding FarNextTrack}"
                            AutomationProperties.Name="{Binding FarNextTrack.Title, FallbackValue=''}"
                            IsVisible="{Binding FarNextTrack, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s170" Tag="3"
                            Canvas.Left="418" Canvas.Top="185" Width="170" Height="170"
                            Content="{Binding EdgeNextTrack}"
                            AutomationProperties.Name="{Binding EdgeNextTrack.Title, FallbackValue=''}"
                            IsVisible="{Binding EdgeNextTrack, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s170" Tag="4"
                            Canvas.Left="418" Canvas.Top="369" Width="170" Height="170"
                            Content="{Binding OffNextTrack}"
                            AutomationProperties.Name="{Binding OffNextTrack.Title, FallbackValue=''}"
                            IsVisible="{Binding OffNextTrack, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s170" Tag="5"
                            Canvas.Left="820" Canvas.Top="1" Width="170" Height="170"
                            Content="{Binding Next5Track}"
                            AutomationProperties.Name="{Binding Next5Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next5Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s170" Tag="6"
                            Canvas.Left="820" Canvas.Top="185" Width="170" Height="170"
                            Content="{Binding Next6Track}"
                            AutomationProperties.Name="{Binding Next6Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next6Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s170" Tag="7"
                            Canvas.Left="820" Canvas.Top="369" Width="170" Height="170"
                            Content="{Binding Next7Track}"
                            AutomationProperties.Name="{Binding Next7Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next7Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                    <!-- ═══ Mid columns (140) ═══ -->
                    <Button Classes="collage-tile s140" Tag="8"
                            Canvas.Left="262" Canvas.Top="44" Width="140" Height="140"
                            Content="{Binding Next8Track}"
                            AutomationProperties.Name="{Binding Next8Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next8Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s140" Tag="9"
                            Canvas.Left="262" Canvas.Top="200" Width="140" Height="140"
                            Content="{Binding Next9Track}"
                            AutomationProperties.Name="{Binding Next9Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next9Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s140" Tag="10"
                            Canvas.Left="262" Canvas.Top="356" Width="140" Height="140"
                            Content="{Binding Next10Track}"
                            AutomationProperties.Name="{Binding Next10Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next10Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s140" Tag="11"
                            Canvas.Left="1006" Canvas.Top="44" Width="140" Height="140"
                            Content="{Binding Next11Track}"
                            AutomationProperties.Name="{Binding Next11Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next11Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s140" Tag="12"
                            Canvas.Left="1006" Canvas.Top="200" Width="140" Height="140"
                            Content="{Binding Next12Track}"
                            AutomationProperties.Name="{Binding Next12Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next12Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s140" Tag="13"
                            Canvas.Left="1006" Canvas.Top="356" Width="140" Height="140"
                            Content="{Binding Next13Track}"
                            AutomationProperties.Name="{Binding Next13Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next13Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                    <!-- ═══ Outer columns (110) ═══ -->
                    <Button Classes="collage-tile s110" Tag="14"
                            Canvas.Left="136" Canvas.Top="26" Width="110" Height="110"
                            Content="{Binding Next14Track}"
                            AutomationProperties.Name="{Binding Next14Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next14Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s110" Tag="15"
                            Canvas.Left="136" Canvas.Top="152" Width="110" Height="110"
                            Content="{Binding Next15Track}"
                            AutomationProperties.Name="{Binding Next15Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next15Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s110" Tag="16"
                            Canvas.Left="136" Canvas.Top="278" Width="110" Height="110"
                            Content="{Binding Next16Track}"
                            AutomationProperties.Name="{Binding Next16Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next16Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s110" Tag="17"
                            Canvas.Left="136" Canvas.Top="404" Width="110" Height="110"
                            Content="{Binding Next17Track}"
                            AutomationProperties.Name="{Binding Next17Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next17Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s110" Tag="18"
                            Canvas.Left="1162" Canvas.Top="26" Width="110" Height="110"
                            Content="{Binding Next18Track}"
                            AutomationProperties.Name="{Binding Next18Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next18Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s110" Tag="19"
                            Canvas.Left="1162" Canvas.Top="152" Width="110" Height="110"
                            Content="{Binding Next19Track}"
                            AutomationProperties.Name="{Binding Next19Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next19Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s110" Tag="20"
                            Canvas.Left="1162" Canvas.Top="278" Width="110" Height="110"
                            Content="{Binding Next20Track}"
                            AutomationProperties.Name="{Binding Next20Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next20Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s110" Tag="21"
                            Canvas.Left="1162" Canvas.Top="404" Width="110" Height="110"
                            Content="{Binding Next21Track}"
                            AutomationProperties.Name="{Binding Next21Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next21Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                    <!-- ═══ Edge columns (90) ═══ -->
                    <Button Classes="collage-tile s90" Tag="22"
                            Canvas.Left="30" Canvas.Top="13" Width="90" Height="90"
                            Content="{Binding Next22Track}"
                            AutomationProperties.Name="{Binding Next22Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next22Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s90" Tag="23"
                            Canvas.Left="30" Canvas.Top="119" Width="90" Height="90"
                            Content="{Binding Next23Track}"
                            AutomationProperties.Name="{Binding Next23Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next23Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s90" Tag="24"
                            Canvas.Left="30" Canvas.Top="225" Width="90" Height="90"
                            Content="{Binding Next24Track}"
                            AutomationProperties.Name="{Binding Next24Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next24Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s90" Tag="25"
                            Canvas.Left="30" Canvas.Top="331" Width="90" Height="90"
                            Content="{Binding Next25Track}"
                            AutomationProperties.Name="{Binding Next25Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next25Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s90" Tag="26"
                            Canvas.Left="30" Canvas.Top="437" Width="90" Height="90"
                            Content="{Binding Next26Track}"
                            AutomationProperties.Name="{Binding Next26Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next26Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s90" Tag="27"
                            Canvas.Left="1288" Canvas.Top="13" Width="90" Height="90"
                            Content="{Binding Next27Track}"
                            AutomationProperties.Name="{Binding Next27Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next27Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s90" Tag="28"
                            Canvas.Left="1288" Canvas.Top="119" Width="90" Height="90"
                            Content="{Binding Next28Track}"
                            AutomationProperties.Name="{Binding Next28Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next28Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s90" Tag="29"
                            Canvas.Left="1288" Canvas.Top="225" Width="90" Height="90"
                            Content="{Binding Next29Track}"
                            AutomationProperties.Name="{Binding Next29Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next29Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s90" Tag="30"
                            Canvas.Left="1288" Canvas.Top="331" Width="90" Height="90"
                            Content="{Binding Next30Track}"
                            AutomationProperties.Name="{Binding Next30Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next30Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Classes="collage-tile s90" Tag="31"
                            Canvas.Left="1288" Canvas.Top="437" Width="90" Height="90"
                            Content="{Binding Next31Track}"
                            AutomationProperties.Name="{Binding Next31Track.Title, FallbackValue=''}"
                            IsVisible="{Binding Next31Track, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </Canvas>
            </Viewbox>

            <!-- ═══ CAROUSEL: five glass cards (queue-driven; hidden in collage mode) ═══
                 Centre = the playing track, −1/−2 = history to its left, +1/+2 = up next
                 to its right. Every slot is a CoverFlowCard (light frosted slab, cover
                 inset on top, title/artist caption inside), all 300px so the caption type
                 matches. The slot GEOMETRY lives in CoverFlowCarouselGeometry and is applied
                 by the code-behind (SetPose): a 3D tilt turning each side card's OUTER
                 edge toward the viewer (Rotate3DTransform + perspective Depth), a
                 scale-down, a slide out, a dim and an opacity per slot, every card SIDE BY
                 SIDE with a fixed gap, never overlapping (09-22 mockup). On a skip the content swaps one slot over
                 by binding and the code-behind slides every card from its previous slot's
                 pose to its own (ease-out cubic, ~360ms). Wheel (one card per notch), drag,
                 ← → and a click on a side card BROWSE the row without touching playback
                 (GitHub #152; the cards bind to the view model's Row, centred on the browsed
                 card). A click on the centred card plays it; its title link opens the album
                 when it is the playing track. Esc / Home slide back to the playing track,
                 whose card carries a "now playing" mark while it is off-centre. With Repeat
                 All on the row runs round. Only these fifteen controls exist — nothing
                 further out is realised. The host cancels the page inset (24 top / 12
                 bottom) with negative margins so the midline is the true page centre. -->
            <Grid x:Name="CarouselHost"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  Height="420"
                  Margin="0,-24,0,-12"
                  Background="Transparent">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      ClipToBounds="False">







                    <!-- −7..−5 (history): drawn small, so decoded small -->
                    <ctrl:CoverFlowCard x:Name="SlotPrev7"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        DecodeWidth="256"
                                        ArtworkPath="{Binding Row[0].Track.AlbumArtworkPath, FallbackValue={x:Null}}"
                                        Title="{Binding Row[0].Track.Title, FallbackValue=''}"
                                        Artist="{Binding Row[0].Track.ArtistDisplay, FallbackValue=''}"
                                        IsExplicit="{Binding Row[0].Track.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding Row[0].Track, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        IsPlaying="{Binding Row[0].IsMarked}" />
                    <ctrl:CoverFlowCard x:Name="SlotPrev6"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        DecodeWidth="256"
                                        ArtworkPath="{Binding Row[1].Track.AlbumArtworkPath, FallbackValue={x:Null}}"
                                        Title="{Binding Row[1].Track.Title, FallbackValue=''}"
                                        Artist="{Binding Row[1].Track.ArtistDisplay, FallbackValue=''}"
                                        IsExplicit="{Binding Row[1].Track.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding Row[1].Track, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        IsPlaying="{Binding Row[1].IsMarked}" />
                    <ctrl:CoverFlowCard x:Name="SlotPrev5"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        DecodeWidth="256"
                                        ArtworkPath="{Binding Row[2].Track.AlbumArtworkPath, FallbackValue={x:Null}}"
                                        Title="{Binding Row[2].Track.Title, FallbackValue=''}"
                                        Artist="{Binding Row[2].Track.ArtistDisplay, FallbackValue=''}"
                                        IsExplicit="{Binding Row[2].Track.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding Row[2].Track, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        IsPlaying="{Binding Row[2].IsMarked}" />

                    <!-- −4 (history) -->
                    <ctrl:CoverFlowCard x:Name="SlotPrev4"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        ArtworkPath="{Binding Row[3].Track.AlbumArtworkPath, FallbackValue={x:Null}}"
                                        Title="{Binding Row[3].Track.Title, FallbackValue=''}"
                                        Artist="{Binding Row[3].Track.ArtistDisplay, FallbackValue=''}"
                                        IsExplicit="{Binding Row[3].Track.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding Row[3].Track, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        IsPlaying="{Binding Row[3].IsMarked}" />

                    <!-- −3 (history) -->
                    <ctrl:CoverFlowCard x:Name="SlotPrev3"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        ArtworkPath="{Binding Row[4].Track.AlbumArtworkPath, FallbackValue={x:Null}}"
                                        Title="{Binding Row[4].Track.Title, FallbackValue=''}"
                                        Artist="{Binding Row[4].Track.ArtistDisplay, FallbackValue=''}"
                                        IsExplicit="{Binding Row[4].Track.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding Row[4].Track, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        IsPlaying="{Binding Row[4].IsMarked}" />

                    <!-- −2 (history) -->
                    <ctrl:CoverFlowCard x:Name="SlotPrev2"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        ArtworkPath="{Binding Row[5].Track.AlbumArtworkPath, FallbackValue={x:Null}}"
                                        Title="{Binding Row[5].Track.Title, FallbackValue=''}"
                                        Artist="{Binding Row[5].Track.ArtistDisplay, FallbackValue=''}"
                                        IsExplicit="{Binding Row[5].Track.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding Row[5].Track, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        IsPlaying="{Binding Row[5].IsMarked}" />

                    <!-- −1 (history) -->
                    <ctrl:CoverFlowCard x:Name="SlotPrev1"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        ArtworkPath="{Binding Row[6].Track.AlbumArtworkPath, FallbackValue={x:Null}}"
                                        Title="{Binding Row[6].Track.Title, FallbackValue=''}"
                                        Artist="{Binding Row[6].Track.ArtistDisplay, FallbackValue=''}"
                                        IsExplicit="{Binding Row[6].Track.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding Row[6].Track, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        IsPlaying="{Binding Row[6].IsMarked}" />

                    <!-- 0 (the centred card: the playing track unless the row was browsed) -->
                    <ctrl:CoverFlowCard x:Name="CenterCard"
                                        Classes="flow-card centre"
                                        ArtworkSize="300"
                                        DecodeWidth="768"
                                        ArtworkPath="{Binding Row[7].Track.AlbumArtworkPath, FallbackValue={x:Null}}"
                                        Title="{Binding Row[7].Track.Title, FallbackValue=''}"
                                        Artist="{Binding Row[7].Track.ArtistDisplay, FallbackValue=''}"
                                        IsExplicit="{Binding Row[7].Track.IsExplicit, FallbackValue=False}"
                                        TitleToolTip="{loc:T PlaybackBar.ViewAlbumTip}"
                                        ArtistCommand="{Binding GoToFocusedArtistCommand}">
                        <ctrl:CoverFlowCard.Overlay>
                            <Panel>
                                <!-- The animated cover belongs to the playing track only -->
                                <ctrl:AnimatedCoverImage
                                    Source="{Binding Player.CurrentAnimatedCoverPath}"
                                    IsVisible="{Binding Row[7].IsPlaying}"
                                    IsActive="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Settings.EnableAnimatedCovers, FallbackValue=False}" />
                                <!-- Favorite heart overlay on the centre cover -->
                                <ctrl:HeartIcon Size="24" ShowWhenOff="False"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"
                                                IsFavorite="{Binding Row[7].Track.IsFavorite, FallbackValue=False}" />
                            </Panel>
                        </ctrl:CoverFlowCard.Overlay>
                    </ctrl:CoverFlowCard>

                    <!-- +1 (up next) -->
                    <ctrl:CoverFlowCard x:Name="SlotNext1"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        ArtworkPath="{Binding Row[8].Track.AlbumArtworkPath, FallbackValue={x:Null}}"
                                        Title="{Binding Row[8].Track.Title, FallbackValue=''}"
                                        Artist="{Binding Row[8].Track.ArtistDisplay, FallbackValue=''}"
                                        IsExplicit="{Binding Row[8].Track.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding Row[8].Track, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        IsPlaying="{Binding Row[8].IsMarked}" />

                    <!-- +2 (up next) -->
                    <ctrl:CoverFlowCard x:Name="SlotNext2"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        ArtworkPath="{Binding Row[9].Track.AlbumArtworkPath, FallbackValue={x:Null}}"
                                        Title="{Binding Row[9].Track.Title, FallbackValue=''}"
                                        Artist="{Binding Row[9].Track.ArtistDisplay, FallbackValue=''}"
                                        IsExplicit="{Binding Row[9].Track.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding Row[9].Track, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        IsPlaying="{Binding Row[9].IsMarked}" />

                    <!-- +3 (up next) -->
                    <ctrl:CoverFlowCard x:Name="SlotNext3"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        ArtworkPath="{Binding Row[10].Track.AlbumArtworkPath, FallbackValue={x:Null}}"
                                        Title="{Binding Row[10].Track.Title, FallbackValue=''}"
                                        Artist="{Binding Row[10].Track.ArtistDisplay, FallbackValue=''}"
                                        IsExplicit="{Binding Row[10].Track.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding Row[10].Track, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        IsPlaying="{Binding Row[10].IsMarked}" />

                    <!-- +4 (up next) -->
                    <ctrl:CoverFlowCard x:Name="SlotNext4"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        ArtworkPath="{Binding Row[11].Track.AlbumArtworkPath, FallbackValue={x:Null}}"
                                        Title="{Binding Row[11].Track.Title, FallbackValue=''}"
                                        Artist="{Binding Row[11].Track.ArtistDisplay, FallbackValue=''}"
                                        IsExplicit="{Binding Row[11].Track.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding Row[11].Track, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        IsPlaying="{Binding Row[11].IsMarked}" />

                    <!-- +5..+7 (up next): drawn small, so decoded small -->
                    <ctrl:CoverFlowCard x:Name="SlotNext5"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        DecodeWidth="256"
                                        ArtworkPath="{Binding Row[12].Track.AlbumArtworkPath, FallbackValue={x:Null}}"
                                        Title="{Binding Row[12].Track.Title, FallbackValue=''}"
                                        Artist="{Binding Row[12].Track.ArtistDisplay, FallbackValue=''}"
                                        IsExplicit="{Binding Row[12].Track.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding Row[12].Track, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        IsPlaying="{Binding Row[12].IsMarked}" />
                    <ctrl:CoverFlowCard x:Name="SlotNext6"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        DecodeWidth="256"
                                        ArtworkPath="{Binding Row[13].Track.AlbumArtworkPath, FallbackValue={x:Null}}"
                                        Title="{Binding Row[13].Track.Title, FallbackValue=''}"
                                        Artist="{Binding Row[13].Track.ArtistDisplay, FallbackValue=''}"
                                        IsExplicit="{Binding Row[13].Track.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding Row[13].Track, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        IsPlaying="{Binding Row[13].IsMarked}" />
                    <ctrl:CoverFlowCard x:Name="SlotNext7"
                                        Classes="flow-card side"
                                        ArtworkSize="300"
                                        DecodeWidth="256"
                                        ArtworkPath="{Binding Row[14].Track.AlbumArtworkPath, FallbackValue={x:Null}}"
                                        Title="{Binding Row[14].Track.Title, FallbackValue=''}"
                                        Artist="{Binding Row[14].Track.ArtistDisplay, FallbackValue=''}"
                                        IsExplicit="{Binding Row[14].Track.IsExplicit, FallbackValue=False}"
                                        IsVisible="{Binding Row[14].Track, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        IsPlaying="{Binding Row[14].IsMarked}" />






                </Grid>
            </Grid>

            <!-- ═══ CASCADE: diagonal path + now-playing column ═══
                 Community mockup (Mistery, Discord 2026-08-29). The covers sit on ONE
                 ordered path that bows out to the right: history climbs away above the
                 playing cover toward the top-left corner, up-next falls away below it
                 toward the bottom-left corner. Skipping a track therefore moves every
                 card one step along the path (down for next, up for previous) — the same
                 fixed-slot content swap the carousel does, just on a curve. Nothing is
                 random. On a skip the code-behind slides every card along the path from
                 the slot it came from to its own (CoverFlowCascadeGeometry, same RAF loop
                 and ease as the carousel; the old Avalonia transitions were removed for
                 lag). No hover, pile not hit-testable.

                 Geometry: a 1000×1000 design canvas whose RIGHT edge is the playing
                 cover's right edge, so the text column hugs the cover like the mockup.
                 Code-behind sizes the Viewbox to a SQUARE as tall as the page (negative
                 margins cancel the page inset), so the canvas maps 1:1 onto the column
                 and the outer cards run off the top and in from the bottom, cut by the
                 page edge itself — nothing clips in mid-air (no Canvas/Viewbox clip; the
                 UserControl's ClipToBounds does it). StageGrid: pile | text; code-behind
                 drops the text under the pile below ~1040px (see OnSizeChanged). -->
            <Grid x:Name="StageGrid"
                  ColumnDefinitions="Auto,*" RowDefinitions="*,Auto"
                  IsVisible="False">

                <Viewbox x:Name="PileViewbox"
                         Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                         Stretch="Uniform"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         Margin="0,-24,0,-12">
                    <Canvas Width="1000" Height="1000">

                        <!-- ── History: climbs away above the playing cover, off the top ── -->
                        <!-- −3: top-left, mostly out of frame -->
                        <Border x:Name="CascadeSlotM3" Classes="pile-card" Canvas.Left="-31" Canvas.Top="-96" Width="208" Height="208" ZIndex="2"
                                RenderTransform="rotate(-18deg)"
                                IsVisible="{Binding EdgePreviousArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding EdgePreviousArtworkPath}" DecodeWidth="256" Stretch="UniformToFill"/>
                                <Border x:Name="CascadeWashM3" Background="#000" Opacity="0.30"/>
                            </Panel>
                        </Border>
                        <!-- −2: top, leaning hard, cut by the page edge -->
                        <Border x:Name="CascadeSlotM2" Classes="pile-card" Canvas.Left="198" Canvas.Top="-65" Width="250" Height="250" ZIndex="4"
                                RenderTransform="rotate(-33deg)"
                                IsVisible="{Binding FarPreviousArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding FarPreviousArtworkPath}" DecodeWidth="512" Stretch="UniformToFill"/>
                                <Border x:Name="CascadeWashM2" Background="#000" Opacity="0.18"/>
                            </Panel>
                        </Border>
                        <!-- −1: tucked under the playing cover's top-left corner -->
                        <Border x:Name="CascadeSlotM1" Classes="pile-card" Canvas.Left="432" Canvas.Top="76" Width="260" Height="260" ZIndex="6"
                                RenderTransform="rotate(-20deg)"
                                IsVisible="{Binding PreviousArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding PreviousArtworkPath}" DecodeWidth="512" Stretch="UniformToFill"/>
                                <Border x:Name="CascadeWashM1" Background="#000" Opacity="0.08"/>
                            </Panel>
                        </Border>

                        <!-- ── Up next: falls away below the playing cover, in from the bottom ── -->
                        <!-- +1: tucked under the playing cover's bottom-left corner -->
                        <Border x:Name="CascadeSlotP1" Classes="pile-card" Canvas.Left="427" Canvas.Top="685" Width="250" Height="250" ZIndex="6"
                                RenderTransform="rotate(25deg)"
                                IsVisible="{Binding NextArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding NextArtworkPath}" DecodeWidth="512" Stretch="UniformToFill"/>
                                <Border x:Name="CascadeWashP1" Background="#000" Opacity="0.08"/>
                            </Panel>
                        </Border>
                        <!-- +2: bottom, drifting left, cut by the page edge -->
                        <Border x:Name="CascadeSlotP2" Classes="pile-card" Canvas.Left="209" Canvas.Top="832" Width="270" Height="270" ZIndex="4"
                                RenderTransform="rotate(-18deg)"
                                IsVisible="{Binding FarNextArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding FarNextArtworkPath}" DecodeWidth="512" Stretch="UniformToFill"/>
                                <Border x:Name="CascadeWashP2" Background="#000" Opacity="0.18"/>
                            </Panel>
                        </Border>
                        <!-- +3: bottom-left, mostly out of frame -->
                        <Border x:Name="CascadeSlotP3" Classes="pile-card" Canvas.Left="-52" Canvas.Top="873" Width="250" Height="250" ZIndex="2"
                                RenderTransform="rotate(12deg)"
                                IsVisible="{Binding EdgeNextArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding EdgeNextArtworkPath}" DecodeWidth="256" Stretch="UniformToFill"/>
                                <Border x:Name="CascadeWashP3" Background="#000" Opacity="0.30"/>
                            </Panel>
                        </Border>

                        <!-- ═══ NOW PLAYING: straight, largest, on top; its right edge IS the canvas edge ═══ -->
                        <Border x:Name="CascadeCenterCover"
                                Canvas.Left="520" Canvas.Top="268" Width="480" Height="480" ZIndex="15"
                                CornerRadius="14" ClipToBounds="True"
                                BoxShadow="0 24 70 0 #80000000">
                            <Panel>
                                <TextBlock Text="{loc:T CoverFlow.Text}"
                                           FontSize="100"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.15"
                                           IsVisible="{Binding CenterArtworkPath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                <ctrl:CachedImage SourcePath="{Binding CenterArtworkPath}"
                                                  DecodeWidth="768"
                                                  Stretch="UniformToFill"
                                                  RenderOptions.BitmapInterpolationMode="HighQuality"
                                                  IsVisible="{Binding CenterArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <ctrl:AnimatedCoverImage
                                    Source="{Binding Player.CurrentAnimatedCoverPath}"
                                    IsActive="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Settings.EnableAnimatedCovers, FallbackValue=False}" />
                                <Border x:Name="CascadeWash0" Background="#000" Opacity="0" IsHitTestVisible="False"/>
                                <!-- Favorite heart overlay on the playing cover -->
                                <ctrl:HeartIcon Size="24" ShowWhenOff="False"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"
                                                IsFavorite="{Binding CenterIsFavorite}" />
                            </Panel>
                        </Border>
                    </Canvas>
                </Viewbox>

                <!-- ═══ NOW-PLAYING COLUMN ═══ -->
                <StackPanel x:Name="InfoStack"
                            Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            MaxWidth="600"
                            Margin="48,0,40,0"
                            Spacing="6">
                    <TextBlock Text="{loc:T CoverFlow.NOWPLAYING}"
                               FontSize="11" FontWeight="SemiBold"
                               LetterSpacing="2" Opacity="0.45"
                               Margin="1,0,0,6"/>
                    <ctrl:MarqueeTextBlock x:Name="TitleMarquee"
                                           Text="{Binding CenterTitle}"
                                           FontSize="40"
                                           FontWeight="Bold"
                                           MaxDisplayWidth="540"
                                           HorizontalAlignment="Left"
                                           IsCoverFlow="True">
                        <ctrl:MarqueeTextBlock.InlineContent>
                            <Border Classes="explicit-badge compact"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding CenterIsExplicit}"
                                    ToolTip.Tip="{loc:T CoverFlow.ExplicitTip}">
                                <TextBlock Text="E"
                                           Classes="explicit-badge-text compact"
                                           FontSize="8"
                                           Opacity="0.9" />
                            </Border>
                        </ctrl:MarqueeTextBlock.InlineContent>
                    </ctrl:MarqueeTextBlock>
                    <Button x:Name="ArtistLink"
                            Classes="link-btn"
                            Command="{Binding GoToArtistCommand}"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding CenterArtist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <ctrl:MarqueeTextBlock Text="{Binding CenterArtist}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentColorBrush}"
                                               MaxDisplayWidth="540"
                                               IsCoverFlow="True"
                                               IsForArtist="True" />
                    </Button>
                    <Button x:Name="AlbumLink"
                            Classes="link-btn"
                            Command="{Binding GoToAlbumCommand}"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding CenterAlbum.Length}">
                        <ctrl:MarqueeTextBlock Text="{Binding CenterAlbum}"
                                               FontSize="17"
                                               Foreground="{DynamicResource AccentColorBrush}"
                                               Opacity="0.85"
                                               MaxDisplayWidth="540"
                                               IsCoverFlow="True"
                                               IsForAlbum="True" />
                    </Button>

                    <!-- Up next: the +1 card's track, so the pile has a caption. -->
                    <StackPanel x:Name="UpNextStack"
                                Spacing="2" Margin="1,26,0,0"
                                IsVisible="{Binding NextTrack, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{loc:T CoverFlow.UPNEXT}"
                                   FontSize="11" FontWeight="SemiBold"
                                   LetterSpacing="2" Opacity="0.45"/>
                        <TextBlock FontSize="14" Opacity="0.75"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="540" HorizontalAlignment="Left">
                            <Run Text="{Binding NextTrack.TitleDisplay, FallbackValue=''}" FontWeight="SemiBold"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding NextTrack.ArtistDisplay, FallbackValue=''}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

            </Grid>

            <!-- Empty state when nothing is playing -->
            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        IsVisible="False">
                <TextBlock Text="{loc:T CoverFlow.NothingPlaying}"
                           FontSize="20"
                           Opacity="0.4"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <TextBlock Text="{loc:T CoverFlow.PlaySomeMusicSee}"
                           FontSize="13"
                           Opacity="0.25"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>

        </Grid>

    </Grid>

</UserControl>
