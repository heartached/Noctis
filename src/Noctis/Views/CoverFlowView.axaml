                            BoxShadow="0 6 18 0 #5A000000"
                            IsVisible="{Binding Next31Track, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Panel>
                            <ctrl:CachedImage SourcePath="{Binding Next31Track.AlbumArtworkPath}" Stretch="UniformToFill"/>
                            <ctrl:HeartIcon Size="11" ShowWhenOff="False"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5"
                                            IsFavorite="{Binding Next31Track.IsFavorite, FallbackValue=False}"/>
                        </Panel>
                    </Border>
                </Canvas>
            </Viewbox>

            <!-- Carousel + now-playing text (queue-driven; hidden in collage mode).
                 Stretches full-width so the nav arrows can pin to the screen edges;
                 the covers and text inside are individually centered. -->

            <!-- Carousel + now-playing text (queue-driven; hidden in collage mode).
                 Stretches full-width so the nav arrows can pin to the screen edges;
                 the covers and text inside are individually centered. -->
            <StackPanel HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Spacing="0"
                        IsVisible="{Binding ShowCarousel}">

                <!-- Carousel area -->
                <Grid HorizontalAlignment="Stretch"
                      Height="460"
                      Margin="0,0"
                      IsVisible="{Binding !IsCollageMode}">

                    <!-- 15-item carousel: center + 7 each side -->
                    <!-- Solid artwork + subtle dark overlay for depth (no transparency/see-through) -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                          ClipToBounds="False">

                        <!-- ═══ PREVIOUS SIDE (history) ═══ -->

                        <!-- Position -7 (farthest left) -->
                        <Border Width="320" Height="320"
                                CornerRadius="6"
                                ClipToBounds="True"
                                IsVisible="{Binding Prev7ArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ZIndex="1"
                                RenderTransformOrigin="50%,50%">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.42" ScaleY="0.42" />
                                    <TranslateTransform X="-960" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding Prev7ArtworkPath}" Stretch="UniformToFill" />
                                <Border Background="#000" Opacity="0.55" />
                            </Panel>
                        </Border>

                        <!-- Position -6 -->
                        <Border Width="320" Height="320"
                                CornerRadius="6"
                                ClipToBounds="True"
                                IsVisible="{Binding Prev6ArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ZIndex="2"
                                RenderTransformOrigin="50%,50%">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.46" ScaleY="0.46" />
                                    <TranslateTransform X="-840" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding Prev6ArtworkPath}" Stretch="UniformToFill" />
                                <Border Background="#000" Opacity="0.48" />
                            </Panel>
                        </Border>

                        <!-- Position -5 -->
                        <Border Width="320" Height="320"
                                CornerRadius="6"
                                ClipToBounds="True"
                                IsVisible="{Binding Prev5ArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ZIndex="3"
                                RenderTransformOrigin="50%,50%">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.50" ScaleY="0.50" />
                                    <TranslateTransform X="-730" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding Prev5ArtworkPath}" Stretch="UniformToFill" />
                                <Border Background="#000" Opacity="0.40" />
                            </Panel>
                        </Border>

                        <!-- Position -4 -->
                        <Border Width="320" Height="320"
                                CornerRadius="8"
                                ClipToBounds="True"
                                IsVisible="{Binding OffPreviousArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ZIndex="4"
                                RenderTransformOrigin="50%,50%">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.55" ScaleY="0.55" />
                                    <TranslateTransform X="-625" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding OffPreviousArtworkPath}" Stretch="UniformToFill" />
                                <Border Background="#000" Opacity="0.32" />
                            </Panel>
                        </Border>

                        <!-- Position -3 -->
                        <Border Width="320" Height="320"
                                CornerRadius="8"
                                ClipToBounds="True"
                                IsVisible="{Binding EdgePreviousArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ZIndex="5"
                                RenderTransformOrigin="50%,50%">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.60" ScaleY="0.60" />
                                    <TranslateTransform X="-525" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding EdgePreviousArtworkPath}" Stretch="UniformToFill" />
                                <Border Background="#000" Opacity="0.24" />
                            </Panel>
                        </Border>

                        <!-- Position -2 -->
                        <Border Width="320" Height="320"
                                CornerRadius="10"
                                ClipToBounds="True"
                                IsVisible="{Binding FarPreviousArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ZIndex="6"
                                RenderTransformOrigin="50%,50%">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.68" ScaleY="0.68" />
                                    <TranslateTransform X="-400" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding FarPreviousArtworkPath}" Stretch="UniformToFill" />
                                <Border Background="#000" Opacity="0.16" />
                            </Panel>
                        </Border>

                        <!-- Position -1 -->
                        <Border Width="320" Height="320"
                                CornerRadius="10"
                                ClipToBounds="True"
                                IsVisible="{Binding PreviousArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ZIndex="7"
                                RenderTransformOrigin="50%,50%">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.80" ScaleY="0.80" />
                                    <TranslateTransform X="-280" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding PreviousArtworkPath}" Stretch="UniformToFill" />
                                <Border Background="#000" Opacity="0.08" />
                            </Panel>
                        </Border>

                        <!-- ═══ CENTER COVER ═══ -->
                        <Border x:Name="CenterCover"
                                Width="440" Height="440"
                                CornerRadius="12"
                                ClipToBounds="True"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ZIndex="15">
                            <Panel>
                                <!-- Placeholder when no artwork -->
                                <TextBlock Text="&#x266A;"
                                           FontSize="100"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.15"
                                           IsVisible="{Binding CenterArtworkPath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                <ctrl:CachedImage SourcePath="{Binding CenterArtworkPath}"
                                                  Stretch="UniformToFill"
                                                  RenderOptions.BitmapInterpolationMode="HighQuality"
                                                  IsVisible="{Binding CenterArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <ctrl:AnimatedCoverImage
                                    Source="{Binding Player.CurrentAnimatedCoverPath}"
                                    IsActive="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Settings.EnableAnimatedCovers, FallbackValue=False}" />
                                <!-- Favorite heart overlay on the center album cover -->
                                <ctrl:HeartIcon Size="24" ShowWhenOff="False"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"
                                                IsFavorite="{Binding CenterIsFavorite}" />
                            </Panel>
                        </Border>

                        <!-- ═══ NEXT SIDE (UpNext queue) ═══ -->

                        <!-- Position +1 -->
                        <Border Width="320" Height="320"
                                CornerRadius="10"
                                ClipToBounds="True"
                                IsVisible="{Binding NextArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ZIndex="7"
                                RenderTransformOrigin="50%,50%">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.80" ScaleY="0.80" />
                                    <TranslateTransform X="280" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding NextArtworkPath}" Stretch="UniformToFill" />
                                <Border Background="#000" Opacity="0.08" />
                            </Panel>
                        </Border>

                        <!-- Position +2 -->
                        <Border Width="320" Height="320"
                                CornerRadius="10"
                                ClipToBounds="True"
                                IsVisible="{Binding FarNextArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ZIndex="6"
                                RenderTransformOrigin="50%,50%">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.68" ScaleY="0.68" />
                                    <TranslateTransform X="400" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding FarNextArtworkPath}" Stretch="UniformToFill" />
                                <Border Background="#000" Opacity="0.16" />
                            </Panel>
                        </Border>

                        <!-- Position +3 -->
                        <Border Width="320" Height="320"
                                CornerRadius="8"
                                ClipToBounds="True"
                                IsVisible="{Binding EdgeNextArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ZIndex="5"
                                RenderTransformOrigin="50%,50%">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.60" ScaleY="0.60" />
                                    <TranslateTransform X="525" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding EdgeNextArtworkPath}" Stretch="UniformToFill" />
                                <Border Background="#000" Opacity="0.24" />
                            </Panel>
                        </Border>

                        <!-- Position +4 -->
                        <Border Width="320" Height="320"
                                CornerRadius="8"
                                ClipToBounds="True"
                                IsVisible="{Binding OffNextArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ZIndex="4"
                                RenderTransformOrigin="50%,50%">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.55" ScaleY="0.55" />
                                    <TranslateTransform X="625" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding OffNextArtworkPath}" Stretch="UniformToFill" />
                                <Border Background="#000" Opacity="0.32" />
                            </Panel>
                        </Border>

                        <!-- Position +5 -->
                        <Border Width="320" Height="320"
                                CornerRadius="6"
                                ClipToBounds="True"
                                IsVisible="{Binding Next5ArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ZIndex="3"
                                RenderTransformOrigin="50%,50%">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.50" ScaleY="0.50" />
                                    <TranslateTransform X="730" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding Next5ArtworkPath}" Stretch="UniformToFill" />
                                <Border Background="#000" Opacity="0.40" />
                            </Panel>
                        </Border>

                        <!-- Position +6 -->
                        <Border Width="320" Height="320"
                                CornerRadius="6"
                                ClipToBounds="True"
                                IsVisible="{Binding Next6ArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ZIndex="2"
                                RenderTransformOrigin="50%,50%">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.46" ScaleY="0.46" />
                                    <TranslateTransform X="840" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding Next6ArtworkPath}" Stretch="UniformToFill" />
                                <Border Background="#000" Opacity="0.48" />
                            </Panel>
                        </Border>

                        <!-- Position +7 (farthest right) -->
                        <Border Width="320" Height="320"
                                CornerRadius="6"
                                ClipToBounds="True"
                                IsVisible="{Binding Next7ArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ZIndex="1"
                                RenderTransformOrigin="50%,50%">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.42" ScaleY="0.42" />
                                    <TranslateTransform X="960" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding Next7ArtworkPath}" Stretch="UniformToFill" />
                                <Border Background="#000" Opacity="0.55" />
                            </Panel>
                        </Border>

                    </Grid>

                </Grid>

                <!-- Track info just below the center cover (carousel only — the collage is covers-only) -->
                <StackPanel HorizontalAlignment="Center"
                            Spacing="4"
                            Margin="0,16,0,0"
                            IsVisible="{Binding !IsCollageMode}">
                    <!-- Title row with explicit badge -->
                    <ctrl:MarqueeTextBlock Text="{Binding CenterTitle}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           MaxDisplayWidth="480"
                                           HorizontalAlignment="Center"
                                           IsCoverFlow="True">
                        <ctrl:MarqueeTextBlock.InlineContent>
                            <Border Classes="explicit-badge compact"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding CenterIsExplicit}"
                                    ToolTip.Tip="Explicit">
                                <TextBlock Text="E"
                                           Classes="explicit-badge-text compact"
                                           FontSize="9"
                                           Opacity="0.9" />
                            </Border>
                        </ctrl:MarqueeTextBlock.InlineContent>
                    </ctrl:MarqueeTextBlock>
                    <Button Classes="link-btn"
                            Command="{Binding GoToArtistCommand}"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding CenterArtist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <ctrl:MarqueeTextBlock Text="{Binding CenterArtist}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentColorBrush}"
                                               MaxDisplayWidth="400"
                                               IsCoverFlow="True"
                                               IsForArtist="True" />
                    </Button>
                    <Button Classes="link-btn"
                            Command="{Binding GoToAlbumCommand}"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding CenterAlbum.Length}">
                        <ctrl:MarqueeTextBlock Text="{Binding CenterAlbum}"
                                               FontSize="13"
                                               Foreground="{DynamicResource AccentColorBrush}"
                                               MaxDisplayWidth="400"
                                               IsCoverFlow="True"
                                               IsForAlbum="True" />
                    </Button>
                </StackPanel>

            </StackPanel>

            <!-- ═══ CASCADE: diagonal path + now-playing column ═══
                 Community mockup (Mistery, Discord 2026-08-29). The covers sit on ONE
                 ordered path that bows out to the right: history climbs away above the
                 playing cover toward the top-left corner, up-next falls away below it
                 toward the bottom-left corner. Skipping a track therefore moves every
                 card one step along the path (down for next, up for previous) — the same
                 fixed-slot content swap the carousel does, just on a curve. Nothing is
                 random and nothing animates: the slide transition was tried and removed
                 for lag (each Cover Flow step is a real track skip), so no transitions,
                 no hover, pile not hit-testable.

                 Geometry: a 1000×1000 design canvas whose RIGHT edge is the playing
                 cover's right edge, so the text column hugs the cover like the mockup.
                 Code-behind sizes the Viewbox to a SQUARE as tall as the page (negative
                 margins cancel the page inset), so the canvas maps 1:1 onto the column
                 and the outer cards run off the top and in from the bottom, cut by the
                 page edge itself — nothing clips in mid-air (no Canvas/Viewbox clip; the
                 UserControl's ClipToBounds does it). StageGrid: pile | text; code-behind
                 drops the text under the pile below ~1040px (see OnSizeChanged). -->
            <Grid x:Name="StageGrid"
                  ColumnDefinitions="Auto,*" RowDefinitions="*,Auto"
                  IsVisible="{Binding ShowCascade}">

                <Viewbox x:Name="PileViewbox"
                         Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                         Stretch="Uniform"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         Margin="0,-24,0,-12">
                    <Canvas Width="1000" Height="1000">

                        <!-- ── History: climbs away above the playing cover, off the top ── -->
                        <!-- −3: top-left, mostly out of frame -->
                        <Border Classes="pile-card" Canvas.Left="-31" Canvas.Top="-96" Width="208" Height="208" ZIndex="2"
                                RenderTransform="rotate(-18deg)"
                                IsVisible="{Binding EdgePreviousArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding EdgePreviousArtworkPath}" DecodeWidth="256" Stretch="UniformToFill"/>
                                <Border Background="#000" Opacity="0.30"/>
                            </Panel>
                        </Border>
                        <!-- −2: top, leaning hard, cut by the page edge -->
                        <Border Classes="pile-card" Canvas.Left="198" Canvas.Top="-65" Width="250" Height="250" ZIndex="4"
                                RenderTransform="rotate(-33deg)"
                                IsVisible="{Binding FarPreviousArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding FarPreviousArtworkPath}" DecodeWidth="512" Stretch="UniformToFill"/>
                                <Border Background="#000" Opacity="0.18"/>
                            </Panel>
                        </Border>
                        <!-- −1: tucked under the playing cover's top-left corner -->
                        <Border Classes="pile-card" Canvas.Left="432" Canvas.Top="76" Width="260" Height="260" ZIndex="6"
                                RenderTransform="rotate(-20deg)"
                                IsVisible="{Binding PreviousArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding PreviousArtworkPath}" DecodeWidth="512" Stretch="UniformToFill"/>
                                <Border Background="#000" Opacity="0.08"/>
                            </Panel>
                        </Border>

                        <!-- ── Up next: falls away below the playing cover, in from the bottom ── -->
                        <!-- +1: tucked under the playing cover's bottom-left corner -->
                        <Border Classes="pile-card" Canvas.Left="427" Canvas.Top="685" Width="250" Height="250" ZIndex="6"
                                RenderTransform="rotate(25deg)"
                                IsVisible="{Binding NextArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding NextArtworkPath}" DecodeWidth="512" Stretch="UniformToFill"/>
                                <Border Background="#000" Opacity="0.08"/>
                            </Panel>
                        </Border>
                        <!-- +2: bottom, drifting left, cut by the page edge -->
                        <Border Classes="pile-card" Canvas.Left="209" Canvas.Top="832" Width="270" Height="270" ZIndex="4"
                                RenderTransform="rotate(-18deg)"
                                IsVisible="{Binding FarNextArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding FarNextArtworkPath}" DecodeWidth="512" Stretch="UniformToFill"/>
                                <Border Background="#000" Opacity="0.18"/>
                            </Panel>
                        </Border>
                        <!-- +3: bottom-left, mostly out of frame -->
                        <Border Classes="pile-card" Canvas.Left="-52" Canvas.Top="873" Width="250" Height="250" ZIndex="2"
                                RenderTransform="rotate(12deg)"
                                IsVisible="{Binding EdgeNextArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Panel>
                                <ctrl:CachedImage SourcePath="{Binding EdgeNextArtworkPath}" DecodeWidth="256" Stretch="UniformToFill"/>
                                <Border Background="#000" Opacity="0.30"/>
                            </Panel>
                        </Border>

                        <!-- ═══ NOW PLAYING: straight, largest, on top; its right edge IS the canvas edge ═══ -->
                        <Border x:Name="CascadeCenterCover"
                                Canvas.Left="520" Canvas.Top="268" Width="480" Height="480" ZIndex="15"
                                CornerRadius="14" ClipToBounds="True"
                                BoxShadow="0 24 70 0 #80000000">
                            <Panel>
                                <TextBlock Text="&#x266A;"
                                           FontSize="100"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.15"
                                           IsVisible="{Binding CenterArtworkPath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                <ctrl:CachedImage SourcePath="{Binding CenterArtworkPath}"
                                                  DecodeWidth="768"
                                                  Stretch="UniformToFill"
                                                  RenderOptions.BitmapInterpolationMode="HighQuality"
                                                  IsVisible="{Binding CenterArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <ctrl:AnimatedCoverImage
                                    Source="{Binding Player.CurrentAnimatedCoverPath}"
                                    IsActive="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Settings.EnableAnimatedCovers, FallbackValue=False}" />
                                <!-- Favorite heart overlay on the playing cover -->
                                <ctrl:HeartIcon Size="24" ShowWhenOff="False"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"
                                                IsFavorite="{Binding CenterIsFavorite}" />
                            </Panel>
                        </Border>
                    </Canvas>
                </Viewbox>

                <!-- ═══ NOW-PLAYING COLUMN ═══ -->
                <StackPanel x:Name="InfoStack"
                            Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            MaxWidth="600"
                            Margin="48,0,40,0"
                            Spacing="6">
                    <TextBlock Text="NOW PLAYING"
                               FontSize="11" FontWeight="SemiBold"
                               LetterSpacing="2" Opacity="0.45"
                               Margin="1,0,0,6"/>
                    <ctrl:MarqueeTextBlock x:Name="TitleMarquee"
                                           Text="{Binding CenterTitle}"
                                           FontSize="40"
                                           FontWeight="Bold"
                                           MaxDisplayWidth="540"
                                           HorizontalAlignment="Left"
                                           IsCoverFlow="True">
                        <ctrl:MarqueeTextBlock.InlineContent>
                            <Border Classes="explicit-badge compact"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding CenterIsExplicit}"
                                    ToolTip.Tip="Explicit">
                                <TextBlock Text="E"
                                           Classes="explicit-badge-text compact"
                                           FontSize="9"
                                           Opacity="0.9" />
                            </Border>
                        </ctrl:MarqueeTextBlock.InlineContent>
                    </ctrl:MarqueeTextBlock>
                    <Button x:Name="ArtistLink"
                            Classes="link-btn"
                            Command="{Binding GoToArtistCommand}"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding CenterArtist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <ctrl:MarqueeTextBlock Text="{Binding CenterArtist}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentColorBrush}"
                                               MaxDisplayWidth="540"
                                               IsCoverFlow="True"
                                               IsForArtist="True" />
                    </Button>
                    <Button x:Name="AlbumLink"
                            Classes="link-btn"
                            Command="{Binding GoToAlbumCommand}"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding CenterAlbum.Length}">
                        <ctrl:MarqueeTextBlock Text="{Binding CenterAlbum}"
                                               FontSize="17"
                                               Foreground="{DynamicResource AccentColorBrush}"
                                               Opacity="0.85"
                                               MaxDisplayWidth="540"
                                               IsCoverFlow="True"
                                               IsForAlbum="True" />
                    </Button>

                    <!-- Up next: the +1 card's track, so the pile has a caption. -->
                    <StackPanel x:Name="UpNextStack"
                                Spacing="2" Margin="1,26,0,0"
                                IsVisible="{Binding NextTrack, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="UP NEXT"
                                   FontSize="11" FontWeight="SemiBold"
                                   LetterSpacing="2" Opacity="0.45"/>
                        <TextBlock FontSize="14" Opacity="0.75"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="540" HorizontalAlignment="Left">
                            <Run Text="{Binding NextTrack.TitleDisplay, FallbackValue=''}" FontWeight="SemiBold"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding NextTrack.ArtistDisplay, FallbackValue=''}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

            </Grid>

            <!-- Empty state when nothing is playing -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        IsVisible="{Binding ShowEmptyState}">
                <TextBlock Text="Nothing playing"
                           FontSize="20"
                           Opacity="0.4"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <TextBlock Text="Play some music to see the queue flow"
                           FontSize="13"
                           Opacity="0.25"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>

        </Grid>

    </Grid>

</UserControl>
