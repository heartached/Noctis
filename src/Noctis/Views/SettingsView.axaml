<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.ViewModels"
             xmlns:models="using:Noctis.Models"
             xmlns:sys="using:System"
             xmlns:conv="using:Noctis.Converters"
             xmlns:controls="using:Noctis.Controls"
             x:Class="Noctis.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource AppMainBackground}">

    <UserControl.Resources>
        <conv:PercentageToWidthConverter x:Key="PercentageToWidth" />
        <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometry" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Section header style -->
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- A setting row gated by another toggle: dim it while disabled so it
             visibly reads as not-yet-available (e.g. "Start minimized to tray"
             before "Open Noctis when computer starts" is on). -->
        <Style Selector="Grid.dependent-setting:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- About-tab update pill: accent by default, subdued while showing the
             transient "✓ Up to date" confirmation so it stops reading as a CTA. -->
        <Style Selector="Button.update-pill">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="Button.update-pill.up-to-date">
            <Setter Property="Background" Value="#26FFFFFF"/>
        </Style>

        <!-- Circular loading spinner: a rotating arc shown during background work -->
        <Style Selector="Ellipse.loading-spinner">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stroke" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeDashArray" Value="11,5"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        </Style>
        <!-- Animation keyed on [IsVisible=True] (same pattern as LyricsView's search
             dots): selector matching ignores visibility, so an ungated INFINITE
             clock would keep ticking on every hidden spinner. -->
        <Style Selector="Ellipse.loading-spinner[IsVisible=True]">
            <Style.Animations>
                <Animation Duration="0:0:0.85" IterationCount="INFINITE" Easing="LinearEasing">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Music Server card: tiny caps field labels, a status dot that follows the
             connection state, and red status text on failures. -->
        <Style Selector="TextBlock.server-field-label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Ellipse.server-status-dot">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Fill" Value="#8B949E"/>
        </Style>
        <Style Selector="Ellipse.server-status-dot.connected">
            <Setter Property="Fill" Value="#3FB950"/>
        </Style>
        <Style Selector="Ellipse.server-status-dot.error">
            <Setter Property="Fill" Value="#E5534B"/>
        </Style>
        <Style Selector="TextBlock.server-status">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="TextBlock.server-status.error">
            <Setter Property="Foreground" Value="#E5534B"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        <!-- Server type picker: the visible outline is drawn by a plain wrapper Border
             (server-pill-shell) carrying exactly the metadata-info-field stroke, and the
             ComboBox's own Fluent chrome is fully disarmed in every state. Pinning the
             stroke on the template's Border#Background was tried twice and never rendered
             the same as the TextBox's PART_BorderElement (same declared 1.5px/brush,
             different layering/snapping) — so all four boxes now share one drawing
             mechanism. Contract pinned by MediaServerOutlineParityTests. -->
        <Style Selector="Border.server-pill-shell">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <!-- Same quiet outline as the rail's search box (plain TextBox theme brushes). -->
            <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource TextControlBackground}"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <!-- Focus parity: the field boxes turn accent on :focus, the shell follows suit. -->
        <Style Selector="Border.server-pill-shell:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
        </Style>
        <Style Selector="ComboBox.server-pill">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill /template/ Border#Background">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill /template/ Border#HighlightBackground">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ComboBox.server-pill:pointerover /template/ Border#Background">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill:pressed /template/ Border#Background">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill:focus /template/ Border#Background">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill:focus-within /template/ Border#Background">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill:dropdownopen /template/ Border#Background">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill:disabled /template/ Border#Background">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Setting card -->
        <Style Selector="Border.setting-card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="22,16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="Border.setting-card.advanced-first">
            <Setter Property="CornerRadius" Value="24,24,0,0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="Border.setting-card.advanced-middle">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="Border.setting-card.advanced-last">
            <Setter Property="CornerRadius" Value="0,0,24,24"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Selectable card used by the Song Transitions style picker -->
        <Style Selector="RadioButton.transition-card">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="card"
                            Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="18"
                            Padding="18,14">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.transition-card:checked /template/ Border#card">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
        </Style>
        <Style Selector="RadioButton.transition-card:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <!-- Same card, laid out four-up for the Now Playing Artwork picker: no bottom
             margin (the Grid spaces them) and centred glyph + label. -->
        <Style Selector="RadioButton.medium-card">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="RadioButton.medium-card Canvas.medium-glyph">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>


        <!-- Setting row: label left, control right -->
        <Style Selector="Border.setting-row">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Liquid motion for every button in Settings -->
        <Style Selector="Button">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18">
                        <TransformOperationsTransition.Easing>
                            <CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                    <BrushTransition Property="Background" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.045)"/>
        </Style>
        <!-- The QR thumbnail must not grow on hover: a moving code reads as decoration,
             and phones scan it in place. The press dip stays for click feedback. -->
        <Style Selector="Button.qr-thumb:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.accent-swatch:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.accent-swatch:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <!-- Theme selection button -->
        <Style Selector="Button.theme-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.theme-btn /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Button.theme-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
        </Style>

        <!-- Profile avatar button: round, no rectangular hover overlay -->
        <Style Selector="Button.profile-avatar-btn /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="Button.profile-avatar-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.profile-avatar-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- Profile name TextBox: no chrome on any state -->
        <Style Selector="TextBox.profile-input /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.profile-input:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.profile-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.profile-input:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.theme-btn.active /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
        </Style>

        <!-- Danger button -->
        <Style Selector="Button.danger /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrushDark1}"/>
        </Style>

        <!-- Accent button -->
        <Style Selector="Button.accent /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrushDark1}"/>
        </Style>

        <Style Selector="TextBox.accent-hex-input /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <Style Selector="TextBox.accent-hex-input:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.accent-hex-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.accent-hex-input:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- Pill-shaped action buttons -->
        <Style Selector="Button.pill-action">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.pill-action /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>

        <!-- Social links (GitHub / Discord) in the About card: brand-coloured icon,
             brighter label, and a soft brand-tinted pill on hover. -->
        <Style Selector="Button.social-link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.social-link /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="Button.social-discord:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#265865F2"/>
        </Style>
        <Style Selector="Button.social-github:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#26F1C40F"/>
        </Style>

        <!-- Pill ComboBox -->
        <Style Selector="ComboBox.pill-combo">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <Panel>
                            <Border Name="Background"
                                    Background="{DynamicResource ButtonBackground}"
                                    BorderThickness="0"
                                    CornerRadius="16"
                                    Padding="{TemplateBinding Padding}"
                                    MinWidth="{TemplateBinding MinWidth}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <ContentPresenter Name="PART_ContentPresenter"
                                                      Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    <Border Grid.Column="1"
                                            Width="15"
                                            Height="15"
                                            Margin="4,0,4,0"
                                            Background="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            RenderOptions.BitmapInterpolationMode="HighQuality">
                                        <Border.OpacityMask>
                                            <ImageBrush Source="avares://Noctis/Assets/Icons/Arrow Down ICON.png" Stretch="Uniform"/>
                                        </Border.OpacityMask>
                                    </Border>
                                </Grid>
                            </Border>
                            <Popup Name="PART_Popup"
                                   PlacementTarget="{TemplateBinding}"
                                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                   MinWidth="{TemplateBinding MinWidth}"
                                   IsLightDismissEnabled="True"
                                   WindowManagerAddShadowHint="False"
                                   Placement="BottomEdgeAlignedLeft">
                                <Border Background="{DynamicResource ComboBoxDropDownBackground}"
                                        BorderBrush="{DynamicResource ComboBoxDropDownBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="0,4">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter Name="PART_ItemsPresenter"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Panel>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ComboBox.pill-combo:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.05)"/>
        </Style>
        <Style Selector="ComboBox.pill-combo.stable-popup:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="ComboBox.pill-combo:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
        </Style>
        <!-- Selected item highlight. Foreground tracks the accent's contrast colour so the
             label stays readable even when the accent is white (otherwise white-on-white). -->
        <Style Selector="ComboBox.pill-combo ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="ComboBox.pill-combo ComboBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrushDark1}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <!-- Pill-shaped hover/selection highlight in the dropdown list, matching the
             rounded MenuItems in the page options menu. Margin insets each row so the
             highlight floats; CornerRadius on the content presenter clips it to a pill. -->
        <Style Selector="ComboBox.pill-combo ComboBoxItem">
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="ComboBox.pill-combo ComboBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="999"/>
        </Style>

        <!-- Pill dropdown items for plain (default-template) pill combos, e.g. ReplayGain Mode. -->
        <Style Selector="ComboBox.pill-list ComboBoxItem">
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="ComboBox.pill-list ComboBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="999"/>
        </Style>

        <!-- Token field: identical treatment to the metadata editor's text fields. The inner
             PART_BorderElement gets the same CornerRadius so the rounded corners render clean
             (the earlier square-corner artifact came from leaving PART_BorderElement unstyled). -->
        <Style Selector="TextBox.metadata-info-field">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
        </Style>
        <Style Selector="TextBox.metadata-info-field /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
        <Style Selector="TextBox.metadata-info-field:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
        </Style>
        <Style Selector="TextBox.metadata-info-field:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
        </Style>
        <Style Selector="ComboBox.transition-pill">
            <Setter Property="Width" Value="132"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="ComboBox.transition-pill /template/ Border#Background">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
        </Style>
        <Style Selector="ComboBox.transition-pill:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </Style>

        <!-- Accent sliders (horizontal) -->
        <Style Selector="Slider.accent-slider">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TickPlacement" Value="None"/>
        </Style>
        <Style Selector="Slider.accent-slider /template/ Track">
            <Setter Property="Height" Value="8"/>
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Margin" Value="0,0,-9,0"/>
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Margin" Value="-9,0,0,0"/>
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="Opacity" Value="0.95"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Height" Value="8"/>
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton#PART_IncreaseButton /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Slider.accent-slider /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14">
                        <TransformOperationsTransition.Easing>
                            <CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                    <DoubleTransition Property="Width" Duration="0:0:0.12"/>
                    <DoubleTransition Property="Height" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Slider.accent-slider:pointerover /template/ Thumb">
            <Setter Property="Width" Value="19.44"/>
            <Setter Property="Height" Value="19.44"/>
        </Style>

        <!-- Child settings dim when their parent toggle is off (matches the
             grayed ReplayGain Mode row) so the dependency is visible at a glance. -->
        <Style Selector="Grid.sub-setting, StackPanel.sub-setting">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.sub-setting:disabled, StackPanel.sub-setting:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- Pill numeric fields in the parametric EQ rows: the spin buttons are
             hidden so the value is always fully readable; adjust by typing,
             scrolling, or arrow keys. -->
        <Style Selector="NumericUpDown.eq-pill-number">
            <Setter Property="ShowButtonSpinner" Value="False"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="NumericUpDown.eq-pill-number /template/ ButtonSpinner">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown.eq-pill-number /template/ TextBox#PART_TextBox">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- The theme draws TextBox chrome on its inner border element (including
             hover/focus recolors), so the pill background has to be set there for
             every state or the theme's square highlight bleeds through. -->
        <Style Selector="NumericUpDown.eq-pill-number /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown.eq-pill-number /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown.eq-pill-number /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Accent sliders (vertical EQ) -->
        <Style Selector="Slider.accent-vertical">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ Track">
            <Setter Property="Width" Value="8"/>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ RepeatButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Margin" Value="0,-9,0,0"/>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Margin" Value="0,0,0,-9"/>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ RepeatButton /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="Opacity" Value="0.95"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Width" Value="8"/>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ RepeatButton#PART_IncreaseButton /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="999"/>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14">
                        <TransformOperationsTransition.Easing>
                            <CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                    <DoubleTransition Property="Width" Duration="0:0:0.12"/>
                    <DoubleTransition Property="Height" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Slider.accent-vertical:pointerover /template/ Thumb">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>

        <!-- Pre-amp pill slider: the real Slider is transparent and only handles hit
             testing; the visible pill track/fill/thumb are drawn on a Canvas and driven
             from code-behind (PillSliderVisualHelper), matching the metadata volume slider. -->
        <Style Selector="Slider.preamp-horizontal">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource IslandSliderFilled}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>

        <!-- Settings rail (left column): section list, profile chip, search. -->
        <Style Selector="Border.settings-rail">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="CornerRadius" Value="21,0,0,0"/>
        </Style>
        <Style Selector="Button.rail-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.rail-item /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style Selector="Button.rail-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}"/>
        </Style>
        <Style Selector="Button.rail-item.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <!-- The app-wide Button:pointerover scale(1.045) reads as a jump on a list of
             full-width rows; the rail relies on the background highlight alone. -->
        <Style Selector="Button.rail-item:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.profile-avatar-btn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <!-- About-tab version chip: plain text that copies on click; the app-wide hover
             zoom makes it wobble under the pointer. -->
        <Style Selector="Button.version-copy:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.rail-profile">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.rail-profile /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style Selector="Button.rail-profile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}"/>
        </Style>
        <Style Selector="TextBox.settings-search">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <!-- Settings search hides non-matching cards through a class (see
             SettingsSearchIndex) so cards whose IsVisible is bound keep that binding. -->
        <Style Selector="Border.setting-card.search-hidden">
            <Setter Property="IsVisible" Value="False"/>
            <!-- A card whose IsVisible is bound (platform / Developer Mode gates) keeps
                 that binding over the setter above, so collapse it geometrically too. -->
            <Setter Property="MaxHeight" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <!-- Tab switch: the incoming page fades in with a short upward glide.
             Keyframe animations can't drive RenderTransform (no registered
             animator — crashed at startup), so the hidden state pins
             opacity 0 / translateY(10px) and releasing it on IsVisible=True
             transitions both back to their natural values. -->
        <Style Selector="StackPanel.tab-page">
            <!-- Explicit resting transform: transitions interpolate between two
                 TransformOperations values, never to an unset (null) transform. -->
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.tab-page[IsVisible=False]">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="translateY(10px)"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="216,*">

    <!-- Rail -->
    <Border Grid.Column="0" Classes="settings-rail">
        <DockPanel Margin="12,14,12,16">
            <!-- Profile: click the picture to change it, click the name to edit it. -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="4,2,4,0">
                <Button Grid.Column="0"
                        Classes="profile-avatar-btn"
                        Background="Transparent" BorderThickness="0"
                        Padding="0" Cursor="Hand"
                        Width="34" Height="34"
                        CornerRadius="999"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Change picture"
                        Click="OnPickAvatarClick">
                    <Border Width="34" Height="34" CornerRadius="17" ClipToBounds="True">
                        <Panel>
                            <Border CornerRadius="17"
                                    Background="{DynamicResource AccentColorBrush}"
                                    IsVisible="{Binding ProfileAvatarPath, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                <TextBlock Text="?" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <controls:CachedImage SourcePath="{Binding ProfileAvatarPath}"
                                                  Stretch="UniformToFill"
                                                  ClearOnSourceChange="False"
                                                  IsVisible="{Binding ProfileAvatarPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </Panel>
                    </Border>
                </Button>
                <TextBox Grid.Column="1"
                         Classes="profile-input"
                         Text="{Binding ProfileName, Mode=TwoWay}"
                         Watermark="Your name"
                         FontSize="13" FontWeight="SemiBold"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0" Padding="2,0"
                         MinHeight="0"
                         ToolTip.Tip="Click to edit your name"
                         KeyDown="OnProfileNameKeyDown"
                         Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            </Grid>

            <!-- Search across every section (Ctrl+F while Settings is open). -->
            <TextBox DockPanel.Dock="Top"
                     x:Name="SettingsSearchBox"
                     Classes="settings-search"
                     Watermark="Search settings"
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchQuery, Mode=TwoWay}"
                     Margin="0,12,0,10"/>

            <!-- Sections -->
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingsSection">
                        <Button Classes="rail-item"
                                Classes.active="{Binding IsSelected}"
                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SelectSettingsTabCommand}"
                                CommandParameter="{Binding Key}">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                           Margin="2,0,0,0" VerticalAlignment="Center"/>
                                <!-- Search hit count while a query is active -->
                                <Border Grid.Column="1" CornerRadius="999" Padding="6,1" Margin="6,0,0,0"
                                        Background="#22FFFFFF" VerticalAlignment="Center"
                                        IsVisible="{Binding HasMatches}">
                                    <TextBlock Text="{Binding MatchCount}" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                                <!-- Update-available dot on About -->
                                <Ellipse Grid.Column="2" Width="8" Height="8" Margin="6,0,0,0"
                                         Fill="{DynamicResource AccentColorBrush}" VerticalAlignment="Center">
                                    <Ellipse.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="IsAbout"/>
                                            <Binding Path="$parent[ItemsControl].((vm:SettingsViewModel)DataContext).IsUpdateAvailable"/>
                                        </MultiBinding>
                                    </Ellipse.IsVisible>
                                </Ellipse>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>

    <!-- Content column: section title + close, then the existing tab pages. -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
    <Grid Grid.Row="0" Margin="28,22,28,8">
        <TextBlock Grid.Column="0"
                   Text="{Binding SelectedSettingsTab}"
                   FontSize="22"
                   FontWeight="Bold"
                   VerticalAlignment="Center"/>
    </Grid>

    <ScrollViewer x:Name="SettingsScrollViewer"
                  Grid.Row="1"
                  Focusable="True"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,8,40,28" HorizontalAlignment="Stretch" Spacing="4">

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- GENERAL                                             -->
            <!-- ═══════════════════════════════════════════════════ -->
            <StackPanel x:Name="GeneralTabPanel" Classes="tab-page" IsVisible="{Binding IsGeneralTabVisible}" Spacing="4">

            <!-- Startup & window behaviour -->
            <Border Classes="setting-card">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Startup &amp; Window Behaviour" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Control how Noctis starts and what the minimize and close buttons do."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Open Noctis when computer starts" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding LaunchAtStartup}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <!-- The OS registration can fail (locked-down HKCU, read-only
                         ~/.config/autostart, an unbundled macOS run). The toggle snaps
                         back to what the OS reports and says so, rather than sitting ON
                         with nothing registered. -->
                    <TextBlock Text="{Binding LaunchAtStartupError}"
                               IsVisible="{Binding LaunchAtStartupError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="12" Foreground="#E74856" TextWrapping="Wrap"/>
                    <!-- Dependent on launch-at-startup: only meaningful for login launches. -->
                    <Grid ColumnDefinitions="*,Auto" Classes="dependent-setting" IsEnabled="{Binding LaunchAtStartup}">
                        <TextBlock Grid.Column="0" Text="Start minimized to tray" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding StartMinimizedToTray}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Minimize to tray" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding MinimizeToTray}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Close to tray" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding CloseToTray}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Restore last played track" FontSize="13"/>
                            <TextBlock Text="Reopen with your last track in the playbar, paused where you left off."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding RestoreLastTrackOnStartup}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Text Animation group -->
            <Border Classes="setting-card">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Text Animation" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Control how long text scrolls in the player bar, Up Next, and menus."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Sub-header: Player Bar -->
                    <TextBlock Text="PLAYER BAR" FontSize="11" FontWeight="SemiBold" Opacity="0.4" Margin="0,4,0,2"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Animate long track titles" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding TrackTitleMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Animate long artist names" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding ArtistMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Sub-header: Cover Flow -->
                    <TextBlock Text="COVER FLOW" FontSize="11" FontWeight="SemiBold" Opacity="0.4" Margin="0,8,0,2"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Animate long track titles" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding CoverFlowMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Animate long artist names" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding CoverFlowArtistMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Animate long album titles" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding CoverFlowAlbumMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Sub-header: Lyrics Page -->
                    <TextBlock Text="LYRICS PAGE" FontSize="11" FontWeight="SemiBold" Opacity="0.4" Margin="0,8,0,2"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Animate long track titles" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding LyricsTitleMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Animate long artist/album names" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding LyricsArtistMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Sub-header: Mini Player -->
                    <TextBlock Text="MINI PLAYER" FontSize="11" FontWeight="SemiBold" Opacity="0.4" Margin="0,8,0,2"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Animate long track titles" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding MiniPlayerTitleMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Animate long album titles" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding MiniPlayerAlbumMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Sub-header: Sidebar -->
                    <TextBlock Text="SIDEBAR" FontSize="11" FontWeight="SemiBold" Opacity="0.4" Margin="0,8,0,2"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Keep sidebar expanded" FontSize="13"/>
                            <TextBlock Text="Pin the sidebar open at all times."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding SidebarAlwaysExpanded}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Hover-expand is moot while the sidebar is pinned open -->
                    <Grid Classes="sub-setting" ColumnDefinitions="*,Auto" IsEnabled="{Binding !SidebarAlwaysExpanded}">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Hover to expand sidebar" FontSize="13"/>
                            <TextBlock Text="Slide the sidebar open on hover."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding SidebarHoverExpand}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- Collapse album editions -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Collapse Album Editions" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Show one tile per release; other editions appear under &quot;Other Versions&quot; on the album page."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding CollapseAlbumEditions}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Merge featured artists from titles -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Merge Featured Artists From Titles" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Turn &quot;(feat. X)&quot; in track titles into artist credits."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding MergeFeaturedFromTitles}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            </StackPanel>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- ABOUT                                               -->
            <!-- ═══════════════════════════════════════════════════ -->
            <StackPanel x:Name="AboutTabPanel" Classes="tab-page" IsVisible="{Binding IsAboutTabVisible}" Spacing="4">

            <Border Classes="setting-card" Padding="18,16" Margin="0,0,0,16">
                <StackPanel Spacing="10">
                    <!-- Row 1: logo + version on left, update button on right -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                            <!-- White note, transparent corners, plus a small transparent margin
                                 baked into the asset so the circle's cardinal points have room to
                                 antialiase (the source circle is full-bleed and would otherwise
                                 render with flat spots at 12/3/6/9 o'clock). No clip needed. -->
                            <Border Width="40" Height="40">
                                <Image Source="avares://Noctis/Assets/Icons/Noctis%20Logo%20Padded.png"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Noctis" FontSize="16" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Click-to-copy version + OS/arch (handy for bug reports) -->
                                    <Button Classes="version-copy"
                                            Background="Transparent"
                                            Padding="0"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Command="{Binding CopyVersionInfoCommand}"
                                            ToolTip.Tip="Click to copy version and system info"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AppVersion}"
                                                   FontSize="12" Opacity="0.5"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                    <TextBlock Text="Copied!"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentColorBrush}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding VersionCopied}"/>
                                    <Border IsVisible="{Binding IsPrereleaseBuild}"
                                            Background="#E74856"
                                            CornerRadius="9"
                                            Padding="8,3,8,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="Pre-Release"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Action buttons (top-right) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Update-available dot next to the update pill, mirroring the
                                 sidebar settings-icon badge -->
                            <Ellipse Width="8" Height="8"
                                     Fill="{DynamicResource AccentColorBrush}"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsUpdateAvailable}"/>
                            <Button Command="{Binding CheckForUpdateCommand}"
                                    Classes="pill update-pill"
                                    Classes.up-to-date="{Binding IsUpToDate}"
                                    VerticalAlignment="Center"
                                    Padding="16,6"
                                    IsVisible="{Binding ShowCheckForUpdatesButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Classes="loading-spinner"
                                             Stroke="White"
                                             IsVisible="{Binding IsCheckingForUpdate}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CheckForUpdatesButtonText}"
                                               FontSize="12" Foreground="White"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Update Available button (replaces Check when a new release is detected).
                                 In-app installer path: Inno install (incl. winget/Chocolatey). -->
                            <Button Command="{Binding DownloadUpdateCommand}"
                                    Classes="pill"
                                    VerticalAlignment="Center"
                                    Padding="16,6"
                                    Background="#E74856"
                                    IsVisible="{Binding ShowInAppUpdateButton}">
                                <TextBlock Text="{Binding UpdateButtonText}"
                                           FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Scoop / portable copies can't safely run the in-app installer;
                                 open the GitHub release instead and surface the update command. -->
                            <Button Command="{Binding OpenLatestReleaseCommand}"
                                    Classes="pill"
                                    VerticalAlignment="Center"
                                    Padding="16,6"
                                    Background="#E74856"
                                    ToolTip.Tip="{Binding ExternalUpdateHint}"
                                    IsVisible="{Binding ShowManualUpdateButton}">
                                <TextBlock Text="{Binding UpdateButtonText}"
                                           FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Install & Restart button (replaces Update when ready) -->
                            <Button Command="{Binding InstallUpdateCommand}"
                                    Classes="pill"
                                    VerticalAlignment="Center"
                                    Padding="16,6"
                                    Background="#E74856"
                                    IsVisible="{Binding IsReadyToInstall}">
                                <TextBlock Text="Install &amp; Restart" FontSize="12" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Update status area -->
                    <StackPanel Orientation="Horizontal" Spacing="12"
                                IsVisible="{Binding UpdateStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding UpdateStatusText}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12"
                                IsVisible="{Binding IsDownloadingUpdate}">
                        <ProgressBar Minimum="0" Maximum="100"
                                     Value="{Binding DownloadProgress}"
                                     Height="4" CornerRadius="2"
                                     VerticalAlignment="Center"
                                     MinWidth="200" />
                        <Button Command="{Binding CancelUpdateCommand}"
                                Classes="pill"
                                Padding="16,6"
                                VerticalAlignment="Center">
                            <TextBlock Text="Cancel" FontSize="12" />
                        </Button>
                    </StackPanel>

                    <!-- Row 2: GitHub + Discord (brand-coloured icons, hover pill) -->
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="-10,0,0,2">
                        <Button Classes="social-link social-github"
                                Command="{Binding OpenGitHubCommand}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource StarIcon}"
                                          Width="14" Height="14"
                                          Foreground="#F1C40F" />
                                <TextBlock Text="Star on GitHub"
                                           FontSize="12" Opacity="0.85"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="social-link social-discord"
                                Command="{Binding OpenDiscordCommand}"
                                Margin="-6,0,0,0"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource DiscordIcon}"
                                          Width="14" Height="14"
                                          Foreground="#5865F2" />
                                <TextBlock Text="Join Discord"
                                           FontSize="12" Opacity="0.85"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="social-link"
                                Command="{Binding OpenWebsiteCommand}"
                                Margin="-6,0,0,0"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="avares://Noctis/Assets/Icons/Noctis%20Logo%20Padded.png"
                                       Width="18" Height="18"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                                <TextBlock Text="Official Website"
                                           FontSize="12" Opacity="0.85"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Height="1"
                            Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                            Opacity="0.2" Margin="0,4"/>

                    <!-- Row 3: pre-release toggle -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Include pre-release updates" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Offer beta builds in the updater. Off = stable releases only."
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding IncludePrereleaseUpdates}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Signature -->
                    <TextBlock Text="Yours Truly, heartached."
                               FontSize="12" Opacity="0.4"/>
                </StackPanel>
            </Border>

            <!-- Developer -->
            <Border Classes="setting-card" Padding="18,16" Margin="0,16,0,0">
                <StackPanel Spacing="10">
                    <!-- Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Developer Mode" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Show the version manager and debug logs."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding DeveloperMode}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Spacing="10" IsVisible="{Binding DeveloperMode}">

                        <!-- ── Version manager ── -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                            <TextBlock Grid.Column="0"
                                       Text="Download and install any release from GitHub. Installing closes the app."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <Ellipse Grid.Column="1"
                                     Classes="loading-spinner"
                                     IsVisible="{Binding IsLoadingReleases}"
                                     VerticalAlignment="Center"
                                     Margin="8,0,0,0"/>
                        </Grid>

                        <TextBlock Text="No releases found."
                                   FontSize="13" Opacity="0.55"
                                   HorizontalAlignment="Center"
                                   Margin="0,8"
                                   IsVisible="{Binding ShowDevReleasesEmpty}"/>

                        <!-- Full release history; scrolls with the settings page itself -->
                        <ItemsControl ItemsSource="{Binding DevReleases}"
                                      IsEnabled="{Binding !IsDevDownloading}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DevReleaseItem">
                                        <Border Background="#12FFFFFF" CornerRadius="10"
                                                Padding="12,8" Margin="0,3">
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding VersionDisplay}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="1"
                                                        IsVisible="{Binding IsPrerelease}"
                                                        Background="{DynamicResource AccentColorBrush}" CornerRadius="999"
                                                        Padding="7,2" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="Pre-release" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentForegroundBrush}"/>
                                                </Border>
                                                <Border Grid.Column="2"
                                                        IsVisible="{Binding IsLatest}"
                                                        Background="{DynamicResource AccentColorBrush}" CornerRadius="999"
                                                        Padding="7,2" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="Latest" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentForegroundBrush}"/>
                                                </Border>
                                                <Border Grid.Column="3"
                                                        IsVisible="{Binding ShowInstalledBadge}"
                                                        Background="{DynamicResource AccentColorBrush}" CornerRadius="999"
                                                        Padding="7,2" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="Installed" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentForegroundBrush}"/>
                                                </Border>
                                                <TextBlock Grid.Column="4"
                                                           IsVisible="{Binding HasWarning}"
                                                           Text="{Binding WarningText}"
                                                           ToolTip.Tip="{Binding WarningText}"
                                                           FontSize="11"
                                                           Foreground="#F1C40F"
                                                           Opacity="0.9"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="5"
                                                           Text="{Binding DateDisplay}"
                                                           FontSize="12" Opacity="0.5"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0"/>
                                                <Button Grid.Column="6"
                                                        Classes="pill-action"
                                                        IsVisible="{Binding !IsCurrent}"
                                                        Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).InstallReleaseCommand}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding ActionLabel}" FontSize="12"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Expand to the full release history -->
                        <Button IsVisible="{Binding HasHiddenReleases}"
                                Command="{Binding ShowOlderReleasesCommand}"
                                Classes="accent-btn"
                                Background="{DynamicResource AccentButtonBackground}"
                                Foreground="{DynamicResource AccentForegroundBrush}"
                                BorderThickness="0"
                                CornerRadius="999"
                                Padding="14,6"
                                HorizontalAlignment="Center"
                                Cursor="Hand">
                            <TextBlock Text="{Binding ShowOlderVersionsLabel}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Button>

                        <!-- Download status / progress -->
                        <StackPanel x:Name="DevDownloadPanel" Spacing="10">
                            <TextBlock Text="{Binding DevStatusText}"
                                       FontSize="12" Opacity="0.7"
                                       IsVisible="{Binding DevStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <StackPanel Orientation="Horizontal" Spacing="12"
                                        IsVisible="{Binding IsDevDownloading}">
                                <ProgressBar Minimum="0" Maximum="100"
                                             Value="{Binding DevDownloadProgress}"
                                             Height="4" CornerRadius="2"
                                             VerticalAlignment="Center"
                                             MinWidth="200"/>
                                <Button Classes="pill-action"
                                        Command="{Binding CancelDevDownloadCommand}">
                                    <TextBlock Text="Cancel" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- ── Debug logs ── -->
                        <TextBlock Text="{Binding PreservedCrashBanner}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#E5A34D"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   IsVisible="{Binding PreservedCrashBanner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="Session log for troubleshooting. Share these when reporting bugs."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="pill-action" Command="{Binding CopyDevLogsCommand}">
                                <TextBlock Text="Copy Logs" FontSize="12"/>
                            </Button>
                            <Button Classes="pill-action" Command="{Binding ClearDevLogsCommand}">
                                <TextBlock Text="Clear" FontSize="12"/>
                            </Button>
                            <Button Classes="pill-action" Command="{Binding OpenLogsFolderCommand}"
                                    ToolTip.Tip="Open the app data folder (also holds crash.log)">
                                <TextBlock Text="Open Folder" FontSize="12"/>
                            </Button>
                            <TextBlock Text="Copied!"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentColorBrush}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding DevLogsCopied}"/>
                        </StackPanel>
                        <Border Background="#12FFFFFF" CornerRadius="10" Padding="12,8" MaxHeight="190">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <SelectableTextBlock Text="{Binding DevLogText}"
                                                     FontSize="11"
                                                     FontFamily="Consolas, Menlo, monospace"
                                                     Opacity="0.8"
                                                     TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>

                    </StackPanel>
                </StackPanel>
            </Border>

            </StackPanel>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- APPEARANCE                                          -->
            <!-- ═══════════════════════════════════════════════════ -->
            <StackPanel x:Name="AppearanceTabPanel" Classes="tab-page" IsVisible="{Binding IsAppearanceTabVisible}" Spacing="4">

            <Border Classes="setting-card" Padding="22,12">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Themes" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Choose how Noctis looks on your device."
                                   FontSize="12" Opacity="0.5"/>
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal">
                        <WrapPanel.Styles>
                            <Style Selector="Button.theme-btn">
                                <Setter Property="Margin" Value="0,0,10,10"/>
                            </Style>
                        </WrapPanel.Styles>
                        <!-- Dark (pure black, silver accents) -->
                        <Button Classes="theme-btn"
                                Classes.active="{Binding IsDarkTheme}"
                                Command="{Binding SetDarkThemeCommand}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="64" Height="40" CornerRadius="6"
                                        Background="#000000"
                                        BorderBrush="#1A1A1A" BorderThickness="1">
                                    <StackPanel Margin="6,5" Spacing="3">
                                        <Border Height="3" Width="30" CornerRadius="1.5"
                                                Background="#E8E8E8" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="20" CornerRadius="1.5"
                                                Background="#A8A8A8" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="36" CornerRadius="1.5"
                                                Background="#707070" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Dark" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Gray (default) -->
                        <Button Classes="theme-btn"
                                Classes.active="{Binding IsGrayTheme}"
                                Command="{Binding SetGrayThemeCommand}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="64" Height="40" CornerRadius="6"
                                        Background="#1E1E1E"
                                        BorderBrush="#444" BorderThickness="1">
                                    <StackPanel Margin="6,5" Spacing="3">
                                        <Border Height="3" Width="30" CornerRadius="1.5"
                                                Background="#555" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="20" CornerRadius="1.5"
                                                Background="#444" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="36" CornerRadius="1.5"
                                                Background="#333" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Gray" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Midnight (deep blue-black) -->
                        <Button Classes="theme-btn"
                                Classes.active="{Binding IsMidnightTheme}"
                                Command="{Binding SetMidnightThemeCommand}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="64" Height="40" CornerRadius="6"
                                        Background="#0E1322"
                                        BorderBrush="#1E2640" BorderThickness="1">
                                    <StackPanel Margin="6,5" Spacing="3">
                                        <Border Height="3" Width="30" CornerRadius="1.5"
                                                Background="#7C8CFF" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="20" CornerRadius="1.5"
                                                Background="#5A6BB0" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="36" CornerRadius="1.5"
                                                Background="#3A4673" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Midnight" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Light -->
                        <Button Classes="theme-btn"
                                Classes.active="{Binding IsLightTheme}"
                                Command="{Binding SetLightThemeCommand}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="64" Height="40" CornerRadius="6"
                                        Background="#F5F5F5"
                                        BorderBrush="#CCC" BorderThickness="1">
                                    <StackPanel Margin="6,5" Spacing="3">
                                        <Border Height="3" Width="30" CornerRadius="1.5"
                                                Background="#CCC" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="20" CornerRadius="1.5"
                                                Background="#DDD" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="36" CornerRadius="1.5"
                                                Background="#E0E0E0" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Light" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- User-created themes -->
                        <ItemsControl ItemsSource="{Binding CustomThemes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CustomThemeTile">
                                    <Button Classes="theme-btn"
                                            Classes.active="{Binding IsActive}"
                                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).ApplyCustomThemeCommand}"
                                            CommandParameter="{Binding Id}"
                                            Margin="0,0,10,10">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Edit"
                                                          Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).OpenThemeEditorCommand}"
                                                          CommandParameter="{Binding Id}"/>
                                                <MenuItem Header="Delete"
                                                          Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DeleteCustomThemeCommand}"
                                                          CommandParameter="{Binding Id}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                                            <Border Width="64" Height="40" CornerRadius="6"
                                                    Background="{Binding MainHex}"
                                                    BorderBrush="{Binding SidebarHex}"
                                                    BorderThickness="1">
                                                <StackPanel Margin="6,5" Spacing="3">
                                                    <Border Height="3" Width="30" CornerRadius="1.5"
                                                            Background="{Binding AccentHex}" HorizontalAlignment="Left"/>
                                                    <Border Height="3" Width="20" CornerRadius="1.5"
                                                            Background="{Binding SidebarHex}" HorizontalAlignment="Left"/>
                                                    <Border Height="3" Width="36" CornerRadius="1.5"
                                                            Background="{Binding SidebarHex}" Opacity="0.65"
                                                            HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       MaxWidth="64" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- "+ Custom" add tile -->
                        <Button Classes="theme-btn"
                                Command="{Binding OpenThemeEditorCommand}"
                                CommandParameter="{x:Null}"
                                Margin="0,0,10,10"
                                ToolTip.Tip="Create custom theme">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="64" Height="40" CornerRadius="6"
                                        BorderBrush="#55FFFFFF" BorderThickness="1">
                                    <TextBlock Text="+" FontSize="22" Opacity="0.7"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Custom" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Accent colour -->
            <Border Classes="setting-card">
                <StackPanel Spacing="16">

                    <!-- Header row -->
                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Accent Color" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Pick a preset or open the picker for any custom color."
                                       FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- Preset grid + custom-picker tile -->
                    <StackPanel Spacing="8">
                        <StackPanel>
                            <!-- Preset swatches -->
                            <ItemsControl ItemsSource="{Binding AccentSwatches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="12"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccentSwatch">
                                        <Button Classes="accent-swatch"
                                                Background="Transparent" BorderThickness="0" Padding="0"
                                                Margin="0,0,4,4" Cursor="Hand"
                                                ToolTip.Tip="{Binding Name}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).ApplyAccentPresetCommand}"
                                                CommandParameter="{Binding}">
                                            <Panel Width="44" Height="44">
                                                <Border Width="40" Height="40" CornerRadius="20"
                                                        Background="{Binding Hex}"
                                                        BorderBrush="#22000000"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <!-- Selection ring sits on the colour's own edge (same
                                                     40px box) so the white overlaps the disc's rim — no
                                                     dark border or anti-alias seam shows between the
                                                     colour and the white outline. -->
                                                <Border Width="40" Height="40" CornerRadius="20"
                                                        BorderBrush="White" BorderThickness="2"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsActive}"/>
                                            </Panel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Custom-color tile: rainbow ring + plus, opens reusable HSV/hex picker.
                                 Same 44px cell as a swatch so it reads as the next slot in the grid. -->
                            <Panel Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,4,4">
                                <controls:ColorPickerFlyout Hex="{Binding CustomAccentHex, Mode=TwoWay}"
                                                            SwatchSize="44"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            ToolTip.Tip="Custom Color"
                                                            Cursor="Hand">
                                    <controls:ColorPickerFlyout.SwatchContent>
                                        <Panel Width="44" Height="44">
                                            <!-- Rainbow ring -->
                                            <Border Width="40" Height="40" CornerRadius="20"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="50%,50%">
                                                        <GradientStop Offset="0.00" Color="#FF0000"/>
                                                        <GradientStop Offset="0.17" Color="#FFFF00"/>
                                                        <GradientStop Offset="0.33" Color="#00FF00"/>
                                                        <GradientStop Offset="0.50" Color="#00FFFF"/>
                                                        <GradientStop Offset="0.67" Color="#0000FF"/>
                                                        <GradientStop Offset="0.83" Color="#FF00FF"/>
                                                        <GradientStop Offset="1.00" Color="#FF0000"/>
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <!-- White inner disc with + glyph -->
                                            <Border Width="30" Height="30" CornerRadius="15"
                                                    Background="{DynamicResource AppMainBackground}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="+"
                                                           FontSize="20" FontWeight="Light"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Width="40" Height="40" CornerRadius="20"
                                                    BorderBrush="White" BorderThickness="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    IsVisible="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).IsCustomAccentSelected}"/>
                                        </Panel>
                                    </controls:ColorPickerFlyout.SwatchContent>
                                </controls:ColorPickerFlyout>
                            </Panel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Liquid Glass (frosted translucent window, Apple Music-style).
                 Hidden on Linux: no Acrylic/Mica/blur-behind there, the hint would
                 only make the window see-through (issue #26). -->
            <Border Classes="setting-card" IsVisible="{Binding IsLiquidGlassSupported}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Liquid Glass" FontSize="15" FontWeight="SemiBold"/>
                            <Border Classes="beta-badge">
                                <TextBlock Classes="beta-badge-text" Text="BETA"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Frost the window with translucent, blurred glass surfaces."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding LiquidGlassEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Animated artwork -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Animated Artwork" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Show animated cover art when available."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding EnableAnimatedCovers}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Now-playing artwork costume (Discord suggestion): the Lyrics-page cover
                 can be printed on a CD, a vinyl sleeve or a cassette label instead of
                 the plain square. Discs and reels spin while music plays. -->
            <Border Classes="setting-card">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Now Playing Artwork" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="How the cover appears on the Lyrics page. Discs spin while music plays."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <RadioButton Grid.Column="0" Classes="transition-card medium-card"
                                     GroupName="NowPlayingArtwork"
                                     IsChecked="{Binding IsArtworkStyleCover, Mode=TwoWay}"
                                     ToolTip.Tip="The album cover as it is">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="3" Canvas.Top="3" Width="22" Height="22" RadiusX="5" RadiusY="5"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="Cover" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Classes="transition-card medium-card"
                                     GroupName="NowPlayingArtwork"
                                     IsChecked="{Binding IsArtworkStyleCompactDisc, Mode=TwoWay}"
                                     ToolTip.Tip="A spinning compact disc">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Ellipse Canvas.Left="2" Canvas.Top="2" Width="24" Height="24"
                                             Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="8"/>
                                </Canvas>
                                <TextBlock Text="CD" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="2" Classes="transition-card medium-card"
                                     GroupName="NowPlayingArtwork"
                                     IsChecked="{Binding IsArtworkStyleVinyl, Mode=TwoWay}"
                                     ToolTip.Tip="A sleeve with the record peeking out">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Ellipse Canvas.Left="10" Canvas.Top="6" Width="16" Height="16"
                                             Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="5"/>
                                    <Rectangle Canvas.Left="2" Canvas.Top="5" Width="18" Height="18" RadiusX="3" RadiusY="3"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="Vinyl" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="3" Classes="transition-card medium-card"
                                     GroupName="NowPlayingArtwork"
                                     IsChecked="{Binding IsArtworkStyleCassette, Mode=TwoWay}"
                                     ToolTip.Tip="A cassette with the cover on its label">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="2" Canvas.Top="6" Width="24" Height="16" RadiusX="4" RadiusY="4"
                                               Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="2.5"/>
                                    <Ellipse Canvas.Left="7" Canvas.Top="11.5" Width="5" Height="5"
                                             Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Ellipse Canvas.Left="16" Canvas.Top="11.5" Width="5" Height="5"
                                             Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="Cassette" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Cover Flow layout (Albums → Cover Flow). Three arrangements; the pill segment
                 on that page steps through the same three, and both persist here. -->
            <Border Classes="setting-card">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Cover Flow Layout" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="How the Cover Flow page arranges the queue's covers."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <RadioButton Grid.Column="0" Classes="transition-card medium-card"
                                     GroupName="CoverFlowLayout"
                                     IsChecked="{Binding IsCoverFlowCarousel, Mode=TwoWay}"
                                     ToolTip.Tip="The classic row: playing cover centred, history and up next to each side">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="1" Canvas.Top="9" Width="6" Height="10" RadiusX="1.5" RadiusY="1.5" Opacity="0.45"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="21" Canvas.Top="9" Width="6" Height="10" RadiusX="1.5" RadiusY="1.5" Opacity="0.45"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="8" Canvas.Top="5" Width="12" Height="18" RadiusX="2.5" RadiusY="2.5"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="Carousel" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Classes="transition-card medium-card"
                                     GroupName="CoverFlowLayout"
                                     IsChecked="{Binding IsCoverFlowCascade, Mode=TwoWay}"
                                     ToolTip.Tip="Tilted covers on a diagonal path with the track details beside them">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="4" Canvas.Top="1" Width="9" Height="9" RadiusX="2" RadiusY="2" Opacity="0.45"
                                               RenderTransformOrigin="50%,50%" RenderTransform="rotate(-24deg)"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="4" Canvas.Top="18" Width="9" Height="9" RadiusX="2" RadiusY="2" Opacity="0.45"
                                               RenderTransformOrigin="50%,50%" RenderTransform="rotate(18deg)"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="11" Canvas.Top="7" Width="14" Height="14" RadiusX="3" RadiusY="3"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="Cascade" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="2" Classes="transition-card medium-card"
                                     GroupName="CoverFlowLayout"
                                     IsChecked="{Binding IsCoverFlowCollage, Mode=TwoWay}"
                                     ToolTip.Tip="A mosaic of the queue's covers">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="2" Canvas.Top="2" Width="11" Height="11" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="15" Canvas.Top="2" Width="11" Height="11" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="2" Canvas.Top="15" Width="11" Height="11" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="15" Canvas.Top="15" Width="11" Height="11" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="Collage" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Mini player design (community mockups, 2026-09): the classic resizable card
                 or one of two fixed designs. Same three-card picker as Cover Flow; the mini
                 player follows the choice live. -->
            <Border Classes="setting-card">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Mini Player Design" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="How the mini player looks. Classic morphs with its size; Pill and Sleeve are fixed designs."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <RadioButton Grid.Column="0" Classes="transition-card medium-card"
                                     GroupName="MiniPlayerStyle"
                                     IsChecked="{Binding IsMiniStyleClassic, Mode=TwoWay}"
                                     ToolTip.Tip="The resizable glass card: icon, bar, card, large icon and lyrics forms">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="5" Canvas.Top="2" Width="18" Height="24" RadiusX="5" RadiusY="5"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="9" Canvas.Top="6" Width="10" Height="10" RadiusX="3" RadiusY="3" Opacity="0.45"
                                               Fill="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="Classic" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Classes="transition-card medium-card"
                                     GroupName="MiniPlayerStyle"
                                     IsChecked="{Binding IsMiniStylePill, Mode=TwoWay}"
                                     ToolTip.Tip="A round cover overlapping a light card with the title and transport">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="8" Canvas.Top="8" Width="19" Height="12" RadiusX="6" RadiusY="6" Opacity="0.45"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Ellipse Canvas.Left="1" Canvas.Top="6" Width="16" Height="16"
                                             Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="Pill" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="2" Classes="transition-card medium-card"
                                     GroupName="MiniPlayerStyle"
                                     IsChecked="{Binding IsMiniStyleSleeve, Mode=TwoWay}"
                                     ToolTip.Tip="A spinning disc peeking out of the top of a light card">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Ellipse Canvas.Left="6" Canvas.Top="1" Width="16" Height="16" Opacity="0.45"
                                             Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="3" Canvas.Top="9" Width="22" Height="17" RadiusX="5" RadiusY="5"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="Sleeve" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Album cover size (Albums / Favorites grids). Automatic = classic five per
                 row; custom size derives the column count from the window width instead,
                 so covers stay near the chosen size on ultrawide and small windows alike. -->
            <Border Classes="setting-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Automatic Album Cover Size" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Five covers per row. Turn off to pick your own cover size."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding AlbumTileSizeAuto}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                          IsVisible="{Binding !AlbumTileSizeAuto}">
                        <TextBlock Grid.Column="0" Text="Smaller"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Slider Grid.Column="1"
                                Classes="accent-slider"
                                Minimum="140" Maximum="320"
                                Value="{Binding AlbumTileTargetSize, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Larger"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding AlbumTileTargetSize, StringFormat='{}{0:0} px'}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center"
                                   MinWidth="52" TextAlignment="Right" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Flowing-light lyrics background (issue #22) -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Flowing Lyrics Background" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="The blurred album artwork drifts and pulses with the beat behind the lyrics on the lyrics page, the lyrics panel and the mini player. Artwork background only."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding LyricsFlowingLightEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Fullscreen lyrics focus -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Fullscreen Lyrics Focus" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Dim all but the current line and its neighbors in fullscreen."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding LyricsFullScreenFocusEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Join split karaoke words (issue #32) -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Join Split Words" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Keep words whole when TTML lyrics split them into syllables."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding LyricsJoinSplitWords}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Player bar opacity -->
            <Border Classes="setting-card">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Player Bar Opacity" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="How solid the playback bar's background looks."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <Slider Grid.Column="0"
                                Classes="accent-slider"
                                Minimum="0" Maximum="1"
                                Value="{Binding PlaybackBarBackgroundOpacity, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PlaybackBarBackgroundOpacity, StringFormat='{}{0:P0}'}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center"
                                   MinWidth="44" TextAlignment="Right" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Mini player opacity -->
            <Border Classes="setting-card">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Mini Player Opacity" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="How much of your desktop shows through the mini player's glass."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <Slider Grid.Column="0"
                                Classes="accent-slider"
                                Minimum="0" Maximum="1"
                                Value="{Binding MiniPlayerBackgroundOpacity, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding MiniPlayerBackgroundOpacity, StringFormat='{}{0:P0}'}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center"
                                   MinWidth="44" TextAlignment="Right" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            </StackPanel>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- AUDIO                                               -->
            <!-- ═══════════════════════════════════════════════════ -->
            <StackPanel x:Name="AudioTabPanel" Classes="tab-page" IsVisible="{Binding IsAudioTabVisible}" Spacing="4">

            <TextBlock Classes="section-title" Text="PLAYBACK" Margin="0,4,0,10"/>

            <!-- Song Transitions (Apple-style; drives the AutoMix engine).
                 Disabled + grayed while Exclusive Mode is on: every transition style
                 needs two overlapping streams, which single-stream exclusive output
                 can't provide. -->
            <Border Classes="setting-card"
                    IsEnabled="{Binding CanUseSongTransitions}"
                    Opacity="{Binding SongTransitionsOpacity}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Song Transitions" FontSize="15" FontWeight="SemiBold"/>
                                <Border Classes="beta-badge">
                                    <TextBlock Classes="beta-badge-text" Text="BETA"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Songs blend smoothly into each other. Albums still play without transitions."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                            <TextBlock Text="Unavailable while Exclusive Mode is on."
                                       IsVisible="{Binding ExclusiveAudioEnabled}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentColorBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding SongTransitionsEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Transition Style picker -->
                    <StackPanel Spacing="6" IsEnabled="{Binding SongTransitionsEnabled}">
                        <TextBlock Text="TRANSITION STYLE" FontSize="10" Opacity="0.45" Margin="2,4,0,2"/>

                        <RadioButton Classes="transition-card"
                                     GroupName="TransitionStyle"
                                     IsChecked="{Binding IsAutoMixStyle, Mode=TwoWay}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="AutoMix" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Transitions timed using each song's key and tempo."
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Classes="transition-card"
                                     GroupName="TransitionStyle"
                                     IsChecked="{Binding IsCrossfadeStyle, Mode=TwoWay}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Crossfade" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Simple fade between songs for a set duration."
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Crossfade Duration (only for the Crossfade style) -->
                        <StackPanel Classes="sub-setting" Spacing="6" Margin="2,4,0,0" IsVisible="{Binding IsCrossfadeStyle}">
                            <TextBlock Text="Crossfade Duration" FontSize="13" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <Slider Grid.Column="0"
                                        Classes="accent-slider"
                                        Minimum="1" Maximum="12"
                                        Value="{Binding CrossfadeDuration, Mode=TwoWay}"
                                        DoubleTapped="OnCrossfadeSliderDoubleTapped"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CrossfadeDuration, StringFormat='{}{0:0} seconds'}"
                                           FontSize="12" Opacity="0.7"
                                           VerticalAlignment="Center"
                                           MinWidth="74" TextAlignment="Right" Margin="12,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Sound Check -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Sound Check" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Keep song volume at a consistent level."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding SoundCheckEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Gapless playback -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Gapless Playback" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Tracks flow into each other without a pause."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding GaplessPlaybackEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Autoplay (tag-based queue continuation) -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Autoplay" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="When the queue ends, keep playing similar songs from your library."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding AutoplayEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Explicit content: a PLAYBACK filter (skip / exclude), not a library filter. -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Explicit Content" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Allow explicit songs. When off, they're skipped unless you play them directly."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding AllowExplicitContent}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Exclusive mode (Windows WASAPI) -->
            <Border Classes="setting-card" IsVisible="{Binding IsExclusiveAudioSupported}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Exclusive Mode" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Bit-perfect output that bypasses the Windows mixer. Other apps go silent and song transitions are off while it's active."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ExclusiveAudioStatus}"
                                   IsVisible="{Binding ExclusiveAudioStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   FontSize="12" Opacity="0.8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding ExclusiveAudioEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Audio analysis: tempo & key detection + tag writing -->
            <Border Classes="setting-card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Analyze Tempo &amp; Key" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Detect BPM and key for AutoMix and Track Radio."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding BpmKeyAnalysisEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Classes="sub-setting" ColumnDefinitions="*,Auto" IsEnabled="{Binding BpmKeyAnalysisEnabled}">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Save analysis to file tags" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Write BPM/key into the file's tags for newly analyzed tracks. This modifies your files."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding WriteAnalysisToTags}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Equalizer (lives under Playback — no redundant header) -->
            <Border Classes="setting-card" Padding="22,16,38,16" ClipToBounds="False">
                <StackPanel Spacing="16">
                    <!-- Header row with icon, preset selector, and reset button -->
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Equalizer" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Parametric EQ — tune each band's frequency, gain, and width (Q)."
                                           FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  x:Name="EqPresetCombo"
                                  Classes="pill-combo stable-popup"
                                  Width="164"
                                  ItemsSource="{Binding VisibleEqPresets}"
                                  SelectedItem="{Binding SelectedEqPresetName}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0" />
                        <Button Grid.Column="2"
                                Classes="pill-action"
                                Command="{Binding ResetEqualizerCommand}"
                                CornerRadius="16"
                                Padding="14,8"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="Reset"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- Pre-amp: level relative to native, applied before the curve.
                         Negative values create the headroom that keeps boosted bands
                         from clipping — the post-mix volume slider cannot. -->
                    <Grid ColumnDefinitions="120,*,64,92,34" Margin="0,2,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="Preamp"
                                   FontSize="12" FontWeight="SemiBold" Opacity="0.85"
                                   VerticalAlignment="Center"/>
                        <Slider Grid.Column="1"
                                Classes="accent-slider"
                                Minimum="-12" Maximum="6"
                                Value="{Binding EqPreampDb}"
                                DoubleTapped="OnEqPreampSliderDoubleTapped"
                                ToolTip.Tip="Level before the EQ — lower it if boosted bands distort. Double-tap to reset."
                                Margin="14,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding EqPreampDb, StringFormat='{}{0:+0.0;-0.0;0.0} dB'}"
                                   FontSize="11" Opacity="0.7"
                                   VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>

                    <!-- Parametric band rows: frequency / gain / Q per band -->
                    <StackPanel Spacing="0" Margin="0,4,0,0">
                        <Grid ColumnDefinitions="120,*,64,92,34" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" Text="FREQUENCY" FontSize="10" Opacity="0.45"/>
                            <TextBlock Grid.Column="1" Text="GAIN" FontSize="10" Opacity="0.45" Margin="14,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="Q" FontSize="10" Opacity="0.45" Margin="10,0,0,0" HorizontalAlignment="Center"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding EqBands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EqBandViewModel">
                                    <Grid ColumnDefinitions="120,*,64,92,34" Margin="0,3">
                                        <NumericUpDown Grid.Column="0"
                                                       Classes="eq-pill-number"
                                                       Value="{Binding FrequencyHz}"
                                                       Minimum="20" Maximum="20000" Increment="10"
                                                       FormatString="0"
                                                       FontSize="12"
                                                       ToolTip.Tip="Center frequency (Hz) — type, scroll, or use arrow keys"
                                                       VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1"
                                                Classes="accent-slider"
                                                Minimum="-12" Maximum="12"
                                                Value="{Binding GainDb}"
                                                DoubleTapped="OnEqGainSliderDoubleTapped"
                                                Margin="14,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding GainLabel}"
                                                   FontSize="11" Opacity="0.7"
                                                   VerticalAlignment="Center" TextAlignment="Right"/>
                                        <NumericUpDown Grid.Column="3"
                                                       Classes="eq-pill-number"
                                                       Value="{Binding Q}"
                                                       Minimum="0.1" Maximum="10" Increment="0.1"
                                                       FormatString="0.0#"
                                                       FontSize="12"
                                                       ToolTip.Tip="Q (band width) — higher values affect a narrower range around the frequency"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <Button Grid.Column="4"
                                                Content="✕" FontSize="11" Padding="7,4"
                                                Background="Transparent" Cursor="Hand"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                IsEnabled="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).CanRemoveEqBand}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveEqBandCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Remove band"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="pill-action"
                                Command="{Binding AddEqBandCommand}"
                                IsEnabled="{Binding CanAddEqBand}"
                                CornerRadius="16"
                                Padding="14,8"
                                Margin="0,8,0,0"
                                Cursor="Hand"
                                HorizontalAlignment="Left">
                            <TextBlock Text="+ Add Band" FontSize="13" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>


            <TextBlock Classes="section-title" Text="AUDIO TOOLS" Margin="0,20,0,10"/>

            <Border Classes="setting-card">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="ffmpeg" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Used by the audio converter. Leave blank to auto-detect."
                                   FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding FfmpegPath}"
                                 Watermark="(auto-detect)"
                                 CornerRadius="999"
                                 Padding="14,8"
                                 BorderThickness="1.5"
                                 MinHeight="0"
                                 KeyDown="OnFfmpegPathKeyDown" />
                        <Button Grid.Column="1"
                                Content="Browse"
                                Command="{Binding BrowseFfmpegCommand}"
                                Padding="14,8"
                                CornerRadius="999"
                                Margin="8,0,0,0"
                                Cursor="Hand"/>
                    </Grid>
                    <TextBlock Text="{Binding FfmpegStatus}"
                               FontSize="11" Opacity="0.6"
                               TextWrapping="Wrap"/>

                    <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.4" Margin="0,8,0,8"/>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Open File With" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Right-click a song → open its audio file in this program, e.g. an editor or analyzer. Leave blank to choose a program each time (Windows)."
                                   FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding ExternalOpenAppPath}"
                                 Watermark="(not set)"
                                 CornerRadius="999"
                                 Padding="14,8"
                                 BorderThickness="1.5"
                                 MinHeight="0" />
                        <Button Grid.Column="1"
                                Content="Browse"
                                Command="{Binding BrowseExternalOpenAppCommand}"
                                Padding="14,8"
                                CornerRadius="999"
                                Margin="8,0,0,0"
                                Cursor="Hand"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.4" Margin="0,8,0,8"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="ReplayGain" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Adjust volume using ReplayGain tags. Scan tracks via right-click → Scan ReplayGain."
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding ReplayGainEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Classes="sub-setting" ColumnDefinitions="120,*" IsEnabled="{Binding ReplayGainEnabled}">
                        <TextBlock Grid.Column="0" Text="Mode" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  Classes="pill-list"
                                  ItemsSource="{Binding ReplayGainModeOptions}"
                                  SelectedItem="{Binding ReplayGainMode}"
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="999"
                                  Padding="14,8"/>
                    </Grid>
                    <Grid Classes="sub-setting" ColumnDefinitions="120,*,Auto" IsEnabled="{Binding ReplayGainEnabled}">
                        <TextBlock Grid.Column="0" Text="Pre-amp (dB)" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" Height="20" ClipToBounds="False"
                              VerticalAlignment="Center" Margin="0,0,12,0">
                            <Canvas x:Name="PreampVisual"
                                    Height="20"
                                    ClipToBounds="False"
                                    IsHitTestVisible="False">
                                <Border x:Name="PreampTrackBackground"
                                        Height="6"
                                        CornerRadius="3"
                                        Background="{DynamicResource IslandSliderUnfilled}"
                                        Opacity="0.4"
                                        Canvas.Top="7"/>
                                <Border x:Name="PreampTrackFill"
                                        Height="6"
                                        CornerRadius="3"
                                        Background="{DynamicResource IslandSliderFilled}"
                                        Canvas.Top="7"/>
                                <Border x:Name="PreampThumb"
                                        Width="14"
                                        Height="14"
                                        CornerRadius="7"
                                        Background="{DynamicResource IslandSliderFilled}"
                                        BoxShadow="0 1 3 0 #40000000"
                                        Canvas.Top="3"/>
                            </Canvas>
                            <Slider x:Name="PreampSlider"
                                    Classes="preamp-horizontal"
                                    Value="{Binding ReplayGainPreampDb, Mode=TwoWay}"
                                    Minimum="-12" Maximum="12"
                                    HorizontalAlignment="Stretch"
                                    DoubleTapped="OnPreampSliderDoubleTapped" />
                        </Grid>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ReplayGainPreampDb, StringFormat='{}{0:+0.0;-0.0;0.0} dB'}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" MinWidth="60"/>
                    </Grid>
                </StackPanel>
            </Border>

            </StackPanel>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- INTEGRATIONS                                        -->
            <!-- ═══════════════════════════════════════════════════ -->
            <StackPanel x:Name="IntegrationsTabPanel" Classes="tab-page" IsVisible="{Binding IsIntegrationsTabVisible}" Spacing="4">

            <TextBlock Classes="section-title" Text="REMOTE CONTROL" Margin="0,4,0,10"/>

            <!-- Web remote -->
            <Border Classes="setting-card">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Web Remote" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Control playback from your phone on your local network. Traffic is unencrypted, so avoid untrusted Wi-Fi."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding WebRemoteEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Border Background="#18000000" CornerRadius="8" Padding="12,10"
                            IsVisible="{Binding WebRemoteUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <StackPanel Spacing="8">
                            <!-- Running: QR thumbnail + connection details. The card shows the
                                 token-free URL; the full auth link lives in the QR, the copy
                                 button and the enlarge flyout (screenshots leaked a live key). -->
                            <Grid ColumnDefinitions="Auto,*"
                                  IsVisible="{Binding WebRemoteQr, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Button Grid.Column="0" Classes="qr-thumb" Padding="0" Background="Transparent" BorderThickness="0"
                                        VerticalAlignment="Center" ToolTip.Tip="Tap to enlarge">
                                    <Border CornerRadius="6" ClipToBounds="True">
                                        <Image Source="{Binding WebRemoteQr}" Width="84" Height="84"/>
                                    </Border>
                                    <Button.Flyout>
                                        <Flyout Placement="RightEdgeAlignedTop">
                                            <StackPanel Spacing="10">
                                                <!-- Natural bitmap size: 1 module = 8 device px, no resampling —
                                                     the crispest render a camera can get off this screen. -->
                                                <Border CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Center">
                                                    <Image Source="{Binding WebRemoteQr}" Stretch="None"/>
                                                </Border>
                                                <SelectableTextBlock Text="{Binding WebRemoteUrl}" FontSize="12" Opacity="0.7"
                                                                     TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"/>
                                                <TextBlock Text="If your phone blocks the link as insecure, choose Continue. The remote uses plain HTTP on your local network."
                                                           FontSize="11" Opacity="0.45" TextWrapping="Wrap"
                                                           TextAlignment="Center" MaxWidth="300"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="OPEN ON YOUR PHONE" FontSize="10" Opacity="0.5"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SelectableTextBlock Text="{Binding WebRemoteDisplayUrl}" FontSize="14" FontWeight="SemiBold"
                                                             VerticalAlignment="Center"/>
                                        <Button Classes="pill-action" Command="{Binding CopyWebRemoteUrlCommand}"
                                                ToolTip.Tip="Copy the full link, including the access key">
                                            <TextBlock Text="Copy" FontSize="11"/>
                                        </Button>
                                        <TextBlock Text="Copied!" FontSize="11"
                                                   Foreground="{DynamicResource AccentColorBrush}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding WebRemoteUrlCopied}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                IsVisible="{Binding !WebRemotePhoneSeen}">
                                        <Ellipse Width="6" Height="6" Fill="#E5A34D" VerticalAlignment="Center"/>
                                        <TextBlock Text="Waiting for a phone. Scan the code or tap it to enlarge."
                                                   FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                IsVisible="{Binding WebRemotePhoneSeen}">
                                        <Ellipse Width="6" Height="6" Fill="#52B788" VerticalAlignment="Center"/>
                                        <TextBlock Text="Phone connected"
                                                   FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <!-- Enabled but the server threw on start -->
                            <TextBlock Text="{Binding WebRemoteUrl}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                       IsVisible="{Binding WebRemoteStartFailed}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="ACCOUNTS" Margin="0,12,0,10"/>

            <!-- Discord Rich Presence -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                            Background="#5865F2" Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <Viewbox Width="22" Height="22"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White"
                                      Data="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Discord Rich Presence" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Show your current song on Discord."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="2"
                                          IsChecked="{Binding DiscordRichPresenceEnabled}"
                                          VerticalAlignment="Center"
                                          Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- Last.fm -->
            <Border Classes="setting-card">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                Width="40" Height="40" CornerRadius="10"
                                Background="#D51007"
                                Margin="0,0,14,0"
                                VerticalAlignment="Top">
                            <Viewbox Width="22" Height="22"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White"
                                          Data="M10.584 17.21l-.88-2.392s-1.43 1.594-3.573 1.594c-1.897 0-3.244-1.649-3.244-4.288 0-3.382 1.704-4.591 3.381-4.591 2.42 0 3.189 1.567 3.849 3.574l.88 2.749c.88 2.666 2.529 4.81 7.284 4.81 3.409 0 5.718-1.044 5.718-3.793 0-2.227-1.265-3.381-3.63-3.931l-1.758-.385c-1.21-.275-1.567-.77-1.567-1.595 0-.934.742-1.484 1.952-1.484 1.32 0 2.034.495 2.144 1.677l2.749-.33c-.22-2.474-1.924-3.492-4.729-3.492-2.474 0-4.893.935-4.893 3.932 0 1.87.907 3.051 3.189 3.601l1.87.44c1.402.33 1.869.907 1.869 1.704 0 1.017-.99 1.43-2.86 1.43-2.776 0-3.932-1.457-4.59-3.464l-.907-2.75c-1.155-3.573-2.997-4.893-6.653-4.893C2.144 5.333 0 7.89 0 12.233c0 4.18 2.144 6.434 5.993 6.434 3.106 0 4.591-1.457 4.591-1.457z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                                    VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="Last.fm Scrobbling" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                            <TextBlock Text="Send plays to Last.fm."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap" MaxWidth="560"
                                       HorizontalAlignment="Left"
                                       Margin="-2,0,0,0"/>
                            <!-- ACCOUNT line sits inline with title/description so it pulls up tight
                                 against the description instead of dropping into its own grid row. -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding LastFmUsername, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Margin="-2,2,0,0">
                                <TextBlock Text="ACCOUNT" FontSize="12" Opacity="0.45" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LastFmUsername}" FontSize="12" Opacity="0.85" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Not connected state -->
                        <Button Grid.Column="2" Grid.Row="0"
                                IsVisible="{Binding !IsLastFmConnected}"
                                Content="Connect"
                                Classes="pill-action"
                                Command="{Binding LoginLastFmCommand}"
                                Padding="14,8"
                                CornerRadius="16"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Margin="0,0,0,4">
                            <Button.Template>
                                <ControlTemplate>
                                    <ContentPresenter Background="{DynamicResource AccentColorBrush}"
                                                      Foreground="{DynamicResource AccentForegroundBrush}"
                                                      CornerRadius="16"
                                                      Padding="14,8"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Content="{TemplateBinding Content}"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Status text removed -->

                        <!-- Logout button (top-right, when connected) -->
                        <Button Grid.Column="2" Grid.Row="0"
                                IsVisible="{Binding IsLastFmConnected}"
                                Command="{Binding LogoutLastFmCommand}"
                                Classes="pill-action"
                                Padding="14,8"
                                CornerRadius="16"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="Logout" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Enable Scrobbling (when connected) -->
                    <Grid IsVisible="{Binding IsLastFmConnected}" ColumnDefinitions="*,Auto" Margin="54,0,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="Enable Scrobbling"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding LastFmScrobblingEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ListenBrainz -->
            <Border Classes="setting-card">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                        <!-- Official multi-colour ListenBrainz logo (transparent PNG). It's the
                             hexagonal brand mark, so it stands on its own at the same 40×40 footprint
                             as the Discord / Last.fm tiles rather than sitting on a colour fill. -->
                        <Image Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                               Width="40" Height="40"
                               Margin="0,0,14,0"
                               VerticalAlignment="Top"
                               Source="avares://Noctis/Assets/Icons/ListenBrainz ICON.png"
                               RenderOptions.BitmapInterpolationMode="HighQuality"/>

                        <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                                    VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="ListenBrainz Scrobbling" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                            <TextBlock Text="Send plays to ListenBrainz."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap" MaxWidth="560"
                                       HorizontalAlignment="Left"
                                       Margin="-2,0,0,0"/>

                            <!-- ACCOUNT line sits inline with the title/description block so it pulls
                                 up tight against the description instead of dropping into its own grid row. -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding ListenBrainzUsername, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Margin="-2,2,0,0">
                                <TextBlock Text="ACCOUNT" FontSize="12" Opacity="0.45" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ListenBrainzUsername}" FontSize="12" Opacity="0.85" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Token row lives inside the same StackPanel as the title so it sits
                                 right under the description instead of leaving a gap. The Connect
                                 button is hoisted to column 2 (top-right) to match the Last.fm card. -->
                            <StackPanel IsVisible="{Binding !IsListenBrainzConnected}"
                                        Margin="-2,6,0,0"
                                        Spacing="4">
                                <TextBox x:Name="ListenBrainzTokenBox"
                                         Classes="metadata-info-field"
                                         Text="{Binding ListenBrainzToken}"
                                         PasswordChar="•"
                                         Watermark="ListenBrainz user token"
                                         FontSize="12"
                                         Width="280"
                                         HorizontalAlignment="Left"/>
                                <!-- Inline validation error (e.g. "Token required"), semantically red. -->
                                <TextBlock Text="{Binding ListenBrainzError}"
                                           IsVisible="{Binding ListenBrainzError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="#E74856"
                                           FontSize="11"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Not connected state (top-right, mirrors the Last.fm Connect button) -->
                        <Button Grid.Column="2" Grid.Row="0"
                                IsVisible="{Binding !IsListenBrainzConnected}"
                                Content="Connect"
                                Classes="pill-action"
                                Command="{Binding TestListenBrainzCommand}"
                                Padding="14,8"
                                CornerRadius="16"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Margin="0,0,0,4">
                            <Button.Template>
                                <ControlTemplate>
                                    <ContentPresenter Background="{DynamicResource AccentColorBrush}"
                                                      Foreground="{DynamicResource AccentForegroundBrush}"
                                                      CornerRadius="16"
                                                      Padding="14,8"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Content="{TemplateBinding Content}"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Logout button (top-right, when connected) -->
                        <Button Grid.Column="2" Grid.Row="0"
                                IsVisible="{Binding IsListenBrainzConnected}"
                                Command="{Binding LogoutListenBrainzCommand}"
                                Classes="pill-action"
                                Padding="14,8"
                                CornerRadius="16"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="Logout" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Enable Scrobbling (when connected) -->
                    <Grid IsVisible="{Binding IsListenBrainzConnected}" ColumnDefinitions="*,Auto" Margin="54,0,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="Enable Scrobbling"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding ListenBrainzScrobblingEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="MEDIA SERVER" Margin="0,20,0,10"/>

            <Border Classes="setting-card">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="Music Server" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                            <TextBlock Text="Stream your library from Jellyfin, Navidrome, Airsonic, Gonic, or any other Subsonic-compatible server."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap" MaxWidth="560"
                                       HorizontalAlignment="Left" Margin="-2,0,0,0"/>

                            <!-- Connected summary -->
                            <StackPanel IsVisible="{Binding IsMediaServerConnected}" Spacing="3" Margin="-2,8,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="server-field-label" Text="TYPE" Width="68" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MediaServerType}" FontSize="12" Opacity="0.85" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="server-field-label" Text="SERVER" Width="68" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MediaServerUrl}" FontSize="12" Opacity="0.85" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="server-field-label" Text="ACCOUNT" Width="68" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MediaServerUsername}" FontSize="12" Opacity="0.85" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Connection form (hidden while connected): labeled 2×2 grid,
                                 Enter in any field submits. -->
                            <!-- Fixed width so long input scrolls inside the boxes instead of
                                 growing them (left-aligned grids size star columns to content). -->
                            <Grid IsVisible="{Binding !IsMediaServerConnected}"
                                  ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto"
                                  Width="560" HorizontalAlignment="Left" Margin="-2,10,0,0">
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,0,10">
                                    <TextBlock Classes="server-field-label" Text="SERVER TYPE"/>
                                    <Border Classes="server-pill-shell">
                                        <ComboBox Classes="pill-list server-pill"
                                                  ItemsSource="{Binding MediaServerTypeOptions}"
                                                  SelectedItem="{Binding MediaServerType}"
                                                  IsEnabled="{Binding !IsMediaServerBusy}"
                                                  HorizontalAlignment="Stretch"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4" Margin="0,0,0,10">
                                    <TextBlock Classes="server-field-label" Text="SERVER ADDRESS"/>
                                    <TextBox Classes="metadata-info-field"
                                             Text="{Binding MediaServerUrl}"
                                             Watermark="https://music.example.com"
                                             IsEnabled="{Binding !IsMediaServerBusy}"
                                             FontSize="12">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding ConnectMediaServerCommand}"/>
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                    <TextBlock Classes="server-field-label" Text="USERNAME"/>
                                    <TextBox Classes="metadata-info-field"
                                             Text="{Binding MediaServerUsername}"
                                             Watermark="Username"
                                             IsEnabled="{Binding !IsMediaServerBusy}"
                                             FontSize="12">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding ConnectMediaServerCommand}"/>
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                                    <TextBlock Classes="server-field-label" Text="PASSWORD"/>
                                    <TextBox Classes="metadata-info-field"
                                             Text="{Binding MediaServerPassword}"
                                             PasswordChar="•"
                                             Watermark="Password"
                                             IsEnabled="{Binding !IsMediaServerBusy}"
                                             FontSize="12">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding ConnectMediaServerCommand}"/>
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                </StackPanel>
                            </Grid>

                            <!-- Status line: dot follows the state (green connected, red error),
                                 spinner while a connection attempt is running. -->
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="-2,8,0,0">
                                <Ellipse Classes="server-status-dot"
                                         Classes.connected="{Binding IsMediaServerConnected}"
                                         Classes.error="{Binding HasMediaServerError}"
                                         IsVisible="{Binding !IsMediaServerBusy}"
                                         VerticalAlignment="Center"/>
                                <Ellipse Classes="loading-spinner" Width="11" Height="11"
                                         IsVisible="{Binding IsMediaServerBusy}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Classes="server-status"
                                           Classes.error="{Binding HasMediaServerError}"
                                           Text="{Binding MediaServerStatusText}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Connect (top-right, mirrors the account cards) -->
                        <Button Grid.Column="1"
                                IsVisible="{Binding !IsMediaServerConnected}"
                                IsEnabled="{Binding !IsMediaServerBusy}"
                                Classes="pill-action"
                                Command="{Binding ConnectMediaServerCommand}"
                                Padding="14,8" CornerRadius="16" Cursor="Hand"
                                VerticalAlignment="Top" Margin="0,4,0,0">
                            <Button.Template>
                                <ControlTemplate>
                                    <ContentPresenter Background="{DynamicResource AccentColorBrush}"
                                                      Foreground="{DynamicResource AccentForegroundBrush}"
                                                      CornerRadius="16"
                                                      Padding="14,8"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Content="{TemplateBinding Content}"/>
                                </ControlTemplate>
                            </Button.Template>
                            <Panel>
                                <TextBlock Text="Connect" IsVisible="{Binding !IsMediaServerBusy}"/>
                                <TextBlock Text="Connecting…" IsVisible="{Binding IsMediaServerBusy}"/>
                            </Panel>
                        </Button>

                        <Button Grid.Column="1"
                                IsVisible="{Binding IsMediaServerConnected}"
                                Command="{Binding DisconnectMediaServerCommand}"
                                Classes="pill-action"
                                Padding="14,8" CornerRadius="16" Cursor="Hand"
                                VerticalAlignment="Top" Margin="0,4,0,0">
                            <TextBlock Text="Disconnect" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="LYRICS" Margin="0,20,0,10"/>

            <Border Classes="setting-card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Use online lyrics when local lyrics are missing."
                               FontSize="12" Opacity="0.5" Margin="0,0,0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="LRCLIB" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Community lyrics database" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding LrcLibEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="NetEase Cloud Music" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Large synced lyrics catalog" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding NetEaseEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="METADATA" Margin="0,20,0,10"/>

            <Border Classes="setting-card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Tag sources for Search metadata, in order."
                               FontSize="12" Opacity="0.5" Margin="0,0,0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Deezer" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Music streaming catalog" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding DeezerEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="MusicBrainz" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Open music encyclopedia" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding MusicBrainzEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>


            </StackPanel>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- LIBRARY (folders, scan, startup preferences)        -->
            <!-- ═══════════════════════════════════════════════════ -->
            <StackPanel x:Name="LibraryTabPanel" Classes="tab-page" IsVisible="{Binding IsLibraryTabVisible}" Spacing="4">

            <Border Classes="setting-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Media Folder Locations" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Folders where your music is stored."
                                           FontSize="12" Opacity="0.5"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="AddFolderButton"
                                Classes="pill-action"
                                Padding="14,8"
                                CornerRadius="16"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="Add Folder" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Folder list -->
                    <ItemsControl ItemsSource="{Binding MusicFolders}">
                        <ItemsControl.Styles>
                            <Style Selector="ItemsControl:empty">
                                <Setter Property="IsVisible" Value="False"/>
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <Border Padding="14,8" Margin="0,2" CornerRadius="12"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1"
                                                Content="&#x2715;"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveFolderCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="14"
                                                Opacity="0.5"
                                                Cursor="Hand"
                                                Padding="4"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Library Management (scan) -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Library Scan" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Find new tracks and update search."
                                       FontSize="12" Opacity="0.5"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Classes="loading-spinner"
                                 IsVisible="{Binding IsScanning}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ScanStatusText}"
                                   FontSize="12"
                                   Opacity="0.6"
                                   VerticalAlignment="Center"/>
                        <Button Classes="pill-action"
                                Command="{Binding RescanCommand}"
                                IsEnabled="{Binding !IsScanning}"
                                Padding="14,8"
                                CornerRadius="16"
                                Cursor="Hand">
                            <TextBlock Text="Scan Library" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>


            <!-- Library Tools (Library group) -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Organize Files" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Rename and move files into a tag-based folder structure, with a preview first."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="pill-action"
                            Command="{Binding OpenOrganizeFilesCommand}"
                            Padding="14,8" CornerRadius="16" Cursor="Hand"
                            VerticalAlignment="Center">
                        <TextBlock Text="Organize" FontSize="13" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Find Duplicates (Library group) -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Find Duplicates" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Find duplicate tracks and remove the copies you don't want."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="pill-action"
                            Command="{Binding OpenDuplicateFinderCommand}"
                            Padding="14,8" CornerRadius="16" Cursor="Hand"
                            VerticalAlignment="Center">
                        <TextBlock Text="Find" FontSize="13" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Find Metadata (Library group) -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Find Metadata" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Identify poorly-tagged tracks and review proposed tags before applying."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="pill-action"
                            Command="{Binding OpenMetadataFinderCommand}"
                            Padding="14,8" CornerRadius="16" Cursor="Hand"
                            VerticalAlignment="Center">
                        <TextBlock Text="Find" FontSize="13" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Import Playlist (Library group) -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Import Playlist" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Import an Exportify CSV or TuneMyMusic JSON export and match tracks to your library."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="pill-action"
                            Command="{Binding OpenPlaylistImportCommand}"
                            Padding="14,8" CornerRadius="16" Cursor="Hand"
                            VerticalAlignment="Center">
                        <TextBlock Text="Import" FontSize="13" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Scan on startup (Library group) -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Scan on Startup" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Scan music folders when Noctis starts."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding ScanOnStartup}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Watch folders for changes (Library group) -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Watch Folders" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Update the library automatically as files change."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding WatchFoldersEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Embedded tag artwork (Library group) -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Use Embedded Artwork" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Use artwork embedded in file tags for album covers."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding UseEmbeddedArtwork}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Snoozed tracks (hidden from shuffle + radio) -->
            <Border Classes="setting-card">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Snoozed Tracks" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Hidden from shuffle and radio until their snooze expires."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Text="No snoozed tracks."
                               FontSize="13" Opacity="0.45"
                               IsVisible="{Binding !HasSnoozedTracks}"/>

                    <ItemsControl ItemsSource="{Binding SnoozedTracks}">
                        <ItemsControl.Styles>
                            <Style Selector="ItemsControl:empty">
                                <Setter Property="IsVisible" Value="False"/>
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Track">
                                <Border Padding="14,8" Margin="0,2" CornerRadius="12"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Artist}"
                                                       FontSize="12" Opacity="0.55"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SnoozedUntil, StringFormat='Until {0:MMM d, yyyy}'}"
                                                   FontSize="12" Opacity="0.5"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0"/>
                                        <Button Grid.Column="2"
                                                Classes="pill-action"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).UnsnoozeCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="12,6"
                                                CornerRadius="14"
                                                Cursor="Hand"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Un-snooze" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Removed tracks (removed from the library with "Keep Files") -->
            <Border Classes="setting-card">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Removed Tracks" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Removed from your library with their files kept on disk. Restore adds them back."
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Text="No removed tracks."
                               FontSize="13" Opacity="0.45"
                               IsVisible="{Binding !HasRemovedTracks}"/>

                    <ItemsControl ItemsSource="{Binding RemovedTracks}">
                        <ItemsControl.Styles>
                            <Style Selector="ItemsControl:empty">
                                <Setter Property="IsVisible" Value="False"/>
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:RemovedTrackEntry">
                                <Border Padding="14,8" Margin="0,2" CornerRadius="12"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Folder}"
                                                       FontSize="12" Opacity="0.55"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Classes="pill-action"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RestoreRemovedTrackCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="12,6"
                                                CornerRadius="14"
                                                Cursor="Hand"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Restore" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- STORAGE                                            -->
            <!-- ═══════════════════════════════════════════════════ -->
            <TextBlock Classes="section-title" Text="STORAGE" Margin="0,20,0,10"/>

            <!-- Disk usage -->
            <Border Classes="setting-card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Disk Usage" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Space used by Noctis data."
                                           FontSize="12" Opacity="0.5"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Command="{Binding OpenDataFolderCommand}"
                                Classes="pill-action"
                                Padding="14,8"
                                CornerRadius="16"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="Open Data Folder" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <StackPanel Spacing="8" Margin="0,4,0,0">
                        <!-- Library size (music files on disk) -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Library Size"
                                       FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalFileSize}"
                                       FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Opacity="0.2"/>

                        <!-- Library data -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Library Data"
                                       FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding StorageLibraryData}"
                                       FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Opacity="0.2"/>

                        <!-- Artwork cache -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Artwork Cache"
                                       FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding StorageArtwork}"
                                       FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Opacity="0.2"/>

                        <!-- Playlists -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Playlists"
                                       FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding StoragePlaylists}"
                                       FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Opacity="0.2"/>

                        <!-- Settings -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Settings"
                                       FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding StorageSettings}"
                                       FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Opacity="0.3"/>

                        <!-- Total -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="Total"
                                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding StorageTotal}"
                                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </Border>


            <!-- ═══════════════════════════════════════════════════ -->
            <!-- ADVANCED                                           -->
            <!-- ═══════════════════════════════════════════════════ -->
            <TextBlock Classes="section-title" Text="ADVANCED" Margin="0,20,0,10"/>

            <!-- Combined Advanced card (Reset · Fetch Images · Clear Cache) -->
            <Border Classes="setting-card">
                <StackPanel Spacing="14">

                    <!-- Reset Settings -->
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Reset Settings" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Restore defaults and clear saved library data."
                                               FontSize="12" Opacity="0.5"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding ShowResetConfirmCommand}"
                                    IsVisible="{Binding !IsResetConfirmVisible}"
                                    Classes="pill-action"
                                    Padding="14,8"
                                    CornerRadius="16"
                                    Cursor="Hand"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Reset Settings" FontSize="13"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                        <StackPanel IsVisible="{Binding IsResetConfirmVisible}" Spacing="8">
                            <TextBlock Text="Are you sure? This action cannot be undone."
                                       FontSize="13" Foreground="#E74856"/>
                            <TextBlock Text="{Binding ResetConfirmDetail}"
                                       FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Cancel"
                                        Command="{Binding CancelResetCommand}"
                                        Classes="pill-action"
                                        FontWeight="Bold"
                                        Padding="16,10"
                                        CornerRadius="18"
                                        Cursor="Hand"/>
                                <Button Content="Reset Everything"
                                        Command="{Binding ConfirmResetLibraryCommand}"
                                        Classes="pill-action danger"
                                        FontWeight="Bold"
                                        Padding="16,10"
                                        CornerRadius="18"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Opacity="0.2"/>

                    <!-- Clear Artwork Cache -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Clear Artwork Cache" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Delete cached artwork. It will rebuild on the next scan."
                                            FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                                <TextBlock Text="Note: This removes all artwork from your library."
                                           FontSize="12" Foreground="#E74856" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding ClearArtworkCacheCommand}"
                                Classes="pill-action"
                                Padding="14,8"
                                CornerRadius="16"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="Clear Cache" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                </StackPanel>
            </Border>

            </StackPanel>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- ═══════════════════════════════════════════════ -->
            <!-- SHORTCUTS (rebindable keys)                          -->
            <!-- ═══════════════════════════════════════════════ -->
            <StackPanel x:Name="ShortcutsTabPanel" Classes="tab-page" IsVisible="{Binding IsShortcutsTabVisible}" Spacing="4">
                <Border Classes="setting-card">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Keyboard shortcuts" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Click a key to change it. Press Esc while recording to cancel, Backspace to unbind. Media keys on your keyboard always work and are not listed here."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Reset all"
                                FontSize="12" FontWeight="SemiBold"
                                Padding="14,7"
                                CornerRadius="999"
                                BorderThickness="0"
                                Background="{DynamicResource SystemControlBackgroundListMediumBrush}"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0"
                                Command="{Binding Shortcuts.ResetAllCommand}"/>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Shortcuts.Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShortcutGroup">
                            <Border Classes="setting-card">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="12"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ShortcutRowViewModel">
                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13" VerticalAlignment="Center"/>
                                                    <controls:ShortcutKeyChip Grid.Column="1" VerticalAlignment="Center"/>
                                                    <!-- Per-row reset, only once the row differs from its default. -->
                                                    <Button Grid.Column="2"
                                                            Width="26" Height="26"
                                                            Margin="6,0,0,0"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            CornerRadius="999"
                                                            Cursor="Hand"
                                                            ToolTip.Tip="Reset to default"
                                                            IsVisible="{Binding !IsDefault}"
                                                            Command="{Binding ResetCommand}">
                                                        <PathIcon Data="M 12.5 8 A 4.5 4.5 0 1 1 11.2 4.8 M 11.5 2 L 11.5 5 L 8.5 5"
                                                                  Width="13" Height="13"
                                                                  Opacity="0.7"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- STATISTICS (listening statistics)                   -->
            <!-- ═══════════════════════════════════════════════════ -->
            <StackPanel x:Name="StatisticsTabPanel" Classes="tab-page" IsVisible="{Binding IsStatisticsTabVisible}" Spacing="4">

            <!-- Library overview (moved from Library tab) -->
            <TextBlock Classes="section-title" Text="LIBRARY OVERVIEW" Margin="0,4,0,10"/>

            <Border Classes="setting-card">
                <StackPanel Spacing="18">
                    <TextBlock Text="Your Music Library" FontSize="15" FontWeight="SemiBold"/>

                    <!-- Primary stats: Songs · Artists · Albums · Total Duration -->
                    <UniformGrid Columns="4" Margin="0,2,0,0">
                        <Border CornerRadius="10" Padding="14,16" Margin="0,0,8,0"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding TotalSongs}"
                                           FontSize="24" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Songs" FontSize="11" Opacity="0.55"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="10" Padding="14,16" Margin="4,0"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding TotalArtists}"
                                           FontSize="24" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Artists" FontSize="11" Opacity="0.55"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="10" Padding="14,16" Margin="4,0"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding TotalAlbums}"
                                           FontSize="24" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Albums" FontSize="11" Opacity="0.55"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="10" Padding="14,16" Margin="8,0,0,0"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding TotalListeningTime}"
                                           FontSize="20" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Total Duration" FontSize="11" Opacity="0.55"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Audio Quality: smaller chips, Hi-Res accented -->
                    <StackPanel Spacing="8" Margin="0,4,0,0">
                        <TextBlock Text="Audio Quality" FontSize="12" Opacity="0.55"
                                   FontWeight="SemiBold" Classes="section-title"/>
                        <Grid ColumnDefinitions="*,*,*">
                            <Border Grid.Column="0" CornerRadius="8" Padding="12,10" Margin="0,0,6,0"
                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding LosslessCount}"
                                               FontSize="17" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Lossless" FontSize="11" Opacity="0.55"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" CornerRadius="8" Padding="12,10" Margin="3,0"
                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding HiResCount}"
                                               FontSize="17" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Hi-Res Lossless" FontSize="11" Opacity="0.55"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" CornerRadius="8" Padding="12,10" Margin="6,0,0,0"
                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding LossyCount}"
                                               FontSize="17" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Lossy" FontSize="11" Opacity="0.55"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Playlists footer (text-only so 0 doesn't dominate) -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                        <TextBlock Text="{Binding TotalPlaylists}" FontSize="12"
                                   FontWeight="SemiBold" Opacity="0.7"/>
                        <TextBlock Text="playlists" FontSize="12" Opacity="0.55"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- LISTENING                                          -->
            <!-- ═══════════════════════════════════════════════════ -->
            <TextBlock Classes="section-title" Text="LISTENING" Margin="0,20,0,10"/>

            <Border Classes="setting-card">
                <StackPanel Spacing="18">
                    <TextBlock Text="Your Listening" FontSize="15" FontWeight="SemiBold"/>

                    <!-- Play stats: Total Plays · Time Listened · Avg Track Length · Liked Songs -->
                    <UniformGrid Columns="4" Margin="0,2,0,0">
                        <Border CornerRadius="10" Padding="14,16" Margin="0,0,8,0"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding TotalPlays}"
                                           FontSize="24" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Total Plays" FontSize="11" Opacity="0.55"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="10" Padding="14,16" Margin="4,0"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding TimeListened}"
                                           FontSize="20" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Time Listened" FontSize="11" Opacity="0.55"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="10" Padding="14,16" Margin="4,0"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding AvgTrackLength}"
                                           FontSize="24" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Avg Track Length" FontSize="11" Opacity="0.55"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="10" Padding="14,16" Margin="8,0,0,0"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding LikedTracks}"
                                           FontSize="24" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Liked Songs" FontSize="11" Opacity="0.55"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- TOP PLAYED                                         -->
            <!-- ═══════════════════════════════════════════════════ -->
            <TextBlock Classes="section-title" Text="TOP PLAYED" Margin="0,20,0,10"/>

            <Grid ColumnDefinitions="*,12,*">
                <Border Grid.Column="0" Classes="setting-card" VerticalAlignment="Top">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Top Artists" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Play some tracks to see your top artists"
                                   FontSize="13" Opacity="0.4"
                                   IsVisible="{Binding !TopArtists.Count}"/>
                        <ItemsControl ItemsSource="{Binding TopArtists}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StatItem">
                                    <Grid ColumnDefinitions="28,*,Auto" Margin="0,5">
                                        <TextBlock Grid.Column="0" Text="{Binding Rank}"
                                                   FontSize="13" FontWeight="SemiBold" Opacity="0.35"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Text="{Binding SubLabel}" FontSize="11" Opacity="0.5"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ValueLabel}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Classes="setting-card" VerticalAlignment="Top">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Top Albums" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Play some tracks to see your top albums"
                                   FontSize="13" Opacity="0.4"
                                   IsVisible="{Binding !TopAlbums.Count}"/>
                        <ItemsControl ItemsSource="{Binding TopAlbums}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StatItem">
                                    <Grid ColumnDefinitions="28,*,Auto" Margin="0,5">
                                        <TextBlock Grid.Column="0" Text="{Binding Rank}"
                                                   FontSize="13" FontWeight="SemiBold" Opacity="0.35"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Text="{Binding SubLabel}" FontSize="11" Opacity="0.5"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ValueLabel}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Button Classes="pill"
                    Command="{Binding OpenStatisticsPageCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0"
                    Padding="16,8">
                <TextBlock Text="View All Stats  →" FontSize="13"/>
            </Button>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
    </Grid>
    </Grid>
</UserControl>
