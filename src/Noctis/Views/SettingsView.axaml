<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:plugins="using:Noctis.Services.Plugins"
             xmlns:server="using:Noctis.Services.Server"
             xmlns:studio="using:Noctis.Services.LyricsStudio"
             xmlns:vm="using:Noctis.ViewModels"
             xmlns:models="using:Noctis.Models"
             xmlns:sys="using:System"
             xmlns:conv="using:Noctis.Converters"
             xmlns:controls="using:Noctis.Controls"
             xmlns:helpers="using:Noctis.Helpers"
             x:Class="Noctis.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource AppMainBackground}">

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometry" />
            <!-- Account card glyphs Icons.axaml has no shape for (24-grid). -->
            <StreamGeometry x:Key="AccountEyeIcon">M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z</StreamGeometry>
            <StreamGeometry x:Key="AccountEyeOffIcon">M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z</StreamGeometry>
            <StreamGeometry x:Key="AccountKeyIcon">M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z</StreamGeometry>
            <StreamGeometry x:Key="AccountLockIcon">M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z</StreamGeometry>
            <StreamGeometry x:Key="AccountPhoneIcon">M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z</StreamGeometry>
            <!-- Official plugins' verified mark (24x24): an 8-scallop seal and a round-capped check,
                 generated as a 384-point outline so it stays smooth at any size. -->
            <StreamGeometry x:Key="VerifiedSealGeometry">M12.000,1.000 L12.180,1.002 L12.360,1.008 L12.539,1.020 L12.718,1.040 L12.896,1.071 L13.072,1.116 L13.245,1.174 L13.415,1.249 L13.581,1.340 L13.742,1.448 L13.898,1.572 L14.047,1.709 L14.190,1.859 L14.327,2.019 L14.459,2.184 L14.585,2.352 L14.708,2.519 L14.827,2.680 L14.946,2.832 L15.064,2.972 L15.185,3.097 L15.310,3.205 L15.441,3.293 L15.578,3.362 L15.724,3.410 L15.878,3.440 L16.043,3.452 L16.217,3.450 L16.400,3.435 L16.591,3.411 L16.790,3.381 L16.994,3.350 L17.202,3.321 L17.412,3.297 L17.622,3.281 L17.829,3.276 L18.032,3.284 L18.229,3.307 L18.419,3.344 L18.601,3.397 L18.774,3.465 L18.938,3.546 L19.094,3.639 L19.242,3.742 L19.383,3.854 L19.518,3.973 L19.650,4.096 L19.778,4.222 L19.904,4.350 L20.027,4.482 L20.146,4.617 L20.258,4.758 L20.361,4.906 L20.454,5.062 L20.535,5.226 L20.603,5.399 L20.656,5.581 L20.693,5.771 L20.716,5.968 L20.724,6.171 L20.719,6.378 L20.703,6.588 L20.679,6.798 L20.650,7.006 L20.619,7.210 L20.589,7.409 L20.565,7.600 L20.550,7.783 L20.548,7.957 L20.560,8.122 L20.590,8.276 L20.638,8.422 L20.707,8.559 L20.795,8.690 L20.903,8.815 L21.028,8.936 L21.168,9.054 L21.320,9.173 L21.481,9.292 L21.648,9.415 L21.816,9.541 L21.981,9.673 L22.141,9.810 L22.291,9.953 L22.428,10.102 L22.552,10.258 L22.660,10.419 L22.751,10.585 L22.826,10.755 L22.884,10.928 L22.929,11.104 L22.960,11.282 L22.980,11.461 L22.992,11.640 L22.998,11.820 L23.000,12.000 L22.998,12.180 L22.992,12.360 L22.980,12.539 L22.960,12.718 L22.929,12.896 L22.884,13.072 L22.826,13.245 L22.751,13.415 L22.660,13.581 L22.552,13.742 L22.428,13.898 L22.291,14.047 L22.141,14.190 L21.981,14.327 L21.816,14.459 L21.648,14.585 L21.481,14.708 L21.320,14.827 L21.168,14.946 L21.028,15.064 L20.903,15.185 L20.795,15.310 L20.707,15.441 L20.638,15.578 L20.590,15.724 L20.560,15.878 L20.548,16.043 L20.550,16.217 L20.565,16.400 L20.589,16.591 L20.619,16.790 L20.650,16.994 L20.679,17.202 L20.703,17.412 L20.719,17.622 L20.724,17.829 L20.716,18.032 L20.693,18.229 L20.656,18.419 L20.603,18.601 L20.535,18.774 L20.454,18.938 L20.361,19.094 L20.258,19.242 L20.146,19.383 L20.027,19.518 L19.904,19.650 L19.778,19.778 L19.650,19.904 L19.518,20.027 L19.383,20.146 L19.242,20.258 L19.094,20.361 L18.938,20.454 L18.774,20.535 L18.601,20.603 L18.419,20.656 L18.229,20.693 L18.032,20.716 L17.829,20.724 L17.622,20.719 L17.412,20.703 L17.202,20.679 L16.994,20.650 L16.790,20.619 L16.591,20.589 L16.400,20.565 L16.217,20.550 L16.043,20.548 L15.878,20.560 L15.724,20.590 L15.578,20.638 L15.441,20.707 L15.310,20.795 L15.185,20.903 L15.064,21.028 L14.946,21.168 L14.827,21.320 L14.708,21.481 L14.585,21.648 L14.459,21.816 L14.327,21.981 L14.190,22.141 L14.047,22.291 L13.898,22.428 L13.742,22.552 L13.581,22.660 L13.415,22.751 L13.245,22.826 L13.072,22.884 L12.896,22.929 L12.718,22.960 L12.539,22.980 L12.360,22.992 L12.180,22.998 L12.000,23.000 L11.820,22.998 L11.640,22.992 L11.461,22.980 L11.282,22.960 L11.104,22.929 L10.928,22.884 L10.755,22.826 L10.585,22.751 L10.419,22.660 L10.258,22.552 L10.102,22.428 L9.953,22.291 L9.810,22.141 L9.673,21.981 L9.541,21.816 L9.415,21.648 L9.292,21.481 L9.173,21.320 L9.054,21.168 L8.936,21.028 L8.815,20.903 L8.690,20.795 L8.559,20.707 L8.422,20.638 L8.276,20.590 L8.122,20.560 L7.957,20.548 L7.783,20.550 L7.600,20.565 L7.409,20.589 L7.210,20.619 L7.006,20.650 L6.798,20.679 L6.588,20.703 L6.378,20.719 L6.171,20.724 L5.968,20.716 L5.771,20.693 L5.581,20.656 L5.399,20.603 L5.226,20.535 L5.062,20.454 L4.906,20.361 L4.758,20.258 L4.617,20.146 L4.482,20.027 L4.350,19.904 L4.222,19.778 L4.096,19.650 L3.973,19.518 L3.854,19.383 L3.742,19.242 L3.639,19.094 L3.546,18.938 L3.465,18.774 L3.397,18.601 L3.344,18.419 L3.307,18.229 L3.284,18.032 L3.276,17.829 L3.281,17.622 L3.297,17.412 L3.321,17.202 L3.350,16.994 L3.381,16.790 L3.411,16.591 L3.435,16.400 L3.450,16.217 L3.452,16.043 L3.440,15.878 L3.410,15.724 L3.362,15.578 L3.293,15.441 L3.205,15.310 L3.097,15.185 L2.972,15.064 L2.832,14.946 L2.680,14.827 L2.519,14.708 L2.352,14.585 L2.184,14.459 L2.019,14.327 L1.859,14.190 L1.709,14.047 L1.572,13.898 L1.448,13.742 L1.340,13.581 L1.249,13.415 L1.174,13.245 L1.116,13.072 L1.071,12.896 L1.040,12.718 L1.020,12.539 L1.008,12.360 L1.002,12.180 L1.000,12.000 L1.002,11.820 L1.008,11.640 L1.020,11.461 L1.040,11.282 L1.071,11.104 L1.116,10.928 L1.174,10.755 L1.249,10.585 L1.340,10.419 L1.448,10.258 L1.572,10.102 L1.709,9.953 L1.859,9.810 L2.019,9.673 L2.184,9.541 L2.352,9.415 L2.519,9.292 L2.680,9.173 L2.832,9.054 L2.972,8.936 L3.097,8.815 L3.205,8.690 L3.293,8.559 L3.362,8.422 L3.410,8.276 L3.440,8.122 L3.452,7.957 L3.450,7.783 L3.435,7.600 L3.411,7.409 L3.381,7.210 L3.350,7.006 L3.321,6.798 L3.297,6.588 L3.281,6.378 L3.276,6.171 L3.284,5.968 L3.307,5.771 L3.344,5.581 L3.397,5.399 L3.465,5.226 L3.546,5.062 L3.639,4.906 L3.742,4.758 L3.854,4.617 L3.973,4.482 L4.096,4.350 L4.222,4.222 L4.350,4.096 L4.482,3.973 L4.617,3.854 L4.758,3.742 L4.906,3.639 L5.062,3.546 L5.226,3.465 L5.399,3.397 L5.581,3.344 L5.771,3.307 L5.968,3.284 L6.171,3.276 L6.378,3.281 L6.588,3.297 L6.798,3.321 L7.006,3.350 L7.210,3.381 L7.409,3.411 L7.600,3.435 L7.783,3.450 L7.957,3.452 L8.122,3.440 L8.276,3.410 L8.422,3.362 L8.559,3.293 L8.690,3.205 L8.815,3.097 L8.936,2.972 L9.054,2.832 L9.173,2.680 L9.292,2.519 L9.415,2.352 L9.541,2.184 L9.673,2.019 L9.810,1.859 L9.953,1.709 L10.102,1.572 L10.258,1.448 L10.419,1.340 L10.585,1.249 L10.755,1.174 L10.928,1.116 L11.104,1.071 L11.282,1.040 L11.461,1.020 L11.640,1.008 L11.820,1.002 Z</StreamGeometry>
            <StreamGeometry x:Key="VerifiedCheckGeometry">M7.55,12.35 L10.55,15.30 L16.45,9.15</StreamGeometry>
            <!-- One setting a plugin declares in plugin.json, as a row of the plugin page's card (owner
                 10-29: the app's own controls). Label and one short grey line on the left (the whole
                 description in its tooltip), the control on the right: the Settings switch, the pill
                 list, a number with a range as the Settings slider and its value, a number without one
                 as a pill stepper. A text setting takes the full row width under its label. -->
            <DataTemplate x:Key="PluginSettingRowTemplate" x:DataType="plugins:PluginSettingItem">
                <Border Classes="plugin-row plugin-setting-row">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Classes="plugin-row-label" Text="{Binding Label}" TextWrapping="Wrap"/>
                            <TextBlock Classes="plugin-row-hint plugin-setting-hint" Text="{Binding Description}"
                                       MaxLines="1" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Description}" IsVisible="{Binding HasDescription}"/>
                        </StackPanel>
                        <Panel Classes="plugin-setting-control" VerticalAlignment="Center">
                            <controls:LottieToggle IsVisible="{Binding IsBool}"
                                                  AutomationProperties.Name="{Binding Label}"
                                                  AutomationProperties.HelpText="{Binding Description}"
                                                  IsChecked="{Binding BoolValue, Mode=TwoWay}"/>
                            <ComboBox IsVisible="{Binding IsChoice}" Classes="pill-list"
                                      AutomationProperties.Name="{Binding Label}"
                                      AutomationProperties.HelpText="{Binding Description}"
                                      ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                      MinWidth="160" MaxWidth="300" CornerRadius="999" Padding="14,6">
                                <!-- A choice longer than the pill trims, the whole of it in the tooltip. -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="sys:String">
                                        <TextBlock Classes="plugin-choice-text" Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <!-- The Settings slider itself (Lyrics > Minimum line opacity, owner 10-29: the same
                                 control, not a lookalike): a SmoothSlider.accent-slider in a 200 column, 16 in,
                                 the value beside it, and a double-click puts the default back. -->
                            <Grid Classes="plugin-number-slider" ColumnDefinitions="200,Auto" IsVisible="{Binding UsesSlider}">
                                <controls:SmoothSlider Grid.Column="0" Classes="accent-slider" VerticalAlignment="Center" Margin="16,0,0,0"
                                                       AutomationProperties.Name="{Binding Label}"
                                                       AutomationProperties.HelpText="{Binding Description}"
                                                       Maximum="{Binding SliderMaximum}" Minimum="{Binding SliderMinimum}"
                                                       Step="{Binding NumberStep}"
                                                       SteppedValue="{Binding SliderValue, Mode=TwoWay}"
                                                       DoubleTapped="OnPluginSliderDoubleTapped"/>
                                <TextBlock Grid.Column="1" Classes="plugin-number-value" Text="{Binding NumberText}" FontSize="12" Opacity="0.7"
                                           VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="36" TextAlignment="Right"/>
                            </Grid>
                            <!-- No full range: minus, the value, plus, in one rounded capsule. -->
                            <Border Classes="plugin-stepper" IsVisible="{Binding UsesStepper}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Classes="plugin-step" Command="{Binding DecreaseCommand}"
                                            AutomationProperties.Name="{Binding DecreaseName}" ToolTip.Tip="{Binding DecreaseName}">
                                        <TextBlock Text="−" FontSize="16"/>
                                    </Button>
                                    <TextBlock Classes="plugin-number-value" Text="{Binding NumberText}" FontSize="13" FontWeight="SemiBold"
                                               MinWidth="44" TextAlignment="Center" VerticalAlignment="Center" Margin="2,0"/>
                                    <Button Classes="plugin-step" Command="{Binding IncreaseCommand}"
                                            AutomationProperties.Name="{Binding IncreaseName}" ToolTip.Tip="{Binding IncreaseName}">
                                        <TextBlock Text="+" FontSize="16"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Panel>
                        <TextBox Grid.Row="1" Grid.ColumnSpan="2" Classes="plugin-setting-text" IsVisible="{Binding IsString}"
                                 Text="{Binding TextValue, Mode=TwoWay}" Watermark="{Binding Placeholder}"
                                 AutomationProperties.Name="{Binding Label}"
                                 AutomationProperties.HelpText="{Binding Description}"
                                 Margin="0,10,0,0" CornerRadius="999" Padding="14,6" BorderThickness="1.5" MinHeight="0"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- Page motion for the Plugins grid and a plugin's page: a quick start that settles
                 softly (CubicBezierEase: SplineEasing is broken here, see its remarks). -->
            <helpers:CubicBezierEase x:Key="PluginPageEase">
                <x:Arguments>
                    <x:Double>0.2</x:Double>
                    <x:Double>0.9</x:Double>
                    <x:Double>0.3</x:Double>
                    <x:Double>1</x:Double>
                </x:Arguments>
            </helpers:CubicBezierEase>

            <!-- One plugin on the Plugins grid: its icon (or letter tile), its name with the verified
                 mark for official plugins, "by <author>" and two lines of description. The whole
                 card is a button: click, or Tab to it and press Enter, to open its page. -->
            <DataTemplate x:Key="PluginCardTemplate" x:DataType="vm:PluginCardItem">
                <Button Classes="plugin-card"
                        Classes.official="{Binding IsOfficial}"
                        Classes.restricted="{Binding IsRestricted}"
                        Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).OpenPluginCardCommand}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding AccessibleName}"
                        AutomationProperties.HelpText="{Binding Description}">
                    <Button.Template>
                        <ControlTemplate>
                            <Border x:Name="card" CornerRadius="20" ClipToBounds="True">
                                <Panel>
                                    <Border x:DataType="vm:PluginCardItem" Background="{Binding TintBrush}" IsHitTestVisible="False"/>
                                    <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                                      Padding="16,18,16,18" HorizontalContentAlignment="Stretch"/>
                                </Panel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Panel>
                        <StackPanel Classes="plugin-card-body">
                            <Panel Width="60" Height="60" HorizontalAlignment="Center" Margin="0,4,0,12">
                                <Border CornerRadius="16" Background="{Binding MonogramBrush}" IsVisible="{Binding ShowMonogram}">
                                    <TextBlock Text="{Binding Monogram}" FontSize="22" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Width="60" Height="60"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                            </Panel>
                            <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Center">
                                <TextBlock Classes="plugin-card-name" Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Viewbox Grid.Column="1" Classes="verified-mark" Width="15" Height="15" Margin="5,0,0,0" VerticalAlignment="Center"
                                         IsVisible="{Binding IsOfficial}" ToolTip.Tip="{loc:T Plugins.Card.Verified}"
                                         AutomationProperties.Name="{loc:T Plugins.Card.Verified}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource VerifiedSealGeometry}" Fill="#1D9BF0"/>
                                        <Path Data="{StaticResource VerifiedCheckGeometry}" Stroke="White" StrokeThickness="2.2"
                                              StrokeLineCap="Round" StrokeJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                            <TextBlock Classes="plugin-card-by" Text="{Binding ByLine}" FontSize="11.5" Opacity="0.5" Margin="0,2,0,0"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Classes="plugin-card-description" Text="{Binding Description}" FontSize="12" Opacity="0.68" Margin="0,8,0,0"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                       LineHeight="17" Height="34" IsVisible="{Binding HasDescription}"/>
                        </StackPanel>
                        <Border Classes="plugin-chip" Classes.accent="{Binding ChipIsAccent}" IsVisible="{Binding HasChip}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-4,0">
                            <TextBlock Text="{Binding ChipText}" FontSize="10.5" FontWeight="SemiBold"/>
                        </Border>
                    </Panel>
                </Button>
            </DataTemplate>

            <!-- A plugin's own page (owner 10-29: reads top to bottom in one glance). Back; the header
                 (big icon, name and mark, "by X · v1.2.1", the description at a readable width, Update /
                 Open X under it, and top-right Install while not installed or a "..." menu with the
                 homepage and the folder once it is); quiet notes; one card of rows (Enabled, the
                 plugin's settings, a one-line permissions row that opens to the full list); Remove
                 plugin on its own at the bottom. -->
            <DataTemplate x:Key="PluginPageTemplate" x:DataType="vm:PluginCardItem">
                <StackPanel Spacing="14">
                    <Button x:Name="PluginBackButton" Classes="pill-action plugin-back" HorizontalAlignment="Left"
                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).ClosePluginDetailCommand}"
                            AutomationProperties.Name="{loc:T Plugins.Detail.Back}"
                            Height="32" Padding="8,0,14,0" VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource ChevronLeftIcon}" Width="16" Height="16"/>
                            <TextBlock Text="{loc:T Plugins.Detail.Back}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Grid x:Name="PluginHero" ColumnDefinitions="Auto,*,Auto" Margin="4,0,0,2">
                        <Panel Width="84" Height="84" VerticalAlignment="Top">
                            <Border CornerRadius="22" Background="{Binding MonogramBrush}" IsVisible="{Binding ShowMonogram}">
                                <TextBlock Text="{Binding Monogram}" FontSize="30" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Width="84" Height="84"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        </Panel>
                        <StackPanel Grid.Column="1" Margin="18,4,12,0" Spacing="3" VerticalAlignment="Top">
                            <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                                <TextBlock x:Name="PluginPageName" Text="{Binding Name}" FontSize="22" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center"/>
                                <Viewbox Grid.Column="1" Classes="verified-mark" Width="20" Height="20" Margin="7,1,0,0" VerticalAlignment="Center"
                                         IsVisible="{Binding IsOfficial}" ToolTip.Tip="{loc:T Plugins.Card.Verified}"
                                         AutomationProperties.Name="{loc:T Plugins.Card.Verified}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource VerifiedSealGeometry}" Fill="#1D9BF0"/>
                                        <Path Data="{StaticResource VerifiedCheckGeometry}" Stroke="White" StrokeThickness="2.2"
                                              StrokeLineCap="Round" StrokeJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                            <TextBlock x:Name="PluginPageMeta" Text="{Binding MetaLine}" FontSize="12.5" Opacity="0.6"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MetaLine}"/>
                            <TextBlock x:Name="PluginPageDescription" Text="{Binding Description}" FontSize="13" Opacity="0.78"
                                       TextWrapping="Wrap" LineHeight="19" MaxWidth="560" HorizontalAlignment="Left" Margin="0,6,0,0"
                                       IsVisible="{Binding HasDescription}"/>
                            <!-- An installed plugin's Update (or Cancel) from the list. Install, and the plugin's
                                 own views ("Open Album Town"), sit top-right beside "..." instead. -->
                            <WrapPanel x:Name="PluginPageActions" Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" Margin="0,12,0,0"
                                       IsVisible="{Binding HasHeaderActions}">
                                <Button x:Name="PluginPageUpdateButton"
                                        Classes.accent-pill="{Binding Listing.IsPrimary, FallbackValue=False}"
                                        Classes.pill-action="{Binding !Listing.IsPrimary, FallbackValue=True}"
                                        Height="34" Padding="18,0" CornerRadius="999" Cursor="Hand" VerticalContentAlignment="Center"
                                        MaxWidth="260"
                                        IsVisible="{Binding ShowInlineButton}"
                                        IsEnabled="{Binding Listing.CanClick, FallbackValue=False}"
                                        AutomationProperties.Name="{Binding Listing.ButtonText, FallbackValue={x:Null}}"
                                        Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).OfficialPluginActionCommand}"
                                        CommandParameter="{Binding Listing}">
                                    <TextBlock Text="{Binding Listing.ButtonText, FallbackValue={x:Null}}" FontSize="12.5" FontWeight="SemiBold"
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                </Button>
                            </WrapPanel>
                            <TextBlock Text="{Binding Listing.Error, FallbackValue={x:Null}}" FontSize="12" Foreground="#FF6B6B" TextWrapping="Wrap"
                                       Margin="0,6,0,0" IsVisible="{Binding Listing.HasError, FallbackValue=False}"/>
                            <ProgressBar Value="{Binding Listing.Progress, FallbackValue=0}" Minimum="0" Maximum="1" Height="3" CornerRadius="2"
                                         MaxWidth="260" HorizontalAlignment="Left" Width="260" Margin="0,8,0,0"
                                         IsVisible="{Binding Listing.IsBusy, FallbackValue=False}"/>
                            <TextBlock Text="{Binding Listing.ProgressDetail, FallbackValue={x:Null}}" FontSize="11" Opacity="0.6"
                                       Margin="0,4,0,0" IsVisible="{Binding Listing.HasProgressDetail, FallbackValue=False}"/>
                        </StackPanel>
                        <!-- Top-right (owner 10-29): Install / Replace / Cancel while the plugin is not
                             installed; once it is, the plugin's own views ("Open Album Town") and "..." with
                             Visit homepage and Open folder (SettingsView.axaml.cs OnPluginMoreClick). -->
                        <StackPanel x:Name="PluginPageCorner" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Top" Margin="0,4,0,0">
                            <ItemsControl x:Name="PluginPageViews" VerticalAlignment="Center" ItemsSource="{Binding Installed.Views, FallbackValue={x:Null}}"
                                          IsVisible="{Binding Installed.HasViews, FallbackValue=False}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="plugins:PluginViewEntry">
                                        <Button Classes="accent-pill" Height="34" Padding="18,0" CornerRadius="999" Cursor="Hand"
                                                VerticalContentAlignment="Center"
                                                AutomationProperties.Name="{Binding OpenText}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).OpenPluginViewCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding OpenText}" FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="PluginPageInstallButton"
                                    Classes.accent-pill="{Binding Listing.IsPrimary, FallbackValue=False}"
                                    Classes.pill-action="{Binding !Listing.IsPrimary, FallbackValue=True}"
                                    Height="34" Padding="18,0" CornerRadius="999" Cursor="Hand" VerticalContentAlignment="Center"
                                    MaxWidth="200" HorizontalAlignment="Right"
                                    IsVisible="{Binding ShowCornerButton}"
                                    IsEnabled="{Binding Listing.CanClick, FallbackValue=False}"
                                    AutomationProperties.Name="{Binding Listing.ButtonText, FallbackValue={x:Null}}"
                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).OfficialPluginActionCommand}"
                                    CommandParameter="{Binding Listing}">
                                <TextBlock Text="{Binding Listing.ButtonText, FallbackValue={x:Null}}" FontSize="12.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Listing.ButtonText, FallbackValue={x:Null}}"/>
                            </Button>
                            <Button x:Name="PluginPageMoreButton" Classes="icon-chip" HorizontalAlignment="Right"
                                    IsVisible="{Binding HasMoreMenu}"
                                    AutomationProperties.Name="{loc:T Plugins.Detail.More}" ToolTip.Tip="{loc:T Plugins.Detail.More}"
                                    Click="OnPluginMoreClick">
                                <PathIcon Data="{StaticResource MoreDotsIcon}" Width="15" Height="15"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Notes and problems, as quiet lines (only when there is something to say). -->
                    <StackPanel x:Name="PluginPageNotes" Spacing="6" Margin="4,0" IsVisible="{Binding IsInstalled}">
                        <TextBlock Text="{loc:T Plugins.LegacyNote}" FontSize="11.5" Opacity="0.55" TextWrapping="Wrap"
                                   IsVisible="{Binding Installed.IsLegacy, FallbackValue=False}"/>
                        <TextBlock Text="{loc:T Plugins.ContentNote}" FontSize="11.5" Opacity="0.55" TextWrapping="Wrap"
                                   IsVisible="{Binding Installed.IsContentPack, FallbackValue=False}"/>
                        <TextBlock Text="{Binding Installed.Error, FallbackValue={x:Null}}" FontSize="12" Foreground="#FF6B6B" TextWrapping="Wrap"
                                   IsVisible="{Binding Installed.HasError, FallbackValue=False}"/>
                        <TextBlock Text="{Binding Installed.Warnings, FallbackValue={x:Null}}" FontSize="11.5" Opacity="0.45" TextWrapping="Wrap"
                                   IsVisible="{Binding Installed.HasWarnings, FallbackValue=False}"/>
                    </StackPanel>

                    <!-- One card of rows: Enabled, the plugin's settings, its permissions. -->
                    <Border x:Name="PluginPageGroup" Classes="plugin-panel plugin-group" IsVisible="{Binding IsInstalled}">
                        <StackPanel>
                            <Border x:Name="PluginPageSwitchPanel" Classes="plugin-row first">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Classes="plugin-row-label" Text="{loc:T Plugins.Detail.Enabled}"/>
                                        <TextBlock Classes="plugin-row-hint" Text="{Binding EnableLine}" TextWrapping="Wrap"
                                                   IsVisible="{Binding HasEnableLine}"/>
                                    </StackPanel>
                                    <ContentControl Grid.Column="1" Content="{Binding Installed}" VerticalAlignment="Center">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate x:DataType="plugins:LoadedPlugin">
                                                <controls:LottieToggle x:Name="PluginPageToggle" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                      AutomationProperties.Name="{Binding Name}"
                                                                      IsEnabled="{Binding CanToggle}"/>
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                </Grid>
                            </Border>
                            <!-- A plugin that adds a screen: its sidebar entry (Discord feedback 11-03). -->
                            <Border x:Name="PluginPageSidebarRow" Classes="plugin-row"
                                    IsVisible="{Binding Installed.HasViews, FallbackValue=False}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="plugin-row-label" Text="{loc:T Plugins.Detail.ShowInSidebar}" Margin="0,0,16,0"
                                               VerticalAlignment="Center"/>
                                    <ContentControl Grid.Column="1" Content="{Binding Installed}" VerticalAlignment="Center">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate x:DataType="plugins:LoadedPlugin">
                                                <controls:LottieToggle x:Name="PluginPageSidebarToggle" IsChecked="{Binding ShowInSidebar, Mode=TwoWay}"
                                                                      AutomationProperties.Name="{loc:T Plugins.Detail.ShowInSidebar}"/>
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                </Grid>
                            </Border>
                            <ItemsControl x:Name="PluginPageSettings" ItemsSource="{Binding Installed.SettingItems, FallbackValue={x:Null}}"
                                          IsVisible="{Binding Installed.HasSettings, FallbackValue=False}"
                                          IsEnabled="{Binding !IsRestricted}"
                                          ItemTemplate="{StaticResource PluginSettingRowTemplate}"/>
                            <!-- Permissions: one quiet line ("Can read your library, control playback");
                                 click it for the full sentences. Code plugins only. -->
                            <Border x:Name="PluginPagePermissionsRow" Classes="plugin-row"
                                    IsVisible="{Binding Installed.IsCodePlugin, FallbackValue=False}">
                                <StackPanel>
                                    <Button x:Name="PluginPagePermissions" Classes="plugin-row-button"
                                            Command="{Binding TogglePermissionsCommand}"
                                            AutomationProperties.Name="{loc:T Plugins.Permissions}"
                                            AutomationProperties.HelpText="{Binding Installed.PermissionSummary, FallbackValue={x:Null}}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2" Margin="0,0,16,0">
                                                <TextBlock Classes="plugin-row-label" Text="{loc:T Plugins.Permissions}"/>
                                                <TextBlock Classes="plugin-row-hint" Text="{Binding Installed.PermissionSummary, FallbackValue={x:Null}}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <PathIcon Grid.Column="1" Classes="plugin-perm-chevron"
                                                      Classes.open="{Binding IsPermissionsExpanded}"
                                                      Data="{StaticResource ChevronDownThinIcon}" Width="12" Height="12" Opacity="0.5"
                                                      VerticalAlignment="Center"
                                                      IsVisible="{Binding Installed.HasPermissions, FallbackValue=False}"/>
                                        </Grid>
                                    </Button>
                                    <controls:CollapsibleContent IsOpen="{Binding IsPermissionsExpanded}" Lift="6">
                                        <ItemsControl x:Name="PluginPagePermissionList" ItemsSource="{Binding Installed.PermissionDetails, FallbackValue={x:Null}}"
                                                      Margin="0,10,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="6"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="sys:String">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <Ellipse Width="4" Height="4" Margin="2,7,10,0" VerticalAlignment="Top"
                                                                 Fill="{DynamicResource AccentColorBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </controls:CollapsibleContent>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Uninstall plugin: one red row of its own (asks first, data kept unless chosen).
                         Every installed plugin, official and community (Discord feedback 11-03). -->
                    <Panel x:Name="PluginPageRemoveHost">
                        <Border x:Name="PluginPageRemovePanel" Classes="plugin-panel plugin-group" IsVisible="{Binding IsInstalled}">
                            <Button x:Name="PluginPageRemoveButton" Classes="plugin-row-button plugin-danger-row"
                                    AutomationProperties.Name="{loc:T Plugins.Detail.RemoveRow}"
                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemovePluginCommand}"
                                    CommandParameter="{Binding Installed}">
                                <TextBlock Text="{loc:T Plugins.Detail.RemoveRow}" FontSize="14"/>
                            </Button>
                        </Border>
                    </Panel>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
        <!-- Last synced: two arrows round a circle, drawn on a 14px box to be stroked (1.4) at
             that size, so it stays crisp where the 24-grid SyncIcon fill went soft at 11px. -->
        <StreamGeometry x:Key="SyncStatusGlyph">M2.5,7 A4.5,4.5 0 0 1 10.45,4.11 M10.67,1.62 L10.45,4.11 L7.96,3.89 M11.5,7 A4.5,4.5 0 0 1 3.55,9.89 M3.33,12.38 L3.55,9.89 L6.04,10.11</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- The page scrollbar sits at the card's right edge, and the card clips its
             children to a 21px rounded rect (MainWindow SettingsCard). At the top the
             header row keeps the bar clear of the corner; at the bottom nothing did, so
             the last ~20px of track and thumb were cut off by the curve. Inset the bar
             by the corner radius; the content itself still scrolls to the card edge. -->
        <Style Selector="ScrollViewer#SettingsScrollViewer /template/ ScrollBar:vertical">
            <Setter Property="Margin" Value="2,0,0,21"/>
        </Style>

        <!-- Section header style -->
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- A setting row gated by another toggle: dim it while disabled so it
             visibly reads as not-yet-available (e.g. "Start minimized to tray"
             before "Open Noctis when computer starts" is on). -->
        <Style Selector="Grid.dependent-setting:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- Hover shade for EVERY clickable button in Settings (user ask 09-08): the same
             "darken in place" the accent Modify button does. Grey and transparent buttons
             take a translucent black wash (SettingsButtonHoverBrush, per theme); accent /
             danger buttons darken to AccentColorBrushDark1 in their own rules below. This
             rule is declared first on purpose: Avalonia styles cascade by order, so every
             class-specific :pointerover rule after it (rail, brand tiles, social links,
             swatch, avatar, preset chips) keeps its own look. Toggles are not Buttons. -->
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SettingsButtonHoverBrush}"/>
        </Style>
        <!-- accent-pill (e.g. Plugins "Install from file"): the wash above beat the global
             Styles.axaml accent hover, turning the pill grey. Stay accent, just deeper. -->
        <Style Selector="Button.accent-pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrushDark1}"/>
        </Style>

        <!-- About-tab update pill: accent by default, subdued while showing the
             transient "✓ Up to date" confirmation so it stops reading as a CTA. -->
        <Style Selector="Button.update-pill">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="Button.update-pill.up-to-date, Button.update-pill.checking">
            <Setter Property="Background" Value="#26FFFFFF"/>
        </Style>
        <!-- No brush/scale transitions on this pill: its state flips twice per click
             (Update -> Checking -> Up to date) and each cross-fade read as a flicker. -->
        <Style Selector="Button.update-pill, Button.update-pill:pointerover, Button.update-pill:pressed">
            <Setter Property="Transitions">
                <Transitions/>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.update-pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrushDark1}"/>
        </Style>
        <Style Selector="Button.update-pill.up-to-date:pointerover /template/ ContentPresenter, Button.update-pill.checking:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SettingsButtonHoverBrush}"/>
        </Style>
        <!-- About-tab red update pills (hard-coded #E74856, not the accent): darken like Modify. -->
        <Style Selector="Button.red-pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C73E4C"/>
        </Style>
        <!-- About update states: whatever appears (pill, label, status line) eases in instead of
             popping. Opacity only, keyed on [IsVisible=True] like the spinner, so each state change
             plays it once and the pill's own hover scale/brush stay untouched. -->
        <Style Selector=":is(Control).update-fade[IsVisible=True]">
            <Style.Animations>
                <Animation Duration="0:0:0.22" FillMode="Backward">
                    <Animation.Easing><CubicEaseOut/></Animation.Easing>
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Download pill: same size and shape as the update pill; the accent fill glides under the label. -->
        <Style Selector="Border.update-download-pill">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Width" Value="152"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style Selector="TextBlock.update-status-text">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="TextBlock.update-status-text.error">
            <Setter Property="Foreground" Value="#FF6B78"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Circular loading spinner: a rotating arc shown during background work -->
        <Style Selector="Ellipse.loading-spinner">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stroke" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeDashArray" Value="11,5"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        </Style>
        <!-- Animation keyed on [IsVisible=True] (same pattern as LyricsView's search
             dots): selector matching ignores visibility, so an ungated INFINITE
             clock would keep ticking on every hidden spinner. -->
        <Style Selector="Ellipse.loading-spinner[IsVisible=True]">
            <Style.Animations>
                <Animation Duration="0:0:0.85" IterationCount="INFINITE" Easing="LinearEasing">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Music Server card: tiny caps field labels, a status dot that follows the
             connection state, and red status text on failures. -->
        <Style Selector="TextBlock.server-field-label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Ellipse.server-status-dot">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Fill" Value="#8B949E"/>
        </Style>
        <Style Selector="Ellipse.server-status-dot.connected">
            <Setter Property="Fill" Value="#3FB950"/>
        </Style>
        <Style Selector="Ellipse.server-status-dot.error">
            <Setter Property="Fill" Value="#E5534B"/>
        </Style>
        <Style Selector="TextBlock.server-status">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="TextBlock.server-status.error">
            <Setter Property="Foreground" Value="#E5534B"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        <!-- Server type picker: the visible box (fill + focus ring) is drawn by a plain wrapper
             Border (server-pill-shell) carrying exactly the metadata-info-field recipe, and the
             ComboBox's own Fluent chrome is fully disarmed in every state. Pinning the
             stroke on the template's Border#Background was tried twice and never rendered
             the same as the TextBox's PART_BorderElement (same declared 1.5px/brush,
             different layering/snapping) — so all four boxes now share one drawing
             mechanism. Contract pinned by MediaServerOutlineParityTests. -->
        <Style Selector="Border.server-pill-shell">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <!-- Same filled pill as every other Settings pill box (owner 10-08: the metadata
                 editor's look): transparent ring at rest, the soft field fill. -->
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="{DynamicResource PillFieldBackground}"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <Style Selector="Border.server-pill-shell:pointerover">
            <Setter Property="Background" Value="{DynamicResource PillFieldBackgroundPointerOver}"/>
        </Style>
        <!-- Focus parity: the field boxes turn accent on :focus, the shell follows suit. -->
        <Style Selector="Border.server-pill-shell:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PillFieldBackgroundFocused}"/>
        </Style>
        <Style Selector="ComboBox.server-pill">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill /template/ Border#Background">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill /template/ Border#HighlightBackground">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ComboBox.server-pill:pointerover /template/ Border#Background">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill:pressed /template/ Border#Background">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill:focus /template/ Border#Background">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill:focus-within /template/ Border#Background">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill:dropdownopen /template/ Border#Background">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill:disabled /template/ Border#Background">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Setting card -->
        <!-- Preset chips (crossfade 3s / 6s / 10s): pill toggles, selected = accent. -->
        <Style Selector="Button.preset-chip">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="11,3"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.preset-chip:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.preset-chip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HomeCardHoverBackground}"/>
        </Style>
        <Style Selector="Button.preset-chip.selected">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="Button.preset-chip.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="Button.preset-chip.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="Border.setting-card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="22,16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="Border.setting-card.advanced-first">
            <Setter Property="CornerRadius" Value="24,24,0,0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="Border.setting-card.advanced-middle">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="Border.setting-card.advanced-last">
            <Setter Property="CornerRadius" Value="0,0,24,24"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Selectable card used by the Song Transitions style picker -->
        <Style Selector="RadioButton.transition-card">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="card"
                            Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="18"
                            Padding="18,14">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Cards shade on hover like the Settings buttons; the checked card keeps its
             accent border. -->
        <Style Selector="RadioButton.transition-card:pointerover /template/ Border#card">
            <Setter Property="Background" Value="{DynamicResource SettingsButtonHoverBrush}"/>
        </Style>
        <!-- Every card picker (transition style, upmix, visualizer, mini player design,
             artwork medium, cover flow layout, group-artists): the press dip the theme
             tiles get from the app-wide Button style, and the accent ring fades in
             instead of snapping (user ask 09-08). -->
        <Style Selector="RadioButton.transition-card">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="RadioButton.transition-card:pressed">
            <Setter Property="RenderTransform" Value="scale(0.96)"/>
        </Style>
        <Style Selector="RadioButton.transition-card /template/ Border#card">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="RadioButton.transition-card:checked /template/ Border#card">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
        </Style>
        <Style Selector="RadioButton.transition-card:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <!-- Same card, laid out four-up for the Now Playing Artwork picker: no bottom
             margin (the Grid spaces them) and centred glyph + label. -->
        <Style Selector="RadioButton.medium-card">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="RadioButton.medium-card Canvas.medium-glyph">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>


        <!-- Setting row: label left, control right -->
        <Style Selector="Border.setting-row">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Liquid motion for every button in Settings -->
        <Style Selector="Button">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18">
                        <TransformOperationsTransition.Easing>
                            <CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                    <BrushTransition Property="Background" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- No hover zoom anywhere in Settings (user ask 09-07): buttons highlight in
             place. Overrides the app-wide Button / Button.pill :pointerover scale. -->
        <Style Selector="Button:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.pill:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <!-- Accent buttons lose their zoom, so they darken on hover instead (the global
             accent-btn hover keeps the resting colour). Same shade as Styles.axaml's
             settings-popup rule. -->
        <Style Selector="Button.accent-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrushDark1}"/>
        </Style>
        <!-- The QR thumbnail must not grow on hover: a moving code reads as decoration,
             and phones scan it in place. The press dip stays for click feedback. -->
        <Style Selector="Button.qr-thumb:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.accent-swatch:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.accent-swatch:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <!-- Theme selection button -->
        <Style Selector="Button.theme-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.theme-btn /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- Theme tiles shade on hover like every other Settings button (the active
             tile keeps its accent border; only the fill changes). -->
        <Style Selector="Button.theme-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SettingsButtonHoverBrush}"/>
        </Style>

        <!-- Profile avatar button: round, no rectangular hover overlay -->
        <Style Selector="Button.profile-avatar-btn /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="Button.profile-avatar-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.profile-avatar-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- Profile name TextBox: no chrome on any state -->
        <Style Selector="TextBox.profile-input /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.profile-input:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.profile-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.profile-input:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.theme-btn.active /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
        </Style>

        <!-- Danger button -->
        <Style Selector="Button.danger /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrushDark1}"/>
        </Style>

        <!-- Accent button -->
        <Style Selector="Button.accent /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrushDark1}"/>
        </Style>

        <Style Selector="TextBox.accent-hex-input /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <Style Selector="TextBox.accent-hex-input:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.accent-hex-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.accent-hex-input:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- Pill-shaped action buttons -->
        <!-- Create-account fields: full-width rounded boxes of one height. -->
        <Style Selector="TextBox.account-field">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="16,0,6,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- Account card: icon pills of one height, and round icon buttons (eye, copy). -->
        <Style Selector="Button.account-action">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.account-action /template/ ContentPresenter">
            <Setter Property="Padding" Value="14,0"/>
        </Style>
        <Style Selector="Button.account-action PathIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.account-remove">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.account-remove /template/ ContentPresenter">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.account-icon-btn">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.account-icon-btn PathIcon">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <Style Selector="Button.pill-action">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.pill-action /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>

        <!-- Social links (GitHub / Discord) in the About card: brand-coloured icon,
             brighter label, and a soft brand-tinted pill on hover. -->
        <Style Selector="Button.social-link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.social-link /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="Button.social-discord:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#265865F2"/>
        </Style>
        <Style Selector="Button.social-github:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#26F1C40F"/>
        </Style>

        <!-- About: three equal-width brand tiles (GitHub / Discord / Website). The tile
             is a Button whose chrome is fully transparent; the wash Border underneath
             carries the colour. Hover lifts the wash with a faint white layer, press
             dips opacity (no scale, per the app's press convention). -->
        <Style Selector="Button.brand-tile">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.brand-tile /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.brand-tile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.brand-tile:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.brand-tile:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.brand-tile:pressed">
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Opacity" Value="0.72"/>
        </Style>
        <Style Selector="Button.brand-tile Border.tile-lift">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.brand-tile:pointerover Border.tile-lift">
            <Setter Property="Opacity" Value="0.07"/>
        </Style>

        <!-- Library > Tools: one row per tool, a monochrome line icon in front of the title —
             the same stroked glyph the tool's menu row / dialog header uses (owner 10-09:
             one icon per action everywhere). -->
        <Style Selector="controls|LineIcon.tool-icon">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,16,0"/>
        </Style>

        <!-- Pill ComboBox -->
        <Style Selector="ComboBox.pill-combo">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <Panel>
                            <Border Name="Background"
                                    Background="{DynamicResource PillFieldBackground}"
                                    BorderThickness="0"
                                    CornerRadius="16"
                                    Padding="{TemplateBinding Padding}"
                                    MinWidth="{TemplateBinding MinWidth}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <ContentPresenter Name="PART_ContentPresenter"
                                                      Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    <PathIcon Grid.Column="1"
                                              Data="{StaticResource ChevronDownThinIcon}"
                                              Width="11"
                                              Height="11"
                                              Margin="6,0,6,0"
                                              Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup Name="PART_Popup"
                                   PlacementTarget="{TemplateBinding}"
                                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                   MinWidth="{TemplateBinding MinWidth}"
                                   IsLightDismissEnabled="True"
                                   WindowManagerAddShadowHint="False"
                                   Placement="BottomEdgeAlignedLeft">
                                <Border Background="{DynamicResource ComboBoxDropDownBackground}"
                                        BorderBrush="{DynamicResource ComboBoxDropDownBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="0,4">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter Name="PART_ItemsPresenter"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Panel>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ComboBox.pill-combo:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="ComboBox.pill-combo.stable-popup:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="ComboBox.pill-combo:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource PillFieldBackgroundPointerOver}"/>
        </Style>
        <!-- Selected item highlight. Foreground tracks the accent's contrast colour so the
             label stays readable even when the accent is white (otherwise white-on-white). -->
        <Style Selector="ComboBox.pill-combo ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="ComboBox.pill-combo ComboBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrushDark1}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <!-- Pill-shaped hover/selection highlight in the dropdown list, matching the
             rounded MenuItems in the page options menu. Margin insets each row so the
             highlight floats; CornerRadius on the content presenter clips it to a pill. -->
        <Style Selector="ComboBox.pill-combo ComboBoxItem">
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="ComboBox.pill-combo ComboBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="999"/>
        </Style>

        <!-- Pill dropdown items for plain (default-template) pill combos, e.g. ReplayGain Mode. -->
        <Style Selector="ComboBox.pill-list ComboBoxItem">
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="ComboBox.pill-list ComboBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="999"/>
        </Style>

        <!-- Token field: identical treatment to the metadata editor's text fields. The inner
             PART_BorderElement gets the same CornerRadius so the rounded corners render clean
             (the earlier square-corner artifact came from leaving PART_BorderElement unstyled). -->
        <Style Selector="TextBox.metadata-info-field">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Background" Value="{DynamicResource PillFieldBackground}" />
        </Style>
        <Style Selector="TextBox.metadata-info-field /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource PillFieldBackground}" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
        <Style Selector="TextBox.metadata-info-field:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource PillFieldBackgroundPointerOver}" />
        </Style>
        <Style Selector="TextBox.metadata-info-field:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
            <Setter Property="Background" Value="{DynamicResource PillFieldBackgroundFocused}" />
        </Style>
        <Style Selector="TextBox.metadata-info-field:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
            <Setter Property="Background" Value="{DynamicResource PillFieldBackgroundFocused}" />
        </Style>
        <Style Selector="TextBox.metadata-info-field:disabled /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource PillFieldBackground}" />
        </Style>
        <Style Selector="ComboBox.transition-pill">
            <Setter Property="Width" Value="132"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="ComboBox.transition-pill /template/ Border#Background">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="ComboBox.transition-pill:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </Style>

        <!-- Accent sliders (horizontal) -->
        <Style Selector="Slider.accent-slider">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TickPlacement" Value="None"/>
        </Style>
        <Style Selector="Slider.accent-slider /template/ Track">
            <Setter Property="Height" Value="8"/>
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border/>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Fill and track tuck 1px under the thumb, square there (10-05). They used to run 9px
             under it from both sides; on a dimmed slider (parent off) the see-through thumb showed
             those overlapping ends, so the slider looked broken apart. Exactly edge-to-edge left a
             notch at each join instead (an 8px bar's corners sit 0.94px outside the 18px circle),
             so 1px: the corners land on the circle, and the sliver under it is too thin to show.
             The bar's outer ends start half a thumb in (10-12): at the minimum the fill still
             peeked out left of the thumb as a little red square, and at the maximum the track
             right of it. Starting at the thumb's centre at either end, the bar is always
             under the thumb there, at any display scaling. -->
        <Style Selector="Slider.accent-slider /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Margin" Value="9,0,-1,0"/>
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Margin" Value="-1,0,9,0"/>
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="Opacity" Value="0.95"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Height" Value="8"/>
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton#PART_DecreaseButton /template/ Border">
            <Setter Property="CornerRadius" Value="4,0,0,4"/>
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton#PART_IncreaseButton /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="CornerRadius" Value="0,4,4,0"/>
        </Style>
        <Style Selector="Slider.accent-slider /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <!-- An explicit circle, as accent-vertical's (no theme thumb chrome). -->
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="999"/>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14">
                        <TransformOperationsTransition.Easing>
                            <CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                    <DoubleTransition Property="Width" Duration="0:0:0.12"/>
                    <DoubleTransition Property="Height" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Slider.accent-slider:pointerover /template/ Thumb">
            <Setter Property="Width" Value="19.44"/>
            <Setter Property="Height" Value="19.44"/>
        </Style>

        <!-- Child settings dim when their parent toggle is off (matches the
             grayed ReplayGain Mode row) so the dependency is visible at a glance. -->
        <Style Selector="Grid.sub-setting, StackPanel.sub-setting">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.sub-setting:disabled, StackPanel.sub-setting:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- Pill numeric fields in the parametric EQ rows: the spin buttons are
             hidden so the value is always fully readable; adjust by typing,
             scrolling, or arrow keys. -->
        <Style Selector="NumericUpDown.eq-pill-number">
            <Setter Property="ShowButtonSpinner" Value="False"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="NumericUpDown.eq-pill-number /template/ ButtonSpinner">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown.eq-pill-number /template/ TextBox#PART_TextBox">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- The theme draws TextBox chrome on its inner border element (including
             hover/focus recolors), so the pill background has to be set there for
             every state or the theme's square highlight bleeds through. -->
        <!-- Same filled pill as the other Settings boxes (owner 10-08): field fill, accent
             ring on focus. -->
        <Style Selector="NumericUpDown.eq-pill-number /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="{DynamicResource PillFieldBackground}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style Selector="NumericUpDown.eq-pill-number /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="{DynamicResource PillFieldBackgroundPointerOver}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="NumericUpDown.eq-pill-number /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="{DynamicResource PillFieldBackgroundFocused}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
        </Style>

        <!-- Accent sliders (vertical EQ) -->
        <Style Selector="Slider.accent-vertical">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ Track">
            <Setter Property="Width" Value="8"/>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ RepeatButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border/>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Fill (bottom) and track (top) tuck 1px under the thumb, as accent-slider above. -->
        <Style Selector="Slider.accent-vertical /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Margin" Value="0,-1,0,0"/>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Margin" Value="0,0,0,-1"/>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ RepeatButton /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="Opacity" Value="0.95"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Width" Value="8"/>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ RepeatButton#PART_DecreaseButton /template/ Border">
            <Setter Property="CornerRadius" Value="0,0,4,4"/>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ RepeatButton#PART_IncreaseButton /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="CornerRadius" Value="4,4,0,0"/>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="999"/>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14">
                        <TransformOperationsTransition.Easing>
                            <CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                    <DoubleTransition Property="Width" Duration="0:0:0.12"/>
                    <DoubleTransition Property="Height" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Slider.accent-vertical:pointerover /template/ Thumb">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>

        <!-- Pre-amp pill slider: the real Slider is transparent and only handles hit
             testing; the visible pill track/fill/thumb are drawn on a Canvas and driven
             from code-behind (PillSliderVisualHelper), matching the metadata volume slider. -->
        <Style Selector="Slider.preamp-horizontal">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource IslandSliderFilled}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>

        <!-- Settings rail (left column): section list, profile chip, search. -->
        <Style Selector="Border.settings-rail">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="CornerRadius" Value="21,0,0,0"/>
        </Style>
        <Style Selector="Button.rail-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.rail-item /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="Button.rail-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}"/>
        </Style>
        <Style Selector="Button.rail-item.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <!-- The app-wide Button:pointerover scale(1.045) reads as a jump on a list of
             full-width rows; the rail relies on the background highlight alone. -->
        <Style Selector="Button.rail-item:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.profile-avatar-btn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <!-- About-tab version chip: plain text that copies on click; the app-wide hover
             zoom makes it wobble under the pointer. -->
        <Style Selector="Button.version-copy:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.rail-profile">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.rail-profile /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style Selector="Button.rail-profile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}"/>
        </Style>
        <Style Selector="TextBox.settings-search">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <!-- Settings search hides non-matching cards through a class (see
             SettingsSearchIndex) so cards whose IsVisible is bound keep that binding. -->
        <Style Selector="Border.setting-card.search-hidden">
            <Setter Property="IsVisible" Value="False"/>
            <!-- A card whose IsVisible is bound (platform / Developer Mode gates) keeps
                 that binding over the setter above, so collapse it geometrically too. -->
            <Setter Property="MaxHeight" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <!-- Tab switch: the incoming page fades in with a short upward glide.
             Keyframe animations can't drive RenderTransform (no registered
             animator — crashed at startup), so the hidden state pins
             opacity 0 / translateY(10px) and releasing it on IsVisible=True
             transitions both back to their natural values. -->
        <Style Selector="StackPanel.tab-page">
            <!-- Explicit resting transform: transitions interpolate between two
                 TransformOperations values, never to an unset (null) transform. -->
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.tab-page[IsVisible=False]">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="translateY(6px)"/>
        </Style>
        <!-- ── Pill BOXES in Settings (text fields, number fields and combo boxes, never buttons):
             the metadata editor's filled pill (owner 10-08, PillDialog.axaml pill-field). A soft
             PillFieldBackground lift off the card, no outline; the 1.5px border is always there
             (transparent at rest) so focus only recolours it to the accent and nothing shifts.
             Every state is pinned on the template part so Fluent's hover/focus/disabled boxes
             never bleed through; a disabled box keeps the resting fill and is greyed by its row
             (or Fluent's dimmed text), not by a different box. ── -->
        <Style Selector="TextBox">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource PillFieldBackground}"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource PillFieldBackground}"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="{DynamicResource PillFieldBackgroundPointerOver}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement, TextBox:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource PillFieldBackgroundFocused}"/>
        </Style>
        <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="{DynamicResource PillFieldBackground}"/>
        </Style>
        <!-- Plain number fields (plugin settings): Fluent draws the box on the spinner shell
             (its inner TextBox stays clear), so the shell takes the filled pill. eq-pill-number
             hides its spinner and fills its TextBox instead (rules above). -->
        <Style Selector="NumericUpDown:not(.eq-pill-number) /template/ ButtonSpinner">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource PillFieldBackground}"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <Style Selector="NumericUpDown:not(.eq-pill-number):pointerover /template/ ButtonSpinner">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="{DynamicResource PillFieldBackgroundPointerOver}"/>
        </Style>
        <Style Selector="NumericUpDown:not(.eq-pill-number):focus-within /template/ ButtonSpinner">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PillFieldBackgroundFocused}"/>
        </Style>
        <Style Selector="NumericUpDown:not(.eq-pill-number):disabled /template/ ButtonSpinner">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="{DynamicResource PillFieldBackground}"/>
        </Style>
        <!-- Its inner TextBox stays clear (the shell is the box), in every state. -->
        <Style Selector="NumericUpDown:not(.eq-pill-number) /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="NumericUpDown:not(.eq-pill-number) /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="NumericUpDown:not(.eq-pill-number) /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="NumericUpDown:not(.eq-pill-number) /template/ TextBox#PART_TextBox:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="NumericUpDown:not(.eq-pill-number) /template/ TextBox#PART_TextBox:disabled /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <!-- Every combo box: the Settings drop-down (shell, list, rows, pop motion), shared with
             plugin windows (Noctis.UI/Assets/DropDowns.axaml). -->
        <StyleInclude Source="avares://Noctis.UI/Assets/DropDowns.axaml"/>
        <!-- Equalizer: the per-band remove control is a round chip like the page's close X. -->
        <Style Selector="Button.eq-remove">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}"/>
        </Style>
        <Style Selector="Button.eq-remove /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="13"/>
        </Style>
        <Style Selector="Button.eq-remove:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>

        <!-- Profile: name in a rounded box (Claude-style field), avatar badges. -->
        <Style Selector="TextBox.profile-name">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="TextBox.profile-name /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="Border.avatar-badge">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.avatar-x">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.avatar-x /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Button.avatar-x:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Border.stat-pill">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- One TextBlock (two Runs) per pill with a fixed 14px box: number and label share a
                 baseline, and a label with descenders (Lossy, playlists) can't grow the box. -->
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
        </Style>
        <!-- The camera badge and the X only appear while the pointer is over the avatar. -->
        <Style Selector="Panel.avatar-wrap Border.avatar-badge, Panel.avatar-wrap Button.avatar-x">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.avatar-wrap:pointerover Border.avatar-badge, Panel.avatar-wrap:pointerover Button.avatar-x">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- ── Grouped rail + grouped cards (2026-09 revamp) ── -->
        <Style Selector="TextBlock.rail-group">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Margin" Value="10,12,0,4"/>
        </Style>
        <Style Selector="PathIcon.rail-icon">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.rail-item.active PathIcon.rail-icon">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- Bitmap rail icons take the row's text colour: theme foreground at rest, accent foreground when active. -->
        <Style Selector="controls|MaskIcon.rail-bitmap">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.rail-item.active controls|MaskIcon.rail-bitmap">
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- One card per section; the cards that moved into it are hairline-separated rows. -->
        <Style Selector="Border.setting-card.group-card">
            <Setter Property="Padding" Value="22,4"/>
        </Style>
        <Style Selector="Border.setting-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0,14"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
        </Style>
        <Style Selector="Border.setting-row:nth-child(1)">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <!-- First row the page shows when the rows above it are platform-gated off
             (nth-child counts hidden siblings, so it drew a stray top hairline on macOS/Linux). -->
        <Style Selector="Border.setting-row.first">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Border.setting-row.divided">
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
        <!-- Plugins page: a plugin that cannot run while Community plugins is off greys out like
             Song Transitions under Exclusive audio (same 0.5), instead of wearing a Restricted pill. -->
        <Style Selector="StackPanel.plugin-body.restricted">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <!-- Rows an ItemsControl makes inside a group card (Plugins page): a hairline between them,
             none above the first. Each row is the only child of its container, so the
             :nth-child(1) rule above can't tell them apart; the container's index can. -->
        <Style Selector="ItemsControl.row-list ContentPresenter > Border.setting-row">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ItemsControl.row-list ContentPresenter:nth-child(n+2) > Border.setting-row">
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
        <!-- Round icon buttons beside a pill-action (Plugins page): same height and fill as the
             pill, a 15px outline glyph drawn at a 2/24 stroke so both icons share one weight. -->
        <Style Selector="Button.icon-chip">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.icon-chip /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="Button.icon-chip:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <!-- Coming soon cards (AccountFeatures off): shown, disabled, dimmed. -->
        <Style Selector="Border.setting-row.parked">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
        <Style Selector="Button.settings-close">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}"/>
        </Style>
        <Style Selector="Button.settings-close:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <!-- Close X + EQ remove X: solid accent circle, white glyph (Claude send-button look).
             Hover/press deepen like the other accent buttons instead of the grey wash. -->
        <Style Selector="Button.settings-close /template/ ContentPresenter, Button.eq-remove /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="Button.settings-close:pointerover /template/ ContentPresenter, Button.eq-remove:pointerover /template/ ContentPresenter, Button.settings-close:pressed /template/ ContentPresenter, Button.eq-remove:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrushDark1}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>

        <!-- ── Plugins page (card grid + a plugin's page). Last in this block on purpose: these
             rules must win over the generic Settings Button rules above (no hover zoom, the
             ContentPresenter hover wash), which match the cards too. ── -->

        <!-- The grid and a plugin's page slide past each other: the incoming one fades in from
             28 px to its side. Same trick as tab-page: the hidden state pins opacity and offset,
             and releasing it on IsVisible=True transitions both home (keyframe animations can't
             drive RenderTransform here). A plugin's own view (PluginViewPage) comes in over its
             page the same way, and the page comes back from the left. -->
        <Style Selector=":is(Panel).plugin-subpage">
            <Setter Property="RenderTransform" Value="translateX(0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="{StaticResource PluginPageEase}"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="{StaticResource PluginPageEase}"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector=":is(Panel).plugin-subpage.from-right[IsVisible=False]">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="translateX(28px)"/>
        </Style>
        <Style Selector=":is(Panel).plugin-subpage.from-left[IsVisible=False]">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="translateX(-28px)"/>
        </Style>

        <!-- The trust switch, compact. -->
        <Style Selector="Border.setting-card.plugin-trust-card">
            <Setter Property="Padding" Value="20,11"/>
            <Setter Property="CornerRadius" Value="20"/>
        </Style>

        <Style Selector="TextBox.plugin-search">
            <Setter Property="Padding" Value="8,0,14,0"/>
        </Style>

        <!-- Section counts beside the titles. -->
        <Style Selector="Border.plugin-count">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.plugin-count > TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Cards: lift on hover, a small dip on press, the accent ring for keyboard focus. -->
        <Style Selector="Button.plugin-card">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform" Value="translateY(0px) scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="{StaticResource PluginPageEase}"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.plugin-card:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-3px) scale(1)"/>
        </Style>
        <Style Selector="Button.plugin-card:pressed">
            <Setter Property="RenderTransform" Value="translateY(-1px) scale(0.97)"/>
        </Style>
        <Style Selector="Button.plugin-card /template/ Border#card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.plugin-card:pointerover /template/ Border#card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}"/>
            <Setter Property="BorderBrush" Value="#2BFFFFFF"/>
        </Style>
        <Style Selector="Button.plugin-card:focus-visible /template/ Border#card">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
        </Style>
        <Style Selector="Button.plugin-card /template/ ContentPresenter, Button.plugin-card:pointerover /template/ ContentPresenter, Button.plugin-card:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Community plugins off: a code plugin's card greys out like the rows did. -->
        <Style Selector="Button.plugin-card.restricted StackPanel.plugin-card-body">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>

        <!-- The corner pill: On / Off / Update / a problem. -->
        <Style Selector="Border.plugin-chip">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
        </Style>
        <Style Selector="Border.plugin-chip > TextBlock">
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
        <Style Selector="Border.plugin-chip.accent">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
        </Style>
        <Style Selector="Border.plugin-chip.accent > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- A plugin's page: Settings card look, not setting-card (Settings search must not pick
             up a page that comes and goes). -->
        <Style Selector="Border.plugin-panel">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="22,16"/>
        </Style>
        <Style Selector="TextBlock.plugin-panel-title">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- A plugin's page (owner 10-29): grouped rows in the Settings card look, a hairline
             between rows, none above the first. -->
        <Style Selector="Border.plugin-panel.plugin-group">
            <Setter Property="Padding" Value="22,0"/>
        </Style>
        <Style Selector="Border.plugin-row">
            <Setter Property="Padding" Value="0,13"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
        </Style>
        <Style Selector="Border.plugin-row.first">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBlock.plugin-row-label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.plugin-row-hint">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
        <Style Selector="ItemsControl:disabled Border.plugin-setting-row">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <!-- A whole row that is a button (permissions, Remove plugin): no fill, no lift. -->
        <Style Selector="Button.plugin-row-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransform" Value="{x:Null}"/>
        </Style>
        <Style Selector="Button.plugin-row-button /template/ ContentPresenter#PART_ContentPresenter, Button.plugin-row-button:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.plugin-row-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.plugin-row-button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
        </Style>
        <Style Selector="Button.plugin-danger-row">
            <Setter Property="Padding" Value="0,14"/>
            <Setter Property="Foreground" Value="#E74856"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.plugin-danger-row:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.plugin-danger-row:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#FF6B76"/>
        </Style>
        <Style Selector="PathIcon.plugin-perm-chevron">
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="PathIcon.plugin-perm-chevron.open">
            <Setter Property="RenderTransform" Value="rotate(180deg)"/>
        </Style>
        <!-- Pills with a set height on the Plugins pages (Back 32, the rest 34): the pill-action
             template padding (16,10) above left them 12-14 px for 12.5 px text, so "Plugins" on
             Back lost the bottom of its "g" (owner screenshot 10-29). Keep the sides, drop the
             top and bottom: the height centres the label. -->
        <Style Selector="Button.pill-action[Height=34] /template/ ContentPresenter">
            <Setter Property="Padding" Value="16,0"/>
        </Style>
        <Style Selector="Button.pill-action.plugin-back /template/ ContentPresenter">
            <Setter Property="Padding" Value="8,0,14,0"/>
        </Style>
        <!-- A narrow pane (SettingsView.axaml.cs LayoutPluginRows): a setting's control drops under
             its label instead of squeezing the label or running past the card. -->
        <Style Selector="Panel.plugin-setting-control">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="StackPanel.narrow Panel.plugin-setting-control">
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <!-- Number settings without a full range: a pill stepper in the Settings field fill. -->
        <Style Selector="Border.plugin-stepper">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="{DynamicResource PillFieldBackground}"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Height" Value="34"/>
        </Style>
        <Style Selector="Button.plugin-step">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.plugin-step /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="Button.plugin-step:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PillFieldBackgroundPointerOver}"/>
        </Style>

        <!-- Phone app card (Connect a phone): the pairing panel, its QR / manual switch,
             numbered steps, the values to copy or compare, and the folded Advanced row. -->
        <Style Selector="Border.pair-panel">
            <Setter Property="Background" Value="#14808080"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>
        <Style Selector="Border.pair-switch">
            <Setter Property="Background" Value="#1F808080"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style Selector="Button.pair-mode">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.pair-mode /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="Button.pair-mode TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="Button.pair-mode.selected">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
        </Style>
        <Style Selector="Button.pair-mode.selected /template/ ContentPresenter, Button.pair-mode.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
        </Style>
        <Style Selector="Button.pair-mode.selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Grid.pair-step">
            <Setter Property="ColumnSpacing" Value="12"/>
        </Style>
        <Style Selector="Grid.pair-step > TextBlock, Grid.pair-step > StackPanel > TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.pair-step-number">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style Selector="Border.pair-step-number > TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.pair-value">
            <Setter Property="Background" Value="#22808080"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.pair-caption">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="Button.pair-link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.pair-link TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColorBrush}"/>
        </Style>
        <Style Selector="Button.pair-disclosure">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.pair-disclosure:pointerover /template/ ContentPresenter, Button.pair-disclosure:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- No press dip on a full-width row: Button:pressed's scale(0.97) pulled the right edge
             in ~10 px, so a click on the chevron was released outside the button and did nothing
             (owner 11-04). The chevron's turn is the feedback. -->
        <Style Selector="Button.pair-disclosure:pressed">
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.pair-disclosure:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
        </Style>
        <Style Selector="Path.pair-chevron">
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2">
                        <TransformOperationsTransition.Easing><CubicEaseOut/></TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Path.pair-chevron.open">
            <Setter Property="RenderTransform" Value="rotate(180deg)"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="232,*">

    <!-- Rail: search, then the pages grouped under small headers. -->
    <Border Grid.Column="0" Classes="settings-rail">
        <DockPanel Margin="12,14,12,12">
            <!-- Search across every section (Ctrl+F while Settings is open). -->
            <TextBox DockPanel.Dock="Top"
                     AutomationProperties.Name="{loc:T Settings.SearchSettings}"
                     x:Name="SettingsSearchBox"
                     Classes="settings-search"
                     Watermark="{loc:T Settings.SearchSettings}"
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchQuery, Mode=TwoWay}"
                     Margin="0,0,0,4"/>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SectionGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingsSectionGroup">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="rail-group" Text="{Binding Label}"/>
                            <ItemsControl ItemsSource="{Binding Sections}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SettingsSection">
                                        <Button Classes="rail-item"
                                                AutomationProperties.Name="{Binding Label}"
                                                Classes.active="{Binding IsSelected}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectSettingsTabCommand}"
                                                CommandParameter="{Binding Key}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <!-- Geometry icons draw as a PathIcon; the sidebar's bitmap icons (Folders)
                                                     draw the way the sidebar does: a foreground-filled square masked by the PNG. -->
                                                <Panel Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <PathIcon Classes="rail-icon"
                                                              Data="{Binding IconKey, Converter={x:Static helpers:IconKeyConverter.Instance}}"
                                                              Width="16" Height="16"/>
                                                    <controls:MaskIcon Classes="rail-bitmap" Width="16" Height="16"
                                                            Source="{Binding IconKey, Converter={x:Static helpers:IconKeyConverter.Bitmap}}"
                                                            IsVisible="{Binding IconKey, Converter={x:Static helpers:IconKeyConverter.IsBitmap}}"/>
                                                </Panel>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <!-- Search hit count while a query is active -->
                                                <Border Grid.Column="2" CornerRadius="999" Padding="6,1" Margin="6,0,0,0"
                                                        Background="#22FFFFFF" VerticalAlignment="Center"
                                                        IsVisible="{Binding HasMatches}">
                                                    <TextBlock Text="{Binding MatchCount}" FontSize="10.5" FontWeight="SemiBold"/>
                                                </Border>
                                                <!-- Update-available dot on About -->
                                                <Ellipse Grid.Column="3" Width="8" Height="8" Margin="6,0,0,0"
                                                         Fill="{DynamicResource AccentColorBrush}" VerticalAlignment="Center">
                                                    <Ellipse.IsVisible>
                                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                            <Binding Path="IsAbout"/>
                                                            <Binding Path="$parent[UserControl].((vm:SettingsViewModel)DataContext).ShowUpdateBadge"/>
                                                        </MultiBinding>
                                                    </Ellipse.IsVisible>
                                                </Ellipse>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>

    <!-- Content column: page title + description + close, then the pages. -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="28,20,20,6">
        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedTabTitle}" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedTabDescription}" FontSize="12.5" Opacity="0.55" TextWrapping="Wrap"/>
        </StackPanel>
        <!-- Close: the modal's only close control now that MainWindow has no footer. -->
        <Button Grid.Column="1" Classes="settings-close"
                ToolTip.Tip="{loc:T Settings.CloseTip}"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseSettingsCommand}"
                VerticalAlignment="Top" Margin="12,2,0,0">
            <controls:LineIcon Data="{StaticResource MenuLineClose}" Width="24" Height="24" Margin="-6" StrokeThickness="1.75"/>
        </Button>
    </Grid>

    <!-- Vertical bar always reserved, never Auto: Fluent puts it in its own template column, so
         under Auto it took its width only once a page grew tall enough to scroll. Toggling a
         sub-block (Audio Visualizer picker) then re-flowed EVERY row: the bar jumped in and the
         Flowing Lyrics description re-wrapped (09-12). The bar itself still auto-hides its thumb. -->
    <ScrollViewer x:Name="SettingsScrollViewer"
                  Grid.Row="1"
                  IsVisible="{Binding !IsPluginViewOpen}"
                  Focusable="True"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Visible">
        <StackPanel Margin="28,8,40,28" HorizontalAlignment="Stretch" Spacing="4">

            <StackPanel x:Name="GeneralTabPanel" Classes="tab-page" IsVisible="{Binding IsGeneralTabVisible}" Spacing="4">
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.Language.Title}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.Language.Description}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{loc:T Settings.Language.Title}"
                                  Classes="pill-list"
                                  ItemsSource="{Binding LanguageOptions}"
                                  SelectedItem="{Binding LanguageChoice}"
                                  MinWidth="180"
                                  VerticalAlignment="Center"
                                  CornerRadius="999"
                                  Padding="14,8"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <Border Classes="setting-card group-card" Margin="0,14,0,10">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.StartupWindowBehaviour}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ControlHowNoctisStarts}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.OpenNoctisWhenComputer}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.OpenNoctisWhenComputer}"
                                              IsChecked="{Binding LaunchAtStartup}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <!-- The OS registration can fail (locked-down HKCU, read-only
                         ~/.config/autostart, an unbundled macOS run). The toggle snaps
                         back to what the OS reports and says so, rather than sitting ON
                         with nothing registered. -->
                    <TextBlock Text="{Binding LaunchAtStartupError}"
                               IsVisible="{Binding LaunchAtStartupError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="12" Foreground="#E74856" TextWrapping="Wrap"/>
                    <!-- Dependent on launch-at-startup: only meaningful for login launches. -->
                    <Grid ColumnDefinitions="*,Auto" Classes="dependent-setting" IsEnabled="{Binding LaunchAtStartup}">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.StartMinimizedTray}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.StartMinimizedTray}"
                                              IsChecked="{Binding StartMinimizedToTray}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.MinimizeTray}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.MinimizeTray}"
                                              IsChecked="{Binding MinimizeToTray}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.CloseTray}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.CloseTray}"
                                              IsChecked="{Binding CloseToTray}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.RestoreLastPlayedTrack}" FontSize="13"/>
                            <TextBlock Text="{loc:T Settings.ReopenLastTrackPlaybar}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.RestoreLastPlayedTrack}"
                                              IsChecked="{Binding RestoreLastTrackOnStartup}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Sidebar}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.KeepSidebarExpanded}" FontSize="13"/>
                            <TextBlock Text="{loc:T Settings.PinSidebarOpenAt}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.KeepSidebarExpanded}"
                                              IsChecked="{Binding SidebarAlwaysExpanded}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Hover-expand is moot while the sidebar is pinned open -->
                    <Grid Classes="sub-setting" ColumnDefinitions="*,Auto" IsEnabled="{Binding !SidebarAlwaysExpanded}">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.HoverExpandSidebar}" FontSize="13"/>
                            <TextBlock Text="{loc:T Settings.SlideSidebarOpenHover}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.HoverExpandSidebar}"
                                              IsChecked="{Binding SidebarHoverExpand}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- Start page and the rail's pages: hide, show and reorder (GitHub #199).
                 Settings always shows; a hidden page stays reachable from shortcuts and links. -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Settings.SidebarStartPage}" FontSize="13"/>
                        <TextBlock Text="{loc:T Settings.SidebarStartPageHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              x:Name="SidebarStartPageCombo"
                              AutomationProperties.Name="{loc:T Settings.SidebarStartPage}"
                              Classes="pill-list"
                              ItemsSource="{Binding StartPageOptions}"
                              SelectedItem="{Binding StartPageChoice, Mode=TwoWay}"
                              MinWidth="180"
                              VerticalAlignment="Center"
                              CornerRadius="999"
                              Padding="14,8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SidebarPageOption">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.SidebarPages}" FontSize="13"/>
                        <TextBlock Text="{loc:T Settings.SidebarPagesHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ItemsControl x:Name="SidebarPagesList" ItemsSource="{Binding SidebarPages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SidebarPageOption">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsAvailable}">
                                    <Button Grid.Column="0" Classes="account-icon-btn"
                                            AutomationProperties.Name="{loc:T Settings.SidebarMoveUp}"
                                            ToolTip.Tip="{loc:T Settings.SidebarMoveUp}"
                                            IsEnabled="{Binding CanMoveUp}"
                                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).MoveSidebarPageUpCommand}"
                                            CommandParameter="{Binding}">
                                        <PathIcon Data="{StaticResource ChevronDownThinIcon}" Width="11" Height="11"
                                                  RenderTransform="rotate(180deg)"/>
                                    </Button>
                                    <Button Grid.Column="1" Classes="account-icon-btn"
                                            AutomationProperties.Name="{loc:T Settings.SidebarMoveDown}"
                                            ToolTip.Tip="{loc:T Settings.SidebarMoveDown}"
                                            IsEnabled="{Binding CanMoveDown}"
                                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).MoveSidebarPageDownCommand}"
                                            CommandParameter="{Binding}">
                                        <PathIcon Data="{StaticResource ChevronDownThinIcon}" Width="11" Height="11"/>
                                    </Button>
                                    <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="13"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <controls:LottieToggle Grid.Column="3"
                                                          AutomationProperties.Name="{Binding Label}"
                                                          IsChecked="{Binding IsShown, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanHide}"
                                                          VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Files}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row" IsVisible="{Binding IsFileAssociationSupported}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.OpenAudioFilesNoctis}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.AddNoctisWindowsOpen}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="pill" FontSize="12" Padding="14,6"
                                Classes.registered="{Binding IsRegisteredForAudioFiles}"
                                VerticalAlignment="Center" Margin="12,0,0,0"
                                Command="{Binding RegisterFileTypesCommand}">
                            <!-- Reads the label it shows (its Panel read "Avalonia.Controls.Panel"). -->
                            <Button.Styles>
                                <Style Selector="Button.pill">
                                    <Setter Property="AutomationProperties.Name" Value="{loc:T Settings.Register}"/>
                                </Style>
                                <Style Selector="Button.pill.registered">
                                    <Setter Property="AutomationProperties.Name" Value="{loc:T Settings.Unregister}"/>
                                </Style>
                            </Button.Styles>
                            <Panel>
                                <TextBlock Text="{loc:T Settings.Register}" IsVisible="{Binding !IsRegisteredForAudioFiles}"/>
                                <TextBlock Text="{loc:T Settings.Unregister}" IsVisible="{Binding IsRegisteredForAudioFiles}"/>
                            </Panel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding FileTypesStatus}"
                               IsVisible="{Binding FileTypesStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Classes="setting-row" Classes.first="{Binding !IsFileAssociationSupported}">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.OpenFile}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.RightClickSongOpen}"
                                   FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 AutomationProperties.Name="{loc:T Settings.OpenFile}"
                                 Text="{Binding ExternalOpenAppPath}"
                                 Watermark="{loc:T Settings.NotSet}"
                                 CornerRadius="999"
                                 Padding="14,8"
                                 BorderThickness="1.5"
                                 MinHeight="0" />
                        <Button Grid.Column="1"
                                Content="{loc:T Settings.Browse}"
                                Command="{Binding BrowseExternalOpenAppCommand}"
                                Padding="14,8"
                                CornerRadius="999"
                                Margin="8,0,0,0"
                                Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="AppearanceTabPanel" Classes="tab-page" IsVisible="{Binding IsAppearanceTabVisible}" Spacing="4">
            <Border Classes="setting-card" Padding="22,12">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.Themes}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ChooseHowNoctisLooks}"
                                   FontSize="12" Opacity="0.5"/>
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal">
                        <WrapPanel.Styles>
                            <Style Selector="Button.theme-btn">
                                <Setter Property="Margin" Value="0,0,10,10"/>
                            </Style>
                        </WrapPanel.Styles>
                        <!-- Dark (pure black, silver accents) -->
                        <Button Classes="theme-btn"
                                AutomationProperties.Name="{loc:T Settings.Dark}"
                                Classes.active="{Binding IsDarkTheme}"
                                Command="{Binding SetDarkThemeCommand}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="64" Height="40" CornerRadius="6"
                                        Background="#000000"
                                        BorderBrush="#1A1A1A" BorderThickness="1">
                                    <StackPanel Margin="6,5" Spacing="3">
                                        <Border Height="3" Width="30" CornerRadius="1.5"
                                                Background="#E8E8E8" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="20" CornerRadius="1.5"
                                                Background="#A8A8A8" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="36" CornerRadius="1.5"
                                                Background="#707070" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:T Settings.Dark}" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Gray (default) -->
                        <Button Classes="theme-btn"
                                AutomationProperties.Name="{loc:T Settings.Gray}"
                                Classes.active="{Binding IsGrayTheme}"
                                Command="{Binding SetGrayThemeCommand}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="64" Height="40" CornerRadius="6"
                                        Background="#1E1E1E"
                                        BorderBrush="#444" BorderThickness="1">
                                    <StackPanel Margin="6,5" Spacing="3">
                                        <Border Height="3" Width="30" CornerRadius="1.5"
                                                Background="#555" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="20" CornerRadius="1.5"
                                                Background="#444" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="36" CornerRadius="1.5"
                                                Background="#333" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:T Settings.Gray}" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Midnight (deep blue-black) -->
                        <Button Classes="theme-btn"
                                AutomationProperties.Name="{loc:T Settings.Midnight}"
                                Classes.active="{Binding IsMidnightTheme}"
                                Command="{Binding SetMidnightThemeCommand}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="64" Height="40" CornerRadius="6"
                                        Background="#0E1322"
                                        BorderBrush="#1E2640" BorderThickness="1">
                                    <StackPanel Margin="6,5" Spacing="3">
                                        <Border Height="3" Width="30" CornerRadius="1.5"
                                                Background="#7C8CFF" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="20" CornerRadius="1.5"
                                                Background="#5A6BB0" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="36" CornerRadius="1.5"
                                                Background="#3A4673" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:T Settings.Midnight}" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Light -->
                        <Button Classes="theme-btn"
                                AutomationProperties.Name="{loc:T Settings.Light}"
                                Classes.active="{Binding IsLightTheme}"
                                Command="{Binding SetLightThemeCommand}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="64" Height="40" CornerRadius="6"
                                        Background="#F5F5F5"
                                        BorderBrush="#CCC" BorderThickness="1">
                                    <StackPanel Margin="6,5" Spacing="3">
                                        <Border Height="3" Width="30" CornerRadius="1.5"
                                                Background="#CCC" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="20" CornerRadius="1.5"
                                                Background="#DDD" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="36" CornerRadius="1.5"
                                                Background="#E0E0E0" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:T Settings.Light}" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Ink -->
                        <Button Classes="theme-btn"
                                AutomationProperties.Name="{loc:T Settings.Ink}"
                                Classes.active="{Binding IsInkTheme}"
                                Command="{Binding SetInkThemeCommand}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="64" Height="40" CornerRadius="6"
                                        Background="#0F0F0F"
                                        BorderBrush="#2A2A2A" BorderThickness="1">
                                    <StackPanel Margin="6,5" Spacing="3">
                                        <Border Height="3" Width="30" CornerRadius="1.5"
                                                Background="#D63A2E" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="20" CornerRadius="1.5"
                                                Background="#2B66D9" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="36" CornerRadius="1.5"
                                                Background="#A3A3A3" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:T Settings.Ink}" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Smoke -->
                        <Button Classes="theme-btn"
                                AutomationProperties.Name="{loc:T Settings.Smoke}"
                                Classes.active="{Binding IsSmokeTheme}"
                                Command="{Binding SetSmokeThemeCommand}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="64" Height="40" CornerRadius="6"
                                        Background="#2A2D38"
                                        BorderBrush="#3E4250" BorderThickness="1">
                                    <StackPanel Margin="6,5" Spacing="3">
                                        <Border Height="3" Width="30" CornerRadius="1.5"
                                                Background="#2F6ACB" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="20" CornerRadius="1.5"
                                                Background="#8A8F9E" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="36" CornerRadius="1.5"
                                                Background="#4A4E5A" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:T Settings.Smoke}" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- User-created themes -->
                        <ItemsControl ItemsSource="{Binding CustomThemes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CustomThemeTile">
                                    <Button Classes="theme-btn"
                                            AutomationProperties.Name="{Binding Name}"
                                            Classes.active="{Binding IsActive}"
                                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).ApplyCustomThemeCommand}"
                                            CommandParameter="{Binding Id}"
                                            Margin="0,0,10,10">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{loc:T Settings.Edit}"
                                                          Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).OpenThemeEditorCommand}"
                                                          CommandParameter="{Binding Id}">
                                                    <MenuItem.Icon>
                                                        <controls:LineIcon Classes="mv2-icon" Data="{StaticResource MenuLineEdit}"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{loc:T Settings.Delete}" Classes="danger"
                                                          Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DeleteCustomThemeCommand}"
                                                          CommandParameter="{Binding Id}">
                                                    <MenuItem.Icon>
                                                        <controls:LineIcon Classes="mv2-icon" Data="{StaticResource MenuLineTrash}"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                                            <Border Width="64" Height="40" CornerRadius="6"
                                                    Background="{Binding MainHex}"
                                                    BorderBrush="{Binding SidebarHex}"
                                                    BorderThickness="1">
                                                <StackPanel Margin="6,5" Spacing="3">
                                                    <Border Height="3" Width="30" CornerRadius="1.5"
                                                            Background="{Binding AccentHex}" HorizontalAlignment="Left"/>
                                                    <Border Height="3" Width="20" CornerRadius="1.5"
                                                            Background="{Binding SidebarHex}" HorizontalAlignment="Left"/>
                                                    <Border Height="3" Width="36" CornerRadius="1.5"
                                                            Background="{Binding SidebarHex}" Opacity="0.65"
                                                            HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       MaxWidth="64" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Content-pack themes: same tile, plus "by <pack>" under the name. -->
                        <ItemsControl ItemsSource="{Binding PackThemes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PackThemeTile">
                                    <Button Classes="theme-btn"
                                            AutomationProperties.Name="{Binding Name}"
                                            Classes.active="{Binding IsActive}"
                                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).ApplyPackThemeCommand}"
                                            CommandParameter="{Binding Key}"
                                            ToolTip.Tip="{Binding ByLabel}"
                                            Margin="0,0,10,10">
                                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                                            <Border Width="64" Height="40" CornerRadius="6"
                                                    Background="{Binding MainHex}"
                                                    BorderBrush="{Binding SidebarHex}"
                                                    BorderThickness="1">
                                                <StackPanel Margin="6,5" Spacing="3">
                                                    <Border Height="3" Width="30" CornerRadius="1.5"
                                                            Background="{Binding AccentHex}" HorizontalAlignment="Left"/>
                                                    <Border Height="3" Width="20" CornerRadius="1.5"
                                                            Background="{Binding SidebarHex}" HorizontalAlignment="Left"/>
                                                    <Border Height="3" Width="36" CornerRadius="1.5"
                                                            Background="{Binding SidebarHex}" Opacity="0.65"
                                                            HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Spacing="0" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           MaxWidth="72" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ByLabel}" FontSize="10" Opacity="0.5"
                                                           HorizontalAlignment="Center"
                                                           MaxWidth="72" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- "+ Custom" add tile -->
                        <Button Classes="theme-btn"
                                AutomationProperties.Name="{loc:T Settings.Custom}"
                                Command="{Binding OpenThemeEditorCommand}"
                                CommandParameter="{x:Null}"
                                Margin="0,0,10,10"
                                ToolTip.Tip="{loc:T Settings.CreateCustomThemeTip}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="64" Height="40" CornerRadius="6"
                                        BorderBrush="#55FFFFFF" BorderThickness="1">
                                    <TextBlock Text="+" FontSize="22" Opacity="0.7"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{loc:T Settings.Custom}" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <!-- App Icon: the window/taskbar/tray icon, swapped live (AppIconService). Each
                 tile shows the real rendered icon; the active one takes the theme tiles'
                 accent outline. The exe/shortcut icon is baked in and stays classic. -->
            <Border x:Name="AppIconCard" Classes="setting-card" Padding="22,12">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.AppIcon}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.AppIconDesc}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ItemsControl x:Name="AppIconList" ItemsSource="{Binding AppIconOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppIconOption">
                                <Button Classes="theme-btn"
                                        AutomationProperties.Name="{Binding Name}"
                                        Classes.active="{Binding IsSelected}"
                                        Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SetAppIconCommand}"
                                        CommandParameter="{Binding Id}"
                                        Margin="0,0,10,10">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                        <!-- 48 DIP from a 96 px render: an exact 2:1 step at 100 %
                                             and 1:1 at 200 %, so the preview stays crisp. -->
                                        <Image Source="{Binding Preview}" Width="48" Height="48"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   MaxWidth="90" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Classes="setting-card">
                <StackPanel Spacing="16">

                    <!-- Header row -->
                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:T Settings.AccentColor}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.PickPresetOpenPicker}"
                                       FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- Preset grid + custom-picker tile -->
                    <StackPanel Spacing="8">
                        <Grid>
                            <!-- Preset swatches -->
                            <ItemsControl ItemsSource="{Binding AccentSwatches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="12"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccentSwatch">
                                        <Button Classes="accent-swatch"
                                                Background="Transparent" BorderThickness="0" Padding="0"
                                                Margin="0,0,4,4" Cursor="Hand"
                                                ToolTip.Tip="{Binding Name}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).ApplyAccentPresetCommand}"
                                                CommandParameter="{Binding}">
                                            <Panel Width="44" Height="44">
                                                <Border Width="40" Height="40" CornerRadius="20"
                                                        Background="{Binding Hex}"
                                                        BorderBrush="#22000000"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <!-- Selection ring sits on the colour's own edge (same
                                                     40px box) so the white overlaps the disc's rim — no
                                                     dark border or anti-alias seam shows between the
                                                     colour and the white outline. -->
                                                <Border Width="40" Height="40" CornerRadius="20"
                                                        BorderBrush="White" BorderThickness="2"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsActive}"/>
                                            </Panel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Custom-color tile: rainbow ring + plus, opens reusable HSV/hex picker.
                                 It takes the 12th cell of the last swatch row (App.AccentPresets holds
                                 12n-1 colours, guarded by a test), on a grid with the same 12 columns,
                                 so it reads as the next slot instead of starting a row of its own. -->
                            <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*">
                            <Panel Grid.Column="11" Width="44" Height="44"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,4,4">
                                <controls:ColorPickerFlyout Hex="{Binding CustomAccentHex, Mode=TwoWay}"
                                                            SwatchSize="44"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            ToolTip.Tip="{loc:T Settings.CustomColorTip}"
                                                            AutomationProperties.Name="{loc:T Settings.CustomColorTip}"
                                                            Cursor="Hand">
                                    <controls:ColorPickerFlyout.SwatchContent>
                                        <Panel Width="44" Height="44">
                                            <!-- Rainbow ring -->
                                            <Border Width="40" Height="40" CornerRadius="20"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="50%,50%">
                                                        <GradientStop Offset="0.00" Color="#FF0000"/>
                                                        <GradientStop Offset="0.17" Color="#FFFF00"/>
                                                        <GradientStop Offset="0.33" Color="#00FF00"/>
                                                        <GradientStop Offset="0.50" Color="#00FFFF"/>
                                                        <GradientStop Offset="0.67" Color="#0000FF"/>
                                                        <GradientStop Offset="0.83" Color="#FF00FF"/>
                                                        <GradientStop Offset="1.00" Color="#FF0000"/>
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <!-- White inner disc with + glyph -->
                                            <Border Width="30" Height="30" CornerRadius="15"
                                                    Background="{DynamicResource AppMainBackground}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="+"
                                                           FontSize="20" FontWeight="Light"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Width="40" Height="40" CornerRadius="20"
                                                    BorderBrush="White" BorderThickness="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    IsVisible="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).IsCustomAccentSelected}"/>
                                        </Panel>
                                    </controls:ColorPickerFlyout.SwatchContent>
                                </controls:ColorPickerFlyout>
                            </Panel>
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <!-- Accent follows album art (Discord, aaron 09-15) -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.AccentFollowsArtwork}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.AccentFollowsArtworkHint}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.AccentFollowsArtwork}"
                                              IsChecked="{Binding AccentFollowsArtwork}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <!-- GitHub #125: plain artist / album names in song lists -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.AccentTrackLinks}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.AccentTrackLinksHint}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.AccentTrackLinks}"
                                              IsChecked="{Binding AccentTrackLinks}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- GitHub #145: the whole interface larger or smaller, live, in every window
                 (UiScale). A picker, not a slider: each step re-lays out the whole app,
                 the slider under the pointer included. -->
            <Border Classes="setting-card group-card" Margin="0,14,0,0">
            <StackPanel>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                        <TextBlock Text="{loc:T Settings.UiScale}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.UiScaleHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              x:Name="UiScaleCombo"
                              AutomationProperties.Name="{loc:T Settings.UiScale}"
                              Classes="pill-list"
                              ItemsSource="{Binding UiScaleOptions}"
                              SelectedItem="{Binding SelectedUiScaleOption}"
                              MinWidth="180"
                              VerticalAlignment="Center"
                              CornerRadius="999"
                              Padding="14,8"/>
                </Grid>
            </Border>
            </StackPanel>
            </Border>

            <Border Classes="setting-card group-card" Margin="0,14,0,10">
            <StackPanel>
            <Border Classes="setting-row" IsVisible="{Binding IsLiquidGlassSupported}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.LiquidGlass}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.FrostWindowTranslucentBlurred}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.LiquidGlass}"
                                          IsChecked="{Binding LiquidGlassEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.PlayerBarOpacity}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HowSolidPlaybackBar}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <Slider Grid.Column="0"
                                AutomationProperties.Name="{loc:T Settings.PlayerBarOpacity}"
                                Classes="accent-slider"
                                Minimum="0" Maximum="1"
                                x:Name="PlayerBarOpacitySlider"
                                Value="{Binding PlaybackBarBackgroundOpacity, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PlaybackBarBackgroundOpacity, StringFormat='{}{0:P0}'}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center"
                                   MinWidth="44" TextAlignment="Right" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- Background Blur (owner 10-08): the app behind pop-ups and this sheet, a smooth
                 0–100% slider like the opacity ones, far left = off (dim only). Applied live: the
                 sheet's own backdrop re-blurs as the thumb moves. -->
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.BackgroundBlur}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.BackgroundBlurHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <Slider Grid.Column="0"
                                AutomationProperties.Name="{loc:T Settings.BackgroundBlur}"
                                Classes="accent-slider"
                                Minimum="0" Maximum="1"
                                x:Name="BackgroundBlurSlider"
                                Value="{Binding BackgroundBlurAmount, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding BackgroundBlurLabel}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center"
                                   MinWidth="44" TextAlignment="Right" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.TrackBoxOpacity}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HowSolidTrackBox}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <Slider Grid.Column="0"
                                AutomationProperties.Name="{loc:T Settings.TrackBoxOpacity}"
                                Classes="accent-slider"
                                Minimum="0" Maximum="1"
                                x:Name="TrackBoxOpacitySlider"
                                Value="{Binding PlaybackBarTrackBoxOpacity, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PlaybackBarTrackBoxOpacity, StringFormat='{}{0:P0}'}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center"
                                   MinWidth="44" TextAlignment="Right" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <Border Classes="setting-card group-card" Margin="0,14,0,10">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.TextAnimation}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ControlHowLongText}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Sub-header: Player Bar -->
                    <TextBlock Text="{loc:T Settings.PLAYERBAR}" FontSize="11" FontWeight="SemiBold" Opacity="0.4" Margin="0,4,0,2"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.AnimateLongTrackTitles}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.AnimateLongTrackTitles}"
                                              IsChecked="{Binding TrackTitleMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.AnimateLongArtistNames}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.AnimateLongArtistNames}"
                                              IsChecked="{Binding ArtistMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Sub-header: Cover Flow -->
                    <TextBlock Text="{loc:T Settings.COVERFLOW}" FontSize="11" FontWeight="SemiBold" Opacity="0.4" Margin="0,8,0,2"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.AnimateLongTrackTitles}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.AnimateLongTrackTitles}"
                                              IsChecked="{Binding CoverFlowMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.AnimateLongArtistNames}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.AnimateLongArtistNames}"
                                              IsChecked="{Binding CoverFlowArtistMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.AnimateLongAlbumTitles}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.AnimateLongAlbumTitles}"
                                              IsChecked="{Binding CoverFlowAlbumMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Sub-header: Lyrics Page -->
                    <TextBlock Text="{loc:T Settings.LYRICSPAGE}" FontSize="11" FontWeight="SemiBold" Opacity="0.4" Margin="0,8,0,2"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.AnimateLongTrackTitles}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.AnimateLongTrackTitles}"
                                              IsChecked="{Binding LyricsTitleMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.AnimateLongArtistAlbum}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.AnimateLongArtistAlbum}"
                                              IsChecked="{Binding LyricsArtistMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Sub-header: Mini Player -->
                    <TextBlock Text="{loc:T Settings.MINIPLAYER}" FontSize="11" FontWeight="SemiBold" Opacity="0.4" Margin="0,8,0,2"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.AnimateLongTrackTitles}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.AnimateLongTrackTitles}"
                                              IsChecked="{Binding MiniPlayerTitleMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.AnimateLongAlbumTitles}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.AnimateLongAlbumTitles}"
                                              IsChecked="{Binding MiniPlayerAlbumMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Home}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.HomeHeavyRotation}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HomeHeavyRotationDesc}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.HomeHeavyRotation}"
                                          IsChecked="{Binding HomeShowHeavyRotation}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- GitHub #159: album row sizes (also on each row's own pill) and their order. -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                        <TextBlock Text="{loc:T Settings.HomeRecentAlbumsCount}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HomeRecentAlbumsCountDesc}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              x:Name="HomeRecentAlbumsCountCombo"
                              AutomationProperties.Name="{loc:T Settings.HomeRecentAlbumsCount}"
                              Classes="pill-list"
                              ItemsSource="{Binding HomeAlbumCountChoices}"
                              SelectedItem="{Binding HomeRecentAlbumsCount}"
                              MinWidth="96"
                              VerticalAlignment="Center"
                              CornerRadius="999"
                              Padding="14,8"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                        <TextBlock Text="{loc:T Settings.HomeNewAlbumsCount}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HomeNewAlbumsCountDesc}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              x:Name="HomeNewAlbumsCountCombo"
                              AutomationProperties.Name="{loc:T Settings.HomeNewAlbumsCount}"
                              Classes="pill-list"
                              ItemsSource="{Binding HomeAlbumCountChoices}"
                              SelectedItem="{Binding HomeNewAlbumsCount}"
                              MinWidth="96"
                              VerticalAlignment="Center"
                              CornerRadius="999"
                              Padding="14,8"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.HomeNewAlbumsFirst}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HomeNewAlbumsFirstDesc}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.HomeNewAlbumsFirst}"
                                          IsChecked="{Binding HomeNewAlbumsFirst}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Artwork}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.AnimatedArtwork}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ShowAnimatedCoverArt}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.AnimatedArtwork}"
                                          IsChecked="{Binding EnableAnimatedCovers}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- GitHub #167: fetch on opening an album into a size-capped cache (oldest loops go
                 first). Only while animated artwork is on; its cache options fold under it. -->
            <Border Classes="setting-row" IsVisible="{Binding EnableAnimatedCovers}">
                <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                        <TextBlock Text="{loc:T Settings.AnimArtAutoFetch}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.AnimArtAutoFetchDesc}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.AnimArtAutoFetch}"
                                          IsChecked="{Binding AnimatedArtworkAutoFetch}"
                                          VerticalAlignment="Center"/>
                </Grid>
                <controls:CollapsibleContent IsOpen="{Binding AnimatedArtworkAutoFetch}" Lift="10" Motion="Glide">
                <StackPanel Classes="sub-setting" Spacing="10" Margin="2,10,0,0">
                    <!-- GitHub #185: the quality fetched loops download at (also Find Animated
                         Artwork); 2160p falls back to 1080p when an album has none. -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.AnimArtQuality}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.AnimArtQualityDesc}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{loc:T Settings.AnimArtQuality}"
                                  Classes="pill-list"
                                  ItemsSource="{Binding AnimatedArtworkQualityOptions}"
                                  SelectedItem="{Binding SelectedAnimatedArtworkQualityOption}"
                                  MinWidth="96"
                                  VerticalAlignment="Center"
                                  CornerRadius="999"
                                  Padding="14,8"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.AnimArtCacheSize}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.AnimArtCacheSizeDesc}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{loc:T Settings.AnimArtCacheSize}"
                                  Classes="pill-list"
                                  ItemsSource="{Binding AnimatedArtworkCacheSizeOptions}"
                                  SelectedItem="{Binding SelectedAnimatedArtworkCacheSizeOption}"
                                  MinWidth="96"
                                  VerticalAlignment="Center"
                                  CornerRadius="999"
                                  Padding="14,8"/>
                    </Grid>
                    <!-- How full the cache is: a thin bar plus "312 MB of 1 GB used", Clear on the right. -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0" VerticalAlignment="Center">
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding AnimatedArtworkCacheUsedPercent}"
                                         Height="4" CornerRadius="2"/>
                            <TextBlock Text="{Binding AnimatedArtworkCacheUsage}"
                                       FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                IsEnabled="{Binding HasAnimatedArtworkCache}"
                                AutomationProperties.Name="{loc:T Settings.ClearCache}"
                                Command="{Binding ClearAnimatedArtworkCacheCommand}"
                                Classes="pill-action"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.ClearCache}" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
                </controls:CollapsibleContent>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <!-- Toggle + its Tint strength slider share a spacing-free panel so the gap folds
                     with the body (see the Crossfade block). -->
                <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.AlbumPageColour}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.TintEachAlbumS}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.AlbumPageColour}"
                                          IsChecked="{Binding AlbumPageTintEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
                <!-- Tint strength (only while the page colour is on): how much of the cover
                     colour the page takes on; 100% is the full cover colour. -->
                <controls:CollapsibleContent IsOpen="{Binding AlbumPageTintEnabled}" Lift="10" Motion="Glide">
                <StackPanel Classes="sub-setting" Spacing="6" Margin="2,10,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.AlbumPageTintStrength}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.AlbumPageTintStrengthHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <controls:SmoothSlider x:Name="AlbumPageTintStrengthSlider" Grid.Column="0" Classes="accent-slider" Step="1"
                                AutomationProperties.Name="{loc:T Settings.AlbumPageTintStrength}"
                                Minimum="0" Maximum="100"
                                SteppedValue="{Binding AlbumPageTintStrength, Mode=TwoWay}" VerticalAlignment="Center"
                                DoubleTapped="OnAlbumPageTintStrengthSliderDoubleTapped"/>
                        <TextBlock Grid.Column="1" Text="{Binding AlbumPageTintStrength, StringFormat='{}{0}%'}" FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="36" TextAlignment="Right"/>
                    </Grid>
                    <!-- Whole page: the colour also runs under Other Versions / More By. -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.AlbumPageTintWholePage}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.AlbumPageTintWholePageHint}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.AlbumPageTintWholePage}"
                                              IsChecked="{Binding AlbumPageTintWholePage}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Whole window: the colour also fills the window around the sidebar and player. -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.AlbumPageTintWholeWindow}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.AlbumPageTintWholeWindowHint}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.AlbumPageTintWholeWindow}"
                                              IsChecked="{Binding AlbumPageTintWholeWindow}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
                </controls:CollapsibleContent>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <!-- Header + slider share a spacing-free panel so the 12px gap folds with the body
                         (see the Crossfade block). -->
                    <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.AutomaticAlbumCoverSize}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.FiveCoversPerRow}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.AutomaticAlbumCoverSize}"
                                              IsChecked="{Binding AlbumTileSizeAuto}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <controls:CollapsibleContent IsOpen="{Binding !AlbumTileSizeAuto}" Lift="10" Motion="Glide">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,12,0,0">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.Smaller}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Slider Grid.Column="1"
                                AutomationProperties.Name="{loc:T Settings.AlbumCoverSize}"
                                Classes="accent-slider"
                                Minimum="140" Maximum="320"
                                Value="{Binding AlbumTileTargetSize, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{loc:T Settings.Larger}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding AlbumTileTargetSize, StringFormat='{}{0:0} px'}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center"
                                   MinWidth="52" TextAlignment="Right" Margin="12,0,0,0"/>
                    </Grid>
                    </controls:CollapsibleContent>
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <!-- Both rows are Windows-only; gate the card too, or macOS/Linux showed an empty box. -->
            <Border Classes="setting-card group-card" Margin="0,14,0,10" IsVisible="{Binding IsTaskbarProgressSupported}">
            <StackPanel>
            <Border Classes="setting-row" IsVisible="{Binding IsTaskbarProgressSupported}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.SongProgressTaskbar}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ShowHowFarAlong}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.SongProgressTaskbar}"
                                          IsChecked="{Binding TaskbarProgressEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row" IsVisible="{Binding IsTaskbarProgressSupported}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.MediaControlsTaskbar}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.MediaControlsTaskbarDesc}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.MediaControlsTaskbar}"
                                          IsChecked="{Binding TaskbarMediaControlsEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="PlayerTabPanel" Classes="tab-page" IsVisible="{Binding IsPlayerTabVisible}" Spacing="4">
            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.PlayerIsland}" Margin="0,2,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.PlayerIslandButtons}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.AddExtraControlsPlayer}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <!-- Header + picker share a spacing-free panel so the 12px gap folds with the body
                         (see the Crossfade block). -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.RepeatButton}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.RepeatButtonNextToForward}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.RepeatButton}"
                                              IsChecked="{Binding PlaybackBarShowRepeat}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.FavoriteButton}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.FavoriteButtonHeart}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.FavoriteButton}"
                                              IsChecked="{Binding PlaybackBarShowFavorite}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <!-- GitHub #186: Quick Add to Playlist (up to three picked playlists) and Move to
                         Trash (into a folder picked here, or the Recycle Bin / Trash), both off by default. -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.QuickPlaylistButton}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.QuickPlaylistButtonHint}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.QuickPlaylistButton}"
                                              IsChecked="{Binding PlaybackBarShowQuickPlaylist}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Spacing="8" IsVisible="{Binding PlaybackBarShowQuickPlaylist}">
                        <ComboBox x:Name="QuickPlaylist1Combo"
                                  AutomationProperties.Name="{loc:T Settings.QuickPlaylist1}"
                                  Classes="pill-list"
                                  ItemsSource="{Binding QuickPlaylistOptions}"
                                  SelectedItem="{Binding SelectedQuickPlaylist1}"
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="999"
                                  Padding="14,8"/>
                        <ComboBox x:Name="QuickPlaylist2Combo"
                                  AutomationProperties.Name="{loc:T Settings.QuickPlaylist2}"
                                  Classes="pill-list"
                                  ItemsSource="{Binding QuickPlaylistOptions}"
                                  SelectedItem="{Binding SelectedQuickPlaylist2}"
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="999"
                                  Padding="14,8"/>
                        <ComboBox x:Name="QuickPlaylist3Combo"
                                  AutomationProperties.Name="{loc:T Settings.QuickPlaylist3}"
                                  Classes="pill-list"
                                  ItemsSource="{Binding QuickPlaylistOptions}"
                                  SelectedItem="{Binding SelectedQuickPlaylist3}"
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="999"
                                  Padding="14,8"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.TrashButton}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.TrashButtonHint}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.TrashButton}"
                                              IsChecked="{Binding PlaybackBarShowTrash}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Spacing="6" IsVisible="{Binding PlaybackBarShowTrash}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:T Settings.TrashFolder}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.TrashFolderHint}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox Grid.Column="0"
                                     x:Name="TrashFolderBox"
                                     AutomationProperties.Name="{loc:T Settings.TrashFolder}"
                                     Text="{Binding PlaybackBarTrashFolder}"
                                     IsReadOnly="True"
                                     Watermark="{loc:T Settings.TrashFolderNotSet}"
                                     CornerRadius="999"
                                     Padding="14,8"
                                     BorderThickness="1.5"
                                     MinHeight="0" />
                            <Button Grid.Column="1"
                                    Content="{loc:T Settings.Browse}"
                                    Command="{Binding BrowseTrashFolderCommand}"
                                    Padding="14,8"
                                    CornerRadius="999"
                                    Margin="8,0,0,0"
                                    Cursor="Hand"/>
                            <Button Grid.Column="2"
                                    Content="{loc:T Settings.Clear}"
                                    Command="{Binding ClearTrashFolderCommand}"
                                    IsVisible="{Binding PlaybackBarTrashFolder, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Padding="14,8"
                                    CornerRadius="999"
                                    Margin="8,0,0,0"
                                    Cursor="Hand"/>
                        </Grid>
                        <TextBlock Text="{loc:T Settings.TrashFolderMissing}"
                                   IsVisible="{Binding ShowTrashFolderMissingHint}"
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <!-- GitHub #183: the stock Lyrics button can go; the lyrics page's own bar keeps it. -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.LyricsButton}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.LyricsButtonHint}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.LyricsButton}"
                                              IsChecked="{Binding PlaybackBarShowLyrics}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.MiniPlayerButton}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.MiniPlayerButtonHint}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.MiniPlayerButton}"
                                              IsChecked="{Binding PlaybackBarShowMiniPlayer}"
                                              IsEnabled="{Binding MiniPlayerEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.IdleQueuePill}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.IdleQueuePillHint}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.IdleQueuePill}"
                                              IsChecked="{Binding PlaybackBarShowIdlePill}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.SkipBackForward}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.JumpFewSecondsEither}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.SkipBackForward}"
                                              IsChecked="{Binding PlaybackBarShowSkipButtons}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <controls:CollapsibleContent IsOpen="{Binding PlaybackBarShowSkipButtons}" Lift="10" Motion="Glide">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,12,0,0">
                        <RadioButton Grid.Column="0" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Settings.10Seconds}"
                                     GroupName="IslandSkipSeconds"
                                     IsChecked="{Binding IsSkipSeconds10, Mode=TwoWay}">
                            <TextBlock Text="{loc:T Settings.10Seconds}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Settings.15Seconds}"
                                     GroupName="IslandSkipSeconds"
                                     IsChecked="{Binding IsSkipSeconds15, Mode=TwoWay}">
                            <TextBlock Text="{loc:T Settings.15Seconds}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </RadioButton>
                        <RadioButton Grid.Column="2" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Settings.30Seconds}"
                                     GroupName="IslandSkipSeconds"
                                     IsChecked="{Binding IsSkipSeconds30, Mode=TwoWay}">
                            <TextBlock Text="{loc:T Settings.30Seconds}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </RadioButton>
                    </Grid>
                    </controls:CollapsibleContent>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.PlaybackSpeed}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.1ButtonOpensSpeed}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.PlaybackSpeed}"
                                              IsChecked="{Binding PlaybackBarShowPlaybackSpeed}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.SleepTimer}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.SleepTimerOneClick}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.SleepTimer}"
                                              IsChecked="{Binding PlaybackBarShowSleepTimer}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <!-- The sleep timer's fade-out (also "stop after current track"): a playback
                         gain of its own, so the volume setting never moves. -->
                    <StackPanel Spacing="6">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:T Settings.SleepTimerFadeOut}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.SleepTimerFadeOutDesc}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <RadioButton Grid.Column="0" Classes="transition-card medium-card"
                                         AutomationProperties.Name="{loc:T Settings.SleepFadeOff}"
                                         GroupName="SleepTimerFadeOut"
                                         IsChecked="{Binding IsSleepFadeOff, Mode=TwoWay}">
                                <TextBlock Text="{loc:T Settings.SleepFadeOff}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </RadioButton>
                            <RadioButton Grid.Column="1" Classes="transition-card medium-card"
                                         AutomationProperties.Name="{loc:T Settings.SleepFade10}"
                                         GroupName="SleepTimerFadeOut"
                                         IsChecked="{Binding IsSleepFade10, Mode=TwoWay}">
                                <TextBlock Text="{loc:T Settings.SleepFade10}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </RadioButton>
                            <RadioButton Grid.Column="2" Classes="transition-card medium-card"
                                         AutomationProperties.Name="{loc:T Settings.SleepFade30}"
                                         GroupName="SleepTimerFadeOut"
                                         IsChecked="{Binding IsSleepFade30, Mode=TwoWay}">
                                <TextBlock Text="{loc:T Settings.SleepFade30}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </RadioButton>
                            <RadioButton Grid.Column="3" Classes="transition-card medium-card"
                                         AutomationProperties.Name="{loc:T Settings.SleepFade60}"
                                         GroupName="SleepTimerFadeOut"
                                         IsChecked="{Binding IsSleepFade60, Mode=TwoWay}">
                                <TextBlock Text="{loc:T Settings.SleepFade60}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </RadioButton>
                        </Grid>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.Shuffle}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.ShuffleButtonAfterRepeat}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.Shuffle}"
                                              IsChecked="{Binding PlaybackBarShowShuffle}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.EqualizerButton}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.EqualizerButtonHint}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.EqualizerButton}"
                                              IsChecked="{Binding PlaybackBarShowEqualizer}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.PlaybackTime}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.PlaybackTimeInTrackBox}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.PlaybackTime}"
                                              IsChecked="{Binding PlaybackBarShowTime}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- GitHub #183: what a click on the island's artwork opens (Mini player by default). -->
            <Border Classes="setting-row">
                <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                        <TextBlock Text="{loc:T Settings.ArtworkClick}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ArtworkClickHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              x:Name="ArtworkClickCombo"
                              AutomationProperties.Name="{loc:T Settings.ArtworkClick}"
                              Classes="pill-list"
                              ItemsSource="{Binding ArtworkClickOptions}"
                              SelectedItem="{Binding SelectedArtworkClickOption}"
                              MinWidth="200"
                              VerticalAlignment="Center"
                              CornerRadius="999"
                              Padding="14,8"/>
                </Grid>
                <TextBlock Text="{loc:T Settings.ArtworkClickLyricsHiddenHint}"
                           IsVisible="{Binding ShowArtworkLyricsHint}"
                           FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <!-- GitHub #93: waveform in the island and mini player seek bars (off by default). -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.WaveformSeekBar}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.WaveformSeekBarHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.WaveformSeekBar}"
                                          IsChecked="{Binding WaveformSeekBarEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.PlayerIslandWidth}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HowWidePlayerIsland}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.Narrower}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Slider Grid.Column="1"
                                AutomationProperties.Name="{loc:T Settings.PlayerIslandWidth}"
                                Classes="accent-slider"
                                Minimum="340" Maximum="1400"
                                x:Name="IslandWidthSlider"
                                Value="{Binding PlaybackBarIslandWidth, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{loc:T Settings.Wider}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding PlaybackBarIslandWidth, StringFormat='{}{0:0} px'}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center"
                                   MinWidth="52" TextAlignment="Right" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.MiniPlayer}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.MiniPlayerDesign}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HowMiniPlayerLooks}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <RadioButton Grid.Column="0" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Settings.Classic}"
                                     GroupName="MiniPlayerStyle"
                                     IsChecked="{Binding IsMiniStyleClassic, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.ResizableGlassCardIconTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="5" Canvas.Top="2" Width="18" Height="24" RadiusX="5" RadiusY="5"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="9" Canvas.Top="6" Width="10" Height="10" RadiusX="3" RadiusY="3" Opacity="0.45"
                                               Fill="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Classic}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Settings.Pill}"
                                     GroupName="MiniPlayerStyle"
                                     IsChecked="{Binding IsMiniStylePill, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.RoundCoverOverlappingLightTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="8" Canvas.Top="8" Width="19" Height="12" RadiusX="6" RadiusY="6" Opacity="0.45"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Ellipse Canvas.Left="1" Canvas.Top="6" Width="16" Height="16"
                                             Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Pill}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="2" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Settings.Sleeve}"
                                     GroupName="MiniPlayerStyle"
                                     IsChecked="{Binding IsMiniStyleSleeve, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.SpinningDiscPeekingOutTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Ellipse Canvas.Left="6" Canvas.Top="1" Width="16" Height="16" Opacity="0.45"
                                             Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="3" Canvas.Top="9" Width="22" Height="17" RadiusX="5" RadiusY="5"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Sleeve}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.MiniPlayerOpacity}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HowMuchDesktopShows}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <Slider Grid.Column="0"
                                AutomationProperties.Name="{loc:T Settings.MiniPlayerOpacity}"
                                Classes="accent-slider"
                                Minimum="0" Maximum="1"
                                x:Name="MiniPlayerOpacitySlider"
                                Value="{Binding MiniPlayerBackgroundOpacity, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding MiniPlayerBackgroundOpacity, StringFormat='{}{0:P0}'}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center"
                                   MinWidth="44" TextAlignment="Right" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="setting-row" IsVisible="{Binding IsMiniPlayerFrostSupported}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.MiniPlayerFrostedBackground}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.BlurDesktopBehindMiniPlayer}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.MiniPlayerFrostedBackground}"
                                          IsChecked="{Binding MiniPlayerFrostedBackground}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            </StackPanel>
            </Border>

            <Border Classes="setting-card group-card" Margin="0,14,0,10">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.NowPlayingArtwork}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HowCoverAppearsLyrics}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <RadioButton Grid.Column="0" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Settings.Cover}"
                                     GroupName="NowPlayingArtwork"
                                     IsChecked="{Binding IsArtworkStyleCover, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.AlbumCoverAsTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="3" Canvas.Top="3" Width="22" Height="22" RadiusX="5" RadiusY="5"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Cover}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Classes="transition-card medium-card"
                                     GroupName="NowPlayingArtwork"
                                     IsChecked="{Binding IsArtworkStyleCompactDisc, Mode=TwoWay}"
                                     AutomationProperties.Name="CD"
                                     ToolTip.Tip="{loc:T Settings.SpinningCompactDiscTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Ellipse Canvas.Left="2" Canvas.Top="2" Width="24" Height="24"
                                             Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="8"/>
                                </Canvas>
                                <TextBlock Text="CD" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="2" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Settings.Vinyl}"
                                     GroupName="NowPlayingArtwork"
                                     IsChecked="{Binding IsArtworkStyleVinyl, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.SleeveRecordPeekingOutTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Ellipse Canvas.Left="10" Canvas.Top="6" Width="16" Height="16"
                                             Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="5"/>
                                    <Rectangle Canvas.Left="2" Canvas.Top="5" Width="18" Height="18" RadiusX="3" RadiusY="3"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Vinyl}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="3" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Settings.Cassette}"
                                     GroupName="NowPlayingArtwork"
                                     IsChecked="{Binding IsArtworkStyleCassette, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.CassetteCoverItsLabelTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="2" Canvas.Top="6" Width="24" Height="16" RadiusX="4" RadiusY="4"
                                               Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="2.5"/>
                                    <Ellipse Canvas.Left="7" Canvas.Top="11.5" Width="5" Height="5"
                                             Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Ellipse Canvas.Left="16" Canvas.Top="11.5" Width="5" Height="5"
                                             Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Cassette}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <Border Classes="setting-card group-card" Margin="0,14,0,10">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.CoverFlowLayout}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HowCoverFlowPage}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <RadioButton Grid.Column="0" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Settings.Carousel}"
                                     GroupName="CoverFlowLayout"
                                     IsChecked="{Binding IsCoverFlowCarousel, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.ClassicRowPlayingCoverTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="1" Canvas.Top="9" Width="6" Height="10" RadiusX="1.5" RadiusY="1.5" Opacity="0.45"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="21" Canvas.Top="9" Width="6" Height="10" RadiusX="1.5" RadiusY="1.5" Opacity="0.45"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="8" Canvas.Top="5" Width="12" Height="18" RadiusX="2.5" RadiusY="2.5"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Carousel}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Settings.Cascade}"
                                     GroupName="CoverFlowLayout"
                                     IsChecked="{Binding IsCoverFlowCascade, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.TiltedCoversDiagonalPathTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="4" Canvas.Top="1" Width="9" Height="9" RadiusX="2" RadiusY="2" Opacity="0.45"
                                               RenderTransformOrigin="50%,50%" RenderTransform="rotate(-24deg)"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="4" Canvas.Top="18" Width="9" Height="9" RadiusX="2" RadiusY="2" Opacity="0.45"
                                               RenderTransformOrigin="50%,50%" RenderTransform="rotate(18deg)"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="11" Canvas.Top="7" Width="14" Height="14" RadiusX="3" RadiusY="3"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Cascade}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="2" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Settings.Collage}"
                                     GroupName="CoverFlowLayout"
                                     IsChecked="{Binding IsCoverFlowCollage, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.MosaicQueueSCoversTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="2" Canvas.Top="2" Width="11" Height="11" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="15" Canvas.Top="2" Width="11" Height="11" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="2" Canvas.Top="15" Width="11" Height="11" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="15" Canvas.Top="15" Width="11" Height="11" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Collage}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <!-- Owner 11-02: the Albums page's default design. The same AlbumViewMode /
                 AlbumCarouselStyle settings the Albums page View menu writes. Hidden while the
                 Album Carousel built-in feature is off (the grid is the only layout then). -->
            <Border Classes="setting-card group-card" Margin="0,14,0,10" IsVisible="{Binding AlbumCarouselEnabled}">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.AlbumsView}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.AlbumsViewDesc}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <RadioButton Grid.Column="0" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Main.AlbumGrid}"
                                     GroupName="AlbumsView"
                                     IsChecked="{Binding IsAlbumViewGrid, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Main.AlbumGrid}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="2" Canvas.Top="2" Width="11" Height="11" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="15" Canvas.Top="2" Width="11" Height="11" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="2" Canvas.Top="15" Width="11" Height="11" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="15" Canvas.Top="15" Width="11" Height="11" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Main.AlbumGrid}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Main.AlbumCarousel}"
                                     GroupName="AlbumsView"
                                     IsChecked="{Binding IsAlbumViewCarousel, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Main.AlbumCarousel}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="1" Canvas.Top="9" Width="6" Height="10" RadiusX="1.5" RadiusY="1.5" Opacity="0.45"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="21" Canvas.Top="9" Width="6" Height="10" RadiusX="1.5" RadiusY="1.5" Opacity="0.45"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="8" Canvas.Top="5" Width="12" Height="18" RadiusX="2.5" RadiusY="2.5"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Main.AlbumCarousel}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                    <TextBlock Text="{loc:T Settings.CarouselCase}" FontSize="12" Opacity="0.5"/>
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <RadioButton Grid.Column="0" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Main.CarouselCover}"
                                     GroupName="AlbumCarouselCase"
                                     IsChecked="{Binding IsAlbumCaseCover, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Main.CarouselCover}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="3" Canvas.Top="3" Width="22" Height="22" RadiusX="5" RadiusY="5"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Main.CarouselCover}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Main.CarouselJewelCase}"
                                     GroupName="AlbumCarouselCase"
                                     IsChecked="{Binding IsAlbumCaseJewelCase, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Main.CarouselJewelCase}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="2" Canvas.Top="4" Width="24" Height="20" RadiusX="2.5" RadiusY="2.5"
                                               Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="2.5"/>
                                    <Rectangle Canvas.Left="6" Canvas.Top="4" Width="2.5" Height="20"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="11" Canvas.Top="8" Width="12" Height="12" RadiusX="1.5" RadiusY="1.5"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Main.CarouselJewelCase}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="2" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Main.CarouselVinyl}"
                                     GroupName="AlbumCarouselCase"
                                     IsChecked="{Binding IsAlbumCaseVinyl, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Main.CarouselVinyl}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Ellipse Canvas.Left="10" Canvas.Top="6" Width="16" Height="16"
                                             Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="5"/>
                                    <Rectangle Canvas.Left="2" Canvas.Top="5" Width="18" Height="18" RadiusX="3" RadiusY="3"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Main.CarouselVinyl}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="3" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Main.CarouselCassette}"
                                     GroupName="AlbumCarouselCase"
                                     IsChecked="{Binding IsAlbumCaseCassette, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Main.CarouselCassette}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="2" Canvas.Top="6" Width="24" Height="16" RadiusX="4" RadiusY="4"
                                               Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="2.5"/>
                                    <Ellipse Canvas.Left="7" Canvas.Top="11.5" Width="5" Height="5"
                                             Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Ellipse Canvas.Left="16" Canvas.Top="11.5" Width="5" Height="5"
                                             Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Main.CarouselCassette}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <!-- GitHub #147: the Queue panel's rows and width. -->
            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Queue}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.QueueRows}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.QueueRowsHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*,*" RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="8" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Settings.QueueFirstLine}"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  AutomationProperties.Name="{loc:T Settings.QueueFirstLine}"
                                  Classes="pill-list"
                                  ItemsSource="{Binding QueueLine1Options}"
                                  SelectedItem="{Binding SelectedQueueLine1Option}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  CornerRadius="999"
                                  Padding="14,8"/>
                        <ComboBox Grid.Row="0" Grid.Column="2"
                                  AutomationProperties.Name="{loc:T Settings.QueueFirstLineExtra}"
                                  Classes="pill-list"
                                  ItemsSource="{Binding QueueOptionalFieldOptions}"
                                  SelectedItem="{Binding SelectedQueueLine1ExtraOption}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  CornerRadius="999"
                                  Padding="14,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T Settings.QueueSecondLine}"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  AutomationProperties.Name="{loc:T Settings.QueueSecondLine}"
                                  Classes="pill-list"
                                  ItemsSource="{Binding QueueOptionalFieldOptions}"
                                  SelectedItem="{Binding SelectedQueueLine2Option}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  CornerRadius="999"
                                  Padding="14,8"/>
                        <ComboBox Grid.Row="1" Grid.Column="2"
                                  AutomationProperties.Name="{loc:T Settings.QueueSecondLineExtra}"
                                  Classes="pill-list"
                                  ItemsSource="{Binding QueueOptionalFieldOptions}"
                                  SelectedItem="{Binding SelectedQueueLine2ExtraOption}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  CornerRadius="999"
                                  Padding="14,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T Settings.QueueRightSide}"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  AutomationProperties.Name="{loc:T Settings.QueueRightSide}"
                                  Classes="pill-list"
                                  ItemsSource="{Binding QueueRightOptions}"
                                  SelectedItem="{Binding SelectedQueueRightOption}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  CornerRadius="999"
                                  Padding="14,8"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.QueueWidth}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.QueueWidthHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.Narrower}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <controls:SmoothSlider Grid.Column="1"
                                AutomationProperties.Name="{loc:T Settings.QueueWidth}"
                                Classes="accent-slider"
                                Step="1" Minimum="300" Maximum="720"
                                x:Name="QueueWidthSlider"
                                SteppedValue="{Binding QueuePanelWidth, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{loc:T Settings.Wider}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding QueuePanelWidth, StringFormat='{}{0:0} px'}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center"
                                   MinWidth="52" TextAlignment="Right" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="LyricsTabPanel" Classes="tab-page" IsVisible="{Binding IsLyricsTabVisible}" Spacing="4">
            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.LyricsPage}" Margin="0,2,0,8"/>
            <!-- Style presets from content packs (only while an enabled pack provides some). -->
            <Border Classes="setting-card" IsVisible="{Binding HasLyricsPresets}" Margin="0,0,0,8">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.LyricsPresets.Title}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.LyricsPresets.Description}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding LyricsPresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LyricsPresetItem">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13"/>
                                        <TextBlock Text="{Binding ByLabel}" FontSize="11" Opacity="0.5"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="pill-action" Padding="12,6" CornerRadius="999" Cursor="Hand"
                                            AutomationProperties.Name="{loc:T Settings.LyricsPresets.Apply}"
                                            VerticalAlignment="Center"
                                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).ApplyLyricsPresetCommand}"
                                            CommandParameter="{Binding Key}">
                                        <TextBlock Text="{loc:T Settings.LyricsPresets.Apply}" FontSize="12"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding LyricsPresetStatus}" FontSize="12" Opacity="0.8"
                               IsVisible="{Binding LyricsPresetStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </Border>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <!-- Spacing-free: each knob block carries its own 12px gap inside the fold, so a
                     closing block doesn't snap the row by the panel's Spacing on its last frame. -->
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="{loc:T Settings.FlowingLyricsBackground}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.BlurredAlbumArtworkDrifts}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="200" VerticalAlignment="Center"
                                  AutomationProperties.Name="{loc:T Settings.FlowingLyricsBackground}"
                                  ItemsSource="{Binding FlowingOptions}"
                                  SelectedItem="{Binding SelectedFlowingOption, Mode=TwoWay}"/>
                    </Grid>
                    <!-- Drift knobs (GitHub #111): only while a Drift style is chosen. 100% everywhere
                         is the stock look; double-tap a slider to snap back to it. -->
                    <controls:CollapsibleContent IsOpen="{Binding IsDriftStyle}" Lift="6">
                    <StackPanel Spacing="8" Margin="0,12,0,0">
                        <Grid ColumnDefinitions="110,*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.DriftMovement}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                            <controls:SmoothSlider Grid.Column="1" Classes="accent-slider" Step="1" Minimum="0" Maximum="300"
                                    AutomationProperties.Name="{loc:T Settings.DriftMovement}"
                                    SteppedValue="{Binding LyricsDriftMovement, Mode=TwoWay}" VerticalAlignment="Center"
                                    DoubleTapped="OnDriftMovementSliderDoubleTapped"/>
                            <TextBlock Grid.Column="2" Text="{Binding LyricsDriftMovement, StringFormat='{}{0}%'}" FontSize="12" Opacity="0.7"
                                       VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="36" TextAlignment="Right"/>
                        </Grid>
                        <Grid ColumnDefinitions="110,*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.DriftSaturation}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                            <controls:SmoothSlider Grid.Column="1" Classes="accent-slider" Step="1" Minimum="0" Maximum="200"
                                    AutomationProperties.Name="{loc:T Settings.DriftSaturation}"
                                    SteppedValue="{Binding LyricsDriftSaturation, Mode=TwoWay}" VerticalAlignment="Center"
                                    DoubleTapped="OnDriftSaturationSliderDoubleTapped"/>
                            <TextBlock Grid.Column="2" Text="{Binding LyricsDriftSaturation, StringFormat='{}{0}%'}" FontSize="12" Opacity="0.7"
                                       VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="36" TextAlignment="Right"/>
                        </Grid>
                        <Grid ColumnDefinitions="110,*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.DriftBlur}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                            <controls:SmoothSlider Grid.Column="1" Classes="accent-slider" Step="1" Minimum="0" Maximum="200"
                                    AutomationProperties.Name="{loc:T Settings.DriftBlur}"
                                    SteppedValue="{Binding LyricsDriftBlur, Mode=TwoWay}" VerticalAlignment="Center"
                                    DoubleTapped="OnDriftBlurSliderDoubleTapped"/>
                            <TextBlock Grid.Column="2" Text="{Binding LyricsDriftBlur, StringFormat='{}{0}%'}" FontSize="12" Opacity="0.7"
                                       VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="36" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                    </controls:CollapsibleContent>
                    <!-- Kawarp knobs (GitHub #58): only while a Kawarp style is chosen. -->
                    <controls:CollapsibleContent IsOpen="{Binding IsKawarpStyle}" Lift="6">
                    <StackPanel Spacing="8" Margin="0,12,0,0">
                        <Grid ColumnDefinitions="110,*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.KawarpWarp}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                            <controls:SmoothSlider Grid.Column="1" Classes="accent-slider" Step="0.1" Minimum="0" Maximum="3"
                                    AutomationProperties.Name="{loc:T Settings.KawarpWarp}"
                                    SteppedValue="{Binding LyricsKawarpWarp, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding LyricsKawarpWarp, StringFormat='{}{0:0.0}'}" FontSize="12" Opacity="0.7"
                                       VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="28" TextAlignment="Right"/>
                        </Grid>
                        <Grid ColumnDefinitions="110,*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.KawarpBlur}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                            <controls:SmoothSlider Grid.Column="1" Classes="accent-slider" Step="1" Minimum="1" Maximum="16"
                                    AutomationProperties.Name="{loc:T Settings.KawarpBlur}"
                                    SteppedValue="{Binding LyricsKawarpBlur, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding LyricsKawarpBlur}" FontSize="12" Opacity="0.7"
                                       VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="28" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                    </controls:CollapsibleContent>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.AudioVisualizer}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.DrawLiveSpectrumMusic}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.AudioVisualizer}"
                                              IsChecked="{Binding LyricsVisualizerEnabled}"
                                              IsEnabled="{Binding VisualizerEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Artwork colour row + style picker share a spacing-free panel so the 12px gap folds
                         with the body (see the Crossfade block). -->
                    <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.ArtworkColour}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.TintBarsCurrentCover}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.ArtworkColour}"
                                              IsChecked="{Binding LyricsVisualizerArtworkColor}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <controls:CollapsibleContent IsOpen="{Binding LyricsVisualizerEnabled}" Lift="10" Motion="Glide">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,12,0,0">
                        <RadioButton Grid.Column="0" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Settings.Bars}"
                                     GroupName="LyricsVisualizerStyle"
                                     IsChecked="{Binding IsVisualizerStyleBars, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.FrequencyBarsRisingFromTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="2" Canvas.Top="16" Width="4" Height="10" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="8" Canvas.Top="6" Width="4" Height="20" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="14" Canvas.Top="11" Width="4" Height="15" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="20" Canvas.Top="2" Width="4" Height="24" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Bars}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Settings.Mirror}"
                                     GroupName="LyricsVisualizerStyle"
                                     IsChecked="{Binding IsVisualizerStyleMirror, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.BarsMirroredAboutCentreTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="2" Canvas.Top="10" Width="4" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="8" Canvas.Top="4" Width="4" Height="20" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="14" Canvas.Top="7" Width="4" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="20" Canvas.Top="2" Width="4" Height="24" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Mirror}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="2" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Settings.Wave}"
                                     GroupName="LyricsVisualizerStyle"
                                     IsChecked="{Binding IsVisualizerStyleWave, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.SmoothFilledCurveTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Path Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                          Data="M2,26 L2,18 C6,16 8,6 12,8 C16,10 18,20 22,12 L26,10 L26,26 Z"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Wave}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                    </controls:CollapsibleContent>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.FullscreenLyricsFocus}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.DimAllButCurrent}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.FullscreenLyricsFocus}"
                                          IsChecked="{Binding LyricsFullScreenFocusEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- Minimum line opacity: floors the lyrics page's distance ramp so every line
                 stays visible and clickable (jump anywhere in the song from its lyrics). -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,200,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.LyricsMinLineOpacity}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.LyricsMinLineOpacityHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:SmoothSlider x:Name="LyricsMinLineOpacitySlider" Grid.Column="1" Classes="accent-slider" Step="1" Minimum="0" Maximum="60"
                            AutomationProperties.Name="{loc:T Settings.LyricsMinLineOpacity}"
                            SteppedValue="{Binding LyricsMinLineOpacity, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0"
                            DoubleTapped="OnLyricsMinLineOpacitySliderDoubleTapped"/>
                    <TextBlock Grid.Column="2" Text="{Binding LyricsMinLineOpacity, StringFormat='{}{0}%'}" FontSize="12" Opacity="0.7"
                               VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="36" TextAlignment="Right"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.JoinSplitWords}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.KeepWordsWholeWhen}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.JoinSplitWords}"
                                          IsChecked="{Binding LyricsJoinSplitWords}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- Apple Music word motion (sung words float up, held notes glow). -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.LyricsGlowAndLift}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.LyricsGlowAndLiftHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.LyricsGlowAndLift}"
                                          IsChecked="{Binding LyricsGlowAndLift}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- Discord request: songs with no lyrics (or instrumentals) centre the player
                 on the lyrics page instead of leaving the lyrics side empty. -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.LyricsCenterWhenNoLyrics}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.LyricsCenterWhenNoLyricsHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.LyricsCenterWhenNoLyrics}"
                                          IsChecked="{Binding LyricsCenterWhenNoLyrics}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- GitHub #184: the page's background reaches under the sidebar rail (off by default). -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.LyricsBackgroundBehindSidebar}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.LyricsBackgroundBehindSidebarHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.LyricsBackgroundBehindSidebar}"
                                          IsChecked="{Binding LyricsBackgroundBehindSidebar}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- GitHub #181: the lyrics page's progress bar draws the song's waveform (off by default). -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.LyricsWaveformSeekBar}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.LyricsWaveformSeekBarHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.LyricsWaveformSeekBar}"
                                          IsChecked="{Binding LyricsWaveformSeekBarEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- Lyric layers (issue #78): display-only, the lyrics are not reloaded. -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.ShowTranslations}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ShowTranslationsHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.ShowTranslations}"
                                          IsChecked="{Binding LyricsShowTranslations}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.ShowRomanization}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ShowRomanizationHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.ShowRomanization}"
                                          IsChecked="{Binding LyricsShowRomanization}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.ShowBackgroundVocals}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ShowBackgroundVocalsHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.ShowBackgroundVocals}"
                                          IsChecked="{Binding LyricsShowBackgroundVocals}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.OnlineLyrics}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:T Settings.UseOnlineLyricsWhen}"
                               FontSize="12" Opacity="0.5" Margin="0,0,0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.LRCLIB}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.CommunityLyricsDatabase}" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.LRCLIB}"
                                              IsChecked="{Binding LrcLibEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.NetEaseCloudMusic}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.LargeSyncedLyricsCatalog}" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.NetEaseCloudMusic}"
                                              IsChecked="{Binding NetEaseEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.Musixmatch}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.MusixmatchHint}" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.Musixmatch}"
                                              IsChecked="{Binding MusixmatchEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.LrcRed}" FontSize="13" FontWeight="SemiBold"/>
                            <!-- Wraps: it also says the model can word-sync from the lyrics page. -->
                            <TextBlock Text="{loc:T Settings.LrcRedHint}" FontSize="11" Opacity="0.5"
                                       TextWrapping="Wrap" Margin="0,0,12,0"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.LrcRed}"
                                              IsChecked="{Binding LrcRedEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.Unison}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.UnisonHint}" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.Unison}"
                                              IsChecked="{Binding UnisonEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.Kugou}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.KugouHint}" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.Kugou}"
                                              IsChecked="{Binding KugouEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.YouTubeMusicLyrics}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.YouTubeMusicLyricsHint}" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.YouTubeMusicLyrics}"
                                              IsChecked="{Binding YouTubeMusicLyricsEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{loc:T Settings.LyricsSourcesPickerHint}"
                               FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <!-- GitHub #135: where saved lyrics go, and the automatic download. -->
            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.SavingLyrics}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                        <TextBlock Text="{loc:T Settings.LyricsSaveTarget}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.LyricsSaveTargetHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              AutomationProperties.Name="{loc:T Settings.LyricsSaveTarget}"
                              Classes="pill-list"
                              ItemsSource="{Binding LyricsSaveTargetOptions}"
                              SelectedItem="{Binding SelectedLyricsSaveTargetOption}"
                              MinWidth="200"
                              VerticalAlignment="Center"
                              CornerRadius="999"
                              Padding="14,8"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.LyricsAutoDownload}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.LyricsAutoDownloadHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.LyricsAutoDownload}"
                                          IsChecked="{Binding LyricsAutoDownload}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                        <TextBlock Text="{loc:T Settings.LyricsPreferredType}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.LyricsPreferredTypeHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              AutomationProperties.Name="{loc:T Settings.LyricsPreferredType}"
                              Classes="pill-list"
                              ItemsSource="{Binding LyricsPreferredTypeOptions}"
                              SelectedItem="{Binding SelectedLyricsPreferredTypeOption}"
                              MinWidth="200"
                              VerticalAlignment="Center"
                              CornerRadius="999"
                              Padding="14,8"/>
                </Grid>
            </Border>
            </StackPanel>
            </Border>

            </StackPanel>

            <StackPanel x:Name="ShortcutsTabPanel" Classes="tab-page" IsVisible="{Binding IsShortcutsTabVisible}" Spacing="4">
                <Border Classes="setting-card">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.KeyboardShortcuts}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.ClickKeyChangePress}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{loc:T Settings.ResetAll}"
                                FontSize="12" FontWeight="SemiBold"
                                Padding="14,7"
                                CornerRadius="999"
                                BorderThickness="0"
                                Background="{DynamicResource SystemControlBackgroundListMediumBrush}"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0"
                                Command="{Binding Shortcuts.ResetAllCommand}"/>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Shortcuts.Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShortcutGroup">
                            <Border Classes="setting-card">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="12"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ShortcutRowViewModel">
                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13" VerticalAlignment="Center"/>
                                                    <controls:ShortcutKeyChip Grid.Column="1" VerticalAlignment="Center"/>
                                                    <!-- Per-row reset, only once the row differs from its default. -->
                                                    <Button Grid.Column="2"
                                                            Width="26" Height="26"
                                                            Margin="6,0,0,0"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            CornerRadius="999"
                                                            Cursor="Hand"
                                                            ToolTip.Tip="{loc:T Settings.ResetDefaultTip}"
                                                            IsVisible="{Binding !IsDefault}"
                                                            Command="{Binding ResetCommand}">
                                                        <!-- Stroked like the Plugins refresh button: an open arc in a
                                                             PathIcon is filled, which drew a solid blob. -->
                                                        <Viewbox Width="13" Height="13" Opacity="0.7">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="{StaticResource PluginsRefreshGlyph}" Stroke="{Binding $parent[Button].Foreground}"
                                                                      StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- STATISTICS (listening statistics)                   -->
            <!-- ═══════════════════════════════════════════════════ -->

            <StackPanel x:Name="AudioTabPanel" Classes="tab-page" IsVisible="{Binding IsAudioTabVisible}" Spacing="4">
            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Playback}" Margin="0,2,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row"
                    IsEnabled="{Binding CanUseSongTransitions}"
                    Opacity="{Binding SongTransitionsOpacity}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.SongTransitions}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.SongsBlendSmoothlyInto}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                            <controls:CollapsibleContent IsOpen="{Binding ExclusiveAudioEnabled}" Lift="6">
                                <TextBlock Text="{loc:T Settings.UnavailableWhileExclusiveMode}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentColorBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </controls:CollapsibleContent>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.SongTransitions}"
                                              IsChecked="{Binding SongTransitionsEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Transition Style picker -->
                    <StackPanel Spacing="6" IsEnabled="{Binding SongTransitionsEnabled}">
                        <TextBlock Text="{loc:T Settings.TRANSITIONSTYLE}" FontSize="10" Opacity="0.45" Margin="2,4,0,2"/>

                        <RadioButton Classes="transition-card"
                                     AutomationProperties.Name="{loc:T Settings.AutoMix}"
                                     GroupName="TransitionStyle"
                                     IsChecked="{Binding IsAutoMixStyle, Mode=TwoWay}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings.AutoMix}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:T Settings.TransitionsTimedUsingEach}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Card + its duration block share a spacing-free panel: StackPanel Spacing is paid per
                             VISIBLE child and vanishes in one go when the shut block turns invisible, which
                             snapped everything below up 6px on the fold's last frame. The gap lives on the
                             body's margin instead, inside the animated height (same recipe as Home). -->
                        <StackPanel>
                        <RadioButton Classes="transition-card"
                                     AutomationProperties.Name="{loc:T Settings.Crossfade}"
                                     GroupName="TransitionStyle"
                                     IsChecked="{Binding IsCrossfadeStyle, Mode=TwoWay}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings.Crossfade}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:T Settings.SimpleFadeBetweenSongs}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Crossfade Duration (only for the Crossfade style): slides open under the card.
                             Glide motion, unlike every other collapsible here, so the new reveal can be
                             judged side by side against the plain fold. -->
                        <controls:CollapsibleContent IsOpen="{Binding IsCrossfadeStyle}" Lift="10" Motion="Glide">
                        <StackPanel Classes="sub-setting" Spacing="6" Margin="2,10,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{loc:T Settings.CrossfadeDuration}" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <!-- Quick presets; the slider below still allows any 1–12 s. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button Classes="preset-chip" Classes.selected="{Binding IsCrossfade3s}"
                                            Content="3s" Command="{Binding SetCrossfadePresetCommand}" CommandParameter="3"/>
                                    <Button Classes="preset-chip" Classes.selected="{Binding IsCrossfade6s}"
                                            Content="6s" Command="{Binding SetCrossfadePresetCommand}" CommandParameter="6"/>
                                    <Button Classes="preset-chip" Classes.selected="{Binding IsCrossfade10s}"
                                            Content="{loc:T Settings.10s}" Command="{Binding SetCrossfadePresetCommand}" CommandParameter="10"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Slider Grid.Column="0"
                                        AutomationProperties.Name="{loc:T Settings.CrossfadeDuration}"
                                        Classes="accent-slider"
                                        Minimum="1" Maximum="12"
                                        Value="{Binding CrossfadeDuration, Mode=TwoWay}"
                                        DoubleTapped="OnCrossfadeSliderDoubleTapped"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CrossfadeDuration, StringFormat='{}{0:0} seconds'}"
                                           FontSize="12" Opacity="0.7"
                                           VerticalAlignment="Center"
                                           MinWidth="74" TextAlignment="Right" Margin="12,0,0,0"/>
                            </Grid>
                        </StackPanel>
                        </controls:CollapsibleContent>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.SoundCheck}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.KeepSongVolumeAt}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.SoundCheck}"
                                          IsChecked="{Binding SoundCheckEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.GaplessPlayback}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.TracksFlowIntoEach}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.GaplessPlayback}"
                                          IsChecked="{Binding GaplessPlaybackEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- GitHub #73: the level fades out before a pause lands and back in after a resume. -->
            <Border Classes="setting-row">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.PlayPauseFade}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.PlayPauseFadeHint}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.PlayPauseFade}"
                                              IsChecked="{Binding PlayPauseFadeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <controls:CollapsibleContent IsOpen="{Binding PlayPauseFadeEnabled}" Lift="10">
                        <StackPanel Classes="sub-setting" Spacing="6" Margin="2,10,0,0">
                            <TextBlock Text="{loc:T Settings.FadeDuration}" FontSize="13" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <controls:SmoothSlider Grid.Column="0"
                                        AutomationProperties.Name="{loc:T Settings.FadeDuration}"
                                        Classes="accent-slider" Step="50"
                                        Minimum="100" Maximum="2000"
                                        SteppedValue="{Binding PlayPauseFadeMs, Mode=TwoWay}"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding PlayPauseFadeMs, StringFormat='{}{0:0} ms'}"
                                           FontSize="12" Opacity="0.7"
                                           VerticalAlignment="Center"
                                           MinWidth="74" TextAlignment="Right" Margin="12,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </controls:CollapsibleContent>
                </StackPanel>
            </Border>
            <!-- GitHub #101: how much of a song has to be heard before it counts as played. -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.PlayCountAfter}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.PlayCountAfterHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              AutomationProperties.Name="{loc:T Settings.PlayCountAfter}"
                              Classes="pill-list"
                              ItemsSource="{Binding PlayCountThresholdOptions}"
                              SelectedItem="{Binding SelectedPlayCountThresholdOption}"
                              MinWidth="140"
                              VerticalAlignment="Center"
                              CornerRadius="999"
                              Padding="14,8"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.Autoplay}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.WhenQueueEndsKeep}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.Autoplay}"
                                          IsChecked="{Binding AutoplayEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- GitHub #124: list played songs in the queue and keep the last one loaded. -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.KeepPlayedInQueue}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.KeepPlayedInQueueHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.KeepPlayedInQueue}"
                                          IsChecked="{Binding KeepPlayedInQueue}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- GitHub #154: what a queued song whose file is gone does when playback passes it. -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.MissingSongs}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.MissingSongsHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              AutomationProperties.Name="{loc:T Settings.MissingSongs}"
                              Classes="pill-list"
                              ItemsSource="{Binding MissingSongsOptions}"
                              SelectedItem="{Binding SelectedMissingSongsOption}"
                              MinWidth="140"
                              VerticalAlignment="Center"
                              CornerRadius="999"
                              Padding="14,8"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.ExplicitContent}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.AllowExplicitSongsWhen}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.ExplicitContent}"
                                          IsChecked="{Binding AllowExplicitContent}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Output}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row" IsVisible="{Binding IsExclusiveAudioSupported}">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.OutputDevice}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.OutputDeviceDesc}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox x:Name="OutputDeviceCombo"
                                  Grid.Column="1"
                                  AutomationProperties.Name="{loc:T Settings.OutputDevice}"
                                  Classes="pill-list"
                                  ItemsSource="{Binding OutputDeviceOptions}"
                                  SelectedItem="{Binding SelectedOutputDevice}"
                                  MinWidth="260"
                                  VerticalAlignment="Center"
                                  CornerRadius="999"
                                  Padding="14,8"/>
                    </Grid>
                    <controls:CollapsibleContent IsOpen="{Binding OutputDeviceMissing}" Lift="6">
                        <TextBlock Text="{loc:T Settings.OutputDeviceMissingHint}"
                                   FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                    </controls:CollapsibleContent>
                </StackPanel>
            </Border>
            <Border Classes="setting-row" IsVisible="{Binding IsExclusiveAudioSupported}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.ExclusiveMode}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.BitPerfectOutputBypasses}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        <controls:CollapsibleContent IsOpen="{Binding ExclusiveAudioStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Lift="6">
                            <TextBlock Text="{Binding ExclusiveAudioStatus}"
                                       FontSize="12" Opacity="0.8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </controls:CollapsibleContent>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.ExclusiveMode}"
                                          IsChecked="{Binding ExclusiveAudioEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row" IsVisible="{Binding IsUpmixSupported}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Upmix.Title}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Upmix.Description}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <RadioButton Grid.Column="0" Classes="transition-card medium-card" GroupName="UpmixMode"
                                     AutomationProperties.Name="{loc:T Upmix.Off}"
                                     IsChecked="{Binding IsUpmixOff, Mode=TwoWay}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Upmix.Off}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:T Upmix.OffHint}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Classes="transition-card medium-card" GroupName="UpmixMode"
                                     AutomationProperties.Name="{loc:T Upmix.Duplicate}"
                                     IsChecked="{Binding IsUpmixDuplicate, Mode=TwoWay}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Upmix.Duplicate}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:T Upmix.DuplicateHint}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="2" Classes="transition-card medium-card" GroupName="UpmixMode"
                                     AutomationProperties.Name="{loc:T Upmix.Surround}"
                                     IsChecked="{Binding IsUpmixSurround, Mode=TwoWay}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Upmix.Surround}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:T Upmix.SurroundHint}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                    <TextBlock Text="{loc:T Upmix.Note}" FontSize="11" Opacity="0.45" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Classes="setting-row" IsVisible="{Binding IsHeadphoneSurroundSupported}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.HeadphoneSurround}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HeadphoneSurroundDesc}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        <controls:CollapsibleContent IsOpen="{Binding HeadphoneSurroundNeedsRestart}" Lift="6">
                            <TextBlock Text="{loc:T Settings.HeadphoneSurroundRestart}"
                                       FontSize="12" Opacity="0.8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </controls:CollapsibleContent>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.HeadphoneSurround}"
                                          IsChecked="{Binding HeadphoneSurround}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- Accessibility: Mono Audio and Balance, applied in the output's sample stage
                 (ChannelMixProvider). Bypassed in bit-perfect Exclusive Mode. -->
            <Border Classes="setting-row" IsVisible="{Binding IsChannelMixSupported}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding IsChannelMixEnabled}">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.MonoAudio}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.MonoAudioDesc}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.MonoAudio}"
                                              IsChecked="{Binding MonoAudio}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Spacing="6" IsEnabled="{Binding IsChannelMixEnabled}">
                        <TextBlock Text="{loc:T Settings.Balance}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.BalanceDesc}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <controls:SmoothSlider x:Name="AudioBalanceSlider" Grid.Column="0"
                                    AutomationProperties.Name="{loc:T Settings.Balance}"
                                    Classes="accent-slider" Step="1"
                                    Minimum="-100" Maximum="100"
                                    SteppedValue="{Binding AudioBalance, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AudioBalanceLabel}"
                                       FontSize="12" Opacity="0.7"
                                       VerticalAlignment="Center"
                                       MinWidth="74" TextAlignment="Right" Margin="12,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <controls:CollapsibleContent IsOpen="{Binding ChannelMixNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Lift="6">
                        <TextBlock Text="{Binding ChannelMixNote}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentColorBrush}"
                                   TextWrapping="Wrap"/>
                    </controls:CollapsibleContent>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.ReplayGain}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.AdjustVolumeUsingReplayGain}"
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.ReplayGain}"
                                              IsChecked="{Binding ReplayGainEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Classes="sub-setting" ColumnDefinitions="120,*" IsEnabled="{Binding ReplayGainEnabled}">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.Mode}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{loc:T Settings.Mode}"
                                  Classes="pill-list"
                                  ItemsSource="{Binding ReplayGainModeOptions}"
                                  SelectedItem="{Binding ReplayGainMode}"
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="999"
                                  Padding="14,8"/>
                    </Grid>
                    <Grid Classes="sub-setting" ColumnDefinitions="120,*,Auto" IsEnabled="{Binding ReplayGainEnabled}">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.PreAmpDB}" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" Height="20" ClipToBounds="False"
                              VerticalAlignment="Center" Margin="0,0,12,0">
                            <Canvas x:Name="PreampVisual"
                                    Height="20"
                                    ClipToBounds="False"
                                    IsHitTestVisible="False">
                                <Border x:Name="PreampTrackBackground"
                                        Height="6"
                                        CornerRadius="3"
                                        Background="{DynamicResource IslandSliderUnfilled}"
                                        Opacity="0.4"
                                        Canvas.Top="7"/>
                                <Border x:Name="PreampTrackFill"
                                        Height="6"
                                        CornerRadius="3"
                                        Background="{DynamicResource IslandSliderFilled}"
                                        Canvas.Top="7"/>
                                <Border x:Name="PreampThumb"
                                        Width="14"
                                        Height="14"
                                        CornerRadius="7"
                                        Background="{DynamicResource IslandSliderFilled}"
                                        BoxShadow="0 1 3 0 #40000000"
                                        Canvas.Top="3"/>
                            </Canvas>
                            <Slider x:Name="PreampSlider"
                                    AutomationProperties.Name="{loc:T Settings.PreAmpDB}"
                                    Classes="preamp-horizontal"
                                    Value="{Binding ReplayGainPreampDb, Mode=TwoWay}"
                                    Minimum="-12" Maximum="12"
                                    HorizontalAlignment="Stretch"
                                    DoubleTapped="OnPreampSliderDoubleTapped" />
                        </Grid>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ReplayGainPreampDb, StringFormat='{}{0:+0.0;-0.0;0.0} dB'}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" MinWidth="60"/>
                    </Grid>
                    <!-- GitHub #148: tagging new files works whether or not playback applies
                         ReplayGain, so this row is not tied to the toggle above. -->
                    <Grid Classes="sub-setting" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.ScanNewFilesReplayGain}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.ScanNewFilesReplayGainDesc}"
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.ScanNewFilesReplayGain}"
                                              IsChecked="{Binding AutoReplayGainScanEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <Border Classes="setting-card group-card" Margin="0,14,0,10">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.AnalyzeTempoKey}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.DetectBPMKeyAutoMix}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.AnalyzeTempoKey}"
                                              IsChecked="{Binding BpmKeyAnalysisEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Classes="sub-setting" ColumnDefinitions="*,Auto" IsEnabled="{Binding BpmKeyAnalysisEnabled}">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.SaveAnalysisFileTags}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.WriteBPMKeyInto}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.SaveAnalysisFileTags}"
                                              IsChecked="{Binding WriteAnalysisToTags}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <Border Classes="setting-card" Padding="22,16,38,16" ClipToBounds="False" Margin="0,14,0,10">
                <StackPanel Spacing="16">
                    <!-- Header row: title + master switch (GitHub #94). Off bypasses the EQ but
                         keeps every value below, so switching back on restores the same curve. -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings.Equalizer}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:T Settings.ParametricEQTuneEach}"
                                           FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.Equalizer}"
                                              IsChecked="{Binding EqualizerEnabled}"
                                              ToolTip.Tip="{loc:T Settings.EqualizerOnOffTip}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Everything below greys out (values kept) while the EQ is off. -->
                    <StackPanel Spacing="16"
                                IsEnabled="{Binding EqualizerEnabled}"
                                Opacity="{Binding EqualizerControlsOpacity}">
                    <!-- Preset row (GitHub #95): selector, save / delete / restore, reset.
                         Wraps rather than overflowing on a narrow Settings pane. -->
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                        <ComboBox x:Name="EqPresetCombo"
                                  AutomationProperties.Name="{loc:T Settings.EqPreset}"
                                  Classes="pill-combo stable-popup"
                                  Width="164"
                                  ItemsSource="{Binding VisibleEqPresets}"
                                  SelectedItem="{Binding SelectedEqPresetName}"
                                  VerticalAlignment="Center" />
                        <Button x:Name="EqSavePresetButton"
                                AutomationProperties.Name="{loc:T Settings.SaveEqPreset}"
                                Classes="pill-action"
                                CornerRadius="999"
                                Padding="14,8"
                                Cursor="Hand"
                                ToolTip.Tip="{loc:T Settings.SaveEqPresetTip}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.SaveEqPreset}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button.Flyout>
                                <!-- One row: pill name box + Save. Fades/scales in and out like
                                     the custom theme editor (code-behind). -->
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel x:Name="EqPresetFlyoutBody" Spacing="6" Width="280">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox Text="{Binding NewEqPresetName}"
                                                     AutomationProperties.Name="{loc:T Settings.EqPresetName}"
                                                     MaxLength="40"
                                                     CornerRadius="999"
                                                     Padding="14,7"
                                                     VerticalContentAlignment="Center"
                                                     Watermark="{loc:T Settings.EqPresetName}"
                                                     AttachedToVisualTree="OnEqPresetNameBoxAttached"
                                                     KeyDown="OnEqPresetNameKeyDown"/>
                                            <Button Grid.Column="1"
                                                    AutomationProperties.Name="{loc:T Settings.SaveEqPreset}"
                                                    Classes="pill-action"
                                                    CornerRadius="999"
                                                    Padding="16,7"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center"
                                                    Click="OnEqSavePresetClick">
                                                <TextBlock Text="{loc:T Settings.SaveEqPreset}" FontSize="13" FontWeight="SemiBold"/>
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{Binding EqPresetSaveError}"
                                                   IsVisible="{Binding EqPresetSaveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   Margin="14,0,0,0"
                                                   FontSize="11" Foreground="#FF6B6B" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="pill-action"
                                AutomationProperties.Name="{loc:T Settings.DeleteEqPreset}"
                                Command="{Binding DeleteSelectedEqPresetCommand}"
                                IsEnabled="{Binding CanDeleteSelectedEqPreset}"
                                CornerRadius="999"
                                Padding="14,8"
                                Cursor="Hand"
                                ToolTip.Tip="{loc:T Settings.DeleteEqPresetTip}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.DeleteEqPreset}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Button>
                        <!-- Only while a built-in has been deleted (hidden). -->
                        <Button Classes="pill-action"
                                AutomationProperties.Name="{loc:T Settings.RestoreEqPresets}"
                                Command="{Binding RestoreBuiltInEqPresetsCommand}"
                                IsVisible="{Binding HasHiddenEqPresets}"
                                CornerRadius="999"
                                Padding="14,8"
                                Cursor="Hand"
                                ToolTip.Tip="{loc:T Settings.RestoreEqPresetsTip}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.RestoreEqPresets}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Button>
                        <Button Classes="pill-action"
                                AutomationProperties.Name="{loc:T Settings.Reset}"
                                Command="{Binding ResetEqualizerCommand}"
                                CornerRadius="999"
                                Padding="14,8"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.Reset}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Button>
                    </WrapPanel>

                    <!-- Pre-amp: level relative to native, applied before the curve.
                         Negative values create the headroom that keeps boosted bands
                         from clipping — the post-mix volume slider cannot. -->
                    <Grid ColumnDefinitions="120,*,64,92,34" Margin="0,2,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="{loc:T Settings.Preamp}"
                                   FontSize="12" FontWeight="SemiBold" Opacity="0.85"
                                   VerticalAlignment="Center"/>
                        <Slider Grid.Column="1"
                                AutomationProperties.Name="{loc:T Settings.Preamp}"
                                Classes="accent-slider"
                                Minimum="-12" Maximum="6"
                                Value="{Binding EqPreampDb}"
                                DoubleTapped="OnEqPreampSliderDoubleTapped"
                                ToolTip.Tip="{loc:T Settings.LevelBeforeEQLowerTip}"
                                Margin="14,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding EqPreampDb, StringFormat='{}{0:+0.0;-0.0;0.0} dB'}"
                                   FontSize="11" Opacity="0.7"
                                   VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>

                    <!-- Parametric band rows: frequency / gain / Q per band -->
                    <StackPanel Spacing="0" Margin="0,4,0,0">
                        <Grid ColumnDefinitions="120,*,64,92,34" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.FREQUENCY}" FontSize="10" Opacity="0.45"/>
                            <TextBlock Grid.Column="1" Text="{loc:T Settings.GAIN}" FontSize="10" Opacity="0.45" Margin="14,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="Q" FontSize="10" Opacity="0.45" Margin="10,0,0,0" HorizontalAlignment="Center"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding EqBands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EqBandViewModel">
                                    <Grid ColumnDefinitions="120,*,64,92,34" Margin="0,3">
                                        <NumericUpDown Grid.Column="0"
                                                       AutomationProperties.Name="{loc:T Settings.FREQUENCY}"
                                                       Classes="eq-pill-number"
                                                       Value="{Binding FrequencyHz}"
                                                       Minimum="20" Maximum="20000" Increment="10"
                                                       FormatString="0"
                                                       FontSize="12"
                                                       ToolTip.Tip="{loc:T Settings.CenterFrequencyHzTypeTip}"
                                                       VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1"
                                                AutomationProperties.Name="{loc:T Settings.GAIN}"
                                                Classes="accent-slider"
                                                Minimum="-12" Maximum="12"
                                                Value="{Binding GainDb}"
                                                DoubleTapped="OnEqGainSliderDoubleTapped"
                                                Margin="14,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding GainLabel}"
                                                   FontSize="11" Opacity="0.7"
                                                   VerticalAlignment="Center" TextAlignment="Right"/>
                                        <NumericUpDown Grid.Column="3"
                                                       AutomationProperties.Name="Q"
                                                       Classes="eq-pill-number"
                                                       Value="{Binding Q}"
                                                       Minimum="0.1" Maximum="10" Increment="0.1"
                                                       FormatString="0.0#"
                                                       FontSize="12"
                                                       ToolTip.Tip="{loc:T Settings.QBandWidthHigherTip}"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <Button Grid.Column="4" Classes="eq-remove"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                IsEnabled="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).CanRemoveEqBand}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveEqBandCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{loc:T Settings.RemoveBandTip}">
                                            <controls:LineIcon Data="{StaticResource MenuLineClose}" Width="20" Height="20" Margin="-5" StrokeThickness="2.1"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="pill-action"
                                AutomationProperties.Name="{loc:T Settings.AddBand}"
                                Command="{Binding AddEqBandCommand}"
                                IsEnabled="{Binding CanAddEqBand}"
                                CornerRadius="999"
                                Padding="14,8"
                                Margin="0,8,0,0"
                                Cursor="Hand"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{loc:T Settings.AddBand}" FontSize="13" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="LibraryTabPanel" Classes="tab-page" IsVisible="{Binding IsLibraryTabVisible}" Spacing="4">
            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Folders}" Margin="0,2,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{loc:T Settings.MediaFolderLocations}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:T Settings.FoldersWhereMusicStored}"
                                           FontSize="12" Opacity="0.5"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1"
                                AutomationProperties.Name="{loc:T Settings.AddFolder}"
                                x:Name="AddFolderButton"
                                Command="{Binding AddMusicFolderCommand}"
                                Classes="pill-action"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.AddFolder}" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Folder list -->
                    <ItemsControl ItemsSource="{Binding MusicFolders}">
                        <ItemsControl.Styles>
                            <Style Selector="ItemsControl:empty">
                                <Setter Property="IsVisible" Value="False"/>
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <Border Padding="14,8" Margin="0,2" CornerRadius="12"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1"
                                                Content="{loc:T Settings.Text}"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveFolderCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="14"
                                                Opacity="0.5"
                                                Cursor="Hand"
                                                Padding="4"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- Folders hidden from the library in the Folders view (right-click a folder →
                 Hide from Library). Only shown while there is at least one. -->
            <Border Classes="setting-row" IsVisible="{Binding HasHiddenLibraryFolders}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.HiddenFolders}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HiddenFoldersHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding HiddenLibraryFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <Border Padding="14,8" Margin="0,2" CornerRadius="12"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1"
                                                AutomationProperties.Name="{loc:T Settings.ShowHiddenFolder}"
                                                Classes="pill-action"
                                                Padding="12,4"
                                                CornerRadius="999"
                                                Cursor="Hand"
                                                Margin="12,0,0,0"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).ShowHiddenFolderCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{loc:T Settings.ShowHiddenFolder}" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- GitHub #71: off = dropped files play / queue from where they are, nothing is
                 moved into Noctis Imports or added to the library. -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{loc:T Settings.ImportDroppedFiles}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ImportDroppedFilesHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.ImportDroppedFiles}"
                                          IsChecked="{Binding ImportDroppedMedia}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- GitHub #74: playlist page furniture, each opt-out. -->
            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.PlaylistPage}" Margin="0,16,0,8"/>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{loc:T Settings.PlaylistAlbumHeaders}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.PlaylistAlbumHeadersHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.PlaylistAlbumHeaders}"
                                          IsChecked="{Binding PlaylistShowAlbumHeaders}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{loc:T Settings.PlaylistNewBadge}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.PlaylistNewBadgeHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.PlaylistNewBadge}"
                                          IsChecked="{Binding PlaylistShowNewBadge}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- Discord (DendyAly 11-02): the Featured Artists / Suggested rail; also in the page's options menu. -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{loc:T Settings.PlaylistSideRail}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.PlaylistSideRailHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1" x:Name="PlaylistSideRailToggle"
                                          AutomationProperties.Name="{loc:T Settings.PlaylistSideRail}"
                                          IsChecked="{Binding PlaylistShowSideRail}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{loc:T Settings.PlaylistAddedColumn}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.PlaylistAddedColumnHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.PlaylistAddedColumn}"
                                          IsChecked="{Binding PlaylistShowAddedColumn}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{loc:T Settings.PlaylistFavoriteColumn}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.PlaylistFavoriteColumnHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.PlaylistFavoriteColumn}"
                                          IsChecked="{Binding PlaylistShowFavoriteColumn}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.LibraryScan}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.FindNewTracksUpdate}"
                                       FontSize="12" Opacity="0.5"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Classes="loading-spinner"
                                 IsVisible="{Binding IsScanning}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ScanStatusText}"
                                   FontSize="12"
                                   Opacity="0.6"
                                   VerticalAlignment="Center"/>
                        <Button Classes="pill-action"
                                AutomationProperties.Name="{loc:T Settings.ScanLibrary}"
                                Command="{Binding RescanCommand}"
                                IsEnabled="{Binding !IsScanning}"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand">
                            <TextBlock Text="{loc:T Settings.ScanLibrary}" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:T Settings.ScanStartup}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.ScanMusicFoldersWhen}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.ScanStartup}"
                                          IsChecked="{Binding ScanOnStartup}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:T Settings.WatchFolders}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.UpdateLibraryAutomaticallyAs}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.WatchFolders}"
                                          IsChecked="{Binding WatchFoldersEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- Discord request (MusicBee's Inbox): new songs found in the music folders wait
                 on the sidebar's Inbox page until added to the library or deleted. -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{loc:T Settings.Inbox}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.InboxHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.Inbox}"
                                          IsChecked="{Binding InboxEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:T Settings.UseEmbeddedArtwork}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.UseArtworkEmbeddedFile}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.UseEmbeddedArtwork}"
                                          IsChecked="{Binding UseEmbeddedArtwork}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Organisation}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.CollapseAlbumEditions}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ShowOneTilePer}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.CollapseAlbumEditions}"
                                          IsChecked="{Binding CollapseAlbumEditions}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- GitHub #193: the automatic grouping of #178 can be switched off (on by default);
                 #190: and written into the files, only while it is on. -->
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="{loc:T Settings.AlbumGrouping}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.AlbumGroupingHint}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.AlbumGrouping}"
                                              IsChecked="{Binding AlbumGroupingEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding AlbumGroupingEnabled}">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="{loc:T Settings.AlbumGroupingWriteTags}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.AlbumGroupingWriteTagsHint}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.AlbumGroupingWriteTags}"
                                              IsChecked="{Binding AlbumGroupingWriteTags}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.MergeFeaturedArtistsFrom}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.TurnFeatXTrack}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.MergeFeaturedArtistsFrom}"
                                          IsChecked="{Binding MergeFeaturedFromTitles}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- GitHub #187: artist lines as the tag writes them; display only -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.ShowArtistsAsTagged}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ShowArtistsAsTaggedHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.ShowArtistsAsTagged}"
                                          IsChecked="{Binding ShowArtistsAsTagged}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.GroupArtistsBy}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.WhichTagArtistsSection}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <RadioButton Grid.Column="0" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Settings.Artist}"
                                     GroupName="ArtistGroupMode"
                                     IsChecked="{Binding IsArtistGroupByArtist, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.FirstCreditedArtistEachTip}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:T Settings.Artist}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:T Settings.SongSArtistTag}" FontSize="11" Opacity="0.55" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Classes="transition-card medium-card"
                                     AutomationProperties.Name="{loc:T Settings.AlbumArtist}"
                                     GroupName="ArtistGroupMode"
                                     IsChecked="{Binding IsArtistGroupByAlbumArtist, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.AlbumArtistTagSongsTip}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:T Settings.AlbumArtist}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:T Settings.ReleaseSAlbumArtist}" FontSize="11" Opacity="0.55" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.ArtistTagSeparators}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.TextSplitsOneArtist}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="pill" Content="{loc:T Settings.Reset}" FontSize="12" Padding="14,6"
                                VerticalAlignment="Top" Margin="12,0,0,0"
                                Command="{Binding ResetArtistSeparatorsCommand}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ArtistTagSeparators}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <Border Padding="12,4,6,4" Margin="0,0,6,6" CornerRadius="14"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="{loc:T Settings.Text}"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveArtistSeparatorCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="11"
                                                Opacity="0.5"
                                                Cursor="Hand"
                                                Padding="4,2"
                                                ToolTip.Tip="{loc:T Settings.RemoveSeparatorTip}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Classes="settings-search"
                                 AutomationProperties.Name="{loc:T Settings.AddSeparatorEG}"
                                 Text="{Binding NewArtistSeparator, Mode=TwoWay}"
                                 Watermark="{loc:T Settings.AddSeparatorEG}"
                                 Padding="14,6"
                                 MaxWidth="320" HorizontalAlignment="Left" MinWidth="220">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding AddArtistSeparatorCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Classes="pill" Content="{loc:T Settings.Add}" FontSize="13" Padding="16,6"
                                Command="{Binding AddArtistSeparatorCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.KeepNamesTogether}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.KeepNamesTogetherHint}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="pill" Content="{loc:T Settings.Reset}" FontSize="12" Padding="14,6"
                                VerticalAlignment="Top" Margin="12,0,0,0"
                                Command="{Binding ResetArtistProtectedNamesCommand}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ArtistProtectedNames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <Border Padding="12,4,6,4" Margin="0,0,6,6" CornerRadius="14"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="{loc:T Settings.Text}"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveArtistProtectedNameCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="11"
                                                Opacity="0.5"
                                                Cursor="Hand"
                                                Padding="4,2"
                                                ToolTip.Tip="{loc:T Settings.RemoveNameTip}"
                                                AutomationProperties.Name="{loc:T Settings.RemoveNameTip}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Classes="settings-search"
                                 AutomationProperties.Name="{loc:T Settings.AddArtistNameEG}"
                                 Text="{Binding NewArtistProtectedName, Mode=TwoWay}"
                                 PlaceholderText="{loc:T Settings.AddArtistNameEG}"
                                 Padding="14,6"
                                 MaxWidth="320" HorizontalAlignment="Left" MinWidth="220">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding AddArtistProtectedNameCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Classes="pill" Content="{loc:T Settings.Add}" FontSize="13" Padding="16,6"
                                Command="{Binding AddArtistProtectedNameCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <!-- GitHub #99. Toggle + its word list share a spacing-free panel so the gap folds
                     with the body (see the Album page colour block). -->
                <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.IgnoreLeadingWordsInArtistSort}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.IgnoreLeadingWordsInArtistSortHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.IgnoreLeadingWordsInArtistSort}"
                                          IsChecked="{Binding IgnoreLeadingWordsInArtistSort}"
                                          VerticalAlignment="Center"/>
                </Grid>
                <controls:CollapsibleContent IsOpen="{Binding IgnoreLeadingWordsInArtistSort}" Lift="10" Motion="Glide">
                <StackPanel Classes="sub-setting" Spacing="12" Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding ArtistSortIgnoredWords}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <Border Padding="12,4,6,4" Margin="0,0,6,6" CornerRadius="14"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="{loc:T Settings.Text}"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveArtistSortIgnoredWordCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="11"
                                                Opacity="0.5"
                                                Cursor="Hand"
                                                Padding="4,2"
                                                ToolTip.Tip="{loc:T Settings.RemoveWordTip}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Classes="settings-search"
                                 AutomationProperties.Name="{loc:T Settings.AddWordEG}"
                                 Text="{Binding NewArtistSortIgnoredWord, Mode=TwoWay}"
                                 PlaceholderText="{loc:T Settings.AddWordEG}"
                                 Padding="14,6"
                                 MaxWidth="320" HorizontalAlignment="Left" MinWidth="220">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding AddArtistSortIgnoredWordCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Classes="pill" Content="{loc:T Settings.Add}" FontSize="13" Padding="16,6"
                                Command="{Binding AddArtistSortIgnoredWordCommand}"/>
                        <Button Grid.Column="2" Classes="pill" Content="{loc:T Settings.Reset}" FontSize="12" Padding="14,6"
                                VerticalAlignment="Center"
                                Command="{Binding ResetArtistSortIgnoredWordsCommand}"/>
                    </Grid>
                </StackPanel>
                </controls:CollapsibleContent>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Metadata}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:T Settings.TagSourcesSearchMetadata}"
                               FontSize="12" Opacity="0.5" Margin="0,0,0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.Deezer}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.MusicStreamingCatalog}" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.Deezer}"
                                              IsChecked="{Binding DeezerEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.MusicBrainz}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.OpenMusicEncyclopedia}" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.MusicBrainz}"
                                              IsChecked="{Binding MusicBrainzEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Tools}" Margin="0,16,0,8"/>
            <!-- One group card, one row per tool: glyph, title + one-line description, action. -->
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <controls:LineIcon Grid.Column="0" Classes="tool-icon" Data="{DynamicResource LineOrganizeFiles}"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Settings.OrganizeFiles}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.RenameMoveFilesInto}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="pill-action" Command="{Binding OpenOrganizeFilesCommand}"
                            AutomationProperties.Name="{loc:T Settings.Organize}"
                            Padding="14,8" CornerRadius="999" Cursor="Hand" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{loc:T Settings.Organize}" FontSize="13"/>
                    </Button>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <controls:LineIcon Grid.Column="0" Classes="tool-icon" Data="{DynamicResource LineDuplicates}"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Settings.FindDuplicates}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.FindDuplicateTracksRemove}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="pill-action" Command="{Binding OpenDuplicateFinderCommand}"
                            AutomationProperties.Name="{loc:T Settings.FindDuplicates}"
                            Padding="14,8" CornerRadius="999" Cursor="Hand" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{loc:T Settings.Find}" FontSize="13"/>
                    </Button>
                </Grid>
            </Border>
            <!-- Discord (Cosmo, 11-02): lyrics and animated artwork for the whole library at once. -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <controls:LineIcon Grid.Column="0" Classes="tool-icon" Data="{StaticResource MenuLineLyrics}"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Settings.FindLibraryLyrics}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.FindLibraryLyricsSub}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="pill-action" Command="{Binding OpenLibraryLyricsCommand}"
                            AutomationProperties.Name="{loc:T Settings.FindLibraryLyrics}"
                            Padding="14,8" CornerRadius="999" Cursor="Hand" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{loc:T Settings.Find}" FontSize="13"/>
                    </Button>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <controls:LineIcon Grid.Column="0" Classes="tool-icon" Data="{StaticResource MenuLineVideo}"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Settings.FindLibraryArtwork}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.FindLibraryArtworkSub}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="pill-action" Command="{Binding OpenLibraryAnimatedArtworkCommand}"
                            AutomationProperties.Name="{loc:T Settings.FindLibraryArtwork}"
                            Padding="14,8" CornerRadius="999" Cursor="Hand" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{loc:T Settings.Find}" FontSize="13"/>
                    </Button>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <controls:LineIcon Grid.Column="0" Classes="tool-icon" Data="{DynamicResource LineFindMetadata}"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Settings.FindMetadata}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.IdentifyPoorlyTaggedTracks}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="pill-action" Command="{Binding OpenMetadataFinderCommand}"
                            AutomationProperties.Name="{loc:T Settings.FindMetadata}"
                            Padding="14,8" CornerRadius="999" Cursor="Hand" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{loc:T Settings.Find}" FontSize="13"/>
                    </Button>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <controls:LineIcon Grid.Column="0" Classes="tool-icon" Data="{StaticResource MenuLineImport}"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Settings.ImportPlaylist}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ImportM3UExportifyCSV}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="pill-action" Command="{Binding OpenPlaylistImportCommand}"
                            AutomationProperties.Name="{loc:T Settings.Import}"
                            Padding="14,8" CornerRadius="999" Cursor="Hand" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{loc:T Settings.Import}" FontSize="13"/>
                    </Button>
                </Grid>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.HiddenTracks}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.SnoozedTracks}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HiddenFromShuffleRadio}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Text="{loc:T Settings.NoSnoozedTracks}"
                               FontSize="13" Opacity="0.45"
                               IsVisible="{Binding !HasSnoozedTracks}"/>

                    <ItemsControl ItemsSource="{Binding SnoozedTracks}">
                        <ItemsControl.Styles>
                            <Style Selector="ItemsControl:empty">
                                <Setter Property="IsVisible" Value="False"/>
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Track">
                                <Border Padding="14,8" Margin="0,2" CornerRadius="12"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Artist}"
                                                       FontSize="12" Opacity="0.55"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SnoozedUntil, StringFormat='Until {0:MMM d, yyyy}'}"
                                                   FontSize="12" Opacity="0.5"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0"/>
                                        <Button Grid.Column="2"
                                                AutomationProperties.Name="{loc:T Settings.UnSnooze}"
                                                Classes="pill-action"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).UnsnoozeCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="12,6"
                                                CornerRadius="14"
                                                Cursor="Hand"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{loc:T Settings.UnSnooze}" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.RemovedTracks}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.RemovedFromLibraryTheir}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Text="{loc:T Settings.NoRemovedTracks}"
                               FontSize="13" Opacity="0.45"
                               IsVisible="{Binding !HasRemovedTracks}"/>

                    <ItemsControl ItemsSource="{Binding RemovedTracks}">
                        <ItemsControl.Styles>
                            <Style Selector="ItemsControl:empty">
                                <Setter Property="IsVisible" Value="False"/>
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:RemovedTrackEntry">
                                <Border Padding="14,8" Margin="0,2" CornerRadius="12"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Folder}"
                                                       FontSize="12" Opacity="0.55"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                AutomationProperties.Name="{loc:T Settings.Restore}"
                                                Classes="pill-action"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RestoreRemovedTrackCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="12,6"
                                                CornerRadius="14"
                                                Cursor="Hand"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{loc:T Settings.Restore}" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="AdvancedTabPanel" Classes="tab-page" IsVisible="{Binding IsAdvancedTabVisible}" Spacing="4">
            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Storage}" Margin="0,2,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings.DiskUsage}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:T Settings.SpaceUsedByNoctis}"
                                           FontSize="12" Opacity="0.5"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2"
                                AutomationProperties.Name="{loc:T Settings.OpenDataFolder}"
                                Command="{Binding OpenDataFolderCommand}"
                                Classes="pill-action"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.OpenDataFolder}" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <StackPanel Spacing="8" Margin="0,4,0,0">
                        <!-- Library size (music files on disk) -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.LibrarySize}"
                                       FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalFileSize}"
                                       FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Opacity="0.2"/>

                        <!-- Library data -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.LibraryData}"
                                       FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding StorageLibraryData}"
                                       FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Opacity="0.2"/>

                        <!-- Artwork cache -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.ArtworkCache}"
                                       FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding StorageArtwork}"
                                       FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Opacity="0.2"/>

                        <!-- Playlists -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.Playlists}"
                                       FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding StoragePlaylists}"
                                       FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Opacity="0.2"/>

                        <!-- Settings -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.Settings}"
                                       FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding StorageSettings}"
                                       FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Opacity="0.3"/>

                        <!-- Total -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.Total}"
                                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding StorageTotal}"
                                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </Border>
            <!-- Data Folder (GitHub #165): where the library, artwork and caches live. -->
            <Border Classes="setting-row">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="{loc:T Settings.DataFolder}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.DataFolderHint}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding !IsDataFolderCopying}">
                            <Button AutomationProperties.Name="{loc:T Settings.DataFolderUseDefault}"
                                    Command="{Binding UseDefaultDataFolderCommand}"
                                    IsVisible="{Binding IsDataFolderCustom}"
                                    Classes="pill-action"
                                    Padding="14,8"
                                    CornerRadius="999"
                                    Cursor="Hand">
                                <TextBlock Text="{loc:T Settings.DataFolderUseDefault}" FontSize="13"
                                           VerticalAlignment="Center"/>
                            </Button>
                            <Button AutomationProperties.Name="{loc:T Settings.DataFolderChange}"
                                    Command="{Binding ChangeDataFolderCommand}"
                                    Classes="pill-action"
                                    Padding="14,8"
                                    CornerRadius="999"
                                    Cursor="Hand">
                                <TextBlock Text="{loc:T Settings.DataFolderChange}" FontSize="13"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <SelectableTextBlock Text="{Binding DataFolderPath}"
                                         FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>

                    <!-- Copying -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsDataFolderCopying}">
                        <TextBlock Text="{Binding DataFolderCopyText}" FontSize="12" Opacity="0.7"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <ProgressBar Grid.Column="0" Minimum="0" Maximum="100"
                                         Value="{Binding DataFolderCopyPercent}"
                                         Height="4" CornerRadius="2"
                                         VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="pill-action" Margin="12,0,0,0"
                                    AutomationProperties.Name="{loc:T Settings.Cancel}"
                                    Command="{Binding CancelDataFolderCopyCommand}">
                                <TextBlock Text="{loc:T Settings.Cancel}" FontSize="12"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- The picked folder already holds Noctis data -->
                    <controls:CollapsibleContent IsOpen="{Binding IsDataFolderUseExistingVisible}" Lift="6">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:T Settings.DataFolderExistingTitle}"
                                       FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DataFolderUseExistingDetail}"
                                       FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="pill-action"
                                        AutomationProperties.Name="{loc:T Settings.Cancel}"
                                        Command="{Binding CancelUseExistingDataFolderCommand}"
                                        Padding="14,8" CornerRadius="999" Cursor="Hand">
                                    <TextBlock Text="{loc:T Settings.Cancel}" FontSize="13"/>
                                </Button>
                                <Button Classes="pill-action"
                                        AutomationProperties.Name="{loc:T Settings.DataFolderUseThis}"
                                        Command="{Binding ConfirmUseExistingDataFolderCommand}"
                                        Padding="14,8" CornerRadius="999" Cursor="Hand">
                                    <TextBlock Text="{loc:T Settings.DataFolderUseThis}" FontSize="13" FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </controls:CollapsibleContent>

                    <TextBlock Text="{Binding DataFolderStatus}"
                               IsVisible="{Binding IsDataFolderInfoVisible}"
                               FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DataFolderStatus}"
                               IsVisible="{Binding IsDataFolderErrorVisible}"
                               FontSize="12" Foreground="#E74856" TextWrapping="Wrap"/>

                    <!-- A change waits for a restart -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                IsVisible="{Binding IsDataFolderRestartNeeded}">
                        <Button Classes="pill-action"
                                AutomationProperties.Name="{loc:T Settings.Cancel}"
                                Command="{Binding CancelDataFolderChangeCommand}"
                                Padding="14,8" CornerRadius="999" Cursor="Hand">
                            <TextBlock Text="{loc:T Settings.Cancel}" FontSize="13"/>
                        </Button>
                        <Button Classes="pill-action"
                                AutomationProperties.Name="{loc:T Settings.DataFolderRestartNow}"
                                Command="{Binding RestartForDataFolderCommand}"
                                Padding="14,8" CornerRadius="999" Cursor="Hand">
                            <TextBlock Text="{loc:T Settings.DataFolderRestartNow}" FontSize="13" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="14">

                    <!-- Reset Settings -->
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:T Settings.ResetSettings}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{loc:T Settings.RestoreDefaultsClearSaved}"
                                               FontSize="12" Opacity="0.5"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    AutomationProperties.Name="{loc:T Settings.ResetSettings}"
                                    Command="{Binding ShowResetConfirmCommand}"
                                    IsVisible="{Binding !IsResetConfirmVisible}"
                                    Classes="pill-action"
                                    Padding="14,8"
                                    CornerRadius="999"
                                    Cursor="Hand"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{loc:T Settings.ResetSettings}" FontSize="13"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                        <controls:CollapsibleContent IsOpen="{Binding IsResetConfirmVisible}" Lift="6">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:T Settings.AreYouSureAction}"
                                       FontSize="13" Foreground="#E74856"/>
                            <TextBlock Text="{Binding ResetConfirmDetail}"
                                       FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:T Settings.Cancel}"
                                        Command="{Binding CancelResetCommand}"
                                        Classes="pill-action"
                                        FontWeight="Bold"
                                        Padding="16,10"
                                        CornerRadius="18"
                                        Cursor="Hand"/>
                                <Button Content="{loc:T Settings.ResetEverything}"
                                        Command="{Binding ConfirmResetLibraryCommand}"
                                        Classes="pill-action danger"
                                        FontWeight="Bold"
                                        Padding="16,10"
                                        CornerRadius="18"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                        </controls:CollapsibleContent>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Opacity="0.2"/>

                    <!-- Clear Artwork Cache -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings.ClearArtworkCache}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:T Settings.DeleteCachedArtworkWill}"
                                            FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                                <TextBlock Text="{loc:T Settings.NoteRemovesAllArtwork}"
                                           FontSize="12" Foreground="#E74856" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1"
                                AutomationProperties.Name="{loc:T Settings.ClearCache}"
                                Command="{Binding ClearArtworkCacheCommand}"
                                Classes="pill-action"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.ClearCache}" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.AudioTools}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.Ffmpeg}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{loc:T Settings.UsedByAudioConverter}"
                                   FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 AutomationProperties.Name="{loc:T Settings.Ffmpeg}"
                                 Text="{Binding FfmpegPath}"
                                 Watermark="{loc:T Settings.AutoDetect}"
                                 CornerRadius="999"
                                 Padding="14,8"
                                 BorderThickness="1.5"
                                 MinHeight="0"
                                 KeyDown="OnFfmpegPathKeyDown" />
                        <Button Grid.Column="1"
                                Content="{loc:T Settings.Browse}"
                                Command="{Binding BrowseFfmpegCommand}"
                                Padding="14,8"
                                CornerRadius="999"
                                Margin="8,0,0,0"
                                Cursor="Hand"/>
                    </Grid>
                    <TextBlock Text="{Binding FfmpegStatus}"
                               FontSize="11" Opacity="0.6"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Updates}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.IncludePreReleaseUpdates}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.OfferBetaBuildsUpdater}"
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.IncludePreReleaseUpdates}"
                                              IsChecked="{Binding IncludePrereleaseUpdates}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="10">
                    <!-- Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.DeveloperMode}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.ShowVersionManagerDebug}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.DeveloperMode}"
                                              IsChecked="{Binding DeveloperMode}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <controls:CollapsibleContent IsOpen="{Binding DeveloperMode}" Lift="6">
                    <StackPanel Spacing="10">

                        <!-- ── Version manager ── -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                            <TextBlock Grid.Column="0"
                                       Text="{loc:T Settings.DownloadInstallAnyRelease}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <Ellipse Grid.Column="1"
                                     Classes="loading-spinner"
                                     IsVisible="{Binding IsLoadingReleases}"
                                     VerticalAlignment="Center"
                                     Margin="8,0,0,0"/>
                        </Grid>

                        <TextBlock Text="{loc:T Settings.NoReleasesFound}"
                                   FontSize="13" Opacity="0.55"
                                   HorizontalAlignment="Center"
                                   Margin="0,8"
                                   IsVisible="{Binding ShowDevReleasesEmpty}"/>

                        <!-- Full release history; scrolls with the settings page itself -->
                        <ItemsControl ItemsSource="{Binding DevReleases}"
                                      IsEnabled="{Binding !IsDevDownloading}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DevReleaseItem">
                                        <Border Background="#12FFFFFF" CornerRadius="10"
                                                Padding="12,8" Margin="0,3">
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding VersionDisplay}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="1"
                                                        IsVisible="{Binding IsPrerelease}"
                                                        Background="{DynamicResource AccentColorBrush}" CornerRadius="999"
                                                        Padding="7,2" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:T Settings.PreRelease2}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentForegroundBrush}"/>
                                                </Border>
                                                <Border Grid.Column="2"
                                                        IsVisible="{Binding IsLatest}"
                                                        Background="{DynamicResource AccentColorBrush}" CornerRadius="999"
                                                        Padding="7,2" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:T Settings.Latest}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentForegroundBrush}"/>
                                                </Border>
                                                <Border Grid.Column="3"
                                                        IsVisible="{Binding ShowInstalledBadge}"
                                                        Background="{DynamicResource AccentColorBrush}" CornerRadius="999"
                                                        Padding="7,2" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:T Settings.Installed}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentForegroundBrush}"/>
                                                </Border>
                                                <TextBlock Grid.Column="4"
                                                           IsVisible="{Binding HasWarning}"
                                                           Text="{Binding WarningText}"
                                                           ToolTip.Tip="{Binding WarningText}"
                                                           FontSize="11"
                                                           Foreground="#F1C40F"
                                                           Opacity="0.9"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="5"
                                                           Text="{Binding DateDisplay}"
                                                           FontSize="12" Opacity="0.5"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0"/>
                                                <Button Grid.Column="6"
                                                        AutomationProperties.Name="{Binding ActionLabel}"
                                                        Classes="pill-action"
                                                        IsVisible="{Binding !IsCurrent}"
                                                        Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).InstallReleaseCommand}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding ActionLabel}" FontSize="12"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Expand to the full release history -->
                        <Button IsVisible="{Binding HasHiddenReleases}"
                                AutomationProperties.Name="{Binding ShowOlderVersionsLabel}"
                                Command="{Binding ShowOlderReleasesCommand}"
                                Classes="accent-btn"
                                Background="{DynamicResource AccentButtonBackground}"
                                Foreground="{DynamicResource AccentForegroundBrush}"
                                BorderThickness="0"
                                CornerRadius="999"
                                Padding="14,6"
                                HorizontalAlignment="Center"
                                Cursor="Hand">
                            <TextBlock Text="{Binding ShowOlderVersionsLabel}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Button>
                        <!-- Collapse back to the newest releases (sits under the expanded list) -->
                        <Button IsVisible="{Binding IsReleaseHistoryExpanded}"
                                AutomationProperties.Name="{loc:T Settings.ShowRecentReleasesOnly}"
                                Command="{Binding HideOlderReleasesCommand}"
                                Classes="accent-btn"
                                Background="{DynamicResource AccentButtonBackground}"
                                Foreground="{DynamicResource AccentForegroundBrush}"
                                BorderThickness="0"
                                Padding="14,6"
                                CornerRadius="999"
                                HorizontalAlignment="Center"
                                Cursor="Hand">
                            <TextBlock Text="{loc:T Settings.ShowRecentReleasesOnly}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Button>

                        <!-- Download status / progress -->
                        <StackPanel x:Name="DevDownloadPanel" Spacing="10">
                            <TextBlock Text="{Binding DevStatusText}"
                                       FontSize="12" Opacity="0.7"
                                       IsVisible="{Binding DevStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <StackPanel Orientation="Horizontal" Spacing="12"
                                        IsVisible="{Binding IsDevDownloading}">
                                <ProgressBar Minimum="0" Maximum="100"
                                             Value="{Binding DevDownloadProgress}"
                                             Height="4" CornerRadius="2"
                                             VerticalAlignment="Center"
                                             MinWidth="200"/>
                                <Button Classes="pill-action"
                                        AutomationProperties.Name="{loc:T Settings.Cancel}"
                                        Command="{Binding CancelDevDownloadCommand}">
                                    <TextBlock Text="{loc:T Settings.Cancel}" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- ── Debug logs ── -->
                        <TextBlock Text="{Binding PreservedCrashBanner}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#E5A34D"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   IsVisible="{Binding PreservedCrashBanner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="{loc:T Settings.SessionLogTroubleshootingShare}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="pill-action" Command="{Binding CopyDevLogsCommand}" AutomationProperties.Name="{loc:T Settings.CopyLogs}">
                                <TextBlock Text="{loc:T Settings.CopyLogs}" FontSize="12"/>
                            </Button>
                            <Button Classes="pill-action" Command="{Binding ClearDevLogsCommand}" AutomationProperties.Name="{loc:T Settings.Clear}">
                                <TextBlock Text="{loc:T Settings.Clear}" FontSize="12"/>
                            </Button>
                            <Button Classes="pill-action" Command="{Binding OpenLogsFolderCommand}"
                                    AutomationProperties.Name="{loc:T Settings.OpenFolder}"
                                    ToolTip.Tip="{loc:T Settings.OpenAppDataFolderTip}">
                                <TextBlock Text="{loc:T Settings.OpenFolder}" FontSize="12"/>
                            </Button>
                            <TextBlock Text="{loc:T Settings.Copied}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentColorBrush}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding DevLogsCopied}"/>
                        </StackPanel>
                        <Border Background="#12FFFFFF" CornerRadius="10" Padding="12,8" MaxHeight="190">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <SelectableTextBlock Text="{Binding DevLogText}"
                                                     FontSize="11"
                                                     FontFamily="Consolas, Menlo, monospace"
                                                     Opacity="0.8"
                                                     TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>

                    </StackPanel>
                    </controls:CollapsibleContent>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="AccountSyncTabPanel" Classes="tab-page" IsVisible="{Binding IsAccountDevicesTabVisible}" Spacing="4">
            <!-- Four groups, one job each: the account, the phone app (server, pairing, devices,
                 sync), the browser remote, and the API for apps on this PC. -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,8">
                <TextBlock Classes="section-title" Text="{loc:T Settings.Section.YourAccount}" Margin="0" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource AccentColorBrush}" CornerRadius="999" Padding="7,2" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Settings.BetaBadge}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentForegroundBrush}"/>
                </Border>
            </StackPanel>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="Auto,*">
                    <!-- Avatar: click to change; on hover a camera badge says so and an X removes the picture. -->
                    <Panel Grid.Column="0" Classes="avatar-wrap" Width="60" Height="60" Background="Transparent">
                        <Button Classes="profile-avatar-btn"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                Width="56" Height="56" CornerRadius="999"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                ToolTip.Tip="{loc:T Settings.ChangePictureTip}"
                                Click="OnPickAvatarClick">
                            <Border Width="56" Height="56" CornerRadius="28" ClipToBounds="True">
                                <Panel>
                                    <Border CornerRadius="28" Background="{DynamicResource AccentColorBrush}"
                                            IsVisible="{Binding ProfileAvatarPath, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                        <TextBlock Text="?" FontSize="22" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <controls:CachedImage SourcePath="{Binding ProfileAvatarPath}" Stretch="UniformToFill" ClearOnSourceChange="False"
                                                          IsVisible="{Binding ProfileAvatarPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </Panel>
                            </Border>
                        </Button>
                        <Border Classes="avatar-badge" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
                            <PathIcon Data="{StaticResource CameraIcon}" Width="11" Height="11" Foreground="{DynamicResource AccentForegroundBrush}"/>
                        </Border>
                        <Button Classes="avatar-x" HorizontalAlignment="Left" VerticalAlignment="Top"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding ClearProfileAvatarCommand}"
                                ToolTip.Tip="{loc:T Settings.RemovePictureTip}"
                                IsVisible="{Binding ProfileAvatarPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <controls:LineIcon Data="{StaticResource MenuLineClose}" Width="16" Height="16" Margin="-4" StrokeThickness="2.62" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Panel>
                    <!-- Name: an editable box, the way a profile field reads. -->
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="5">
                        <TextBlock Text="{loc:T Settings.Name}" FontSize="11.5" FontWeight="SemiBold" Opacity="0.55"/>
                        <TextBox Classes="profile-name"
                                 AutomationProperties.Name="{loc:T Settings.Name}"
                                 Text="{Binding ProfileName, Mode=TwoWay}"
                                 Watermark="{loc:T Settings.Name}"
                                 Width="260" HorizontalAlignment="Left"
                                 ToolTip.Tip="{loc:T Settings.ClickEditNameTip}"
                                 KeyDown="OnProfileNameKeyDown"/>
                        <!-- The account this profile signs devices in with: under the name, beside
                             the one profile picture (no second avatar). -->
                        <TextBlock x:Name="AccountIdentityLine" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding HasPrimaryAccount}">
                            <Run Text="{Binding PrimaryAccountName}" FontWeight="SemiBold"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding PrimaryAccountSince}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Coming soon while AccountFeatures is off: the card stays visible so the feature is
                 discoverable, but every control is disabled. -->
            <Border Classes="setting-row" Classes.parked="{Binding !AccountFeaturesEnabled}" IsEnabled="{Binding AccountFeaturesEnabled}">
                <!-- No spacing: a folded section keeps the panel's spacing, which left an empty band
                     under the buttons; the error slot carries its own margin. -->
                <StackPanel>
                    <!-- No account yet: a short form, one field per line, one Create button. Enter in
                         the password box creates too. -->
                    <controls:CollapsibleContent IsOpen="{Binding !HasPrimaryAccount}" Lift="10" Motion="Glide">
                    <StackPanel x:Name="CreateAccountForm" Spacing="14" MaxWidth="440" HorizontalAlignment="Left">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Width="36" Height="36" CornerRadius="999" ClipToBounds="True" VerticalAlignment="Top">
                                <Panel>
                                    <Border Background="{DynamicResource AccentColorBrush}" Opacity="0.18"/>
                                    <PathIcon Data="{StaticResource AccountLockIcon}" Width="16" Height="16"
                                              Foreground="{DynamicResource AccentColorBrush}"/>
                                </Panel>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{loc:T AccountSync.CreateTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{loc:T AccountSync.CreateHelp}" FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="10">
                            <TextBox x:Name="CreateEmailBox" Classes="account-field" Text="{Binding NewServerUserName}"
                                     AutomationProperties.Name="{loc:T AccountSync.EmailWatermark}"
                                     Watermark="{loc:T AccountSync.EmailWatermark}"/>
                            <TextBox x:Name="CreatePasswordBox" Classes="account-field" Text="{Binding NewServerUserPassword}" PasswordChar="•"
                                     AutomationProperties.Name="{loc:T AccountSync.NewPassword}"
                                     RevealPassword="{Binding IsPasswordRevealed}" Watermark="{loc:T AccountSync.NewPassword}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding CreatePrimaryAccountCommand}"/>
                                </TextBox.KeyBindings>
                                <TextBox.InnerRightContent>
                                    <Button Classes="account-icon-btn" Command="{Binding TogglePasswordRevealCommand}" ToolTip.Tip="{loc:T AccountSync.ShowPasswordTip}">
                                        <Panel>
                                            <PathIcon Data="{StaticResource AccountEyeIcon}" IsVisible="{Binding !IsPasswordRevealed}"/>
                                            <PathIcon Data="{StaticResource AccountEyeOffIcon}" IsVisible="{Binding IsPasswordRevealed}"/>
                                        </Panel>
                                    </Button>
                                </TextBox.InnerRightContent>
                            </TextBox>
                        </StackPanel>
                        <Button x:Name="CreateAccountButton" Classes="accent-btn account-action" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.Name="{loc:T AccountSync.Create}"
                                Height="40" Command="{Binding CreatePrimaryAccountCommand}"
                                Background="{DynamicResource AccentButtonBackground}" Foreground="{DynamicResource AccentForegroundBrush}">
                            <TextBlock Text="{loc:T AccountSync.Create}" FontSize="13.5" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                    </controls:CollapsibleContent>

                    <!-- Account exists: only what belongs to the account itself. Pairing, devices
                         and the API key for other apps live in the Phone app card below. -->
                    <controls:CollapsibleContent IsOpen="{Binding HasPrimaryAccount}" Lift="10" Motion="Glide">
                    <StackPanel>
                        <WrapPanel x:Name="AccountActions" ItemSpacing="8" LineSpacing="8">
                            <Button Classes="pill-action account-action" Command="{Binding ToggleChangePasswordCommand}" AutomationProperties.Name="{loc:T AccountSync.ChangePassword}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="{StaticResource AccountLockIcon}"/>
                                    <TextBlock Text="{loc:T AccountSync.ChangePassword}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="AccountRemoveButton" Classes="pill-action account-action account-remove" Command="{Binding DeleteServerUserCommand}" CommandParameter="{Binding PrimaryAccount}"
                                    ToolTip.Tip="{loc:T AccountSync.DeleteAccountTip}">
                                <PathIcon Data="{StaticResource TrashIcon}" Foreground="#FF6B6B"/>
                            </Button>
                        </WrapPanel>

                        <!-- Change password (inline) -->
                        <controls:CollapsibleContent IsOpen="{Binding IsChangePasswordVisible}" Lift="10" Motion="Glide">
                        <StackPanel Spacing="8" Margin="0,14,0,0">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" MaxWidth="560" HorizontalAlignment="Left">
                                <TextBox Grid.Column="0" Text="{Binding ChangePasswordValue}" PasswordChar="•" RevealPassword="{Binding IsPasswordRevealed}"
                                         AutomationProperties.Name="{loc:T AccountSync.NewPassword}"
                                         Watermark="{loc:T AccountSync.NewPassword}" CornerRadius="999" Padding="14,8,4,8" BorderThickness="1.5" MinHeight="0" MinWidth="260">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding ChangePrimaryPasswordCommand}"/>
                                    </TextBox.KeyBindings>
                                    <TextBox.InnerRightContent>
                                        <Button Classes="account-icon-btn" Command="{Binding TogglePasswordRevealCommand}" ToolTip.Tip="{loc:T AccountSync.ShowPasswordTip}">
                                            <Panel>
                                                <PathIcon Data="{StaticResource AccountEyeIcon}" IsVisible="{Binding !IsPasswordRevealed}"/>
                                                <PathIcon Data="{StaticResource AccountEyeOffIcon}" IsVisible="{Binding IsPasswordRevealed}"/>
                                            </Panel>
                                        </Button>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                                <Button Grid.Column="1" Classes="accent-btn account-action" Command="{Binding ChangePrimaryPasswordCommand}"
                                        AutomationProperties.Name="{loc:T AccountSync.Save}"
                                        Background="{DynamicResource AccentButtonBackground}" Foreground="{DynamicResource AccentForegroundBrush}">
                                    <TextBlock Text="{loc:T AccountSync.Save}" FontWeight="SemiBold"/>
                                </Button>
                                <Button Grid.Column="2" Classes="pill-action account-action" Command="{Binding ToggleChangePasswordCommand}" AutomationProperties.Name="{loc:T Settings.Cancel}">
                                    <TextBlock Text="{loc:T Settings.Cancel}"/>
                                </Button>
                            </Grid>
                            <!-- ServerUserStore.ChangePassword drops every device key: say so before Save. -->
                            <TextBlock Text="{loc:T AccountSync.ChangePasswordNote}" FontSize="11.5" Opacity="0.55" TextWrapping="Wrap"/>
                        </StackPanel>
                        </controls:CollapsibleContent>
                    </StackPanel>
                    </controls:CollapsibleContent>

                    <!-- The message glides in and out: a plain show/hide reflowed the card in one
                         jump (it read as the page shaking), and a fixed empty slot left a band
                         under the buttons. -->
                    <controls:CollapsibleContent IsOpen="{Binding ServerUserError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Lift="6" Motion="Glide">
                        <TextBlock Text="{Binding ServerUserError}" FontSize="12" Foreground="#FF6B6B" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </controls:CollapsibleContent>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <!-- Phone app: the switch is Noctis Server itself (phones and Subsonic apps connect
                 through it), so turning it off really stops the server. While it runs the card
                 is four plain rows: Connect a phone (QR or by hand, as numbered steps), Your
                 phones, Sync, and a folded Advanced corner (this PC's name, other music apps). -->
            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.PhoneApp}" Margin="0,16,0,8"/>
            <Border x:Name="PhoneCard" Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row" Classes.parked="{Binding !AccountFeaturesEnabled}" IsEnabled="{Binding AccountFeaturesEnabled}">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:T Phone.Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource AccentColorBrush}" CornerRadius="999" Padding="7,2" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T Settings.BetaBadge}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentForegroundBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{loc:T Phone.Description}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle AutomationProperties.Name="{loc:T Phone.Title}" x:Name="PhoneServerToggle" Grid.Column="1" IsChecked="{Binding NoctisServerEnabled}" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{loc:T Phone.NeedsAccount}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0"
                               IsVisible="{Binding !HasPrimaryAccount}"/>
                    <TextBlock Text="{Binding NoctisServerError}" FontSize="12" Foreground="#FF6B6B" TextWrapping="Wrap" Margin="0,8,0,0"
                               IsVisible="{Binding NoctisServerStartFailed}"/>
                </StackPanel>
            </Border>

            <controls:CollapsibleContent x:Name="PhoneBody" IsOpen="{Binding IsPhoneCardOpen}" Lift="10" Motion="Glide">
            <StackPanel>
                <!-- (a) Connect a phone. The button opens two ways to sign the phone in: the QR
                     (default; a one-time code, never a password or key) and by hand. -->
                <Border x:Name="ConnectPhoneRow" Classes="setting-row divided">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{loc:T AccountSync.PairDevice}" FontSize="13.5" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:T Pair.Subtitle}" FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="ConnectPhoneButton" Classes="accent-btn account-action" Command="{Binding TogglePairingCommand}"
                                    AutomationProperties.Name="{loc:T AccountSync.PairDevice}" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentButtonBackground}" Foreground="{DynamicResource AccentForegroundBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="{StaticResource AccountPhoneIcon}" Foreground="{DynamicResource AccentForegroundBrush}"
                                              IsVisible="{Binding !IsPairingVisible}"/>
                                    <TextBlock Text="{loc:T AccountSync.PairDevice}" FontWeight="SemiBold" IsVisible="{Binding !IsPairingVisible}"/>
                                    <TextBlock Text="{loc:T Server.Done}" FontWeight="SemiBold" IsVisible="{Binding IsPairingVisible}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <controls:CollapsibleContent IsOpen="{Binding IsPairingVisible}" Lift="10" Motion="Glide">
                        <Border x:Name="PairingPanel" Classes="pair-panel" Margin="0,14,0,0">
                            <StackPanel Spacing="16">
                                <!-- Which way: two segments, the QR first. -->
                                <Border Classes="pair-switch" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="PairModeQrButton" Classes="pair-mode" Classes.selected="{Binding IsQrPairing}"
                                                Command="{Binding ShowQrPairingCommand}" AutomationProperties.Name="{loc:T Pair.ModeQr}">
                                            <TextBlock Text="{loc:T Pair.ModeQr}"/>
                                        </Button>
                                        <Button x:Name="PairModeManualButton" Classes="pair-mode" Classes.selected="{Binding IsManualPairing}"
                                                Command="{Binding ShowManualPairingCommand}" AutomationProperties.Name="{loc:T Pair.ModeManual}">
                                            <TextBlock Text="{loc:T Pair.ModeManual}"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Scan QR code: the code (on white, so it scans on a dark theme too) and three steps. -->
                                <Grid x:Name="PairingQrBlock" ColumnDefinitions="Auto,*" ColumnSpacing="24" IsVisible="{Binding IsQrPairing}">
                                    <StackPanel Grid.Column="0" Spacing="8" IsVisible="{Binding HasPairingQr}">
                                        <Border Background="White" CornerRadius="12" Padding="6" HorizontalAlignment="Left">
                                            <Image Source="{Binding PairingQr}" Width="188" Height="188"
                                                   RenderOptions.BitmapInterpolationMode="None"
                                                   AutomationProperties.Name="{loc:T AccountSync.PairQrName}"/>
                                        </Border>
                                        <Grid ColumnDefinitions="*,Auto" Width="200" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding PairingQrCountdown}" FontSize="11.5" Opacity="0.6" FontFeatures="+tnum"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" x:Name="RenewPairingQrButton" Classes="pair-link" Command="{Binding RenewPairingQrCommand}"
                                                    AutomationProperties.Name="{loc:T Pair.NewCode}">
                                                <TextBlock Text="{loc:T Pair.NewCode}"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                                        <Grid Classes="pair-step" ColumnDefinitions="Auto,*">
                                            <Border Classes="pair-step-number"><TextBlock Text="1"/></Border>
                                            <TextBlock Grid.Column="1" Text="{loc:T Pair.QrStep1}"/>
                                        </Grid>
                                        <Grid Classes="pair-step" ColumnDefinitions="Auto,*">
                                            <Border Classes="pair-step-number"><TextBlock Text="2"/></Border>
                                            <TextBlock Grid.Column="1" Text="{loc:T Pair.QrStep2}"/>
                                        </Grid>
                                        <Grid Classes="pair-step" ColumnDefinitions="Auto,*">
                                            <Border Classes="pair-step-number"><TextBlock Text="3"/></Border>
                                            <TextBlock Grid.Column="1" Text="{loc:T Pair.QrStep3}"/>
                                        </Grid>
                                        <TextBlock Text="{loc:T AccountSync.PairQrWarning}" FontSize="11.5" Opacity="0.5" TextWrapping="Wrap"
                                                   Margin="34,2,0,0" IsVisible="{Binding HasPairingQr}"/>
                                        <TextBlock Text="{loc:T Pair.QrUnavailable}" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                                   Margin="34,2,0,0" IsVisible="{Binding ShowsQrUnavailable}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Enter manually: the address to type and the code to compare, in the steps that use them. -->
                                <StackPanel x:Name="PairingManualBlock" Spacing="12" IsVisible="{Binding IsManualPairing}">
                                    <Grid Classes="pair-step" ColumnDefinitions="Auto,*">
                                        <Border Classes="pair-step-number"><TextBlock Text="1"/></Border>
                                        <TextBlock Grid.Column="1" Text="{loc:T Pair.ManualStep1}"/>
                                    </Grid>
                                    <Grid Classes="pair-step" ColumnDefinitions="Auto,*">
                                        <Border Classes="pair-step-number"><TextBlock Text="2"/></Border>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <TextBlock Text="{loc:T Pair.ManualStep2}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Classes="pair-value">
                                                    <SelectableTextBlock x:Name="PairAddressText" Text="{Binding NoctisServerUrl}" FontSize="14" FontWeight="SemiBold"/>
                                                </Border>
                                                <Button Classes="pill-action account-action" Command="{Binding CopyNoctisServerUrlCommand}" AutomationProperties.Name="{loc:T Settings.Copy}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <PathIcon Data="{StaticResource CopyIcon}" IsVisible="{Binding !NoctisServerUrlCopied}"/>
                                                        <PathIcon Data="{StaticResource CheckmarkIcon}" IsVisible="{Binding NoctisServerUrlCopied}"
                                                                  Foreground="{DynamicResource AccentColorBrush}"/>
                                                        <TextBlock Text="{loc:T Settings.Copy}" IsVisible="{Binding !NoctisServerUrlCopied}"/>
                                                        <TextBlock Text="{loc:T Settings.Copied}" IsVisible="{Binding NoctisServerUrlCopied}"
                                                                   Foreground="{DynamicResource AccentColorBrush}"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Classes="pair-step" ColumnDefinitions="Auto,*">
                                        <Border Classes="pair-step-number"><TextBlock Text="3"/></Border>
                                        <TextBlock Grid.Column="1" Text="{loc:T Pair.ManualStep3}"/>
                                    </Grid>
                                    <Grid Classes="pair-step" ColumnDefinitions="Auto,*">
                                        <Border Classes="pair-step-number"><TextBlock Text="4"/></Border>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <TextBlock Text="{loc:T Pair.ManualStep4}"/>
                                            <!-- Grouped as the phone groups it, line for line. -->
                                            <Border Classes="pair-value" HorizontalAlignment="Left">
                                                <SelectableTextBlock x:Name="PairSecurityCodeText" Text="{Binding NoctisServerFingerprintDisplay}" FontSize="14"
                                                                     FontWeight="SemiBold" FontFamily="Consolas,Menlo,monospace" LineHeight="22"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </controls:CollapsibleContent>
                    </StackPanel>
                </Border>

                <!-- (b) Your phones: one list, signed in or not, and when each last synced
                     (the server's device keys joined with the sync ledger's devices). -->
                <Border Classes="setting-row divided">
                    <StackPanel x:Name="PhoneDevicesList" Spacing="8">
                        <TextBlock Text="{loc:T AccountSync.SignedInDevices}" Classes="pair-caption"/>
                        <TextBlock Text="{loc:T AccountSync.NoSignedInDevices}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"
                                   IsVisible="{Binding !HasPhoneDevices}"/>
                        <ItemsControl ItemsSource="{Binding PhoneDevices}" IsVisible="{Binding HasPhoneDevices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="4"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SettingsViewModel+PhoneDeviceRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" MinHeight="30">
                                        <Panel Grid.Column="0" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="#4DC26B" IsVisible="{Binding IsSignedIn}"/>
                                            <Ellipse Width="7" Height="7" Fill="#808080" IsVisible="{Binding !IsSignedIn}"/>
                                        </Panel>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12" Opacity="0.55" VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Classes="pill-action" Cursor="Hand" IsVisible="{Binding IsSignedIn}"
                                                AutomationProperties.Name="{loc:T AccountSync.Remove}"
                                                ToolTip.Tip="{loc:T Phone.SignOutTip}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveSignedInDeviceCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{loc:T AccountSync.Remove}" FontSize="11" Foreground="#FF6B6B"/>
                                        </Button>
                                        <!-- Signed out already: only takes it off the list (the ledger keeps what it synced). -->
                                        <Button Grid.Column="3" Classes="pill-action" Cursor="Hand" IsVisible="{Binding !IsSignedIn}"
                                                AutomationProperties.Name="{loc:T Server.Remove}"
                                                ToolTip.Tip="{loc:T Phone.ForgetTip}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveSignedInDeviceCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{loc:T Server.Remove}" FontSize="11"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- (c) Sync: whether a phone that connects also shares favourites, ratings, play
                     counts and playlists. "Last synced" glides in and out with the switch. -->
                <Border Classes="setting-row divided">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{loc:T Sync.Title}" FontSize="13.5" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:T Sync.Description}" FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                            </StackPanel>
                            <controls:LottieToggle AutomationProperties.Name="{loc:T Sync.Title}" x:Name="PhoneSyncToggle" Grid.Column="1" IsChecked="{Binding SyncEnabled}" VerticalAlignment="Center"/>
                        </Grid>
                        <controls:CollapsibleContent x:Name="LastSyncedReveal" Lift="6" Motion="Glide"
                                                     IsOpen="{Binding SyncStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,10,0,0">
                                <!-- Drawn at its own 14px size (a stroked path, not a scaled 24-grid fill), so it stays crisp. -->
                                <Path x:Name="LastSyncedIcon" Data="{StaticResource SyncStatusGlyph}" Width="14" Height="14"
                                      Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.4"
                                      StrokeLineCap="Round" StrokeJoin="Round" Opacity="0.6" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LastSyncedLabel" Text="{Binding SyncStatusText}" FontSize="12" Opacity="0.7"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </controls:CollapsibleContent>
                    </StackPanel>
                </Border>

                <!-- (d) Advanced, folded: this PC's name and other music apps (Symfonium and the
                     like sign in with the email and the account's API key). -->
                <Border Classes="setting-row divided">
                    <StackPanel>
                        <Button x:Name="PhoneAdvancedHeader" Classes="pair-disclosure" Command="{Binding TogglePhoneAdvancedCommand}"
                                AutomationProperties.Name="{loc:T Settings.Tab.Advanced}" HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:T Settings.Tab.Advanced}" FontSize="13.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{loc:T Phone.AdvancedDesc}" FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Path Grid.Column="1" Data="M1,1 L6,6 L11,1" Width="12" Height="7" Stretch="None"
                                      Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.6"
                                      StrokeLineCap="Round" StrokeJoin="Round" Opacity="0.55" VerticalAlignment="Center"
                                      RenderTransformOrigin="50%,50%" Classes="pair-chevron" Classes.open="{Binding IsPhoneAdvancedOpen}"/>
                            </Grid>
                        </Button>
                        <controls:CollapsibleContent IsOpen="{Binding IsPhoneAdvancedOpen}" Lift="10" Motion="Glide">
                        <StackPanel x:Name="PhoneAdvancedBody" Spacing="16" Margin="0,14,0,0">
                            <Grid Classes="sub-setting" ColumnDefinitions="140,*">
                                <TextBlock Grid.Column="0" Text="{loc:T Sync.DeviceName}" VerticalAlignment="Center" FontSize="13"/>
                                <TextBox Grid.Column="1" Text="{Binding SyncDeviceName}" MaxWidth="320" HorizontalAlignment="Left" MinWidth="220"
                                         AutomationProperties.Name="{loc:T Sync.DeviceName}"
                                         CornerRadius="999" Padding="14,8" BorderThickness="1.5" MinHeight="0"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding HasPrimaryAccount}">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T Phone.OtherAppsTitle}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{loc:T Phone.OtherAppsDesc}" FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="pill-action account-action" VerticalAlignment="Center"
                                        AutomationProperties.Name="{loc:T AccountSync.NewApiKey}"
                                        Command="{Binding RegenerateServerApiKeyCommand}" CommandParameter="{Binding PrimaryAccount}"
                                        ToolTip.Tip="{loc:T Phone.NewApiKeyTip}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <PathIcon Data="{StaticResource AccountKeyIcon}"/>
                                        <TextBlock Text="{loc:T AccountSync.NewApiKey}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <!-- Freshly issued key: shown once, never stored in clear. Hidden behind dots until
                                 the eye is pressed; Copy works either way. -->
                            <controls:CollapsibleContent IsOpen="{Binding IsIssuedApiKeyOpen}" Lift="10" Motion="Glide">
                            <Border x:Name="ApiKeyPanel" Background="#18000000" CornerRadius="14" Padding="14,12">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource AccountKeyIcon}" Width="14" Height="14" Opacity="0.75" VerticalAlignment="Center"/>
                                        <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <Run Text="{loc:T Server.ApiKeyFor}"/> <Run Text="{Binding IssuedApiKeyUser}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Background="#22808080" CornerRadius="999" Padding="16,4,6,4" HorizontalAlignment="Left" MaxWidth="560">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2">
                                            <SelectableTextBlock x:Name="ApiKeyText" Text="{Binding DisplayedApiKey}" FontSize="13" FontFamily="Consolas,Menlo,monospace"
                                                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MinWidth="220"/>
                                            <Button Grid.Column="1" x:Name="ApiKeyRevealButton" Classes="account-icon-btn" Command="{Binding ToggleIssuedApiKeyRevealCommand}"
                                                    ToolTip.Tip="{loc:T AccountSync.ShowKeyTip}">
                                                <Panel>
                                                    <PathIcon Data="{StaticResource AccountEyeIcon}" IsVisible="{Binding !IsIssuedApiKeyRevealed}"/>
                                                    <PathIcon Data="{StaticResource AccountEyeOffIcon}" IsVisible="{Binding IsIssuedApiKeyRevealed}"/>
                                                </Panel>
                                            </Button>
                                            <Button Grid.Column="2" x:Name="ApiKeyCopyButton" Classes="account-icon-btn" Command="{Binding CopyIssuedApiKeyCommand}"
                                                    ToolTip.Tip="{loc:T Settings.Copy}">
                                                <Panel>
                                                    <PathIcon Data="{StaticResource CopyIcon}" IsVisible="{Binding !IssuedApiKeyCopied}"/>
                                                    <PathIcon Data="{StaticResource CheckmarkIcon}" IsVisible="{Binding IssuedApiKeyCopied}"
                                                              Foreground="{DynamicResource AccentColorBrush}"/>
                                                </Panel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{loc:T Server.ApiKeyOnce}" FontSize="11.5" Opacity="0.6" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="pill-action account-action" Command="{Binding HideIssuedApiKeyCommand}" AutomationProperties.Name="{loc:T Server.Done}">
                                            <TextBlock Text="{loc:T Server.Done}"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            </controls:CollapsibleContent>
                        </StackPanel>
                        </controls:CollapsibleContent>
                    </StackPanel>
                </Border>
            </StackPanel>
            </controls:CollapsibleContent>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.RemoteControl}" Margin="0,16,0,8"/>
            <Border x:Name="WebRemoteCard" Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="10">
                    <!-- Header + QR card share a spacing-free panel so the 10px gap folds with the body
                         (see the Crossfade block). -->
                    <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.WebRemote}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.ControlPlaybackFromPhone}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.WebRemote}"
                                              IsChecked="{Binding WebRemoteEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <controls:CollapsibleContent x:Name="WebRemoteBody" IsOpen="{Binding IsWebRemoteCardOpen}" Lift="10" Motion="Glide">
                    <Border Background="#18000000" CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
                        <StackPanel Spacing="8">
                            <!-- Running: QR thumbnail + connection details. The card shows the
                                 token-free URL; the full auth link lives in the QR, the copy
                                 button and the enlarge flyout (screenshots leaked a live key). -->
                            <Grid ColumnDefinitions="Auto,*"
                                  IsVisible="{Binding WebRemoteQr, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Button Grid.Column="0" Classes="qr-thumb" Padding="0" Background="Transparent" BorderThickness="0"
                                        VerticalAlignment="Center" ToolTip.Tip="{loc:T Settings.TapEnlargeTip}">
                                    <Border CornerRadius="6" ClipToBounds="True">
                                        <Image Source="{Binding WebRemoteQr}" Width="84" Height="84"/>
                                    </Border>
                                    <Button.Flyout>
                                        <Flyout Placement="RightEdgeAlignedTop">
                                            <StackPanel Spacing="10">
                                                <!-- Natural bitmap size: 1 module = 8 device px, no resampling —
                                                     the crispest render a camera can get off this screen. -->
                                                <Border CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Center">
                                                    <Image Source="{Binding WebRemoteQr}" Stretch="None"/>
                                                </Border>
                                                <SelectableTextBlock Text="{Binding WebRemoteUrl}" FontSize="12" Opacity="0.7"
                                                                     TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"/>
                                                <TextBlock Text="{loc:T Settings.IfPhoneBlocksLink}"
                                                           FontSize="11" Opacity="0.45" TextWrapping="Wrap"
                                                           TextAlignment="Center" MaxWidth="300"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T Settings.OPENPHONE}" FontSize="10" Opacity="0.5"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SelectableTextBlock Text="{Binding WebRemoteDisplayUrl}" FontSize="14" FontWeight="SemiBold"
                                                             VerticalAlignment="Center"/>
                                        <Button Classes="pill-action" Command="{Binding CopyWebRemoteUrlCommand}"
                                                AutomationProperties.Name="{loc:T Settings.Copy}"
                                                ToolTip.Tip="{loc:T Settings.CopyFullLinkIncludingTip}">
                                            <TextBlock Text="{loc:T Settings.Copy}" FontSize="11"/>
                                        </Button>
                                        <TextBlock Text="{loc:T Settings.Copied}" FontSize="11"
                                                   Foreground="{DynamicResource AccentColorBrush}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding WebRemoteUrlCopied}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                IsVisible="{Binding !WebRemotePhoneSeen}">
                                        <Ellipse Width="6" Height="6" Fill="#E5A34D" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:T Settings.WaitingPhoneScanCode}"
                                                   FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                IsVisible="{Binding WebRemotePhoneSeen}">
                                        <Ellipse Width="6" Height="6" Fill="#52B788" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:T Settings.PhoneConnected}"
                                                   FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <!-- Enabled but the server threw on start -->
                            <TextBlock Text="{Binding WebRemoteUrl}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                       IsVisible="{Binding WebRemoteStartFailed}"/>
                        </StackPanel>
                    </Border>
                    </controls:CollapsibleContent>
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <!-- Local API: loopback automation for Stream Deck / OBS / scripts (docs/LOCAL-API.md).
                 The token is masked until revealed, like the remote's key. -->
            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.PcApps}" Margin="0,16,0,8"/>
            <Border x:Name="LocalApiCard" Classes="setting-card group-card" Margin="0,0,0,10">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="10">
                    <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.LocalApi}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.LocalApiDesc}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.LocalApi}"
                                              IsChecked="{Binding LocalApiEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <controls:CollapsibleContent x:Name="LocalApiBody" IsOpen="{Binding LocalApiRunning}" Lift="10" Motion="Glide">
                    <Border Background="#18000000" CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings.LocalApiAddress}" FontSize="10" Opacity="0.5"/>
                                <SelectableTextBlock Text="{Binding LocalApiBaseUrl}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings.LocalApiToken}" FontSize="10" Opacity="0.5"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding LocalApiTokenDisplay}" FontSize="12"
                                               FontFamily="Consolas,Menlo,monospace"
                                               VerticalAlignment="Center"/>
                                    <Button Classes="pill-action" Command="{Binding ToggleLocalApiTokenRevealCommand}"
                                            Classes.revealed="{Binding LocalApiTokenRevealed}">
                                        <Button.Styles>
                                            <Style Selector="Button.pill-action">
                                                <Setter Property="AutomationProperties.Name" Value="{loc:T Settings.LocalApiShowToken}"/>
                                            </Style>
                                            <Style Selector="Button.pill-action.revealed">
                                                <Setter Property="AutomationProperties.Name" Value="{loc:T Settings.LocalApiHideToken}"/>
                                            </Style>
                                        </Button.Styles>
                                        <Panel>
                                            <TextBlock Text="{loc:T Settings.LocalApiShowToken}" FontSize="11"
                                                       IsVisible="{Binding !LocalApiTokenRevealed}"/>
                                            <TextBlock Text="{loc:T Settings.LocalApiHideToken}" FontSize="11"
                                                       IsVisible="{Binding LocalApiTokenRevealed}"/>
                                        </Panel>
                                    </Button>
                                    <Button Classes="pill-action" Command="{Binding CopyLocalApiTokenCommand}" AutomationProperties.Name="{loc:T Settings.Copy}">
                                        <TextBlock Text="{loc:T Settings.Copy}" FontSize="11"/>
                                    </Button>
                                    <Button Classes="pill-action" Command="{Binding RegenerateLocalApiTokenCommand}"
                                            AutomationProperties.Name="{loc:T Settings.LocalApiRegenerate}"
                                            ToolTip.Tip="{loc:T Settings.LocalApiRegenerateTip}">
                                        <TextBlock Text="{loc:T Settings.LocalApiRegenerate}" FontSize="11"/>
                                    </Button>
                                    <TextBlock Text="{loc:T Settings.Copied}" FontSize="11"
                                               Foreground="{DynamicResource AccentColorBrush}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding LocalApiTokenCopied}"/>
                                </StackPanel>
                                <!-- Full token glides open under the row on Show and folds away on
                                     Hide; the row above never re-flows. -->
                                <controls:CollapsibleContent IsOpen="{Binding LocalApiTokenRevealed}"
                                                             Lift="8" Motion="Glide">
                                    <Border Background="#14FFFFFF" CornerRadius="6"
                                            Padding="10,8" Margin="0,6,0,0">
                                        <SelectableTextBlock Text="{Binding LocalApiToken}" FontSize="12"
                                                             FontFamily="Consolas,Menlo,monospace"
                                                             TextWrapping="Wrap"/>
                                    </Border>
                                </controls:CollapsibleContent>
                            </StackPanel>
                            <TextBlock Text="{loc:T Settings.LocalApiWarning}"
                                       FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                            <TextBlock Text="{loc:T Settings.LocalApiDiscovery}"
                                       FontSize="11" Opacity="0.45" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    </controls:CollapsibleContent>
                    </StackPanel>
                    <TextBlock Text="{Binding LocalApiError}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               IsVisible="{Binding LocalApiError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="IntegrationsTabPanel" Classes="tab-page" IsVisible="{Binding IsIntegrationsTabVisible}" Spacing="4">
            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Discord}" Margin="0,2,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                            Background="#5865F2" Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <Viewbox Width="22" Height="22"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White"
                                      Data="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{loc:T Settings.DiscordRichPresence}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ShowCurrentSongDiscord}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="2"
                                          AutomationProperties.Name="{loc:T Settings.DiscordRichPresence}"
                                          IsChecked="{Binding DiscordRichPresenceEnabled}"
                                          VerticalAlignment="Center"
                                          Margin="12,0,0,0"/>
                </Grid>
            </Border>
            <controls:CollapsibleContent IsOpen="{Binding DiscordRichPresenceEnabled}" Lift="10" Motion="Glide">
            <StackPanel>
            <Border Classes="setting-row divided">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.ShowAlbumDiscord}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.AddAlbumNameUnder}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          AutomationProperties.Name="{loc:T Settings.ShowAlbumDiscord}"
                                          IsChecked="{Binding DiscordShowAlbum}"
                                          VerticalAlignment="Center"
                                          Margin="12,0,0,0"/>
                </Grid>
            </Border>
            <Border Classes="setting-row divided">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                        <TextBlock Text="{loc:T Settings.DiscordStatusDisplay}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.DiscordStatusDisplayHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              AutomationProperties.Name="{loc:T Settings.DiscordStatusDisplay}"
                              Classes="pill-list"
                              ItemsSource="{Binding DiscordStatusDisplayOptions}"
                              SelectedItem="{Binding SelectedDiscordStatusDisplayOption}"
                              MinWidth="160"
                              VerticalAlignment="Center"
                              CornerRadius="999"
                              Padding="14,8"/>
                </Grid>
            </Border>
            </StackPanel>
            </controls:CollapsibleContent>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Scrobbling}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                Width="40" Height="40" CornerRadius="10"
                                Background="#D51007"
                                Margin="0,0,14,0"
                                VerticalAlignment="Top">
                            <Viewbox Width="22" Height="22"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White"
                                          Data="M10.584 17.21l-.88-2.392s-1.43 1.594-3.573 1.594c-1.897 0-3.244-1.649-3.244-4.288 0-3.382 1.704-4.591 3.381-4.591 2.42 0 3.189 1.567 3.849 3.574l.88 2.749c.88 2.666 2.529 4.81 7.284 4.81 3.409 0 5.718-1.044 5.718-3.793 0-2.227-1.265-3.381-3.63-3.931l-1.758-.385c-1.21-.275-1.567-.77-1.567-1.595 0-.934.742-1.484 1.952-1.484 1.32 0 2.034.495 2.144 1.677l2.749-.33c-.22-2.474-1.924-3.492-4.729-3.492-2.474 0-4.893.935-4.893 3.932 0 1.87.907 3.051 3.189 3.601l1.87.44c1.402.33 1.869.907 1.869 1.704 0 1.017-.99 1.43-2.86 1.43-2.776 0-3.932-1.457-4.59-3.464l-.907-2.75c-1.155-3.573-2.997-4.893-6.653-4.893C2.144 5.333 0 7.89 0 12.233c0 4.18 2.144 6.434 5.993 6.434 3.106 0 4.591-1.457 4.591-1.457z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                                    VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="{loc:T Settings.LastFmScrobbling}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                            <TextBlock Text="{loc:T Settings.SendPlaysLastFm}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap" MaxWidth="560"
                                       HorizontalAlignment="Left"
                                       Margin="-2,0,0,0"/>
                            <!-- ACCOUNT line sits inline with title/description so it pulls up tight
                                 against the description instead of dropping into its own grid row. -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding LastFmUsername, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Margin="-2,2,0,0">
                                <TextBlock Text="{loc:T Settings.ACCOUNT}" FontSize="12" Opacity="0.45" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LastFmUsername}" FontSize="12" Opacity="0.85" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- GitHub #197: signed in on another computer only, and plays waiting to be sent. -->
                            <TextBlock Text="{Binding LastFmQueueNote}"
                                       IsVisible="{Binding LastFmQueueNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" MaxWidth="560"
                                       HorizontalAlignment="Left" Margin="-2,2,0,0"/>
                        </StackPanel>

                        <!-- Not connected state -->
                        <Button Grid.Column="2" Grid.Row="0"
                                IsVisible="{Binding !IsLastFmConnected}"
                                Content="{loc:T Settings.Connect}"
                                Classes="pill-action accent-btn"
                                Command="{Binding LoginLastFmCommand}"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Margin="0,0,0,4">
                            <Button.Template>
                                <ControlTemplate>
                                    <ContentPresenter Background="{DynamicResource AccentColorBrush}"
                                                      Foreground="{DynamicResource AccentForegroundBrush}"
                                                      CornerRadius="16"
                                                      Padding="14,8"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Content="{TemplateBinding Content}"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Status text removed -->

                        <!-- Logout button (top-right, when connected) -->
                        <Button Grid.Column="2" Grid.Row="0"
                                AutomationProperties.Name="{loc:T Settings.Logout}"
                                IsVisible="{Binding IsLastFmConnected}"
                                Command="{Binding LogoutLastFmCommand}"
                                Classes="pill-action"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.Logout}" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Enable Scrobbling (when connected) -->
                    <controls:CollapsibleContent IsOpen="{Binding IsLastFmConnected}" Lift="6">
                    <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" Margin="54,0,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="{loc:T Settings.EnableScrobbling}"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.EnableScrobbling}"
                                              IsChecked="{Binding LastFmScrobblingEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <!-- GitHub #177: Home's "From your Last.fm" mixes and Discover (read-only). -->
                    <Grid ColumnDefinitions="*,Auto" Margin="54,4,0,0">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{loc:T Settings.LastFmTaste.Title}" FontSize="13"/>
                            <TextBlock Text="{loc:T Settings.LastFmTaste.Line}"
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap" MaxWidth="460"
                                       HorizontalAlignment="Left"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.LastFmTaste.Title}"
                                              IsChecked="{Binding LastFmTasteEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <!-- GitHub #160: one-way play count import from LastFm (SettingsViewModel.PlayCountImport.cs). -->
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="54,4,0,0">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{loc:T Settings.PlayCountImport.Title}" FontSize="13"/>
                            <TextBlock Text="{loc:T Settings.PlayCountImport.Line}"
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap" MaxWidth="460"
                                       HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding LastFmImportStatus}"
                                       IsVisible="{Binding LastFmImportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="11" Opacity="0.85" TextWrapping="Wrap" MaxWidth="460"
                                       HorizontalAlignment="Left"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{loc:T Settings.PlayCountImport.ModeName}"
                                  Classes="pill-list"
                                  ItemsSource="{Binding PlayCountImportModeOptions}"
                                  SelectedItem="{Binding SelectedPlayCountImportModeOption}"
                                  IsEnabled="{Binding !IsPlayCountImportRunning}"
                                  MinWidth="160"
                                  VerticalAlignment="Center"
                                  CornerRadius="999"
                                  Padding="14,8"
                                  Margin="0,0,8,0"/>
                        <Button Grid.Column="2"
                                AutomationProperties.Name="{loc:T Settings.PlayCountImport.Title}"
                                IsVisible="{Binding !IsLastFmImportRunning}"
                                Command="{Binding ImportLastFmPlayCountsCommand}"
                                Classes="pill-action"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.PlayCountImport.Button}" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                        <Button Grid.Column="2"
                                AutomationProperties.Name="{loc:T Settings.PlayCountImport.Cancel}"
                                IsVisible="{Binding IsLastFmImportRunning}"
                                Command="{Binding CancelPlayCountImportCommand}"
                                Classes="pill-action"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.PlayCountImport.Cancel}" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                    <!-- GitHub #160: background play count sync (SettingsViewModel.PlayCountImport.cs). -->
                    <Grid ColumnDefinitions="*,Auto" Margin="54,4,0,0">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{loc:T Settings.PlayCountImport.Sync.Title}" FontSize="13"/>
                            <TextBlock Text="{loc:T Settings.PlayCountImport.Sync.Line}"
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap" MaxWidth="460"
                                       HorizontalAlignment="Left"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.PlayCountImport.Sync.Title}"
                                              IsChecked="{Binding LastFmPlayCountSync}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    </StackPanel>
                    </controls:CollapsibleContent>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                        <!-- Official multi-colour ListenBrainz logo (transparent PNG). It's the
                             hexagonal brand mark, so it stands on its own at the same 40×40 footprint
                             as the Discord / Last.fm tiles rather than sitting on a colour fill. -->
                        <Image Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                               Width="40" Height="40"
                               Margin="0,0,14,0"
                               VerticalAlignment="Top"
                               Source="avares://Noctis.UI/Assets/Icons/ListenBrainz ICON.png"
                               RenderOptions.BitmapInterpolationMode="HighQuality"/>

                        <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                                    VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="{loc:T Settings.ListenBrainzScrobbling}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                            <TextBlock Text="{loc:T Settings.SendPlaysListenBrainz}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap" MaxWidth="560"
                                       HorizontalAlignment="Left"
                                       Margin="-2,0,0,0"/>

                            <!-- ACCOUNT line sits inline with the title/description block so it pulls
                                 up tight against the description instead of dropping into its own grid row. -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding ListenBrainzUsername, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Margin="-2,2,0,0">
                                <TextBlock Text="{loc:T Settings.ACCOUNT}" FontSize="12" Opacity="0.45" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ListenBrainzUsername}" FontSize="12" Opacity="0.85" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- Self-hosted server in use (Koito, Maloja, …); hidden for the official one. -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding ListenBrainzServerDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Margin="-2,0,0,0">
                                <TextBlock Text="{loc:T Settings.ListenBrainzServer}" FontSize="12" Opacity="0.45" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ListenBrainzServerDisplay}" FontSize="12" Opacity="0.85" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                            </StackPanel>
                            <!-- GitHub #197: signed in on another computer only, and plays waiting to be sent. -->
                            <TextBlock Text="{Binding ListenBrainzQueueNote}"
                                       IsVisible="{Binding ListenBrainzQueueNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" MaxWidth="560"
                                       HorizontalAlignment="Left" Margin="-2,2,0,0"/>

                            <!-- Token row lives inside the same StackPanel as the title so it sits
                                 right under the description instead of leaving a gap. The Connect
                                 button is hoisted to column 2 (top-right) to match the Last.fm card. -->
                            <controls:CollapsibleContent IsOpen="{Binding !IsListenBrainzConnected}" Lift="6" Margin="-2,0,0,0">
                            <StackPanel
                                        Margin="0,6,0,0"
                                        Spacing="4">
                                <TextBox x:Name="ListenBrainzTokenBox"
                                         AutomationProperties.Name="{loc:T Settings.ListenBrainzUserToken}"
                                         Classes="metadata-info-field"
                                         Text="{Binding ListenBrainzToken}"
                                         PasswordChar="•"
                                         Watermark="{loc:T Settings.ListenBrainzUserToken}"
                                         Width="280"
                                         HorizontalAlignment="Left"/>
                                <!-- GitHub #118: optional ListenBrainz-compatible server (blank = listenbrainz.org). -->
                                <TextBox x:Name="ListenBrainzApiUrlBox"
                                         AutomationProperties.Name="{loc:T Settings.ListenBrainzApiUrl}"
                                         Classes="metadata-info-field"
                                         Text="{Binding ListenBrainzApiUrl}"
                                         Watermark="{loc:T Settings.ListenBrainzApiUrl}"
                                         Width="280"
                                         HorizontalAlignment="Left"/>
                                <TextBlock Text="{loc:T Settings.ListenBrainzApiUrlHint}"
                                           FontSize="11" Opacity="0.5" TextWrapping="Wrap" MaxWidth="420"
                                           HorizontalAlignment="Left"
                                           Margin="8,0,0,0"/>
                                <!-- Inline validation error (e.g. "Token required"), semantically red. -->
                                <TextBlock Text="{Binding ListenBrainzError}"
                                           IsVisible="{Binding ListenBrainzError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="#E74856"
                                           FontSize="11"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                            </controls:CollapsibleContent>
                        </StackPanel>

                        <!-- Not connected state (top-right, mirrors the Last.fm Connect button) -->
                        <Button Grid.Column="2" Grid.Row="0"
                                IsVisible="{Binding !IsListenBrainzConnected}"
                                Content="{loc:T Settings.Connect}"
                                Classes="pill-action accent-btn"
                                Command="{Binding TestListenBrainzCommand}"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Margin="0,0,0,4">
                            <Button.Template>
                                <ControlTemplate>
                                    <ContentPresenter Background="{DynamicResource AccentColorBrush}"
                                                      Foreground="{DynamicResource AccentForegroundBrush}"
                                                      CornerRadius="16"
                                                      Padding="14,8"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Content="{TemplateBinding Content}"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Logout button (top-right, when connected) -->
                        <Button Grid.Column="2" Grid.Row="0"
                                AutomationProperties.Name="{loc:T Settings.Logout}"
                                IsVisible="{Binding IsListenBrainzConnected}"
                                Command="{Binding LogoutListenBrainzCommand}"
                                Classes="pill-action"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.Logout}" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Enable Scrobbling (when connected) -->
                    <controls:CollapsibleContent IsOpen="{Binding IsListenBrainzConnected}" Lift="6">
                    <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" Margin="54,0,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="{loc:T Settings.EnableScrobbling}"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.EnableScrobbling}"
                                              IsChecked="{Binding ListenBrainzScrobblingEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <!-- GitHub #160: one-way play count import from ListenBrainz (SettingsViewModel.PlayCountImport.cs). -->
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="54,4,0,0">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{loc:T Settings.PlayCountImport.Title}" FontSize="13"/>
                            <TextBlock Text="{loc:T Settings.PlayCountImport.Line}"
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap" MaxWidth="460"
                                       HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding ListenBrainzImportStatus}"
                                       IsVisible="{Binding ListenBrainzImportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="11" Opacity="0.85" TextWrapping="Wrap" MaxWidth="460"
                                       HorizontalAlignment="Left"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{loc:T Settings.PlayCountImport.ModeName}"
                                  Classes="pill-list"
                                  ItemsSource="{Binding PlayCountImportModeOptions}"
                                  SelectedItem="{Binding SelectedPlayCountImportModeOption}"
                                  IsEnabled="{Binding !IsPlayCountImportRunning}"
                                  MinWidth="160"
                                  VerticalAlignment="Center"
                                  CornerRadius="999"
                                  Padding="14,8"
                                  Margin="0,0,8,0"/>
                        <Button Grid.Column="2"
                                AutomationProperties.Name="{loc:T Settings.PlayCountImport.Title}"
                                IsVisible="{Binding !IsListenBrainzImportRunning}"
                                Command="{Binding ImportListenBrainzPlayCountsCommand}"
                                Classes="pill-action"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.PlayCountImport.Button}" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                        <Button Grid.Column="2"
                                AutomationProperties.Name="{loc:T Settings.PlayCountImport.Cancel}"
                                IsVisible="{Binding IsListenBrainzImportRunning}"
                                Command="{Binding CancelPlayCountImportCommand}"
                                Classes="pill-action"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.PlayCountImport.Cancel}" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                    <!-- GitHub #160: background play count sync (SettingsViewModel.PlayCountImport.cs). -->
                    <Grid ColumnDefinitions="*,Auto" Margin="54,4,0,0">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{loc:T Settings.PlayCountImport.Sync.Title}" FontSize="13"/>
                            <TextBlock Text="{loc:T Settings.PlayCountImport.Sync.Line}"
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap" MaxWidth="460"
                                       HorizontalAlignment="Left"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.PlayCountImport.Sync.Title}"
                                              IsChecked="{Binding ListenBrainzPlayCountSync}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    </StackPanel>
                    </controls:CollapsibleContent>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <Border Classes="setting-card group-card" Margin="0,14,0,10">
            <StackPanel>
            <Border Classes="setting-row" IsVisible="{Binding IsTidalAvailable}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0"
                            Width="40" Height="40" CornerRadius="10"
                            Background="#000000" BorderBrush="#33FFFFFF" BorderThickness="1"
                            Margin="0,0,14,0"
                            VerticalAlignment="Top">
                        <!-- TIDAL's three-diamond mark, drawn as paths so it stays crisp at any scale. -->
                        <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="16">
                                <Path Fill="White" Data="M4,0 L8,4 L4,8 L0,4 Z"/>
                                <Path Fill="White" Data="M12,0 L16,4 L12,8 L8,4 Z"/>
                                <Path Fill="White" Data="M20,0 L24,4 L20,8 L16,4 Z"/>
                                <Path Fill="White" Data="M12,8 L16,12 L12,16 L8,12 Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                        <TextBlock Text="{loc:T Settings.TidalTitle}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:T Settings.TidalDescription}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap" MaxWidth="560"
                                   HorizontalAlignment="Left" Margin="-2,0,0,0"/>
                        <TextBlock Text="{loc:T Settings.TidalConnected}" FontSize="12" Opacity="0.85"
                                   IsVisible="{Binding IsTidalConnected}" Margin="-2,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            IsVisible="{Binding !IsTidalConnected}"
                            IsEnabled="{Binding !IsTidalBusy}"
                            Content="{loc:T Settings.Connect}"
                            Classes="pill-action accent-btn"
                            Command="{Binding ConnectTidalCommand}"
                            Padding="14,8" CornerRadius="999" Cursor="Hand" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate>
                                <ContentPresenter Background="{DynamicResource AccentColorBrush}"
                                                  Foreground="{DynamicResource AccentForegroundBrush}"
                                                  CornerRadius="16" Padding="14,8"
                                                  FontSize="13" FontWeight="SemiBold"
                                                  Content="{TemplateBinding Content}"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2"
                            AutomationProperties.Name="{loc:T Settings.Disconnect}"
                            IsVisible="{Binding IsTidalConnected}"
                            Command="{Binding DisconnectTidalCommand}"
                            Classes="pill-action"
                            Padding="14,8" CornerRadius="999" Cursor="Hand" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Settings.Disconnect}" FontSize="13" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>
            </StackPanel>
            </Border>

            <Border Classes="setting-card" Margin="0,14,0,10">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="{loc:T Settings.MusicServer}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                            <TextBlock Text="{loc:T Settings.StreamLibraryFromJellyfin}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap" MaxWidth="560"
                                       HorizontalAlignment="Left" Margin="-2,0,0,0"/>

                            <!-- Connected summary -->
                            <controls:CollapsibleContent IsOpen="{Binding IsMediaServerConnected}" Lift="6" Margin="-2,0,0,0">
                            <StackPanel Spacing="3" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="server-field-label" Text="{loc:T Settings.TYPE}" Width="68" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MediaServerType}" FontSize="12" Opacity="0.85" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="server-field-label" Text="{loc:T Settings.SERVER}" Width="68" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MediaServerUrl}" FontSize="12" Opacity="0.85" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="server-field-label" Text="{loc:T Settings.ACCOUNT}" Width="68" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MediaServerUsername}" FontSize="12" Opacity="0.85" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            </controls:CollapsibleContent>

                            <!-- Connection form (hidden while connected): labeled 2×2 grid,
                                 Enter in any field submits. -->
                            <!-- Stretched across the column so the star columns split the width
                                 and long input scrolls inside the boxes. Left-aligned, the grid
                                 sized its star columns to content and the boxes resized on every
                                 keystroke. -->
                            <controls:CollapsibleContent IsOpen="{Binding !IsMediaServerConnected}" Lift="6" Margin="-2,0,0,0">
                            <Grid
                                  ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto"
                                  HorizontalAlignment="Stretch" Margin="0,10,0,0">
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,0,10">
                                    <TextBlock Classes="server-field-label" Text="{loc:T Settings.SERVERTYPE}"/>
                                    <Border Classes="server-pill-shell">
                                        <ComboBox Classes="pill-list server-pill"
                                                  AutomationProperties.Name="{loc:T Settings.SERVERTYPE}"
                                                  ItemsSource="{Binding MediaServerTypeOptions}"
                                                  SelectedItem="{Binding MediaServerType}"
                                                  IsEnabled="{Binding !IsMediaServerBusy}"
                                                  HorizontalAlignment="Stretch"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4" Margin="0,0,0,10">
                                    <TextBlock Classes="server-field-label" Text="{loc:T Settings.SERVERADDRESS}"/>
                                    <TextBox Classes="metadata-info-field"
                                             AutomationProperties.Name="{loc:T Settings.SERVERADDRESS}"
                                             Text="{Binding MediaServerUrl}"
                                             Watermark="{loc:T Settings.HttpsMusicExampleCom}"
                                             IsEnabled="{Binding !IsMediaServerBusy}">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding ConnectMediaServerCommand}"/>
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                    <TextBlock Classes="server-field-label" Text="{loc:T Settings.USERNAME}"/>
                                    <TextBox Classes="metadata-info-field"
                                             AutomationProperties.Name="{loc:T Settings.USERNAME}"
                                             Text="{Binding MediaServerUsername}"
                                             Watermark="{loc:T Settings.UsernameWatermark}"
                                             IsEnabled="{Binding !IsMediaServerBusy}">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding ConnectMediaServerCommand}"/>
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                                    <TextBlock Classes="server-field-label" Text="{loc:T Settings.PASSWORD}"/>
                                    <TextBox Classes="metadata-info-field"
                                             AutomationProperties.Name="{loc:T Settings.PASSWORD}"
                                             Text="{Binding MediaServerPassword}"
                                             PasswordChar="•"
                                             Watermark="{loc:T Settings.PasswordWatermark}"
                                             IsEnabled="{Binding !IsMediaServerBusy}">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding ConnectMediaServerCommand}"/>
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                </StackPanel>
                            </Grid>
                            </controls:CollapsibleContent>

                            <!-- Status line: dot follows the state (green connected, red error),
                                 spinner while a connection attempt is running. -->
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="-2,8,0,0">
                                <Ellipse Classes="server-status-dot"
                                         Classes.connected="{Binding IsMediaServerConnected}"
                                         Classes.error="{Binding HasMediaServerError}"
                                         IsVisible="{Binding !IsMediaServerBusy}"
                                         VerticalAlignment="Center"/>
                                <Ellipse Classes="loading-spinner" Width="11" Height="11"
                                         IsVisible="{Binding IsMediaServerBusy}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Classes="server-status"
                                           Classes.error="{Binding HasMediaServerError}"
                                           Text="{Binding MediaServerStatusText}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Connect (top-right, mirrors the account cards) -->
                        <Button Grid.Column="1"
                                AutomationProperties.Name="{loc:T Settings.Connect}"
                                IsVisible="{Binding !IsMediaServerConnected}"
                                IsEnabled="{Binding !IsMediaServerBusy}"
                                Classes="pill-action accent-btn"
                                Command="{Binding ConnectMediaServerCommand}"
                                Padding="14,8" CornerRadius="999" Cursor="Hand"
                                VerticalAlignment="Top" Margin="0,4,0,0">
                            <Button.Template>
                                <ControlTemplate>
                                    <ContentPresenter Background="{DynamicResource AccentColorBrush}"
                                                      Foreground="{DynamicResource AccentForegroundBrush}"
                                                      CornerRadius="16"
                                                      Padding="14,8"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Content="{TemplateBinding Content}"/>
                                </ControlTemplate>
                            </Button.Template>
                            <Panel>
                                <TextBlock Text="{loc:T Settings.Connect}" IsVisible="{Binding !IsMediaServerBusy}"/>
                                <TextBlock Text="{loc:T Settings.Connecting}" IsVisible="{Binding IsMediaServerBusy}"/>
                            </Panel>
                        </Button>

                        <Button Grid.Column="1"
                                AutomationProperties.Name="{loc:T Settings.Disconnect}"
                                IsVisible="{Binding IsMediaServerConnected}"
                                Command="{Binding DisconnectMediaServerCommand}"
                                Classes="pill-action"
                                Padding="14,8" CornerRadius="999" Cursor="Hand"
                                VerticalAlignment="Top" Margin="0,4,0,0">
                            <TextBlock Text="{loc:T Settings.Disconnect}" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- More integrations: the way to the Plugins page, where plugins add services and features. -->
            <Border x:Name="MoreIntegrationsCard" Classes="setting-card" Margin="0,10,0,10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Integrations.More.Title}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Integrations.More.Line}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BrowsePluginsButton" Classes="pill-action"
                            AutomationProperties.Name="{loc:T Integrations.More.Browse}"
                            Command="{Binding SelectSettingsTabCommand}"
                            CommandParameter="{x:Static vm:SettingsViewModel.TabPlugins}"
                            Height="34" Padding="14,0" VerticalContentAlignment="Center" CornerRadius="999" Cursor="Hand" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Integrations.More.Browse}" FontSize="12" FontWeight="SemiBold"/>
                    </Button>
                </Grid>
            </Border>
            </StackPanel>

            <StackPanel x:Name="PluginsTabPanel" Classes="tab-page" IsVisible="{Binding IsPluginsTabVisible}" Spacing="4">
            <!-- The grid: trust switch, search and actions, Official Noctis plugins, Community
                 plugins, Make your own plugin. A card opens the plugin's page (PluginDetailPage)
                 in place; the two slide past each other (plugin-subpage, from-left / from-right). -->
            <StackPanel x:Name="PluginsListPage" Classes="plugin-subpage from-left" IsVisible="{Binding IsPluginGridVisible}" Spacing="4">
            <!-- Community plugins: restricted mode when off (Obsidian-style). First on the page: it
                 decides whether anything below can run. Compact: one line and the switch. -->
            <Border x:Name="CommunityPluginsCard" Classes="setting-card plugin-trust-card" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="1" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Plugins.CommunityTitle}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:T Plugins.CommunityLine}" FontSize="11.5" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1" x:Name="CommunityPluginsToggle"
                                          AutomationProperties.Name="{loc:T Plugins.CommunityTitle}"
                                          IsChecked="{Binding CommunityPluginsEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Search (both sections) and the small actions: Install from file, the plugins folder
                 (its path in the tooltip), refresh (the folder and the list). On a narrow pane the
                 actions drop under the search box (SettingsView.axaml.cs LayoutPluginsHeader). -->
            <Grid x:Name="PluginsHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,4">
                <TextBox x:Name="PluginSearchBox" Grid.Column="0" Classes="settings-search plugin-search"
                         Watermark="{loc:T Plugins.Search}"
                         AutomationProperties.Name="{loc:T Plugins.Search}"
                         Text="{Binding PluginSearchText, Mode=TwoWay}"
                         VerticalContentAlignment="Center" Height="34">
                    <TextBox.InnerLeftContent>
                        <PathIcon Data="{StaticResource SearchIcon}" Width="14" Height="14" Opacity="0.5" Margin="12,0,0,0"/>
                    </TextBox.InnerLeftContent>
                </TextBox>
                <WrapPanel x:Name="PluginsHeaderActions" Grid.Column="1" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="InstallPluginFromFileButton" Classes="pill-action"
                            AutomationProperties.Name="{loc:T Plugins.InstallFromFile}"
                            Command="{Binding InstallPluginFromFileCommand}"
                            Height="34" Padding="14,0" VerticalContentAlignment="Center" CornerRadius="999" Cursor="Hand" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Plugins.InstallFromFile}" FontSize="12" FontWeight="SemiBold"/>
                    </Button>
                    <Button x:Name="OpenPluginsFolderButton" Classes="icon-chip"
                            AutomationProperties.Name="{loc:T Plugins.OpenFolder}"
                            ToolTip.Tip="{Binding PluginsFolderTip}" Command="{Binding OpenPluginsFolderCommand}">
                        <Viewbox Width="15" Height="15">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource PluginsFolderGlyph}" Stroke="{Binding $parent[Button].Foreground}"
                                      StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- Dims while the list loads. -->
                    <Button x:Name="RefreshPluginsButton" Classes="icon-chip"
                            AutomationProperties.Name="{loc:T Plugins.Refresh}"
                            ToolTip.Tip="{loc:T Plugins.Refresh}" Command="{Binding RefreshPluginsCommand}"
                            IsEnabled="{Binding !IsOfficialPluginsLoading}">
                        <Panel>
                            <Viewbox Width="15" Height="15" IsVisible="{Binding !IsRefreshingPlugins}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource PluginsRefreshGlyph}" Stroke="{Binding $parent[Button].Foreground}"
                                          StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <controls:LoadingSpinner Width="15" Height="15" Thickness="2"
                                                     Foreground="{Binding $parent[Button].Foreground}"
                                                     IsVisible="{Binding IsRefreshingPlugins}" IsActive="{Binding IsRefreshingPlugins}"/>
                        </Panel>
                    </Button>
                </WrapPanel>
            </Grid>
            <!-- After a refresh: a check and "Refreshed · 8 plugins", gone again after a few seconds. -->
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="14,2,0,4"
                        IsVisible="{Binding PluginsStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <PathIcon Data="{StaticResource CheckmarkIcon}" Width="11" Height="11"
                          Foreground="{DynamicResource AccentColorBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding PluginsStatus}" FontSize="12" FontWeight="SemiBold" Opacity="0.75"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Built-in Features (Discord, Mistery 11-02): parts of Noctis behind one switch each, like
                 plugins that ship on. A row is the feature's own setting where one existed (Discord,
                 scrobbling, Inbox, animated artwork, NEW badge). Hidden while searching plugins. -->
            <StackPanel x:Name="BuiltInFeaturesSection" IsVisible="{Binding ShowBuiltInFeatures}">
                <StackPanel Spacing="2" Margin="4,12,0,10">
                    <TextBlock Classes="section-title" Text="{loc:T Features.Section}" Margin="0" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:T Features.SectionLine}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Classes="setting-card group-card" Margin="0,0,0,4">
                    <ItemsControl x:Name="BuiltInFeaturesList" Classes="row-list" ItemsSource="{Binding BuiltInFeatures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BuiltInFeatureRow">
                                <Border Classes="setting-row">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Margin="0,0,14,0"
                                                Background="#22808080" VerticalAlignment="Center">
                                            <PathIcon Data="{Binding IconKey, Converter={x:Static helpers:IconKeyConverter.Instance}}"
                                                      Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Line}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <controls:LottieToggle Grid.Column="2"
                                                              AutomationProperties.Name="{Binding Title}"
                                                              IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanToggle}"
                                                              VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- Official Noctis plugins: the list's plugins by Noctis (plugins/index.json, fetched when
                 this page opens). Always the verified mark. -->
            <StackPanel x:Name="OfficialPluginsSection" IsVisible="{Binding ShowOfficialSection}">
                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left" Margin="4,12,0,10">
                    <TextBlock Classes="section-title" Text="{loc:T Plugins.OfficialSection}" Margin="0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Border Grid.Column="1" Margin="8,0,0,0" Classes="plugin-count" IsVisible="{Binding HasOfficialCards}">
                        <TextBlock Text="{Binding OfficialCountText}"/>
                    </Border>
                </Grid>
                <TextBlock Text="{loc:T Plugins.Get.Empty}" FontSize="12" Opacity="0.5" Margin="14,0,0,10"
                           IsVisible="{Binding ShowOfficialEmpty}"/>
                <ItemsControl x:Name="OfficialPluginsGrid" ClipToBounds="False" ItemsSource="{Binding OfficialCards}"
                              ItemTemplate="{StaticResource PluginCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).PluginGridColumns}"
                                         ColumnSpacing="12" RowSpacing="12"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- Community plugins: made by users and credited by name (listed ones, and whatever was
                 installed from a file or dropped in the folder). Never the verified mark. -->
            <StackPanel x:Name="CommunityPluginsSection" IsVisible="{Binding ShowCommunitySection}">
                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left" Margin="4,18,0,10">
                    <TextBlock Classes="section-title" Text="{loc:T Plugins.CommunitySection}" Margin="0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Border Grid.Column="1" Margin="8,0,0,0" Classes="plugin-count" IsVisible="{Binding HasCommunityCards}">
                        <TextBlock Text="{Binding CommunityCountText}"/>
                    </Border>
                </Grid>
                <TextBlock x:Name="CommunityPluginsEmpty" Text="{loc:T Plugins.CommunityEmpty}" FontSize="12" Opacity="0.5" Margin="14,0,0,10"
                           TextWrapping="Wrap" IsVisible="{Binding ShowCommunityEmpty}"/>
                <ItemsControl x:Name="CommunityPluginsGrid" ClipToBounds="False" ItemsSource="{Binding CommunityCards}"
                              ItemTemplate="{StaticResource PluginCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).PluginGridColumns}"
                                         ColumnSpacing="12" RowSpacing="12"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <TextBlock x:Name="PluginSearchEmpty" Text="{loc:T Plugins.SearchEmpty}" FontSize="12.5" Opacity="0.55"
                       HorizontalAlignment="Center" Margin="0,24,0,16" IsVisible="{Binding ShowNoPluginMatches}"/>

            <!-- Make your own plugin: the way in for people who want to build one. Three plain steps
                 (a row; stacked when the pane is narrow, see SettingsView.axaml.cs LayoutMakePluginSteps),
                 then the website guide and the submission form (docs/PLUGINS.md, "Submitting a plugin"). -->
            <Border x:Name="MakePluginCard" Classes="setting-card" Margin="0,22,0,10">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Plugins.Make.Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:T Plugins.Make.Line}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid x:Name="MakePluginSteps" ColumnDefinitions="*,*,*">
                        <Grid.Styles>
                            <Style Selector="Border.make-step-n">
                                <Setter Property="Width" Value="22"/>
                                <Setter Property="Height" Value="22"/>
                                <Setter Property="CornerRadius" Value="999"/>
                                <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Top"/>
                                <Setter Property="Margin" Value="0,0,10,0"/>
                            </Style>
                            <Style Selector="Border.make-step-n > TextBlock">
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </Grid.Styles>
                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                            <Border Classes="make-step-n"><TextBlock Text="1"/></Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{loc:T Plugins.Make.Step1Title}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:T Plugins.Make.Step1}" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="16,0,0,0">
                            <Border Classes="make-step-n"><TextBlock Text="2"/></Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{loc:T Plugins.Make.Step2Title}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:T Plugins.Make.Step2}" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Column="2" ColumnDefinitions="Auto,*" Margin="16,0,0,0">
                            <Border Classes="make-step-n"><TextBlock Text="3"/></Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{loc:T Plugins.Make.Step3Title}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:T Plugins.Make.Step3}" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <!-- Guide first (read, then submit): the tab order follows. -->
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                        <Button x:Name="ReadPluginGuideButton" Classes="pill-action"
                                AutomationProperties.Name="{loc:T Plugins.Make.Guide}"
                                Command="{Binding OpenPluginGuideCommand}"
                                Height="34" Padding="14,0" VerticalContentAlignment="Center" CornerRadius="999" Cursor="Hand">
                            <TextBlock Text="{loc:T Plugins.Make.Guide}" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                        <Button x:Name="SubmitPluginButton" Classes="accent-pill"
                                AutomationProperties.Name="{loc:T Plugins.Submit}"
                                Command="{Binding SubmitPluginCommand}"
                                Height="34" Padding="14,0" VerticalContentAlignment="Center" CornerRadius="999" Cursor="Hand">
                            <TextBlock Text="{loc:T Plugins.Submit}" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- A plugin's own page (PluginPageTemplate), in place of the grid. -->
            <StackPanel x:Name="PluginDetailPage" Classes="plugin-subpage from-right" IsVisible="{Binding IsPluginPageVisible}">
                <ContentControl x:Name="PluginDetailHost" Content="{Binding SelectedPluginCard}"
                                ContentTemplate="{StaticResource PluginPageTemplate}"/>
            </StackPanel>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- ABOUT                                               -->
            <!-- ═══════════════════════════════════════════════════ -->

            <StackPanel x:Name="StatisticsTabPanel" Classes="tab-page" IsVisible="{Binding IsStatisticsTabVisible}" Spacing="4">

            <!-- One card, two quiet rows of big numbers; the format mix is a pill strip under the library row. -->
            <Border Classes="setting-card" Padding="26,22">
                <StackPanel Spacing="18">
                    <TextBlock Text="{loc:T Settings.MusicLibrary}" FontSize="12" FontWeight="SemiBold" Opacity="0.55"/>
                    <UniformGrid Columns="4">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding TotalSongs}" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="{loc:T Settings.Songs}" FontSize="12" Opacity="0.55"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding TotalAlbums}" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="{loc:T Settings.Albums}" FontSize="12" Opacity="0.55"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding TotalArtists}" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="{loc:T Settings.Artists}" FontSize="12" Opacity="0.55"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding TotalListeningTime}" FontSize="28" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{loc:T Settings.TotalDuration}" FontSize="12" Opacity="0.55"/>
                        </StackPanel>
                    </UniformGrid>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-6,0,-6">
                        <Border Classes="stat-pill">
                            <TextBlock FontSize="11.5" Height="14" LineHeight="14" VerticalAlignment="Center"><Run Text="{Binding LosslessCount}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{loc:T Settings.Lossless}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/></TextBlock>
                        </Border>
                        <Border Classes="stat-pill">
                            <TextBlock FontSize="11.5" Height="14" LineHeight="14" VerticalAlignment="Center"><Run Text="{Binding HiResCount}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{loc:T Settings.HiResLossless}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/></TextBlock>
                        </Border>
                        <Border Classes="stat-pill">
                            <TextBlock FontSize="11.5" Height="14" LineHeight="14" VerticalAlignment="Center"><Run Text="{Binding LossyCount}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{loc:T Settings.Lossy}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/></TextBlock>
                        </Border>
                        <Border Classes="stat-pill">
                            <TextBlock FontSize="11.5" Height="14" LineHeight="14" VerticalAlignment="Center"><Run Text="{Binding TotalPlaylists}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{loc:T Settings.Playlists2}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/></TextBlock>
                        </Border>
                    </WrapPanel>

                    <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <TextBlock Text="{loc:T Settings.YourListening}" FontSize="12" FontWeight="SemiBold" Opacity="0.55"/>
                    <UniformGrid Columns="4">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding TotalPlays}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="{loc:T Settings.TotalPlays}" FontSize="12" Opacity="0.55"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <!-- Shrinks to fit instead of "4d 9h 2..." (seen in Discord screenshots 11-06). -->
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,0,16,0">
                                <TextBlock Text="{Binding TimeListened}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                            </Viewbox>
                            <TextBlock Text="{loc:T Settings.TimeListened}" FontSize="12" Opacity="0.55"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding AvgTrackLength}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="{loc:T Settings.AvgTrackLength}" FontSize="12" Opacity="0.55"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding LikedTracks}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="{loc:T Settings.LikedSongs}" FontSize="12" Opacity="0.55"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Top played: one card, two columns split by a hairline, the full-page link in the header. -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,8">
                <TextBlock Grid.Column="0" Classes="section-title" Text="{loc:T Settings.Section.TopPlayed}" Margin="0" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Classes="pill-action" Command="{Binding OpenStatisticsPageCommand}" Padding="12,5" CornerRadius="999" Cursor="Hand" AutomationProperties.Name="{loc:T Settings.ViewAllStats}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{loc:T Settings.ViewAllStats}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <PathIcon Data="{StaticResource ChevronRightIcon}" Width="9" Height="9" VerticalAlignment="Center" Opacity="0.7"/>
                    </StackPanel>
                </Button>
            </Grid>
            <Border Classes="setting-card" Padding="22,18">
                <Grid ColumnDefinitions="*,1,*">
                    <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,20,0">
                        <TextBlock Text="{loc:T Settings.TopArtists}" FontSize="12" FontWeight="SemiBold" Opacity="0.55"/>
                        <TextBlock Text="{loc:T Settings.PlaySomeTracksSee}" FontSize="13" Opacity="0.4" IsVisible="{Binding !TopArtists.Count}"/>
                        <ItemsControl ItemsSource="{Binding TopArtists}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StatItem">
                                    <Grid ColumnDefinitions="24,*,Auto" Margin="0,5">
                                        <TextBlock Grid.Column="0" Text="{Binding Rank}" FontSize="12" FontWeight="SemiBold" Opacity="0.35" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
                    <StackPanel Grid.Column="2" Spacing="10" Margin="20,0,0,0">
                        <TextBlock Text="{loc:T Settings.TopAlbums}" FontSize="12" FontWeight="SemiBold" Opacity="0.55"/>
                        <TextBlock Text="{loc:T Settings.PlaySomeTracksSee2}" FontSize="13" Opacity="0.4" IsVisible="{Binding !TopAlbums.Count}"/>
                        <ItemsControl ItemsSource="{Binding TopAlbums}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StatItem">
                                    <Grid ColumnDefinitions="24,*,Auto" Margin="0,5">
                                        <TextBlock Grid.Column="0" Text="{Binding Rank}" FontSize="12" FontWeight="SemiBold" Opacity="0.35" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Text="{Binding SubLabel}" FontSize="11.5" Opacity="0.5" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>

            <StackPanel x:Name="AboutTabPanel" Classes="tab-page" IsVisible="{Binding IsAboutTabVisible}" Spacing="4">

            <Border Classes="setting-card" Padding="18,16" Margin="0,0,0,16">
                <StackPanel Spacing="10">
                    <!-- Row 1: logo + version on left, update button on right -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                            <!-- White note, transparent corners, plus a small transparent margin
                                 baked into the asset so the circle's cardinal points have room to
                                 antialiase (the source circle is full-bleed and would otherwise
                                 render with flat spots at 12/3/6/9 o'clock). No clip needed. -->
                            <Border Width="40" Height="40">
                                <Image Source="avares://Noctis.UI/Assets/Icons/Noctis%20Logo%20Padded.png"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{loc:T Settings.Noctis}" FontSize="16" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Click-to-copy version + OS/arch (handy for bug reports) -->
                                    <Button Classes="version-copy"
                                            Background="Transparent"
                                            Padding="0"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Command="{Binding CopyVersionInfoCommand}"
                                            ToolTip.Tip="{loc:T Settings.ClickCopyVersionSystemTip}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AppVersion}"
                                                   FontSize="12" Opacity="0.5"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                    <TextBlock Text="{loc:T Settings.Copied}"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentColorBrush}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding VersionCopied}"/>
                                    <Border IsVisible="{Binding IsPrereleaseBuild}"
                                            Background="#E74856"
                                            CornerRadius="9"
                                            Padding="8,3,8,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{loc:T Settings.PreRelease}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Action buttons (top-right) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Update-available dot next to the update pill, mirroring the
                                 sidebar settings-icon badge -->
                            <Ellipse Width="8" Height="8"
                                     Fill="{DynamicResource AccentColorBrush}"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsUpdateAvailable}"/>
                            <Button Command="{Binding CheckForUpdateCommand}"
                                    AutomationProperties.Name="{Binding CheckForUpdatesButtonText}"
                                    Classes="pill update-pill"
                                    Classes.up-to-date="{Binding IsUpToDate}"
                                    Classes.checking="{Binding IsCheckingForUpdate}"
                                    VerticalAlignment="Center"
                                    Padding="16,6"
                                    MinWidth="124"
                                    HorizontalContentAlignment="Center"
                                    IsVisible="{Binding ShowCheckForUpdatesButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <!-- Fixed 14px slot: spinner while checking, tick when up to
                                         date. Keeping the slot means the text never shifts. -->
                                    <Panel Width="14" Height="14" VerticalAlignment="Center">
                                        <Panel.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                <Binding Path="IsCheckingForUpdate"/>
                                                <Binding Path="IsUpToDate"/>
                                            </MultiBinding>
                                        </Panel.IsVisible>
                                        <Ellipse Classes="loading-spinner"
                                                 Stroke="White"
                                                 IsVisible="{Binding IsCheckingForUpdate}"/>
                                        <TextBlock Text="&#x2713;" FontSize="12" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsUpToDate}"/>
                                    </Panel>
                                    <!-- "Checking..." in its own block so each label change eases in. -->
                                    <Panel VerticalAlignment="Center">
                                        <TextBlock Classes="update-fade" Text="{Binding CheckForUpdatesButtonText}"
                                                   FontSize="12" Foreground="White"
                                                   IsVisible="{Binding !IsCheckingForUpdate}"/>
                                        <TextBlock Classes="update-fade" Text="{Binding CheckForUpdatesButtonText}"
                                                   FontSize="12" Foreground="White"
                                                   IsVisible="{Binding IsCheckingForUpdate}"/>
                                    </Panel>
                                </StackPanel>
                            </Button>

                            <!-- Download in progress: the pill becomes a progress bar. The accent fill
                                 glides toward each report on the frame clock (SmoothProgressBar), sweeps
                                 while the download is starting, and fills while the file is verified. -->
                            <Border Classes="update-download-pill update-fade"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsDownloadingUpdate}">
                                <Panel>
                                    <controls:SmoothProgressBar Value="{Binding DownloadFraction}"
                                                                IsIndeterminate="{Binding IsDownloadStarting}"
                                                                TrackBrush="#26FFFFFF"
                                                                FillBrush="{DynamicResource AccentColorBrush}"/>
                                    <Grid ColumnDefinitions="*,Auto" Margin="14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DownloadPillText}"
                                                   FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DownloadPercentText}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="White"
                                                   VerticalAlignment="Center"/>
                                        <Ellipse Grid.Column="1" Classes="loading-spinner update-fade" Stroke="White"
                                                 VerticalAlignment="Center"
                                                 IsVisible="{Binding IsDownloadVerifying}"/>
                                    </Grid>
                                </Panel>
                            </Border>
                            <Button Command="{Binding CancelUpdateCommand}"
                                    AutomationProperties.Name="{loc:T Settings.Cancel}"
                                    Classes="pill update-fade"
                                    Padding="16,6"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsDownloadingUpdate}">
                                <TextBlock Text="{loc:T Settings.Cancel}" FontSize="12" />
                            </Button>

                            <!-- Update Available button (replaces Check when a new release is detected).
                                 In-app installer path: Inno install (incl. winget/Chocolatey). -->
                            <Button Command="{Binding DownloadUpdateCommand}"
                                    AutomationProperties.Name="{Binding UpdateButtonText}"
                                    Classes="pill red-pill update-fade"
                                    VerticalAlignment="Center"
                                    Padding="16,6"
                                    Background="#E74856"
                                    IsVisible="{Binding ShowInAppUpdateButton}">
                                <TextBlock Text="{Binding UpdateButtonText}"
                                           FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Scoop / portable copies can't safely run the in-app installer;
                                 open the GitHub release instead and surface the update command. -->
                            <Button Command="{Binding OpenLatestReleaseCommand}"
                                    AutomationProperties.Name="{Binding UpdateButtonText}"
                                    Classes="pill red-pill update-fade"
                                    VerticalAlignment="Center"
                                    Padding="16,6"
                                    Background="#E74856"
                                    ToolTip.Tip="{Binding ExternalUpdateHint}"
                                    IsVisible="{Binding ShowManualUpdateButton}">
                                <TextBlock Text="{Binding UpdateButtonText}"
                                           FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Postpone a queued automatic install by 24 h (auto-update only) -->
                            <Button Command="{Binding PostponeAutoInstallCommand}"
                                    AutomationProperties.Name="{loc:T Settings.Postpone}"
                                    Classes="pill update-fade"
                                    Padding="16,6"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding ShowPostponeButton}">
                                <TextBlock Text="{loc:T Settings.Postpone}" FontSize="12" />
                            </Button>

                            <!-- Install & Restart button (replaces Update when ready) -->
                            <Button Command="{Binding InstallUpdateCommand}"
                                    AutomationProperties.Name="{loc:T Settings.InstallRestart}"
                                    Classes="pill red-pill update-fade"
                                    VerticalAlignment="Center"
                                    Padding="16,6"
                                    Background="#E74856"
                                    IsVisible="{Binding IsReadyToInstall}">
                                <TextBlock Text="{loc:T Settings.InstallRestart}" FontSize="12" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Update status area (failures in red behind a "!" badge) -->
                    <StackPanel Classes="update-fade" Orientation="Horizontal" Spacing="12"
                                IsVisible="{Binding UpdateStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Border Width="14" Height="14" CornerRadius="7" Background="#E74856"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding UpdateStatusIsError}">
                                <TextBlock Text="!" FontSize="10" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Classes="update-status-text"
                                       Classes.error="{Binding UpdateStatusIsError}"
                                       Text="{Binding UpdateStatusText}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- After an automatic update: the release notes on GitHub -->
                        <Button Command="{Binding OpenLatestReleaseCommand}"
                                AutomationProperties.Name="{loc:T Settings.WhatsNew}"
                                Classes="pill"
                                Padding="12,4"
                                VerticalAlignment="Center"
                                IsVisible="{Binding ShowWhatsNew}">
                            <TextBlock Text="{loc:T Settings.WhatsNew}" FontSize="12" />
                        </Button>
                    </StackPanel>

                    <!-- Auto-update (opt-in): background download + install at next launch. Hidden for Scoop /
                         portable / read-only copies, which update through their own channel. -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2" IsVisible="{Binding CanAutoUpdate}">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.AutoInstallUpdates}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.AutoInstallUpdatesCaption}"
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                                       IsVisible="{Binding AutoUpdateInstallsAtLaunch}"/>
                            <TextBlock Text="{loc:T Settings.AutoDownloadUpdatesCaption}"
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                                       IsVisible="{Binding AutoUpdateDownloadOnly}"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              AutomationProperties.Name="{loc:T Settings.AutoInstallUpdates}"
                                              IsChecked="{Binding AutoInstallUpdates}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Row 2: three equal-width brand tiles (GitHub / Discord / Website),
                         each a solid brand fill (star yellow, Discord blurple, Noctis red)
                         with the glyph and text in a contrasting colour. -->
                    <UniformGrid Columns="3" Margin="0,6,0,2">
                        <Button Classes="brand-tile" Command="{Binding OpenGitHubCommand}" Margin="0,0,5,0" AutomationProperties.Name="{loc:T Settings.StarGitHub}">
                            <Grid>
                                <Border CornerRadius="16" Background="#F1C40F"/>
                                <Border Classes="tile-lift" CornerRadius="16"/>
                                <StackPanel Margin="16,16,16,14">
                                    <!-- GitHub-gold star on the star-yellow tile (user ask 2026-09-07). The
                                         two hues are a near match, so a tight dark shadow lifts the star off
                                         the tile the way a sticker sits on paper. -->
                                    <PathIcon Data="{StaticResource StarIcon}"
                                              Width="24" Height="24"
                                              Foreground="#F5C518"
                                              Effect="drop-shadow(0 1 3 #B0000000)"
                                              HorizontalAlignment="Left"/>
                                    <TextBlock Text="{loc:T Settings.StarGitHub}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#1B1B1B"
                                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <TextBlock Text="{loc:T Settings.About.GitHubCaption}"
                                               FontSize="12" Foreground="#1B1B1B" Opacity="0.78"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Classes="brand-tile" Command="{Binding OpenDiscordCommand}" Margin="5,0,5,0" AutomationProperties.Name="{loc:T Settings.JoinDiscord}">
                            <Grid>
                                <Border CornerRadius="16" Background="#5865F2"/>
                                <Border Classes="tile-lift" CornerRadius="16"/>
                                <StackPanel Margin="16,16,16,14">
                                    <PathIcon Data="{StaticResource DiscordIcon}"
                                              Width="24" Height="24"
                                              Foreground="White"
                                              HorizontalAlignment="Left"/>
                                    <TextBlock Text="{loc:T Settings.JoinDiscord}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="White"
                                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <TextBlock Text="{loc:T Settings.About.DiscordCaption}"
                                               FontSize="12" Foreground="White" Opacity="0.78"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Classes="brand-tile" Command="{Binding OpenWebsiteCommand}" Margin="5,0,0,0" AutomationProperties.Name="{loc:T Settings.OfficialWebsite}">
                            <Grid>
                                <Border CornerRadius="16" Background="#E74856"/>
                                <Border Classes="tile-lift" CornerRadius="16"/>
                                <StackPanel Margin="16,16,16,14">
                                    <!-- The real logo (red disc, white double note): on the red tile the
                                         disc merges with the fill and the note reads as the glyph. -->
                                    <Image Source="avares://Noctis.UI/Assets/Icons/Noctis%20Logo%20Padded.png"
                                           Width="28" Height="28" Margin="-2,-2,0,-2"
                                           Stretch="Uniform" HorizontalAlignment="Left"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                    <TextBlock Text="{loc:T Settings.OfficialWebsite}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="White"
                                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <TextBlock Text="{loc:T Settings.About.WebsiteCaption}"
                                               FontSize="12" Foreground="White" Opacity="0.78"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </UniformGrid>

                    <!-- Signature -->
                    <TextBlock Text="{loc:T Settings.YoursTrulyHeartached}"
                               FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                </StackPanel>
            </Border>

            <!-- Developer -->

            </StackPanel>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- APPEARANCE                                          -->
            <!-- ═══════════════════════════════════════════════════ -->


        </StackPanel>
    </ScrollViewer>

    <!-- A plugin's own view ("Open Album Town") in place of its page (owner 10-29: the window
         looked choppy). Outside the scroller so the view gets a real height; it slides in like a
         plugin's page (plugin-subpage) while MainWindow grows the card to the size the view asks
         for (CardSizeRequested). Back returns to the page; the icon opens the view in its own
         window instead. The view wears the plugin-window theme (PluginViewTheme on PluginViewHost). -->
    <DockPanel x:Name="PluginViewPage" Grid.Row="1" Classes="plugin-subpage from-right"
               Margin="28,8,28,24" IsVisible="{Binding IsPluginViewOpen}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <Button x:Name="PluginViewBackButton" Classes="pill-action plugin-back" HorizontalAlignment="Left"
                    Command="{Binding ClosePluginViewCommand}"
                    AutomationProperties.Name="{Binding PluginViewBackName}"
                    Height="32" Padding="8,0,14,0" VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <PathIcon Data="{StaticResource ChevronLeftIcon}" Width="16" Height="16"/>
                    <TextBlock Text="{Binding PluginViewName}" FontSize="12.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="1" x:Name="PluginViewPopOutButton" Classes="icon-chip"
                    AutomationProperties.Name="{loc:T Plugins.View.PopOut}" ToolTip.Tip="{loc:T Plugins.View.PopOut}"
                    Command="{Binding PopOutPluginViewCommand}">
                <Viewbox Width="15" Height="15">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource MenuLineOpenWith}" Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/>
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>
        <!-- DataContext null: as in its window, the plugin's control inherits no DataContext
             (a binding of its own must not resolve against Settings' view model). -->
        <Border x:Name="PluginViewFrame" CornerRadius="18" ClipToBounds="True">
            <ContentControl x:Name="PluginViewHost" DataContext="{x:Null}"
                            Content="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).PluginViewContent}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Border>
    </DockPanel>
    </Grid>
    </Grid>
</UserControl>