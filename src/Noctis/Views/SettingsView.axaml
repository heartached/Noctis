<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:plugins="using:Noctis.Services.Plugins"
             xmlns:server="using:Noctis.Services.Server"
             xmlns:studio="using:Noctis.Services.LyricsStudio"
             xmlns:vm="using:Noctis.ViewModels"
             xmlns:models="using:Noctis.Models"
             xmlns:sys="using:System"
             xmlns:conv="using:Noctis.Converters"
             xmlns:controls="using:Noctis.Controls"
             xmlns:helpers="using:Noctis.Helpers"
             x:Class="Noctis.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource AppMainBackground}">

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometry" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- The page scrollbar sits at the card's right edge, and the card clips its
             children to a 21px rounded rect (MainWindow SettingsCard). At the top the
             header row keeps the bar clear of the corner; at the bottom nothing did, so
             the last ~20px of track and thumb were cut off by the curve. Inset the bar
             by the corner radius; the content itself still scrolls to the card edge. -->
        <Style Selector="ScrollViewer#SettingsScrollViewer /template/ ScrollBar:vertical">
            <Setter Property="Margin" Value="2,0,0,21"/>
        </Style>

        <!-- Section header style -->
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- A setting row gated by another toggle: dim it while disabled so it
             visibly reads as not-yet-available (e.g. "Start minimized to tray"
             before "Open Noctis when computer starts" is on). -->
        <Style Selector="Grid.dependent-setting:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- Hover shade for EVERY clickable button in Settings (user ask 09-08): the same
             "darken in place" the accent Modify button does. Grey and transparent buttons
             take a translucent black wash (SettingsButtonHoverBrush, per theme); accent /
             danger buttons darken to AccentColorBrushDark1 in their own rules below. This
             rule is declared first on purpose: Avalonia styles cascade by order, so every
             class-specific :pointerover rule after it (rail, brand tiles, social links,
             swatch, avatar, preset chips) keeps its own look. Toggles are not Buttons. -->
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SettingsButtonHoverBrush}"/>
        </Style>
        <!-- accent-pill (e.g. Plugins "Install from file"): the wash above beat the global
             Styles.axaml accent hover, turning the pill grey. Stay accent, just deeper. -->
        <Style Selector="Button.accent-pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrushDark1}"/>
        </Style>

        <!-- About-tab update pill: accent by default, subdued while showing the
             transient "✓ Up to date" confirmation so it stops reading as a CTA. -->
        <Style Selector="Button.update-pill">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="Button.update-pill.up-to-date, Button.update-pill.checking">
            <Setter Property="Background" Value="#26FFFFFF"/>
        </Style>
        <!-- No brush/scale transitions on this pill: its state flips twice per click
             (Update -> Checking -> Up to date) and each cross-fade read as a flicker. -->
        <Style Selector="Button.update-pill, Button.update-pill:pointerover, Button.update-pill:pressed">
            <Setter Property="Transitions">
                <Transitions/>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.update-pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrushDark1}"/>
        </Style>
        <Style Selector="Button.update-pill.up-to-date:pointerover /template/ ContentPresenter, Button.update-pill.checking:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SettingsButtonHoverBrush}"/>
        </Style>
        <!-- About-tab red update pills (hard-coded #E74856, not the accent): darken like Modify. -->
        <Style Selector="Button.red-pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C73E4C"/>
        </Style>

        <!-- Circular loading spinner: a rotating arc shown during background work -->
        <Style Selector="Ellipse.loading-spinner">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stroke" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeDashArray" Value="11,5"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        </Style>
        <!-- Animation keyed on [IsVisible=True] (same pattern as LyricsView's search
             dots): selector matching ignores visibility, so an ungated INFINITE
             clock would keep ticking on every hidden spinner. -->
        <Style Selector="Ellipse.loading-spinner[IsVisible=True]">
            <Style.Animations>
                <Animation Duration="0:0:0.85" IterationCount="INFINITE" Easing="LinearEasing">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Music Server card: tiny caps field labels, a status dot that follows the
             connection state, and red status text on failures. -->
        <Style Selector="TextBlock.server-field-label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Ellipse.server-status-dot">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Fill" Value="#8B949E"/>
        </Style>
        <Style Selector="Ellipse.server-status-dot.connected">
            <Setter Property="Fill" Value="#3FB950"/>
        </Style>
        <Style Selector="Ellipse.server-status-dot.error">
            <Setter Property="Fill" Value="#E5534B"/>
        </Style>
        <Style Selector="TextBlock.server-status">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="TextBlock.server-status.error">
            <Setter Property="Foreground" Value="#E5534B"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        <!-- Server type picker: the visible outline is drawn by a plain wrapper Border
             (server-pill-shell) carrying exactly the metadata-info-field stroke, and the
             ComboBox's own Fluent chrome is fully disarmed in every state. Pinning the
             stroke on the template's Border#Background was tried twice and never rendered
             the same as the TextBox's PART_BorderElement (same declared 1.5px/brush,
             different layering/snapping) — so all four boxes now share one drawing
             mechanism. Contract pinned by MediaServerOutlineParityTests. -->
        <Style Selector="Border.server-pill-shell">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <!-- Same grey stroke as every other Settings pill box (user ask 09-08). -->
            <Setter Property="BorderBrush" Value="#99A0A0A8"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeWhiteBrush}"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <!-- Focus parity: the field boxes turn accent on :focus, the shell follows suit. -->
        <Style Selector="Border.server-pill-shell:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
        </Style>
        <Style Selector="ComboBox.server-pill">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill /template/ Border#Background">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill /template/ Border#HighlightBackground">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ComboBox.server-pill:pointerover /template/ Border#Background">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill:pressed /template/ Border#Background">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill:focus /template/ Border#Background">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill:focus-within /template/ Border#Background">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill:dropdownopen /template/ Border#Background">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.server-pill:disabled /template/ Border#Background">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Setting card -->
        <!-- Preset chips (crossfade 3s / 6s / 10s): pill toggles, selected = accent. -->
        <Style Selector="Button.preset-chip">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="11,3"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.preset-chip:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.preset-chip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HomeCardHoverBackground}"/>
        </Style>
        <Style Selector="Button.preset-chip.selected">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="Button.preset-chip.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="Button.preset-chip.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="Border.setting-card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="22,16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="Border.setting-card.advanced-first">
            <Setter Property="CornerRadius" Value="24,24,0,0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="Border.setting-card.advanced-middle">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="Border.setting-card.advanced-last">
            <Setter Property="CornerRadius" Value="0,0,24,24"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Selectable card used by the Song Transitions style picker -->
        <Style Selector="RadioButton.transition-card">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="card"
                            Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="18"
                            Padding="18,14">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Cards shade on hover like the Settings buttons; the checked card keeps its
             accent border. -->
        <Style Selector="RadioButton.transition-card:pointerover /template/ Border#card">
            <Setter Property="Background" Value="{DynamicResource SettingsButtonHoverBrush}"/>
        </Style>
        <!-- Every card picker (transition style, upmix, visualizer, mini player design,
             artwork medium, cover flow layout, group-artists): the press dip the theme
             tiles get from the app-wide Button style, and the accent ring fades in
             instead of snapping (user ask 09-08). -->
        <Style Selector="RadioButton.transition-card">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="RadioButton.transition-card:pressed">
            <Setter Property="RenderTransform" Value="scale(0.96)"/>
        </Style>
        <Style Selector="RadioButton.transition-card /template/ Border#card">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="RadioButton.transition-card:checked /template/ Border#card">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
        </Style>
        <Style Selector="RadioButton.transition-card:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <!-- Same card, laid out four-up for the Now Playing Artwork picker: no bottom
             margin (the Grid spaces them) and centred glyph + label. -->
        <Style Selector="RadioButton.medium-card">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="RadioButton.medium-card Canvas.medium-glyph">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>


        <!-- Setting row: label left, control right -->
        <Style Selector="Border.setting-row">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Liquid motion for every button in Settings -->
        <Style Selector="Button">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18">
                        <TransformOperationsTransition.Easing>
                            <CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                    <BrushTransition Property="Background" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- No hover zoom anywhere in Settings (user ask 09-07): buttons highlight in
             place. Overrides the app-wide Button / Button.pill :pointerover scale. -->
        <Style Selector="Button:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.pill:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <!-- Accent buttons lose their zoom, so they darken on hover instead (the global
             accent-btn hover keeps the resting colour). Same shade as Styles.axaml's
             settings-popup rule. -->
        <Style Selector="Button.accent-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrushDark1}"/>
        </Style>
        <!-- The QR thumbnail must not grow on hover: a moving code reads as decoration,
             and phones scan it in place. The press dip stays for click feedback. -->
        <Style Selector="Button.qr-thumb:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.accent-swatch:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.accent-swatch:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <!-- Theme selection button -->
        <Style Selector="Button.theme-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.theme-btn /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- Theme tiles shade on hover like every other Settings button (the active
             tile keeps its accent border; only the fill changes). -->
        <Style Selector="Button.theme-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SettingsButtonHoverBrush}"/>
        </Style>

        <!-- Profile avatar button: round, no rectangular hover overlay -->
        <Style Selector="Button.profile-avatar-btn /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="Button.profile-avatar-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.profile-avatar-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- Profile name TextBox: no chrome on any state -->
        <Style Selector="TextBox.profile-input /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.profile-input:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.profile-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.profile-input:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.theme-btn.active /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
        </Style>

        <!-- Danger button -->
        <Style Selector="Button.danger /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrushDark1}"/>
        </Style>

        <!-- Accent button -->
        <Style Selector="Button.accent /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrushDark1}"/>
        </Style>

        <Style Selector="TextBox.accent-hex-input /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <Style Selector="TextBox.accent-hex-input:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.accent-hex-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.accent-hex-input:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- Pill-shaped action buttons -->
        <Style Selector="Button.pill-action">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.pill-action /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>

        <!-- Social links (GitHub / Discord) in the About card: brand-coloured icon,
             brighter label, and a soft brand-tinted pill on hover. -->
        <Style Selector="Button.social-link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.social-link /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="Button.social-discord:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#265865F2"/>
        </Style>
        <Style Selector="Button.social-github:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#26F1C40F"/>
        </Style>

        <!-- About: three equal-width brand tiles (GitHub / Discord / Website). The tile
             is a Button whose chrome is fully transparent; the wash Border underneath
             carries the colour. Hover lifts the wash with a faint white layer, press
             dips opacity (no scale, per the app's press convention). -->
        <Style Selector="Button.brand-tile">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.brand-tile /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.brand-tile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.brand-tile:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.brand-tile:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.brand-tile:pressed">
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Opacity" Value="0.72"/>
        </Style>
        <Style Selector="Button.brand-tile Border.tile-lift">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.brand-tile:pointerover Border.tile-lift">
            <Setter Property="Opacity" Value="0.07"/>
        </Style>

        <!-- Library > Tools: one row per tool, a plain monochrome glyph in front of the
             title (same family as the rail icons). -->
        <Style Selector="PathIcon.tool-icon">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,16,0"/>
        </Style>
        <!-- Sidebar bitmap icons (Folder / Playlist PNGs) drawn as an opacity mask so
             they take the same colour and size as the geometry glyphs beside them. -->
        <Style Selector="Border.tool-bitmap">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,16,0"/>
        </Style>

        <!-- Pill ComboBox -->
        <Style Selector="ComboBox.pill-combo">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <Panel>
                            <Border Name="Background"
                                    Background="{DynamicResource ButtonBackground}"
                                    BorderThickness="0"
                                    CornerRadius="16"
                                    Padding="{TemplateBinding Padding}"
                                    MinWidth="{TemplateBinding MinWidth}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <ContentPresenter Name="PART_ContentPresenter"
                                                      Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    <Border Grid.Column="1"
                                            Width="15"
                                            Height="15"
                                            Margin="4,0,4,0"
                                            Background="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            RenderOptions.BitmapInterpolationMode="HighQuality">
                                        <Border.OpacityMask>
                                            <ImageBrush Source="avares://Noctis.UI/Assets/Icons/Arrow Down ICON.png" Stretch="Uniform"/>
                                        </Border.OpacityMask>
                                    </Border>
                                </Grid>
                            </Border>
                            <Popup Name="PART_Popup"
                                   PlacementTarget="{TemplateBinding}"
                                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                   MinWidth="{TemplateBinding MinWidth}"
                                   IsLightDismissEnabled="True"
                                   WindowManagerAddShadowHint="False"
                                   Placement="BottomEdgeAlignedLeft">
                                <Border Background="{DynamicResource ComboBoxDropDownBackground}"
                                        BorderBrush="{DynamicResource ComboBoxDropDownBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="0,4">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter Name="PART_ItemsPresenter"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Panel>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ComboBox.pill-combo:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="ComboBox.pill-combo.stable-popup:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="ComboBox.pill-combo:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
        </Style>
        <!-- Selected item highlight. Foreground tracks the accent's contrast colour so the
             label stays readable even when the accent is white (otherwise white-on-white). -->
        <Style Selector="ComboBox.pill-combo ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="ComboBox.pill-combo ComboBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrushDark1}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <!-- Pill-shaped hover/selection highlight in the dropdown list, matching the
             rounded MenuItems in the page options menu. Margin insets each row so the
             highlight floats; CornerRadius on the content presenter clips it to a pill. -->
        <Style Selector="ComboBox.pill-combo ComboBoxItem">
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="ComboBox.pill-combo ComboBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="999"/>
        </Style>

        <!-- Pill dropdown items for plain (default-template) pill combos, e.g. ReplayGain Mode. -->
        <Style Selector="ComboBox.pill-list ComboBoxItem">
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="ComboBox.pill-list ComboBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="999"/>
        </Style>

        <!-- Token field: identical treatment to the metadata editor's text fields. The inner
             PART_BorderElement gets the same CornerRadius so the rounded corners render clean
             (the earlier square-corner artifact came from leaving PART_BorderElement unstyled). -->
        <Style Selector="TextBox.metadata-info-field">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="#99A0A0A8" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeWhiteBrush}" />
        </Style>
        <Style Selector="TextBox.metadata-info-field /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="#99A0A0A8" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
        <Style Selector="TextBox.metadata-info-field:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
        </Style>
        <Style Selector="TextBox.metadata-info-field:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
        </Style>
        <Style Selector="ComboBox.transition-pill">
            <Setter Property="Width" Value="132"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="ComboBox.transition-pill /template/ Border#Background">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="ComboBox.transition-pill:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </Style>

        <!-- Accent sliders (horizontal) -->
        <Style Selector="Slider.accent-slider">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TickPlacement" Value="None"/>
        </Style>
        <Style Selector="Slider.accent-slider /template/ Track">
            <Setter Property="Height" Value="8"/>
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Margin" Value="0,0,-9,0"/>
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Margin" Value="-9,0,0,0"/>
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="Opacity" Value="0.95"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Height" Value="8"/>
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton#PART_IncreaseButton /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Slider.accent-slider /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14">
                        <TransformOperationsTransition.Easing>
                            <CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                    <DoubleTransition Property="Width" Duration="0:0:0.12"/>
                    <DoubleTransition Property="Height" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Slider.accent-slider:pointerover /template/ Thumb">
            <Setter Property="Width" Value="19.44"/>
            <Setter Property="Height" Value="19.44"/>
        </Style>

        <!-- Child settings dim when their parent toggle is off (matches the
             grayed ReplayGain Mode row) so the dependency is visible at a glance. -->
        <Style Selector="Grid.sub-setting, StackPanel.sub-setting">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.sub-setting:disabled, StackPanel.sub-setting:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- Pill numeric fields in the parametric EQ rows: the spin buttons are
             hidden so the value is always fully readable; adjust by typing,
             scrolling, or arrow keys. -->
        <Style Selector="NumericUpDown.eq-pill-number">
            <Setter Property="ShowButtonSpinner" Value="False"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="NumericUpDown.eq-pill-number /template/ ButtonSpinner">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown.eq-pill-number /template/ TextBox#PART_TextBox">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- The theme draws TextBox chrome on its inner border element (including
             hover/focus recolors), so the pill background has to be set there for
             every state or the theme's square highlight bleeds through. -->
        <Style Selector="NumericUpDown.eq-pill-number /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown.eq-pill-number /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown.eq-pill-number /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Accent sliders (vertical EQ) -->
        <Style Selector="Slider.accent-vertical">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ Track">
            <Setter Property="Width" Value="8"/>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ RepeatButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Margin" Value="0,-9,0,0"/>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Margin" Value="0,0,0,-9"/>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ RepeatButton /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="Opacity" Value="0.95"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Width" Value="8"/>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ RepeatButton#PART_IncreaseButton /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Slider.accent-vertical /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="999"/>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14">
                        <TransformOperationsTransition.Easing>
                            <CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                    <DoubleTransition Property="Width" Duration="0:0:0.12"/>
                    <DoubleTransition Property="Height" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Slider.accent-vertical:pointerover /template/ Thumb">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>

        <!-- Pre-amp pill slider: the real Slider is transparent and only handles hit
             testing; the visible pill track/fill/thumb are drawn on a Canvas and driven
             from code-behind (PillSliderVisualHelper), matching the metadata volume slider. -->
        <Style Selector="Slider.preamp-horizontal">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource IslandSliderFilled}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>

        <!-- Settings rail (left column): section list, profile chip, search. -->
        <Style Selector="Border.settings-rail">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="CornerRadius" Value="21,0,0,0"/>
        </Style>
        <Style Selector="Button.rail-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.rail-item /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="Button.rail-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}"/>
        </Style>
        <Style Selector="Button.rail-item.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <!-- The app-wide Button:pointerover scale(1.045) reads as a jump on a list of
             full-width rows; the rail relies on the background highlight alone. -->
        <Style Selector="Button.rail-item:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.profile-avatar-btn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <!-- About-tab version chip: plain text that copies on click; the app-wide hover
             zoom makes it wobble under the pointer. -->
        <Style Selector="Button.version-copy:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.rail-profile">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.rail-profile /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style Selector="Button.rail-profile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}"/>
        </Style>
        <Style Selector="TextBox.settings-search">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <!-- Settings search hides non-matching cards through a class (see
             SettingsSearchIndex) so cards whose IsVisible is bound keep that binding. -->
        <Style Selector="Border.setting-card.search-hidden">
            <Setter Property="IsVisible" Value="False"/>
            <!-- A card whose IsVisible is bound (platform / Developer Mode gates) keeps
                 that binding over the setter above, so collapse it geometrically too. -->
            <Setter Property="MaxHeight" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <!-- Tab switch: the incoming page fades in with a short upward glide.
             Keyframe animations can't drive RenderTransform (no registered
             animator — crashed at startup), so the hidden state pins
             opacity 0 / translateY(10px) and releasing it on IsVisible=True
             transitions both back to their natural values. -->
        <Style Selector="StackPanel.tab-page">
            <!-- Explicit resting transform: transitions interpolate between two
                 TransformOperations values, never to an unset (null) transform. -->
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.tab-page[IsVisible=False]">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="translateY(6px)"/>
        </Style>
        <!-- ── Pill BOXES in Settings (text fields and combo boxes, never buttons): one mid-grey
             stroke, 1.5px, layout-rounded so both control types rasterise it identically. The
             brush is a translucent grey so it reads as the same mid grey on dark and light cards. ── -->
        <Style Selector="TextBox">
            <Setter Property="BorderBrush" Value="#99A0A0A8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#99A0A0A8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#99A0A0A8"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement, TextBox:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <!-- Every combo box: pill shell, label centred, and the pill-combo dropdown (rounded
             popup, pill rows, accent highlight) so no combo has square rows. -->
        <Style Selector="ComboBox">
            <Setter Property="BorderBrush" Value="#99A0A0A8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,0,8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox /template/ Border#Background">
            <Setter Property="BorderBrush" Value="#99A0A0A8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="BorderBrush" Value="#99A0A0A8"/>
        </Style>
        <Style Selector="ComboBox:focus /template/ Border#Background, ComboBox:dropdownopen /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
        </Style>
        <Style Selector="ComboBox /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox /template/ Border#PopupBorder">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0,4"/>
        </Style>
        <Style Selector="ComboBox ComboBoxItem">
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="ComboBox ComboBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="ComboBox ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="ComboBox ComboBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrushDark1}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <!-- Equalizer: the per-band remove control is a round chip like the page's close X. -->
        <Style Selector="Button.eq-remove">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}"/>
        </Style>
        <Style Selector="Button.eq-remove /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="13"/>
        </Style>
        <Style Selector="Button.eq-remove:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>

        <!-- Profile: name in a rounded box (Claude-style field), avatar badges. -->
        <Style Selector="TextBox.profile-name">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="#22000000"/>
        </Style>
        <Style Selector="TextBox.profile-name /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="Border.avatar-badge">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.avatar-x">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.avatar-x /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Button.avatar-x:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Border.stat-pill">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- One TextBlock (two Runs) per pill with a fixed 14px box: number and label share a
                 baseline, and a label with descenders (Lossy, playlists) can't grow the box. -->
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
        </Style>
        <!-- The camera badge and the X only appear while the pointer is over the avatar. -->
        <Style Selector="Panel.avatar-wrap Border.avatar-badge, Panel.avatar-wrap Button.avatar-x">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.avatar-wrap:pointerover Border.avatar-badge, Panel.avatar-wrap:pointerover Button.avatar-x">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- ── Grouped rail + grouped cards (2026-09 revamp) ── -->
        <Style Selector="TextBlock.rail-group">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Margin" Value="10,12,0,4"/>
        </Style>
        <Style Selector="PathIcon.rail-icon">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.rail-item.active PathIcon.rail-icon">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- Bitmap rail icons take the row's text colour: theme foreground at rest, accent foreground when active. -->
        <Style Selector="Border.rail-bitmap">
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.rail-item.active Border.rail-bitmap">
            <Setter Property="Background" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- One card per section; the cards that moved into it are hairline-separated rows. -->
        <Style Selector="Border.setting-card.group-card">
            <Setter Property="Padding" Value="22,4"/>
        </Style>
        <Style Selector="Border.setting-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0,14"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
        </Style>
        <Style Selector="Border.setting-row:nth-child(1)">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Border.setting-row.divided">
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
        <Style Selector="Button.settings-close">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}"/>
        </Style>
        <Style Selector="Button.settings-close:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="232,*">

    <!-- Rail: search, then the pages grouped under small headers. -->
    <Border Grid.Column="0" Classes="settings-rail">
        <DockPanel Margin="12,14,12,12">
            <!-- Search across every section (Ctrl+F while Settings is open). -->
            <TextBox DockPanel.Dock="Top"
                     x:Name="SettingsSearchBox"
                     Classes="settings-search"
                     Watermark="{loc:T Settings.SearchSettings}"
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchQuery, Mode=TwoWay}"
                     Margin="0,0,0,4"/>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SectionGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingsSectionGroup">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="rail-group" Text="{Binding Label}"/>
                            <ItemsControl ItemsSource="{Binding Sections}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SettingsSection">
                                        <Button Classes="rail-item"
                                                Classes.active="{Binding IsSelected}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectSettingsTabCommand}"
                                                CommandParameter="{Binding Key}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <!-- Geometry icons draw as a PathIcon; the sidebar's bitmap icons (Folders)
                                                     draw the way the sidebar does: a foreground-filled square masked by the PNG. -->
                                                <Panel Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <PathIcon Classes="rail-icon"
                                                              Data="{Binding IconKey, Converter={x:Static helpers:IconKeyConverter.Instance}}"
                                                              Width="16" Height="16"/>
                                                    <Border Classes="rail-bitmap" Width="16" Height="16"
                                                            RenderOptions.BitmapInterpolationMode="HighQuality"
                                                            IsVisible="{Binding IconKey, Converter={x:Static helpers:IconKeyConverter.IsBitmap}}">
                                                        <Border.OpacityMask>
                                                            <ImageBrush Source="{Binding IconKey, Converter={x:Static helpers:IconKeyConverter.Bitmap}}" Stretch="Uniform"/>
                                                        </Border.OpacityMask>
                                                    </Border>
                                                </Panel>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <!-- Search hit count while a query is active -->
                                                <Border Grid.Column="2" CornerRadius="999" Padding="6,1" Margin="6,0,0,0"
                                                        Background="#22FFFFFF" VerticalAlignment="Center"
                                                        IsVisible="{Binding HasMatches}">
                                                    <TextBlock Text="{Binding MatchCount}" FontSize="10.5" FontWeight="SemiBold"/>
                                                </Border>
                                                <!-- Update-available dot on About -->
                                                <Ellipse Grid.Column="3" Width="8" Height="8" Margin="6,0,0,0"
                                                         Fill="{DynamicResource AccentColorBrush}" VerticalAlignment="Center">
                                                    <Ellipse.IsVisible>
                                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                            <Binding Path="IsAbout"/>
                                                            <Binding Path="$parent[UserControl].((vm:SettingsViewModel)DataContext).ShowUpdateBadge"/>
                                                        </MultiBinding>
                                                    </Ellipse.IsVisible>
                                                </Ellipse>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>

    <!-- Content column: page title + description + close, then the pages. -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="28,20,20,6">
        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedTabTitle}" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedTabDescription}" FontSize="12.5" Opacity="0.55" TextWrapping="Wrap"/>
        </StackPanel>
        <!-- Close: the modal's only close control now that MainWindow has no footer. -->
        <Button Grid.Column="1" Classes="settings-close"
                ToolTip.Tip="{loc:T Settings.CloseTip}"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseSettingsCommand}"
                VerticalAlignment="Top" Margin="12,2,0,0">
            <PathIcon Data="{StaticResource DismissIcon}" Width="12" Height="12"/>
        </Button>
    </Grid>

    <!-- Vertical bar always reserved, never Auto: Fluent puts it in its own template column, so
         under Auto it took its width only once a page grew tall enough to scroll. Toggling a
         sub-block (Audio Visualizer picker) then re-flowed EVERY row: the bar jumped in and the
         Flowing Lyrics description re-wrapped (09-12). The bar itself still auto-hides its thumb. -->
    <ScrollViewer x:Name="SettingsScrollViewer"
                  Grid.Row="1"
                  Focusable="True"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Visible">
        <StackPanel Margin="28,8,40,28" HorizontalAlignment="Stretch" Spacing="4">

            <StackPanel x:Name="GeneralTabPanel" Classes="tab-page" IsVisible="{Binding IsGeneralTabVisible}" Spacing="4">
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.Language.Title}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.Language.Description}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  Classes="pill-list"
                                  ItemsSource="{Binding LanguageOptions}"
                                  SelectedItem="{Binding LanguageChoice}"
                                  MinWidth="180"
                                  VerticalAlignment="Center"
                                  CornerRadius="999"
                                  Padding="14,8"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <Border Classes="setting-card group-card" Margin="0,14,0,10">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.StartupWindowBehaviour}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ControlHowNoctisStarts}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.OpenNoctisWhenComputer}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding LaunchAtStartup}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <!-- The OS registration can fail (locked-down HKCU, read-only
                         ~/.config/autostart, an unbundled macOS run). The toggle snaps
                         back to what the OS reports and says so, rather than sitting ON
                         with nothing registered. -->
                    <TextBlock Text="{Binding LaunchAtStartupError}"
                               IsVisible="{Binding LaunchAtStartupError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="12" Foreground="#E74856" TextWrapping="Wrap"/>
                    <!-- Dependent on launch-at-startup: only meaningful for login launches. -->
                    <Grid ColumnDefinitions="*,Auto" Classes="dependent-setting" IsEnabled="{Binding LaunchAtStartup}">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.StartMinimizedTray}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding StartMinimizedToTray}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.MinimizeTray}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding MinimizeToTray}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.CloseTray}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding CloseToTray}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.RestoreLastPlayedTrack}" FontSize="13"/>
                            <TextBlock Text="{loc:T Settings.ReopenLastTrackPlaybar}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding RestoreLastTrackOnStartup}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Sidebar}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.KeepSidebarExpanded}" FontSize="13"/>
                            <TextBlock Text="{loc:T Settings.PinSidebarOpenAt}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding SidebarAlwaysExpanded}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Hover-expand is moot while the sidebar is pinned open -->
                    <Grid Classes="sub-setting" ColumnDefinitions="*,Auto" IsEnabled="{Binding !SidebarAlwaysExpanded}">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.HoverExpandSidebar}" FontSize="13"/>
                            <TextBlock Text="{loc:T Settings.SlideSidebarOpenHover}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding SidebarHoverExpand}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Files}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row" IsVisible="{Binding IsFileAssociationSupported}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.OpenAudioFilesNoctis}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.AddNoctisWindowsOpen}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="pill" FontSize="12" Padding="14,6"
                                VerticalAlignment="Center" Margin="12,0,0,0"
                                Command="{Binding RegisterFileTypesCommand}">
                            <Panel>
                                <TextBlock Text="{loc:T Settings.Register}" IsVisible="{Binding !IsRegisteredForAudioFiles}"/>
                                <TextBlock Text="{loc:T Settings.Unregister}" IsVisible="{Binding IsRegisteredForAudioFiles}"/>
                            </Panel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding FileTypesStatus}"
                               IsVisible="{Binding FileTypesStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.OpenFile}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.RightClickSongOpen}"
                                   FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding ExternalOpenAppPath}"
                                 Watermark="{loc:T Settings.NotSet}"
                                 CornerRadius="999"
                                 Padding="14,8"
                                 BorderThickness="1.5"
                                 MinHeight="0" />
                        <Button Grid.Column="1"
                                Content="{loc:T Settings.Browse}"
                                Command="{Binding BrowseExternalOpenAppCommand}"
                                Padding="14,8"
                                CornerRadius="999"
                                Margin="8,0,0,0"
                                Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="AppearanceTabPanel" Classes="tab-page" IsVisible="{Binding IsAppearanceTabVisible}" Spacing="4">
            <Border Classes="setting-card" Padding="22,12">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.Themes}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ChooseHowNoctisLooks}"
                                   FontSize="12" Opacity="0.5"/>
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal">
                        <WrapPanel.Styles>
                            <Style Selector="Button.theme-btn">
                                <Setter Property="Margin" Value="0,0,10,10"/>
                            </Style>
                        </WrapPanel.Styles>
                        <!-- Dark (pure black, silver accents) -->
                        <Button Classes="theme-btn"
                                Classes.active="{Binding IsDarkTheme}"
                                Command="{Binding SetDarkThemeCommand}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="64" Height="40" CornerRadius="6"
                                        Background="#000000"
                                        BorderBrush="#1A1A1A" BorderThickness="1">
                                    <StackPanel Margin="6,5" Spacing="3">
                                        <Border Height="3" Width="30" CornerRadius="1.5"
                                                Background="#E8E8E8" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="20" CornerRadius="1.5"
                                                Background="#A8A8A8" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="36" CornerRadius="1.5"
                                                Background="#707070" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:T Settings.Dark}" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Gray (default) -->
                        <Button Classes="theme-btn"
                                Classes.active="{Binding IsGrayTheme}"
                                Command="{Binding SetGrayThemeCommand}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="64" Height="40" CornerRadius="6"
                                        Background="#1E1E1E"
                                        BorderBrush="#444" BorderThickness="1">
                                    <StackPanel Margin="6,5" Spacing="3">
                                        <Border Height="3" Width="30" CornerRadius="1.5"
                                                Background="#555" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="20" CornerRadius="1.5"
                                                Background="#444" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="36" CornerRadius="1.5"
                                                Background="#333" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:T Settings.Gray}" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Midnight (deep blue-black) -->
                        <Button Classes="theme-btn"
                                Classes.active="{Binding IsMidnightTheme}"
                                Command="{Binding SetMidnightThemeCommand}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="64" Height="40" CornerRadius="6"
                                        Background="#0E1322"
                                        BorderBrush="#1E2640" BorderThickness="1">
                                    <StackPanel Margin="6,5" Spacing="3">
                                        <Border Height="3" Width="30" CornerRadius="1.5"
                                                Background="#7C8CFF" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="20" CornerRadius="1.5"
                                                Background="#5A6BB0" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="36" CornerRadius="1.5"
                                                Background="#3A4673" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:T Settings.Midnight}" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Light -->
                        <Button Classes="theme-btn"
                                Classes.active="{Binding IsLightTheme}"
                                Command="{Binding SetLightThemeCommand}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="64" Height="40" CornerRadius="6"
                                        Background="#F5F5F5"
                                        BorderBrush="#CCC" BorderThickness="1">
                                    <StackPanel Margin="6,5" Spacing="3">
                                        <Border Height="3" Width="30" CornerRadius="1.5"
                                                Background="#CCC" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="20" CornerRadius="1.5"
                                                Background="#DDD" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="36" CornerRadius="1.5"
                                                Background="#E0E0E0" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:T Settings.Light}" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Ink -->
                        <Button Classes="theme-btn"
                                Classes.active="{Binding IsInkTheme}"
                                Command="{Binding SetInkThemeCommand}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="64" Height="40" CornerRadius="6"
                                        Background="#0F0F0F"
                                        BorderBrush="#2A2A2A" BorderThickness="1">
                                    <StackPanel Margin="6,5" Spacing="3">
                                        <Border Height="3" Width="30" CornerRadius="1.5"
                                                Background="#D63A2E" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="20" CornerRadius="1.5"
                                                Background="#2B66D9" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="36" CornerRadius="1.5"
                                                Background="#A3A3A3" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:T Settings.Ink}" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Smoke -->
                        <Button Classes="theme-btn"
                                Classes.active="{Binding IsSmokeTheme}"
                                Command="{Binding SetSmokeThemeCommand}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="64" Height="40" CornerRadius="6"
                                        Background="#2A2D38"
                                        BorderBrush="#3E4250" BorderThickness="1">
                                    <StackPanel Margin="6,5" Spacing="3">
                                        <Border Height="3" Width="30" CornerRadius="1.5"
                                                Background="#2F6ACB" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="20" CornerRadius="1.5"
                                                Background="#8A8F9E" HorizontalAlignment="Left"/>
                                        <Border Height="3" Width="36" CornerRadius="1.5"
                                                Background="#4A4E5A" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:T Settings.Smoke}" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- User-created themes -->
                        <ItemsControl ItemsSource="{Binding CustomThemes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CustomThemeTile">
                                    <Button Classes="theme-btn"
                                            Classes.active="{Binding IsActive}"
                                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).ApplyCustomThemeCommand}"
                                            CommandParameter="{Binding Id}"
                                            Margin="0,0,10,10">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{loc:T Settings.Edit}"
                                                          Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).OpenThemeEditorCommand}"
                                                          CommandParameter="{Binding Id}"/>
                                                <MenuItem Header="{loc:T Settings.Delete}"
                                                          Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DeleteCustomThemeCommand}"
                                                          CommandParameter="{Binding Id}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                                            <Border Width="64" Height="40" CornerRadius="6"
                                                    Background="{Binding MainHex}"
                                                    BorderBrush="{Binding SidebarHex}"
                                                    BorderThickness="1">
                                                <StackPanel Margin="6,5" Spacing="3">
                                                    <Border Height="3" Width="30" CornerRadius="1.5"
                                                            Background="{Binding AccentHex}" HorizontalAlignment="Left"/>
                                                    <Border Height="3" Width="20" CornerRadius="1.5"
                                                            Background="{Binding SidebarHex}" HorizontalAlignment="Left"/>
                                                    <Border Height="3" Width="36" CornerRadius="1.5"
                                                            Background="{Binding SidebarHex}" Opacity="0.65"
                                                            HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       MaxWidth="64" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Content-pack themes: same tile, plus "by <pack>" under the name. -->
                        <ItemsControl ItemsSource="{Binding PackThemes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PackThemeTile">
                                    <Button Classes="theme-btn"
                                            Classes.active="{Binding IsActive}"
                                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).ApplyPackThemeCommand}"
                                            CommandParameter="{Binding Key}"
                                            ToolTip.Tip="{Binding ByLabel}"
                                            Margin="0,0,10,10">
                                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                                            <Border Width="64" Height="40" CornerRadius="6"
                                                    Background="{Binding MainHex}"
                                                    BorderBrush="{Binding SidebarHex}"
                                                    BorderThickness="1">
                                                <StackPanel Margin="6,5" Spacing="3">
                                                    <Border Height="3" Width="30" CornerRadius="1.5"
                                                            Background="{Binding AccentHex}" HorizontalAlignment="Left"/>
                                                    <Border Height="3" Width="20" CornerRadius="1.5"
                                                            Background="{Binding SidebarHex}" HorizontalAlignment="Left"/>
                                                    <Border Height="3" Width="36" CornerRadius="1.5"
                                                            Background="{Binding SidebarHex}" Opacity="0.65"
                                                            HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Spacing="0" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           MaxWidth="72" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ByLabel}" FontSize="10" Opacity="0.5"
                                                           HorizontalAlignment="Center"
                                                           MaxWidth="72" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- "+ Custom" add tile -->
                        <Button Classes="theme-btn"
                                Command="{Binding OpenThemeEditorCommand}"
                                CommandParameter="{x:Null}"
                                Margin="0,0,10,10"
                                ToolTip.Tip="{loc:T Settings.CreateCustomThemeTip}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="64" Height="40" CornerRadius="6"
                                        BorderBrush="#55FFFFFF" BorderThickness="1">
                                    <TextBlock Text="+" FontSize="22" Opacity="0.7"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{loc:T Settings.Custom}" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Classes="setting-card">
                <StackPanel Spacing="16">

                    <!-- Header row -->
                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:T Settings.AccentColor}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.PickPresetOpenPicker}"
                                       FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- Preset grid + custom-picker tile -->
                    <StackPanel Spacing="8">
                        <StackPanel>
                            <!-- Preset swatches -->
                            <ItemsControl ItemsSource="{Binding AccentSwatches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="12"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccentSwatch">
                                        <Button Classes="accent-swatch"
                                                Background="Transparent" BorderThickness="0" Padding="0"
                                                Margin="0,0,4,4" Cursor="Hand"
                                                ToolTip.Tip="{Binding Name}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).ApplyAccentPresetCommand}"
                                                CommandParameter="{Binding}">
                                            <Panel Width="44" Height="44">
                                                <Border Width="40" Height="40" CornerRadius="20"
                                                        Background="{Binding Hex}"
                                                        BorderBrush="#22000000"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <!-- Selection ring sits on the colour's own edge (same
                                                     40px box) so the white overlaps the disc's rim — no
                                                     dark border or anti-alias seam shows between the
                                                     colour and the white outline. -->
                                                <Border Width="40" Height="40" CornerRadius="20"
                                                        BorderBrush="White" BorderThickness="2"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsActive}"/>
                                            </Panel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Custom-color tile: rainbow ring + plus, opens reusable HSV/hex picker.
                                 Same 44px cell as a swatch so it reads as the next slot in the grid. -->
                            <Panel Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,4,4">
                                <controls:ColorPickerFlyout Hex="{Binding CustomAccentHex, Mode=TwoWay}"
                                                            SwatchSize="44"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            ToolTip.Tip="{loc:T Settings.CustomColorTip}"
                                                            Cursor="Hand">
                                    <controls:ColorPickerFlyout.SwatchContent>
                                        <Panel Width="44" Height="44">
                                            <!-- Rainbow ring -->
                                            <Border Width="40" Height="40" CornerRadius="20"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="50%,50%">
                                                        <GradientStop Offset="0.00" Color="#FF0000"/>
                                                        <GradientStop Offset="0.17" Color="#FFFF00"/>
                                                        <GradientStop Offset="0.33" Color="#00FF00"/>
                                                        <GradientStop Offset="0.50" Color="#00FFFF"/>
                                                        <GradientStop Offset="0.67" Color="#0000FF"/>
                                                        <GradientStop Offset="0.83" Color="#FF00FF"/>
                                                        <GradientStop Offset="1.00" Color="#FF0000"/>
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <!-- White inner disc with + glyph -->
                                            <Border Width="30" Height="30" CornerRadius="15"
                                                    Background="{DynamicResource AppMainBackground}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="+"
                                                           FontSize="20" FontWeight="Light"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Width="40" Height="40" CornerRadius="20"
                                                    BorderBrush="White" BorderThickness="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    IsVisible="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).IsCustomAccentSelected}"/>
                                        </Panel>
                                    </controls:ColorPickerFlyout.SwatchContent>
                                </controls:ColorPickerFlyout>
                            </Panel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Accent follows album art (Discord, aaron 09-15) -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.AccentFollowsArtwork}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.AccentFollowsArtworkHint}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding AccentFollowsArtwork}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="setting-card group-card" Margin="0,14,0,10">
            <StackPanel>
            <Border Classes="setting-row" IsVisible="{Binding IsLiquidGlassSupported}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.LiquidGlass}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.FrostWindowTranslucentBlurred}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding LiquidGlassEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.PlayerBarOpacity}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HowSolidPlaybackBar}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <Slider Grid.Column="0"
                                Classes="accent-slider"
                                Minimum="0" Maximum="1"
                                x:Name="PlayerBarOpacitySlider"
                                Value="{Binding PlaybackBarBackgroundOpacity, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PlaybackBarBackgroundOpacity, StringFormat='{}{0:P0}'}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center"
                                   MinWidth="44" TextAlignment="Right" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.TrackBoxOpacity}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HowSolidTrackBox}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <Slider Grid.Column="0"
                                Classes="accent-slider"
                                Minimum="0" Maximum="1"
                                x:Name="TrackBoxOpacitySlider"
                                Value="{Binding PlaybackBarTrackBoxOpacity, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PlaybackBarTrackBoxOpacity, StringFormat='{}{0:P0}'}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center"
                                   MinWidth="44" TextAlignment="Right" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <Border Classes="setting-card group-card" Margin="0,14,0,10">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.TextAnimation}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ControlHowLongText}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Sub-header: Player Bar -->
                    <TextBlock Text="{loc:T Settings.PLAYERBAR}" FontSize="11" FontWeight="SemiBold" Opacity="0.4" Margin="0,4,0,2"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.AnimateLongTrackTitles}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding TrackTitleMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.AnimateLongArtistNames}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding ArtistMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Sub-header: Cover Flow -->
                    <TextBlock Text="{loc:T Settings.COVERFLOW}" FontSize="11" FontWeight="SemiBold" Opacity="0.4" Margin="0,8,0,2"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.AnimateLongTrackTitles}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding CoverFlowMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.AnimateLongArtistNames}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding CoverFlowArtistMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.AnimateLongAlbumTitles}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding CoverFlowAlbumMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Sub-header: Lyrics Page -->
                    <TextBlock Text="{loc:T Settings.LYRICSPAGE}" FontSize="11" FontWeight="SemiBold" Opacity="0.4" Margin="0,8,0,2"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.AnimateLongTrackTitles}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding LyricsTitleMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.AnimateLongArtistAlbum}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding LyricsArtistMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Sub-header: Mini Player -->
                    <TextBlock Text="{loc:T Settings.MINIPLAYER}" FontSize="11" FontWeight="SemiBold" Opacity="0.4" Margin="0,8,0,2"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.AnimateLongTrackTitles}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding MiniPlayerTitleMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.AnimateLongAlbumTitles}" FontSize="13" VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding MiniPlayerAlbumMarqueeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Home}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.HomeHeavyRotation}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HomeHeavyRotationDesc}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding HomeShowHeavyRotation}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Artwork}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.AnimatedArtwork}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ShowAnimatedCoverArt}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding EnableAnimatedCovers}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <!-- Toggle + its Tint strength slider share a spacing-free panel so the gap folds
                     with the body (see the Crossfade block). -->
                <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.AlbumPageColour}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.TintEachAlbumS}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding AlbumPageTintEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
                <!-- Tint strength (only while the page colour is on): how much of the cover
                     colour the page takes on; 100% is the full cover colour. -->
                <controls:CollapsibleContent IsOpen="{Binding AlbumPageTintEnabled}" Lift="10" Motion="Glide">
                <StackPanel Classes="sub-setting" Spacing="6" Margin="2,10,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.AlbumPageTintStrength}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.AlbumPageTintStrengthHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <Slider x:Name="AlbumPageTintStrengthSlider" Grid.Column="0" Classes="accent-slider"
                                Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding AlbumPageTintStrength, Mode=TwoWay}" VerticalAlignment="Center"
                                DoubleTapped="OnAlbumPageTintStrengthSliderDoubleTapped"/>
                        <TextBlock Grid.Column="1" Text="{Binding AlbumPageTintStrength, StringFormat='{}{0}%'}" FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="36" TextAlignment="Right"/>
                    </Grid>
                    <!-- Whole page: the colour also runs under Other Versions / More By. -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.AlbumPageTintWholePage}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.AlbumPageTintWholePageHint}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding AlbumPageTintWholePage}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
                </controls:CollapsibleContent>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <!-- Header + slider share a spacing-free panel so the 12px gap folds with the body
                         (see the Crossfade block). -->
                    <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.AutomaticAlbumCoverSize}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.FiveCoversPerRow}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding AlbumTileSizeAuto}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <controls:CollapsibleContent IsOpen="{Binding !AlbumTileSizeAuto}" Lift="10" Motion="Glide">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,12,0,0">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.Smaller}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Slider Grid.Column="1"
                                Classes="accent-slider"
                                Minimum="140" Maximum="320"
                                Value="{Binding AlbumTileTargetSize, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{loc:T Settings.Larger}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding AlbumTileTargetSize, StringFormat='{}{0:0} px'}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center"
                                   MinWidth="52" TextAlignment="Right" Margin="12,0,0,0"/>
                    </Grid>
                    </controls:CollapsibleContent>
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <Border Classes="setting-card group-card" Margin="0,14,0,10">
            <StackPanel>
            <Border Classes="setting-row" IsVisible="{Binding IsTaskbarProgressSupported}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.SongProgressTaskbar}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ShowHowFarAlong}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding TaskbarProgressEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="PlayerTabPanel" Classes="tab-page" IsVisible="{Binding IsPlayerTabVisible}" Spacing="4">
            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.PlayerIsland}" Margin="0,2,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.PlayerIslandButtons}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.AddExtraControlsPlayer}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <!-- Header + picker share a spacing-free panel so the 12px gap folds with the body
                         (see the Crossfade block). -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.RepeatButton}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.RepeatButtonNextToForward}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding PlaybackBarShowRepeat}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.FavoriteButton}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.FavoriteButtonHeart}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding PlaybackBarShowFavorite}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.MiniPlayerButton}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.MiniPlayerButtonHint}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding PlaybackBarShowMiniPlayer}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.IdleQueuePill}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.IdleQueuePillHint}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding PlaybackBarShowIdlePill}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.SkipBackForward}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.JumpFewSecondsEither}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding PlaybackBarShowSkipButtons}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <controls:CollapsibleContent IsOpen="{Binding PlaybackBarShowSkipButtons}" Lift="10" Motion="Glide">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,12,0,0">
                        <RadioButton Grid.Column="0" Classes="transition-card medium-card"
                                     GroupName="IslandSkipSeconds"
                                     IsChecked="{Binding IsSkipSeconds10, Mode=TwoWay}">
                            <TextBlock Text="{loc:T Settings.10Seconds}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Classes="transition-card medium-card"
                                     GroupName="IslandSkipSeconds"
                                     IsChecked="{Binding IsSkipSeconds15, Mode=TwoWay}">
                            <TextBlock Text="{loc:T Settings.15Seconds}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </RadioButton>
                        <RadioButton Grid.Column="2" Classes="transition-card medium-card"
                                     GroupName="IslandSkipSeconds"
                                     IsChecked="{Binding IsSkipSeconds30, Mode=TwoWay}">
                            <TextBlock Text="{loc:T Settings.30Seconds}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </RadioButton>
                    </Grid>
                    </controls:CollapsibleContent>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.PlaybackSpeed}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.1ButtonOpensSpeed}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding PlaybackBarShowPlaybackSpeed}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.SleepTimer}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.SleepTimerOneClick}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding PlaybackBarShowSleepTimer}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.Shuffle}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.ShuffleButtonAfterRepeat}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding PlaybackBarShowShuffle}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.EqualizerButton}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.EqualizerButtonHint}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding PlaybackBarShowEqualizer}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.PlaybackTime}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.PlaybackTimeInTrackBox}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding PlaybackBarShowTime}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- GitHub #93: waveform in the island and mini player seek bars (off by default). -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.WaveformSeekBar}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.WaveformSeekBarHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding WaveformSeekBarEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.PlayerIslandWidth}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HowWidePlayerIsland}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.Narrower}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Slider Grid.Column="1"
                                Classes="accent-slider"
                                Minimum="340" Maximum="1400"
                                x:Name="IslandWidthSlider"
                                Value="{Binding PlaybackBarIslandWidth, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{loc:T Settings.Wider}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding PlaybackBarIslandWidth, StringFormat='{}{0:0} px'}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center"
                                   MinWidth="52" TextAlignment="Right" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.MiniPlayer}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.MiniPlayerDesign}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HowMiniPlayerLooks}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <RadioButton Grid.Column="0" Classes="transition-card medium-card"
                                     GroupName="MiniPlayerStyle"
                                     IsChecked="{Binding IsMiniStyleClassic, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.ResizableGlassCardIconTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="5" Canvas.Top="2" Width="18" Height="24" RadiusX="5" RadiusY="5"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="9" Canvas.Top="6" Width="10" Height="10" RadiusX="3" RadiusY="3" Opacity="0.45"
                                               Fill="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Classic}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Classes="transition-card medium-card"
                                     GroupName="MiniPlayerStyle"
                                     IsChecked="{Binding IsMiniStylePill, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.RoundCoverOverlappingLightTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="8" Canvas.Top="8" Width="19" Height="12" RadiusX="6" RadiusY="6" Opacity="0.45"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Ellipse Canvas.Left="1" Canvas.Top="6" Width="16" Height="16"
                                             Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Pill}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="2" Classes="transition-card medium-card"
                                     GroupName="MiniPlayerStyle"
                                     IsChecked="{Binding IsMiniStyleSleeve, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.SpinningDiscPeekingOutTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Ellipse Canvas.Left="6" Canvas.Top="1" Width="16" Height="16" Opacity="0.45"
                                             Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="3" Canvas.Top="9" Width="22" Height="17" RadiusX="5" RadiusY="5"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Sleeve}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.MiniPlayerOpacity}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HowMuchDesktopShows}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <Slider Grid.Column="0"
                                Classes="accent-slider"
                                Minimum="0" Maximum="1"
                                x:Name="MiniPlayerOpacitySlider"
                                Value="{Binding MiniPlayerBackgroundOpacity, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding MiniPlayerBackgroundOpacity, StringFormat='{}{0:P0}'}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center"
                                   MinWidth="44" TextAlignment="Right" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="setting-row" IsVisible="{Binding IsMiniPlayerFrostSupported}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.MiniPlayerFrostedBackground}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.BlurDesktopBehindMiniPlayer}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding MiniPlayerFrostedBackground}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            </StackPanel>
            </Border>

            <Border Classes="setting-card group-card" Margin="0,14,0,10">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.NowPlayingArtwork}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HowCoverAppearsLyrics}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <RadioButton Grid.Column="0" Classes="transition-card medium-card"
                                     GroupName="NowPlayingArtwork"
                                     IsChecked="{Binding IsArtworkStyleCover, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.AlbumCoverAsTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="3" Canvas.Top="3" Width="22" Height="22" RadiusX="5" RadiusY="5"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Cover}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Classes="transition-card medium-card"
                                     GroupName="NowPlayingArtwork"
                                     IsChecked="{Binding IsArtworkStyleCompactDisc, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.SpinningCompactDiscTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Ellipse Canvas.Left="2" Canvas.Top="2" Width="24" Height="24"
                                             Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="8"/>
                                </Canvas>
                                <TextBlock Text="CD" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="2" Classes="transition-card medium-card"
                                     GroupName="NowPlayingArtwork"
                                     IsChecked="{Binding IsArtworkStyleVinyl, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.SleeveRecordPeekingOutTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Ellipse Canvas.Left="10" Canvas.Top="6" Width="16" Height="16"
                                             Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="5"/>
                                    <Rectangle Canvas.Left="2" Canvas.Top="5" Width="18" Height="18" RadiusX="3" RadiusY="3"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Vinyl}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="3" Classes="transition-card medium-card"
                                     GroupName="NowPlayingArtwork"
                                     IsChecked="{Binding IsArtworkStyleCassette, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.CassetteCoverItsLabelTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="2" Canvas.Top="6" Width="24" Height="16" RadiusX="4" RadiusY="4"
                                               Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="2.5"/>
                                    <Ellipse Canvas.Left="7" Canvas.Top="11.5" Width="5" Height="5"
                                             Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Ellipse Canvas.Left="16" Canvas.Top="11.5" Width="5" Height="5"
                                             Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Cassette}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <Border Classes="setting-card group-card" Margin="0,14,0,10">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.CoverFlowLayout}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HowCoverFlowPage}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <RadioButton Grid.Column="0" Classes="transition-card medium-card"
                                     GroupName="CoverFlowLayout"
                                     IsChecked="{Binding IsCoverFlowCarousel, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.ClassicRowPlayingCoverTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="1" Canvas.Top="9" Width="6" Height="10" RadiusX="1.5" RadiusY="1.5" Opacity="0.45"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="21" Canvas.Top="9" Width="6" Height="10" RadiusX="1.5" RadiusY="1.5" Opacity="0.45"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="8" Canvas.Top="5" Width="12" Height="18" RadiusX="2.5" RadiusY="2.5"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Carousel}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Classes="transition-card medium-card"
                                     GroupName="CoverFlowLayout"
                                     IsChecked="{Binding IsCoverFlowCascade, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.TiltedCoversDiagonalPathTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="4" Canvas.Top="1" Width="9" Height="9" RadiusX="2" RadiusY="2" Opacity="0.45"
                                               RenderTransformOrigin="50%,50%" RenderTransform="rotate(-24deg)"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="4" Canvas.Top="18" Width="9" Height="9" RadiusX="2" RadiusY="2" Opacity="0.45"
                                               RenderTransformOrigin="50%,50%" RenderTransform="rotate(18deg)"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="11" Canvas.Top="7" Width="14" Height="14" RadiusX="3" RadiusY="3"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Cascade}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="2" Classes="transition-card medium-card"
                                     GroupName="CoverFlowLayout"
                                     IsChecked="{Binding IsCoverFlowCollage, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.MosaicQueueSCoversTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="2" Canvas.Top="2" Width="11" Height="11" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="15" Canvas.Top="2" Width="11" Height="11" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="2" Canvas.Top="15" Width="11" Height="11" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="15" Canvas.Top="15" Width="11" Height="11" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Collage}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="LyricsTabPanel" Classes="tab-page" IsVisible="{Binding IsLyricsTabVisible}" Spacing="4">
            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.LyricsPage}" Margin="0,2,0,8"/>
            <!-- Style presets from content packs (only while an enabled pack provides some). -->
            <Border Classes="setting-card" IsVisible="{Binding HasLyricsPresets}" Margin="0,0,0,8">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.LyricsPresets.Title}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.LyricsPresets.Description}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding LyricsPresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LyricsPresetItem">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13"/>
                                        <TextBlock Text="{Binding ByLabel}" FontSize="11" Opacity="0.5"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="pill-action" Padding="12,6" CornerRadius="999" Cursor="Hand"
                                            VerticalAlignment="Center"
                                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).ApplyLyricsPresetCommand}"
                                            CommandParameter="{Binding Key}">
                                        <TextBlock Text="{loc:T Settings.LyricsPresets.Apply}" FontSize="12"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding LyricsPresetStatus}" FontSize="12" Opacity="0.8"
                               IsVisible="{Binding LyricsPresetStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </Border>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="{loc:T Settings.FlowingLyricsBackground}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.BlurredAlbumArtworkDrifts}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="200" VerticalAlignment="Center"
                                  ItemsSource="{Binding FlowingOptions}"
                                  SelectedItem="{Binding SelectedFlowingOption, Mode=TwoWay}"/>
                    </Grid>
                    <!-- Kawarp knobs (GitHub #58): only while a Kawarp style is chosen. -->
                    <controls:CollapsibleContent IsOpen="{Binding IsKawarpStyle}" Lift="6">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="110,*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.KawarpWarp}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Classes="accent-slider" Minimum="0" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    Value="{Binding LyricsKawarpWarp, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding LyricsKawarpWarp, StringFormat='{}{0:0.0}'}" FontSize="12" Opacity="0.7"
                                       VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="28" TextAlignment="Right"/>
                        </Grid>
                        <Grid ColumnDefinitions="110,*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.KawarpBlur}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Classes="accent-slider" Minimum="1" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding LyricsKawarpBlur, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding LyricsKawarpBlur}" FontSize="12" Opacity="0.7"
                                       VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="28" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                    </controls:CollapsibleContent>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.AudioVisualizer}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.DrawLiveSpectrumMusic}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding LyricsVisualizerEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Artwork colour row + style picker share a spacing-free panel so the 12px gap folds
                         with the body (see the Crossfade block). -->
                    <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.ArtworkColour}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.TintBarsCurrentCover}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding LyricsVisualizerArtworkColor}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <controls:CollapsibleContent IsOpen="{Binding LyricsVisualizerEnabled}" Lift="10" Motion="Glide">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,12,0,0">
                        <RadioButton Grid.Column="0" Classes="transition-card medium-card"
                                     GroupName="LyricsVisualizerStyle"
                                     IsChecked="{Binding IsVisualizerStyleBars, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.FrequencyBarsRisingFromTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="2" Canvas.Top="16" Width="4" Height="10" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="8" Canvas.Top="6" Width="4" Height="20" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="14" Canvas.Top="11" Width="4" Height="15" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="20" Canvas.Top="2" Width="4" Height="24" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Bars}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Classes="transition-card medium-card"
                                     GroupName="LyricsVisualizerStyle"
                                     IsChecked="{Binding IsVisualizerStyleMirror, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.BarsMirroredAboutCentreTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Rectangle Canvas.Left="2" Canvas.Top="10" Width="4" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="8" Canvas.Top="4" Width="4" Height="20" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="14" Canvas.Top="7" Width="4" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <Rectangle Canvas.Left="20" Canvas.Top="2" Width="4" Height="24" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Mirror}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="2" Classes="transition-card medium-card"
                                     GroupName="LyricsVisualizerStyle"
                                     IsChecked="{Binding IsVisualizerStyleWave, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.SmoothFilledCurveTip}">
                            <StackPanel Spacing="8">
                                <Canvas Classes="medium-glyph">
                                    <Path Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                          Data="M2,26 L2,18 C6,16 8,6 12,8 C16,10 18,20 22,12 L26,10 L26,26 Z"/>
                                </Canvas>
                                <TextBlock Text="{loc:T Settings.Wave}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                    </controls:CollapsibleContent>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.FullscreenLyricsFocus}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.DimAllButCurrent}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding LyricsFullScreenFocusEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- Minimum line opacity: floors the lyrics page's distance ramp so every line
                 stays visible and clickable (jump anywhere in the song from its lyrics). -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,200,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.LyricsMinLineOpacity}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.LyricsMinLineOpacityHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Slider x:Name="LyricsMinLineOpacitySlider" Grid.Column="1" Classes="accent-slider" Minimum="0" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding LyricsMinLineOpacity, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0"
                            DoubleTapped="OnLyricsMinLineOpacitySliderDoubleTapped"/>
                    <TextBlock Grid.Column="2" Text="{Binding LyricsMinLineOpacity, StringFormat='{}{0}%'}" FontSize="12" Opacity="0.7"
                               VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="36" TextAlignment="Right"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.JoinSplitWords}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.KeepWordsWholeWhen}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding LyricsJoinSplitWords}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- Lyric layers (issue #78): display-only, the lyrics are not reloaded. -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.ShowTranslations}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ShowTranslationsHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding LyricsShowTranslations}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.ShowRomanization}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ShowRomanizationHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding LyricsShowRomanization}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.ShowBackgroundVocals}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ShowBackgroundVocalsHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding LyricsShowBackgroundVocals}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.OnlineLyrics}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:T Settings.UseOnlineLyricsWhen}"
                               FontSize="12" Opacity="0.5" Margin="0,0,0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.LRCLIB}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.CommunityLyricsDatabase}" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding LrcLibEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.NetEaseCloudMusic}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.LargeSyncedLyricsCatalog}" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding NetEaseEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            </StackPanel>

            <StackPanel x:Name="ShortcutsTabPanel" Classes="tab-page" IsVisible="{Binding IsShortcutsTabVisible}" Spacing="4">
                <Border Classes="setting-card">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.KeyboardShortcuts}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.ClickKeyChangePress}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{loc:T Settings.ResetAll}"
                                FontSize="12" FontWeight="SemiBold"
                                Padding="14,7"
                                CornerRadius="999"
                                BorderThickness="0"
                                Background="{DynamicResource SystemControlBackgroundListMediumBrush}"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0"
                                Command="{Binding Shortcuts.ResetAllCommand}"/>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Shortcuts.Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShortcutGroup">
                            <Border Classes="setting-card">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="12"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ShortcutRowViewModel">
                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13" VerticalAlignment="Center"/>
                                                    <controls:ShortcutKeyChip Grid.Column="1" VerticalAlignment="Center"/>
                                                    <!-- Per-row reset, only once the row differs from its default. -->
                                                    <Button Grid.Column="2"
                                                            Width="26" Height="26"
                                                            Margin="6,0,0,0"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            CornerRadius="999"
                                                            Cursor="Hand"
                                                            ToolTip.Tip="{loc:T Settings.ResetDefaultTip}"
                                                            IsVisible="{Binding !IsDefault}"
                                                            Command="{Binding ResetCommand}">
                                                        <PathIcon Data="M 12.5 8 A 4.5 4.5 0 1 1 11.2 4.8 M 11.5 2 L 11.5 5 L 8.5 5"
                                                                  Width="13" Height="13"
                                                                  Opacity="0.7"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- STATISTICS (listening statistics)                   -->
            <!-- ═══════════════════════════════════════════════════ -->

            <StackPanel x:Name="AudioTabPanel" Classes="tab-page" IsVisible="{Binding IsAudioTabVisible}" Spacing="4">
            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Playback}" Margin="0,2,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row"
                    IsEnabled="{Binding CanUseSongTransitions}"
                    Opacity="{Binding SongTransitionsOpacity}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.SongTransitions}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.SongsBlendSmoothlyInto}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                            <controls:CollapsibleContent IsOpen="{Binding ExclusiveAudioEnabled}" Lift="6">
                                <TextBlock Text="{loc:T Settings.UnavailableWhileExclusiveMode}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentColorBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </controls:CollapsibleContent>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding SongTransitionsEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Transition Style picker -->
                    <StackPanel Spacing="6" IsEnabled="{Binding SongTransitionsEnabled}">
                        <TextBlock Text="{loc:T Settings.TRANSITIONSTYLE}" FontSize="10" Opacity="0.45" Margin="2,4,0,2"/>

                        <RadioButton Classes="transition-card"
                                     GroupName="TransitionStyle"
                                     IsChecked="{Binding IsAutoMixStyle, Mode=TwoWay}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings.AutoMix}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:T Settings.TransitionsTimedUsingEach}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Card + its duration block share a spacing-free panel: StackPanel Spacing is paid per
                             VISIBLE child and vanishes in one go when the shut block turns invisible, which
                             snapped everything below up 6px on the fold's last frame. The gap lives on the
                             body's margin instead, inside the animated height (same recipe as Home). -->
                        <StackPanel>
                        <RadioButton Classes="transition-card"
                                     GroupName="TransitionStyle"
                                     IsChecked="{Binding IsCrossfadeStyle, Mode=TwoWay}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings.Crossfade}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:T Settings.SimpleFadeBetweenSongs}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Crossfade Duration (only for the Crossfade style): slides open under the card.
                             Glide motion, unlike every other collapsible here, so the new reveal can be
                             judged side by side against the plain fold. -->
                        <controls:CollapsibleContent IsOpen="{Binding IsCrossfadeStyle}" Lift="10" Motion="Glide">
                        <StackPanel Classes="sub-setting" Spacing="6" Margin="2,10,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{loc:T Settings.CrossfadeDuration}" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <!-- Quick presets; the slider below still allows any 1–12 s. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button Classes="preset-chip" Classes.selected="{Binding IsCrossfade3s}"
                                            Content="3s" Command="{Binding SetCrossfadePresetCommand}" CommandParameter="3"/>
                                    <Button Classes="preset-chip" Classes.selected="{Binding IsCrossfade6s}"
                                            Content="6s" Command="{Binding SetCrossfadePresetCommand}" CommandParameter="6"/>
                                    <Button Classes="preset-chip" Classes.selected="{Binding IsCrossfade10s}"
                                            Content="{loc:T Settings.10s}" Command="{Binding SetCrossfadePresetCommand}" CommandParameter="10"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Slider Grid.Column="0"
                                        Classes="accent-slider"
                                        Minimum="1" Maximum="12"
                                        Value="{Binding CrossfadeDuration, Mode=TwoWay}"
                                        DoubleTapped="OnCrossfadeSliderDoubleTapped"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CrossfadeDuration, StringFormat='{}{0:0} seconds'}"
                                           FontSize="12" Opacity="0.7"
                                           VerticalAlignment="Center"
                                           MinWidth="74" TextAlignment="Right" Margin="12,0,0,0"/>
                            </Grid>
                        </StackPanel>
                        </controls:CollapsibleContent>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.SoundCheck}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.KeepSongVolumeAt}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding SoundCheckEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.GaplessPlayback}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.TracksFlowIntoEach}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding GaplessPlaybackEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- GitHub #73: the level fades out before a pause lands and back in after a resume. -->
            <Border Classes="setting-row">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.PlayPauseFade}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.PlayPauseFadeHint}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding PlayPauseFadeEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <controls:CollapsibleContent IsOpen="{Binding PlayPauseFadeEnabled}" Lift="10">
                        <StackPanel Classes="sub-setting" Spacing="6" Margin="2,10,0,0">
                            <TextBlock Text="{loc:T Settings.FadeDuration}" FontSize="13" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <Slider Grid.Column="0"
                                        Classes="accent-slider"
                                        Minimum="100" Maximum="2000"
                                        TickFrequency="50" IsSnapToTickEnabled="True"
                                        Value="{Binding PlayPauseFadeMs, Mode=TwoWay}"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding PlayPauseFadeMs, StringFormat='{}{0:0} ms'}"
                                           FontSize="12" Opacity="0.7"
                                           VerticalAlignment="Center"
                                           MinWidth="74" TextAlignment="Right" Margin="12,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </controls:CollapsibleContent>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.Autoplay}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.WhenQueueEndsKeep}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding AutoplayEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.ExplicitContent}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.AllowExplicitSongsWhen}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding AllowExplicitContent}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Output}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row" IsVisible="{Binding IsExclusiveAudioSupported}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.ExclusiveMode}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.BitPerfectOutputBypasses}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        <controls:CollapsibleContent IsOpen="{Binding ExclusiveAudioStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Lift="6">
                            <TextBlock Text="{Binding ExclusiveAudioStatus}"
                                       FontSize="12" Opacity="0.8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </controls:CollapsibleContent>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding ExclusiveAudioEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row" IsVisible="{Binding IsUpmixSupported}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Upmix.Title}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Upmix.Description}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <RadioButton Grid.Column="0" Classes="transition-card medium-card" GroupName="UpmixMode"
                                     IsChecked="{Binding IsUpmixOff, Mode=TwoWay}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Upmix.Off}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:T Upmix.OffHint}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Classes="transition-card medium-card" GroupName="UpmixMode"
                                     IsChecked="{Binding IsUpmixDuplicate, Mode=TwoWay}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Upmix.Duplicate}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:T Upmix.DuplicateHint}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="2" Classes="transition-card medium-card" GroupName="UpmixMode"
                                     IsChecked="{Binding IsUpmixSurround, Mode=TwoWay}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Upmix.Surround}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:T Upmix.SurroundHint}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                    <TextBlock Text="{loc:T Upmix.Note}" FontSize="11" Opacity="0.45" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.ReplayGain}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.AdjustVolumeUsingReplayGain}"
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding ReplayGainEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Classes="sub-setting" ColumnDefinitions="120,*" IsEnabled="{Binding ReplayGainEnabled}">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.Mode}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  Classes="pill-list"
                                  ItemsSource="{Binding ReplayGainModeOptions}"
                                  SelectedItem="{Binding ReplayGainMode}"
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="999"
                                  Padding="14,8"/>
                    </Grid>
                    <Grid Classes="sub-setting" ColumnDefinitions="120,*,Auto" IsEnabled="{Binding ReplayGainEnabled}">
                        <TextBlock Grid.Column="0" Text="{loc:T Settings.PreAmpDB}" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" Height="20" ClipToBounds="False"
                              VerticalAlignment="Center" Margin="0,0,12,0">
                            <Canvas x:Name="PreampVisual"
                                    Height="20"
                                    ClipToBounds="False"
                                    IsHitTestVisible="False">
                                <Border x:Name="PreampTrackBackground"
                                        Height="6"
                                        CornerRadius="3"
                                        Background="{DynamicResource IslandSliderUnfilled}"
                                        Opacity="0.4"
                                        Canvas.Top="7"/>
                                <Border x:Name="PreampTrackFill"
                                        Height="6"
                                        CornerRadius="3"
                                        Background="{DynamicResource IslandSliderFilled}"
                                        Canvas.Top="7"/>
                                <Border x:Name="PreampThumb"
                                        Width="14"
                                        Height="14"
                                        CornerRadius="7"
                                        Background="{DynamicResource IslandSliderFilled}"
                                        BoxShadow="0 1 3 0 #40000000"
                                        Canvas.Top="3"/>
                            </Canvas>
                            <Slider x:Name="PreampSlider"
                                    Classes="preamp-horizontal"
                                    Value="{Binding ReplayGainPreampDb, Mode=TwoWay}"
                                    Minimum="-12" Maximum="12"
                                    HorizontalAlignment="Stretch"
                                    DoubleTapped="OnPreampSliderDoubleTapped" />
                        </Grid>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ReplayGainPreampDb, StringFormat='{}{0:+0.0;-0.0;0.0} dB'}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" MinWidth="60"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <Border Classes="setting-card group-card" Margin="0,14,0,10">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.AnalyzeTempoKey}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.DetectBPMKeyAutoMix}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding BpmKeyAnalysisEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Classes="sub-setting" ColumnDefinitions="*,Auto" IsEnabled="{Binding BpmKeyAnalysisEnabled}">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.SaveAnalysisFileTags}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.WriteBPMKeyInto}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding WriteAnalysisToTags}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <Border Classes="setting-card" Padding="22,16,38,16" ClipToBounds="False" Margin="0,14,0,10">
                <StackPanel Spacing="16">
                    <!-- Header row: title + master switch (GitHub #94). Off bypasses the EQ but
                         keeps every value below, so switching back on restores the same curve. -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings.Equalizer}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:T Settings.ParametricEQTuneEach}"
                                           FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding EqualizerEnabled}"
                                              ToolTip.Tip="{loc:T Settings.EqualizerOnOffTip}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Everything below greys out (values kept) while the EQ is off. -->
                    <StackPanel Spacing="16"
                                IsEnabled="{Binding EqualizerEnabled}"
                                Opacity="{Binding EqualizerControlsOpacity}">
                    <!-- Preset row (GitHub #95): selector, save / delete / restore, reset.
                         Wraps rather than overflowing on a narrow Settings pane. -->
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                        <ComboBox x:Name="EqPresetCombo"
                                  Classes="pill-combo stable-popup"
                                  Width="164"
                                  ItemsSource="{Binding VisibleEqPresets}"
                                  SelectedItem="{Binding SelectedEqPresetName}"
                                  VerticalAlignment="Center" />
                        <Button x:Name="EqSavePresetButton"
                                Classes="pill-action"
                                CornerRadius="999"
                                Padding="14,8"
                                Cursor="Hand"
                                ToolTip.Tip="{loc:T Settings.SaveEqPresetTip}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.SaveEqPreset}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button.Flyout>
                                <!-- One row: pill name box + Save. Fades/scales in and out like
                                     the custom theme editor (code-behind). -->
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel x:Name="EqPresetFlyoutBody" Spacing="6" Width="280">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox Text="{Binding NewEqPresetName}"
                                                     MaxLength="40"
                                                     CornerRadius="999"
                                                     Padding="14,7"
                                                     VerticalContentAlignment="Center"
                                                     Watermark="{loc:T Settings.EqPresetName}"
                                                     AttachedToVisualTree="OnEqPresetNameBoxAttached"
                                                     KeyDown="OnEqPresetNameKeyDown"/>
                                            <Button Grid.Column="1"
                                                    Classes="pill-action"
                                                    CornerRadius="999"
                                                    Padding="16,7"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center"
                                                    Click="OnEqSavePresetClick">
                                                <TextBlock Text="{loc:T Settings.SaveEqPreset}" FontSize="13" FontWeight="SemiBold"/>
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{Binding EqPresetSaveError}"
                                                   IsVisible="{Binding EqPresetSaveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   Margin="14,0,0,0"
                                                   FontSize="11" Foreground="#FF6B6B" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="pill-action"
                                Command="{Binding DeleteSelectedEqPresetCommand}"
                                IsEnabled="{Binding CanDeleteSelectedEqPreset}"
                                CornerRadius="999"
                                Padding="14,8"
                                Cursor="Hand"
                                ToolTip.Tip="{loc:T Settings.DeleteEqPresetTip}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.DeleteEqPreset}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Button>
                        <!-- Only while a built-in has been deleted (hidden). -->
                        <Button Classes="pill-action"
                                Command="{Binding RestoreBuiltInEqPresetsCommand}"
                                IsVisible="{Binding HasHiddenEqPresets}"
                                CornerRadius="999"
                                Padding="14,8"
                                Cursor="Hand"
                                ToolTip.Tip="{loc:T Settings.RestoreEqPresetsTip}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.RestoreEqPresets}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Button>
                        <Button Classes="pill-action"
                                Command="{Binding ResetEqualizerCommand}"
                                CornerRadius="999"
                                Padding="14,8"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.Reset}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Button>
                    </WrapPanel>

                    <!-- Pre-amp: level relative to native, applied before the curve.
                         Negative values create the headroom that keeps boosted bands
                         from clipping — the post-mix volume slider cannot. -->
                    <Grid ColumnDefinitions="120,*,64,92,34" Margin="0,2,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="{loc:T Settings.Preamp}"
                                   FontSize="12" FontWeight="SemiBold" Opacity="0.85"
                                   VerticalAlignment="Center"/>
                        <Slider Grid.Column="1"
                                Classes="accent-slider"
                                Minimum="-12" Maximum="6"
                                Value="{Binding EqPreampDb}"
                                DoubleTapped="OnEqPreampSliderDoubleTapped"
                                ToolTip.Tip="{loc:T Settings.LevelBeforeEQLowerTip}"
                                Margin="14,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding EqPreampDb, StringFormat='{}{0:+0.0;-0.0;0.0} dB'}"
                                   FontSize="11" Opacity="0.7"
                                   VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>

                    <!-- Parametric band rows: frequency / gain / Q per band -->
                    <StackPanel Spacing="0" Margin="0,4,0,0">
                        <Grid ColumnDefinitions="120,*,64,92,34" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.FREQUENCY}" FontSize="10" Opacity="0.45"/>
                            <TextBlock Grid.Column="1" Text="{loc:T Settings.GAIN}" FontSize="10" Opacity="0.45" Margin="14,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="Q" FontSize="10" Opacity="0.45" Margin="10,0,0,0" HorizontalAlignment="Center"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding EqBands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EqBandViewModel">
                                    <Grid ColumnDefinitions="120,*,64,92,34" Margin="0,3">
                                        <NumericUpDown Grid.Column="0"
                                                       Classes="eq-pill-number"
                                                       Value="{Binding FrequencyHz}"
                                                       Minimum="20" Maximum="20000" Increment="10"
                                                       FormatString="0"
                                                       FontSize="12"
                                                       ToolTip.Tip="{loc:T Settings.CenterFrequencyHzTypeTip}"
                                                       VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1"
                                                Classes="accent-slider"
                                                Minimum="-12" Maximum="12"
                                                Value="{Binding GainDb}"
                                                DoubleTapped="OnEqGainSliderDoubleTapped"
                                                Margin="14,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding GainLabel}"
                                                   FontSize="11" Opacity="0.7"
                                                   VerticalAlignment="Center" TextAlignment="Right"/>
                                        <NumericUpDown Grid.Column="3"
                                                       Classes="eq-pill-number"
                                                       Value="{Binding Q}"
                                                       Minimum="0.1" Maximum="10" Increment="0.1"
                                                       FormatString="0.0#"
                                                       FontSize="12"
                                                       ToolTip.Tip="{loc:T Settings.QBandWidthHigherTip}"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <Button Grid.Column="4" Classes="eq-remove"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                IsEnabled="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).CanRemoveEqBand}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveEqBandCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{loc:T Settings.RemoveBandTip}">
                                            <PathIcon Data="{StaticResource DismissIcon}" Width="10" Height="10"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="pill-action"
                                Command="{Binding AddEqBandCommand}"
                                IsEnabled="{Binding CanAddEqBand}"
                                CornerRadius="999"
                                Padding="14,8"
                                Margin="0,8,0,0"
                                Cursor="Hand"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{loc:T Settings.AddBand}" FontSize="13" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="LibraryTabPanel" Classes="tab-page" IsVisible="{Binding IsLibraryTabVisible}" Spacing="4">
            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Folders}" Margin="0,2,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{loc:T Settings.MediaFolderLocations}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:T Settings.FoldersWhereMusicStored}"
                                           FontSize="12" Opacity="0.5"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="AddFolderButton"
                                Classes="pill-action"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.AddFolder}" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Folder list -->
                    <ItemsControl ItemsSource="{Binding MusicFolders}">
                        <ItemsControl.Styles>
                            <Style Selector="ItemsControl:empty">
                                <Setter Property="IsVisible" Value="False"/>
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <Border Padding="14,8" Margin="0,2" CornerRadius="12"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1"
                                                Content="{loc:T Settings.Text}"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveFolderCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="14"
                                                Opacity="0.5"
                                                Cursor="Hand"
                                                Padding="4"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- GitHub #71: off = dropped files play / queue from where they are, nothing is
                 moved into Noctis Imports or added to the library. -->
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{loc:T Settings.ImportDroppedFiles}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ImportDroppedFilesHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding ImportDroppedMedia}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- GitHub #74: playlist page furniture, each opt-out. -->
            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.PlaylistPage}" Margin="0,16,0,8"/>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{loc:T Settings.PlaylistAlbumHeaders}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.PlaylistAlbumHeadersHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding PlaylistShowAlbumHeaders}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{loc:T Settings.PlaylistNewBadge}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.PlaylistNewBadgeHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding PlaylistShowNewBadge}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{loc:T Settings.PlaylistAddedColumn}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.PlaylistAddedColumnHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding PlaylistShowAddedColumn}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{loc:T Settings.PlaylistFavoriteColumn}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.PlaylistFavoriteColumnHint}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding PlaylistShowFavoriteColumn}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.LibraryScan}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.FindNewTracksUpdate}"
                                       FontSize="12" Opacity="0.5"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Classes="loading-spinner"
                                 IsVisible="{Binding IsScanning}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ScanStatusText}"
                                   FontSize="12"
                                   Opacity="0.6"
                                   VerticalAlignment="Center"/>
                        <Button Classes="pill-action"
                                Command="{Binding RescanCommand}"
                                IsEnabled="{Binding !IsScanning}"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand">
                            <TextBlock Text="{loc:T Settings.ScanLibrary}" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:T Settings.ScanStartup}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.ScanMusicFoldersWhen}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding ScanOnStartup}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:T Settings.WatchFolders}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.UpdateLibraryAutomaticallyAs}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding WatchFoldersEnabled}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:T Settings.UseEmbeddedArtwork}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.UseArtworkEmbeddedFile}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding UseEmbeddedArtwork}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Organisation}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.CollapseAlbumEditions}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ShowOneTilePer}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding CollapseAlbumEditions}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.MergeFeaturedArtistsFrom}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.TurnFeatXTrack}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding MergeFeaturedFromTitles}"
                                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.GroupArtistsBy}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.WhichTagArtistsSection}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <RadioButton Grid.Column="0" Classes="transition-card medium-card"
                                     GroupName="ArtistGroupMode"
                                     IsChecked="{Binding IsArtistGroupByArtist, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.FirstCreditedArtistEachTip}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:T Settings.Artist}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:T Settings.SongSArtistTag}" FontSize="11" Opacity="0.55" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Classes="transition-card medium-card"
                                     GroupName="ArtistGroupMode"
                                     IsChecked="{Binding IsArtistGroupByAlbumArtist, Mode=TwoWay}"
                                     ToolTip.Tip="{loc:T Settings.AlbumArtistTagSongsTip}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:T Settings.AlbumArtist}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:T Settings.ReleaseSAlbumArtist}" FontSize="11" Opacity="0.55" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.ArtistTagSeparators}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.TextSplitsOneArtist}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="pill" Content="{loc:T Settings.Reset}" FontSize="12" Padding="14,6"
                                VerticalAlignment="Top" Margin="12,0,0,0"
                                Command="{Binding ResetArtistSeparatorsCommand}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ArtistTagSeparators}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <Border Padding="12,4,6,4" Margin="0,0,6,6" CornerRadius="14"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="{loc:T Settings.Text}"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveArtistSeparatorCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="11"
                                                Opacity="0.5"
                                                Cursor="Hand"
                                                Padding="4,2"
                                                ToolTip.Tip="{loc:T Settings.RemoveSeparatorTip}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Classes="settings-search"
                                 Text="{Binding NewArtistSeparator, Mode=TwoWay}"
                                 Watermark="{loc:T Settings.AddSeparatorEG}"
                                 Padding="14,6"
                                 MaxWidth="320" HorizontalAlignment="Left" MinWidth="220">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding AddArtistSeparatorCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Classes="pill" Content="{loc:T Settings.Add}" FontSize="13" Padding="16,6"
                                Command="{Binding AddArtistSeparatorCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Metadata}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:T Settings.TagSourcesSearchMetadata}"
                               FontSize="12" Opacity="0.5" Margin="0,0,0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.Deezer}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.MusicStreamingCatalog}" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding DeezerEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.MusicBrainz}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.OpenMusicEncyclopedia}" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding MusicBrainzEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Tools}" Margin="0,16,0,8"/>
            <!-- One group card, one row per tool: glyph, title + one-line description, action. -->
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Classes="tool-bitmap" RenderOptions.BitmapInterpolationMode="HighQuality">
                        <Border.OpacityMask>
                            <ImageBrush Source="avares://Noctis.UI/Assets/Icons/Folder%20ICON.png" Stretch="Uniform"/>
                        </Border.OpacityMask>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Settings.OrganizeFiles}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.RenameMoveFilesInto}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="pill-action" Command="{Binding OpenOrganizeFilesCommand}"
                            Padding="14,8" CornerRadius="999" Cursor="Hand" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{loc:T Settings.Organize}" FontSize="13"/>
                    </Button>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.Column="0" Classes="tool-icon" Data="{StaticResource CopyIcon}"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Settings.FindDuplicates}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.FindDuplicateTracksRemove}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="pill-action" Command="{Binding OpenDuplicateFinderCommand}"
                            Padding="14,8" CornerRadius="999" Cursor="Hand" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{loc:T Settings.Find}" FontSize="13"/>
                    </Button>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.Column="0" Classes="tool-icon" Data="{StaticResource TagIcon}"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Settings.FindMetadata}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.IdentifyPoorlyTaggedTracks}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="pill-action" Command="{Binding OpenMetadataFinderCommand}"
                            Padding="14,8" CornerRadius="999" Cursor="Hand" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{loc:T Settings.Find}" FontSize="13"/>
                    </Button>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Classes="tool-bitmap" RenderOptions.BitmapInterpolationMode="HighQuality">
                        <Border.OpacityMask>
                            <ImageBrush Source="avares://Noctis.UI/Assets/Icons/Playlist%20icon.png" Stretch="Uniform"/>
                        </Border.OpacityMask>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Settings.ImportPlaylist}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ImportM3UExportifyCSV}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="pill-action" Command="{Binding OpenPlaylistImportCommand}"
                            Padding="14,8" CornerRadius="999" Cursor="Hand" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{loc:T Settings.Import}" FontSize="13"/>
                    </Button>
                </Grid>
            </Border>
            </StackPanel>
            </Border>

            <!-- YouTube: its own card, header row then the two settings stacked. -->
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.Column="0" Classes="tool-icon" Data="{StaticResource PlayIcon}"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T YouTubeSettings.Title}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T YouTubeSettings.Description}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="pill-action" Command="{Binding OpenYouTubeDownloaderCommand}"
                            Padding="14,8" CornerRadius="999" Cursor="Hand" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{loc:T YouTubeSettings.Open}" FontSize="13"/>
                    </Button>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="150,*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Column="0" Grid.Row="0" Text="{loc:T YouTubeSettings.Folder}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding YouTubeDownloadFolder}" Watermark="{Binding YouTubeDownloadFolderHint}"
                             CornerRadius="999" Padding="14,8" BorderThickness="1.5" MinHeight="0" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Grid.Row="0" Content="{loc:T Settings.Browse}" Command="{Binding BrowseYouTubeFolderCommand}"
                            Padding="14,8" CornerRadius="999" Margin="8,0,0,0" Cursor="Hand" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Text="{loc:T YouTubeSettings.FolderHint}"
                               FontSize="11" Opacity="0.5" TextWrapping="Wrap" Margin="2,6,0,0"/>
                </Grid>
            </Border>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="150,*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Grid.Row="0" Text="{loc:T YouTubeSettings.Tool}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding YtDlpPath}" Watermark="{loc:T YouTubeSettings.ToolPathHint}"
                             CornerRadius="999" Padding="14,8" BorderThickness="1.5" MinHeight="0" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Grid.Row="0" Classes="pill-action" Command="{Binding InstallYtDlpCommand}" IsEnabled="{Binding !IsInstallingYtDlp}"
                            Padding="14,8" CornerRadius="999" Margin="8,0,0,0" Cursor="Hand" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T YouTubeSettings.InstallUpdate}" FontSize="12"/>
                    </Button>
                    <TextBlock Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding YtDlpStatus}"
                               FontSize="11" Opacity="0.5" TextWrapping="Wrap" Margin="2,6,0,0"/>
                    <ProgressBar Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" Value="{Binding YtDlpInstallProgress}" Minimum="0" Maximum="1"
                                 Height="3" CornerRadius="2" Margin="0,6,0,0" IsVisible="{Binding IsInstallingYtDlp}"/>
                </Grid>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.HiddenTracks}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.SnoozedTracks}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.HiddenFromShuffleRadio}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Text="{loc:T Settings.NoSnoozedTracks}"
                               FontSize="13" Opacity="0.45"
                               IsVisible="{Binding !HasSnoozedTracks}"/>

                    <ItemsControl ItemsSource="{Binding SnoozedTracks}">
                        <ItemsControl.Styles>
                            <Style Selector="ItemsControl:empty">
                                <Setter Property="IsVisible" Value="False"/>
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Track">
                                <Border Padding="14,8" Margin="0,2" CornerRadius="12"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Artist}"
                                                       FontSize="12" Opacity="0.55"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SnoozedUntil, StringFormat='Until {0:MMM d, yyyy}'}"
                                                   FontSize="12" Opacity="0.5"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0"/>
                                        <Button Grid.Column="2"
                                                Classes="pill-action"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).UnsnoozeCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="12,6"
                                                CornerRadius="14"
                                                Cursor="Hand"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{loc:T Settings.UnSnooze}" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Settings.RemovedTracks}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.RemovedFromLibraryTheir}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Text="{loc:T Settings.NoRemovedTracks}"
                               FontSize="13" Opacity="0.45"
                               IsVisible="{Binding !HasRemovedTracks}"/>

                    <ItemsControl ItemsSource="{Binding RemovedTracks}">
                        <ItemsControl.Styles>
                            <Style Selector="ItemsControl:empty">
                                <Setter Property="IsVisible" Value="False"/>
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:RemovedTrackEntry">
                                <Border Padding="14,8" Margin="0,2" CornerRadius="12"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Folder}"
                                                       FontSize="12" Opacity="0.55"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Classes="pill-action"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RestoreRemovedTrackCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="12,6"
                                                CornerRadius="14"
                                                Cursor="Hand"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{loc:T Settings.Restore}" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="AdvancedTabPanel" Classes="tab-page" IsVisible="{Binding IsAdvancedTabVisible}" Spacing="4">
            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Storage}" Margin="0,2,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings.DiskUsage}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:T Settings.SpaceUsedByNoctis}"
                                           FontSize="12" Opacity="0.5"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Command="{Binding OpenDataFolderCommand}"
                                Classes="pill-action"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.OpenDataFolder}" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <StackPanel Spacing="8" Margin="0,4,0,0">
                        <!-- Library size (music files on disk) -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.LibrarySize}"
                                       FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalFileSize}"
                                       FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Opacity="0.2"/>

                        <!-- Library data -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.LibraryData}"
                                       FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding StorageLibraryData}"
                                       FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Opacity="0.2"/>

                        <!-- Artwork cache -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.ArtworkCache}"
                                       FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding StorageArtwork}"
                                       FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Opacity="0.2"/>

                        <!-- Playlists -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.Playlists}"
                                       FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding StoragePlaylists}"
                                       FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Opacity="0.2"/>

                        <!-- Settings -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.Settings}"
                                       FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding StorageSettings}"
                                       FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Opacity="0.3"/>

                        <!-- Total -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="{loc:T Settings.Total}"
                                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding StorageTotal}"
                                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="14">

                    <!-- Reset Settings -->
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:T Settings.ResetSettings}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{loc:T Settings.RestoreDefaultsClearSaved}"
                                               FontSize="12" Opacity="0.5"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding ShowResetConfirmCommand}"
                                    IsVisible="{Binding !IsResetConfirmVisible}"
                                    Classes="pill-action"
                                    Padding="14,8"
                                    CornerRadius="999"
                                    Cursor="Hand"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{loc:T Settings.ResetSettings}" FontSize="13"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                        <controls:CollapsibleContent IsOpen="{Binding IsResetConfirmVisible}" Lift="6">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:T Settings.AreYouSureAction}"
                                       FontSize="13" Foreground="#E74856"/>
                            <TextBlock Text="{Binding ResetConfirmDetail}"
                                       FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:T Settings.Cancel}"
                                        Command="{Binding CancelResetCommand}"
                                        Classes="pill-action"
                                        FontWeight="Bold"
                                        Padding="16,10"
                                        CornerRadius="18"
                                        Cursor="Hand"/>
                                <Button Content="{loc:T Settings.ResetEverything}"
                                        Command="{Binding ConfirmResetLibraryCommand}"
                                        Classes="pill-action danger"
                                        FontWeight="Bold"
                                        Padding="16,10"
                                        CornerRadius="18"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                        </controls:CollapsibleContent>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Opacity="0.2"/>

                    <!-- Clear Artwork Cache -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings.ClearArtworkCache}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:T Settings.DeleteCachedArtworkWill}"
                                            FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                                <TextBlock Text="{loc:T Settings.NoteRemovesAllArtwork}"
                                           FontSize="12" Foreground="#E74856" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding ClearArtworkCacheCommand}"
                                Classes="pill-action"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.ClearCache}" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.AudioTools}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.Ffmpeg}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{loc:T Settings.UsedByAudioConverter}"
                                   FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding FfmpegPath}"
                                 Watermark="{loc:T Settings.AutoDetect}"
                                 CornerRadius="999"
                                 Padding="14,8"
                                 BorderThickness="1.5"
                                 MinHeight="0"
                                 KeyDown="OnFfmpegPathKeyDown" />
                        <Button Grid.Column="1"
                                Content="{loc:T Settings.Browse}"
                                Command="{Binding BrowseFfmpegCommand}"
                                Padding="14,8"
                                CornerRadius="999"
                                Margin="8,0,0,0"
                                Cursor="Hand"/>
                    </Grid>
                    <TextBlock Text="{Binding FfmpegStatus}"
                               FontSize="11" Opacity="0.6"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Updates}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.IncludePreReleaseUpdates}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.OfferBetaBuildsUpdater}"
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding IncludePrereleaseUpdates}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="10">
                    <!-- Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.DeveloperMode}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.ShowVersionManagerDebug}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding DeveloperMode}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <controls:CollapsibleContent IsOpen="{Binding DeveloperMode}" Lift="6">
                    <StackPanel Spacing="10">

                        <!-- ── Version manager ── -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                            <TextBlock Grid.Column="0"
                                       Text="{loc:T Settings.DownloadInstallAnyRelease}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <Ellipse Grid.Column="1"
                                     Classes="loading-spinner"
                                     IsVisible="{Binding IsLoadingReleases}"
                                     VerticalAlignment="Center"
                                     Margin="8,0,0,0"/>
                        </Grid>

                        <TextBlock Text="{loc:T Settings.NoReleasesFound}"
                                   FontSize="13" Opacity="0.55"
                                   HorizontalAlignment="Center"
                                   Margin="0,8"
                                   IsVisible="{Binding ShowDevReleasesEmpty}"/>

                        <!-- Full release history; scrolls with the settings page itself -->
                        <ItemsControl ItemsSource="{Binding DevReleases}"
                                      IsEnabled="{Binding !IsDevDownloading}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DevReleaseItem">
                                        <Border Background="#12FFFFFF" CornerRadius="10"
                                                Padding="12,8" Margin="0,3">
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding VersionDisplay}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="1"
                                                        IsVisible="{Binding IsPrerelease}"
                                                        Background="{DynamicResource AccentColorBrush}" CornerRadius="999"
                                                        Padding="7,2" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:T Settings.PreRelease2}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentForegroundBrush}"/>
                                                </Border>
                                                <Border Grid.Column="2"
                                                        IsVisible="{Binding IsLatest}"
                                                        Background="{DynamicResource AccentColorBrush}" CornerRadius="999"
                                                        Padding="7,2" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:T Settings.Latest}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentForegroundBrush}"/>
                                                </Border>
                                                <Border Grid.Column="3"
                                                        IsVisible="{Binding ShowInstalledBadge}"
                                                        Background="{DynamicResource AccentColorBrush}" CornerRadius="999"
                                                        Padding="7,2" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:T Settings.Installed}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentForegroundBrush}"/>
                                                </Border>
                                                <TextBlock Grid.Column="4"
                                                           IsVisible="{Binding HasWarning}"
                                                           Text="{Binding WarningText}"
                                                           ToolTip.Tip="{Binding WarningText}"
                                                           FontSize="11"
                                                           Foreground="#F1C40F"
                                                           Opacity="0.9"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="5"
                                                           Text="{Binding DateDisplay}"
                                                           FontSize="12" Opacity="0.5"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0"/>
                                                <Button Grid.Column="6"
                                                        Classes="pill-action"
                                                        IsVisible="{Binding !IsCurrent}"
                                                        Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).InstallReleaseCommand}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding ActionLabel}" FontSize="12"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Expand to the full release history -->
                        <Button IsVisible="{Binding HasHiddenReleases}"
                                Command="{Binding ShowOlderReleasesCommand}"
                                Classes="accent-btn"
                                Background="{DynamicResource AccentButtonBackground}"
                                Foreground="{DynamicResource AccentForegroundBrush}"
                                BorderThickness="0"
                                CornerRadius="999"
                                Padding="14,6"
                                HorizontalAlignment="Center"
                                Cursor="Hand">
                            <TextBlock Text="{Binding ShowOlderVersionsLabel}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Button>
                        <!-- Collapse back to the newest releases (sits under the expanded list) -->
                        <Button IsVisible="{Binding IsReleaseHistoryExpanded}"
                                Command="{Binding HideOlderReleasesCommand}"
                                Classes="accent-btn"
                                Background="{DynamicResource AccentButtonBackground}"
                                Foreground="{DynamicResource AccentForegroundBrush}"
                                BorderThickness="0"
                                Padding="14,6"
                                CornerRadius="999"
                                HorizontalAlignment="Center"
                                Cursor="Hand">
                            <TextBlock Text="{loc:T Settings.ShowRecentReleasesOnly}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Button>

                        <!-- Download status / progress -->
                        <StackPanel x:Name="DevDownloadPanel" Spacing="10">
                            <TextBlock Text="{Binding DevStatusText}"
                                       FontSize="12" Opacity="0.7"
                                       IsVisible="{Binding DevStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <StackPanel Orientation="Horizontal" Spacing="12"
                                        IsVisible="{Binding IsDevDownloading}">
                                <ProgressBar Minimum="0" Maximum="100"
                                             Value="{Binding DevDownloadProgress}"
                                             Height="4" CornerRadius="2"
                                             VerticalAlignment="Center"
                                             MinWidth="200"/>
                                <Button Classes="pill-action"
                                        Command="{Binding CancelDevDownloadCommand}">
                                    <TextBlock Text="{loc:T Settings.Cancel}" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- ── Debug logs ── -->
                        <TextBlock Text="{Binding PreservedCrashBanner}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#E5A34D"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   IsVisible="{Binding PreservedCrashBanner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="{loc:T Settings.SessionLogTroubleshootingShare}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="pill-action" Command="{Binding CopyDevLogsCommand}">
                                <TextBlock Text="{loc:T Settings.CopyLogs}" FontSize="12"/>
                            </Button>
                            <Button Classes="pill-action" Command="{Binding ClearDevLogsCommand}">
                                <TextBlock Text="{loc:T Settings.Clear}" FontSize="12"/>
                            </Button>
                            <Button Classes="pill-action" Command="{Binding OpenLogsFolderCommand}"
                                    ToolTip.Tip="{loc:T Settings.OpenAppDataFolderTip}">
                                <TextBlock Text="{loc:T Settings.OpenFolder}" FontSize="12"/>
                            </Button>
                            <TextBlock Text="{loc:T Settings.Copied}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentColorBrush}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding DevLogsCopied}"/>
                        </StackPanel>
                        <Border Background="#12FFFFFF" CornerRadius="10" Padding="12,8" MaxHeight="190">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <SelectableTextBlock Text="{Binding DevLogText}"
                                                     FontSize="11"
                                                     FontFamily="Consolas, Menlo, monospace"
                                                     Opacity="0.8"
                                                     TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>

                    </StackPanel>
                    </controls:CollapsibleContent>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="AccountSyncTabPanel" Classes="tab-page" IsVisible="{Binding IsAccountDevicesTabVisible}" Spacing="4">
            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.YourAccount}" Margin="0,2,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="Auto,*">
                    <!-- Avatar: click to change; on hover a camera badge says so and an X removes the picture. -->
                    <Panel Grid.Column="0" Classes="avatar-wrap" Width="60" Height="60" Background="Transparent">
                        <Button Classes="profile-avatar-btn"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                Width="56" Height="56" CornerRadius="999"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                ToolTip.Tip="{loc:T Settings.ChangePictureTip}"
                                Click="OnPickAvatarClick">
                            <Border Width="56" Height="56" CornerRadius="28" ClipToBounds="True">
                                <Panel>
                                    <Border CornerRadius="28" Background="{DynamicResource AccentColorBrush}"
                                            IsVisible="{Binding ProfileAvatarPath, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                        <TextBlock Text="?" FontSize="22" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <controls:CachedImage SourcePath="{Binding ProfileAvatarPath}" Stretch="UniformToFill" ClearOnSourceChange="False"
                                                          IsVisible="{Binding ProfileAvatarPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </Panel>
                            </Border>
                        </Button>
                        <Border Classes="avatar-badge" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
                            <PathIcon Data="{StaticResource CameraIcon}" Width="11" Height="11" Foreground="{DynamicResource AccentForegroundBrush}"/>
                        </Border>
                        <Button Classes="avatar-x" HorizontalAlignment="Left" VerticalAlignment="Top"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding ClearProfileAvatarCommand}"
                                ToolTip.Tip="{loc:T Settings.RemovePictureTip}"
                                IsVisible="{Binding ProfileAvatarPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <PathIcon Data="{StaticResource DismissIcon}" Width="8" Height="8" UseLayoutRounding="False"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Panel>
                    <!-- Name: an editable box, the way a profile field reads. -->
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="5">
                        <TextBlock Text="{loc:T Settings.Name}" FontSize="11.5" FontWeight="SemiBold" Opacity="0.55"/>
                        <TextBox Classes="profile-name"
                                 Text="{Binding ProfileName, Mode=TwoWay}"
                                 Watermark="{loc:T Settings.Name}"
                                 Width="260" HorizontalAlignment="Left"
                                 ToolTip.Tip="{loc:T Settings.ClickEditNameTip}"
                                 KeyDown="OnProfileNameKeyDown"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Coming soon: device accounts are parked until the server-side sync ships. The card
                 stays visible so the feature is discoverable, but every control is disabled. -->
            <Border Classes="setting-row" IsEnabled="False" Opacity="0.55">
                <StackPanel Spacing="14">
                    <!-- No account yet -->
                    <controls:CollapsibleContent IsOpen="{Binding !HasPrimaryAccount}" Lift="6">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:T AccountSync.CreateTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource AccentColorBrush}" CornerRadius="999" Padding="7,2" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T Settings.ComingSoon}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentForegroundBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{loc:T AccountSync.CreateHelp}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Text="{Binding NewServerUserName}" Watermark="{loc:T AccountSync.EmailWatermark}" CornerRadius="999" Padding="14,8" BorderThickness="1.5" MinHeight="0"/>
                            <TextBox Grid.Column="1" Text="{Binding NewServerUserPassword}" PasswordChar="•" Watermark="{loc:T AccountSync.PasswordWatermark}" CornerRadius="999" Padding="14,8" BorderThickness="1.5" MinHeight="0"/>
                            <Button Grid.Column="2" Classes="accent-btn" Command="{Binding CreatePrimaryAccountCommand}" Padding="16,8" CornerRadius="999" Cursor="Hand"
                                    Background="{DynamicResource AccentButtonBackground}" Foreground="{DynamicResource AccentForegroundBrush}">
                                <TextBlock Text="{loc:T AccountSync.Create}" FontSize="13" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                    </controls:CollapsibleContent>

                    <!-- Account exists -->
                    <controls:CollapsibleContent IsOpen="{Binding HasPrimaryAccount}" Lift="6">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" Background="{DynamicResource AccentColorBrush}" Opacity="0.9">
                                <TextBlock Text="{Binding PrimaryAccountInitial}" FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PrimaryAccount.Name, FallbackValue=''}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding PrimaryAccountSince}" FontSize="12" Opacity="0.5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Classes="accent-btn" Command="{Binding TogglePairingCommand}" Padding="14,8" CornerRadius="999" Cursor="Hand"
                                        Background="{DynamicResource AccentButtonBackground}" Foreground="{DynamicResource AccentForegroundBrush}">
                                    <TextBlock Text="{loc:T AccountSync.PairDevice}" FontSize="12" FontWeight="SemiBold"/>
                                </Button>
                                <Button Classes="pill-action" Command="{Binding RegenerateServerApiKeyCommand}" CommandParameter="{Binding PrimaryAccount}" Padding="14,8" CornerRadius="999" Cursor="Hand">
                                    <TextBlock Text="{loc:T AccountSync.NewApiKey}" FontSize="12"/>
                                </Button>
                                <Button Classes="pill-action" Command="{Binding ToggleChangePasswordCommand}" Padding="14,8" CornerRadius="999" Cursor="Hand">
                                    <TextBlock Text="{loc:T AccountSync.ChangePassword}" FontSize="12"/>
                                </Button>
                                <Button Classes="pill-action" Command="{Binding DeleteServerUserCommand}" CommandParameter="{Binding PrimaryAccount}" Padding="14,8" CornerRadius="999" Cursor="Hand">
                                    <TextBlock Text="{loc:T AccountSync.Remove}" FontSize="12" Foreground="#FF6B6B"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Change password (inline) -->
                        <controls:CollapsibleContent IsOpen="{Binding IsChangePasswordVisible}" Lift="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Text="{Binding ChangePasswordValue}" PasswordChar="•" Watermark="{loc:T AccountSync.NewPassword}" CornerRadius="999" Padding="14,8" BorderThickness="1.5" MinHeight="0"/>
                            <Button Grid.Column="1" Classes="pill-action" Command="{Binding ChangePrimaryPasswordCommand}" Padding="14,8" CornerRadius="999" Cursor="Hand">
                                <TextBlock Text="{loc:T AccountSync.Save}" FontSize="12"/>
                            </Button>
                        </Grid>
                        </controls:CollapsibleContent>

                        <!-- Pairing: address + QR + fingerprint, or the switch to turn the server on -->
                        <controls:CollapsibleContent IsOpen="{Binding IsPairingVisible}" Lift="6">
                        <Border Background="#18000000" CornerRadius="12" Padding="14,12">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="10" IsVisible="{Binding NoctisServerUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{loc:T AccountSync.PairHelp}" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Top"
                                                IsVisible="{Binding NoctisServerQr, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <Image Source="{Binding NoctisServerQr}" Width="96" Height="96"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:T Server.AddressLabel}" FontSize="10" Opacity="0.5"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <SelectableTextBlock Text="{Binding NoctisServerUrl}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Button Classes="pill-action" Command="{Binding CopyNoctisServerUrlCommand}">
                                                    <TextBlock Text="{loc:T Settings.Copy}" FontSize="11"/>
                                                </Button>
                                                <TextBlock Text="{loc:T Settings.Copied}" FontSize="11" Foreground="{DynamicResource AccentColorBrush}" VerticalAlignment="Center" IsVisible="{Binding NoctisServerUrlCopied}"/>
                                            </StackPanel>
                                            <TextBlock Text="{loc:T Server.FingerprintLabel}" FontSize="10" Opacity="0.5" Margin="0,4,0,0"/>
                                            <SelectableTextBlock Text="{Binding NoctisServerFingerprint}" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Spacing="8" IsVisible="{Binding NoctisServerUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                    <TextBlock Text="{loc:T AccountSync.ServerOffHelp}" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                                    <Button Classes="accent-btn" Command="{Binding TurnOnNoctisServerCommand}" Padding="16,8" CornerRadius="999" Cursor="Hand" HorizontalAlignment="Left"
                                            Background="{DynamicResource AccentButtonBackground}" Foreground="{DynamicResource AccentForegroundBrush}">
                                        <TextBlock Text="{loc:T AccountSync.TurnOnServer}" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>
                                    <TextBlock Text="{Binding NoctisServerError}" FontSize="12" Foreground="#FF6B6B" TextWrapping="Wrap" IsVisible="{Binding NoctisServerStartFailed}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </controls:CollapsibleContent>
                    </StackPanel>
                    </controls:CollapsibleContent>

                    <!-- Freshly issued key: visible once, never stored in clear -->
                    <controls:CollapsibleContent IsOpen="{Binding HasIssuedApiKey}" Lift="6">
                    <Border Background="#1AFFFFFF" CornerRadius="8" Padding="12,10">
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="12" TextWrapping="Wrap">
                                <Run Text="{loc:T Server.ApiKeyFor}"/> <Run Text="{Binding IssuedApiKeyUser}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <SelectableTextBlock Text="{Binding IssuedApiKey}" FontSize="12" FontFamily="Consolas,Menlo,monospace" TextWrapping="Wrap"/>
                            <TextBlock Text="{loc:T Server.ApiKeyOnce}" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="pill-action" Command="{Binding CopyIssuedApiKeyCommand}">
                                    <TextBlock Text="{loc:T Settings.Copy}" FontSize="11"/>
                                </Button>
                                <Button Classes="pill-action" Command="{Binding HideIssuedApiKeyCommand}">
                                    <TextBlock Text="{loc:T Server.Done}" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </controls:CollapsibleContent>
                    <!-- Fixed-height slot: the message appearing and leaving must not reflow the
                         card (it read as the page shaking). -->
                    <Panel MinHeight="18">
                        <TextBlock Text="{Binding ServerUserError}" FontSize="12" Foreground="#FF6B6B" TextWrapping="Wrap"
                                   IsVisible="{Binding ServerUserError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </Panel>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <Border Classes="setting-card group-card" Margin="0,14,0,10">
            <StackPanel>
            <!-- Coming soon: see the account card above. -->
            <Border Classes="setting-row" IsEnabled="False" Opacity="0.55">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:T Sync.Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource AccentColorBrush}" CornerRadius="999" Padding="7,2" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T Settings.ComingSoon}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentForegroundBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{loc:T Sync.Description}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1" IsChecked="{Binding SyncEnabled}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Background="#18000000" CornerRadius="10" Padding="12,10">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding SyncStatusText}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                            <controls:CollapsibleContent IsOpen="{Binding HasSyncDevices}" Lift="6">
                            <ItemsControl ItemsSource="{Binding SyncDevices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="4"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SettingsViewModel+SyncDeviceRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <Ellipse Grid.Column="0" Width="6" Height="6" Fill="#4DC26B" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding LastSeenText}" FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </controls:CollapsibleContent>
                        </StackPanel>
                    </Border>
                    <Grid Classes="sub-setting" ColumnDefinitions="140,*" IsEnabled="{Binding SyncEnabled}">
                        <TextBlock Grid.Column="0" Text="{loc:T Sync.DeviceName}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding SyncDeviceName}" MaxWidth="320" HorizontalAlignment="Left" MinWidth="220"
                                 CornerRadius="999" Padding="14,8" BorderThickness="1.5" MinHeight="0"/>
                    </Grid>
                    <TextBlock Text="{loc:T Sync.WhatSyncs}" FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <Border Classes="setting-card group-card" Margin="0,14,0,10">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="10">
                    <!-- Header + QR card share a spacing-free panel so the 10px gap folds with the body
                         (see the Crossfade block). -->
                    <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.WebRemote}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.ControlPlaybackFromPhone}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding WebRemoteEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <controls:CollapsibleContent IsOpen="{Binding WebRemoteUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Lift="10" Motion="Glide">
                    <Border Background="#18000000" CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
                        <StackPanel Spacing="8">
                            <!-- Running: QR thumbnail + connection details. The card shows the
                                 token-free URL; the full auth link lives in the QR, the copy
                                 button and the enlarge flyout (screenshots leaked a live key). -->
                            <Grid ColumnDefinitions="Auto,*"
                                  IsVisible="{Binding WebRemoteQr, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Button Grid.Column="0" Classes="qr-thumb" Padding="0" Background="Transparent" BorderThickness="0"
                                        VerticalAlignment="Center" ToolTip.Tip="{loc:T Settings.TapEnlargeTip}">
                                    <Border CornerRadius="6" ClipToBounds="True">
                                        <Image Source="{Binding WebRemoteQr}" Width="84" Height="84"/>
                                    </Border>
                                    <Button.Flyout>
                                        <Flyout Placement="RightEdgeAlignedTop">
                                            <StackPanel Spacing="10">
                                                <!-- Natural bitmap size: 1 module = 8 device px, no resampling —
                                                     the crispest render a camera can get off this screen. -->
                                                <Border CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Center">
                                                    <Image Source="{Binding WebRemoteQr}" Stretch="None"/>
                                                </Border>
                                                <SelectableTextBlock Text="{Binding WebRemoteUrl}" FontSize="12" Opacity="0.7"
                                                                     TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"/>
                                                <TextBlock Text="{loc:T Settings.IfPhoneBlocksLink}"
                                                           FontSize="11" Opacity="0.45" TextWrapping="Wrap"
                                                           TextAlignment="Center" MaxWidth="300"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T Settings.OPENPHONE}" FontSize="10" Opacity="0.5"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SelectableTextBlock Text="{Binding WebRemoteDisplayUrl}" FontSize="14" FontWeight="SemiBold"
                                                             VerticalAlignment="Center"/>
                                        <Button Classes="pill-action" Command="{Binding CopyWebRemoteUrlCommand}"
                                                ToolTip.Tip="{loc:T Settings.CopyFullLinkIncludingTip}">
                                            <TextBlock Text="{loc:T Settings.Copy}" FontSize="11"/>
                                        </Button>
                                        <TextBlock Text="{loc:T Settings.Copied}" FontSize="11"
                                                   Foreground="{DynamicResource AccentColorBrush}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding WebRemoteUrlCopied}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                IsVisible="{Binding !WebRemotePhoneSeen}">
                                        <Ellipse Width="6" Height="6" Fill="#E5A34D" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:T Settings.WaitingPhoneScanCode}"
                                                   FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                IsVisible="{Binding WebRemotePhoneSeen}">
                                        <Ellipse Width="6" Height="6" Fill="#52B788" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:T Settings.PhoneConnected}"
                                                   FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <!-- Enabled but the server threw on start -->
                            <TextBlock Text="{Binding WebRemoteUrl}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                       IsVisible="{Binding WebRemoteStartFailed}"/>
                        </StackPanel>
                    </Border>
                    </controls:CollapsibleContent>
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <!-- Local API: loopback automation for Stream Deck / OBS / scripts (docs/LOCAL-API.md).
                 The token is masked until revealed, like the remote's key. -->
            <Border Classes="setting-card group-card" Margin="0,4,0,10">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="10">
                    <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:T Settings.LocalApi}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.LocalApiDesc}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding LocalApiEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <controls:CollapsibleContent IsOpen="{Binding LocalApiRunning}" Lift="10" Motion="Glide">
                    <Border Background="#18000000" CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings.LocalApiAddress}" FontSize="10" Opacity="0.5"/>
                                <SelectableTextBlock Text="{Binding LocalApiBaseUrl}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:T Settings.LocalApiToken}" FontSize="10" Opacity="0.5"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding LocalApiTokenDisplay}" FontSize="12"
                                               FontFamily="Consolas,Menlo,monospace"
                                               VerticalAlignment="Center"/>
                                    <Button Classes="pill-action" Command="{Binding ToggleLocalApiTokenRevealCommand}">
                                        <Panel>
                                            <TextBlock Text="{loc:T Settings.LocalApiShowToken}" FontSize="11"
                                                       IsVisible="{Binding !LocalApiTokenRevealed}"/>
                                            <TextBlock Text="{loc:T Settings.LocalApiHideToken}" FontSize="11"
                                                       IsVisible="{Binding LocalApiTokenRevealed}"/>
                                        </Panel>
                                    </Button>
                                    <Button Classes="pill-action" Command="{Binding CopyLocalApiTokenCommand}">
                                        <TextBlock Text="{loc:T Settings.Copy}" FontSize="11"/>
                                    </Button>
                                    <Button Classes="pill-action" Command="{Binding RegenerateLocalApiTokenCommand}"
                                            ToolTip.Tip="{loc:T Settings.LocalApiRegenerateTip}">
                                        <TextBlock Text="{loc:T Settings.LocalApiRegenerate}" FontSize="11"/>
                                    </Button>
                                    <TextBlock Text="{loc:T Settings.Copied}" FontSize="11"
                                               Foreground="{DynamicResource AccentColorBrush}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding LocalApiTokenCopied}"/>
                                </StackPanel>
                                <!-- Full token glides open under the row on Show and folds away on
                                     Hide; the row above never re-flows. -->
                                <controls:CollapsibleContent IsOpen="{Binding LocalApiTokenRevealed}"
                                                             Lift="8" Motion="Glide">
                                    <Border Background="#14FFFFFF" CornerRadius="6"
                                            Padding="10,8" Margin="0,6,0,0">
                                        <SelectableTextBlock Text="{Binding LocalApiToken}" FontSize="12"
                                                             FontFamily="Consolas,Menlo,monospace"
                                                             TextWrapping="Wrap"/>
                                    </Border>
                                </controls:CollapsibleContent>
                            </StackPanel>
                            <TextBlock Text="{loc:T Settings.LocalApiWarning}"
                                       FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                            <TextBlock Text="{loc:T Settings.LocalApiDiscovery}"
                                       FontSize="11" Opacity="0.45" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    </controls:CollapsibleContent>
                    </StackPanel>
                    <TextBlock Text="{Binding LocalApiError}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               IsVisible="{Binding LocalApiError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="IntegrationsTabPanel" Classes="tab-page" IsVisible="{Binding IsIntegrationsTabVisible}" Spacing="4">
            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Discord}" Margin="0,2,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                            Background="#5865F2" Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <Viewbox Width="22" Height="22"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White"
                                      Data="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{loc:T Settings.DiscordRichPresence}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.ShowCurrentSongDiscord}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="2"
                                          IsChecked="{Binding DiscordRichPresenceEnabled}"
                                          VerticalAlignment="Center"
                                          Margin="12,0,0,0"/>
                </Grid>
            </Border>
            <controls:CollapsibleContent IsOpen="{Binding DiscordRichPresenceEnabled}" Lift="10" Motion="Glide">
            <Border Classes="setting-row divided">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{loc:T Settings.ShowAlbumDiscord}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Settings.AddAlbumNameUnder}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <controls:LottieToggle Grid.Column="1"
                                          IsChecked="{Binding DiscordShowAlbum}"
                                          VerticalAlignment="Center"
                                          Margin="12,0,0,0"/>
                </Grid>
            </Border>
            </controls:CollapsibleContent>
            </StackPanel>
            </Border>

            <TextBlock Classes="section-title" Text="{loc:T Settings.Section.Scrobbling}" Margin="0,16,0,8"/>
            <Border Classes="setting-card group-card">
            <StackPanel>
            <Border Classes="setting-row">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                Width="40" Height="40" CornerRadius="10"
                                Background="#D51007"
                                Margin="0,0,14,0"
                                VerticalAlignment="Top">
                            <Viewbox Width="22" Height="22"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White"
                                          Data="M10.584 17.21l-.88-2.392s-1.43 1.594-3.573 1.594c-1.897 0-3.244-1.649-3.244-4.288 0-3.382 1.704-4.591 3.381-4.591 2.42 0 3.189 1.567 3.849 3.574l.88 2.749c.88 2.666 2.529 4.81 7.284 4.81 3.409 0 5.718-1.044 5.718-3.793 0-2.227-1.265-3.381-3.63-3.931l-1.758-.385c-1.21-.275-1.567-.77-1.567-1.595 0-.934.742-1.484 1.952-1.484 1.32 0 2.034.495 2.144 1.677l2.749-.33c-.22-2.474-1.924-3.492-4.729-3.492-2.474 0-4.893.935-4.893 3.932 0 1.87.907 3.051 3.189 3.601l1.87.44c1.402.33 1.869.907 1.869 1.704 0 1.017-.99 1.43-2.86 1.43-2.776 0-3.932-1.457-4.59-3.464l-.907-2.75c-1.155-3.573-2.997-4.893-6.653-4.893C2.144 5.333 0 7.89 0 12.233c0 4.18 2.144 6.434 5.993 6.434 3.106 0 4.591-1.457 4.591-1.457z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                                    VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="{loc:T Settings.LastFmScrobbling}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                            <TextBlock Text="{loc:T Settings.SendPlaysLastFm}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap" MaxWidth="560"
                                       HorizontalAlignment="Left"
                                       Margin="-2,0,0,0"/>
                            <!-- ACCOUNT line sits inline with title/description so it pulls up tight
                                 against the description instead of dropping into its own grid row. -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding LastFmUsername, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Margin="-2,2,0,0">
                                <TextBlock Text="{loc:T Settings.ACCOUNT}" FontSize="12" Opacity="0.45" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LastFmUsername}" FontSize="12" Opacity="0.85" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Not connected state -->
                        <Button Grid.Column="2" Grid.Row="0"
                                IsVisible="{Binding !IsLastFmConnected}"
                                Content="{loc:T Settings.Connect}"
                                Classes="pill-action accent-btn"
                                Command="{Binding LoginLastFmCommand}"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Margin="0,0,0,4">
                            <Button.Template>
                                <ControlTemplate>
                                    <ContentPresenter Background="{DynamicResource AccentColorBrush}"
                                                      Foreground="{DynamicResource AccentForegroundBrush}"
                                                      CornerRadius="16"
                                                      Padding="14,8"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Content="{TemplateBinding Content}"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Status text removed -->

                        <!-- Logout button (top-right, when connected) -->
                        <Button Grid.Column="2" Grid.Row="0"
                                IsVisible="{Binding IsLastFmConnected}"
                                Command="{Binding LogoutLastFmCommand}"
                                Classes="pill-action"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.Logout}" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Enable Scrobbling (when connected) -->
                    <controls:CollapsibleContent IsOpen="{Binding IsLastFmConnected}" Lift="6">
                    <Grid ColumnDefinitions="*,Auto" Margin="54,0,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="{loc:T Settings.EnableScrobbling}"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding LastFmScrobblingEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    </controls:CollapsibleContent>
                </StackPanel>
            </Border>
            <Border Classes="setting-row">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                        <!-- Official multi-colour ListenBrainz logo (transparent PNG). It's the
                             hexagonal brand mark, so it stands on its own at the same 40×40 footprint
                             as the Discord / Last.fm tiles rather than sitting on a colour fill. -->
                        <Image Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                               Width="40" Height="40"
                               Margin="0,0,14,0"
                               VerticalAlignment="Top"
                               Source="avares://Noctis.UI/Assets/Icons/ListenBrainz ICON.png"
                               RenderOptions.BitmapInterpolationMode="HighQuality"/>

                        <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                                    VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="{loc:T Settings.ListenBrainzScrobbling}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                            <TextBlock Text="{loc:T Settings.SendPlaysListenBrainz}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap" MaxWidth="560"
                                       HorizontalAlignment="Left"
                                       Margin="-2,0,0,0"/>

                            <!-- ACCOUNT line sits inline with the title/description block so it pulls
                                 up tight against the description instead of dropping into its own grid row. -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding ListenBrainzUsername, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Margin="-2,2,0,0">
                                <TextBlock Text="{loc:T Settings.ACCOUNT}" FontSize="12" Opacity="0.45" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ListenBrainzUsername}" FontSize="12" Opacity="0.85" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Token row lives inside the same StackPanel as the title so it sits
                                 right under the description instead of leaving a gap. The Connect
                                 button is hoisted to column 2 (top-right) to match the Last.fm card. -->
                            <controls:CollapsibleContent IsOpen="{Binding !IsListenBrainzConnected}" Lift="6" Margin="-2,0,0,0">
                            <StackPanel
                                        Margin="0,6,0,0"
                                        Spacing="4">
                                <TextBox x:Name="ListenBrainzTokenBox"
                                         Classes="metadata-info-field"
                                         Text="{Binding ListenBrainzToken}"
                                         PasswordChar="•"
                                         Watermark="{loc:T Settings.ListenBrainzUserToken}"
                                         Width="280"
                                         HorizontalAlignment="Left"/>
                                <!-- Inline validation error (e.g. "Token required"), semantically red. -->
                                <TextBlock Text="{Binding ListenBrainzError}"
                                           IsVisible="{Binding ListenBrainzError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="#E74856"
                                           FontSize="11"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                            </controls:CollapsibleContent>
                        </StackPanel>

                        <!-- Not connected state (top-right, mirrors the Last.fm Connect button) -->
                        <Button Grid.Column="2" Grid.Row="0"
                                IsVisible="{Binding !IsListenBrainzConnected}"
                                Content="{loc:T Settings.Connect}"
                                Classes="pill-action accent-btn"
                                Command="{Binding TestListenBrainzCommand}"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Margin="0,0,0,4">
                            <Button.Template>
                                <ControlTemplate>
                                    <ContentPresenter Background="{DynamicResource AccentColorBrush}"
                                                      Foreground="{DynamicResource AccentForegroundBrush}"
                                                      CornerRadius="16"
                                                      Padding="14,8"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Content="{TemplateBinding Content}"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Logout button (top-right, when connected) -->
                        <Button Grid.Column="2" Grid.Row="0"
                                IsVisible="{Binding IsListenBrainzConnected}"
                                Command="{Binding LogoutListenBrainzCommand}"
                                Classes="pill-action"
                                Padding="14,8"
                                CornerRadius="999"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.Logout}" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Enable Scrobbling (when connected) -->
                    <controls:CollapsibleContent IsOpen="{Binding IsListenBrainzConnected}" Lift="6">
                    <Grid ColumnDefinitions="*,Auto" Margin="54,0,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="{loc:T Settings.EnableScrobbling}"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding ListenBrainzScrobblingEnabled}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    </controls:CollapsibleContent>
                </StackPanel>
            </Border>
            </StackPanel>
            </Border>

            <Border Classes="setting-card group-card" Margin="0,14,0,10">
            <StackPanel>
            <Border Classes="setting-row" IsVisible="{Binding IsTidalAvailable}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0"
                            Width="40" Height="40" CornerRadius="10"
                            Background="#000000" BorderBrush="#33FFFFFF" BorderThickness="1"
                            Margin="0,0,14,0"
                            VerticalAlignment="Top">
                        <!-- TIDAL's three-diamond mark, drawn as paths so it stays crisp at any scale. -->
                        <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="16">
                                <Path Fill="White" Data="M4,0 L8,4 L4,8 L0,4 Z"/>
                                <Path Fill="White" Data="M12,0 L16,4 L12,8 L8,4 Z"/>
                                <Path Fill="White" Data="M20,0 L24,4 L20,8 L16,4 Z"/>
                                <Path Fill="White" Data="M12,8 L16,12 L12,16 L8,12 Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                        <TextBlock Text="{loc:T Settings.TidalTitle}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:T Settings.TidalDescription}"
                                   FontSize="12" Opacity="0.5" TextWrapping="Wrap" MaxWidth="560"
                                   HorizontalAlignment="Left" Margin="-2,0,0,0"/>
                        <TextBlock Text="{loc:T Settings.TidalConnected}" FontSize="12" Opacity="0.85"
                                   IsVisible="{Binding IsTidalConnected}" Margin="-2,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            IsVisible="{Binding !IsTidalConnected}"
                            IsEnabled="{Binding !IsTidalBusy}"
                            Content="{loc:T Settings.Connect}"
                            Classes="pill-action accent-btn"
                            Command="{Binding ConnectTidalCommand}"
                            Padding="14,8" CornerRadius="999" Cursor="Hand" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate>
                                <ContentPresenter Background="{DynamicResource AccentColorBrush}"
                                                  Foreground="{DynamicResource AccentForegroundBrush}"
                                                  CornerRadius="16" Padding="14,8"
                                                  FontSize="13" FontWeight="SemiBold"
                                                  Content="{TemplateBinding Content}"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2"
                            IsVisible="{Binding IsTidalConnected}"
                            Command="{Binding DisconnectTidalCommand}"
                            Classes="pill-action"
                            Padding="14,8" CornerRadius="999" Cursor="Hand" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Settings.Disconnect}" FontSize="13" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>
            </StackPanel>
            </Border>

            <Border Classes="setting-card" Margin="0,14,0,10">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="{loc:T Settings.MusicServer}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                            <TextBlock Text="{loc:T Settings.StreamLibraryFromJellyfin}"
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap" MaxWidth="560"
                                       HorizontalAlignment="Left" Margin="-2,0,0,0"/>

                            <!-- Connected summary -->
                            <controls:CollapsibleContent IsOpen="{Binding IsMediaServerConnected}" Lift="6" Margin="-2,0,0,0">
                            <StackPanel Spacing="3" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="server-field-label" Text="{loc:T Settings.TYPE}" Width="68" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MediaServerType}" FontSize="12" Opacity="0.85" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="server-field-label" Text="{loc:T Settings.SERVER}" Width="68" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MediaServerUrl}" FontSize="12" Opacity="0.85" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="server-field-label" Text="{loc:T Settings.ACCOUNT}" Width="68" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MediaServerUsername}" FontSize="12" Opacity="0.85" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            </controls:CollapsibleContent>

                            <!-- Connection form (hidden while connected): labeled 2×2 grid,
                                 Enter in any field submits. -->
                            <!-- Stretched across the column so the star columns split the width
                                 and long input scrolls inside the boxes. Left-aligned, the grid
                                 sized its star columns to content and the boxes resized on every
                                 keystroke. -->
                            <controls:CollapsibleContent IsOpen="{Binding !IsMediaServerConnected}" Lift="6" Margin="-2,0,0,0">
                            <Grid
                                  ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto"
                                  HorizontalAlignment="Stretch" Margin="0,10,0,0">
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,0,10">
                                    <TextBlock Classes="server-field-label" Text="{loc:T Settings.SERVERTYPE}"/>
                                    <Border Classes="server-pill-shell">
                                        <ComboBox Classes="pill-list server-pill"
                                                  ItemsSource="{Binding MediaServerTypeOptions}"
                                                  SelectedItem="{Binding MediaServerType}"
                                                  IsEnabled="{Binding !IsMediaServerBusy}"
                                                  HorizontalAlignment="Stretch"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4" Margin="0,0,0,10">
                                    <TextBlock Classes="server-field-label" Text="{loc:T Settings.SERVERADDRESS}"/>
                                    <TextBox Classes="metadata-info-field"
                                             Text="{Binding MediaServerUrl}"
                                             Watermark="{loc:T Settings.HttpsMusicExampleCom}"
                                             IsEnabled="{Binding !IsMediaServerBusy}">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding ConnectMediaServerCommand}"/>
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                    <TextBlock Classes="server-field-label" Text="{loc:T Settings.USERNAME}"/>
                                    <TextBox Classes="metadata-info-field"
                                             Text="{Binding MediaServerUsername}"
                                             Watermark="{loc:T Settings.UsernameWatermark}"
                                             IsEnabled="{Binding !IsMediaServerBusy}">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding ConnectMediaServerCommand}"/>
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                                    <TextBlock Classes="server-field-label" Text="{loc:T Settings.PASSWORD}"/>
                                    <TextBox Classes="metadata-info-field"
                                             Text="{Binding MediaServerPassword}"
                                             PasswordChar="•"
                                             Watermark="{loc:T Settings.PasswordWatermark}"
                                             IsEnabled="{Binding !IsMediaServerBusy}">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding ConnectMediaServerCommand}"/>
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                </StackPanel>
                            </Grid>
                            </controls:CollapsibleContent>

                            <!-- Status line: dot follows the state (green connected, red error),
                                 spinner while a connection attempt is running. -->
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="-2,8,0,0">
                                <Ellipse Classes="server-status-dot"
                                         Classes.connected="{Binding IsMediaServerConnected}"
                                         Classes.error="{Binding HasMediaServerError}"
                                         IsVisible="{Binding !IsMediaServerBusy}"
                                         VerticalAlignment="Center"/>
                                <Ellipse Classes="loading-spinner" Width="11" Height="11"
                                         IsVisible="{Binding IsMediaServerBusy}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Classes="server-status"
                                           Classes.error="{Binding HasMediaServerError}"
                                           Text="{Binding MediaServerStatusText}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Connect (top-right, mirrors the account cards) -->
                        <Button Grid.Column="1"
                                IsVisible="{Binding !IsMediaServerConnected}"
                                IsEnabled="{Binding !IsMediaServerBusy}"
                                Classes="pill-action accent-btn"
                                Command="{Binding ConnectMediaServerCommand}"
                                Padding="14,8" CornerRadius="999" Cursor="Hand"
                                VerticalAlignment="Top" Margin="0,4,0,0">
                            <Button.Template>
                                <ControlTemplate>
                                    <ContentPresenter Background="{DynamicResource AccentColorBrush}"
                                                      Foreground="{DynamicResource AccentForegroundBrush}"
                                                      CornerRadius="16"
                                                      Padding="14,8"
                                                      FontSize="13"
                                                      FontWeight="SemiBold"
                                                      Content="{TemplateBinding Content}"/>
                                </ControlTemplate>
                            </Button.Template>
                            <Panel>
                                <TextBlock Text="{loc:T Settings.Connect}" IsVisible="{Binding !IsMediaServerBusy}"/>
                                <TextBlock Text="{loc:T Settings.Connecting}" IsVisible="{Binding IsMediaServerBusy}"/>
                            </Panel>
                        </Button>

                        <Button Grid.Column="1"
                                IsVisible="{Binding IsMediaServerConnected}"
                                Command="{Binding DisconnectMediaServerCommand}"
                                Classes="pill-action"
                                Padding="14,8" CornerRadius="999" Cursor="Hand"
                                VerticalAlignment="Top" Margin="0,4,0,0">
                            <TextBlock Text="{loc:T Settings.Disconnect}" FontSize="13" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="PluginsTabPanel" Classes="tab-page" IsVisible="{Binding IsPluginsTabVisible}" Spacing="4">
            <!-- Community plugins switch (restricted mode when off, Obsidian-style). -->
            <Border Classes="setting-card">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                            <TextBlock Text="{loc:T Plugins.CommunityTitle}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Plugins.CommunityDescription}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1" IsChecked="{Binding CommunityPluginsEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{loc:T Plugins.Warning}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                    <Border IsVisible="{Binding !CommunityPluginsEnabled}" CornerRadius="12" Padding="12,9"
                            Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                        <TextBlock Text="{loc:T Plugins.RestrictedNotice}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="setting-card">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Plugins.Title}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T Plugins.Description}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <WrapPanel Orientation="Horizontal">
                        <Button Classes="accent-pill" Command="{Binding InstallPluginFromFileCommand}"
                                Padding="14,8" CornerRadius="999" Cursor="Hand" Margin="0,0,8,8">
                            <TextBlock Text="{loc:T Plugins.InstallFromFile}" FontSize="13" FontWeight="SemiBold"/>
                        </Button>
                        <Button Classes="pill-action" Command="{Binding OpenPluginsFolderCommand}"
                                Padding="14,8" CornerRadius="999" Cursor="Hand" Margin="0,0,8,8">
                            <TextBlock Text="{loc:T Plugins.OpenFolder}" FontSize="13"/>
                        </Button>
                        <Button Classes="pill-action" Command="{Binding ReloadPluginsCommand}"
                                Padding="14,8" CornerRadius="999" Cursor="Hand" Margin="0,0,8,8">
                            <TextBlock Text="{loc:T Plugins.Reload}" FontSize="13"/>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="{Binding Plugins.PluginsDirectory}" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding PluginsStatus}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                               IsVisible="{Binding PluginsStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{loc:T Plugins.None}" FontSize="12" Opacity="0.5" Margin="22,8"
                       IsVisible="{Binding !Plugins.Plugins.Count}"/>

            <ItemsControl ItemsSource="{Binding Plugins.Plugins}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="plugins:LoadedPlugin">
                        <Border Classes="setting-card">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                                        <WrapPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Version}" FontSize="12" Opacity="0.5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <Border CornerRadius="999" Padding="8,1" Background="#22FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border CornerRadius="999" Padding="8,1" Background="#14FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                                    VerticalAlignment="Center" IsVisible="{Binding IsLegacy}">
                                                <TextBlock Text="{loc:T Plugins.LegacyBadge}" FontSize="10.5" Opacity="0.8"/>
                                            </Border>
                                            <Border CornerRadius="999" Padding="8,1" Background="#14FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                                    VerticalAlignment="Center" IsVisible="{Binding IsContentPack}">
                                                <TextBlock Text="{loc:T Plugins.ContentBadge}" FontSize="10.5" Opacity="0.8"/>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Author}" FontSize="11" Opacity="0.45"
                                                   IsVisible="{Binding HasAuthor}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                                   IsVisible="{Binding HasDescription}"/>
                                    </StackPanel>
                                    <!-- Two-way: LoadedPlugin.IsEnabled routes the flip back to the host
                                         (approval dialog on first enable, start/stop + persist). -->
                                    <controls:LottieToggle Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanToggle}"
                                                          VerticalAlignment="Top"/>
                                </Grid>

                                <TextBlock Text="{loc:T Plugins.LegacyNote}" FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                           IsVisible="{Binding IsLegacy}"/>

                                <TextBlock Text="{loc:T Plugins.ContentNote}" FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                           IsVisible="{Binding IsContentPack}"/>

                                <!-- Permissions as quiet chips (code plugins only: a content pack has none). -->
                                <StackPanel Spacing="5" IsVisible="{Binding IsCodePlugin}">
                                    <TextBlock Text="{loc:T Plugins.Permissions}" FontSize="11" FontWeight="SemiBold" Opacity="0.5"/>
                                    <ItemsControl ItemsSource="{Binding PermissionChips}" IsVisible="{Binding HasPermissions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="sys:String">
                                                <Border CornerRadius="999" Padding="9,2" Margin="0,0,6,6"
                                                        Background="#12FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                                                    <TextBlock Text="{Binding}" FontSize="11"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{loc:T Plugins.NoPermissionsShort}" FontSize="11" Opacity="0.5"
                                               IsVisible="{Binding !HasPermissions}"/>
                                </StackPanel>

                                <TextBlock Text="{Binding Extensions}" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                           IsVisible="{Binding HasExtensions}"/>
                                <TextBlock Text="{Binding Error}" FontSize="11" Foreground="#FF6B6B" TextWrapping="Wrap"
                                           IsVisible="{Binding HasError}"/>
                                <TextBlock Text="{Binding Warnings}" FontSize="11" Opacity="0.45" TextWrapping="Wrap"
                                           IsVisible="{Binding HasWarnings}"/>

                                <!-- Settings declared in plugin.json, drawn by Noctis. -->
                                <StackPanel Spacing="8" IsVisible="{Binding HasSettings}">
                                    <TextBlock Text="{loc:T Plugins.Settings}" FontSize="11" FontWeight="SemiBold" Opacity="0.5"/>
                                    <ItemsControl ItemsSource="{Binding SettingItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="plugins:PluginSettingItem">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Label}" FontSize="13" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                                                                   IsVisible="{Binding HasDescription}"/>
                                                    </StackPanel>
                                                    <Panel Grid.Column="1" VerticalAlignment="Center">
                                                        <controls:LottieToggle IsVisible="{Binding IsBool}"
                                                                              IsChecked="{Binding BoolValue, Mode=TwoWay}"/>
                                                        <TextBox IsVisible="{Binding IsString}" Text="{Binding TextValue, Mode=TwoWay}"
                                                                 Width="220" CornerRadius="999" Padding="14,6" BorderThickness="1.5" MinHeight="0"/>
                                                        <NumericUpDown IsVisible="{Binding IsNumber}" Value="{Binding NumberValue, Mode=TwoWay}"
                                                                       Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                                       Width="150" CornerRadius="999" FormatString="0.###"/>
                                                        <ComboBox IsVisible="{Binding IsChoice}" Classes="pill-list"
                                                                  ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                                  MinWidth="160" CornerRadius="999" Padding="14,6"/>
                                                    </Panel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="pill-action" Padding="12,6" CornerRadius="999" Cursor="Hand"
                                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).OpenPluginDirectoryCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{loc:T Plugins.OpenPluginFolder}" FontSize="12"/>
                                    </Button>
                                    <Button Classes="pill-action danger-ghost-pill" Padding="12,6" CornerRadius="999" Cursor="Hand"
                                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemovePluginCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{loc:T Plugins.Remove}" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- ABOUT                                               -->
            <!-- ═══════════════════════════════════════════════════ -->

            <StackPanel x:Name="StatisticsTabPanel" Classes="tab-page" IsVisible="{Binding IsStatisticsTabVisible}" Spacing="4">

            <!-- One card, two quiet rows of big numbers; the format mix is a pill strip under the library row. -->
            <Border Classes="setting-card" Padding="26,22">
                <StackPanel Spacing="18">
                    <TextBlock Text="{loc:T Settings.MusicLibrary}" FontSize="12" FontWeight="SemiBold" Opacity="0.55"/>
                    <UniformGrid Columns="4">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding TotalSongs}" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="{loc:T Settings.Songs}" FontSize="12" Opacity="0.55"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding TotalAlbums}" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="{loc:T Settings.Albums}" FontSize="12" Opacity="0.55"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding TotalArtists}" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="{loc:T Settings.Artists}" FontSize="12" Opacity="0.55"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding TotalListeningTime}" FontSize="28" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{loc:T Settings.TotalDuration}" FontSize="12" Opacity="0.55"/>
                        </StackPanel>
                    </UniformGrid>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-6,0,-6">
                        <Border Classes="stat-pill">
                            <TextBlock FontSize="11.5" Height="14" LineHeight="14" VerticalAlignment="Center"><Run Text="{Binding LosslessCount}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{loc:T Settings.Lossless}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/></TextBlock>
                        </Border>
                        <Border Classes="stat-pill">
                            <TextBlock FontSize="11.5" Height="14" LineHeight="14" VerticalAlignment="Center"><Run Text="{Binding HiResCount}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{loc:T Settings.HiResLossless}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/></TextBlock>
                        </Border>
                        <Border Classes="stat-pill">
                            <TextBlock FontSize="11.5" Height="14" LineHeight="14" VerticalAlignment="Center"><Run Text="{Binding LossyCount}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{loc:T Settings.Lossy}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/></TextBlock>
                        </Border>
                        <Border Classes="stat-pill">
                            <TextBlock FontSize="11.5" Height="14" LineHeight="14" VerticalAlignment="Center"><Run Text="{Binding TotalPlaylists}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{loc:T Settings.Playlists2}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/></TextBlock>
                        </Border>
                    </WrapPanel>

                    <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <TextBlock Text="{loc:T Settings.YourListening}" FontSize="12" FontWeight="SemiBold" Opacity="0.55"/>
                    <UniformGrid Columns="4">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding TotalPlays}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="{loc:T Settings.TotalPlays}" FontSize="12" Opacity="0.55"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding TimeListened}" FontSize="28" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="{loc:T Settings.TimeListened}" FontSize="12" Opacity="0.55"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding AvgTrackLength}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="{loc:T Settings.AvgTrackLength}" FontSize="12" Opacity="0.55"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding LikedTracks}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="{loc:T Settings.LikedSongs}" FontSize="12" Opacity="0.55"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Top played: one card, two columns split by a hairline, the full-page link in the header. -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,8">
                <TextBlock Grid.Column="0" Classes="section-title" Text="{loc:T Settings.Section.TopPlayed}" Margin="0" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Classes="pill-action" Command="{Binding OpenStatisticsPageCommand}" Padding="12,5" CornerRadius="999" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{loc:T Settings.ViewAllStats}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <PathIcon Data="{StaticResource ChevronRightIcon}" Width="9" Height="9" VerticalAlignment="Center" Opacity="0.7"/>
                    </StackPanel>
                </Button>
            </Grid>
            <Border Classes="setting-card" Padding="22,18">
                <Grid ColumnDefinitions="*,1,*">
                    <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,20,0">
                        <TextBlock Text="{loc:T Settings.TopArtists}" FontSize="12" FontWeight="SemiBold" Opacity="0.55"/>
                        <TextBlock Text="{loc:T Settings.PlaySomeTracksSee}" FontSize="13" Opacity="0.4" IsVisible="{Binding !TopArtists.Count}"/>
                        <ItemsControl ItemsSource="{Binding TopArtists}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StatItem">
                                    <Grid ColumnDefinitions="24,*,Auto" Margin="0,5">
                                        <TextBlock Grid.Column="0" Text="{Binding Rank}" FontSize="12" FontWeight="SemiBold" Opacity="0.35" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
                    <StackPanel Grid.Column="2" Spacing="10" Margin="20,0,0,0">
                        <TextBlock Text="{loc:T Settings.TopAlbums}" FontSize="12" FontWeight="SemiBold" Opacity="0.55"/>
                        <TextBlock Text="{loc:T Settings.PlaySomeTracksSee2}" FontSize="13" Opacity="0.4" IsVisible="{Binding !TopAlbums.Count}"/>
                        <ItemsControl ItemsSource="{Binding TopAlbums}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StatItem">
                                    <Grid ColumnDefinitions="24,*,Auto" Margin="0,5">
                                        <TextBlock Grid.Column="0" Text="{Binding Rank}" FontSize="12" FontWeight="SemiBold" Opacity="0.35" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Text="{Binding SubLabel}" FontSize="11.5" Opacity="0.5" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>

            <StackPanel x:Name="AboutTabPanel" Classes="tab-page" IsVisible="{Binding IsAboutTabVisible}" Spacing="4">

            <Border Classes="setting-card" Padding="18,16" Margin="0,0,0,16">
                <StackPanel Spacing="10">
                    <!-- Row 1: logo + version on left, update button on right -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                            <!-- White note, transparent corners, plus a small transparent margin
                                 baked into the asset so the circle's cardinal points have room to
                                 antialiase (the source circle is full-bleed and would otherwise
                                 render with flat spots at 12/3/6/9 o'clock). No clip needed. -->
                            <Border Width="40" Height="40">
                                <Image Source="avares://Noctis.UI/Assets/Icons/Noctis%20Logo%20Padded.png"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{loc:T Settings.Noctis}" FontSize="16" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Click-to-copy version + OS/arch (handy for bug reports) -->
                                    <Button Classes="version-copy"
                                            Background="Transparent"
                                            Padding="0"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Command="{Binding CopyVersionInfoCommand}"
                                            ToolTip.Tip="{loc:T Settings.ClickCopyVersionSystemTip}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AppVersion}"
                                                   FontSize="12" Opacity="0.5"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                    <TextBlock Text="{loc:T Settings.Copied}"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentColorBrush}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding VersionCopied}"/>
                                    <Border IsVisible="{Binding IsPrereleaseBuild}"
                                            Background="#E74856"
                                            CornerRadius="9"
                                            Padding="8,3,8,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{loc:T Settings.PreRelease}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Action buttons (top-right) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Update-available dot next to the update pill, mirroring the
                                 sidebar settings-icon badge -->
                            <Ellipse Width="8" Height="8"
                                     Fill="{DynamicResource AccentColorBrush}"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsUpdateAvailable}"/>
                            <Button Command="{Binding CheckForUpdateCommand}"
                                    Classes="pill update-pill"
                                    Classes.up-to-date="{Binding IsUpToDate}"
                                    Classes.checking="{Binding IsCheckingForUpdate}"
                                    VerticalAlignment="Center"
                                    Padding="16,6"
                                    MinWidth="124"
                                    HorizontalContentAlignment="Center"
                                    IsVisible="{Binding ShowCheckForUpdatesButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <!-- Fixed 14px slot: spinner while checking, tick when up to
                                         date. Keeping the slot means the text never shifts. -->
                                    <Panel Width="14" Height="14" VerticalAlignment="Center">
                                        <Panel.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                <Binding Path="IsCheckingForUpdate"/>
                                                <Binding Path="IsUpToDate"/>
                                            </MultiBinding>
                                        </Panel.IsVisible>
                                        <Ellipse Classes="loading-spinner"
                                                 Stroke="White"
                                                 IsVisible="{Binding IsCheckingForUpdate}"/>
                                        <TextBlock Text="&#x2713;" FontSize="12" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsUpToDate}"/>
                                    </Panel>
                                    <TextBlock Text="{Binding CheckForUpdatesButtonText}"
                                               FontSize="12" Foreground="White"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Update Available button (replaces Check when a new release is detected).
                                 In-app installer path: Inno install (incl. winget/Chocolatey). -->
                            <Button Command="{Binding DownloadUpdateCommand}"
                                    Classes="pill red-pill"
                                    VerticalAlignment="Center"
                                    Padding="16,6"
                                    Background="#E74856"
                                    IsVisible="{Binding ShowInAppUpdateButton}">
                                <TextBlock Text="{Binding UpdateButtonText}"
                                           FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Scoop / portable copies can't safely run the in-app installer;
                                 open the GitHub release instead and surface the update command. -->
                            <Button Command="{Binding OpenLatestReleaseCommand}"
                                    Classes="pill red-pill"
                                    VerticalAlignment="Center"
                                    Padding="16,6"
                                    Background="#E74856"
                                    ToolTip.Tip="{Binding ExternalUpdateHint}"
                                    IsVisible="{Binding ShowManualUpdateButton}">
                                <TextBlock Text="{Binding UpdateButtonText}"
                                           FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Postpone a queued automatic install by 24 h (auto-update only) -->
                            <Button Command="{Binding PostponeAutoInstallCommand}"
                                    Classes="pill"
                                    Padding="16,6"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding ShowPostponeButton}">
                                <TextBlock Text="{loc:T Settings.Postpone}" FontSize="12" />
                            </Button>

                            <!-- Install & Restart button (replaces Update when ready) -->
                            <Button Command="{Binding InstallUpdateCommand}"
                                    Classes="pill red-pill"
                                    VerticalAlignment="Center"
                                    Padding="16,6"
                                    Background="#E74856"
                                    IsVisible="{Binding IsReadyToInstall}">
                                <TextBlock Text="{loc:T Settings.InstallRestart}" FontSize="12" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Update status area -->
                    <StackPanel Orientation="Horizontal" Spacing="12"
                                IsVisible="{Binding UpdateStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding UpdateStatusText}"
                                   FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" />
                        <!-- After an automatic update: the release notes on GitHub -->
                        <Button Command="{Binding OpenLatestReleaseCommand}"
                                Classes="pill"
                                Padding="12,4"
                                VerticalAlignment="Center"
                                IsVisible="{Binding ShowWhatsNew}">
                            <TextBlock Text="{loc:T Settings.WhatsNew}" FontSize="12" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12"
                                IsVisible="{Binding IsDownloadingUpdate}">
                        <ProgressBar Minimum="0" Maximum="100"
                                     Value="{Binding DownloadProgress}"
                                     Height="4" CornerRadius="2"
                                     VerticalAlignment="Center"
                                     MinWidth="200" />
                        <Button Command="{Binding CancelUpdateCommand}"
                                Classes="pill"
                                Padding="16,6"
                                VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.Cancel}" FontSize="12" />
                        </Button>
                    </StackPanel>

                    <!-- Auto-update (opt-in): background download + install at next launch. Hidden for Scoop /
                         portable / read-only copies, which update through their own channel. -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2" IsVisible="{Binding CanAutoUpdate}">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Settings.AutoInstallUpdates}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T Settings.AutoInstallUpdatesCaption}"
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                                       IsVisible="{Binding AutoUpdateInstallsAtLaunch}"/>
                            <TextBlock Text="{loc:T Settings.AutoDownloadUpdatesCaption}"
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                                       IsVisible="{Binding AutoUpdateDownloadOnly}"/>
                        </StackPanel>
                        <controls:LottieToggle Grid.Column="1"
                                              IsChecked="{Binding AutoInstallUpdates}"
                                              VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Row 2: three equal-width brand tiles (GitHub / Discord / Website),
                         each a solid brand fill (star yellow, Discord blurple, Noctis red)
                         with the glyph and text in a contrasting colour. -->
                    <UniformGrid Columns="3" Margin="0,6,0,2">
                        <Button Classes="brand-tile" Command="{Binding OpenGitHubCommand}" Margin="0,0,5,0">
                            <Grid>
                                <Border CornerRadius="16" Background="#F1C40F"/>
                                <Border Classes="tile-lift" CornerRadius="16"/>
                                <StackPanel Margin="16,16,16,14">
                                    <!-- GitHub-gold star on the star-yellow tile (user ask 2026-09-07). The
                                         two hues are a near match, so a tight dark shadow lifts the star off
                                         the tile the way a sticker sits on paper. -->
                                    <PathIcon Data="{StaticResource StarIcon}"
                                              Width="24" Height="24"
                                              Foreground="#F5C518"
                                              Effect="drop-shadow(0 1 3 #B0000000)"
                                              HorizontalAlignment="Left"/>
                                    <TextBlock Text="{loc:T Settings.StarGitHub}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#1B1B1B"
                                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <TextBlock Text="{loc:T Settings.About.GitHubCaption}"
                                               FontSize="12" Foreground="#1B1B1B" Opacity="0.78"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Classes="brand-tile" Command="{Binding OpenDiscordCommand}" Margin="5,0,5,0">
                            <Grid>
                                <Border CornerRadius="16" Background="#5865F2"/>
                                <Border Classes="tile-lift" CornerRadius="16"/>
                                <StackPanel Margin="16,16,16,14">
                                    <PathIcon Data="{StaticResource DiscordIcon}"
                                              Width="24" Height="24"
                                              Foreground="White"
                                              HorizontalAlignment="Left"/>
                                    <TextBlock Text="{loc:T Settings.JoinDiscord}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="White"
                                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <TextBlock Text="{loc:T Settings.About.DiscordCaption}"
                                               FontSize="12" Foreground="White" Opacity="0.78"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Classes="brand-tile" Command="{Binding OpenWebsiteCommand}" Margin="5,0,0,0">
                            <Grid>
                                <Border CornerRadius="16" Background="#E74856"/>
                                <Border Classes="tile-lift" CornerRadius="16"/>
                                <StackPanel Margin="16,16,16,14">
                                    <!-- The real logo (red disc, white double note): on the red tile the
                                         disc merges with the fill and the note reads as the glyph. -->
                                    <Image Source="avares://Noctis.UI/Assets/Icons/Noctis%20Logo%20Padded.png"
                                           Width="28" Height="28" Margin="-2,-2,0,-2"
                                           Stretch="Uniform" HorizontalAlignment="Left"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                    <TextBlock Text="{loc:T Settings.OfficialWebsite}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="White"
                                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <TextBlock Text="{loc:T Settings.About.WebsiteCaption}"
                                               FontSize="12" Foreground="White" Opacity="0.78"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </UniformGrid>

                    <!-- Signature -->
                    <TextBlock Text="{loc:T Settings.YoursTrulyHeartached}"
                               FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                </StackPanel>
            </Border>

            <!-- Developer -->

            </StackPanel>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- APPEARANCE                                          -->
            <!-- ═══════════════════════════════════════════════════ -->


        </StackPanel>
    </ScrollViewer>
    </Grid>
    </Grid>
</UserControl>