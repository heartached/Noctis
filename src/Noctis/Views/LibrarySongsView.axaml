<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:vm="using:Noctis.ViewModels"
             xmlns:m="using:Noctis.Models"
             xmlns:controls="using:Noctis.Controls"
             xmlns:conv="using:Noctis.Converters"
             xmlns:helpers="using:Noctis.Helpers"
             x:Class="Noctis.Views.LibrarySongsView"
             x:DataType="vm:LibrarySongsViewModel"
             Focusable="True"
             Background="{DynamicResource AppMainBackground}">

    <UserControl.Resources>
        <conv:ArtworkPathConverter x:Key="ArtworkConverter" />
        <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometry" />
    </UserControl.Resources>

    <Grid RowDefinitions="*">
        <!-- Right margin trimmed to 2 so the vertical scrollbar sits near the window
             edge (matches the Albums section) instead of being inset ~16px from it. -->
        <DockPanel Grid.Row="0" Margin="16,8,2,16">

        <!-- Column headers (GitHub #151). Header and rows are ColumnsPanels reading one shared
             ColumnLayout (set on the DockPanel in code-behind, inherited by every row), so
             widths are computed once per width and every cell sits under its header. Click a
             header to sort (again to flip), drag a divider to resize (double-click: automatic
             width), drag a header sideways to move the column, right-click for the column list.
             Title / Artist / Album flex with the window until resized; the rest keep their
             widths. Composer and Format have no sort field, so their headers are labels.
             Margin 1,_,9,_ mirrors the track-list row insets (1px ListBoxItem border
             each side + 8px right padding) so header cells sit exactly over row cells. -->
        <controls:ColumnHeaderPanel x:Name="ColumnHeader" DockPanel.Dock="Top" Margin="1,0,9,8"
                                    SortKey="{Binding SortColumn}" SortAscending="{Binding SortAscending}">
            <Button controls:ColumnsPanel.Column="Title" Content="{loc:T LibrarySongs.Title}" Command="{Binding SortCommand}" CommandParameter="Title"
                    Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Cursor="Hand" HorizontalContentAlignment="Left" HorizontalAlignment="Left" />
            <Button controls:ColumnsPanel.Column="Time" Content="{loc:T LibrarySongs.Time}" Command="{Binding SortCommand}" CommandParameter="Time"
                    Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Cursor="Hand" HorizontalContentAlignment="Center" HorizontalAlignment="Center" />
            <Button controls:ColumnsPanel.Column="Artist" Content="{loc:T LibrarySongs.Artist}" Command="{Binding SortCommand}" CommandParameter="Artist"
                    Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Cursor="Hand" HorizontalContentAlignment="Left" HorizontalAlignment="Left" />
            <Button controls:ColumnsPanel.Column="Album" Content="{loc:T LibrarySongs.Album}" Command="{Binding SortCommand}" CommandParameter="Album"
                    Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Cursor="Hand" HorizontalContentAlignment="Left" HorizontalAlignment="Left" />
            <Button controls:ColumnsPanel.Column="Genre" Content="{loc:T LibrarySongs.Genre}" Command="{Binding SortCommand}" CommandParameter="Genre"
                    Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Cursor="Hand" HorizontalContentAlignment="Left" HorizontalAlignment="Left" />
            <Button controls:ColumnsPanel.Column="Favorite" Content="{loc:T LibrarySongs.Favorites}" Command="{Binding SortCommand}" CommandParameter="IsFavorite"
                    Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Cursor="Hand" HorizontalContentAlignment="Center" HorizontalAlignment="Center" />
            <Button controls:ColumnsPanel.Column="Rating" Content="{loc:T LibrarySongs.Rating}" Command="{Binding SortCommand}" CommandParameter="Rating"
                    Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Cursor="Hand" HorizontalContentAlignment="Center" HorizontalAlignment="Center" />
            <Button controls:ColumnsPanel.Column="Plays" Content="{loc:T LibrarySongs.Plays}" Command="{Binding SortCommand}" CommandParameter="Plays"
                    Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Cursor="Hand" HorizontalContentAlignment="Center" HorizontalAlignment="Center" />
            <Button controls:ColumnsPanel.Column="Bpm" Content="{loc:T LibrarySongs.BPM}" Command="{Binding SortCommand}" CommandParameter="Bpm"
                    Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Cursor="Hand" HorizontalContentAlignment="Center" HorizontalAlignment="Center" />
            <Button controls:ColumnsPanel.Column="Bitrate" Content="{loc:T LibrarySongs.Bitrate}" Command="{Binding SortCommand}" CommandParameter="Bitrate"
                    Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Cursor="Hand" HorizontalContentAlignment="Center" HorizontalAlignment="Center" />
            <Button controls:ColumnsPanel.Column="SampleRate" Content="{loc:T LibrarySongs.Sample}" Command="{Binding SortCommand}" CommandParameter="SampleRate"
                    Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Cursor="Hand" HorizontalContentAlignment="Center" HorizontalAlignment="Center" />
            <Button controls:ColumnsPanel.Column="Year" Content="{loc:T Main.Year}" Command="{Binding SortCommand}" CommandParameter="Year"
                    Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Cursor="Hand" HorizontalContentAlignment="Center" HorizontalAlignment="Center" />
            <Button controls:ColumnsPanel.Column="AlbumArtist" Content="{loc:T Main.AlbumArtist}" Command="{Binding SortCommand}" CommandParameter="Album Artist"
                    Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Cursor="Hand" HorizontalContentAlignment="Left" HorizontalAlignment="Left" />
            <TextBlock controls:ColumnsPanel.Column="Composer" Text="{loc:T LibrarySongs.Composer}"
                       FontSize="12" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <TextBlock controls:ColumnsPanel.Column="Format" Text="{loc:T LibrarySongs.Format}"
                       FontSize="12" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button controls:ColumnsPanel.Column="DateAdded" Content="{loc:T Main.DateAdded}" Command="{Binding SortCommand}" CommandParameter="Date Added"
                    Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Cursor="Hand" HorizontalContentAlignment="Center" HorizontalAlignment="Center" />
            <Button controls:ColumnsPanel.Column="ReplayGain" Content="{loc:T LibrarySongs.ReplayGain}" Command="{Binding SortCommand}" CommandParameter="ReplayGain"
                    Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Cursor="Hand" HorizontalContentAlignment="Center" HorizontalAlignment="Center" />
        </controls:ColumnHeaderPanel>

        <Separator DockPanel.Dock="Top" Margin="0,0,0,4" />

        <!-- Content area with overlay for empty state -->
        <Grid>
            <!-- Track list -->
            <!-- Negative left margin pulls the row box 8px past the DockPanel's 16px inset so
                 it reaches further left, matching the album page. Border.row-body adds a
                 matching 8px left padding, so row CONTENT lands exactly where it did and the
                 column headers above (Margin 1,_,9,_) stay over their cells. Moving the
                 ListBox rather than the Border keeps the box inside the scroll viewport —
                 a negative margin on the Border alone would be clipped. -->
            <ListBox Classes="track-list"
                     ItemsSource="{Binding FilteredTracks}"
                     SelectionMode="Multiple"
                     AutoScrollToSelectedItem="False"
                     Margin="-8,0,0,0"
                     Padding="0,0,0,115"
                     x:Name="TrackList">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                </Style>

                <!-- Row background moves off the ListBoxItem onto the inner row-body Border so
                     the hover box and the now-playing box are one element and cannot drift
                     apart. The ListBoxItem keeps its hit-testing and layout role but paints
                     nothing. Same pattern as AlbumDetailView / PlaylistView. -->
                <Style Selector="ListBox.track-list ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBox.track-list ListBoxItem:nth-child(2n)">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBox.track-list ListBoxItem:pointerover">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBox.track-list ListBoxItem:nth-child(2n):pointerover">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBox.track-list ListBoxItem:selected">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBox.track-list ListBoxItem:nth-child(2n):selected">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBox.track-list ListBoxItem.ctrl-selected">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBox.track-list ListBoxItem.ctrl-selected:nth-child(2n)">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBox.track-list ListBoxItem.ctrl-selected:pointerover">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBox.track-list ListBoxItem.ctrl-selected:nth-child(2n):pointerover">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBox.track-list ListBoxItem.ctrl-selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBox.track-list ListBoxItem.ctrl-selected:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <!-- Styles.axaml also carries a compound :selected variant (a row can be both
                     natively :selected — e.g. a plain click before a Ctrl+click on the same
                     row — and .ctrl-selected at once). The neutralisers above already cover
                     it: Avalonia has no selector specificity, so the plain .ctrl-selected
                     pair matches such a row too and wins on origin order (view styles apply
                     after app styles). Kept as belt-and-braces so the compound case is
                     visibly accounted for. -->
                <Style Selector="ListBox.track-list ListBoxItem.ctrl-selected:selected">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBox.track-list ListBoxItem.ctrl-selected:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>

                <!-- Row body: carries stripe, hover, ctrl-select and the now-playing fill on
                     one rectangle. -->
                <Style Selector="Border.row-body">
                    <!-- Left 8 cancels the ListBox's -8 margin: box wider, content unmoved. -->
                    <Setter Property="Padding" Value="8,8,8,8" />
                    <Setter Property="CornerRadius" Value="4" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Transitions">
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.04" />
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="ListBox.track-list ListBoxItem:nth-child(2n) Border.row-body">
                    <Setter Property="Background" Value="{DynamicResource TrackListStripeBrush}" />
                </Style>
                <Style Selector="Border.row-body:pointerover">
                    <Setter Property="Background" Value="{DynamicResource TrackListHoverBrush}" />
                </Style>
                <!-- Row heart: invisible at rest, faint on row hover, brighter under the
                     pointer, red and always visible once favorited. Declaration order
                     matters — the favorited rules come last so they win on hovered rows. -->
                <Style Selector="Button.row-heart">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="6" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                </Style>
                <Style Selector="Button.row-heart:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="Button.row-heart:pressed /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="Border.row-body:pointerover Button.row-heart">
                    <Setter Property="Opacity" Value="0.4" />
                </Style>
                <Style Selector="Border.row-body:pointerover Button.row-heart:pointerover">
                    <Setter Property="Opacity" Value="0.9" />
                </Style>
                <Style Selector="Button.row-heart.is-favorite">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Foreground" Value="#E74856" />
                </Style>
                <Style Selector="Border.row-body:pointerover Button.row-heart.is-favorite">
                    <Setter Property="Opacity" Value="1" />
                </Style>
                <!-- Artwork play overlay (09-14): hidden until the row is hovered; fills the
                     36px thumb with a dim and a centred Play (Pause while this track plays).
                     Same idiom as the playlist page's rows; no global button zoom. -->
                <Style Selector="Button.art-play-overlay">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="Border.row-body:pointerover Button.art-play-overlay">
                    <Setter Property="Opacity" Value="1" />
                </Style>
                <Style Selector="Button.art-play-overlay:pointerover">
                    <Setter Property="RenderTransform" Value="scale(1)" />
                </Style>
                <Style Selector="Button.art-play-overlay:pressed">
                    <Setter Property="RenderTransform" Value="scale(1)" />
                </Style>
                <Style Selector="Button.art-play-overlay:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#80000000" />
                </Style>
                <Style Selector="Button.art-play-overlay Path">
                    <Setter Property="Fill" Value="White" />
                    <Setter Property="Stretch" Value="Uniform" />
                </Style>
                <!-- Row rating stars: same reveal idiom as the heart — hidden until the row is
                     hovered, always visible once rated. -->
                <Style Selector="controls|RatingStars.row-rating">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.08" />
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="controls|RatingStars.row-rating.rated">
                    <Setter Property="Opacity" Value="0.7" />
                </Style>
                <Style Selector="Border.row-body:pointerover controls|RatingStars.row-rating">
                    <Setter Property="Opacity" Value="0.45" />
                </Style>
                <Style Selector="Border.row-body:pointerover controls|RatingStars.row-rating.rated">
                    <Setter Property="Opacity" Value="1" />
                </Style>
                <Style Selector="ListBoxItem.ctrl-selected Border.row-body">
                    <Setter Property="Background" Value="#3FFFFFFF" />
                </Style>
                <!-- MUST stay last: equal-origin Avalonia styles resolve by declaration order,
                     so this is what makes the box win on striped, hovered and ctrl-selected
                     rows alike. -->
                <!-- Snap onto/off the fill; see AlbumDetailView (white flicker on dark accents).
                     Transitions must stay the first setter. -->
                <Style Selector="Border.row-body.now-playing">
                    <Setter Property="Transitions">
                        <Transitions />
                    </Setter>
                    <Setter Property="Background" Value="{DynamicResource NowPlayingRowBrush}" />
                </Style>
                <!-- Lyric search (Discord, Cosmo 11-08): the matched line under the title. The
                     title moves up beside the 36px artwork to make room for it. -->
                <Style Selector="Grid.with-snippet">
                    <!-- 13px title (~20) over the 11px line (~15): at 34 they touched. -->
                    <Setter Property="MinHeight" Value="38" />
                </Style>
                <Style Selector="Grid.with-snippet > controls|HighlightTextBlock.one-line-explicit-title">
                    <Setter Property="VerticalAlignment" Value="Top" />
                </Style>
                <Style Selector="Grid.with-snippet > Border.explicit-badge">
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="Margin" Value="6,3,4,0" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="m:Track">
                    <Border Classes="row-body" Classes.now-playing="{Binding IsNowPlaying}">
                    <!-- Cells name their column; the shared ColumnLayout places and hides them. -->
                    <controls:ColumnsPanel Background="Transparent"
                                           helpers:DragFileBehavior.EnableFileDrag="True"
                                           x:Name="TrackRow">

                        <!-- Artwork + Title + Explicit badge -->
                        <Grid controls:ColumnsPanel.Column="Title"
                              ColumnDefinitions="Auto,Auto,Auto,*"
                              Classes.with-snippet="{Binding LyricsSearchSnippet, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                              ClipToBounds="True"
                              VerticalAlignment="Center"
                              LayoutUpdated="OnTitleCellLayoutUpdated">
                            <!-- Album art thumbnail (Apple Music style); hideable via the
                                 column chooser. Same lazy pipeline as playlist rows. -->
                            <Border Grid.Column="0"
                                    Classes="row-art"
                                    Width="36" Height="36"
                                    CornerRadius="5"
                                    ClipToBounds="True"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Background="#18FFFFFF"
                                    IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Settings.ShowArtworkColumn, FallbackValue=True}">
                                <Panel>
                                    <PathIcon Data="{StaticResource SongsIcon}"
                                              Width="14" Height="14"
                                              Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsVisible="{Binding !HasAlbumArt}" />
                                    <controls:CachedImage SourcePath="{Binding AlbumArtworkPath}"
                                                          DecodeWidth="256"
                                                          Stretch="UniformToFill"
                                                          RenderOptions.BitmapInterpolationMode="HighQuality"
                                                          IsVisible="{Binding HasAlbumArt}" />
                                    <!-- Hover Play over the thumb (09-14): plays from this row like a
                                         double-click; Pause while this is the playing track. -->
                                    <Button Classes="art-play-overlay"
                                            Background="#66000000"
                                            BorderThickness="0"
                                            Padding="0"
                                            CornerRadius="5"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Cursor="Hand"
                                            ToolTip.Tip="{loc:T LibrarySongs.PlayFromHereTip}"
                                            Command="{Binding $parent[UserControl].((vm:LibrarySongsViewModel)DataContext).TogglePlayTrackCommand}"
                                            CommandParameter="{Binding}">
                                        <Panel>
                                            <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0" IsVisible="{Binding !IsCurrentlyPlaying}"><Path Data="{StaticResource PlayIcon}" /></Viewbox>
                                            <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsCurrentlyPlaying}"><Path Data="{StaticResource PauseIcon}" /></Viewbox>
                                        </Panel>
                                    </Button>
                                </Panel>
                            </Border>
                            <!-- Center: the cell is as tall as the 36px artwork, and a
                                 stretched TextBlock draws its glyphs at the top of that
                                 box — which rides ~12px above the artwork and the
                                 (center-aligned) explicit badge beside it. -->
                            <controls:HighlightTextBlock Grid.Column="1"
                                                         Classes="one-line-explicit-title"
                                                         DisplayText="{Binding TitleDisplay}"
                                                         HighlightText="{Binding $parent[UserControl].((vm:LibrarySongsViewModel)DataContext).SearchText}"
                                                         FontSize="13"
                                                         FontWeight="SemiBold"
                                                         TextWrapping="NoWrap"
                                                         MaxLines="1"
                                                         VerticalAlignment="Center"
                                                         TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="2"
                                    Classes="explicit-badge compact"
                                    Margin="6,0,4,0"
                                    IsVisible="{Binding IsExplicit}"
                                    ToolTip.Tip="{loc:T LibrarySongs.ExplicitTip}">
                                <TextBlock Text="E"
                                           Classes="explicit-badge-text compact"
                                           FontSize="8"
                                           Opacity="0.9" />
                            </Border>
                            <!-- Spans into the star column so a long line never widens the title's
                                 column (which would push the E badge). Width capped in
                                 OnTitleCellLayoutUpdated. -->
                            <TextBlock Grid.Column="1"
                                       Grid.ColumnSpan="3"
                                       Classes="lyric-snippet"
                                       Text="{Binding LyricsSearchSnippet, StringFormat='“{0}”'}"
                                       IsVisible="{Binding LyricsSearchSnippet, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="11"
                                       Opacity="0.6"
                                       TextWrapping="NoWrap"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Bottom" />
                        </Grid>

                        <Border controls:ColumnsPanel.Column="Time">
                            <TextBlock Text="{Binding DurationFormatted}"
                                       FontSize="12"
                                       Opacity="0.5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <!-- No right margins on the cells: the shared ColumnLayout.CellPadding keeps every
                             column's text clear of the next one (GitHub #157; was per-cell margins
                             after "Quavo) -...Hip-Hop/Rap", 10-09). -->
                        <Button controls:ColumnsPanel.Column="Artist"
                                Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
                                Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Center"
                                helpers:ArtistCreditLink.IsEnabled="True"
                                Command="{Binding $parent[UserControl].((vm:LibrarySongsViewModel)DataContext).ViewArtistCommand}"
                                CommandParameter="{Binding Artist}">
                            <controls:HighlightTextBlock Classes="accent-link"
                                                         DisplayText="{Binding ArtistDisplay}"
                                                         HighlightText="{Binding $parent[UserControl].((vm:LibrarySongsViewModel)DataContext).SearchText}"
                                                         FontSize="12"
                                                         FontWeight="SemiBold"
                                                         TextTrimming="CharacterEllipsis"
                                                         VerticalAlignment="Center" />
                        </Button>
                        <Button controls:ColumnsPanel.Column="Album"
                                Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
                                Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Command="{Binding $parent[UserControl].((vm:LibrarySongsViewModel)DataContext).ViewAlbumCommand}"
                                CommandParameter="{Binding}">
                            <controls:HighlightTextBlock Classes="accent-link"
                                                         DisplayText="{Binding Album}"
                                                         HighlightText="{Binding $parent[UserControl].((vm:LibrarySongsViewModel)DataContext).SearchText}"
                                                         FontSize="12"
                                                         FontWeight="SemiBold"
                                                         TextTrimming="CharacterEllipsis"
                                                         VerticalAlignment="Center" />
                        </Button>
                        <Border controls:ColumnsPanel.Column="Genre">
                            <controls:HighlightTextBlock Classes="accent-link"
                                                         DisplayText="{Binding GenreDisplay}"
                                                         HighlightText="{Binding $parent[UserControl].((vm:LibrarySongsViewModel)DataContext).SearchText}"
                                                         FontSize="12"
                                                         FontWeight="SemiBold"
                                                         TextTrimming="CharacterEllipsis"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Center" />
                        </Border>
                        <Border controls:ColumnsPanel.Column="Favorite">
                            <!-- One-click favorite (Discord, Reuben Strides 2026-08-25): red when
                                 favorited, faint on row hover otherwise, invisible at rest so the
                                 column reads exactly as before. Ctrl-selected rows toggle together,
                                 like the context menu. -->
                            <Button Classes="row-heart"
                                    Classes.is-favorite="{Binding IsFavorite}"
                                    Command="{Binding $parent[UserControl].((vm:LibrarySongsViewModel)DataContext).ToggleFavoriteCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{loc:T LibrarySongs.FavoriteTip}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <controls:HeartIcon Size="12" IsFavorite="{Binding IsFavorite}" />
                            </Button>
                        </Border>
                        <Border controls:ColumnsPanel.Column="Rating">
                            <!-- Click-to-rate: dim stars appear on row hover for unrated songs;
                                 rated songs always show them. The click rates the whole
                                 Ctrl-selection when the row is part of it (OnRowRated). -->
                            <controls:RatingStars Value="{Binding Rating}"
                                                  Classes="row-rating"
                                                  Classes.rated="{Binding !!Rating}"
                                                  StarSize="11"
                                                  StarSpacing="2"
                                                  IsInteractive="True"
                                                  Cursor="Hand"
                                                  UserRated="OnRowRated"
                                                  ToolTip.Tip="{loc:T LibrarySongs.RateTip}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                        </Border>

                        <Border controls:ColumnsPanel.Column="Plays">
                            <TextBlock Text="{Binding PlayCount}"
                                       FontSize="12"
                                       Opacity="0.5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <!-- Optional columns: BPM / Bitrate / Sample rate -->
                        <Border controls:ColumnsPanel.Column="Bpm">
                            <TextBlock Text="{Binding Bpm}"
                                       FontSize="12" Opacity="0.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding !!Bpm}" />
                        </Border>
                        <Border controls:ColumnsPanel.Column="Bitrate">
                            <TextBlock Text="{Binding BitrateFormatted}"
                                       FontSize="12" Opacity="0.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border controls:ColumnsPanel.Column="SampleRate">
                            <TextBlock Text="{Binding SampleRateFormatted}"
                                       FontSize="12" Opacity="0.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- GitHub #151: Year / Album Artist / Composer / Format / Date Added. -->
                        <Border controls:ColumnsPanel.Column="Year">
                            <TextBlock Text="{Binding Year}"
                                       FontSize="12" Opacity="0.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding !!Year}" />
                        </Border>
                        <Border controls:ColumnsPanel.Column="AlbumArtist">
                            <TextBlock Text="{Binding AlbumArtist}"
                                       FontSize="12" Opacity="0.5"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <Border controls:ColumnsPanel.Column="Composer">
                            <TextBlock Text="{Binding Composer}"
                                       FontSize="12" Opacity="0.5"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <Border controls:ColumnsPanel.Column="Format">
                            <TextBlock Text="{Binding CodecShortName}"
                                       FontSize="12" Opacity="0.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border controls:ColumnsPanel.Column="DateAdded">
                            <TextBlock Text="{Binding DateAddedFormatted}"
                                       FontSize="12" Opacity="0.5"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border controls:ColumnsPanel.Column="ReplayGain">
                            <TextBlock Text="{Binding ReplayGainFormatted}"
                                       FontSize="12" Opacity="0.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- 3-dots menu button -->
                        <Button controls:ColumnsPanel.Column="More"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Width="28" Height="28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                Tag="{Binding}"
                                ToolTip.Tip="{loc:T LibrarySongs.OptionsTip}"
                                Click="OnOptionsButtonClick">
                            <PathIcon Classes="row-dots-icon"
                                     Data="{StaticResource MoreDotsIcon}"
                                     Width="14" Height="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Button>
                    </controls:ColumnsPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state overlay -->
            <StackPanel IsVisible="{Binding !FilteredTracks.Count}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock Text="{loc:T LibrarySongs.NoSongsFound}"
                           FontSize="18"
                           Opacity="0.5"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <TextBlock Text="{loc:T LibrarySongs.AddMusicFoldersSettings}"
                           FontSize="13"
                           Opacity="0.3"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>

        </DockPanel>
    </Grid>

</UserControl>
