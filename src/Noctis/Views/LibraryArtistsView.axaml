<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:vm="using:Noctis.ViewModels"
             xmlns:m="using:Noctis.Models"
             xmlns:ctrl="using:Noctis.Controls"
             x:Class="Noctis.Views.LibraryArtistsView"
             x:DataType="vm:LibraryArtistsViewModel"
             Background="{DynamicResource AppMainBackground}">

    <UserControl.Styles>
        <!-- Keep portrait tiles visually static on hover/press (image is the affordance) -->
        <Style Selector="Button.artist-tile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.artist-tile:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*">
        <!-- Right margin trimmed to 2 so the vertical scrollbar sits at the window edge. -->
        <DockPanel Grid.Row="0" Margin="16,8,2,16">

        <!-- Content area with overlay for empty state -->
        <Grid>
            <!-- Artist grid: outer ListBox virtualizes rows, inner UniformGrid lays out GridColumns portraits per row -->
            <ListBox x:Name="ArtistListBox"
                     ItemsSource="{Binding ArtistRows}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,8,0,115"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionMode="Single"
                     AutoScrollToSelectedItem="False">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                    <!-- Rows exist only for virtualization: press-dragging across the grid
                         must not paint the row-wide hover/selection band. -->
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="m:ArtistRow">
                        <ItemsControl ItemsSource="{Binding Artists}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding $parent[UserControl].((vm:LibraryArtistsViewModel)DataContext).GridColumns, FallbackValue=7}" Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:Artist}">
                                    <!-- Only the portrait circle is interactive: the Button IS the circle
                                         (fixed square + elliptical Clip, which Avalonia hit-testing honours),
                                         so the gap between two tiles, the square corners around the disc and
                                         the name underneath no longer open the artist. -->
                                    <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="4,6">
                                    <!-- 190px disc (user ask 09-15, up from 160); the artist page's Similar Artists tiles match. -->
                                    <Panel HorizontalAlignment="Center" Width="190" Height="190">
                                    <Button Classes="artist-tile"
                                            Focusable="False"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Width="190" Height="190"
                                            CornerRadius="95"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Cursor="Hand"
                                            Command="{Binding $parent[UserControl].((vm:LibraryArtistsViewModel)DataContext).OpenArtistCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding}"
                                            ContextRequested="OnArtistTileContextRequested">
                                        <Button.Clip>
                                            <EllipseGeometry Center="95,95" RadiusX="95" RadiusY="95" />
                                        </Button.Clip>
                                        <!-- Right-click: one shared v2 menu built in code (OnArtistTileContextRequested). -->
                                        <!-- Circular portrait with icon fallback -->
                                        <Border Width="190" Height="190"
                                                CornerRadius="95"
                                                Background="{DynamicResource ArtworkPlaceholderBackground}"
                                                ClipToBounds="True">
                                            <Panel>
                                                <!-- Path shapes, not PathIcon: PathIcon is a templated control and the two per tile
                                                     cost ~3.6ms of every realized row of seven (09-12 scroll-hitch probe). -->
                                                <!-- Height only: the glyph is taller than wide (16×20 units), and a forced
                                                     56×56 box left the Uniform-scaled geometry at the box's left edge, so the
                                                     placeholder sat ~5px left of the circle's centre. Width follows the aspect
                                                     and the Path itself is centred. -->
                                                <Path Data="{StaticResource ArtistsIcon}" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" Height="56"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Opacity="0.35" />
                                                <ctrl:CachedImage SourcePath="{Binding ImagePath}"
                                                                  Stretch="UniformToFill"
                                                                  Width="190"
                                                                  Height="190"
                                                                  IsVisible="{Binding ImagePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </Panel>
                                        </Border>
                                    </Button>
                                    <!-- Favorite star (GitHub #41): accent-colored, riding the
                                         portrait's bottom-right rim. Sibling of the clipped circle,
                                         not a child, so the corner doesn't slice it; the dark disc
                                         keeps it readable over any photo. Not hit-testable: it sits
                                         outside the circle and must not open the artist. -->
                                    <Border Width="26" Height="26" CornerRadius="13"
                                            Background="#D91E1E24"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,6,6"
                                            IsHitTestVisible="False"
                                            IsVisible="{Binding IsFavorite}">
                                        <Path Data="{StaticResource StarIcon}" Stretch="Uniform" Width="15" Height="15" Fill="{DynamicResource AccentColorBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                    </Panel>
                                    <ctrl:HighlightTextBlock DisplayText="{Binding Name}"
                                                             HighlightText="{Binding $parent[UserControl].((vm:LibraryArtistsViewModel)DataContext).SearchText, FallbackValue=''}"
                                                             FontSize="14"
                                                             FontWeight="SemiBold"
                                                             TextWrapping="NoWrap"
                                                             MaxLines="1"
                                                             TextTrimming="CharacterEllipsis"
                                                             TextAlignment="Center"
                                                             MaxWidth="198"
                                                             HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state overlay -->
            <StackPanel IsVisible="{Binding !ArtistRows.Count}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock Text="{loc:T LibraryArtists.NoArtistsFound}"
                           FontSize="18"
                           Opacity="0.5"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <TextBlock Text="{loc:T LibraryArtists.AddMusicFoldersSettings}"
                           FontSize="13"
                           Opacity="0.3"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>

        </DockPanel>
    </Grid>

</UserControl>
