<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Noctis.Localization"
        xmlns:vm="using:Noctis.ViewModels"
        xmlns:controls="using:Noctis.Controls"
        x:Class="Noctis.Views.CreatePlaylistDialog"
        x:DataType="vm:CreatePlaylistDialogViewModel"
        Title="{loc:T CreatePlaylist.CreateNewPlaylist}"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- Small muted label above a field, as the Metadata editor's. -->
        <Style Selector="TextBlock.cp-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
    </Window.Styles>

    <!-- Owner 10-08: the rounded pill pop-up of the Metadata editor, with the blurred app
         behind. PillDialogHost draws the blurred, dimmed owner, the card with its shadow, and
         plays the open/close animation (every close path — Cancel, Create, Esc, Alt+F4 —
         animates out once). The result reaches the caller through the view model's
         PlaylistCreated event, never through Close(result), so the deferred close loses
         nothing. -->
    <controls:PillDialogHost>

    <Grid Width="480" RowDefinitions="Auto,Auto,Auto">

        <!-- Header: title and the one-line purpose (the Playlists page "New" menu's words). -->
        <Border Grid.Row="0"
                Padding="28,22,28,16"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="56,16,*">
                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="18" Classes="pill-well">
                    <PathIcon Data="{StaticResource PlaylistsIcon}" Width="22" Height="22" Opacity="0.6"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T CreatePlaylist.CreateNewPlaylist}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="{loc:T CreatePlaylist.Subtitle}"
                               FontSize="13" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Name (Enter creates) and the optional description. -->
        <StackPanel Grid.Row="1" Margin="28,20,28,24" Spacing="16">
            <StackPanel Spacing="6">
                <TextBlock Classes="cp-label" Text="{loc:T CreatePlaylist.Name}" />
                <TextBox x:Name="NameTextBox"
                         Classes="pill-field"
                         Text="{Binding PlaylistName}"
                         Watermark="{loc:T CreatePlaylist.PlaylistName}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding CreateCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <TextBlock Text="{loc:T CreatePlaylist.NameRequired}"
                           FontSize="12"
                           Margin="16,0,0,0"
                           Foreground="{DynamicResource AccentColorBrush}"
                           IsVisible="{Binding ShowNameRequiredError}" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Classes="cp-label" Text="{loc:T CreatePlaylist.Description}" />
                <TextBox x:Name="DescriptionTextBox"
                         Classes="pill-field"
                         Text="{Binding PlaylistDescription}"
                         Watermark="{loc:T CreatePlaylist.Optional}" />
            </StackPanel>
        </StackPanel>

        <!-- Footer: Cancel / Create on the right (the editor's Cancel / Save). -->
        <Border Grid.Row="2"
                Padding="28,14"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Classes="pill-secondary"
                        Content="{loc:T CreatePlaylist.Cancel}"
                        Command="{Binding CancelCommand}"
                        MinWidth="108" />
                <Button Classes="pill-primary"
                        Content="{loc:T CreatePlaylist.Create}"
                        Command="{Binding CreateCommand}"
                        MinWidth="108" />
            </StackPanel>
        </Border>
    </Grid>
    </controls:PillDialogHost>
</Window>
