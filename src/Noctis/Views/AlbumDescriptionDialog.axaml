<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Noctis.ViewModels"
        xmlns:controls="using:Noctis.Controls"
        x:Class="Noctis.Views.AlbumDescriptionDialog"
        x:DataType="vm:AlbumDetailViewModel"
        Title="Album Description"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
    </Window.Resources>

    <Window.Styles>
        <!-- The card sits on the theme's chrome surface, so the fact tiles have to be
             theme-driven too: hardcoded white text left the whole panel blank on Light. -->
        <Style Selector="Border.album-desc-fact">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style Selector="TextBlock.album-desc-fact-label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.2" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="Opacity" Value="0.54" />
        </Style>
        <Style Selector="TextBlock.album-desc-fact-value">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Styles>

    <!-- Full-window dimmed overlay.
         Starts transparent; code-behind fades it in on open and back out
         before closing (mirrors the Settings modal animation). -->
    <Border x:Name="DialogOverlay"
            Background="#98000000"
            Opacity="0"
            PointerPressed="OnOverlayPointerPressed"
            PointerWheelChanged="OnOverlayWheel">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18">
                    <DoubleTransition.Easing>
                        <CubicEaseOut/>
                    </DoubleTransition.Easing>
                </DoubleTransition>
            </Transitions>
        </Border.Transitions>

        <!-- Centered dialog card: artwork/facts panel on the left, text on the right -->
        <Border x:Name="AlbumDescriptionCard"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                PointerPressed="OnCardPointerPressed"
                Width="920"
                MaxHeight="620"
                CornerRadius="12"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                RenderTransformOrigin="50%,50%"
                RenderTransform="scale(0.96)"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <Border.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18">
                        <TransformOperationsTransition.Easing>
                            <CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Border.Transitions>

            <Grid ColumnDefinitions="290,*">

                <!-- Left panel: cover + facts, same surface as the description side -->
                <Border Grid.Column="0">
                    <StackPanel Margin="22" VerticalAlignment="Center">
                        <Border Height="246"
                                Margin="0,0,0,16"
                                CornerRadius="10"
                                ClipToBounds="True"
                                Background="{DynamicResource ChipBackground}"
                                BoxShadow="0 10 30 0 #55000000">
                            <Panel>
                                <TextBlock Text="&#x266A;"
                                           FontSize="48"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.25"
                                           IsVisible="{Binding HeaderArtPath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                <controls:CachedImage SourcePath="{Binding HeaderArtPath}"
                                                      DecodeWidth="512"
                                                      Stretch="UniformToFill"
                                                      RenderOptions.BitmapInterpolationMode="HighQuality"
                                                      IsVisible="{Binding HeaderArtPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </Panel>
                        </Border>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                            <Border Grid.Row="0" Grid.Column="0" Classes="album-desc-fact" Margin="0,0,4,8">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="album-desc-fact-label" Text="RELEASED" />
                                    <TextBlock Classes="album-desc-fact-value" Text="{Binding Album.ReleaseDateShortFormatted}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Classes="album-desc-fact" Margin="4,0,0,8">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="album-desc-fact-label" Text="GENRE" />
                                    <TextBlock Classes="album-desc-fact-value" Text="{Binding Album.Genre}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Classes="album-desc-fact" Margin="0,0,4,8">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="album-desc-fact-label" Text="TRACKS" />
                                    <TextBlock Classes="album-desc-fact-value" Text="{Binding Album.TrackCount}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Classes="album-desc-fact" Margin="4,0,0,8"
                                    IsVisible="{Binding Album.AudioQualityBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="album-desc-fact-label" Text="QUALITY" />
                                    <TextBlock Classes="album-desc-fact-value" Text="{Binding Album.AudioQualityBadge}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Classes="album-desc-fact"
                                    IsVisible="{Binding Album.HasLabelName}">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="album-desc-fact-label" Text="LABEL" />
                                    <TextBlock Classes="album-desc-fact-value" Text="{Binding Album.LabelName}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right panel: title, meta, description -->
                <!-- Right panel: title, description. Genre / year / quality are deliberately
                     NOT repeated here — the left fact cards already carry them. -->
                <Grid Grid.Column="1" Margin="26,20,26,0" RowDefinitions="Auto,*,Auto">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,14,0">
                            <Run Text="{Binding Album.Name}" />
                            <InlineUIContainer BaselineAlignment="Center">
                                <Border Classes="explicit-badge"
                                        IsVisible="{Binding Album.IsExplicit}"
                                        Margin="0,0,0,-2"
                                        ToolTip.Tip="Explicit">
                                    <TextBlock Text="E"
                                               Classes="explicit-badge-text"
                                               FontSize="10"
                                               Opacity="0.95" />
                                </Border>
                            </InlineUIContainer>
                        </TextBlock>

                        <Button Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Margin="0,0,4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Cursor="Hand"
                                ToolTip.Tip="Edit description"
                                Command="{Binding StartAlbumDescriptionEditCommand}"
                                IsVisible="{Binding !IsAlbumDescriptionEditing}">
                            <PathIcon Data="{StaticResource EditIcon}"
                                      Width="16" Height="16"
                                      Opacity="0.75"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Button>

                        <Button Grid.Column="2"
                                Background="Transparent"
                                BorderThickness="0"
                                Width="32"
                                Height="32"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Cursor="Hand"
                                Click="OnCloseClick">
                            <PathIcon Data="{StaticResource DismissIcon}"
                                      Width="16" Height="16"
                                      Opacity="0.75"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,16,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <TextBlock Text="{Binding AlbumDescriptionFull}"
                                       FontSize="15"
                                       LineHeight="26"
                                       Opacity="0.9"
                                       Margin="0,0,14,0"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding !IsAlbumDescriptionEditing}" />
                            <TextBox Text="{Binding AlbumDescriptionEditorText}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     FontSize="15"
                                     LineHeight="26"
                                     Padding="10,8"
                                     MinHeight="240"
                                     IsVisible="{Binding IsAlbumDescriptionEditing}" />
                        </Grid>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8"
                                Margin="0,14,0,16"
                                IsVisible="{Binding IsAlbumDescriptionEditing}">
                        <Button Content="Cancel"
                                Command="{Binding CancelAlbumDescriptionEditCommand}"
                                Padding="12,6"
                                FontSize="12"
                                FontWeight="Bold"
                                CornerRadius="999"
                                Cursor="Hand"
                                Background="{DynamicResource AccentColorBrush}"
                                Foreground="{DynamicResource AccentForegroundBrush}"
                                Classes="album-desc-btn" />
                        <Button Content="Save"
                                Command="{Binding SaveAlbumDescriptionEditCommand}"
                                Padding="12,6"
                                FontSize="12"
                                FontWeight="Bold"
                                CornerRadius="999"
                                Cursor="Hand"
                                Background="{DynamicResource AccentColorBrush}"
                                Foreground="{DynamicResource AccentForegroundBrush}"
                                Classes="album-desc-btn"
                                IsEnabled="{Binding HasAlbumDescriptionChanges}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
