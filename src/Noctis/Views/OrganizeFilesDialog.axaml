<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Noctis.Localization"
        xmlns:vm="using:Noctis.ViewModels"
        xmlns:controls="using:Noctis.Controls"
        x:Class="Noctis.Views.OrganizeFilesDialog"
        x:DataType="vm:OrganizeFilesViewModel"
        Title="{loc:T OrganizeFiles.OrganizeFiles}"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- Header "Undo last" pill: the editor's header "Find online" pill. BorderThickness is
             set on the button itself: pill-secondary, loaded by the host and so nearer the
             button, sets it to 0 (the same goes for the chips' sizes below). -->
        <Style Selector="Button.of-header-action">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBlock.of-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="TextBlock.of-status">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <!-- Files already where the pattern puts them recede; the ones that move stand out. -->
        <Style Selector="Border.of-row.in-place">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </Window.Styles>

    <!-- Owner 10-08: the rounded pill pop-up of the Metadata editor / Find Metadata, with the
         blurred app behind. PillDialogHost draws the blurred, dimmed owner, the card with its
         shadow, and plays the open/close animation (every close path — Close, Esc, the view
         model's Closed, Alt+F4 — animates out once). MaxHeight, not Height: the card shrinks
         with a short window and stays bounded so the preview list virtualizes. -->
    <controls:PillDialogHost>

    <Grid Width="680" MaxHeight="720" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header: title, one-line purpose, Undo last where the editor has Find online. -->
        <Border Grid.Row="0"
                Padding="28,22,28,16"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="56,16,*,Auto">
                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="18" Classes="pill-well">
                    <controls:LineIcon x:Name="HeaderIcon" Data="{DynamicResource LineOrganizeFiles}" Width="22" Height="22" Opacity="0.6"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T OrganizeFiles.OrganizeFiles}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="{loc:T OrganizeFiles.RenameMoveFilesInto}"
                               FontSize="13" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="3"
                        Classes="pill-secondary of-header-action"
                        BorderThickness="1.5"
                        MinHeight="36"
                        Padding="16,0"
                        FontSize="12.5"
                        VerticalAlignment="Center"
                        Content="{loc:T OrganizeFiles.UndoLast}"
                        Command="{Binding UndoLastCommand}"
                        IsEnabled="{Binding CanUndo}" />
            </Grid>
        </Border>

        <!-- 1. Pattern (tag chips add a token at the caret; the accent line is a live example)
             2. Destination. Pinned at the top: only the preview list below scrolls. -->
        <StackPanel Grid.Row="1" Margin="28,18,28,0" Spacing="14">
            <StackPanel Spacing="6">
                <TextBlock Classes="of-label" Text="{loc:T OrganizeFiles.FolderPattern}" />
                <TextBox x:Name="PatternBox"
                         Classes="pill-field"
                         Text="{Binding Pattern}"
                         Watermark="{}{AlbumArtist}/{Album}/{TrackNo} {Title}" />
                <ItemsControl x:Name="TokenChips" ItemsSource="{Binding Tokens}" Margin="4,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="6" LineSpacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OrganizeFilesViewModel+PatternToken">
                            <!-- Not focusable: the pattern keeps the caret the chip inserts at. -->
                            <Button Classes="pill-secondary"
                                    Content="{Binding Label}"
                                    Tag="{Binding Token}"
                                    Focusable="False"
                                    MinHeight="28"
                                    Padding="12,0"
                                    FontSize="12"
                                    FontWeight="Normal"
                                    ToolTip.Tip="{loc:T OrganizeFiles.InsertToken}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,2,0,0"
                            Background="Transparent"
                            ToolTip.Tip="{loc:T OrganizeFiles.SampleTip}"
                            IsVisible="{Binding SampleTarget, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="→" FontSize="12.5" Opacity="0.45" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SampleTarget}" FontSize="12.5"
                               Foreground="{DynamicResource AccentColorBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="590" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Classes="of-label" Text="{loc:T OrganizeFiles.Destination}" />
                <TextBox Classes="pill-field"
                         Text="{Binding TargetRoot}"
                         Watermark="{loc:T OrganizeFiles.FirstMediaFolder}" />
            </StackPanel>
        </StackPanel>

        <!-- 3. Preview: every planned move in one filled well. -->
        <Grid Grid.Row="2" Margin="28,18,28,12" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <TextBlock Grid.Column="0" Classes="of-label" Text="{loc:T OrganizeFiles.Preview}"
                           VerticalAlignment="Center" Margin="4,0,0,0" />
                <Button Grid.Column="1"
                        Classes="pill-secondary"
                        MinHeight="30"
                        Padding="14,0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Content="{loc:T OrganizeFiles.UpdatePreview}"
                        Command="{Binding PreviewCommand}" />
            </Grid>

            <Border Grid.Row="1" Classes="pill-well" ClipToBounds="True" MinHeight="120">
                <!-- Right padding is the overlay scrollbar's lane, so it never sits on a chip. -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              Padding="8,8,16,8">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <!-- Virtualized: Rows holds one entry per local library track (skips
                             included), so a large library built every row on the UI thread. -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OrganizeFilesViewModel+OrganizeRow">
                                <Border Classes="of-row" Classes.in-place="{Binding IsInPlace}"
                                        Padding="12,7">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                                                Classes="pill-well" CornerRadius="999"
                                                Padding="10,3" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding ActionText}" FontSize="11" Opacity="0.8" />
                                        </Border>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding SourceName}" FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TargetRelative}" FontSize="11.5" Opacity="0.6"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding TargetRelativeFull}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer: count on the left, Close / Apply on the right (the editor's Cancel / Save). -->
        <Border Grid.Row="3"
                Padding="28,14"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Classes="of-status" Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                <Button Grid.Column="1"
                        Classes="pill-secondary"
                        Content="{loc:T OrganizeFiles.Close}"
                        Command="{Binding CloseCommand}"
                        MinWidth="108"
                        Margin="0,0,10,0" />
                <Button Grid.Column="2"
                        Classes="pill-primary"
                        Content="{loc:T OrganizeFiles.Apply}"
                        Command="{Binding ApplyCommand}"
                        IsEnabled="{Binding HasApplicableMoves}"
                        MinWidth="108" />
            </Grid>
        </Border>
    </Grid>
    </controls:PillDialogHost>
</Window>
