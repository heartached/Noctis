<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
        xmlns:vm="using:Noctis.ViewModels"
        x:Class="Noctis.Views.OrganizeFilesDialog"
        x:DataType="vm:OrganizeFilesViewModel"
        Title="{loc:T OrganizeFiles.OrganizeFiles}"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- Pill outline shared with Settings (SettingsView "(not set)" box): 1.5px translucent
             mid-grey, layout-rounded. The Fluent templates restyle the border on hover/focus/press,
             so the template parts are pinned too. Neutral buttons opt in via .pill-outline. -->
        <Style Selector="TextBox">
            <Setter Property="BorderBrush" Value="#99A0A0A8" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#99A0A0A8" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#99A0A0A8" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement, TextBox:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Button.pill-outline">
            <Setter Property="BorderBrush" Value="#99A0A0A8" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
        <Style Selector="Button.pill-outline:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.pill-outline:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#99A0A0A8" />
        </Style>
        <!-- Round header X (same look as the Settings header close). -->
        <Style Selector="Button.dialog-close">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}" />
        </Style>
        <Style Selector="Button.dialog-close:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <!-- Quiet secondary actions in the sticky bar: no fill, no border, dims until hovered.
             The Fluent template paints a hover fill on the presenter, so pin it transparent. -->
        <Style Selector="Button.text-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.text-btn:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.text-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.text-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Window.Styles>

    <Border Background="#50000000">
        <Border CornerRadius="20"
                ClipToBounds="True"
                Background="{DynamicResource AppMainBackground}"
                Width="720"
                MaxHeight="820"
                Margin="0,50"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                BoxShadow="0 8 32 0 #80000000, 0 0 0 1 #33FFFFFF">
            <DockPanel>
                <!-- Header: centred title + one-line description, round X at the top-right. -->
                <Panel DockPanel.Dock="Top" Margin="24,18,18,8">
                    <StackPanel Spacing="2" Margin="34,2,34,0">
                        <TextBlock Text="{loc:T OrganizeFiles.OrganizeFiles}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:T OrganizeFiles.RenameMoveFilesInto}"
                                   FontSize="12" Opacity="0.6" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Classes="dialog-close" Command="{Binding CloseCommand}"
                            ToolTip.Tip="{loc:T Common.Close}"
                            HorizontalAlignment="Right" VerticalAlignment="Top">
                        <PathIcon Data="{StaticResource DismissIcon}" Width="12" Height="12" />
                    </Button>
                </Panel>

                <!-- Sticky bar: count on the left, quiet Undo, one primary on the right. -->
                <Border DockPanel.Dock="Bottom" Padding="24,12,24,16"
                        Background="#09FFFFFF"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                                   FontSize="13" Opacity="0.8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Content="{loc:T OrganizeFiles.UndoLast}" Command="{Binding UndoLastCommand}"
                                IsEnabled="{Binding CanUndo}" Classes="text-btn"
                                VerticalAlignment="Center" Margin="12,0,8,0" />
                        <Button Grid.Column="2" Content="{loc:T OrganizeFiles.Apply}" Command="{Binding ApplyCommand}"
                                IsEnabled="{Binding HasApplicableMoves}"
                                Padding="22,10"
                                Classes="accent-btn"
                                Background="{DynamicResource AccentButtonBackground}"
                                Foreground="{DynamicResource AccentForegroundBrush}"
                                FontWeight="SemiBold"
                                HorizontalContentAlignment="Center" CornerRadius="999" Cursor="Hand" />
                    </Grid>
                </Border>

                <!-- Form stays pinned at the top; only the preview list scrolls, so the
                     mouse wheel always works on one predictable scroll region. -->
                <StackPanel DockPanel.Dock="Top" Margin="24,4,24,0" Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:T OrganizeFiles.FolderPattern}" FontSize="12" FontWeight="SemiBold" Opacity="0.75" />
                        <TextBox Text="{Binding Pattern}" Watermark="{}{AlbumArtist}/{Album}/{TrackNo} {Title}"
                                 CornerRadius="999" Padding="14,8" />
                        <TextBlock Text="{loc:T OrganizeFiles.TokensAlbumArtistArtistAlbum}"
                                   FontSize="11" Opacity="0.5" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:T OrganizeFiles.DestinationFolderBlankFirst}" FontSize="12" FontWeight="SemiBold" Opacity="0.75" />
                        <TextBox Text="{Binding TargetRoot}" Watermark="{loc:T OrganizeFiles.FirstMediaFolder}"
                                 CornerRadius="999" Padding="14,8" />
                    </StackPanel>

                    <Button Content="{loc:T OrganizeFiles.UpdatePreview}" Command="{Binding PreviewCommand}"
                            Classes="pill-outline" HorizontalAlignment="Left" Padding="14,8" CornerRadius="16" Cursor="Hand" />

                    <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.5" />

                    <TextBlock Text="{loc:T OrganizeFiles.Preview}" FontSize="13" FontWeight="SemiBold" Opacity="0.75" Margin="0,0,0,2" />
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              Padding="24,2,24,8">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <!-- Virtualized: Rows holds one entry per local library track (skips
                             included), so opening the tool or pressing Update Preview on a
                             large library built every row's Border + DockPanel + 3 TextBlock
                             tree on the UI thread. -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OrganizeFilesViewModel+OrganizeRow">
                                <Border Background="#10FFFFFF" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                                                Background="#22FFFFFF" CornerRadius="999"
                                                Padding="10,3" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding ActionText}" FontSize="11" Opacity="0.85" />
                                        </Border>
                                        <StackPanel Spacing="1" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SourceName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TargetRelative}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding TargetRelativeFull}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Border>
</Window>
