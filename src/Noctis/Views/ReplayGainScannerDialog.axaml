<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Noctis.Localization"
        xmlns:vm="using:Noctis.ViewModels"
        xmlns:controls="using:Noctis.Controls"
        x:Class="Noctis.Views.ReplayGainScannerDialog"
        x:DataType="vm:ReplayGainScannerViewModel"
        Title="{loc:T ReplayGainScanner.ScanReplayGain}"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- Header "Add files…" pill: the editor's header "Find online" pill. BorderThickness
             is set on the button itself (pill-secondary, nearer the button, sets it to 0). -->
        <Style Selector="Button.rg-header-action">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBlock.rg-status">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Border.rg-row.skipped StackPanel.rg-text">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- Per-row state chip: a dot and one word on a faint tint (Import's Matched/Missing);
             the detail (ffmpeg's error, both gains) is its tooltip. -->
        <Style Selector="Border.rg-chip">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="8,2,9,2" />
            <Setter Property="Background" Value="#18808080" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.rg-chip Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="#80808080" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.rg-chip.working Ellipse">
            <Setter Property="Fill" Value="{DynamicResource AccentColorBrush}" />
        </Style>
        <Style Selector="Border.rg-chip.tagged Ellipse">
            <Setter Property="Fill" Value="#3BB273" />
        </Style>
        <Style Selector="Border.rg-chip.done">
            <Setter Property="Background" Value="#293BB273" />
        </Style>
        <Style Selector="Border.rg-chip.done Ellipse">
            <Setter Property="Fill" Value="#3BB273" />
        </Style>
        <Style Selector="Border.rg-chip.failed">
            <Setter Property="Background" Value="#33FF6B6B" />
        </Style>
        <Style Selector="Border.rg-chip.failed Ellipse">
            <Setter Property="Fill" Value="#FF6B6B" />
        </Style>

        <!-- Thin inline bar under the row while it is measured (YouTube download's bar). -->
        <Style Selector="ProgressBar.rg-bar">
            <Setter Property="Height" Value="3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="#26808080" />
            <Setter Property="Foreground" Value="{DynamicResource AccentColorBrush}" />
            <Setter Property="Margin" Value="0,5,0,1" />
        </Style>
    </Window.Styles>

    <!-- Owner 10-08: the rounded pill pop-up of the Metadata editor / Find Metadata.
         PillDialogHost draws the blurred, dimmed app behind, the card with its shadow, and
         plays the open/close animation (every close path — Cancel, Esc, the view model's
         Closed, Alt+F4 — animates out once). MaxHeight, not Height: the card sizes to its
         content and stays bounded so a long queue virtualizes. -->
    <controls:PillDialogHost>

    <Grid Width="620" MaxHeight="720" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header: icon, "Scan ReplayGain · N tracks", one-line purpose, Add files…
             where the editor has Find online. -->
        <Border Grid.Row="0"
                Padding="28,22,28,16"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="56,16,*,Auto">
                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="18" Classes="pill-well">
                    <PathIcon Data="{StaticResource SpeakerHighIcon}" Width="22" Height="22" Opacity="0.6"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TitleText}" FontSize="18" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{loc:T ReplayGainScanner.Subtitle}"
                               FontSize="13" Opacity="0.7" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{loc:T ReplayGainScanner.SubtitleTip}" />
                </StackPanel>
                <!-- GitHub #105: add any audio file, in the library or not. -->
                <Button x:Name="AddFilesButton"
                        Grid.Column="3"
                        Classes="pill-secondary rg-header-action"
                        BorderThickness="1.5"
                        MinHeight="36"
                        Padding="16,0"
                        FontSize="12.5"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Content="{loc:T ReplayGainScanner.AddFiles}"
                        Click="OnAddFilesClick"
                        IsVisible="{Binding CanAddFiles}"
                        IsEnabled="{Binding CanAddMore}" />
            </Grid>
        </Border>

        <!-- The one option, in plain words. -->
        <StackPanel Grid.Row="1" Margin="28,18,28,0">
            <CheckBox Classes="metadata-pill-checkbox"
                      IsChecked="{Binding AlbumMode}"
                      IsEnabled="{Binding CanEditSelection}"
                      Content="{loc:T ReplayGainScanner.AlbumGain}"
                      ToolTip.Tip="{loc:T ReplayGainScanner.AlbumGainTip}" />
        </StackPanel>

        <!-- Queue: one filled card per file — tick to include, a state chip, and the
             measured gain once it is tagged. Right padding is the overlay scrollbar's lane. -->
        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      Padding="28,16,28,10">
            <ItemsControl ItemsSource="{Binding Jobs}">
                <!-- Virtualized: Jobs holds one entry per selected track and is populated
                     eagerly, so a Ctrl+A selection from the Songs view built thousands of row
                     trees on the UI thread the moment the dialog opened. -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReplayGainScannerViewModel+RgJobRow">
                        <Border Classes="pill-well rg-row" Classes.skipped="{Binding !IsIncluded}"
                                CornerRadius="16" Padding="12,9,12,9" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="Auto,*,12,Auto">
                                <!-- GitHub #105: untick a row to leave that file out of the scan. -->
                                <CheckBox Grid.Column="0" Classes="metadata-pill-checkbox"
                                          Padding="0" MinWidth="0" MinHeight="0"
                                          IsChecked="{Binding IsIncluded}"
                                          IsEnabled="{Binding $parent[ItemsControl].((vm:ReplayGainScannerViewModel)DataContext).CanEditSelection}"
                                          VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" Classes="rg-text" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TrackTitle}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TrackSubtitle}" FontSize="11.5" Opacity="0.55"
                                               TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Classes="rg-bar" IsIndeterminate="True"
                                                 IsVisible="{Binding IsWorking}" />
                                </StackPanel>
                                <Panel Grid.Column="3" VerticalAlignment="Center">
                                    <Border Classes="rg-chip"
                                            IsVisible="{Binding ShowChip}"
                                            Classes.working="{Binding IsWorking}"
                                            Classes.tagged="{Binding IsTagged}"
                                            Classes.done="{Binding IsSucceeded}"
                                            Classes.failed="{Binding IsFailedState}"
                                            ToolTip.Tip="{Binding Detail}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse />
                                            <TextBlock Text="{Binding ChipText}" FontSize="11.5" Opacity="0.85" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Tagged: the track gain in its place, both gains in the tip. -->
                                    <Border Classes="rg-chip done"
                                            IsVisible="{Binding ShowGain}"
                                            ToolTip.Tip="{Binding Detail}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse />
                                            <TextBlock Text="{Binding TrackGainText}" FontSize="11.5" FontWeight="SemiBold"
                                                       Opacity="0.9" />
                                        </StackPanel>
                                    </Border>
                                </Panel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer: status left, Cancel / Scan right; Scan becomes Done once tagged. -->
        <Border Grid.Row="3"
                Padding="28,14"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Classes="rg-status" Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"
                           ToolTip.Tip="{Binding StatusMessage}" />
                <Button Grid.Column="1"
                        Classes="pill-secondary"
                        Content="{Binding CancelLabel}"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding ShowCancel}"
                        MinWidth="108"
                        Margin="0,0,10,0" />
                <Button Grid.Column="2"
                        Classes="pill-primary"
                        Content="{Binding PrimaryButtonText}"
                        Command="{Binding StartCommand}"
                        MinWidth="108" />
            </Grid>
        </Border>
    </Grid>
    </controls:PillDialogHost>
</Window>
