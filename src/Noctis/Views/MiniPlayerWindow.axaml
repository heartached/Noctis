<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Noctis.ViewModels"
        xmlns:m="using:Noctis.Models"
        xmlns:controls="using:Noctis.Controls"
        xmlns:conv="using:Noctis.Converters"
        xmlns:helpers="using:Noctis.Helpers"
        x:Class="Noctis.Views.MiniPlayerWindow"
        x:DataType="vm:MiniPlayerViewModel"
        Title="Noctis Mini Player"
        Width="420" Height="172"
        MinWidth="160" MinHeight="140"
        MaxWidth="960" MaxHeight="840"
        CanResize="True"
        Topmost="True"
        SystemDecorations="None"
        Background="Transparent"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Lossless waveform mark. Hoisted to a resource now that two forms (Card and
             Large icon) draw the quality badge — kept local to this window rather than
             pushed into Icons.axaml, which would mean rewriting the four other views
             that inline the same path. -->
        <StreamGeometry x:Key="LosslessWaveIcon">M8.184,0.35C9.944,0.35 10.703,3.296 11.338,5.238C11.673,3.842 11.497,3.542 11.857,3.542C11.99,3.542 12.126,3.633 12.126,3.798C12.126,3.809 12.123,3.839 12.117,3.883L12.091,4.058C12.02,4.522 11.845,5.494 11.654,6.144C13.198,10.191 14.345,4.861 14.474,3.772C14.493,3.615 14.612,3.542 14.731,3.542C14.891,3.542 15.022,3.662 14.997,3.843C14.72,5.605 14.295,8.35 12.547,8.35C11.582,8.35 11.04,7.595 10.611,6.73C9.54,4.626 9.047,1.093 7.997,1.093C7.66,1.093 7.411,1.444 7.394,1.444C7.362,1.444 7.337,1.301 7.023,0.909C7.322,0.567 7.734,0.35 8.184,0.35ZM2.458,0.354C5.211,0.354 5.456,7.618 7.014,7.618C7.197,7.618 7.394,7.507 7.61,7.256C7.729,7.458 7.851,7.638 7.978,7.796C7.667,8.151 7.28,8.35 6.795,8.35C5.054,8.349 4.306,5.434 3.663,3.466C3.511,4.097 3.432,4.669 3.402,4.925C3.382,5.088 3.263,5.163 3.143,5.163C3.009,5.163 2.874,5.071 2.874,4.908L2.874,4.908L2.877,4.87C2.966,4.223 3.146,3.243 3.347,2.56C3.079,1.858 2.745,1.091 2.252,1.091C1.257,1.091 0.687,3.591 0.527,4.925C0.508,5.088 0.388,5.163 0.268,5.163C0.135,5.163 0,5.071 0,4.908C0,4.896 0.001,4.883 0.002,4.87C0.283,2.836 0.808,0.354 2.458,0.354ZM5.315,0.35C5.809,0.35 6.339,0.608 6.797,1.211C6.822,1.241 7.078,1.639 7.159,1.777C8.277,3.802 8.818,7.627 9.881,7.627C10.065,7.627 10.264,7.513 10.484,7.256C10.604,7.458 10.726,7.638 10.852,7.796C10.542,8.15 10.155,8.35 9.67,8.35C6.933,8.349 6.636,1.09 5.128,1.09C4.788,1.09 4.536,1.444 4.519,1.444C4.487,1.444 4.462,1.301 4.148,0.909C4.455,0.558 4.87,0.35 5.315,0.35Z</StreamGeometry>
        <!-- The frosted band, shared by the Large-icon and Lyrics forms so the two stay in
             step. MiniFrostMask reveals the blurred artwork copy; MiniFrostScrim is the
             contrast ramp over it. Both are measured, not eyeballed — see the notes at the
             Large-icon form's L2/L3 layers before changing an offset. -->
        <LinearGradientBrush x:Key="MiniFrostMask" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0.40" Color="#00000000"/>
            <GradientStop Offset="0.54" Color="#8C000000"/>
            <GradientStop Offset="0.64" Color="#FF000000"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="MiniFrostScrim" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0.40" Color="#00000000"/>
            <GradientStop Offset="0.64" Color="#7A000000"/>
            <GradientStop Offset="1" Color="#A0000000"/>
        </LinearGradientBrush>
        <conv:BlurRadiusToEffectConverter x:Key="BlurToEffect"/>
        <conv:ProgressToSweepForegroundConverter x:Key="ProgressToSweepFg"/>
        <conv:EmphasisGlowConverter x:Key="EmphasisGlow"/>
        <conv:WordOverflowPaddingConverter x:Key="WordOverflowPad"/>
        <conv:OpacityFloorConverter x:Key="OpacityFloor"/>
        <conv:DoubleScaleConverter x:Key="FontScale"/>

        <!-- Duet layout (ELRC v1:/v2:/v3: voice markers) — mini copy of the lyrics
             page keys; keep in sync. -->
        <conv:LyricVoiceToAlignmentConverter x:Key="VoiceAlign"/>
        <conv:LyricVoiceToTextAlignmentConverter x:Key="VoiceTextAlign"/>
        <conv:LyricVoiceToItemsAlignmentConverter x:Key="VoiceItemsAlign"/>
        <conv:LyricVoiceToTransformOriginConverter x:Key="VoiceOrigin"/>
        <conv:DuetMinWidthConverter x:Key="DuetMinWidth"/>

        <!-- Shared karaoke word cell (glow / dimmed base / gradient sweep) — mini copy
             of the lyrics panel template (the mini card is always dark glass, so the
             foregrounds are fixed white instead of the lyrics theme brushes). -->
        <DataTemplate x:Key="MiniWordCellTemplate" x:DataType="m:WordTiming">
            <Panel Classes="word-cell"
                   Classes.current="{Binding IsCurrent}"
                   Classes.emphasis="{Binding IsEmphasis}">
                <!-- DownOnly viewbox: shrinks a merged melisma word that outgrows the
                     line MaxWidth so it can't overflow (WrapPanel cells can't break
                     mid-word); words that fit render 1:1. -->
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" ClipToBounds="False">
                <Panel>
                <!-- Glow hosted in a Canvas so the blur surface has headroom without
                     growing the word cell (see the lyrics page template). -->
                <Canvas ClipToBounds="False">
                    <TextBlock Text="{Binding Text}"
                               Classes="word-glow"
                               IsVisible="{Binding IsEmphasis}"
                               Canvas.Left="-40"
                               Canvas.Top="-40"
                               Padding="40"
                               FontWeight="Bold"
                               Foreground="White">
                        <TextBlock.Opacity>
                            <MultiBinding Converter="{StaticResource EmphasisGlow}">
                                <Binding Path="Progress"/>
                                <Binding Path="HeldDurationMs"/>
                            </MultiBinding>
                        </TextBlock.Opacity>
                    </TextBlock>
                </Canvas>
                <TextBlock Text="{Binding Text}"
                           Classes="word-base"
                           Padding="{Binding Text, Converter={StaticResource WordOverflowPad}}"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="{Binding SweepText}"
                           HorizontalAlignment="Left"
                           FontWeight="Bold">
                    <TextBlock.Foreground>
                        <MultiBinding Converter="{StaticResource ProgressToSweepFg}">
                            <Binding Path="Progress"/>
                            <Binding Source="{x:Static Brushes.White}"/>
                            <Binding Path="Bounds.Width" RelativeSource="{RelativeSource Self}"/>
                            <Binding Path="FontSize" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </TextBlock.Foreground>
                </TextBlock>
                </Panel>
                </Viewbox>
            </Panel>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- Transport buttons: borderless white glyphs over glass. Press feel mirrors
             the playback bar's transport-btn: a soft opacity dip that eases back on
             release — deliberately NO scale (scale(1) on hover/press neutralizes the
             global Button zoom). -->
        <Style Selector="Button.mini-transport">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15">
                        <DoubleTransition.Easing>
                            <CubicEaseOut/>
                        </DoubleTransition.Easing>
                    </DoubleTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.mini-transport:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.mini-transport:pressed">
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Button.mini-transport /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="Button.mini-transport:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#28FFFFFF"/>
        </Style>
        <Style Selector="Button.mini-transport:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#40FFFFFF"/>
        </Style>
        <!-- Favorite heart opts out of the hover/press circle: glyph-only feedback -->
        <Style Selector="Button.mini-transport.no-hover-circle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.mini-transport.no-hover-circle:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Compact seek/volume slider (accent fill/thumb to match the playback bar).
             ClipToBounds stops the track parts (negative margins under the thumb) from
             extending the clickable area past the slider. -->
        <Style Selector="Slider.mini-seek">
            <Setter Property="Height" Value="16"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColorBrush}"/>
        </Style>
        <Style Selector="Slider.mini-seek /template/ Track">
            <Setter Property="Height" Value="4"/>
        </Style>
        <Style Selector="Slider.mini-seek /template/ RepeatButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Slider.mini-seek /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Margin" Value="0,0,-6,0"/>
        </Style>
        <Style Selector="Slider.mini-seek /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Margin" Value="-6,0,0,0"/>
        </Style>
        <Style Selector="Slider.mini-seek /template/ RepeatButton /template/ Border">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Height" Value="4"/>
        </Style>
        <Style Selector="Slider.mini-seek /template/ RepeatButton#PART_IncreaseButton /template/ Border">
            <Setter Property="Background" Value="#50FFFFFF"/>
        </Style>
        <Style Selector="Slider.mini-seek /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="999"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Search box inside the drawer pill: strip the Fluent TextBox chrome -->
        <Style Selector="TextBox.mini-search">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="TextBox.mini-search /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.mini-search:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.mini-search:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Explicit badge. Always hosted as the title marquee's InlineContent (never a
             sibling in a horizontal StackPanel): the marquee subtracts the badge's width
             from its viewport, so a long title trims/scrolls instead of pushing the badge
             out from under the infinite-width StackPanel measure and over the heart. -->
        <Style Selector="Border.mini-explicit">
            <Setter Property="Background" Value="#59FFFFFF"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Drawer / search result rows -->
        <Style Selector="Border.mini-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style Selector="Border.mini-row:pointerover">
            <Setter Property="Background" Value="#1FFFFFFF"/>
        </Style>

        <!-- Liquid circle: persistent translucent glass disc behind the glyph
             (Apple Music's star / "…" buttons) -->
        <Style Selector="Button.mini-transport.glass-circle /template/ ContentPresenter">
            <Setter Property="Background" Value="#26FFFFFF"/>
        </Style>
        <Style Selector="Button.mini-transport.glass-circle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3DFFFFFF"/>
        </Style>
        <Style Selector="Button.mini-transport.glass-circle:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#52FFFFFF"/>
        </Style>

        <!-- "…" popup menu rows -->
        <Style Selector="Button.mini-menu-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.mini-menu-item:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.mini-menu-item:pressed">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.mini-menu-item /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <!-- Theme brushes, not white overlays: the menu card is painted in the app's
             theme background, which a light or custom theme can make pale. -->
        <Style Selector="Button.mini-menu-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
        </Style>
        <Style Selector="Button.mini-menu-item:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}"/>
        </Style>

        <!-- Icon-form hover overlay fade -->
        <Style Selector="Border.icon-overlay">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid#IconFormRoot:pointerover Border.icon-overlay">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Lyric line buttons: mini copy of the panel's AMLL line presentation —
             inactive lines rest at 0.96×, the active line springs to natural size.
             Origin pinned left so text grows in place. ClipToBounds=False or the
             word layer's emphasis swell/glow hard-clips at the line box. -->
        <Style Selector="Button.mini-lyric-line">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0,0.5"/>
            <Setter Property="RenderTransform" Value="translate(0px,0px) scale(0.96)"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.45">
                        <TransformOperationsTransition.Easing>
                            <helpers:SpringEase Damping="7.5" Frequency="4.0"/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.mini-lyric-line.active">
            <Setter Property="RenderTransform" Value="translate(0px,-2px) scale(1)"/>
        </Style>
        <!-- No hover/press box on lyric lines: clickable (Cursor=Hand) but reads as text. -->
        <Style Selector="Button.mini-lyric-line /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.mini-lyric-line:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.mini-lyric-line:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Suppress the global hover-scale on lyric lines. -->
        <Style Selector="ItemsControl#LyricsItems Button:pointerover">
            <Setter Property="RenderTransform" Value="translate(0px,0px) scale(0.96)"/>
        </Style>
        <Style Selector="ItemsControl#LyricsItems Button.mini-lyric-line.active:pointerover">
            <Setter Property="RenderTransform" Value="translate(0px,-1px) scale(1)"/>
        </Style>

        <!-- Per-word lift (panel feel, mini scale). -->
        <Style Selector="Panel.word-cell">
            <Setter Property="RenderTransformOrigin" Value="0.5,1"/>
            <Setter Property="RenderTransform" Value="translate(0px,0px) scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.word-cell.current">
            <Setter Property="RenderTransform" Value="translate(0px,-1px) scale(1.01)"/>
        </Style>

        <!-- Held-note emphasis: slow swell + soft glow, as on the lyrics page. -->
        <Style Selector="Panel.word-cell.emphasis">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.8" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.word-cell.emphasis.current">
            <Setter Property="RenderTransform" Value="translate(0px,-2px) scale(1.04)"/>
        </Style>
        <!-- Glow opacity is bound per-frame in the template (EmphasisGlow bell over
             the hold). No Opacity setter/transition here: a transition would low-pass
             the per-frame values and lag the vocal. -->
        <Style Selector="TextBlock.word-glow">
            <Setter Property="Effect" Value="blur(6)"/>
        </Style>

        <!-- Word base layer: full brightness on inactive lines, soft ghost under the
             sweep while the line is active. -->
        <Style Selector="ItemsControl.word-layer TextBlock.word-base">
            <Setter Property="Opacity" Value="1.0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ItemsControl.word-layer.active TextBlock.word-base">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <!-- Plain (line-timed) lyric text cross-fades its dimming. -->
        <Style Selector="TextBlock.mini-lyric-plain">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Intro dots: pulse as a group while the intro gap is active. -->
        <Style Selector="StackPanel.mini-intro-dots.active">
            <Style.Animations>
                <Animation Duration="0:0:1.8" IterationCount="INFINITE" Easing="SineEaseInOut" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Resize grips: invisible hit areas along edges/corners -->
        <Style Selector="Border.resize-grip">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Close button: invisible until the pointer enters the window, so the card
             carries no chrome at rest (the reference widget has none at all). Staying
             hit-testable while transparent costs nothing — the pointer can only reach it
             from inside the window, which is exactly when it has faded in. The fade comes
             from mini-transport's opacity transition. -->

        <!-- Favourite pop, mirroring the global PathIcon.heart-pop. A local copy because
             that selector is an exact-type match on PathIcon and the mini player draws its
             glyphs as Viewbox/Canvas/Path (a 24×24 canvas centres the glyph predictably;
             PathIcon scales the geometry's own bounds, which left the heart's off-centre
             bounding box visibly low and right inside the button). -->
        <!-- Form cross-fade. The five form layouts are siblings; morphing between them means
             both being alive for the length of the fade, so their IsVisible is driven by
             code-behind (SyncFormVisual) instead of a binding — a binding would collapse the
             outgoing tree in the same frame and leave nothing to fade out. Hidden forms park
             at opacity 0 / scale(1.03) so showing one is just "ease to rest".
             TransformOperationsTransition, never a KeyFrame on RenderTransform: that crashes
             at startup. -->
        <!-- :is(Panel), not Panel or Grid: a bare ".form-root" has no type to resolve the
             setter properties against, and a plain "Panel." selector is exact-type so it
             would skip the four Grid roots. -->
        <Style Selector=":is(Panel).form-root">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform" Value="scale(1.03)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18">
                        <DoubleTransition.Easing>
                            <CubicEaseOut/>
                        </DoubleTransition.Easing>
                    </DoubleTransition>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18">
                        <TransformOperationsTransition.Easing>
                            <CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
        </Style>

        <!-- Optically centre the heart in its disc. The icon's bounding box is centred
             already, but a heart carries its mass in the top lobes and tapers to a
             point, so box-centring reads high: measured under Skia-headless, the ink's
             centroid sits 0.84px above the disc centre, and +0.8px lands it dead on.
             Layout rounding is the other half — it snaps the 14px glyph box half a
             device pixel left/up at 125% and 150% scaling, which is the "it's a bit
             left" tell. The disc keeps rounding (it stays crisp); only the glyph opts
             out. Lives on the wrapping Panel so it composes with mini-heart-pop's
             scale instead of fighting it for the RenderTransform slot. -->
        <Style Selector="Panel.mini-heart-glyph">
            <Setter Property="RenderTransform" Value="translateY(0.8px)"/>
            <Setter Property="UseLayoutRounding" Value="False"/>
        </Style>
        <Style Selector="Viewbox.mini-heart-pop">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25">
                        <TransformOperationsTransition.Easing>
                            <CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2">
                        <DoubleTransition.Easing>
                            <CubicEaseOut/>
                        </DoubleTransition.Easing>
                    </DoubleTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Viewbox.mini-heart-pop[IsVisible=False]">
            <Setter Property="RenderTransform" Value="scale(0.7)"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>
    </Window.Styles>

    <!-- Starts faded/scaled down; code-behind animates to full on open and back down
         on close (the window itself is transparent, so animating the root border
         reads as the whole window animating). -->
    <!-- The card fill lives on this border (not a clipped child layer): the content
         clip is a slightly smaller rounded rect, so a child fill left a bare arc at
         each corner between the fill and the stroke — the fill must follow the same
         rounded outline the stroke draws. -->
    <!-- 1.5px, not 1px: a 1-device-pixel stroke cannot resolve the corner arcs. Measured
         under Skia at 100% and 125% scaling, the arc's brightness swings between 50% and
         98% of the straight edges' as the curve crosses the pixel grid, so the corners
         read as thin and broken while the flat sides stay solid. 1.5px is the first width
         that renders the whole outline at one strength (1.25px is still broken at 100%). -->
    <!-- Genuinely translucent: the fill's alpha is the "Mini Player Opacity" setting, so
         the desktop reads through the card (per-pixel alpha, see the TransparencyLevelHint
         note in code-behind). The blur behind it can't be an OS backdrop — acrylic paints
         the whole window rect and brought back black corners outside the rounded card —
         so the depth comes from the blurred-artwork wash under a light frost instead.
         Brush-level Opacity (as on the playback bar's island) rather than Border.Opacity:
         the latter would fade the card's contents along with the fill. -->
    <!-- ClipToBounds is OFF so the close badge below can hang over the corner. Measured
         under Skia: Border.ClipToBounds is NOT the rectangular clip it looks like — Border
         rounds it by its own CornerRadius, so with it on the badge was sliced off dead on
         the card's outline (nothing painted past r=28). Turning it off costs nothing here,
         because RootPanel carries its own explicit rounded clip and is the only child that
         paints card content. -->
    <Border x:Name="RootBorder"
            CornerRadius="28"
            ClipToBounds="False"
            BorderBrush="#8CFFFFFF"
            BorderThickness="1.5"
            UseLayoutRounding="True"
            Opacity="0"
            RenderTransform="scale(0.92)"
            RenderTransformOrigin="50%,50%"
            PointerPressed="OnRootPointerPressed">
        <Border.Background>
            <SolidColorBrush Color="#0B0B11" Opacity="{Binding Settings.MiniPlayerBackgroundOpacity}"/>
        </Border.Background>
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.16"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18">
                    <TransformOperationsTransition.Easing>
                        <CubicEaseOut/>
                    </TransformOperationsTransition.Easing>
                </TransformOperationsTransition>
            </Transitions>
        </Border.Transitions>

        <!-- Wrapper so the close badge can be a SIBLING of RootPanel rather than a child
             of it. RootPanel carries the rounded clip, so anything inside it is cut at the
             card's outline; out here nothing clips but the window rect, which leaves the
             transparent square corners free for the badge to hang into. -->
        <Panel>

        <!-- RootPanel's rounded clip geometry is kept in sync with the window size by
             code-behind. With RootBorder's ClipToBounds off, this is now the ONLY thing
             holding the artwork / glass layers to the rounded outline. -->
        <Panel x:Name="RootPanel">

            <!-- ── Glass stack (bottom → top) ─────────────────────────────── -->
            <!-- Simulated glass only: OS acrylic (AcrylicBlur) paints the WHOLE window
                 rect, so the transparent corners outside the rounded card came back as
                 black squares. Per-pixel transparency + these layers (over the root
                 border's base fill) keep the rounded outline clean everywhere. -->

            <!-- Liquid wash — the artwork itself, heavily blurred, tints the glass -->
            <controls:CachedImage x:Name="ArtWash"
                                  SourcePath="{Binding Player.CurrentArtPath}"
                                  ClearOnSourceChange="False"
                                  Stretch="UniformToFill"
                                  Opacity="0.42"
                                  IsHitTestVisible="False"
                                  IsVisible="{Binding Player.CurrentArtPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <controls:CachedImage.Effect>
                    <BlurEffect Radius="80"/>
                </controls:CachedImage.Effect>
            </controls:CachedImage>

            <!-- L3: contrast scrim over the wash. Kept light — every point of alpha here
                 is see-through the card loses. -->
            <Border Background="#1A000000" IsHitTestVisible="False"/>

            <!-- L4: glass sheen — diagonal highlight fading out mid-card -->
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="70%,100%">
                        <GradientStop Offset="0" Color="#3DFFFFFF"/>
                        <GradientStop Offset="0.35" Color="#12FFFFFF"/>
                        <GradientStop Offset="0.7" Color="#00FFFFFF"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- L5: top specular — the bright hairline along the upper edge that reads as
                 the lit rim of a glass slab. Clipped to the rounded outline by RootPanel. -->
            <Border Height="1" VerticalAlignment="Top" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Offset="0" Color="#00FFFFFF"/>
                        <GradientStop Offset="0.5" Color="#59FFFFFF"/>
                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Forms on top, drawer underneath — NOT stacked on top of each other. The
                 drawer used to be a bottom-anchored sibling painted over whichever form was
                 showing, which on the short Bar form put the queue straight over the title
                 and transport. Now it owns its own row and the window grows to make space
                 for it (see AnimateDrawer). The glass layers above stay outside this grid
                 so the wash runs behind the drawer too and the card reads as one pane. -->
            <Grid RowDefinitions="*,Auto">
            <Panel Grid.Row="0">

            <!-- ── Form: Icon (tiny square — artwork only, hover controls) ── -->
            <Grid x:Name="IconFormRoot" Classes="form-root" Background="Transparent">
                <Panel x:Name="IconArtClip">
                    <controls:CachedImage SourcePath="{Binding Player.CurrentArtPath}" ClearOnSourceChange="False"
                                          DecodeWidth="512"
                                          Stretch="UniformToFill"
                                          RenderOptions.BitmapInterpolationMode="HighQuality"
                                          IsVisible="{Binding Player.CurrentArtPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <controls:AnimatedCoverImage x:Name="IconAnimatedArt"
                                                 Source="{Binding Player.CurrentAnimatedCoverPath}"
                                                 IsActive="{Binding Settings.EnableAnimatedCovers}"/>
                    <TextBlock Text="♪" FontSize="56" Opacity="0.15" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding Player.CurrentArtPath, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                </Panel>
                <Border Classes="icon-overlay" Background="#66000000">
                    <Panel>
                        <Button Classes="mini-transport" Width="26" Height="26"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="8"
                                ToolTip.Tip="Back to full view"
                                ToolTip.Placement="Left"
                                Click="OnCloseClick">
                            <PathIcon Data="{StaticResource DismissIcon}" Width="12" Height="12" Foreground="White"/>
                        </Button>
                        <Button Classes="mini-transport" Width="46" Height="46"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Command="{Binding Player.PlayPauseCommand}"
                                ToolTip.Tip="{Binding Player.PlayPauseTooltip}">
                            <Panel>
                                <Viewbox Width="24" Height="24"
                                         IsVisible="{Binding Player.State, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static m:PlaybackState.Playing}}">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="White" Data="{StaticResource PlayIcon}"/>
                                    </Canvas>
                                </Viewbox>
                                <Viewbox Width="24" Height="24"
                                         IsVisible="{Binding Player.State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:PlaybackState.Playing}}">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="White" Data="{StaticResource PauseIcon}"/>
                                    </Canvas>
                                </Viewbox>
                            </Panel>
                        </Button>
                    </Panel>
                </Border>
            </Grid>

            <!-- ── Form: Bar (wide + short) ───────────────────────────────── -->
            <Grid x:Name="BarFormRoot" Classes="form-root"
                  Margin="14,12,14,10" RowDefinitions="*,Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <!-- 60 is the largest thumb that still fits row 0 at the bar form's
                         minimum height (140): 140 - 22 margins - 18 seek - 38 transport. -->
                    <Border Grid.Column="0" Width="60" Height="60" CornerRadius="13" VerticalAlignment="Center">
                        <Panel>
                            <Panel.Clip>
                                <RectangleGeometry Rect="0,0,60,60" RadiusX="13" RadiusY="13"/>
                            </Panel.Clip>
                            <controls:CachedImage SourcePath="{Binding Player.CurrentArtPath}" ClearOnSourceChange="False"
                                                  DecodeWidth="256" Width="60" Height="60"
                                                  Stretch="UniformToFill"/>
                            <TextBlock Text="♪" FontSize="24" Opacity="0.2" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding Player.CurrentArtPath, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                        </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" x:Name="BarInfoHost" VerticalAlignment="Center" Margin="12,0,8,0" Spacing="1">
                        <controls:MarqueeTextBlock Text="{Binding Player.CurrentTrack.TitleDisplay, FallbackValue='No track playing'}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White"
                                                   MaxDisplayWidth="{Binding #BarInfoHost.Bounds.Width}"
                                                   HorizontalAlignment="Left"
                                                   IsMiniPlayer="True">
                            <controls:MarqueeTextBlock.InlineContent>
                                <Border Classes="mini-explicit"
                                        IsVisible="{Binding Player.CurrentTrack.IsExplicit, FallbackValue=False}"
                                        ToolTip.Tip="Explicit">
                                    <TextBlock Text="E" FontSize="9" FontWeight="Bold"
                                               VerticalAlignment="Center" TextAlignment="Center"
                                               Foreground="Black"/>
                                </Border>
                            </controls:MarqueeTextBlock.InlineContent>
                        </controls:MarqueeTextBlock>
                        <controls:MarqueeTextBlock Text="{Binding Player.CurrentTrack.ArtistDisplay, FallbackValue=''}"
                                                   FontSize="12"
                                                   Foreground="#B3FFFFFF"
                                                   MaxDisplayWidth="{Binding #BarInfoHost.Bounds.Width}"
                                                   HorizontalAlignment="Left"
                                                   IsMiniPlayer="True"
                                                   IsForAlbum="True"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Negative right margin offsets the heart without dragging "…" along. -->
                        <Button Classes="mini-transport glass-circle" Width="28" Height="28"
                                Margin="4,0,-4,0"
                                Command="{Binding Player.ToggleCurrentTrackFavoriteCommand}"
                                ToolTip.Tip="Favorites">
                            <Panel Classes="mini-heart-glyph">
                                <Viewbox Width="14" Height="14"
                                         IsVisible="{Binding !Player.CurrentTrack.IsFavorite, FallbackValue=False}">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#D9FFFFFF" Data="{StaticResource HeartFillIcon}"/>
                                    </Canvas>
                                </Viewbox>
                                <Viewbox Width="14" Height="14" Classes="mini-heart-pop"
                                         IsVisible="{Binding Player.CurrentTrack.IsFavorite, FallbackValue=False}">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#E74856" Data="{StaticResource HeartFillIcon}"/>
                                    </Canvas>
                                </Viewbox>
                            </Panel>
                        </Button>
                        <Button Classes="mini-transport glass-circle" Width="28" Height="28"
                                ToolTip.Tip="More" Click="OnMoreMenuClick">
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#D9FFFFFF" Data="{StaticResource MoreDotsIcon}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
                    <TextBlock Grid.Column="0" Text="{Binding Player.PositionText}"
                               FontSize="10" Foreground="#A0FFFFFF"
                               VerticalAlignment="Center" MinWidth="32"/>
                    <Slider Grid.Column="1" x:Name="BarSeekSlider" Classes="mini-seek"
                            Minimum="0" Maximum="1" Focusable="False"
                            Value="{Binding Player.PositionFraction, Mode=TwoWay}"
                            Margin="6,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Player.RemainingTimeText}"
                               FontSize="10" Foreground="#A0FFFFFF"
                               VerticalAlignment="Center" MinWidth="32" TextAlignment="Right"/>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center">
                    <Button Classes="mini-transport" Width="34" Height="34"
                            Command="{Binding Player.ToggleShuffleCommand}" ToolTip.Tip="Shuffle">
                        <Panel>
                            <Viewbox Width="18" Height="18" IsVisible="{Binding !Player.IsShuffleEnabled}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#B8FFFFFF" Data="{StaticResource ShuffleIcon}"/>
                                </Canvas>
                            </Viewbox>
                            <Viewbox Width="18" Height="18" IsVisible="{Binding Player.IsShuffleEnabled}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{DynamicResource AccentColorBrush}" Data="{StaticResource ShuffleIcon}"/>
                                </Canvas>
                            </Viewbox>
                        </Panel>
                    </Button>
                    <Button Classes="mini-transport" Width="34" Height="34"
                            Command="{Binding Player.PreviousCommand}" ToolTip.Tip="Previous">
                        <Viewbox Width="19" Height="19">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White" Data="{StaticResource PreviousIcon}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Classes="mini-transport" Width="38" Height="38"
                            Command="{Binding Player.PlayPauseCommand}"
                            ToolTip.Tip="{Binding Player.PlayPauseTooltip}">
                        <Panel>
                            <Viewbox Width="22" Height="22"
                                     IsVisible="{Binding Player.State, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static m:PlaybackState.Playing}}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="{StaticResource PlayIcon}"/>
                                </Canvas>
                            </Viewbox>
                            <Viewbox Width="22" Height="22"
                                     IsVisible="{Binding Player.State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:PlaybackState.Playing}}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="{StaticResource PauseIcon}"/>
                                </Canvas>
                            </Viewbox>
                        </Panel>
                    </Button>
                    <Button Classes="mini-transport" Width="34" Height="34"
                            Command="{Binding Player.NextCommand}" ToolTip.Tip="Forward">
                        <Viewbox Width="19" Height="19">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White" Data="{StaticResource NextIcon}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Classes="mini-transport" Width="34" Height="34"
                            Command="{Binding Player.CycleRepeatCommand}" ToolTip.Tip="Repeat">
                        <Panel>
                            <Viewbox Width="18" Height="18"
                                     IsVisible="{Binding Player.RepeatMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:RepeatMode.Off}}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#B8FFFFFF" Data="{StaticResource RepeatAllIcon}"/>
                                </Canvas>
                            </Viewbox>
                            <Viewbox Width="18" Height="18"
                                     IsVisible="{Binding Player.RepeatMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:RepeatMode.All}}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{DynamicResource AccentColorBrush}" Data="{StaticResource RepeatAllIcon}"/>
                                </Canvas>
                            </Viewbox>
                            <Viewbox Width="18" Height="18"
                                     IsVisible="{Binding Player.RepeatMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:RepeatMode.One}}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{DynamicResource AccentColorBrush}" Data="{StaticResource RepeatOneIcon}"/>
                                </Canvas>
                            </Viewbox>
                        </Panel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── Form: Card (default vertical) ──────────────────────────── -->
            <Grid x:Name="CardFormRoot" Classes="form-root"
                  Margin="16,14,16,12" RowDefinitions="Auto,Auto,Auto,Auto,*">
                <!-- Art thumb + info + "…" -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,20,0,0">
                    <Border Grid.Column="0" Width="72" Height="72" CornerRadius="16" VerticalAlignment="Center">
                        <Panel>
                            <Panel.Clip>
                                <RectangleGeometry Rect="0,0,72,72" RadiusX="16" RadiusY="16"/>
                            </Panel.Clip>
                            <controls:CachedImage SourcePath="{Binding Player.CurrentArtPath}" ClearOnSourceChange="False"
                                                  DecodeWidth="256" Width="72" Height="72"
                                                  Stretch="UniformToFill"/>
                            <TextBlock Text="♪" FontSize="30" Opacity="0.2" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding Player.CurrentArtPath, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                        </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" x:Name="CardInfoHost" VerticalAlignment="Center" Margin="12,0,8,0" Spacing="1">
                        <controls:MarqueeTextBlock Text="{Binding Player.CurrentTrack.TitleDisplay, FallbackValue='No track playing'}"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="White"
                                                   MaxDisplayWidth="{Binding #CardInfoHost.Bounds.Width}"
                                                   HorizontalAlignment="Left"
                                                   IsMiniPlayer="True">
                            <controls:MarqueeTextBlock.InlineContent>
                                <Border Classes="mini-explicit"
                                        IsVisible="{Binding Player.CurrentTrack.IsExplicit, FallbackValue=False}"
                                        ToolTip.Tip="Explicit">
                                    <TextBlock Text="E" FontSize="9" FontWeight="Bold"
                                               VerticalAlignment="Center" TextAlignment="Center"
                                               Foreground="Black"/>
                                </Border>
                            </controls:MarqueeTextBlock.InlineContent>
                        </controls:MarqueeTextBlock>
                        <controls:MarqueeTextBlock Text="{Binding Player.CurrentTrack.ArtistDisplay, FallbackValue=''}"
                                                   FontSize="13"
                                                   Foreground="#B3FFFFFF"
                                                   MaxDisplayWidth="{Binding #CardInfoHost.Bounds.Width}"
                                                   HorizontalAlignment="Left"
                                                   IsMiniPlayer="True"
                                                   IsForAlbum="True"/>
                    </StackPanel>
                    <!-- Liqoria/Apple Music pairing: heart + "…" side by side in glass discs -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="mini-transport glass-circle" Width="28" Height="28"
                                Command="{Binding Player.ToggleCurrentTrackFavoriteCommand}"
                                ToolTip.Tip="Favorites">
                            <Panel Classes="mini-heart-glyph">
                                <Viewbox Width="14" Height="14"
                                         IsVisible="{Binding !Player.CurrentTrack.IsFavorite, FallbackValue=False}">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#D9FFFFFF" Data="{StaticResource HeartFillIcon}"/>
                                    </Canvas>
                                </Viewbox>
                                <Viewbox Width="14" Height="14" Classes="mini-heart-pop"
                                         IsVisible="{Binding Player.CurrentTrack.IsFavorite, FallbackValue=False}">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#E74856" Data="{StaticResource HeartFillIcon}"/>
                                    </Canvas>
                                </Viewbox>
                            </Panel>
                        </Button>
                        <Button Classes="mini-transport glass-circle" Width="28" Height="28"
                                ToolTip.Tip="More" Click="OnMoreMenuClick">
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#D9FFFFFF" Data="{StaticResource MoreDotsIcon}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Seek + times -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
                    <TextBlock Grid.Column="0" Text="{Binding Player.PositionText}"
                               FontSize="10" Foreground="#A0FFFFFF"
                               VerticalAlignment="Center" MinWidth="32"/>
                    <Slider Grid.Column="1" x:Name="SeekSlider" Classes="mini-seek"
                            Minimum="0" Maximum="1" Focusable="False"
                            Value="{Binding Player.PositionFraction, Mode=TwoWay}"
                            Margin="6,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Player.RemainingTimeText}"
                               FontSize="10" Foreground="#A0FFFFFF"
                               VerticalAlignment="Center" MinWidth="32" TextAlignment="Right"/>
                </Grid>

                <!-- Codec quality tag (Lossless / Hi-Res / codec) centered like Apple Music -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            Margin="0,4,0,0"
                            IsVisible="{Binding Player.CurrentTrack.AudioQualityBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                    <ToolTip.Tip>
                        <StackPanel Width="220" Spacing="4">
                            <TextBlock Text="{Binding Player.CurrentTrack.AudioQualityBadge}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            <TextBlock Text="{Binding Player.CurrentTrack.AudioQualityDetailedInfo}"
                                       FontSize="12" Opacity="0.9"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            <TextBlock Text="{Binding Player.CurrentTrack.AudioQualityDescription, FallbackValue=''}"
                                       FontSize="11" TextWrapping="Wrap" Opacity="0.85" Margin="0,4,0,0"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                    </ToolTip.Tip>
                    <Viewbox Width="16" Height="11" VerticalAlignment="Center" Margin="0,0,0,1" Opacity="0.7">
                        <Path Data="{StaticResource LosslessWaveIcon}" Fill="White"/>
                    </Viewbox>
                    <TextBlock Text="{Binding Player.CurrentTrack.AudioQualityBadge, FallbackValue=''}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#B3FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Transport: shuffle | prev play next | heart (Liqoria order) -->
                <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                    <Button Grid.Column="0" Classes="mini-transport" Width="36" Height="36"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Command="{Binding Player.ToggleShuffleCommand}" ToolTip.Tip="Shuffle">
                        <Panel>
                            <Viewbox Width="19" Height="19" IsVisible="{Binding !Player.IsShuffleEnabled}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#B8FFFFFF" Data="{StaticResource ShuffleIcon}"/>
                                </Canvas>
                            </Viewbox>
                            <Viewbox Width="19" Height="19" IsVisible="{Binding Player.IsShuffleEnabled}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{DynamicResource AccentColorBrush}" Data="{StaticResource ShuffleIcon}"/>
                                </Canvas>
                            </Viewbox>
                        </Panel>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button Classes="mini-transport" Width="40" Height="40"
                                Command="{Binding Player.PreviousCommand}" ToolTip.Tip="Previous">
                            <Viewbox Width="21" Height="21">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="{StaticResource PreviousIcon}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Classes="mini-transport" Width="46" Height="46"
                                Command="{Binding Player.PlayPauseCommand}"
                                ToolTip.Tip="{Binding Player.PlayPauseTooltip}">
                            <Panel>
                                <Viewbox Width="25" Height="25"
                                         IsVisible="{Binding Player.State, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static m:PlaybackState.Playing}}">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="White" Data="{StaticResource PlayIcon}"/>
                                    </Canvas>
                                </Viewbox>
                                <Viewbox Width="25" Height="25"
                                         IsVisible="{Binding Player.State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:PlaybackState.Playing}}">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="White" Data="{StaticResource PauseIcon}"/>
                                    </Canvas>
                                </Viewbox>
                            </Panel>
                        </Button>
                        <Button Classes="mini-transport" Width="40" Height="40"
                                Command="{Binding Player.NextCommand}" ToolTip.Tip="Forward">
                            <Viewbox Width="21" Height="21">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="{StaticResource NextIcon}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <Button Grid.Column="2" Classes="mini-transport" Width="36" Height="36"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding Player.CycleRepeatCommand}"
                            ToolTip.Tip="Repeat">
                        <Panel>
                            <Viewbox Width="19" Height="19"
                                     IsVisible="{Binding Player.RepeatMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:RepeatMode.Off}}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#B8FFFFFF" Data="{StaticResource RepeatAllIcon}"/>
                                </Canvas>
                            </Viewbox>
                            <Viewbox Width="19" Height="19"
                                     IsVisible="{Binding Player.RepeatMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:RepeatMode.All}}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{DynamicResource AccentColorBrush}" Data="{StaticResource RepeatAllIcon}"/>
                                </Canvas>
                            </Viewbox>
                            <Viewbox Width="19" Height="19"
                                     IsVisible="{Binding Player.RepeatMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:RepeatMode.One}}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{DynamicResource AccentColorBrush}" Data="{StaticResource RepeatOneIcon}"/>
                                </Canvas>
                            </Viewbox>
                        </Panel>
                    </Button>
                </Grid>
            </Grid>

            <!-- ── Form: Large icon (tall, artwork-dominant, volume bar) ──── -->
            <!-- Full bleed, Apple Music style: the artwork runs edge to edge and the
                 controls float on a frosted band at the bottom. Layered as a Panel
                 rather than stacked in Grid rows — the art is no longer a row, it is
                 the backdrop everything else sits on. RootPanel's rounded clip is what
                 rounds the artwork now, which is why LargeArtClip no longer gets its
                 own 16px clip in code-behind. -->
            <Panel x:Name="LargeIconFormRoot" Classes="form-root">

                <!-- L1: the artwork, at full opacity. "Mini Player Opacity" deliberately
                     does NOT apply here — it is documented as background-only ("the artwork
                     wash, sheen and contents are unaffected") and it still governs the card
                     fill and the glass wash. Running the cover through it as well was tried
                     and reverted: at the 0.55 default it washed the whole card out, and
                     since the frost is a copy of that same artwork, both the sharp top and
                     the frosted bottom faded together — which left no visible band at all. -->
                <Panel x:Name="LargeArtClip">
                    <controls:CachedImage SourcePath="{Binding Player.CurrentArtPath}" ClearOnSourceChange="False"
                                          DecodeWidth="768"
                                          Stretch="UniformToFill"
                                          RenderOptions.BitmapInterpolationMode="HighQuality"
                                          IsVisible="{Binding Player.CurrentArtPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <controls:AnimatedCoverImage x:Name="LargeAnimatedArt"
                                                 Source="{Binding Player.CurrentAnimatedCoverPath}"
                                                 IsActive="{Binding Settings.EnableAnimatedCovers}"/>
                    <TextBlock Text="♪" FontSize="72" Opacity="0.15" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding Player.CurrentArtPath, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                </Panel>

                <!-- L2: the frosted band — a SECOND copy of the same artwork, blurred,
                     revealed by a vertical opacity mask so the frost fades in down the
                     card instead of starting at a hard line. The mask lives on the
                     wrapper (not the image) so it masks the blur's *output*; on the
                     image itself it would fight the effect for the same visual slot.
                     The inner negative margin is the blur's bleed, and it is NOT optional:
                     measured with an exactly-sized copy, the frost holds to 0.85 of the
                     height and then collapses — residual detail climbs from 0.5 to 9.6 at
                     the volume row, 32 near the edge and 53 at the very bottom, i.e. the
                     sharp cover walks back in under the volume slider. The margin is
                     asymmetric on purpose: a square cover on a portrait card is
                     height-driven under UniformToFill, so widening is FREE (same scale,
                     just reveals more source) while heightening zooms the crop away from
                     L1's. -120/-60 holds the bottom edge (residual 0.3-0.7) at a 1.11x
                     zoom, where a uniform -135 cost 1.52x for the same result.
                     Deliberately the STATIC art even while an animated cover plays: at
                     this radius the difference doesn't survive the blur, and a second
                     video decode per frame very much would.
                     Radius measured, not guessed: rendered against a hard stripe pattern,
                     r=36 left 26% of the detail standing and r=60 left 11-20%. Only r=90
                     reads as frost (4% at 100% scaling). Note BlurEffect.Radius is in
                     DEVICE pixels, so the same radius blurs ~20% weaker at 125% scaling —
                     hence the headroom. -->
                <Panel IsHitTestVisible="False"
                       OpacityMask="{StaticResource MiniFrostMask}"
                       IsVisible="{Binding Player.CurrentArtPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <controls:CachedImage SourcePath="{Binding Player.CurrentArtPath}" ClearOnSourceChange="False"
                                          DecodeWidth="768"
                                          Stretch="UniformToFill"
                                          Margin="-120,0,-120,-60"
                                          RenderOptions.BitmapInterpolationMode="HighQuality">
                        <controls:CachedImage.Effect>
                            <BlurEffect Radius="90"/>
                        </controls:CachedImage.Effect>
                    </controls:CachedImage>
                </Panel>

                <!-- L3: contrast ramp. The frost alone does NOT guarantee readable text —
                     a pale cover just blurs to a pale wash. Measured against a worst-case
                     pale cover, white-on-frost came out at 3.0:1 with a light scrim; these
                     stops put the title at 5.1:1 (100%) / 4.9:1 (125%), clearing the 4.5:1
                     floor with margin, while staying lighter than the next step up so dark
                     covers don't get crushed. Full frost lands at 0.64, just above where
                     the controls start (~0.66 at the canonical 340x520). -->
                <Border IsHitTestVisible="False" Background="{StaticResource MiniFrostScrim}"/>

                <!-- L4: the controls, anchored to the bottom of the frosted band. -->
                <Grid VerticalAlignment="Bottom" Margin="16,0,16,12"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,0,0">
                    <StackPanel Grid.Column="0" x:Name="LargeInfoHost" VerticalAlignment="Center" Margin="0,0,8,0" Spacing="1">
                        <controls:MarqueeTextBlock Text="{Binding Player.CurrentTrack.TitleDisplay, FallbackValue='No track playing'}"
                                                   FontSize="15" FontWeight="Bold" Foreground="White"
                                                   MaxDisplayWidth="{Binding #LargeInfoHost.Bounds.Width}"
                                                   HorizontalAlignment="Left" IsMiniPlayer="True">
                            <controls:MarqueeTextBlock.InlineContent>
                                <Border Classes="mini-explicit"
                                        IsVisible="{Binding Player.CurrentTrack.IsExplicit, FallbackValue=False}"
                                        ToolTip.Tip="Explicit">
                                    <TextBlock Text="E" FontSize="9" FontWeight="Bold"
                                               VerticalAlignment="Center" TextAlignment="Center" Foreground="Black"/>
                                </Border>
                            </controls:MarqueeTextBlock.InlineContent>
                        </controls:MarqueeTextBlock>
                        <controls:MarqueeTextBlock Text="{Binding Player.CurrentTrack.ArtistDisplay, FallbackValue=''}"
                                                   FontSize="13" Foreground="#B3FFFFFF"
                                                   MaxDisplayWidth="{Binding #LargeInfoHost.Bounds.Width}"
                                                   HorizontalAlignment="Left" IsMiniPlayer="True" IsForAlbum="True"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="mini-transport glass-circle" Width="28" Height="28"
                                Command="{Binding Player.ToggleCurrentTrackFavoriteCommand}"
                                ToolTip.Tip="Favorites">
                            <Panel Classes="mini-heart-glyph">
                                <Viewbox Width="14" Height="14"
                                         IsVisible="{Binding !Player.CurrentTrack.IsFavorite, FallbackValue=False}">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#D9FFFFFF" Data="{StaticResource HeartFillIcon}"/>
                                    </Canvas>
                                </Viewbox>
                                <Viewbox Width="14" Height="14" Classes="mini-heart-pop"
                                         IsVisible="{Binding Player.CurrentTrack.IsFavorite, FallbackValue=False}">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#E74856" Data="{StaticResource HeartFillIcon}"/>
                                    </Canvas>
                                </Viewbox>
                            </Panel>
                        </Button>
                        <Button Classes="mini-transport glass-circle" Width="28" Height="28"
                                ToolTip.Tip="More" Click="OnMoreMenuClick">
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#D9FFFFFF" Data="{StaticResource MoreDotsIcon}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,0">
                    <TextBlock Grid.Column="0" Text="{Binding Player.PositionText}"
                               FontSize="10" Foreground="#A0FFFFFF"
                               VerticalAlignment="Center" MinWidth="32"/>
                    <Slider Grid.Column="1" x:Name="LargeSeekSlider" Classes="mini-seek"
                            Minimum="0" Maximum="1" Focusable="False"
                            Value="{Binding Player.PositionFraction, Mode=TwoWay}"
                            Margin="6,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Player.RemainingTimeText}"
                               FontSize="10" Foreground="#A0FFFFFF"
                               VerticalAlignment="Center" MinWidth="32" TextAlignment="Right"/>
                </Grid>

                <!-- Codec quality tag (Lossless / Hi-Res / codec) centered like Apple Music -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            Margin="0,4,0,0"
                            IsVisible="{Binding Player.CurrentTrack.AudioQualityBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                    <ToolTip.Tip>
                        <StackPanel Width="220" Spacing="4">
                            <TextBlock Text="{Binding Player.CurrentTrack.AudioQualityBadge}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            <TextBlock Text="{Binding Player.CurrentTrack.AudioQualityDetailedInfo}"
                                       FontSize="12" Opacity="0.9"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            <TextBlock Text="{Binding Player.CurrentTrack.AudioQualityDescription, FallbackValue=''}"
                                       FontSize="11" TextWrapping="Wrap" Opacity="0.85" Margin="0,4,0,0"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                    </ToolTip.Tip>
                    <Viewbox Width="16" Height="11" VerticalAlignment="Center" Margin="0,0,0,1" Opacity="0.7">
                        <Path Data="{StaticResource LosslessWaveIcon}" Fill="White"/>
                    </Viewbox>
                    <TextBlock Text="{Binding Player.CurrentTrack.AudioQualityBadge, FallbackValue=''}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#B3FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                    <Button Grid.Column="0" Classes="mini-transport" Width="36" Height="36"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Command="{Binding Player.ToggleShuffleCommand}" ToolTip.Tip="Shuffle">
                        <Panel>
                            <Viewbox Width="19" Height="19" IsVisible="{Binding !Player.IsShuffleEnabled}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#B8FFFFFF" Data="{StaticResource ShuffleIcon}"/>
                                </Canvas>
                            </Viewbox>
                            <Viewbox Width="19" Height="19" IsVisible="{Binding Player.IsShuffleEnabled}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{DynamicResource AccentColorBrush}" Data="{StaticResource ShuffleIcon}"/>
                                </Canvas>
                            </Viewbox>
                        </Panel>
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                    <Button Classes="mini-transport" Width="40" Height="40"
                            Command="{Binding Player.PreviousCommand}" ToolTip.Tip="Previous">
                        <Viewbox Width="21" Height="21">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White" Data="{StaticResource PreviousIcon}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Classes="mini-transport" Width="46" Height="46"
                            Command="{Binding Player.PlayPauseCommand}"
                            ToolTip.Tip="{Binding Player.PlayPauseTooltip}">
                        <Panel>
                            <Viewbox Width="25" Height="25"
                                     IsVisible="{Binding Player.State, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static m:PlaybackState.Playing}}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="{StaticResource PlayIcon}"/>
                                </Canvas>
                            </Viewbox>
                            <Viewbox Width="25" Height="25"
                                     IsVisible="{Binding Player.State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:PlaybackState.Playing}}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="{StaticResource PauseIcon}"/>
                                </Canvas>
                            </Viewbox>
                        </Panel>
                    </Button>
                    <Button Classes="mini-transport" Width="40" Height="40"
                            Command="{Binding Player.NextCommand}" ToolTip.Tip="Forward">
                        <Viewbox Width="21" Height="21">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White" Data="{StaticResource NextIcon}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="mini-transport" Width="36" Height="36"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding Player.CycleRepeatCommand}" ToolTip.Tip="Repeat">
                        <Panel>
                            <Viewbox Width="19" Height="19"
                                     IsVisible="{Binding Player.RepeatMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:RepeatMode.Off}}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#B8FFFFFF" Data="{StaticResource RepeatAllIcon}"/>
                                </Canvas>
                            </Viewbox>
                            <Viewbox Width="19" Height="19"
                                     IsVisible="{Binding Player.RepeatMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:RepeatMode.All}}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{DynamicResource AccentColorBrush}" Data="{StaticResource RepeatAllIcon}"/>
                                </Canvas>
                            </Viewbox>
                            <Viewbox Width="19" Height="19"
                                     IsVisible="{Binding Player.RepeatMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:RepeatMode.One}}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{DynamicResource AccentColorBrush}" Data="{StaticResource RepeatOneIcon}"/>
                                </Canvas>
                            </Viewbox>
                        </Panel>
                    </Button>
                </Grid>

                <!-- Bottom volume bar (Liqoria large-icon look) -->
                <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" Margin="2,6,2,0">
                    <Button Grid.Column="0" Classes="mini-transport" Width="26" Height="26"
                            Command="{Binding Player.ToggleMuteCommand}" ToolTip.Tip="Mute">
                        <Panel>
                            <Viewbox Width="13" Height="13" Opacity="0.75" IsVisible="{Binding !Player.IsMuted}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="{StaticResource SpeakerZeroIcon}"/>
                                </Canvas>
                            </Viewbox>
                            <Viewbox Width="13" Height="13" Opacity="0.55" IsVisible="{Binding Player.IsMuted}">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="{StaticResource SpeakerMuteIcon}"/>
                                </Canvas>
                            </Viewbox>
                        </Panel>
                    </Button>
                    <Slider Grid.Column="1" x:Name="LargeVolumeSlider" Classes="mini-seek"
                            Minimum="0" Maximum="100" Focusable="False"
                            Value="{Binding Player.Volume, Mode=TwoWay}"
                            Margin="4,0" VerticalAlignment="Center"/>
                    <Viewbox Grid.Column="2" Width="15" Height="15" Opacity="0.75" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Fill="White" Data="{StaticResource SpeakerHighIcon}"/>
                        </Canvas>
                    </Viewbox>
                </Grid>

                </Grid>
            </Panel>

            <!-- ── Form: Lyrics (wide split view, Liqoria 1.5 layout) ─────── -->
            <!-- The root carries NO margin any more: the art column bleeds to the window's
                 left/top/bottom edges, so the insets moved onto the lyrics column. -->
            <!-- The art column's width bounds live on the COLUMN, not on the panel inside
                 it. On the panel they capped the panel while the column kept its full 5/12
                 share, so on a wide window the panel centred itself in the slot and left a
                 strip of bare card down each side of the artwork. On the column the cap
                 shrinks the slot itself and the spare width goes to the lyrics. -->
            <Grid x:Name="LyricsFormRoot" Classes="form-root">
                <!-- Left: full-bleed artwork with the controls floating on a frosted band,
                     same construction as the Large-icon form (see the notes there for why
                     the mask sits on the wrapper and why the bleed margin is asymmetric).
                     Rounded on the left by RootPanel's clip; its right edge is a straight
                     seam against the lyrics column. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" MinWidth="190" MaxWidth="320"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>

                <Panel Grid.Column="0" x:Name="LyricsArtColumn">
                    <!-- L1: frost backdrop — the blurred cover filling the WHOLE column at
                         full strength, no mask. The sharp cover sits over its top, so what
                         shows below the cover reads as the frost carrying on rather than
                         bare glass. (The Large-icon form masks its frost instead, because
                         there the sharp artwork runs the whole card and the frost has to
                         fade in over it. Here the sharp artwork stops, so it doesn't.) -->
                    <!-- Stretch is Fill, NOT UniformToFill: this copy has no sharp artwork
                         to stay aligned with (the cover above it stops), and UniformToFill
                         on a tall narrow column is height-driven, so it magnified a thin
                         central sliver of the cover more and more as the window grew —
                         the frost visibly churned while resizing. Fill always maps the
                         WHOLE cover onto the column, so it is stable at any size and keeps
                         the cover's real colours; the aspect distortion it introduces does
                         not survive a 90px blur. -->
                    <controls:CachedImage SourcePath="{Binding Player.CurrentArtPath}" ClearOnSourceChange="False"
                                          DecodeWidth="512"
                                          Stretch="Fill"
                                          Margin="-120,0,-120,-60"
                                          IsHitTestVisible="False"
                                          RenderOptions.BitmapInterpolationMode="HighQuality"
                                          IsVisible="{Binding Player.CurrentArtPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <controls:CachedImage.Effect>
                            <BlurEffect Radius="90"/>
                        </controls:CachedImage.Effect>
                    </controls:CachedImage>

                    <!-- L2: the cover itself — a full-width SQUARE pinned to the top, so a
                         square cover lands whole instead of being cropped to a vertical
                         slice by the tall column. Height tracks the COLUMN's width (not its
                         own, which would be self-referential). Its bottom edge dissolves
                         into the frost underneath rather than ending on a hard line. -->
                    <Panel x:Name="LyricsArtClip"
                           VerticalAlignment="Top"
                           Height="{Binding #LyricsArtColumn.Bounds.Width}">
                        <Panel.OpacityMask>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Offset="0.86" Color="#FF000000"/>
                                <GradientStop Offset="1" Color="#00000000"/>
                            </LinearGradientBrush>
                        </Panel.OpacityMask>
                        <controls:CachedImage SourcePath="{Binding Player.CurrentArtPath}" ClearOnSourceChange="False"
                                              DecodeWidth="512"
                                              Stretch="UniformToFill"
                                              RenderOptions.BitmapInterpolationMode="HighQuality"
                                              IsVisible="{Binding Player.CurrentArtPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <controls:AnimatedCoverImage x:Name="LyricsAnimatedArt"
                                                     Source="{Binding Player.CurrentAnimatedCoverPath}"
                                                     IsActive="{Binding Settings.EnableAnimatedCovers}"/>
                        <TextBlock Text="♪" FontSize="42" Opacity="0.15" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding Player.CurrentArtPath, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                    </Panel>

                    <Border IsHitTestVisible="False" Background="{StaticResource MiniFrostScrim}"/>

                    <Grid VerticalAlignment="Bottom" Margin="12,0,12,10"
                          RowDefinitions="Auto,Auto,Auto,Auto">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,4,0,0">
                        <StackPanel Grid.Column="0" x:Name="LyricsInfoHost" Spacing="1" VerticalAlignment="Center" Margin="0,0,6,0">
                            <controls:MarqueeTextBlock Text="{Binding Player.CurrentTrack.TitleDisplay, FallbackValue='No track playing'}"
                                                       FontSize="14" FontWeight="Bold" Foreground="White"
                                                       MaxDisplayWidth="{Binding #LyricsInfoHost.Bounds.Width}"
                                                       HorizontalAlignment="Left" IsMiniPlayer="True">
                                <controls:MarqueeTextBlock.InlineContent>
                                    <Border Classes="mini-explicit"
                                            IsVisible="{Binding Player.CurrentTrack.IsExplicit, FallbackValue=False}"
                                            ToolTip.Tip="Explicit">
                                        <TextBlock Text="E" FontSize="9" FontWeight="Bold"
                                                   VerticalAlignment="Center" TextAlignment="Center"
                                                   Foreground="Black"/>
                                    </Border>
                                </controls:MarqueeTextBlock.InlineContent>
                            </controls:MarqueeTextBlock>
                            <controls:MarqueeTextBlock Text="{Binding Player.CurrentTrack.ArtistDisplay, FallbackValue=''}"
                                                       FontSize="12" Foreground="#B3FFFFFF"
                                                       MaxDisplayWidth="{Binding #LyricsInfoHost.Bounds.Width}"
                                                       HorizontalAlignment="Left" IsMiniPlayer="True" IsForAlbum="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="mini-transport glass-circle" Width="28" Height="28"
                                    Command="{Binding Player.ToggleCurrentTrackFavoriteCommand}"
                                    ToolTip.Tip="Favorites">
                                <Panel Classes="mini-heart-glyph">
                                    <Viewbox Width="14" Height="14"
                                             IsVisible="{Binding !Player.CurrentTrack.IsFavorite, FallbackValue=False}">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#D9FFFFFF" Data="{StaticResource HeartFillIcon}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Viewbox Width="14" Height="14" Classes="mini-heart-pop"
                                             IsVisible="{Binding Player.CurrentTrack.IsFavorite, FallbackValue=False}">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#E74856" Data="{StaticResource HeartFillIcon}"/>
                                        </Canvas>
                                    </Viewbox>
                                </Panel>
                            </Button>
                            <Button Classes="mini-transport glass-circle" Width="28" Height="28"
                                    ToolTip.Tip="More" Click="OnMoreMenuClick">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#D9FFFFFF" Data="{StaticResource MoreDotsIcon}"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Slider Grid.Row="1" x:Name="LyricsSeekSlider" Classes="mini-seek"
                            Minimum="0" Maximum="1" Focusable="False"
                            Value="{Binding Player.PositionFraction, Mode=TwoWay}"
                            Margin="0,4,0,0" VerticalAlignment="Center"/>

                    <!-- Codec quality tag (Lossless / Hi-Res / codec) centered like Apple Music -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4"
                                HorizontalAlignment="Center"
                                Background="Transparent"
                                Margin="0,3,0,0"
                                IsVisible="{Binding Player.CurrentTrack.AudioQualityBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                        <ToolTip.Tip>
                            <StackPanel Width="220" Spacing="4">
                                <TextBlock Text="{Binding Player.CurrentTrack.AudioQualityBadge}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                <TextBlock Text="{Binding Player.CurrentTrack.AudioQualityDetailedInfo}"
                                           FontSize="12" Opacity="0.9"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                <TextBlock Text="{Binding Player.CurrentTrack.AudioQualityDescription, FallbackValue=''}"
                                           FontSize="11" TextWrapping="Wrap" Opacity="0.85" Margin="0,4,0,0"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                        </ToolTip.Tip>
                        <Viewbox Width="16" Height="11" VerticalAlignment="Center" Margin="0,0,0,1" Opacity="0.7">
                            <Path Data="{StaticResource LosslessWaveIcon}" Fill="White"/>
                        </Viewbox>
                        <TextBlock Text="{Binding Player.CurrentTrack.AudioQualityBadge, FallbackValue=''}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="#B3FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Button Classes="mini-transport" Width="30" Height="30"
                                Command="{Binding Player.ToggleShuffleCommand}" ToolTip.Tip="Shuffle">
                            <Panel>
                                <Viewbox Width="16" Height="16" IsVisible="{Binding !Player.IsShuffleEnabled}">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#B8FFFFFF" Data="{StaticResource ShuffleIcon}"/>
                                    </Canvas>
                                </Viewbox>
                                <Viewbox Width="16" Height="16" IsVisible="{Binding Player.IsShuffleEnabled}">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource AccentColorBrush}" Data="{StaticResource ShuffleIcon}"/>
                                    </Canvas>
                                </Viewbox>
                            </Panel>
                        </Button>
                        <Button Classes="mini-transport" Width="32" Height="32"
                                Command="{Binding Player.PreviousCommand}" ToolTip.Tip="Previous">
                            <Viewbox Width="17" Height="17">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="{StaticResource PreviousIcon}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Classes="mini-transport" Width="38" Height="38"
                                Command="{Binding Player.PlayPauseCommand}"
                                ToolTip.Tip="{Binding Player.PlayPauseTooltip}">
                            <Panel>
                                <Viewbox Width="21" Height="21"
                                         IsVisible="{Binding Player.State, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static m:PlaybackState.Playing}}">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="White" Data="{StaticResource PlayIcon}"/>
                                    </Canvas>
                                </Viewbox>
                                <Viewbox Width="21" Height="21"
                                         IsVisible="{Binding Player.State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:PlaybackState.Playing}}">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="White" Data="{StaticResource PauseIcon}"/>
                                    </Canvas>
                                </Viewbox>
                            </Panel>
                        </Button>
                        <Button Classes="mini-transport" Width="32" Height="32"
                                Command="{Binding Player.NextCommand}" ToolTip.Tip="Forward">
                            <Viewbox Width="17" Height="17">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="{StaticResource NextIcon}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Classes="mini-transport" Width="30" Height="30"
                                Command="{Binding Player.CycleRepeatCommand}" ToolTip.Tip="Repeat">
                            <Panel>
                                <Viewbox Width="16" Height="16"
                                         IsVisible="{Binding Player.RepeatMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:RepeatMode.Off}}">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#B8FFFFFF" Data="{StaticResource RepeatAllIcon}"/>
                                    </Canvas>
                                </Viewbox>
                                <Viewbox Width="16" Height="16"
                                         IsVisible="{Binding Player.RepeatMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:RepeatMode.All}}">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource AccentColorBrush}" Data="{StaticResource RepeatAllIcon}"/>
                                    </Canvas>
                                </Viewbox>
                                <Viewbox Width="16" Height="16"
                                         IsVisible="{Binding Player.RepeatMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:RepeatMode.One}}">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource AccentColorBrush}" Data="{StaticResource RepeatOneIcon}"/>
                                    </Canvas>
                                </Viewbox>
                            </Panel>
                        </Button>
                    </StackPanel>

                    </Grid>
                </Panel>

                <!-- Right: synced lyrics. Carries the insets the form root used to apply,
                     now that the root has none so the art column can bleed to the edges. -->
                <Panel Grid.Column="1" Margin="14,36,10,12">
                    <ScrollViewer x:Name="LyricsScroll"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Hidden">
                        <StackPanel Margin="0,8,8,120">
                            <!-- Mini copy of the lyrics panel's line presentation: plain text
                                 layer for line-timed lyrics, three-layer karaoke word cells
                                 (glow / dimmed base / gradient sweep) for word-timed (ELRC/TTML)
                                 lines, background vocals row, and intro dots. MaxWidth is kept
                                 in sync with the scroller by code-behind so WrapPanel lines
                                 never run under the right edge. -->
                            <ItemsControl x:Name="LyricsItems" ItemsSource="{Binding Lyrics.ActiveLyricLines}"
                                          FontSize="17"
                                          MaxWidth="340"
                                          ClipToBounds="False"
                                          HorizontalAlignment="Left">
                                <ItemsControl.MinWidth>
                                    <MultiBinding Converter="{StaticResource DuetMinWidth}">
                                        <Binding Path="Lyrics.HasDuetLines"/>
                                        <Binding Path="$self.MaxWidth"/>
                                    </MultiBinding>
                                </ItemsControl.MinWidth>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:LyricLine">
                                        <Button Background="Transparent"
                                                Classes="mini-lyric-line"
                                                Classes.active="{Binding IsActive}"
                                                BorderThickness="0"
                                                Padding="0"
                                                Margin="0,9"
                                                MaxWidth="{Binding $parent[ItemsControl].MaxWidth}"
                                                HorizontalAlignment="{Binding Voice, Converter={StaticResource VoiceAlign}}"
                                                RenderTransformOrigin="{Binding Voice, Converter={StaticResource VoiceOrigin}}"
                                                HorizontalContentAlignment="Left"
                                                Cursor="Hand"
                                                IsHitTestVisible="{Binding IsClickable}"
                                                Command="{Binding $parent[Window].((vm:MiniPlayerViewModel)DataContext).Lyrics.SeekToLineCommand}"
                                                CommandParameter="{Binding}"
                                                Effect="{Binding BlurRadius, Converter={StaticResource BlurToEffect}}">
                                            <StackPanel HorizontalAlignment="Left"
                                                        MaxWidth="{Binding $parent[ItemsControl].MaxWidth}">
                                            <Panel HorizontalAlignment="{Binding Voice, Converter={StaticResource VoiceAlign}}">
                                                <!-- Plain text layer (lines without word timings) -->
                                                <TextBlock Text="{Binding Text}"
                                                           Classes="mini-lyric-plain"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Left"
                                                           TextAlignment="{Binding Voice, Converter={StaticResource VoiceTextAlign}}"
                                                           MaxWidth="{Binding $parent[ItemsControl].MaxWidth}"
                                                           Opacity="{Binding LineOpacity, Converter={StaticResource OpacityFloor}, ConverterParameter=0.3}"
                                                           IsVisible="{Binding ShowLineText}"
                                                           TextWrapping="Wrap"/>

                                                <!-- Word-level karaoke layer -->
                                                <ItemsControl ItemsSource="{Binding Words}"
                                                              Classes="word-layer"
                                                              Classes.active="{Binding IsActive}"
                                                              IsVisible="{Binding ShowWords}"
                                                              Opacity="{Binding LineOpacity, Converter={StaticResource OpacityFloor}, ConverterParameter=0.3}"
                                                              HorizontalAlignment="Left"
                                                              ClipToBounds="False"
                                                              MaxWidth="{Binding $parent[ItemsControl].MaxWidth}"
                                                              ItemTemplate="{StaticResource MiniWordCellTemplate}">
                                                    <ItemsControl.Transitions>
                                                        <Transitions>
                                                            <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseInOut"/>
                                                        </Transitions>
                                                    </ItemsControl.Transitions>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" ItemsAlignment="{Binding Voice, Converter={StaticResource VoiceItemsAlign}}"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>

                                                <!-- Intro dots: first dot sits over the first letter -->
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="4"
                                                            Classes="mini-intro-dots"
                                                            Classes.active="{Binding IsActive}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Margin="4,4,0,4"
                                                            Opacity="{Binding LineOpacity, Converter={StaticResource OpacityFloor}, ConverterParameter=0.3}"
                                                            IsVisible="{Binding IsIntroPlaceholder}">
                                                    <Ellipse Width="5" Height="5" Fill="#8CFFFFFF"/>
                                                    <Ellipse Width="5" Height="5" Fill="#8CFFFFFF"/>
                                                    <Ellipse Width="5" Height="5" Fill="#8CFFFFFF"/>
                                                </StackPanel>
                                            </Panel>

                                            <!-- Background vocals (adlibs): smaller karaoke row -->
                                            <ItemsControl ItemsSource="{Binding BackgroundWords}"
                                                          Classes="word-layer bg-vocals"
                                                          Classes.active="{Binding IsActive}"
                                                          IsVisible="{Binding ShowBackgroundWords}"
                                                          Opacity="{Binding LineOpacity, Converter={StaticResource OpacityFloor}, ConverterParameter=0.3}"
                                                          HorizontalAlignment="{Binding Voice, Converter={StaticResource VoiceAlign}}"
                                                          ClipToBounds="False"
                                                          Margin="0,3,0,0"
                                                          FontSize="{Binding $parent[ItemsControl].FontSize, Converter={StaticResource FontScale}, ConverterParameter=0.6}"
                                                          MaxWidth="{Binding $parent[ItemsControl].MaxWidth}"
                                                          ItemTemplate="{StaticResource MiniWordCellTemplate}">
                                                <ItemsControl.Transitions>
                                                    <Transitions>
                                                        <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseInOut"/>
                                                    </Transitions>
                                                </ItemsControl.Transitions>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" ItemsAlignment="{Binding Voice, Converter={StaticResource VoiceItemsAlign}}"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Composer credit under the last line, like the lyrics page -->
                            <TextBlock Margin="8,18,0,0"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding Lyrics.WrittenByText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><Run Text="Written By: " FontWeight="SemiBold" Foreground="#B3FFFFFF"/><Run Text="{Binding Lyrics.WrittenByText}" Foreground="#80FFFFFF"/></TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Text="No lyrics available"
                               FontSize="13" Foreground="#80FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding HasNoLyrics}"/>
                </Panel>
            </Grid>

            </Panel>

            <!-- ── Drawer sheet (Search / Queue / Volume layers) ──────────────
                 Height is driven by code-behind in lockstep with the window height, so the
                 player area above it never changes size while the card grows. Starts at 0.

                 Liquid glass rather than a solid sheet: the fill is translucent enough that
                 the blurred artwork wash behind RootPanel reads through it, and the top edge
                 carries the same specular hairline as the card's own top rim (L5 above) so
                 the seam looks lit rather than drawn. -->
            <Border x:Name="DrawerSheet"
                    Grid.Row="1"
                    IsVisible="False"
                    Opacity="0"
                    Height="0"
                    ClipToBounds="True"
                    Background="#590B0B11"
                    BorderThickness="0,1,0,0"
                    Padding="12,10,12,12">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Offset="0" Color="#00FFFFFF"/>
                        <GradientStop Offset="0.5" Color="#59FFFFFF"/>
                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.RenderTransform>
                    <TranslateTransform Y="14">
                        <TranslateTransform.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Y" Duration="0:0:0.18">
                                    <DoubleTransition.Easing>
                                        <CubicEaseOut/>
                                    </DoubleTransition.Easing>
                                </DoubleTransition>
                            </Transitions>
                        </TranslateTransform.Transitions>
                    </TranslateTransform>
                </Border.RenderTransform>
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.18">
                            <DoubleTransition.Easing>
                                <CubicEaseOut/>
                            </DoubleTransition.Easing>
                        </DoubleTransition>
                    </Transitions>
                </Border.Transitions>

                <Panel>
                    <!-- Search layer -->
                    <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsSearchDrawer}">
                        <Border Grid.Row="0" Background="#33000000" BorderBrush="#26FFFFFF" BorderThickness="1"
                                CornerRadius="999" Padding="12,7">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Grid.Column="0" Data="{StaticResource SearchIcon}" Width="13" Height="13"
                                          Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="SearchBox" Classes="mini-search"
                                         Text="{Binding SearchQuery, Mode=TwoWay}"
                                         Watermark="Search Library"
                                         Margin="8,0,4,0"/>
                                <Button Grid.Column="2" Classes="mini-transport" Width="20" Height="20"
                                        Command="{Binding ClearSearchCommand}"
                                        IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        ToolTip.Tip="Clear">
                                    <PathIcon Data="{StaticResource DismissIcon}" Width="10" Height="10" Foreground="#99FFFFFF"/>
                                </Button>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:Track">
                                        <Border Classes="mini-row">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8">
                                                    <Panel>
                                                        <Panel.Clip>
                                                            <RectangleGeometry Rect="0,0,36,36" RadiusX="8" RadiusY="8"/>
                                                        </Panel.Clip>
                                                        <controls:CachedImage SourcePath="{Binding AlbumArtworkPath}"
                                                                              DecodeWidth="128" Width="36" Height="36"
                                                                              Stretch="UniformToFill"/>
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Column="1" x:Name="ResultInfoHost"
                                                            VerticalAlignment="Center" Margin="10,0,6,0" Spacing="1">
                                                    <!-- Badge rides the title as marquee InlineContent, the same way every
                                                         form does it. A Grid put the badge at the far end of the text
                                                         column instead of against the title, and a horizontal StackPanel
                                                         would measure at infinite width — killing the ellipsis and letting
                                                         a long title shove the badge out (issue #30). The marquee subtracts
                                                         the badge's width from its own viewport, so the title trims against
                                                         the badge rather than through it. -->
                                                    <controls:MarqueeTextBlock Text="{Binding TitleDisplay}"
                                                                               FontSize="13" FontWeight="SemiBold"
                                                                               Foreground="White"
                                                                               MaxDisplayWidth="{Binding #ResultInfoHost.Bounds.Width}"
                                                                               HorizontalAlignment="Left" IsMiniPlayer="True">
                                                        <controls:MarqueeTextBlock.InlineContent>
                                                            <Border Classes="mini-explicit"
                                                                    IsVisible="{Binding IsExplicit, FallbackValue=False}"
                                                                    ToolTip.Tip="Explicit">
                                                                <TextBlock Text="E" FontSize="9" FontWeight="Bold"
                                                                           VerticalAlignment="Center" TextAlignment="Center"
                                                                           Foreground="Black"/>
                                                            </Border>
                                                        </controls:MarqueeTextBlock.InlineContent>
                                                    </controls:MarqueeTextBlock>
                                                    <TextBlock Text="{Binding ArtistDisplay}" FontSize="11"
                                                               Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="mini-transport" Width="28" Height="28"
                                                        Command="{Binding $parent[Window].((vm:MiniPlayerViewModel)DataContext).PlaySearchResultCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Play">
                                                    <PathIcon Data="{StaticResource PlaySolidIcon}" Width="13" Height="13" Foreground="White"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Queue layer -->
                    <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsQueueDrawer}">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="6,0,6,6">
                            <TextBlock Grid.Column="0" Text="Up Next" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#B3FFFFFF"/>
                            <TextBlock Grid.Column="1" Text="showing first 100" FontSize="10"
                                       Foreground="#66FFFFFF" VerticalAlignment="Center"
                                       IsVisible="{Binding QueuePreviewTruncated}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding QueuePreview}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:Track">
                                        <Border Classes="mini-row">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8">
                                                    <Panel>
                                                        <Panel.Clip>
                                                            <RectangleGeometry Rect="0,0,36,36" RadiusX="8" RadiusY="8"/>
                                                        </Panel.Clip>
                                                        <controls:CachedImage SourcePath="{Binding AlbumArtworkPath}"
                                                                              DecodeWidth="128" Width="36" Height="36"
                                                                              Stretch="UniformToFill"/>
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,6,0" Spacing="1">
                                                    <TextBlock Text="{Binding TitleDisplay}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ArtistDisplay}" FontSize="11"
                                                               Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="mini-transport" Width="28" Height="28"
                                                        Command="{Binding $parent[Window].((vm:MiniPlayerViewModel)DataContext).PlayFromQueueCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Play">
                                                    <PathIcon Data="{StaticResource PlaySolidIcon}" Width="13" Height="13" Foreground="White"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Volume layer -->
                    <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsVolumeDrawer}" Margin="4,6">
                        <Button Grid.Column="0" Classes="mini-transport" Width="26" Height="26"
                                Command="{Binding Player.ToggleMuteCommand}" ToolTip.Tip="Mute">
                            <Panel>
                                <Viewbox Width="13" Height="13" Opacity="0.75" IsVisible="{Binding !Player.IsMuted}">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="White" Data="{StaticResource SpeakerZeroIcon}"/>
                                    </Canvas>
                                </Viewbox>
                                <Viewbox Width="13" Height="13" Opacity="0.55" IsVisible="{Binding Player.IsMuted}">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="White" Data="{StaticResource SpeakerMuteIcon}"/>
                                    </Canvas>
                                </Viewbox>
                            </Panel>
                        </Button>
                        <Slider Grid.Column="1" x:Name="DrawerVolumeSlider" Classes="mini-seek"
                                Minimum="0" Maximum="100" Focusable="False"
                                Value="{Binding Player.Volume, Mode=TwoWay}"
                                Margin="6,0" VerticalAlignment="Center"/>
                        <Viewbox Grid.Column="2" Width="15" Height="15" Opacity="0.75" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White" Data="{StaticResource SpeakerHighIcon}"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Panel>
            </Border>
            </Grid>

            <!-- ── "…" menu popup (shared by every form's more-button). A custom
                 popup instead of a MenuFlyout so open/close play the same fade +
                 scale animation as the Settings modal; anchored to the clicked
                 button and driven from code-behind. ─────────────────────────── -->
            <!-- Light dismiss is off: it unmaps the popup instantly, skipping the close
                 animation. Outside clicks are handled by the window's tunnel handler
                 (and Deactivated) so the close always plays the fade/scale out. -->
            <Popup x:Name="MorePopup"
                   Placement="BottomEdgeAlignedRight"
                   VerticalOffset="6"
                   IsLightDismissEnabled="False"
                   WindowManagerAddShadowHint="False">
                <!-- Chrome follows the app's right-click menus (Styles.axaml's ContextMenu /
                     MenuFlyoutPresenter): the active theme's sidebar background, radius 16,
                     padding 6 — so a custom or light theme carries over here too. -->
                <Border x:Name="MenuCard"
                        Width="176"
                        Background="{DynamicResource AppSidebarBackground}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="6"
                        RenderTransformOrigin="50%,0%"
                        RenderTransform="scale(0.96)"
                        Opacity="0">
                        <!-- No BoxShadow. A popup window is sized to its child's DESIRED
                             size, which does not include a shadow, so the shadow was
                             clipped to the card's own rect — and since the card is rounded,
                             the only place it could still show was the four corner gaps
                             between the rounded card and the square popup surface. That is
                             exactly the dark wedge that appeared at each corner. Restoring
                             a shadow means padding the popup's child so the surface is
                             bigger than the card, then compensating the placement offsets
                             in OnMoreMenuClick by the same padding; the window-manager
                             shadow is not an option either, because it is drawn for the
                             full popup rect and would not follow the open/close scale. -->
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.18">
                                <DoubleTransition.Easing>
                                    <CubicEaseOut/>
                                </DoubleTransition.Easing>
                            </DoubleTransition>
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18">
                                <TransformOperationsTransition.Easing>
                                    <CubicEaseOut/>
                                </TransformOperationsTransition.Easing>
                            </TransformOperationsTransition>
                        </Transitions>
                    </Border.Transitions>
                    <StackPanel Spacing="1">
                        <Button Classes="mini-menu-item" Command="{Binding ToggleSearchDrawerCommand}"
                                Click="OnMenuItemClick">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource SearchIcon}" Width="14" Height="14" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                <TextBlock Text="Search" FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="mini-menu-item" Command="{Binding ToggleQueueDrawerCommand}"
                                Click="OnMenuItemClick">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <!-- Same artwork the playback bar's queue button uses, so the two
                                     read as the same control. PathIcon glyphs made Queue and Lyrics
                                     nearly identical here — both were plain stacks of lines. -->
                                <Border Width="14" Height="14" Background="#D9FFFFFF"
                                        RenderOptions.BitmapInterpolationMode="HighQuality">
                                    <Border.OpacityMask>
                                        <ImageBrush Source="avares://Noctis/Assets/Icons/Queue%20ICON.png" Stretch="Uniform"/>
                                    </Border.OpacityMask>
                                </Border>
                                <TextBlock Text="Queue" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- The large-icon form has its own always-visible volume bar -->
                        <Button Classes="mini-menu-item" Command="{Binding ToggleVolumeDrawerCommand}"
                                Click="OnMenuItemClick"
                                IsVisible="{Binding !IsLargeIconForm}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="14" Height="14" Background="#D9FFFFFF"
                                        RenderOptions.BitmapInterpolationMode="HighQuality">
                                    <Border.OpacityMask>
                                        <ImageBrush Source="avares://Noctis/Assets/Icons/Volume%20ICON.png" Stretch="Uniform"/>
                                    </Border.OpacityMask>
                                </Border>
                                <TextBlock Text="Volume" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Stays in the list while lyrics are open: it is the only way back
                             out of the split view, so hiding it stranded the user there. -->
                        <Button Classes="mini-menu-item" Command="{Binding ToggleLyricsFormCommand}"
                                Click="OnMenuItemClick">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="14" Height="14" Background="#D9FFFFFF"
                                        RenderOptions.BitmapInterpolationMode="HighQuality">
                                    <Border.OpacityMask>
                                        <ImageBrush Source="avares://Noctis/Assets/Icons/Lyrics%20ICON.png" Stretch="Uniform"/>
                                    </Border.OpacityMask>
                                </Border>
                                <TextBlock Text="{Binding LyricsMenuLabel}" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Was the corner badge. No OnMenuItemClick needed: closing the
                             window takes the popup with it. -->
                        <Border Height="1" Margin="8,4"
                                Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
                        <Button Classes="mini-menu-item" Click="OnCloseClick">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource DismissIcon}" Width="14" Height="14" Foreground="#D9FFFFFF"/>
                                <TextBlock Text="Back to full view" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- ── Resize grips (frameless window) ────────────────────────── -->
            <Border Classes="resize-grip" Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Margin="0,12" Cursor="LeftSide" Tag="West" PointerPressed="OnResizeGripPressed"/>
            <Border Classes="resize-grip" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Margin="0,12" Cursor="RightSide" Tag="East" PointerPressed="OnResizeGripPressed"/>
            <Border Classes="resize-grip" Height="6" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    Margin="12,0" Cursor="TopSide" Tag="North" PointerPressed="OnResizeGripPressed"/>
            <Border Classes="resize-grip" Height="6" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Margin="12,0" Cursor="BottomSide" Tag="South" PointerPressed="OnResizeGripPressed"/>
            <Border Classes="resize-grip" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Cursor="TopLeftCorner" Tag="NorthWest" PointerPressed="OnResizeGripPressed"/>
            <Border Classes="resize-grip" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Cursor="TopRightCorner" Tag="NorthEast" PointerPressed="OnResizeGripPressed"/>
            <Border Classes="resize-grip" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Cursor="BottomLeftCorner" Tag="SouthWest" PointerPressed="OnResizeGripPressed"/>
            <Border Classes="resize-grip" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Cursor="BottomRightCorner" Tag="SouthEast" PointerPressed="OnResizeGripPressed"/>
        </Panel>

        <!-- The corner close badge used to live here, outside RootPanel's rounded clip so
             it could overhang the card's outline. It moved into the "…" menu as "Back to
             full view". Two things came back with it: the NorthEast corner's diagonal
             resize, which the badge had been sitting on top of, and the top-right corner
             itself, which the artwork now runs into cleanly. The icon form is unaffected —
             it never used this badge, it hosts its own close inside its hover overlay. -->
        </Panel>
    </Border>

</Window>
