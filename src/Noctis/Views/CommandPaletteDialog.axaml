<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
        xmlns:vm="using:Noctis.ViewModels"
        xmlns:controls="using:Noctis.Controls"
        x:Class="Noctis.Views.CommandPaletteDialog"
        x:DataType="vm:CommandPaletteViewModel"
        Title="{loc:T CommandPalette.CommandPalette}"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False">

    <Window.Styles>
        <!-- The row card paints the states, the ListBoxItem stays clear. The app-wide
             "album grid" rule (Styles.axaml, ListBox:not(.track-list):not(.sidebar)) makes every
             other ListBox's selected and hovered items transparent, so the palette's rows
             showed no selection at all while the arrow keys moved it (Discord 11-21). -->
        <Style Selector="ListBox.palette-list ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBox.palette-list ListBoxItem" x:DataType="vm:PaletteItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
        </Style>
        <Style Selector="ListBox.palette-list ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.palette-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <!-- Hover: the fields' filled tone. Keyboard selection: a step brighter plus the accent
             ring the search pop-ups' selected rows carry (Search Lyrics, Artist info). -->
        <Style Selector="ListBox.palette-list ListBoxItem:pointerover Border.palette-row">
            <Setter Property="Background" Value="{DynamicResource PillFieldBackground}"/>
        </Style>
        <Style Selector="ListBox.palette-list ListBoxItem:selected Border.palette-row">
            <Setter Property="Background" Value="{DynamicResource PillFieldBackgroundPointerOver}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
        </Style>
    </Window.Styles>

    <!-- Click outside the card closes (the card's own clicks stop at PillDialogHost). -->
    <Border Background="Transparent" PointerPressed="OnOverlayPointerPressed">

        <!-- The pop-ups' card: blurred app behind, Liquid Glass while it is on (#234), the open and
             close motion. Anchored in the upper third, Spotlight-style. -->
        <controls:PillDialogHost VerticalContentAlignment="Top"
                                 CardMargin="0,110,0,0">
            <StackPanel Width="600">
                <TextBox x:Name="QueryBox"
                         Classes="pill-field"
                         Text="{Binding Query, Mode=TwoWay}"
                         PlaceholderText="{loc:T CommandPalette.SearchSongsAlbumsArtists}"
                         AutomationProperties.Name="{loc:T CommandPalette.SearchSongsAlbumsArtists}"
                         FontSize="15"
                         Margin="14,14,14,12"/>
                <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
                <!-- Right padding = the scrollbar's lane, as the search pop-ups' result lists. -->
                <ListBox x:Name="ResultsList"
                         Classes="palette-list"
                         ItemsSource="{Binding Results}"
                         SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                         MaxHeight="420"
                         Background="Transparent"
                         Padding="8,6,16,6"
                         KeyboardNavigation.TabNavigation="None">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PaletteItem">
                            <Border Classes="palette-row" PointerReleased="OnItemPointerReleased">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Pages the sidebar draws with a PNG mask use that same mask here. -->
                                    <controls:MaskIcon Grid.Column="0"
                                                       Source="{Binding Mask}"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                       Width="17" Height="17"
                                                       Opacity="0.7"
                                                       Margin="1,0,11,0"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding ShowMaskIcon}"/>
                                    <PathIcon Grid.Column="0"
                                              Data="{Binding Glyph}"
                                              Width="15" Height="15"
                                              Opacity="0.7"
                                              Margin="2,0,12,0"
                                              VerticalAlignment="Center"
                                              IsVisible="{Binding ShowGlyphIcon}"/>
                                    <!-- The menus' line icons (Queue, Lyrics) are strokes: a PathIcon
                                         would fill them into blobs. -->
                                    <controls:LineIcon Grid.Column="0"
                                                       Data="{Binding Glyph}"
                                                       Width="17" Height="17"
                                                       Opacity="0.7"
                                                       Margin="1,0,11,0"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding ShowLineIcon}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.55"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Category}"
                                               FontSize="10" Opacity="0.5"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
                <TextBlock Text="{loc:T CommandPalette.NavigateEnterRunEsc}"
                           FontSize="10" Opacity="0.5"
                           Margin="20,9,20,11"/>
            </StackPanel>
        </controls:PillDialogHost>
    </Border>
</Window>
