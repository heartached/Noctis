<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.ViewModels"
             xmlns:m="using:Noctis.Models"
             xmlns:conv="using:Noctis.Converters"
             xmlns:controls="using:Noctis.Controls"
             xmlns:views="using:Noctis.Views"
             xmlns:helpers="using:Noctis.Helpers"
             x:Class="Noctis.Views.LyricsView"
             x:DataType="vm:LyricsViewModel"
             x:Name="LyricsRoot"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToOpacityConverter x:Key="BoolToOpacity"/>
        <conv:ArtworkPathConverter x:Key="ArtworkConverter"/>
        <conv:ProgressToSweepForegroundConverter x:Key="ProgressToSweepFg"/>
        <conv:EmphasisGlowConverter x:Key="EmphasisGlow"/>
        <conv:WordOverflowPaddingConverter x:Key="WordOverflowPad"/>
        <conv:BlurRadiusToEffectConverter x:Key="BlurToEffect"/>
        <conv:PreBlurredArtworkConverter x:Key="PreBlurArt"/>
        <conv:MetadataLineConverter x:Key="MetadataLine"/>
        <conv:DoubleScaleConverter x:Key="FontScale"/>

        <!-- Duet layout (ELRC v1:/v2:/v3: voice markers): voice 2 lines anchor right,
             group lines center. Same keys exist in LyricsPanelView — keep in sync. -->
        <conv:LyricVoiceToAlignmentConverter x:Key="VoiceAlign"/>
        <conv:LyricVoiceToTextAlignmentConverter x:Key="VoiceTextAlign"/>
        <conv:LyricVoiceToItemsAlignmentConverter x:Key="VoiceItemsAlign"/>
        <conv:LyricVoiceToTransformOriginConverter x:Key="VoiceOrigin"/>
        <conv:DuetMinWidthConverter x:Key="DuetMinWidth"/>

        <!-- Shared karaoke word cell (glow / dimmed base / gradient sweep), used by the
             main word layer and the background-vocal (adlib) layer below it. -->
        <DataTemplate x:Key="WordCellTemplate" x:DataType="m:WordTiming">
            <Panel Classes="word-cell"
                   Classes.current="{Binding IsCurrent}"
                   Classes.emphasis="{Binding IsEmphasis}">
                <!-- DownOnly viewbox: a merged melisma word ("No-o-o-o-…") can outgrow
                     the line MaxWidth, and a WrapPanel cell can't break mid-word — the
                     overflow ran past the line box and was hard-clipped by the button
                     (ClipToBounds, see lyric-line-btn). Scaling the whole cell down
                     keeps glow/base/sweep pixel-aligned; words that fit the constraint
                     render 1:1 as before. -->
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" ClipToBounds="False">
                <Panel>
                <!-- Soft glow under held-note words; fades in via word-glow styles.
                     Hosted in a Canvas so its blur surface can be padded out for the
                     gaussian tail WITHOUT growing the word cell (which would space words
                     apart). A negative Margin does NOT work here: unlike WPF, Avalonia
                     collapses the arrange bounds to the layout slot, so the padded
                     headroom never reaches the effect surface and blur(6) clips into a
                     hard box. The Canvas reports zero desired size and never clips; the
                     glow's Padding gives the blur room and the matching negative offset
                     re-aligns its glyphs onto the base layer. -->
                <Canvas ClipToBounds="False">
                    <TextBlock Text="{Binding Text}"
                               Classes="word-glow"
                               IsVisible="{Binding IsEmphasis}"
                               Canvas.Left="-40"
                               Canvas.Top="-40"
                               Padding="40"
                               FontWeight="Bold"
                               Foreground="{Binding $parent[UserControl].((vm:LyricsViewModel)DataContext).LyricsPrimaryFg}">
                        <!-- Bell envelope over the hold: rises, peaks mid-word, releases —
                             peak scaled by hold length (a 1s hold barely glows, a 4s note
                             blooms). Driven per-frame off Progress, replacing the old
                             class transition that snapped to 0.5 and froze. -->
                        <TextBlock.Opacity>
                            <MultiBinding Converter="{StaticResource EmphasisGlow}">
                                <Binding Path="Progress"/>
                                <Binding Path="HeldDurationMs"/>
                            </MultiBinding>
                        </TextBlock.Opacity>
                    </TextBlock>
                </Canvas>
                <!-- Base layer: full opacity while the line is inactive, dims to a
                     soft ghost under the sweep while active (word-base styles). -->
                <!-- Right padding on line-final words only (see WordOverflowPaddingConverter):
                     the dimmed base composites through a bounds-clipped layer that shears the
                     last glyph of words with no trailing space. Costs no spacing — mid-line
                     words already carry a trailing space and get zero padding. -->
                <TextBlock Text="{Binding Text}"
                           Classes="word-base"
                           Padding="{Binding Text, Converter={StaticResource WordOverflowPad}}"
                           FontWeight="Bold"
                           Foreground="{Binding $parent[UserControl].((vm:LyricsViewModel)DataContext).LyricsPrimaryFg}"/>
                <!-- Bright overlay revealed left-to-right by the Progress sweep, painted
                     as a Foreground gradient — NOT an OpacityMask: the mask's compositor
                     layer captured the sibling glow (multiplied it by the sweep and
                     clipped it at the overlay bounds → hard box around emphasis words).
                     SweepText + Left alignment shrink the gradient's domain to the glyphs:
                     with the trailing space included, the edge spent the tail of every
                     word's duration crossing invisible whitespace (per-word stall). -->
                <TextBlock Text="{Binding SweepText}"
                           HorizontalAlignment="Left"
                           FontWeight="Bold">
                    <TextBlock.Foreground>
                        <MultiBinding Converter="{StaticResource ProgressToSweepFg}">
                            <Binding Path="Progress"/>
                            <Binding Path="$parent[UserControl].((vm:LyricsViewModel)DataContext).LyricsPrimaryFg"/>
                            <!-- Layout width + font size → constant ~0.25em feather, so
                                 narrow tokens (single CJK cells) get a soft edge too. -->
                            <Binding Path="Bounds.Width" RelativeSource="{RelativeSource Self}"/>
                            <Binding Path="FontSize" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </TextBlock.Foreground>
                </TextBlock>
                </Panel>
                </Viewbox>
            </Panel>
        </DataTemplate>
        <!-- Adaptive button/slider brushes (updated from code-behind) -->
        <SolidColorBrush x:Key="LyricsBtnBgRes" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="LyricsBtnBgHoverRes" Color="#55FFFFFF"/>
        <SolidColorBrush x:Key="LyricsSecBtnBgRes" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="LyricsSecBtnBgHoverRes" Color="#33FFFFFF"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Explicit badge -->
        <Style Selector="Border.lyrics-explicit">
            <Setter Property="Background" Value="#88888888"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Clickable text style -->
        <Style Selector="Button.link-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.link-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="Button.link-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>
        <Style Selector="Button.link-btn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>

        <!-- Play/Pause prominent button -->
        <Style Selector="Button.lyrics-play-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.lyrics-play-btn:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.lyrics-play-btn:pressed">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.lyrics-play-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.lyrics-play-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Pill button style -->
        <Style Selector="Button.pill-btn">
            <Setter Property="Background" Value="{DynamicResource LyricsBtnBgRes}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.pill-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource LyricsBtnBgHoverRes}"/>
        </Style>

        <!-- Color picker circle button -->
        <Style Selector="Button.icon-circle-btn">
            <Setter Property="Background" Value="{DynamicResource LyricsBtnBgRes}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.icon-circle-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource LyricsBtnBgHoverRes}"/>
        </Style>

        <!-- Color swatch button — fully transparent template, no box behind circle -->
        <Style Selector="Button.swatch-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.swatch-btn:pointerover">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <Style Selector="Button.swatch-btn:pressed">
            <Setter Property="Opacity" Value="0.65"/>
        </Style>

        <!-- Secondary control button (bottom row) -->
        <Style Selector="Button.lyrics-secondary-btn">
            <Setter Property="Background" Value="{DynamicResource LyricsSecBtnBgRes}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#BBBBBB"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.lyrics-secondary-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource LyricsSecBtnBgHoverRes}"/>
        </Style>

        <!-- AMLL-style active-line presentation: inactive lines sit at 0.96× and the
             active line grows to natural size (same visual zoom as scaling up, but
             nothing ever renders outside its layout bounds, so the viewport can't
             clip the grown line at the right edge). Origin pinned to the left edge
             so text grows in place instead of drifting. No translate: the active
             line used to lift 2px as well, which read as the lyric hopping up while
             it was sung. -->
        <Style Selector="Button.lyric-line-btn">
            <Setter Property="RenderTransformOrigin" Value="0,0.5"/>
            <Setter Property="RenderTransform" Value="scale(0.96)"/>
            <!-- Button defaults to ClipToBounds=True, which hard-clips anything the
                 word layer renders past the line's layout box: the emphasis swell
                 (1.04, centre origin) nibbled edge glyphs of full-width melisma words
                 and the held-note glow spill got boxed. Verified via headless render:
                 the button is the clipper, not the ScrollViewer or OpacityMask. -->
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Transitions">
                <Transitions>
                    <!-- Same curve and length as the scroll glide (LineMotion): the line
                         grows WHILE the list moves, one motion — a faster spring here
                         popped the line to full size before the glide had visibly
                         started. Duration is pinned to LineMotion.DurationMs by test. -->
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.65">
                        <TransformOperationsTransition.Easing>
                            <helpers:LineMotionEase/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.lyric-line-btn.active">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <!-- No hover/press box on lyric lines: the line stays clickable (Cursor=Hand
             on the button) but reads as text, not as a button. -->
        <Style Selector="Button.lyric-line-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.lyric-line-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Suppress global hover-scale on lyric lines (match the resting transforms). -->
        <Style Selector="ItemsControl#LyricsItemsControl Button:pointerover">
            <Setter Property="RenderTransform" Value="scale(0.96)"/>
        </Style>
        <Style Selector="ItemsControl#LyricsItemsControl Button.lyric-line-btn.active:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>

        <!-- Regular words do NOT move as they are sung — the sweep is the cue, as in
             Apple Music. (They used to lift 1px and grow 1% each, a chain of small
             hops on every fast passage.) Only held-note emphasis words swell below. -->
        <Style Selector="Panel.word-cell">
            <Setter Property="RenderTransformOrigin" Value="0.5,1"/>
            <Setter Property="RenderTransform" Value="translate(0px,0px) scale(1)"/>
        </Style>

        <!-- Held-note emphasis (Apple Music style): long words swell slowly while sung
             and ease back just as gently, with a soft glow that fades in underneath.
             The longer transition here replaces the quick 0.22s one from word-cell. -->
        <Style Selector="Panel.word-cell.emphasis">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.8" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.word-cell.emphasis.current">
            <!-- 1.04 / blur(6): the swell and glow spill past the line's layout bounds;
                 in narrow mode lines wrap flush against the ScrollViewer's content edge,
                 so the spill must stay under the viewer's right padding or it clips. -->
            <Setter Property="RenderTransform" Value="translate(0px,-2px) scale(1.04)"/>
        </Style>
        <!-- Glow opacity is bound per-frame in the template (EmphasisGlowConverter
             bell over the hold). No Opacity setter or transition here: a transition
             would low-pass the per-frame values and lag the vocal. -->
        <Style Selector="TextBlock.word-glow">
            <Setter Property="Effect" Value="blur(6)"/>
        </Style>

        <!-- Word base layer: full brightness on inactive lines (matches plain line text),
             fades to a soft ghost while the line is active so the sweep reads on top. -->
        <Style Selector="ItemsControl.word-layer TextBlock.word-base">
            <Setter Property="Opacity" Value="1.0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ItemsControl.word-layer.active TextBlock.word-base">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <!-- Lyric line: keep active emphasis in opacity/color only, without size/position zoom. -->
        <Style Selector="TextBlock.lyric-line">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Lyrics scrollbar -->
        <Style Selector="ScrollViewer#LyricsScrollViewer /template/ ScrollBar:vertical">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,8,3,8"/>
        </Style>
        <Style Selector="ScrollViewer#LyricsScrollViewer /template/ ScrollBar:vertical /template/ Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ScrollViewer#LyricsScrollViewer /template/ ScrollBar:vertical /template/ Thumb">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinHeight" Value="24"/>
        </Style>
        <Style Selector="ScrollViewer#LyricsScrollViewer /template/ ScrollBar:vertical /template/ Thumb:pointerover">
            <Setter Property="Background" Value="#66FFFFFF"/>
        </Style>
        <Style Selector="ScrollViewer#LyricsScrollViewer /template/ ScrollBar:vertical /template/ RepeatButton">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Height" Value="0"/>
        </Style>
        <Style Selector="ScrollViewer#LyricsScrollViewer /template/ ScrollBar:vertical /template/ Rectangle">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- Karaoke word styles (Lyricsfile word-level sync) -->
        <Style Selector="TextBlock.word">
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.word.past">
            <Setter Property="Opacity" Value="1.0"/>
        </Style>
        <Style Selector="TextBlock.word.current">
            <!-- Base layer goes invisible while the accent overlay renders on top. -->
            <Setter Property="Opacity" Value="0.0"/>
        </Style>
        <Style Selector="TextBlock.word-accent">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.word-accent.current">
            <Setter Property="Opacity" Value="1.0"/>
        </Style>

        <Style Selector="Slider.lyrics-timeline-slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding LyricsSliderFilled}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <!-- Row/column definitions are fixed; wide vs narrow mode is expressed purely
         through Grid.Row/Column/Span attached properties from code-behind. -->
    <Grid x:Name="MainLayoutGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,*"
          Background="{Binding FullBackgroundBrush}">
        <!-- AMLL/Apple-Music–style background: heavily-blurred album cover filling the page.
             A subtle scrim on top keeps lyric text legible against bright art. -->
        <Grid x:Name="LyricsBlurBackdrop"
              Grid.ColumnSpan="2"
              Grid.RowSpan="2"
              ZIndex="-1"
              ClipToBounds="True"
              IsHitTestVisible="False"
              IsVisible="{Binding IsColorModeArtwork}">
            <!-- Pre-blurred ONCE per artwork (PreBlurredArtworkConverter): a live
                 BlurEffect here was re-executed every rendered frame, and during the
                 line-change scroll glide two stacked fullscreen radius-72 gaussians
                 dropped the whole page to ~25fps on software rendering / weak GPUs
                 (issue #11). Player.AlbumArt (the mini-player's in-memory 768px
                 bitmap) paints synchronously on page mount, and after this much blur
                 a higher-res source adds nothing — so the old hi-res CachedImage
                 layer is gone entirely. -->
            <!-- Pulse host: FlowingArtworkAnimator breathes this whole stack about its
                 centre on every beat (BeatMeter) and drifts/rotates the two extra copies
                 below, so the background keeps the artwork's own colours — the old
                 palette-tinted blobs recoloured the whole page when the toggle went on. -->
            <Panel x:Name="FlowBackdrop">
                <Image Source="{Binding Player.AlbumArt, Converter={StaticResource PreBlurArt}}"
                Stretch="UniformToFill"
                RenderOptions.BitmapInterpolationMode="HighQuality"
                IsVisible="{Binding Player.AlbumArt, Converter={x:Static ObjectConverters.IsNotNull}}">
                <!-- Gentle outward scale so blur edges never reveal the underlying solid fill. -->
                <Image.RenderTransform>
                <ScaleTransform ScaleX="1.18" ScaleY="1.18"/>
                </Image.RenderTransform>
                </Image>
                <!-- Flowing-artwork layer (issue #22): two more copies of the same
                     pre-blurred cover slowly rotate in opposite directions over the static
                     one. Transform/opacity only — no live blur, no layout, so a frame is a
                     handful of property writes on the compositor's own clock. -->
                <Panel x:Name="FlowLayerHost" IsHitTestVisible="False"
                       IsVisible="{Binding Player.LyricsFlowingLightEnabled}">
                    <Image x:Name="FlowLayer1"
                           Source="{Binding Player.AlbumArt, Converter={StaticResource PreBlurArt}}"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           Opacity="0.5"/>
                    <Image x:Name="FlowLayer2"
                           Source="{Binding Player.AlbumArt, Converter={StaticResource PreBlurArt}}"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           Opacity="0.36"/>
                </Panel>
            </Panel>
            <!-- Beat glow: a white wash the animator lifts for a few frames on each beat. -->
            <Rectangle x:Name="BeatGlow" Fill="White" Opacity="0" IsHitTestVisible="False"
                       IsVisible="{Binding Player.LyricsFlowingLightEnabled}"/>
            <!-- Dark scrim: drops the cover's brightness so white lyrics stay readable.
                 Kept strong enough that bright/near-white covers don't bleed a light
                 halo around the title/artist/album text. -->
            <Rectangle Fill="#99000000"/>
        </Grid>

        <!-- Optional looping video/GIF background (Settings → Appearance → Lyrics
             Background Video). Sits over the artwork backdrop (same ZIndex, later in
             document order) so the blurred cover stays visible until the first decoded
             frame lands — no black flash. Its own scrim keeps the lyrics legible on
             bright clips. Decoding runs only while this page is attached and the window
             isn't minimized (VideoBackdrop). -->
        <Grid x:Name="LyricsMediaBackdrop"
              Grid.ColumnSpan="2"
              Grid.RowSpan="2"
              ZIndex="-1"
              ClipToBounds="True"
              IsHitTestVisible="False"
              IsVisible="{Binding Player.LyricsBackgroundMediaPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <controls:VideoBackdrop x:Name="MediaBackdrop"
                                    Source="{Binding Player.LyricsBackgroundMediaPath}"
                                    IsActive="{Binding $self.IsVisible}" />
            <Rectangle Fill="#8C000000"/>
        </Grid>

        <!-- Live audio visualizer (Settings → Appearance → Audio Visualizer): the spectrum
             of what is being heard, drawn along the bottom of the page over every background
             mode and under the lyrics. Reads SpectrumMeter, which the output chains feed
             from the same post-gain tap as the beat pulse; runs only while this page is
             visible and the toggle is on (SpectrumVisualizer parks itself otherwise). -->
        <controls:SpectrumVisualizer x:Name="LyricsSpectrum"
                                     Grid.ColumnSpan="2"
                                     Grid.RowSpan="2"
                                     ZIndex="-1"
                                     VerticalAlignment="Bottom"
                                     Height="220"
                                     Margin="24,0,24,0"
                                     Opacity="0.55"
                                     IsHitTestVisible="False"
                                     Fill="White"
                                     ArtworkColor="{Binding Player.ArtworkAccentColor}"
                                     UseArtworkColor="{Binding Player.LyricsVisualizerArtworkColor}"
                                     StyleName="{Binding Player.LyricsVisualizerStyle}"
                                     IsActive="{Binding $self.IsVisible}"
                                     IsVisible="{Binding Player.LyricsVisualizerEnabled}"/>


        <!-- ══════════════════════════════════════════════════════ -->
        <!-- LEFT PANEL: Cover Art + Track Info + Controls         -->
        <!-- ══════════════════════════════════════════════════════ -->
        <Border x:Name="LeftPanel"
                Grid.Column="0"
                Grid.RowSpan="2"
                Background="Transparent"
                Padding="48,42">
            <StackPanel x:Name="LeftContentStack" VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        ClipToBounds="False"
                        Width="760">
                <!-- No size transitions here: code-behind sizes the cover/stack/lyrics
                     from the window on attach and resize, and any transition turned
                     those instant layout snaps into a visible grow/zoom every time the
                     page opened or the window was minimized/maximized. -->

                <!-- Header: cover + track info. Wide mode stacks them (cover centered
                     above the text); narrow mode flips to a compact row (small cover
                     beside left-aligned text) via attached properties from code-behind,
                     so the header never eats a short window's height. -->
                <Grid x:Name="HeaderGrid" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <!-- Album Art -->
                <Border x:Name="AlbumArtBorder"
                        Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        Width="630" Height="630"
                        HorizontalAlignment="Center">
                    <!-- The cover, or the same art on a CD / vinyl sleeve / cassette
                         (Appearance → Now Playing Artwork). The control owns the corner
                         radius, clip and shadow: a spinning disc cannot sit inside a
                         square shadow, so this Border is only the sizing box that the
                         code-behind drives (Width/Height/Margin/alignment).
                         FallbackSource is the mini-player's already-decoded 768px bitmap:
                         it prevents the gray placeholder flashing between page-attach and
                         the 1280px CachedImage decode. -->
                    <controls:MediaArtwork
                        SourcePath="{Binding Player.CurrentTrack.AlbumArtworkPath}"
                        FallbackSource="{Binding Player.AlbumArt}"
                        DecodeWidth="1280"
                        AnimatedSource="{Binding Player.CurrentAnimatedCoverPath}"
                        AnimatedActive="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Settings.EnableAnimatedCovers, FallbackValue=False}"
                        Medium="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Settings.NowPlayingArtworkMedium, FallbackValue={x:Static m:ArtworkMedium.Cover}}"
                        IsSpinning="{Binding Player.IsPlaying}"
/>
                </Border>

                <!-- Track Info -->
                <StackPanel x:Name="TrackInfoStack"
                            Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                            Spacing="4" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <!-- Title + Explicit badge -->
                    <controls:MarqueeTextBlock x:Name="TitleMarquee"
                                               Text="{Binding Player.CurrentTrack.Title, FallbackValue='No track playing'}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="{Binding LyricsPrimaryFg}"
                                               MaxDisplayWidth="520"
                                               HorizontalAlignment="Center"
                                               IsLyricsPage="True"
                                               IsForArtist="False">
                        <controls:MarqueeTextBlock.InlineContent>
                            <Border Classes="lyrics-explicit"
                                    IsVisible="{Binding Player.CurrentTrack.IsExplicit, FallbackValue=False}"
                                    ToolTip.Tip="Explicit">
                                <TextBlock Text="E"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{Binding LyricsPrimaryFg}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </controls:MarqueeTextBlock.InlineContent>
                    </controls:MarqueeTextBlock>

                    <!-- Artist -->
                    <Button x:Name="ArtistLinkButton"
                            Classes="link-btn"
                            Command="{Binding ViewArtistCommand}"
                            HorizontalAlignment="Center">
                        <controls:MarqueeTextBlock x:Name="ArtistMarquee"
                                                   Text="{Binding Player.CurrentTrack.Artist, FallbackValue=''}"
                                                   FontSize="17"
                                                   Foreground="{Binding LyricsAccentFg}"
                                                   MaxDisplayWidth="520"
                                                   IsLyricsPage="True"
                                                   IsForArtist="True"/>
                    </Button>

                    <!-- Album -->
                    <Button x:Name="AlbumLinkButton"
                            Classes="link-btn"
                            Command="{Binding ViewAlbumCommand}"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding Player.CurrentTrack.Album, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <controls:MarqueeTextBlock x:Name="AlbumMarquee"
                                                   Text="{Binding Player.CurrentTrack.Album, FallbackValue=''}"
                                                   FontSize="14"
                                                   Foreground="{Binding LyricsAccentFg}"
                                                   MaxDisplayWidth="520"
                                                   IsLyricsPage="True"
                                                   IsForArtist="True"/>
                    </Button>

                <!-- Genre · Year · Tracks · Lossless info (inside the info stack;
                     Spacing 4 + Margin 4 preserves the previous 8px gap) -->
                <StackPanel x:Name="MetadataRow"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            MaxWidth="560"
                            Spacing="0"
                            Margin="0,4,0,0"
                            ClipToBounds="True"
                            IsVisible="{Binding Player.CurrentTrack, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock FontSize="12" Foreground="{Binding LyricsSubtleFg}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <TextBlock.Text>
                            <!-- MetadataLine skips empty segments: untagged files (no genre/year)
                                 otherwise render a stray leading "· 2018 · 24 tracks" dot. -->
                            <MultiBinding Converter="{StaticResource MetadataLine}" ConverterParameter="track">
                                <Binding Path="Player.CurrentTrack.Genre" FallbackValue=""/>
                                <Binding Path="Player.CurrentTrack.Year" FallbackValue="0"/>
                                <Binding Path="Player.CurrentTrack.TrackCount" FallbackValue="0"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text=" · "
                               FontSize="12"
                               Foreground="{Binding LyricsSubtleFg}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding Player.CurrentTrack.AudioQualityBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center"
                                IsVisible="{Binding Player.CurrentTrack.AudioQualityBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <ToolTip.Tip>
                            <StackPanel Width="220" Spacing="4">
                                <TextBlock Text="{Binding Player.CurrentTrack.AudioQualityBadge}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                <TextBlock Text="{Binding Player.CurrentTrack.AudioQualityDetailedInfo}"
                                           FontSize="12"
                                           Opacity="0.9"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBlock Text="{Binding Player.CurrentTrack.AudioQualityDescription, FallbackValue=''}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Opacity="0.85"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </ToolTip.Tip>
                        <Viewbox Width="16" Height="11" VerticalAlignment="Center" Margin="0,1,0,0">
                            <!-- Match the adjacent "Lossless" label colour so the badge reads as one
                                 inline element instead of an icon-plus-label with mismatched tones.
                                 No Opacity here — it would dim the icon relative to the text. -->
                            <Path Data="M8.184,0.35C9.944,0.35 10.703,3.296 11.338,5.238C11.673,3.842 11.497,3.542 11.857,3.542C11.99,3.542 12.126,3.633 12.126,3.798C12.126,3.809 12.123,3.839 12.117,3.883L12.091,4.058C12.02,4.522 11.845,5.494 11.654,6.144C13.198,10.191 14.345,4.861 14.474,3.772C14.493,3.615 14.612,3.542 14.731,3.542C14.891,3.542 15.022,3.662 14.997,3.843C14.72,5.605 14.295,8.35 12.547,8.35C11.582,8.35 11.04,7.595 10.611,6.73C9.54,4.626 9.047,1.093 7.997,1.093C7.66,1.093 7.411,1.444 7.394,1.444C7.362,1.444 7.337,1.301 7.023,0.909C7.322,0.567 7.734,0.35 8.184,0.35ZM2.458,0.354C5.211,0.354 5.456,7.618 7.014,7.618C7.197,7.618 7.394,7.507 7.61,7.256C7.729,7.458 7.851,7.638 7.978,7.796C7.667,8.151 7.28,8.35 6.795,8.35C5.054,8.349 4.306,5.434 3.663,3.466C3.511,4.097 3.432,4.669 3.402,4.925C3.382,5.088 3.263,5.163 3.143,5.163C3.009,5.163 2.874,5.071 2.874,4.908L2.874,4.908L2.877,4.87C2.966,4.223 3.146,3.243 3.347,2.56C3.079,1.858 2.745,1.091 2.252,1.091C1.257,1.091 0.687,3.591 0.527,4.925C0.508,5.088 0.388,5.163 0.268,5.163C0.135,5.163 0,5.071 0,4.908C0,4.896 0.001,4.883 0.002,4.87C0.283,2.836 0.808,0.354 2.458,0.354ZM5.315,0.35C5.809,0.35 6.339,0.608 6.797,1.211C6.822,1.241 7.078,1.639 7.159,1.777C8.277,3.802 8.818,7.627 9.881,7.627C10.065,7.627 10.264,7.513 10.484,7.256C10.604,7.458 10.726,7.638 10.852,7.796C10.542,8.15 10.155,8.35 9.67,8.35C6.933,8.349 6.636,1.09 5.128,1.09C4.788,1.09 4.536,1.444 4.519,1.444C4.487,1.444 4.462,1.301 4.148,0.909C4.455,0.558 4.87,0.35 5.315,0.35Z"
                                  Fill="{Binding LyricsSubtleFg}" />
                        </Viewbox>
                        <TextBlock Text="{Binding Player.CurrentTrack.AudioQualityBadge}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding LyricsSubtleFg}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Favorite heart inline (only for singles) -->
                    <TextBlock Text=" · "
                               FontSize="12"
                               Foreground="{Binding LyricsSubtleFg}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding ShowMetadataFavoriteHeart}" />
                    <controls:HeartIcon Size="12" ShowWhenOff="False"
                                        VerticalAlignment="Center"
                                        IsFavorite="{Binding ShowMetadataFavoriteHeart}"/>
                </StackPanel>
                </StackPanel>
                </Grid>

                <Grid x:Name="LyricsTimeline"
                      Margin="0,14,0,0"
                      RowDefinitions="Auto,24"
                      IsVisible="{Binding Player.CurrentTrack, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Player.PositionText}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding LyricsSubtleFg}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Player.RemainingTimeText}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding LyricsSubtleFg}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                    </Grid>

                    <Grid Grid.Row="1"
                          Height="24"
                          ClipToBounds="False">
                        <Canvas Height="24"
                                ClipToBounds="False"
                                IsHitTestVisible="False">
                            <Border x:Name="LyricsTimelineTrackBackground"
                                    Height="7"
                                    CornerRadius="3.5"
                                    Background="{Binding LyricsSliderUnfilled}"
                                    Canvas.Top="8.5"/>
                            <Border x:Name="LyricsTimelineTrackFill"
                                    Height="7"
                                    CornerRadius="3.5"
                                    Background="{Binding LyricsAccentFg}"
                                    Canvas.Top="8.5"/>
                            <Border x:Name="LyricsTimelineThumb"
                                    Width="16"
                                    Height="16"
                                    CornerRadius="8"
                                    Background="{Binding LyricsAccentFg}"
                                    BoxShadow="0 2 5 0 #40000000"
                                    Canvas.Top="4"/>
                        </Canvas>
                        <Slider x:Name="LyricsTimelineSlider"
                                Classes="lyrics-timeline-slider"
                                Value="{Binding Player.PositionFraction, Mode=TwoWay}"
                                Minimum="0"
                                Maximum="1"
                                Focusable="False"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <!-- Lyrics-page playback controls; timeline and track metadata live above. -->
                <views:PlaybackBarView DataContext="{Binding Player}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,12,0,0"/>

                <!-- Hidden host button anchoring the background-color flyout -->
                <Button x:Name="LyricsColorPickerHost"
                        Width="1" Height="1"
                        Opacity="0"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,2,0,0">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <Flyout.FlyoutPresenterTheme>
                                <ControlTheme TargetType="FlyoutPresenter" BasedOn="{StaticResource {x:Type FlyoutPresenter}}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="CornerRadius" Value="0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="MaxWidth" Value="9999"/>
                                    <!-- Suppress the built-in ScrollViewer's scrollbars; the picker is a
                                         pill that should never show a track on either axis. -->
                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                                </ControlTheme>
                            </Flyout.FlyoutPresenterTheme>
                            <Border x:Name="ColorPickerContent"
                                    Background="#EE141414" CornerRadius="999" Padding="6,5"
                                    BorderBrush="#22FFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            DataContext="{Binding #LyricsRoot.DataContext}"
                                            x:DataType="vm:LyricsViewModel">

                                    <!-- Artwork / Solid / Gradient toggle -->
                                    <Border Background="#18FFFFFF" CornerRadius="999" Padding="2"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="1">
                                            <Button Command="{Binding SelectColorModeArtworkCommand}"
                                                    Background="Transparent"
                                                    BorderThickness="0" Padding="8,3" CornerRadius="999" Cursor="Hand"
                                                    Opacity="{Binding IsColorModeArtwork, Converter={StaticResource BoolToOpacity}}"
                                                    ToolTip.Tip="Show blurred album artwork as background">
                                                <TextBlock Text="Artwork" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                            </Button>
                                            <Button Command="{Binding SelectColorModeSolidCommand}"
                                                    Background="Transparent"
                                                    BorderThickness="0" Padding="8,3" CornerRadius="999" Cursor="Hand"
                                                    Opacity="{Binding IsColorModeSolid, Converter={StaticResource BoolToOpacity}}">
                                                <TextBlock Text="Solid" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                            </Button>
                                            <Button Command="{Binding SelectColorModeGradientCommand}"
                                                    Background="Transparent"
                                                    BorderThickness="0" Padding="8,3" CornerRadius="999" Cursor="Hand"
                                                    Opacity="{Binding IsColorModeGradient, Converter={StaticResource BoolToOpacity}}">
                                                <TextBlock Text="Gradient" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Divider between mode toggle and swatches; hidden in Artwork mode
                                         where no swatches follow, otherwise it reads as a trailing scrollbar. -->
                                    <Border Width="1" Height="16" Background="#30FFFFFF" VerticalAlignment="Center"
                                            IsVisible="{Binding IsColorModeArtwork, Converter={x:Static BoolConverters.Not}}"/>

                                    <!-- Solid swatches -->
                                    <ScrollViewer x:Name="SolidSwatchScroller"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  MaxWidth="280"
                                                  IsVisible="{Binding IsColorModeSolid}">
                                        <ItemsControl ItemsSource="{Binding SolidSwatches}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ColorSwatch">
                                                    <Button Classes="swatch-btn"
                                                            Command="{Binding $parent[UserControl].((vm:LyricsViewModel)DataContext).SetBackgroundColorCommand}"
                                                            CommandParameter="{Binding Key}"
                                                            ToolTip.Tip="{Binding Name}">
                                                        <Panel>
                                                            <Border Width="20" Height="20" CornerRadius="10"
                                                                    Background="{Binding Preview}"
                                                                    BorderBrush="#33FFFFFF" BorderThickness="1"/>
                                                            <TextBlock Text="A" FontSize="8" FontWeight="Bold"
                                                                       Foreground="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsAuto}"/>
                                                        </Panel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Gradient swatches -->
                                    <ScrollViewer x:Name="GradientSwatchScroller"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  MaxWidth="280"
                                                  IsVisible="{Binding IsColorModeGradient}">
                                        <ItemsControl ItemsSource="{Binding GradientSwatches}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ColorSwatch">
                                                    <Button Classes="swatch-btn"
                                                            Command="{Binding $parent[UserControl].((vm:LyricsViewModel)DataContext).SetBackgroundColorCommand}"
                                                            CommandParameter="{Binding Key}"
                                                            ToolTip.Tip="{Binding Name}">
                                                        <Border Width="20" Height="20" CornerRadius="10"
                                                                Background="{Binding Preview}"
                                                                BorderBrush="#33FFFFFF" BorderThickness="1"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Bottom action row: Alternate source + save status (Share moved into player-bar ⋯ menu) -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Margin="0,24,0,0">
                    <!-- Switch to alternate lyrics source -->
                    <Button Classes="pill-btn"
                            Padding="10,5"
                            Height="30" MinHeight="30"
                            IsVisible="{Binding HasAlternateLyrics}"
                            Command="{Binding SwitchToAlternateLyricsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{StaticResource AttachIcon}"
                                     Width="12" Height="12" Foreground="{Binding LyricsPrimaryFg}"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AlternateLyricsLabel}" FontSize="11" Foreground="{Binding LyricsPrimaryFg}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Save status text -->
                    <TextBlock Text="{Binding SaveStatusText}"
                               FontSize="11"
                               Foreground="{Binding LyricsSubtleFg}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding SaveStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- RIGHT PANEL: Lyrics Column                           -->
        <!-- ══════════════════════════════════════════════════════ -->
        <Grid x:Name="RightPanel" Grid.Column="1" Grid.RowSpan="2"
              RenderTransformOrigin="0.5,0.5">
            <!-- No RenderTransform transition: the wide-mode 1.1x scale is applied
                 by code-behind on attach/resize; a transition made it zoom in every
                 time the page opened or the window was minimized/maximized. -->

            <!-- (Color picker moved to left panel bottom) -->

            <!-- Search Lyrics Button (when no lyrics) — frosted pill so it sits
                 naturally on the blurred-artwork backdrop like the other
                 lyrics-page pills. -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="-50,0,0,0"
                        Spacing="14"
                        IsVisible="{Binding ShowSearchButton}"
                        ZIndex="3">
                <TextBlock Text="{Binding SearchFailedMessage}"
                           FontSize="14"
                           Foreground="{Binding LyricsSubtleFg}"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding SearchFailedMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <Button Classes="pill-btn"
                        Padding="20,9"
                        CornerRadius="22"
                        Command="{Binding SearchLyricsCommand}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="Search Lyrics"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </Button>
            </StackPanel>

            <!-- Searching indicator: three staggered pulsing dots + label -->
            <StackPanel x:Name="SearchingIndicator"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="-50,0,0,0"
                        Spacing="14"
                        IsVisible="{Binding IsSearching}"
                        ZIndex="3">
                <StackPanel.Styles>
                    <!-- Animations keyed on [IsVisible=True] so they only run while
                         searching (same pattern as the previous pulse text). -->
                    <Style Selector="StackPanel#SearchingIndicator[IsVisible=True] Ellipse.dot1">
                        <Style.Animations>
                            <Animation Duration="0:0:0.9" IterationCount="INFINITE"
                                       Easing="SineEaseInOut" PlaybackDirection="Alternate">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0.25"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                    <Style Selector="StackPanel#SearchingIndicator[IsVisible=True] Ellipse.dot2">
                        <Style.Animations>
                            <Animation Duration="0:0:0.9" Delay="0:0:0.2" IterationCount="INFINITE"
                                       Easing="SineEaseInOut" PlaybackDirection="Alternate">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0.25"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                    <Style Selector="StackPanel#SearchingIndicator[IsVisible=True] Ellipse.dot3">
                        <Style.Animations>
                            <Animation Duration="0:0:0.9" Delay="0:0:0.4" IterationCount="INFINITE"
                                       Easing="SineEaseInOut" PlaybackDirection="Alternate">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0.25"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </StackPanel.Styles>
                <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                    <Ellipse Classes="dot1" Width="9" Height="9" Fill="{Binding LyricsPrimaryFg}" Opacity="0.25"/>
                    <Ellipse Classes="dot2" Width="9" Height="9" Fill="{Binding LyricsPrimaryFg}" Opacity="0.25"/>
                    <Ellipse Classes="dot3" Width="9" Height="9" Fill="{Binding LyricsPrimaryFg}" Opacity="0.25"/>
                </StackPanel>
                <TextBlock Text="Searching for Lyrics"
                           FontSize="14"
                           Foreground="{Binding LyricsSubtleFg}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Opacity-masked lyrics container.
                 ClipToBounds=False so the active line's 1.07× scale doesn't get hard-clipped
                 on the right edge ("…GOA" → "…GOAT"). Vertical clipping still handled by the
                 ScrollViewer below; the OpacityMask handles the soft top/bottom fade. -->
            <Border x:Name="LyricsContentHost"
                    ClipToBounds="False"
                    VerticalAlignment="Stretch"
                    Margin="0,20,0,20">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                        <GradientStop Color="#A0FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#E0FFFFFF" Offset="0.06"/>
                        <GradientStop Color="#FFFFFFFF" Offset="0.15"/>
                        <GradientStop Color="#FFFFFFFF" Offset="0.80"/>
                        <GradientStop Color="#E0FFFFFF" Offset="0.93"/>
                        <GradientStop Color="#A0FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.OpacityMask>

                <ScrollViewer x:Name="LyricsScrollViewer"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,0,48,0">
                    <!-- Scroll content = lyric lines + the Written-By footer, one extent.
                         The ItemsControl stays this panel's FIRST child at Y=0 with no
                         header above it: the anchor math (TryComputeAnchorOffset and the
                         jump path) converts item-panel coordinates to extent space as
                         panel Y + LyricsItemsControl.Margin.Top, which only holds while
                         nothing precedes the ItemsControl. The run-out bottom pad lives
                         on this wrapper (UpdateLyricsCenterPadding) so the footer sits
                         just after the last line, before the empty run-out. -->
                    <StackPanel x:Name="LyricsScrollContent" ClipToBounds="False">
                    <!-- FontSize set here (and adjusted from code-behind per window size)
                         is inherited by the lyric-line and karaoke TextBlocks below. -->
                    <!-- ClipToBounds=False here, on the word-layer ItemsControl and on the
                         word-cell Viewbox below: all three clip by default and each one
                         hard-cuts the active word's 1.04 emphasis swell (and the glow
                         spill) at its own box. Verified per-element via headless render
                         bisect; the ScrollViewer still provides the viewport clip. -->
                    <ItemsControl ItemsSource="{Binding ActiveLyricLines}"
                                  x:Name="LyricsItemsControl"
                                  MaxWidth="640"
                                  FontSize="46"
                                  ClipToBounds="False"
                                  HorizontalAlignment="Left">
                        <!-- No MaxWidth transition: width is set from the window on
                             attach/resize and a transition animated the lyric column
                             width on every open and minimize/maximize. -->
                        <!-- Duet files pin the column to full MaxWidth so voice-2 lines
                             right-align against a stable edge; otherwise MinWidth is 0
                             and the column hugs content exactly as before. -->
                        <ItemsControl.MinWidth>
                            <MultiBinding Converter="{StaticResource DuetMinWidth}">
                                <Binding Path="HasDuetLines"/>
                                <Binding Path="$self.MaxWidth"/>
                            </MultiBinding>
                        </ItemsControl.MinWidth>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:LyricLine">
                                <Button Background="Transparent"
                                        Classes="lyric-line-btn"
                                        Classes.active="{Binding IsActive}"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="0,10"
                                        MaxWidth="{Binding $parent[ItemsControl].MaxWidth}"
                                        HorizontalAlignment="{Binding Voice, Converter={StaticResource VoiceAlign}}"
                                        RenderTransformOrigin="{Binding Voice, Converter={StaticResource VoiceOrigin}}"
                                        HorizontalContentAlignment="Left"
                                        Cursor="Hand"
                                        IsHitTestVisible="{Binding IsClickable}"
                                        Command="{Binding $parent[ItemsControl].((vm:LyricsViewModel)DataContext).SeekToLineCommand}"
                                        CommandParameter="{Binding}"
                                        Effect="{Binding BlurRadius, Converter={StaticResource BlurToEffect}}">
                                    <StackPanel HorizontalAlignment="Left"
                                                MaxWidth="{Binding $parent[ItemsControl].MaxWidth}">
                                    <Panel HorizontalAlignment="{Binding Voice, Converter={StaticResource VoiceAlign}}">
                                        <!-- Main text layer (only for lines without word timings; intro uses dots) -->
                                        <TextBlock Text="{Binding Text}"
                                                   Classes="lyric-line"
                                                   Classes.active="{Binding IsActive}"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding $parent[UserControl].((vm:LyricsViewModel)DataContext).LyricsPrimaryFg}"
                                                   HorizontalAlignment="Left"
                                                   TextAlignment="{Binding Voice, Converter={StaticResource VoiceTextAlign}}"
                                                   MaxWidth="{Binding $parent[ItemsControl].MaxWidth}"
                                                   Opacity="{Binding LineOpacity}"
                                                   IsVisible="{Binding ShowLineText}"
                                                   TextWrapping="Wrap"/>

                                        <!-- Word-level karaoke layer. Rendered for word-timed lines whether active
                                             or not, so the wrap geometry never changes on activation (the old
                                             TextBlock swap re-wrapped the line mid-song). Inactive lines show the
                                             base layer at full opacity — indistinguishable from plain line text. -->
                                        <ItemsControl ItemsSource="{Binding Words}"
                                                      Classes="word-layer"
                                                      Classes.active="{Binding IsActive}"
                                                      IsVisible="{Binding ShowWords}"
                                                      Opacity="{Binding LineOpacity}"
                                                      HorizontalAlignment="Left"
                                                      ClipToBounds="False"
                                                      MaxWidth="{Binding $parent[ItemsControl].MaxWidth}"
                                                      ItemTemplate="{StaticResource WordCellTemplate}">
                                            <ItemsControl.Transitions>
                                                <Transitions>
                                                    <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseInOut"/>
                                                </Transitions>
                                            </ItemsControl.Transitions>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" ItemsAlignment="{Binding Voice, Converter={StaticResource VoiceItemsAlign}}"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <!-- Intro dots. Left margin centers the first dot over the
                                             first letter of the lyric below. Each dot breathes on a
                                             sine wave (Alternate keeps it continuous, no hold-and-snap);
                                             FillMode=Backward holds the dim keyframe through the stagger
                                             delay so dots 2/3 don't pop from full opacity. -->
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Margin="10,8,0,8"
                                                    Opacity="{Binding LineOpacity}"
                                                    IsVisible="{Binding IsIntroPlaceholder}"
                                                    Classes.active="{Binding IsActive}">
                                            <StackPanel.Transitions>
                                                <Transitions>
                                                    <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseInOut"/>
                                                </Transitions>
                                            </StackPanel.Transitions>
                                            <Ellipse x:Name="IntroDot1" Width="12" Height="12" Fill="{Binding $parent[UserControl].((vm:LyricsViewModel)DataContext).LyricsControlFill}">
                                                <Ellipse.Styles>
                                                    <Style Selector="StackPanel.active Ellipse#IntroDot1">
                                                        <Style.Animations>
                                                            <Animation Duration="0:0:0.9" IterationCount="INFINITE" PlaybackDirection="Alternate" FillMode="Backward" Easing="SineEaseInOut">
                                                                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35"/></KeyFrame>
                                                                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                                                            </Animation>
                                                        </Style.Animations>
                                                    </Style>
                                                    <Style Selector="StackPanel:not(.active) Ellipse#IntroDot1">
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                    </Style>
                                                </Ellipse.Styles>
                                            </Ellipse>
                                            <Ellipse x:Name="IntroDot2" Width="12" Height="12" Fill="{Binding $parent[UserControl].((vm:LyricsViewModel)DataContext).LyricsControlFill}">
                                                <Ellipse.Styles>
                                                    <Style Selector="StackPanel.active Ellipse#IntroDot2">
                                                        <Style.Animations>
                                                            <Animation Duration="0:0:0.9" IterationCount="INFINITE" PlaybackDirection="Alternate" FillMode="Backward" Easing="SineEaseInOut" Delay="0:0:0.3">
                                                                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35"/></KeyFrame>
                                                                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                                                            </Animation>
                                                        </Style.Animations>
                                                    </Style>
                                                    <Style Selector="StackPanel:not(.active) Ellipse#IntroDot2">
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                    </Style>
                                                </Ellipse.Styles>
                                            </Ellipse>
                                            <Ellipse x:Name="IntroDot3" Width="12" Height="12" Fill="{Binding $parent[UserControl].((vm:LyricsViewModel)DataContext).LyricsControlFill}">
                                                <Ellipse.Styles>
                                                    <Style Selector="StackPanel.active Ellipse#IntroDot3">
                                                        <Style.Animations>
                                                            <Animation Duration="0:0:0.9" IterationCount="INFINITE" PlaybackDirection="Alternate" FillMode="Backward" Easing="SineEaseInOut" Delay="0:0:0.6">
                                                                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35"/></KeyFrame>
                                                                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                                                            </Animation>
                                                        </Style.Animations>
                                                    </Style>
                                                    <Style Selector="StackPanel:not(.active) Ellipse#IntroDot3">
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                    </Style>
                                                </Ellipse.Styles>
                                            </Ellipse>
                                        </StackPanel>
                                    </Panel>

                                    <!-- Background vocals (adlibs): smaller karaoke row under the
                                         main words, Apple Music style. Same cell template, so it
                                         gets the full glow/base/sweep treatment; font size tracks
                                         the responsive lyrics size at 60%. Present whenever the
                                         line has one, so wrap geometry never changes on activation. -->
                                    <ItemsControl ItemsSource="{Binding BackgroundWords}"
                                                  Classes="word-layer bg-vocals"
                                                  Classes.active="{Binding IsActive}"
                                                  IsVisible="{Binding ShowBackgroundWords}"
                                                  Opacity="{Binding LineOpacity}"
                                                  HorizontalAlignment="{Binding Voice, Converter={StaticResource VoiceAlign}}"
                                                  ClipToBounds="False"
                                                  Margin="0,6,0,0"
                                                  FontSize="{Binding $parent[ItemsControl].FontSize, Converter={StaticResource FontScale}, ConverterParameter=0.6}"
                                                  MaxWidth="{Binding $parent[ItemsControl].MaxWidth}"
                                                  ItemTemplate="{StaticResource WordCellTemplate}">
                                        <ItemsControl.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseInOut"/>
                                            </Transitions>
                                        </ItemsControl.Transitions>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" ItemsAlignment="{Binding Voice, Converter={StaticResource VoiceItemsAlign}}"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- "Written By" credit (Apple Music style): scrolls into view after
                         the final line. Collapses entirely — no reserved space — when the
                         track has no composer or no lyrics (WrittenByText is empty then).
                         Not a lyric line: it lives outside LyricsItemsControl, so line
                         indices, active-line anchoring and opacity dimming never see it. -->
                    <!-- 2px optical inset: layout boxes are flush with the lyric lines
                         (verified by headless pixel probe), but the big bold lyric
                         glyphs carry ~1-2px of left-side bearing while the 15px "W"
                         overhangs its box — without this the credit reads as sitting
                         left of the text above. -->
                    <TextBlock x:Name="WrittenByFooter"
                               FontSize="15"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Left"
                               MaxWidth="{Binding #LyricsItemsControl.MaxWidth}"
                               Margin="2,44,0,0"
                               IsVisible="{Binding WrittenByText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><Run Text="Written By: " FontWeight="SemiBold" Foreground="{Binding LyricsSecondaryFg}"/><Run Text="{Binding WrittenByText}" Foreground="{Binding LyricsSubtleFg}"/></TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- (Source / Save / Alternate buttons moved to left panel bottom) -->

            <!-- Follow Button -->
            <Button Classes="pill-btn"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,30"
                    ZIndex="2"
                    IsVisible="{Binding IsAutoFollowPaused}"
                    Command="{Binding ResumeAutoFollowCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource ClipboardIcon}"
                             Width="14" Height="14"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="Follow" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
