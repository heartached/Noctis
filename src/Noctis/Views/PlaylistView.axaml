<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:vm="using:Noctis.ViewModels"
             xmlns:m="using:Noctis.Models"
             xmlns:controls="using:Noctis.Controls"
             xmlns:conv="using:Noctis.Converters"
             xmlns:helpers="using:Noctis.Helpers"
             x:Class="Noctis.Views.PlaylistView"
             x:DataType="vm:PlaylistViewModel"
             Focusable="True"
             Background="{DynamicResource AppMainBackground}">

    <UserControl.Resources>
        <conv:ArtworkPathConverter x:Key="ArtworkConverter" />
        <conv:HexColorToBrushConverter x:Key="HexColorConverter" />
        <conv:DateAddedDisplayConverter x:Key="DateAddedDisplay" />
        <conv:RecentlyAddedConverter x:Key="RecentAdded" />
        <conv:BadgeBrushConverter x:Key="BadgeBrush" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Section header link: no hover zoom (overrides the global Button scale) -->
        <Style Selector="Button.featured-header:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="Button.featured-header:pressed">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="Button.featured-artist-tile:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="Button.featured-artist-tile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#18FFFFFF" />
        </Style>
        <Style Selector="Button.featured-artist-tile:pressed">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="Button.featured-artist-tile:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#24FFFFFF" />
        </Style>
        <Style Selector="Button.neutral-desc-btn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="Button.neutral-desc-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF" />
        </Style>
        <Style Selector="Button.neutral-desc-btn:pressed">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="Button.neutral-desc-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <!-- Glass pill buttons (Shuffle / options) — visible against the theme bg -->
        <Style Selector="Button.glass-pill">
            <Setter Property="Background" Value="{DynamicResource GlassPillBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassPillBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="Button.glass-pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource GlassPillHoverBackground}" />
        </Style>
        <Style Selector="Button.glass-pill:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource GlassPillPressedBackground}" />
        </Style>
        <Style Selector="Button.glass-pill:pressed">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>

        <!-- Favorite heart: no square hover highlight and no scale/pop; only a subtle opacity cue on hover -->
        <Style Selector="Button.heart-btn">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.heart-btn /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.heart-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.heart-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Override the global Button hover/press scale so hearts never zoom or pop -->
        <Style Selector="Button.heart-btn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="Button.heart-btn:pressed">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <!-- The row heart is a HeartIcon now; hover brightens its not-favorited glyph. -->
        <Style Selector="Button.heart-btn:pointerover controls|HeartIcon.faint-heart">
            <Setter Property="OffOpacity" Value="0.7" />
        </Style>

        <!-- Album run headers live inside each run-start item, so the row
             background (stripe/hover/ctrl-select) moves off the ListBoxItem onto
             the inner row-body Border — otherwise the header line would get
             striped and highlighted along with the row. Scoped to this view. -->
        <Style Selector="ListBox.track-list ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.track-list ListBoxItem:nth-child(2n)">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.track-list ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.track-list ListBoxItem:nth-child(2n):pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.track-list ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.track-list ListBoxItem:nth-child(2n):selected">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.track-list ListBoxItem.ctrl-selected">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.track-list ListBoxItem.ctrl-selected:nth-child(2n)">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.track-list ListBoxItem.ctrl-selected:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.track-list ListBoxItem.ctrl-selected:nth-child(2n):pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.track-list ListBoxItem.ctrl-selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.track-list ListBoxItem.ctrl-selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Row body: carries the stripe ("even" stamped by code-behind), hover
             and ctrl-select backgrounds the ListBoxItem used to paint -->
        <Style Selector="Border.row-body">
            <Setter Property="Padding" Value="0,6,8,6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.04" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.row-body.even">
            <Setter Property="Background" Value="{DynamicResource TrackListStripeBrush}" />
        </Style>
        <Style Selector="Border.row-body:pointerover">
            <Setter Property="Background" Value="{DynamicResource TrackListHoverBrush}" />
        </Style>
        <Style Selector="ListBoxItem.ctrl-selected Border.row-body">
            <Setter Property="Background" Value="#3FFFFFFF" />
        </Style>
        <!-- Now-playing: the accent-coloured box (see Styles.axaml) must be re-applied
             at view scope because the stripe/hover/ctrl-select styles above live here
             too and would otherwise outrank the app-level fill. Declared after them
             so the box wins on even, hovered and ctrl-selected rows alike. -->
        <Style Selector="Border.row-body.now-playing">
            <Setter Property="Background" Value="{DynamicResource NowPlayingRowBrush}" />
        </Style>

        <!-- # column: the row number fades into a grip hint on hover, but only
             when reorder is actually possible (manual playlist + manual sort + no filter) -->
        <Style Selector="TextBlock.row-index, TextBlock.row-grip">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.row-body.reorderable:pointerover TextBlock.row-index">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.row-body.reorderable:pointerover TextBlock.row-grip">
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!-- Artwork play overlay: hidden until the row is hovered; no global button zoom -->
        <Style Selector="Button.art-play-overlay">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.row-body:pointerover Button.art-play-overlay">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.art-play-overlay:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="Button.art-play-overlay:pressed">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>

        <!-- Album cell repeating the row above (stamped .repeat-dim by code-behind):
             dimmed at rest so only album changes catch the eye, but restored under the
             pointer — it is a link to the album page, and a permanently faded control
             reads as disabled at the moment you go to click it. -->
        <Style Selector="Button.album-btn">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.album-btn.repeat-dim">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Border.row-body:pointerover Button.album-btn.repeat-dim">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Floating selection action bar: fades/slides in when rows are Ctrl-selected -->
        <Style Selector="Border#SelectionBar">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="RenderTransform" Value="translateY(14px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#SelectionBar.visible">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="RenderTransform" Value="translateY(0px)" />
        </Style>
        <Style Selector="Border#SelectionBar Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border#SelectionBar Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF" />
        </Style>
        <Style Selector="Border#SelectionBar Button:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="Border#SelectionBar Button:pressed">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>

        <!-- Suggested-song add button: subtle outline that lights up on hover -->
        <Style Selector="Button.suggest-add">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#3DFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="Button.suggest-add:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="Button.suggest-add:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.suggest-add:pressed">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
    </UserControl.Styles>

    <Panel>

        <!-- Background follows the app theme (AppMainBackground on the UserControl).
             The hero band alone carries the playlist's own art, blurred. -->

        <!-- ═══════════════ Banner layout (09-14, design "1 Banner · rail right") ═══════════════
             Hero band on top (blurred playlist art + name + stats + controls), then the
             track list with the Featured Artists / Suggested rail on its right. The list
             is still the only scrolling region; the rail scrolls on its own. -->
        <Grid RowDefinitions="Auto,*">

            <!-- ───────── Hero ───────── -->
            <Grid Grid.Row="0" Height="236" ClipToBounds="True">
                <!-- Ground: the playlist's own colour, so an art-less playlist is never flat black -->
                <Border Background="{Binding PlaylistColor, Converter={StaticResource HexColorConverter}}" Opacity="0.45" />
                <!-- The art as an abstract colour glow (the Artist page's hero recipe: heavy
                     blur, zoomed far past the frame, faint) — a readable blur of a 2x2 collage
                     cropped to a 236px band was a muddy photo smear (user, 09-14). -->
                <Panel Opacity="0.55" RenderTransformOrigin="0.5,0.5">
                    <Panel.RenderTransform>
                        <ScaleTransform ScaleX="1.7" ScaleY="1.7" />
                    </Panel.RenderTransform>
                    <Panel.Effect>
                        <BlurEffect Radius="130" />
                    </Panel.Effect>
                    <Panel>
                        <Border Background="{Binding PlaylistColor, Converter={StaticResource HexColorConverter}}" />
                        <PathIcon Data="{StaticResource PlaylistsIcon}"
                                  Width="56" Height="56"
                                  Foreground="{DynamicResource TertiaryTextBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding ShowFallbackIcon}" />
                        <controls:CachedImage SourcePath="{Binding Art1}"
                                              Stretch="UniformToFill"
                                              IsVisible="{Binding HasSingleArt}" />
                        <Grid RowDefinitions="*,*"
                              ColumnDefinitions="*,*"
                              IsVisible="{Binding HasCollageArt}">
                            <controls:CachedImage Grid.Row="0" Grid.Column="0"
                                                  SourcePath="{Binding Art1}"
                                                  Stretch="UniformToFill" />
                            <controls:CachedImage Grid.Row="0" Grid.Column="1"
                                                  SourcePath="{Binding Art2}"
                                                  Stretch="UniformToFill" />
                            <controls:CachedImage Grid.Row="1" Grid.Column="0"
                                                  SourcePath="{Binding Art3}"
                                                  Stretch="UniformToFill" />
                            <controls:CachedImage Grid.Row="1" Grid.Column="1"
                                                  SourcePath="{Binding Art4}"
                                                  Stretch="UniformToFill" />
                        </Grid>
                        <controls:CachedImage SourcePath="{Binding PlaylistCoverArtPath}"
                                              Stretch="UniformToFill"
                                              IsVisible="{Binding HasCustomArt}" />
                    </Panel>
                </Panel>
                <!-- Scrim for legibility, then a page-colour fade so the band dissolves into the list -->
                <Rectangle Fill="#000000" Opacity="0.38" />
                <Border Background="{DynamicResource AppMainBackground}">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="0.45" Color="#26FFFFFF" />
                            <GradientStop Offset="1" Color="White" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>

                <!-- Hero content, bottom-left: the playlist's cover (the same custom > collage >
                     single > colour tile the grid shows, 09-14) beside the name block. -->
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Bottom" Margin="28,0,28,18">
                <Border Grid.Column="0"
                        Width="156" Height="156"
                        CornerRadius="10"
                        ClipToBounds="True"
                        VerticalAlignment="Bottom"
                        Margin="0,0,24,0"
                        BoxShadow="0 10 30 0 #66000000">
                    <Panel>
                        <Border Background="{Binding PlaylistColor, Converter={StaticResource HexColorConverter}}" />
                        <PathIcon Data="{StaticResource PlaylistsIcon}"
                                  Width="56" Height="56"
                                  Foreground="{DynamicResource TertiaryTextBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding ShowFallbackIcon}" />
                        <controls:CachedImage SourcePath="{Binding Art1}"
                                              Stretch="UniformToFill"
                                              IsVisible="{Binding HasSingleArt}" />
                        <Grid RowDefinitions="*,*"
                              ColumnDefinitions="*,*"
                              IsVisible="{Binding HasCollageArt}">
                            <controls:CachedImage Grid.Row="0" Grid.Column="0"
                                                  SourcePath="{Binding Art1}"
                                                  Stretch="UniformToFill" />
                            <controls:CachedImage Grid.Row="0" Grid.Column="1"
                                                  SourcePath="{Binding Art2}"
                                                  Stretch="UniformToFill" />
                            <controls:CachedImage Grid.Row="1" Grid.Column="0"
                                                  SourcePath="{Binding Art3}"
                                                  Stretch="UniformToFill" />
                            <controls:CachedImage Grid.Row="1" Grid.Column="1"
                                                  SourcePath="{Binding Art4}"
                                                  Stretch="UniformToFill" />
                        </Grid>
                        <controls:CachedImage SourcePath="{Binding PlaylistCoverArtPath}"
                                              Stretch="UniformToFill"
                                              IsVisible="{Binding HasCustomArt}" />
                    </Panel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                    <TextBlock Text="{loc:T Playlist.Kicker}"
                               FontSize="11" FontWeight="Bold" LetterSpacing="1.4" Opacity="0.75" />

                    <!-- Name (click to rename inline) + Smart badge -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <Panel>
                            <Button Classes="featured-header"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    MinHeight="0"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Cursor="Hand"
                                    ToolTip.Tip="{loc:T Playlist.RenamePlaylistTip}"
                                    Command="{Binding StartRenameCommand}"
                                    IsVisible="{Binding !IsRenamingName}">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="40"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"
                                           TextWrapping="NoWrap" />
                            </Button>
                            <TextBox x:Name="RenameBox"
                                     Text="{Binding NameEditorText, Mode=TwoWay}"
                                     FontSize="40"
                                     FontWeight="Bold"
                                     MinWidth="200"
                                     Padding="0"
                                     Background="Transparent"
                                     BorderThickness="0,0,0,1"
                                     BorderBrush="{DynamicResource AccentColorBrush}"
                                     KeyDown="OnRenameBoxKeyDown"
                                     LostFocus="OnRenameBoxLostFocus"
                                     IsVisible="{Binding IsRenamingName}" />
                        </Panel>
                        <Border Background="{DynamicResource AccentColorBrush}" CornerRadius="999" Padding="9,3"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsSmartPlaylist}">
                            <TextBlock Text="{loc:T Playlist.Smart}" FontSize="10" Foreground="{DynamicResource AccentForegroundBrush}"
                                       FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <!-- Stats: one line (tracks · duration · size · created · modified) -->
                    <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,8,0,0">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Opacity="0.8">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} tracks · {1} · {2}">
                                <Binding Path="TrackCount" />
                                <Binding Path="TotalDuration" />
                                <Binding Path="TotalSize" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text=" · " FontSize="12" FontWeight="SemiBold" Opacity="0.8" />
                    <TextBlock FontSize="12" FontWeight="SemiBold" Opacity="0.8">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} · {1}">
                                <Binding Path="CreatedDateDisplay" />
                                <Binding Path="ModifiedDateDisplay" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    </StackPanel>

                    <!-- Description (clickable, opens dialog) -->
                    <Button Classes="neutral-desc-btn"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="2,2"
                            MinHeight="0"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand"
                            Margin="-2,4,0,0"
                            Command="{Binding OpenDescriptionCommand}"
                            ToolTip.Tip="{loc:T Playlist.ViewPlaylistDescriptionTip}"
                            IsVisible="{Binding HasDescription}">
                        <TextBlock Text="{Binding PlaylistDescription}"
                                   FontSize="12.5"
                                   Opacity="0.72"
                                   TextWrapping="NoWrap"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis" />
                    </Button>

                    <!-- Ghost affordance when there is no description yet -->
                    <Button Classes="neutral-desc-btn"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="2,2"
                            MinHeight="0"
                            HorizontalAlignment="Left"
                            Cursor="Hand"
                            Margin="-2,4,0,0"
                            Command="{Binding AddDescriptionCommand}"
                            IsVisible="{Binding !HasDescription}">
                        <TextBlock Text="{loc:T Playlist.AddDescription}"
                                   FontSize="12.5"
                                   FontStyle="Italic"
                                   Opacity="0.45" />
                    </Button>

                    <!-- Play / Shuffle / options — compact pills matching the Albums/Singles header -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                        <Button Command="{Binding PlayAllCommand}"
                                Classes="accent-btn"
                                Background="{DynamicResource AccentButtonBackground}"
                                Foreground="{DynamicResource AccentForegroundBrush}"
                                BorderThickness="0"
                                CornerRadius="999"
                                Padding="24,8"
                                FontWeight="Bold"
                                Cursor="Hand"
                                ToolTip.Tip="{loc:T Playlist.PlayTip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource PlaySolidIcon}"
                                          Width="13" Height="13"
                                          Foreground="{DynamicResource AccentForegroundBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{loc:T Playlist.PlayTip}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <!-- Shuffle: solid accent pill matching the Albums/Singles header (layered icon) -->
                        <Button Command="{Binding ShuffleAllCommand}"
                                Classes="accent-btn"
                                Background="{DynamicResource AccentButtonBackground}"
                                Foreground="{DynamicResource AccentForegroundBrush}"
                                BorderThickness="0"
                                CornerRadius="999"
                                Padding="20,8"
                                FontWeight="Bold"
                                Cursor="Hand"
                                ToolTip.Tip="{loc:T Playlist.ShuffleTip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource ShuffleIcon}"
                                              Width="16" Height="16"
                                              Foreground="{DynamicResource AccentForegroundBrush}" />
                                    <PathIcon Data="{StaticResource ShuffleIcon}"
                                              Width="16" Height="16"
                                              Foreground="{DynamicResource AccentForegroundBrush}"
                                              Opacity="0.85"
                                              Margin="0.6,0,0,0" />
                                </Grid>
                                <TextBlock Text="{loc:T Playlist.ShuffleTip}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <!-- Star in sidebar (09-14): mirrors the tile menu's Star/Unstar. -->
                        <Button Classes="glass-pill"
                                Width="42" Height="34"
                                Padding="0"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                Command="{Binding TogglePinCommand}"
                                ToolTip.Tip="{loc:T LibraryPlaylists.StarSidebar}"
                                IsVisible="{Binding !IsPinned}">
                            <PathIcon Data="{StaticResource StarIcon}" Width="14" Height="14" Opacity="0.85" />
                        </Button>
                        <Button Classes="glass-pill"
                                Width="42" Height="34"
                                Padding="0"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                Command="{Binding TogglePinCommand}"
                                ToolTip.Tip="{loc:T LibraryPlaylists.UnstarFromSidebar}"
                                IsVisible="{Binding IsPinned}">
                            <PathIcon Data="{StaticResource StarIcon}" Width="14" Height="14" Foreground="{DynamicResource AccentColorBrush}" />
                        </Button>
                        <Button Classes="glass-pill"
                                Width="42" Height="34"
                                Padding="0"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="{loc:T Playlist.OptionsTip}">
                            <PathIcon Data="{StaticResource MoreDotsIcon}"
                                      Width="13" Height="13" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft"
                                            PlacementConstraintAdjustment="None"
                                            helpers:MenuOpenAnimation.EnableFlyoutClose="True">
                                    <MenuItem Header="{loc:T Playlist.PlayNext}"
                                              Command="{Binding PlayNextAllCommand}">
                                        <MenuItem.Icon>
                                            <Border Width="14" Height="14" Background="{DynamicResource SystemControlForegroundBaseHighBrush}" RenderOptions.BitmapInterpolationMode="HighQuality"><Border.OpacityMask><ImageBrush Source="avares://Noctis.UI/Assets/Icons/Forward%20ICON.png" Stretch="Uniform" /></Border.OpacityMask></Border>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:T Playlist.AddQueue}"
                                              Command="{Binding AddAllToQueueCommand}">
                                        <MenuItem.Icon>
                                            <Border Width="17" Height="17" Background="{DynamicResource SystemControlForegroundBaseHighBrush}" RenderOptions.BitmapInterpolationMode="HighQuality"><Border.OpacityMask><ImageBrush Source="avares://Noctis.UI/Assets/Icons/Queue%20ICON.png" Stretch="Uniform" /></Border.OpacityMask></Border>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{loc:T Playlist.AddSongs}"
                                              Command="{Binding AddSongsCommand}"
                                              IsVisible="{Binding IsManualPlaylist}">
                                        <MenuItem.Icon>
                                            <PathIcon Data="M11 5H13V11H19V13H13V19H11V13H5V11H11V5Z" Width="13" Height="13" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:T Playlist.EditPlaylist}"
                                              Command="{Binding EditPlaylistCommand}">
                                        <MenuItem.Icon>
                                            <Border Width="14" Height="14" Background="{DynamicResource SystemControlForegroundBaseHighBrush}" RenderOptions.BitmapInterpolationMode="HighQuality"><Border.OpacityMask><ImageBrush Source="avares://Noctis.UI/Assets/Icons/Edit%20Playlist%20ICON.png" Stretch="Uniform" /></Border.OpacityMask></Border>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{loc:T Playlist.DeletePlaylist}" Classes="danger"
                                              Command="{Binding DeletePlaylistCommand}">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource TrashIcon}" Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    <!-- Sort (view-only display order; does not change the saved playlist order).
                             Sits with the other pills (09-14) instead of on its own row above the list.
                             Same explicit 34px height as the star/options pills (09-15): with padding
                             alone its text row measured a different height, and Fluent centres each
                             button in the row, so this pill sat higher than its neighbours. -->
                            <Button Classes="glass-pill"
                                Height="34"
                                Padding="12,0"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                ToolTip.Tip="{loc:T Playlist.ChangeDisplayedOrderManualTip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding SortLabel, StringFormat='Sort: {0}'}"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:T Playlist.Text}"
                                           FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                           FontSize="9" Opacity="0.6" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft"
                                            helpers:MenuOpenAnimation.EnableFlyoutClose="True">
                                    <MenuItem Header="{loc:T Playlist.ManualPlaylistOrder}" Command="{Binding SetSortCommand}" CommandParameter="Manual" />
                                    <MenuItem Header="{loc:T Playlist.Title}" Command="{Binding SetSortCommand}" CommandParameter="Title" />
                                    <MenuItem Header="{loc:T Playlist.Artist}" Command="{Binding SetSortCommand}" CommandParameter="Artist" />
                                    <MenuItem Header="{loc:T Playlist.Album}" Command="{Binding SetSortCommand}" CommandParameter="Album" />
                                    <MenuItem Header="{loc:T Playlist.Duration}" Command="{Binding SetSortCommand}" CommandParameter="Duration" />
                                    <MenuItem Header="{loc:T Playlist.RecentlyAdded}" Command="{Binding SetSortCommand}" CommandParameter="RecentlyAdded" />
                                    <MenuItem Header="{loc:T Playlist.ReleaseDateOldest}" Command="{Binding SetSortCommand}" CommandParameter="ReleaseDateOldest" />
                                    <MenuItem Header="{loc:T Playlist.ReleaseDateNewest}" Command="{Binding SetSortCommand}" CommandParameter="ReleaseDateNewest" />
                                    <MenuItem Header="{loc:T Playlist.SortBadge}" Command="{Binding SetSortCommand}" CommandParameter="Badge" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>
                </Grid>
            </Grid>

            <!-- ───────── Body: track list + right rail ───────── -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

                <!-- Track list column. Right margin trimmed to 2 so the vertical scrollbar
                     sits at the rail's divider (matching the Albums/Songs lists). -->
                <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="20,14,2,0">

                <!-- Column headers. Insets (1px left, 9px right) mirror the track-list
                     row content box (1px ListBoxItem border + 8px right padding) so each
                     header sits exactly over its column's data. -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="34,48,2*,1.4*,Auto,Auto,64,40"
                      Margin="1,0,9,6">
                    <TextBlock Grid.Column="0" Text="#"
                               FontSize="12" FontWeight="SemiBold" Opacity="0.5"
                               HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{loc:T Playlist.Title}"
                               FontSize="12" FontWeight="SemiBold" Opacity="0.5"
                               Margin="12,0,0,0" />
                    <TextBlock Grid.Column="3" Text="{loc:T Playlist.Album}"
                               FontSize="12" FontWeight="SemiBold" Opacity="0.5" />
                    <!-- GitHub #74: Added / Favorite are Auto columns whose only child is this
                         fixed-width cell, so hiding the cell (Settings → Library → Playlist page)
                         collapses the column in the header and every row alike. -->
                    <TextBlock Grid.Column="4" Text="{loc:T Playlist.Added}" Width="70"
                               FontSize="12" FontWeight="SemiBold" Opacity="0.5"
                               TextAlignment="Center"
                               IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Settings.PlaylistShowAddedColumn, FallbackValue=True}" />
                    <TextBlock Grid.Column="5" Text="{loc:T Playlist.Favorite}" Width="64"
                               FontSize="12" FontWeight="SemiBold" Opacity="0.5"
                               TextAlignment="Center"
                               IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Settings.PlaylistShowFavoriteColumn, FallbackValue=True}" />
                    <TextBlock Grid.Column="6" Text="{loc:T Playlist.Time}"
                               FontSize="12" FontWeight="SemiBold" Opacity="0.5"
                               HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="7" />
                </Grid>

                <!-- Track list: the only scrolling region (virtualized) -->
                <Grid Grid.Row="1" x:Name="TrackListWrapper">
                    <ListBox Classes="track-list"
                             ItemsSource="{Binding Tracks}"
                             x:Name="TrackList"
                             Padding="0,0,0,115"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="m:Track">
                                <StackPanel>

                                <!-- Album run header: stamped by code-behind on the first row of
                                     each consecutive same-album run (hidden while filtering) -->
                                <StackPanel Classes="album-run-header"
                                            IsVisible="False"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            Margin="8,18,8,6">
                                    <TextBlock Classes="run-album"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               LetterSpacing="1"
                                               Opacity="0.6"
                                               VerticalAlignment="Center" />
                                    <TextBlock Classes="run-count"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Opacity="0.35"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Border Classes="row-body"
                                        Classes.now-playing="{Binding IsNowPlaying}"
                                        Classes.reorderable="{Binding $parent[UserControl].((vm:PlaylistViewModel)DataContext).CanReorder}">
                                <Grid ColumnDefinitions="34,48,2*,1.4*,Auto,Auto,64,40"
                                      Margin="0,1" Background="Transparent">

                                    <!-- Row number; becomes a grip hint on hover when reorder is possible -->
                                    <Panel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Classes="row-index"
                                                   FontSize="11.5"
                                                   Opacity="0.4"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Classes="row-grip"
                                                   Text="{loc:T Playlist.Text4}"
                                                   FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Opacity="0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Panel>

                                    <!-- Cover art thumbnail (play overlay on hover) -->
                                    <Border Grid.Column="1"
                                            Width="36" Height="36"
                                            CornerRadius="5"
                                            ClipToBounds="True"
                                            VerticalAlignment="Center"
                                            Background="#18FFFFFF">
                                        <Panel>
                                            <PathIcon Data="{StaticResource SongsIcon}"
                                                      Width="14" Height="14"
                                                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsVisible="{Binding !HasAlbumArt}" />
                                            <controls:CachedImage SourcePath="{Binding AlbumArtworkPath}"
                                                                  DecodeWidth="256"
                                                                  Stretch="UniformToFill"
                                                                  RenderOptions.BitmapInterpolationMode="HighQuality"
                                                                  IsVisible="{Binding HasAlbumArt}" />
                                            <Button Classes="art-play-overlay"
                                                    Background="#66000000"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    CornerRadius="5"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Cursor="Hand"
                                                    ToolTip.Tip="{loc:T Playlist.PlayFromHereTip}"
                                                    Command="{Binding $parent[UserControl].((vm:PlaylistViewModel)DataContext).PlayFromCommand}"
                                                    CommandParameter="{Binding}">
                                                <PathIcon Data="{StaticResource PlaySolidIcon}"
                                                          Width="14" Height="14"
                                                          Foreground="White" />
                                            </Button>
                                        </Panel>
                                    </Border>

                                    <!-- Title over artist -->
                                    <StackPanel Grid.Column="2"
                                                Margin="12,4,12,4"
                                                VerticalAlignment="Center"
                                                Spacing="1">
                                        <!-- Auto/Auto/Auto keeps both badges hard against the end of the
                                             title (as in the Songs rows) rather than parked at the far
                                             edge of the column, which a star column would do. Auto
                                             measures with infinite width though, so the title only has
                                             a width to ellipsize against because OnTitleCellLayoutUpdated
                                             budgets it MaxWidth = cell - badges; ClipToBounds is the
                                             backstop for the frame before that lands. Without this the
                                             title painted straight over the Album column (issue #30). -->
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto"
                                              ClipToBounds="True"
                                              LayoutUpdated="OnTitleCellLayoutUpdated">
                                            <!-- Trimming is also set inline, as in the Songs rows: the
                                                 one-line-explicit-title class alone is not enough to rely
                                                 on here, because a TextBlock type selector does not match
                                                 this HighlightTextBlock subclass. -->
                                            <controls:HighlightTextBlock Grid.Column="0"
                                                                         Classes="one-line-explicit-title"
                                                                         DisplayText="{Binding TitleDisplay}"
                                                                         HighlightText="{Binding $parent[UserControl].((vm:PlaylistViewModel)DataContext).SearchText}"
                                                                         FontSize="13"
                                                                         FontWeight="SemiBold"
                                                                         TextWrapping="NoWrap"
                                                                         MaxLines="1"
                                                                         VerticalAlignment="Center"
                                                                         TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1"
                                                    Classes="explicit-badge compact"
                                                    Margin="6,0,0,0"
                                                    IsVisible="{Binding IsExplicit}"
                                                    ToolTip.Tip="{loc:T Playlist.ExplicitTip}">
                                                <TextBlock Text="E"
                                                           Classes="explicit-badge-text compact"
                                                           FontSize="8"
                                                           Opacity="0.9" />
                                            </Border>
                                            <Border Grid.Column="2"
                                                    CornerRadius="999"
                                                    Padding="6,1.5"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource AccentTextExactBrush}"
                                                    ToolTip.Tip="{loc:T Playlist.AddedLast7DaysTip}">
                                                <!-- GitHub #74: the badge can be switched off in Settings. -->
                                                <Border.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="DateAdded" Converter="{StaticResource RecentAdded}" />
                                                        <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).Settings.PlaylistShowNewBadge" FallbackValue="True" />
                                                    </MultiBinding>
                                                </Border.IsVisible>
                                                <TextBlock Text="{loc:T Playlist.NEW}"
                                                           FontSize="8"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentTextExactBrush}" />
                                            </Border>
                                            <!-- GitHub #74: the user's own badge, coloured by name (BadgePalette). -->
                                            <Border Grid.Column="3"
                                                    Classes="user-badge"
                                                    CornerRadius="999"
                                                    Padding="6,1.5"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    BorderThickness="1"
                                                    BorderBrush="{Binding Badge, Converter={StaticResource BadgeBrush}}"
                                                    IsVisible="{Binding HasBadge}"
                                                    ToolTip.Tip="{Binding Badge}">
                                                <TextBlock Text="{Binding Badge}"
                                                           FontSize="8"
                                                           FontWeight="Bold"
                                                           MaxWidth="90"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{Binding Badge, Converter={StaticResource BadgeBrush}}" />
                                            </Border>
                                        </Grid>
                                        <Button Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
                                                Cursor="Hand" HorizontalAlignment="Left"
                                                Command="{Binding $parent[UserControl].((vm:PlaylistViewModel)DataContext).ViewArtistCommand}"
                                                CommandParameter="{Binding Artist}">
                                            <controls:HighlightTextBlock Classes="accent-link"
                                                                         DisplayText="{Binding ArtistDisplay}"
                                                                         HighlightText="{Binding $parent[UserControl].((vm:PlaylistViewModel)DataContext).SearchText}"
                                                                         FontSize="11"
                                                                         FontWeight="SemiBold"
                                                                         TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </StackPanel>

                                    <!-- Album (clickable, red; dimmed by code-behind when repeating the row above) -->
                                    <Button Grid.Column="3"
                                            Classes="album-btn"
                                            Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
                                            Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Command="{Binding $parent[UserControl].((vm:PlaylistViewModel)DataContext).ViewAlbumCommand}"
                                            CommandParameter="{Binding}">
                                        <controls:HighlightTextBlock Classes="accent-link"
                                                                     DisplayText="{Binding Album}"
                                                                     HighlightText="{Binding $parent[UserControl].((vm:PlaylistViewModel)DataContext).SearchText}"
                                                                     FontSize="12"
                                                                     FontWeight="SemiBold"
                                                                     TextTrimming="CharacterEllipsis"
                                                                     VerticalAlignment="Center" />
                                    </Button>

                                    <!-- Added date (column hidden via Settings → Library → Playlist page) -->
                                    <TextBlock Grid.Column="4" Width="70"
                                               Text="{Binding DateAdded, Converter={StaticResource DateAddedDisplay}}"
                                               FontSize="11.5"
                                               Opacity="0.5"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Settings.PlaylistShowAddedColumn, FallbackValue=True}" />

                                    <!-- Favorite heart toggle: red when favorited, faint otherwise (click toggles this track only) -->
                                    <Panel Grid.Column="5" Width="64"
                                           IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Settings.PlaylistShowFavoriteColumn, FallbackValue=True}">
                                    <Button Classes="heart-btn"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Width="28" Height="28"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Cursor="Hand"
                                            ToolTip.Tip="{loc:T Playlist.Favorite}"
                                            Command="{Binding $parent[UserControl].((vm:PlaylistViewModel)DataContext).ToggleFavoriteSingleCommand}"
                                            CommandParameter="{Binding}">
                                        <!-- Shared HeartIcon (pops both ways); the faint-heart styles
                                             above drive its OffOpacity on row hover. -->
                                        <controls:HeartIcon Classes="faint-heart" Size="13"
                                                            OffBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                            OffOpacity="0.28"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            IsFavorite="{Binding IsFavorite}" />
                                    </Button>
                                    </Panel>

                                    <!-- Time / duration -->
                                    <TextBlock Grid.Column="6"
                                               Text="{Binding DurationFormatted}"
                                               FontSize="12"
                                               Opacity="0.5"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />

                                    <!-- 3-dots menu -->
                                    <Button Grid.Column="7"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Width="32" Height="32"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Cursor="Hand"
                                            ToolTip.Tip="{loc:T Playlist.OptionsTip}"
                                            Tag="{Binding}"
                                            Click="OnOptionsButtonClick">
                                        <PathIcon Classes="row-dots-icon"
                                                  Data="{StaticResource MoreDotsIcon}"
                                                  Width="14" Height="14"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                                </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Floating drag card: lifts and springs after the pointer while
                         reordering (transforms driven per frame by LiquidReorder). -->
                    <Border x:Name="PlaylistDragPreview"
                            x:DataType="m:Track"
                            IsHitTestVisible="False"
                            IsVisible="False"
                            Margin="6,0,6,0"
                            Padding="6,4"
                            CornerRadius="10"
                            Background="#E62A2A2A"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            BoxShadow="0 10 28 0 #80000000"
                            RenderTransformOrigin="50%,50%">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform />
                                <TranslateTransform />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Grid ColumnDefinitions="Auto,*,Auto" Height="48">
                            <Border Grid.Column="0"
                                    Width="40" Height="40"
                                    CornerRadius="4"
                                    ClipToBounds="True"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"
                                    Background="#18FFFFFF">
                                <controls:CachedImage SourcePath="{Binding AlbumArtworkPath}"
                                                      Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding TitleDisplay}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                                <TextBlock Text="{Binding ArtistDisplay}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextExactBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding DurationFormatted}"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                       Opacity="0.6"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Empty state: manual playlists -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                IsVisible="{Binding ShowEmptyManual}">
                        <TextBlock Text="{loc:T Playlist.PlaylistEmpty}"
                                   FontSize="16"
                                   Opacity="0.5"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <TextBlock Text="{loc:T Playlist.DragTracksHereFrom}"
                                   FontSize="13"
                                   Opacity="0.3"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <Button Content="{loc:T Playlist.AddSongs}"
                                Command="{Binding AddSongsCommand}"
                                Classes="accent-btn"
                                Background="{DynamicResource AccentButtonBackground}"
                                Foreground="{DynamicResource AccentForegroundBrush}"
                                BorderThickness="0"
                                CornerRadius="999"
                                Padding="22,8"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0"
                                Cursor="Hand" />
                    </StackPanel>

                    <!-- Empty state: smart playlists -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                IsVisible="{Binding ShowEmptySmart}">
                        <TextBlock Text="{loc:T Playlist.NoTracksMatchCurrent}"
                                   FontSize="16"
                                   Opacity="0.5"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <TextBlock Text="{loc:T Playlist.TryAdjustingSmartPlaylist}"
                                   FontSize="13"
                                   Opacity="0.3"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                    </StackPanel>

                    <!-- Empty state: search matched nothing -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                IsVisible="{Binding ShowNoResults}">
                        <TextBlock Text="{loc:T Playlist.NoResults}"
                                   FontSize="16"
                                   Opacity="0.5"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <TextBlock Text="{loc:T Playlist.NoTracksPlaylistMatch}"
                                   FontSize="13"
                                   Opacity="0.3"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                    </StackPanel>

                    <!-- Floating multi-select action bar -->
                    <Border x:Name="SelectionBar"
                            Classes.visible="{Binding HasSelection}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,26"
                            CornerRadius="999"
                            Padding="16,6,8,6"
                            Background="{DynamicResource IslandBackground}"
                            BorderBrush="{DynamicResource IslandBorder}"
                            BorderThickness="1"
                            BoxShadow="0 8 30 0 #99000000">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} selected'}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <Button Click="OnSelectionAddToPlaylistClick"
                                    ToolTip.Tip="{loc:T Playlist.AddSelectedTracksPlaylistTip}">
                                <TextBlock Text="{loc:T Playlist.AddPlaylist}" FontSize="12" FontWeight="SemiBold" />
                            </Button>
                            <Button Click="OnSelectionFavoriteClick"
                                    ToolTip.Tip="{loc:T Playlist.ToggleFavoriteSelectedTracksTip}">
                                <TextBlock Text="{loc:T Playlist.Favorite}" FontSize="12" FontWeight="SemiBold" />
                            </Button>
                            <Button Click="OnSelectionRemoveClick"
                                    IsVisible="{Binding IsManualPlaylist}"
                                    ToolTip.Tip="{loc:T Playlist.RemoveSelectedTracksFromTip}">
                                <TextBlock Text="{loc:T Playlist.Remove}" FontSize="12" FontWeight="SemiBold" />
                            </Button>
                            <Button Click="OnSelectionClearClick"
                                    Padding="8,5"
                                    ToolTip.Tip="{loc:T Playlist.ClearSelectionTip}">
                                <TextBlock Text="{loc:T Playlist.Text5}" FontSize="11" Opacity="0.6" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
                </Grid>

                <!-- ───────── Right rail: Featured Artists + Suggested ───────── -->
                <Border Grid.Column="1"
                        Width="292"
                        Margin="0,12,0,0"
                        Padding="20,0,20,0"
                        BorderThickness="1,0,0,0"
                        BorderBrush="#1FFFFFFF">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,115">
                    <!-- Featured Artists -->
                    <StackPanel Margin="0,0,0,0"
                                IsVisible="{Binding HasFeaturedArtists}">
                        <Button Classes="featured-header"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="2,0"
                                MinHeight="0"
                                HorizontalAlignment="Left"
                                Cursor="Hand"
                                Command="{Binding OpenFeaturedArtistsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{loc:T Playlist.FEATUREDARTISTS}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Opacity="0.6"
                                           LetterSpacing="1" />
                                <TextBlock Text="{loc:T Playlist.Text2}"
                                           FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                           FontSize="10"
                                           Opacity="0.55"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!-- Stacked vertically so artists never clip off the right edge -->
                        <ItemsControl ItemsSource="{Binding TopFeaturedArtists}"
                                      Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlaylistFeaturedArtist">
                                    <Button Classes="featured-artist-tile"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="8"
                                            Padding="4,5"
                                            MinHeight="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Cursor="Hand"
                                            Command="{Binding $parent[UserControl].((vm:PlaylistViewModel)DataContext).ViewArtistCommand}"
                                            CommandParameter="{Binding Name}">
                                        <Grid ColumnDefinitions="44,*">
                                            <Border Grid.Column="0"
                                                    Width="44" Height="44"
                                                    CornerRadius="22"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource ArtworkPlaceholderBackground}">
                                                <Panel>
                                                    <controls:CachedImage SourcePath="{Binding ImagePath}"
                                                                          Stretch="UniformToFill"
                                                                          Width="44" Height="44"
                                                                          IsVisible="{Binding ImagePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    <PathIcon Data="{StaticResource ArtistsIcon}"
                                                              Width="18" Height="18"
                                                              Foreground="{DynamicResource SecondaryTextBrush}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              IsVisible="{Binding ImagePath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                                </Panel>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.85"
                                                       VerticalAlignment="Center"
                                                       Margin="11,0,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Suggested songs: library-only picks from this playlist's artists -->
                    <StackPanel Margin="0,22,0,0"
                                IsVisible="{Binding HasSuggestions}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{loc:T Playlist.SUGGESTED}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Opacity="0.6"
                                       LetterSpacing="1"
                                       Margin="2,0,0,0"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:T Playlist.FromLibraryBasedArtistsTip}" />
                            <Button Grid.Column="1"
                                    Classes="featured-header"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4,2"
                                    MinHeight="0"
                                    Cursor="Hand"
                                    ToolTip.Tip="{loc:T Playlist.RefreshSuggestionsTip}"
                                    Command="{Binding RefreshSuggestionsCommand}">
                                <TextBlock Text="{loc:T Playlist.Text3}"
                                           FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                           FontSize="11"
                                           Opacity="0.55" />
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding SuggestedTracks}"
                                      Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:Track">
                                    <Grid ColumnDefinitions="44,*,Auto" Margin="4,3">
                                        <Border Grid.Column="0"
                                                Width="36" Height="36"
                                                CornerRadius="5"
                                                ClipToBounds="True"
                                                VerticalAlignment="Center"
                                                Background="#18FFFFFF">
                                            <Panel>
                                                <PathIcon Data="{StaticResource SongsIcon}"
                                                          Width="14" Height="14"
                                                          Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          IsVisible="{Binding !HasAlbumArt}" />
                                                <controls:CachedImage SourcePath="{Binding AlbumArtworkPath}"
                                                                      DecodeWidth="256"
                                                                      Stretch="UniformToFill"
                                                                      IsVisible="{Binding HasAlbumArt}" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,8,0"
                                                    Spacing="1">
                                            <!-- Auto/Auto keeps the badge hard against the end of the
                                                 title (as in the Songs rows) instead of parked at the
                                                 far edge; MaxWidth trims long titles so the badge is
                                                 never pushed out of the 320px rail. -->
                                            <Grid ColumnDefinitions="Auto,Auto" HorizontalAlignment="Left">
                                                <TextBlock Grid.Column="0"
                                                           Classes="one-line-explicit-title"
                                                           Text="{Binding TitleDisplay}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           MaxWidth="140" />
                                                <Border Grid.Column="1"
                                                        Classes="explicit-badge compact"
                                                        Margin="6,0,0,0"
                                                        IsVisible="{Binding IsExplicit}"
                                                        ToolTip.Tip="{loc:T Playlist.ExplicitTip}">
                                                    <TextBlock Text="E"
                                                               Classes="explicit-badge-text compact"
                                                               FontSize="8"
                                                               Opacity="0.9" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding ArtistDisplay}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.55"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Classes="suggest-add"
                                                Padding="0"
                                                Width="24" Height="24"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                ToolTip.Tip="{loc:T Playlist.AddPlaylistTip}"
                                                Command="{Binding $parent[UserControl].((vm:PlaylistViewModel)DataContext).AddSuggestedCommand}"
                                                CommandParameter="{Binding}">
                                            <PathIcon Data="{StaticResource AddIcon}"
                                                      Width="11" Height="11"
                                                      Opacity="0.8" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Panel>

</UserControl>
