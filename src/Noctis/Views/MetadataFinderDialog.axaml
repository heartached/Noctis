<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
        xmlns:vm="using:Noctis.ViewModels"
        xmlns:controls="using:Noctis.Controls"
        x:Class="Noctis.Views.MetadataFinderDialog"
        x:DataType="vm:MetadataFinderViewModel"
        Title="{loc:T MetadataFinder.FindMetadata}"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- Header "Identify all" pill: the editor's header "Find online" pill (pill-secondary
             with an accent search glyph). BorderThickness is set on the button itself, as
             there: pill-secondary, loaded by the host and so nearer the button, sets it to 0. -->
        <Style Selector="Button.mf-header-action">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Result rows: filled pill-well cards; a ticked row gets the accent ring, like the
             picked result card in Find online. The 1.5px ring is always there (transparent
             when unticked) so ticking only recolours it and nothing shifts. -->
        <Style Selector="Border.mf-row">
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.mf-row.on">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
        </Style>
        <Style Selector="TextBlock.mf-label">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- Footer status, as the editor's change summary. -->
        <Style Selector="TextBlock.mf-status">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
    </Window.Styles>

    <!-- Owner 10-08: same UI + animation for search metadata. The same rounded pill pop-up as
         the Metadata editor: PillDialogHost draws the blurred, dimmed app behind, the card
         with its shadow, and plays the open/close animation (every close path — Cancel, Esc,
         the view model's Closed, Alt+F4 — animates out once before the real close).
         MaxHeight, not Height: the card shrinks with a short window (the main window's
         MinHeight is 500) and with a short list, and stays bounded so the list virtualizes. -->
    <controls:PillDialogHost>

    <Grid Width="760" MaxHeight="680" RowDefinitions="Auto,*,Auto">

        <!-- Header: title with the sources behind ⓘ, the one-line purpose under it, and
             Identify all where the editor has Find online. -->
        <Border Grid.Row="0"
                Padding="28,22,28,16"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="56,16,*,Auto">
                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="18" Classes="pill-well">
                    <PathIcon Data="{StaticResource TagIcon}" Width="22" Height="22" Opacity="0.6"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{loc:T MetadataFinder.FindMetadata}" FontSize="18" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <PathIcon x:Name="SourcesInfo"
                                  Data="{StaticResource InfoIcon}" Width="14" Height="14" Opacity="0.45"
                                  Background="Transparent" VerticalAlignment="Center"
                                  ToolTip.Tip="{Binding SourceHint}" />
                    </StackPanel>
                    <TextBlock Text="{loc:T MetadataFinder.IdentifyPoorlyTaggedTracks}"
                               FontSize="13" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="3"
                        Classes="pill-secondary mf-header-action"
                        BorderThickness="1.5"
                        MinHeight="36"
                        Padding="16,0"
                        FontSize="12.5"
                        VerticalAlignment="Center"
                        Command="{Binding IdentifyAllCommand}"
                        IsEnabled="{Binding !IsBusy}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource SearchIcon}" Width="12" Height="12"
                                  Foreground="{DynamicResource AccentColorBrush}" />
                        <TextBlock Text="{loc:T MetadataFinder.IdentifyAll}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Footer: status on the left, Cancel / Apply on the right (the editor's Cancel / Save). -->
        <Border Grid.Row="2"
                Padding="28,14"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Classes="mf-status" Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                <!-- Cancel stops a running identify; otherwise it closes. -->
                <Button Grid.Column="1"
                        Classes="pill-secondary"
                        Content="{loc:T Metadata.Cancel}"
                        Command="{Binding CancelCommand}"
                        MinWidth="108"
                        Margin="0,0,10,0" />
                <Button Grid.Column="2"
                        Classes="pill-primary"
                        Content="{loc:T MetadataFinder.Apply}"
                        Command="{Binding ApplySelectedCommand}"
                        IsEnabled="{Binding HasSelection}"
                        MinWidth="108" />
            </Grid>
        </Border>

        <!-- Nothing poorly tagged: say so where the list would be. -->
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   IsVisible="{Binding !HasRows}"
                   FontSize="13" Opacity="0.5"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="28,48" />

        <!-- Right padding is the overlay scrollbar's lane, so it never sits on a row. -->
        <ScrollViewer Grid.Row="1"
                      IsVisible="{Binding HasRows}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      Padding="28,16,28,8">
            <ItemsControl ItemsSource="{Binding Rows}">
                <!-- Virtualized: every poorly tagged track is a row, so a messy library
                     built thousands of cards on open. -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MetadataFinderViewModel+MetaRow">
                        <Border Classes="pill-well mf-row" Classes.on="{Binding Apply}"
                                CornerRadius="18" Padding="14,12,18,14" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*">
                                <CheckBox Grid.Column="0" Classes="metadata-pill-checkbox"
                                          Padding="0" MinWidth="0" MinHeight="0"
                                          IsChecked="{Binding Apply}" IsEnabled="{Binding HasProposal}"
                                          VerticalAlignment="Top" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Status}" FontSize="12.5" FontWeight="SemiBold"
                                                   Opacity="0.75" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding ConfidenceText}" FontSize="11.5" Opacity="0.55"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,28,*">
                                        <StackPanel Grid.Column="0" Spacing="1">
                                            <TextBlock Classes="mf-label" Text="{loc:T MetadataFinder.Current}" />
                                            <TextBlock Text="{Binding CurrentTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CurrentArtist}" FontSize="11.5" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CurrentAlbum}" FontSize="11.5" Opacity="0.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="→" FontSize="13" Opacity="0.4"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <!-- The proposal carries the accent, as changed values do in Find online. -->
                                        <StackPanel Grid.Column="2" Spacing="1">
                                            <TextBlock Classes="mf-label" Text="{loc:T MetadataFinder.Proposed}" />
                                            <TextBlock Text="{Binding ProposedTitle}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentColorBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ProposedArtist}" FontSize="11.5" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ProposedAlbum}" FontSize="11.5" Opacity="0.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
    </controls:PillDialogHost>
</Window>
