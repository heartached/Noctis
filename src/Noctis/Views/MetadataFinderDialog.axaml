<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
        xmlns:vm="using:Noctis.ViewModels"
        x:Class="Noctis.Views.MetadataFinderDialog"
        x:DataType="vm:MetadataFinderViewModel"
        Title="{loc:T MetadataFinder.FindMetadata}"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- Neutral pill buttons share the Settings pill outline (1.5px translucent mid-grey,
             layout-rounded); the Fluent template swaps BorderBrush on hover/press, so pin it. -->
        <Style Selector="Button.pill-outline">
            <Setter Property="BorderBrush" Value="#99A0A0A8" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
        <Style Selector="Button.pill-outline:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.pill-outline:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#99A0A0A8" />
        </Style>
        <!-- Round header X (same look as the Settings header close). -->
        <Style Selector="Button.dialog-close">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}" />
        </Style>
        <Style Selector="Button.dialog-close:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <!-- Quiet secondary actions in the sticky bar: no fill, no border, dims until hovered.
             The Fluent template paints a hover fill on the presenter, so pin it transparent. -->
        <Style Selector="Button.text-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.text-btn:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.text-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.text-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Window.Styles>

    <Border Background="#50000000">
        <Border CornerRadius="20"
                ClipToBounds="True"
                Background="{DynamicResource AppMainBackground}"
                Width="760"
                MaxHeight="820"
                Margin="0,50"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                BoxShadow="0 8 32 0 #80000000, 0 0 0 1 #33FFFFFF">
            <DockPanel>
                <!-- Header: centred title + one-line description (+ source line), round X at the top-right. -->
                <Panel DockPanel.Dock="Top" Margin="24,18,18,8">
                    <StackPanel Spacing="2" Margin="34,2,34,0">
                        <TextBlock Text="{loc:T MetadataFinder.FindMetadata}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:T MetadataFinder.IdentifyPoorlyTaggedTracks}"
                                   FontSize="12" Opacity="0.6" HorizontalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SourceHint}" FontSize="11" Opacity="0.5" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Classes="dialog-close" Command="{Binding CancelCommand}"
                            ToolTip.Tip="{loc:T Common.Close}"
                            HorizontalAlignment="Right" VerticalAlignment="Top">
                        <PathIcon Data="{StaticResource DismissIcon}" Width="12" Height="12" />
                    </Button>
                </Panel>

                <!-- Sticky bar: status on the left, quiet Identify all, one primary on the right. -->
                <Border DockPanel.Dock="Bottom" Padding="24,12,24,16"
                        Background="#09FFFFFF"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                                   FontSize="13" Opacity="0.8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Content="{loc:T MetadataFinder.IdentifyAll}" Command="{Binding IdentifyAllCommand}"
                                IsEnabled="{Binding !IsBusy}" Classes="text-btn"
                                VerticalAlignment="Center" Margin="12,0,8,0" />
                        <Button Grid.Column="2" Content="{loc:T MetadataFinder.Apply}" Command="{Binding ApplySelectedCommand}"
                                IsEnabled="{Binding HasSelection}"
                                Padding="22,10"
                                Classes="accent-btn"
                                Background="{DynamicResource AccentButtonBackground}"
                                Foreground="{DynamicResource AccentForegroundBrush}"
                                FontWeight="SemiBold"
                                HorizontalContentAlignment="Center" CornerRadius="999" Cursor="Hand" />
                    </Grid>
                </Border>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              Padding="24,4,24,8">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <!-- Virtualized: every poorly tagged track is a row, so a messy library
                             built thousands of cards on open. -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MetadataFinderViewModel+MetaRow">
                                <Border Background="#10FFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding Apply}" IsEnabled="{Binding HasProposal}"
                                                  VerticalAlignment="Top" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Opacity="0.7" />
                                                <TextBlock Grid.Column="1" Text="{Binding ConfidenceText}" FontSize="11" Opacity="0.6" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,16,*">
                                                <StackPanel Grid.Column="0" Spacing="1">
                                                    <TextBlock Text="{loc:T MetadataFinder.Current}" FontSize="10" Opacity="0.5" />
                                                    <TextBlock Text="{Binding CurrentTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding CurrentArtist}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding CurrentAlbum}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center" Opacity="0.5" />
                                                <StackPanel Grid.Column="2" Spacing="1">
                                                    <TextBlock Text="{loc:T MetadataFinder.Proposed}" FontSize="10" Opacity="0.5" />
                                                    <TextBlock Text="{Binding ProposedTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ProposedArtist}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ProposedAlbum}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Border>
</Window>
