<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
        xmlns:vm="using:Noctis.ViewModels"
        x:Class="Noctis.Views.AudioConverterDialog"
        x:DataType="vm:AudioConverterViewModel"
        Title="{loc:T AudioConverter.Convert}"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBox.pill">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="TextBox.pill /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="ComboBox.pill">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
        <!-- Pill-shaped hover/selection highlight for dropdown items, matching the
             rounded menu highlight used elsewhere. Margin insets each row so the pill
             floats; CornerRadius on the content presenter clips it to a pill. -->
        <Style Selector="ComboBox.pill ComboBoxItem">
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="ComboBox.pill ComboBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="999" />
        </Style>
    </Window.Styles>

    <Border Background="#50000000">
        <Border CornerRadius="20"
                ClipToBounds="True"
                Background="{DynamicResource AppMainBackground}"
                Width="680"
                MaxHeight="820"
                Margin="0,50"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                BoxShadow="0 8 32 0 #80000000, 0 0 0 1 #33FFFFFF">
            <DockPanel>
                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="24,20,24,8" Spacing="2">
                    <TextBlock Text="{Binding TitleText}"
                               FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:T AudioConverter.TranscodeSelectedTracksAnother}"
                               FontSize="12" Opacity="0.6"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Footer -->
                <Border DockPanel.Dock="Bottom" Padding="24,12,24,16">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                                   FontSize="12" Opacity="0.7" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1"
                                Content="{loc:T AudioConverter.Cancel}"
                                Command="{Binding CancelCommand}"
                                Width="100" Padding="0,8"
                                FontWeight="Bold"
                                HorizontalContentAlignment="Center"
                                CornerRadius="999"
                                Margin="0,0,8,0"
                                Cursor="Hand" />
                        <Button Grid.Column="2"
                                Content="{loc:T AudioConverter.Convert}"
                                Command="{Binding StartCommand}"
                                IsEnabled="{Binding !IsConverting}"
                                Width="100" Padding="0,8"
                                Classes="accent-btn"
                                Background="{DynamicResource AccentButtonBackground}"
                                Foreground="{DynamicResource AccentForegroundBrush}"
                                FontWeight="SemiBold"
                                HorizontalContentAlignment="Center"
                                CornerRadius="999"
                                Cursor="Hand" />
                    </Grid>
                </Border>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Padding="24,4,24,8">
                    <StackPanel Spacing="14">

                        <!-- Format + bitrate -->
                        <Grid ColumnDefinitions="140,*">
                            <TextBlock Grid.Column="0" Text="{loc:T AudioConverter.Format}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Classes="pill"
                                      ItemsSource="{Binding FormatOptions}"
                                      SelectedItem="{Binding SelectedFormat}"
                                      HorizontalAlignment="Stretch" />
                        </Grid>

                        <Grid ColumnDefinitions="140,*" IsVisible="{Binding BitrateApplies}">
                            <TextBlock Grid.Column="0" Text="{loc:T AudioConverter.BitrateKbps}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Classes="pill"
                                      ItemsSource="{Binding BitrateOptions}"
                                      SelectedItem="{Binding SelectedBitrate}"
                                      HorizontalAlignment="Stretch" />
                        </Grid>

                        <Grid ColumnDefinitions="140,*" IsVisible="{Binding BitDepthApplies}">
                            <TextBlock Grid.Column="0" Text="{loc:T AudioConverter.BitDepth}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Classes="pill"
                                      ItemsSource="{Binding BitDepthOptions}"
                                      SelectedItem="{Binding SelectedBitDepth}"
                                      HorizontalAlignment="Stretch" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.5" />

                        <!-- Output folder -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:T AudioConverter.OutputFolder}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:T AudioConverter.LeaveBlankWriteNext}"
                                       FontSize="11" Opacity="0.55" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Classes="pill"
                                         Text="{Binding OutputFolder}"
                                         Watermark="{loc:T AudioConverter.BesideSourceFile}" />
                                <Button Grid.Column="1" Content="{loc:T AudioConverter.Browse}"
                                        Click="OnBrowseOutputClick"
                                        Padding="14,8"
                                        CornerRadius="999"
                                        Margin="8,0,0,0"
                                        Cursor="Hand" />
                            </Grid>
                        </StackPanel>

                        <!-- Filename pattern -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:T AudioConverter.FilenamePattern}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:T AudioConverter.TokensArtistAlbumartistAlbum}"
                                       FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                            <TextBox Classes="pill" Text="{Binding FilenamePattern}" />
                        </StackPanel>

                        <!-- Options -->
                        <StackPanel Spacing="6">
                            <CheckBox Classes="metadata-pill-checkbox" IsChecked="{Binding CopyTags}" Content="{loc:T AudioConverter.CopyTagsFromSource}" />
                            <CheckBox Classes="metadata-pill-checkbox" IsChecked="{Binding EmbedArtwork}" Content="{loc:T AudioConverter.EmbedSourceArtwork}" />
                            <CheckBox Classes="metadata-pill-checkbox" IsChecked="{Binding OverwriteExisting}" Content="{loc:T AudioConverter.OverwriteExistingOutputFiles}" />
                            <CheckBox Classes="metadata-pill-checkbox" IsChecked="{Binding AddToLibrary}" Content="{loc:T AudioConverter.AddLibraryShowApp}" />
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.5" />

                        <!-- Job list -->
                        <TextBlock Text="{loc:T AudioConverter.Queue}" FontSize="13" FontWeight="SemiBold" Opacity="0.75" />
                        <Border Background="#10FFFFFF" CornerRadius="8" Padding="10" MaxHeight="220">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Jobs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AudioConverterViewModel+JobRow">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <StackPanel Grid.Column="0" Spacing="1">
                                                    <TextBlock Text="{Binding TrackTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding TrackSubtitle}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" VerticalAlignment="Center"
                                                           Margin="12,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Border>
</Window>
