<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="using:Noctis.Helpers"
             xmlns:loc="using:Noctis.Localization"
             xmlns:vm="using:Noctis.ViewModels"
             xmlns:views="using:Noctis.Views"
             xmlns:studio="using:Noctis.Services.LyricsStudio"
             x:Class="Noctis.Views.LyricsStudioPanel"
             x:DataType="vm:LyricsStudioViewModel">

    <!-- The Lyrics Studio surface: header, queue | review body, and the model/run footer.
         Hosted two ways — inside LyricsStudioDialog (per-song right-click) and as the sidebar's
         Lyrics Studio page (LyricsStudioView), which hides the header and draws its own. -->

    <UserControl.Styles>
        <Style Selector="Border.queue-row">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="ListBox.queue ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <!-- The song on review keeps a quiet fill: the app-wide list style clears every selected
             row, which left no mark of which song was open (09-24). -->
        <Style Selector="ListBox.queue ListBoxItem:selected /template/ ContentPresenter,
                         ListBox.queue ListBoxItem:selected:pointerover /template/ ContentPresenter,
                         ListBox.queue ListBoxItem:selected:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="#1CFFFFFF" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <!-- Narrow windows (09-24). The review's action buttons and whole-song tools drop onto a
             row of their own (and wrap) instead of drawing over the title and source pill, and the
             queue gives up some width. Placement comes from styles so the queries can move it. -->
        <Style Selector="Border.studio-queue">
            <Setter Property="Width" Value="320" />
        </Style>
        <ContainerQuery Name="StudioBody" Query="max-width:900">
            <Style Selector="Border.studio-queue">
                <Setter Property="Width" Value="250" />
            </Style>
        </ContainerQuery>
        <Style Selector="WrapPanel.review-actions, WrapPanel.review-tools">
            <Setter Property="Grid.Column" Value="1" />
        </Style>
        <ContainerQuery Name="ReviewHead" Query="max-width:600">
            <Style Selector="WrapPanel.review-actions">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.ColumnSpan" Value="2" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>
        </ContainerQuery>
        <ContainerQuery Name="ReviewMeta" Query="max-width:860">
            <Style Selector="WrapPanel.review-tools">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.ColumnSpan" Value="2" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>
        </ContainerQuery>
        <Style Selector="Border.review-line">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.review-line.low">
            <Setter Property="Background" Value="#22E5A34D" />
        </Style>
        <!-- An ELRC row edit that was refused (bad or backwards time): the line kept its words. -->
        <Style Selector="Border.review-line.edit-error">
            <Setter Property="Background" Value="#22FF6B6B" />
        </Style>
        <Style Selector="Button.time-pill">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- Review rows: every time pill the same width, text centred, so the lyric column
             starts at one x whatever the digits (an Auto column sized each pill to its own
             text and rows read as staggered, user 09-20). -->
        <Style Selector="Button.time-pill.line-time">
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.line-edit">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBox.line-edit:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#18FFFFFF" />
        </Style>
        <Style Selector="Button.word-chip">
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Button.word-chip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#26FFFFFF" />
        </Style>
        <Style Selector="Button.word-chip.selected">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
        </Style>
        <Style Selector="Button.word-chip.selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        </Style>
        <Style Selector="Button.word-chip.target">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Button.word-chip.tapped TextBlock.chip-time">
            <Setter Property="Foreground" Value="{DynamicResource AccentColorBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.word-toggle">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Button.word-toggle:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- Pill outline shared with Settings (SettingsView "(not set)" box): 1.5px translucent
             mid-grey, layout-rounded. The Fluent templates restyle the border on hover/focus/press,
             so the template parts are pinned too. Neutral buttons opt in via .pill-outline. -->
        <!-- Model / Language pills: the Settings "System language" pill — the same 1.5px
             translucent mid-grey rim SettingsView pins on every ComboBox (#99A0A0A8, hover
             included, accent while open), rounded full, with pill dropdown items. -->
        <Style Selector="ComboBox.pill">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderBrush" Value="#99A0A0A8" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
        <Style Selector="ComboBox.pill:pointerover /template/ Border#Background">
            <Setter Property="BorderBrush" Value="#99A0A0A8" />
        </Style>
        <Style Selector="ComboBox.pill:focus /template/ Border#Background, ComboBox.pill:dropdownopen /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
        </Style>
        <!-- Options dropdown: same rim and fill as the two pills beside it. Fluent paints a
             Button's chrome on the presenter, so hover/press are pinned there. No zoom on
             hover or press (user ask 09-19): the app-wide Button:pointerover scale is undone. -->
        <!-- One button size across the Studio (09-23): every toolbar, review and lyrics-box
             button is this pill; .accent-btn / .pill-outline only change its fill and rim. -->
        <Style Selector="Button.studio-btn">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.studio-btn:pointerover, Button.studio-btn:pressed">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <!-- Format chips (toolbar): the Choose songs picker's chips, accent while chosen. -->
        <Style Selector="ToggleButton.format-chip">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.format-chip /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="ToggleButton.format-chip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ChipHoverBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="ToggleButton.format-chip:checked /template/ ContentPresenter,
                         ToggleButton.format-chip:checked:pointerover /template/ ContentPresenter,
                         ToggleButton.format-chip:checked:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        </Style>
        <Style Selector="ToggleButton.format-chip:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="Button.studio-options">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="#99A0A0A8" />
            <Setter Property="Background" Value="{DynamicResource ComboBoxBackground}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
        <Style Selector="Button.studio-options:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.studio-options:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#99A0A0A8" />
            <Setter Property="Background" Value="{DynamicResource ComboBoxBackgroundPointerOver}" />
        </Style>
        <Style Selector="Button.studio-options:pointerover, Button.studio-options:pressed">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <!-- Chromeless presenter for the Options flyout (MetadataWindow search-pop recipe):
             the card inside draws the chrome. -->
        <Style Selector="FlyoutPresenter.studio-options-pop">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="ComboBox.pill /template/ Border#Background">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="BorderBrush" Value="#99A0A0A8" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
        <Style Selector="ComboBox.pill /template/ Border#HighlightBackground">
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="ComboBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <!-- Queue rows: artist in the accent like the island, title with the island's hover wash. -->
        <Style Selector="Border.title-hover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Margin" Value="-2,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.title-hover:pointerover">
            <Setter Property="Background" Value="#22FFFFFF" />
        </Style>
        <Style Selector="Button.pill-outline">
            <Setter Property="BorderBrush" Value="#99A0A0A8" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
        <Style Selector="Button.pill-outline:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.pill-outline:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#99A0A0A8" />
        </Style>
        <!-- Round X close, the Settings sheet's recipe (SettingsView Button.settings-close). -->
        <Style Selector="Button.dialog-close">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}" />
        </Style>
        <Style Selector="Button.dialog-close:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <!-- Footer option boxes: the metadata editor's animated pill checkbox, one size down.
             The circle's 1.5px ring is pinned to whole pixels and does not grow on hover: the
             scaled ring landed on half pixels and read as clipped at one edge (user, 09-19). -->
        <Style Selector="CheckBox.metadata-pill-checkbox.studio-option">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
        <Style Selector="CheckBox.metadata-pill-checkbox.studio-option:pointerover /template/ Border#IndicatorBorder">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Header (the sidebar page draws its own and hides this one) -->
        <Grid DockPanel.Dock="Top" Margin="24,18,24,10" ColumnDefinitions="*,Auto"
              IsVisible="{Binding $parent[views:LyricsStudioPanel].ShowHeader}">
            <StackPanel Grid.Column="0" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{loc:T LyricsStudio.Title}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                    <!-- Same "Beta" pill as the sidebar page's header title. -->
                    <Border CornerRadius="999" Padding="6,0,6,1" Margin="0,1,0,0" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="1.5" UseLayoutRounding="True">
                        <TextBlock Text="{loc:T LyricsStudio.Beta}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentColorBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{loc:T LyricsStudio.Subtitle}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Classes="dialog-close" Command="{Binding CloseCommand}"
                    ToolTip.Tip="{loc:T Settings.CloseTip}" VerticalAlignment="Top" Margin="12,0,0,0">
                <PathIcon Data="{StaticResource DismissIcon}" Width="12" Height="12" />
            </Button>
        </Grid>

        <!-- Toolbar, above the editor it drives (was a footer under the queue, 09-23): the format
             to write, the Settings popover (model, language, run options), then Download / Start /
             Stop. The format is chosen here before a run, not buried in the options. -->
        <StackPanel DockPanel.Dock="Top" Margin="24,0,24,12" Spacing="10">
            <!-- ffmpeg missing -->
            <Border CornerRadius="10" Padding="12,8" Background="#26FF6B6B" IsVisible="{Binding !HasFfmpeg}">
                <TextBlock Text="{loc:T LyricsStudio.NeedsFfmpeg}" FontSize="12" TextWrapping="Wrap" />
            </Border>
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="{loc:T LyricsStudio.Format}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ToggleButton Classes="format-chip" Content="{loc:T LyricsStudioPicker.WordTimings}"
                                  IsChecked="{Binding WordTimings}" IsEnabled="{Binding !IsRunning}" />
                    <ToggleButton Classes="format-chip" Content="{loc:T LyricsStudioPicker.LineTimings}"
                                  IsChecked="{Binding LineTimings}" IsEnabled="{Binding !IsRunning}" />
                </StackPanel>
                <!-- Settings: the model, language and run options behind one popover (09-23). -->
                <Button Grid.Column="2" Classes="studio-btn studio-options" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{loc:T LyricsStudio.Settings}" VerticalAlignment="Center" />
                        <PathIcon Data="{StaticResource ChevronDownThinIcon}" Width="10" Height="10" Opacity="0.7" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="Standard" FlyoutPresenterClasses="studio-options-pop"
                                helpers:DropDownFlyoutMotion.Enable="True">
                            <!-- Sized to its longest option (a fixed 360 clipped "· Experimental"). -->
                            <Border CornerRadius="16" Padding="18,14" MinWidth="360"
                                    Background="{DynamicResource ComboBoxDropDownBackground}"
                                    BorderBrush="{DynamicResource ComboBoxDropDownBorderBrush}" BorderThickness="1"
                                    BoxShadow="0 10 30 0 #90000000">
                                <StackPanel Spacing="12">
                                    <!-- Model status ("Medium installed", download progress) sits on the label. -->
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{loc:T LyricsStudio.Model}" FontSize="11" Opacity="0.55" />
                                            <TextBlock Text="·" FontSize="11" Opacity="0.55" />
                                            <TextBlock Text="{Binding ModelStatusText}" FontSize="11" Opacity="0.55"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="230" ToolTip.Tip="{Binding ModelStatusText}" />
                                            <ProgressBar Value="{Binding ModelProgress}" Minimum="0" Maximum="1" Width="48" Height="3" CornerRadius="2"
                                                         VerticalAlignment="Center" IsVisible="{Binding IsDownloadingModel}" />
                                        </StackPanel>
                                        <ComboBox Classes="pill" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding SelectedModel}" IsEnabled="{Binding !IsRunning}">
                                                <ComboBox.SelectionBoxItemTemplate>
                                                    <DataTemplate x:DataType="studio:WhisperModelInfo">
                                                        <TextBlock Text="{Binding DisplayName}" />
                                                    </DataTemplate>
                                                </ComboBox.SelectionBoxItemTemplate>
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="studio:WhisperModelInfo">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding DisplayName}" />
                                                            <TextBlock Text="{Binding SizeText}" Opacity="0.5" FontSize="11" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{loc:T LyricsStudio.Language}" FontSize="11" Opacity="0.55" />
                                        <ComboBox Classes="pill" HorizontalAlignment="Stretch" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" />
                                    </StackPanel>
                                    <Border Height="1" Background="#14FFFFFF" />
                                    <CheckBox Classes="metadata-pill-checkbox studio-option" IsChecked="{Binding SkipAlreadyTimed}" Content="{loc:T LyricsStudio.SkipAlreadyTimed}"
                                              ToolTip.Tip="{loc:T LyricsStudio.SkipAlreadyTimedTip}" />
                                    <CheckBox Classes="metadata-pill-checkbox studio-option" IsChecked="{Binding OnlineLyrics}" Content="{loc:T LyricsStudio.OnlineLyrics}"
                                              ToolTip.Tip="{loc:T LyricsStudio.OnlineLyricsTip}" />
                                    <CheckBox Classes="metadata-pill-checkbox studio-option" IsChecked="{Binding EmbedTags}" Content="{loc:T LyricsStudioSettings.EmbedTags}"
                                              ToolTip.Tip="{loc:T LyricsStudioSettings.EmbedTagsHint}" />
                                    <CheckBox Classes="metadata-pill-checkbox studio-option" IsChecked="{Binding TranscribeOnly}" Content="{loc:T LyricsStudio.TranscribeOnly}"
                                              ToolTip.Tip="{loc:T LyricsStudio.TranscribeOnlyTip}" />
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBlock Grid.Column="3" Text="{Binding ModelStatusText}" FontSize="11.5" Opacity="0.5" Margin="6,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ModelStatusText}" />
                <Button Grid.Column="4" Command="{Binding DownloadModelCommand}" IsVisible="{Binding ShowModelDownload}"
                        Classes="studio-btn pill-outline">
                    <TextBlock Text="{loc:T LyricsStudio.DownloadModel}" />
                </Button>
                <Panel Grid.Column="5" VerticalAlignment="Center">
                    <Button Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" IsVisible="{Binding !IsRunning}"
                            Classes="studio-btn accent-btn" MinWidth="96" HorizontalContentAlignment="Center"
                            Background="{DynamicResource AccentButtonBackground}" Foreground="{DynamicResource AccentForegroundBrush}">
                        <TextBlock Text="{Binding StartLabel}" />
                    </Button>
                    <Button Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}"
                            Classes="studio-btn pill-outline" MinWidth="96" HorizontalContentAlignment="Center">
                        <TextBlock Text="{loc:T LyricsStudio.Stop}" />
                    </Button>
                </Panel>
            </Grid>
        </StackPanel>

        <!-- Body: queue | review -->
        <Grid ColumnDefinitions="Auto,*" Margin="24,0,24,8" ColumnSpacing="16" Container.Name="StudioBody" Container.Sizing="Width">
            <!-- Queue (width from the styles: narrower in a small window) -->
            <Border Grid.Column="0" Classes="studio-queue" CornerRadius="14" ClipToBounds="True" Background="#0CFFFFFF" Padding="8,8,0,8">
                <DockPanel>
                    <!-- Queue header: the list's title (plus "all LRC" when every row would say it),
                         Choose songs where it acts (page only, 09-23), and the run status under it. -->
                    <StackPanel DockPanel.Dock="Top" Margin="8,2,16,8" Spacing="4">
                        <!-- The note trims before it can reach under Choose songs (narrow queue, long translations). -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <DockPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock DockPanel.Dock="Left" Text="{loc:T LyricsStudio.Queue}" FontSize="11" Opacity="0.5" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding QueueFormatText}" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding QueueFormatText}" />
                            </DockPanel>
                            <Button Grid.Column="1" Classes="studio-btn pill-outline" Padding="12,4" FontSize="11.5"
                                    Content="{loc:T LyricsStudio.ChooseSongs}" ToolTip.Tip="{loc:T LyricsStudio.ChooseSongsTip}"
                                    IsVisible="{Binding $parent[views:LyricsStudioPanel].ShowChooseSongs}"
                                    Click="OnChooseSongsClick" />
                        </Grid>
                        <TextBlock Text="{Binding RunStatusText}" FontSize="11" Opacity="0.5"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RunStatusText}" />
                    </StackPanel>
                    <!-- Padding on the list (its ItemsPresenter margin) keeps the rows inset while the
                         scrollbar sits on the box's right edge instead of inside the padding. -->
                    <ListBox Classes="queue" ItemsSource="{Binding Queue}" SelectedItem="{Binding Selected}" Background="Transparent" Padding="0,0,8,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LyricsStudioViewModel+StudioItem">
                                <Border Classes="queue-row">
                                    <StackPanel Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <!-- Title cell: the E badge hugs the title (user ask 09-19). Auto,Auto keeps
                                                 them together; the LayoutUpdated handler caps the title's width so a long
                                                 one trims instead of pushing the badge out of the row. -->
                                            <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto" ClipToBounds="True"
                                                  LayoutUpdated="OnTitleCellLayoutUpdated">
                                                <Border Grid.Column="0" Classes="title-hover" Name="TitleBox">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <!-- Same E badge as the island's title. -->
                                                <Border Grid.Column="1" Name="ExplicitBadge"
                                                        Background="{DynamicResource IslandExplicitBadge}" CornerRadius="2" Padding="4,0" Height="14"
                                                        Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="{Binding Track.IsExplicit}"
                                                        ToolTip.Tip="{loc:T PlaybackBar.ExplicitTip}">
                                                    <TextBlock Text="E" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center"
                                                               Foreground="{DynamicResource IslandIconFill}" />
                                                </Border>
                                            </Grid>
                                            <PathIcon Grid.Column="1" Data="{StaticResource CheckmarkIcon}" Width="12" Height="12" Margin="6,0,0,0"
                                                      Foreground="{DynamicResource AccentColorBrush}" IsVisible="{Binding IsSaved}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource AccentColorBrush}" TextTrimming="CharacterEllipsis" />
                                        <!-- Work state once the song moves; before that its format, unless every row shares it. -->
                                        <Border CornerRadius="999" Padding="7,1" Background="#22FFFFFF" HorizontalAlignment="Left" Margin="0,2,0,0"
                                                IsVisible="{Binding ShowStatePill}">
                                            <TextBlock Text="{Binding StateText}" FontSize="10" Opacity="0.85" />
                                        </Border>
                                        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" Height="3" CornerRadius="2" IsVisible="{Binding IsWorking}" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" IsVisible="{Binding HasStatusText}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Review -->
            <Border Grid.Column="1" CornerRadius="14" ClipToBounds="True" Background="#0CFFFFFF" Padding="16,16,0,16">
                <Panel>
                    <StackPanel VerticalAlignment="Center" Spacing="6" Margin="0,0,16,0" IsVisible="{Binding ShowReviewEmpty}">
                        <TextBlock Text="{loc:T LyricsStudio.ReviewEmptyTitle}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" Opacity="0.7" />
                        <TextBlock Text="{loc:T LyricsStudio.ReviewEmptyBody}" FontSize="12" Opacity="0.5" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
                    </StackPanel>

                    <!-- The song on screen is being run: its stage and progress; Stop is in the toolbar. -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="0,0,16,0" Width="320"
                                IsVisible="{Binding IsSelectedWorking}">
                        <TextBlock Text="{Binding ReviewTitle}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Selected.StatusText}" FontSize="12" Opacity="0.6" TextAlignment="Center" />
                        <ProgressBar Value="{Binding Selected.Progress}" Minimum="0" Maximum="1" Height="4" CornerRadius="2" />
                    </StackPanel>

                    <!-- Lyrics box (09-23): a song with no timed lyrics yet. Paste lyrics (the default),
                         import a lyrics file, or — experimental — let the model listen and correct its
                         transcript here. Align then times the text; the result opens for review. -->
                    <DockPanel IsVisible="{Binding IsComposing}" Margin="0,0,16,0">
                        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding ReviewTitle}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ReviewSubtitle}" FontSize="12" Foreground="{DynamicResource AccentColorBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Text="{loc:T LyricsStudio.ComposeEmpty}" FontSize="13" FontWeight="SemiBold" Opacity="0.8" TextWrapping="Wrap"
                                       IsVisible="{Binding Selected.DraftText, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                            <TextBlock Text="{loc:T LyricsStudio.ComposeCheck}" FontSize="12" Opacity="0.6" TextWrapping="Wrap">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="Selected.DraftText" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                        <Binding Path="!Selected.IsTranscriptDraft" />
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                            <Border CornerRadius="10" Padding="12,8" Background="#22E5A34D" IsVisible="{Binding Selected.IsTranscriptDraft}">
                                <TextBlock Text="{loc:T LyricsStudio.TranscriptBanner}" FontSize="12" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" Margin="0,10,0,0">
                            <Button Grid.Column="0" Classes="studio-btn pill-outline" Command="{Binding ImportLyricsFileCommand}"
                                    IsEnabled="{Binding !IsRunning}" ToolTip.Tip="{loc:T LyricsStudio.ImportFileTip}">
                                <TextBlock Text="{loc:T LyricsStudio.ImportFile}" />
                            </Button>
                            <Button Grid.Column="1" Classes="studio-btn pill-outline" Command="{Binding TranscribeDraftCommand}"
                                    IsEnabled="{Binding CanTranscribeDraft}" ToolTip.Tip="{loc:T LyricsStudio.TranscribeDraftTip}">
                                <TextBlock Text="{loc:T LyricsStudio.TranscribeDraft}" />
                            </Button>
                            <TextBlock Grid.Column="2" Text="{Binding Selected.StatusText}" FontSize="11.5" Opacity="0.6" Margin="6,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Selected.StatusText}" />
                            <Button Grid.Column="3" Classes="studio-btn accent-btn" Command="{Binding AlignDraftCommand}"
                                    IsEnabled="{Binding CanAlignDraft}" ToolTip.Tip="{loc:T LyricsStudio.AlignTip}"
                                    Background="{DynamicResource AccentButtonBackground}" Foreground="{DynamicResource AccentForegroundBrush}">
                                <TextBlock Text="{loc:T LyricsStudio.Align}" />
                            </Button>
                        </Grid>
                        <TextBox Text="{Binding Selected.DraftText}" AcceptsReturn="True" TextWrapping="Wrap"
                                 PlaceholderText="{loc:T LyricsStudio.PasteWatermark}" VerticalContentAlignment="Top"
                                 CornerRadius="12" Padding="12,10" FontSize="13"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" IsEnabled="{Binding !IsRunning}" />
                    </DockPanel>

                    <DockPanel IsVisible="{Binding HasReview}">
                        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,16,10">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Container.Name="ReviewHead" Container.Sizing="Width">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <!-- Same title + E badge as the queue row; artist in the accent like the row (user ask 09-19). -->
                                    <Grid ColumnDefinitions="Auto,Auto" ClipToBounds="True" LayoutUpdated="OnTitleCellLayoutUpdated">
                                        <Border Grid.Column="0" Name="TitleBox">
                                            <TextBlock Text="{Binding ReviewTitle}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Border Grid.Column="1" Name="ExplicitBadge"
                                                Background="{DynamicResource IslandExplicitBadge}" CornerRadius="2" Padding="4,0" Height="14"
                                                Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding ReviewIsExplicit}"
                                                ToolTip.Tip="{loc:T PlaybackBar.ExplicitTip}">
                                            <TextBlock Text="E" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center"
                                                       Foreground="{DynamicResource IslandIconFill}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding ReviewSubtitle}" FontSize="12" Foreground="{DynamicResource AccentColorBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <WrapPanel Classes="review-actions" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                                    <Button Command="{Binding UpgradeToWordTimingsCommand}" IsVisible="{Binding ReviewCanUpgrade}"
                                            Classes="studio-btn accent-btn" ToolTip.Tip="{loc:T LyricsStudio.UpgradeTip}"
                                            Background="{DynamicResource AccentButtonBackground}" Foreground="{DynamicResource AccentForegroundBrush}">
                                        <TextBlock Text="{loc:T LyricsStudio.Upgrade}" />
                                    </Button>
                                    <!-- Plays the song on the real lyrics page with these unsaved timings (09-23). -->
                                    <Button Command="{Binding PreviewOnLyricsPageCommand}" IsVisible="{Binding CanPreview}"
                                            Classes="studio-btn pill-outline" ToolTip.Tip="{loc:T LyricsStudio.PreviewTip}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource PlayIcon}" Width="10" Height="10" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:T LyricsStudio.Preview}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SkipCommand}" Classes="studio-btn pill-outline">
                                        <TextBlock Text="{loc:T LyricsStudio.Skip}" />
                                    </Button>
                                    <Button Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"
                                            Classes="studio-btn accent-btn"
                                            Background="{DynamicResource AccentButtonBackground}" Foreground="{DynamicResource AccentForegroundBrush}">
                                        <TextBlock Text="{loc:T LyricsStudio.Save}" />
                                    </Button>
                                </WrapPanel>
                            </Grid>
                            <!-- Source + confidence on the left; whole-song timing tools on the right -->
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Container.Name="ReviewMeta" Container.Sizing="Width">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border CornerRadius="999" Padding="8,3" Background="#22FFFFFF" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ReviewSourceText}" FontSize="11" Opacity="0.85" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding ReviewConfidenceText}" FontSize="11" Opacity="0.55" VerticalAlignment="Center" />
                                </StackPanel>
                                <!-- Whole-song shift, labelled, with [ and ] as keys (09-23). -->
                                <WrapPanel Classes="review-tools" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T LyricsStudio.ShiftAllLines}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,2,0" />
                                    <Button Classes="studio-btn pill-outline" Command="{Binding NudgeEarlierCommand}" ToolTip.Tip="{loc:T LyricsStudio.NudgeEarlier}">
                                        <TextBlock Text="−0.1s" />
                                    </Button>
                                    <Button Classes="studio-btn pill-outline" Command="{Binding NudgeLaterCommand}" ToolTip.Tip="{loc:T LyricsStudio.NudgeLater}">
                                        <TextBlock Text="+0.1s" />
                                    </Button>
                                    <Button Classes="studio-btn pill-outline" Command="{Binding RedoAsTranscriptionCommand}" IsVisible="{Binding !ReviewIsTranscription}"
                                            IsEnabled="{Binding CanTranscribeDraft}" ToolTip.Tip="{loc:T LyricsStudio.RedoTip}" Margin="8,0,0,0">
                                        <TextBlock Text="{loc:T LyricsStudio.Redo}" />
                                    </Button>
                                </WrapPanel>
                            </Grid>
                            <Border CornerRadius="10" Padding="12,8" Background="{DynamicResource AccentButtonBackground}" IsVisible="{Binding IsTapping}">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="{Binding TapHint}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AccentForegroundBrush}" />
                                    <Button Grid.Column="1" Command="{Binding TapCommand}" Classes="studio-btn" Background="#33000000">
                                        <TextBlock Text="{loc:T LyricsStudio.Tap}" FontWeight="Bold" Foreground="{DynamicResource AccentForegroundBrush}" />
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding CancelTapCommand}" Classes="studio-btn" Background="#33000000">
                                        <TextBlock Text="{loc:T LyricsStudio.TapCancel}" Foreground="{DynamicResource AccentForegroundBrush}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
                            <ItemsControl ItemsSource="{Binding ReviewLines}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ReviewLine">
                                        <Border Classes="review-line" Classes.low="{Binding IsLow}" Classes.edit-error="{Binding HasEditError}">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <Button Grid.Column="0" Classes="time-pill line-time" VerticalAlignment="Center"
                                                            Command="{Binding $parent[views:LyricsStudioPanel].((vm:LyricsStudioViewModel)DataContext).PlayFromLineCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{loc:T LyricsStudio.PlayFromHere}">
                                                        <TextBlock Text="{Binding TimeText}" />
                                                    </Button>
                                                    <!-- ELRC: the line as saved, word tags included; Enter / focus loss reads it back, Esc undoes. -->
                                                    <TextBox Grid.Column="1" Classes="line-edit" Text="{Binding RowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                                             KeyDown="OnLineEditKeyDown" LostFocus="OnLineEditLostFocus" />
                                                    <Button Grid.Column="2" Classes="word-toggle" VerticalAlignment="Center"
                                                            Command="{Binding $parent[views:LyricsStudioPanel].((vm:LyricsStudioViewModel)DataContext).ToggleWordsCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{loc:T LyricsStudio.WordsTip}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" IsVisible="{Binding HasWordTimings}" Fill="{DynamicResource AccentColorBrush}" />
                                                            <PathIcon Data="{StaticResource ChevronDownThinIcon}" Width="10" Height="10" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <TextBlock Text="{Binding EditError}" IsVisible="{Binding HasEditError}" FontSize="11" Foreground="#FF6B6B"
                                                           TextWrapping="Wrap" Margin="82,0,0,0" />
                                                <!-- Word strip: one chip per word, click = select + hear it -->
                                                <StackPanel Spacing="6" Margin="4,0,0,2" IsVisible="{Binding IsExpanded}">
                                                    <ItemsControl ItemsSource="{Binding Words}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ReviewWord">
                                                                <Button Classes="word-chip" Margin="0,0,4,4"
                                                                        Classes.selected="{Binding IsSelected}" Classes.target="{Binding IsTapTarget}" Classes.tapped="{Binding IsTapped}"
                                                                        Command="{Binding $parent[views:LyricsStudioPanel].((vm:LyricsStudioViewModel)DataContext).SelectWordCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <StackPanel Spacing="1">
                                                                        <TextBlock Text="{Binding Text}" FontSize="12" />
                                                                        <TextBlock Classes="chip-time" Text="{Binding TimeText}" FontSize="9.5" Opacity="0.55" FontFamily="Consolas,Menlo,monospace" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button Classes="studio-btn pill-outline" Command="{Binding $parent[views:LyricsStudioPanel].((vm:LyricsStudioViewModel)DataContext).NudgeWordEarlierCommand}"
                                                                IsEnabled="{Binding $parent[views:LyricsStudioPanel].((vm:LyricsStudioViewModel)DataContext).HasSelectedWord}" ToolTip.Tip="{loc:T LyricsStudio.WordEarlier}">
                                                            <TextBlock Text="−50ms" />
                                                        </Button>
                                                        <Button Classes="studio-btn pill-outline" Command="{Binding $parent[views:LyricsStudioPanel].((vm:LyricsStudioViewModel)DataContext).NudgeWordLaterCommand}"
                                                                IsEnabled="{Binding $parent[views:LyricsStudioPanel].((vm:LyricsStudioViewModel)DataContext).HasSelectedWord}" ToolTip.Tip="{loc:T LyricsStudio.WordLater}">
                                                            <TextBlock Text="+50ms" />
                                                        </Button>
                                                        <Button Classes="studio-btn pill-outline" Command="{Binding $parent[views:LyricsStudioPanel].((vm:LyricsStudioViewModel)DataContext).StartTapCommand}"
                                                                CommandParameter="{Binding}" ToolTip.Tip="{loc:T LyricsStudio.TapTip}">
                                                            <TextBlock Text="{loc:T LyricsStudio.TapWords}" />
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Panel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
