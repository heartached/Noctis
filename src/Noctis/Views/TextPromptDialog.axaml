<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
        xmlns:controls="using:Noctis.Controls"
        x:Class="Noctis.Views.TextPromptDialog"
        Title="{loc:T TextPrompt.EnterName}"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False">

    <!-- Owner 11-05: the blurred app behind and the metadata editor's filled pill fields
         (it was a flat dark tint with outlined boxes, seen on Group into One Album).
         PillDialogHost draws the blurred, dimmed owner and the card, swallows clicks and
         wheel on the backdrop, and animates every close path. -->
    <controls:PillDialogHost>

        <StackPanel Width="352" Margin="24,20,24,18" Spacing="18">

            <StackPanel Spacing="10">
                <TextBlock x:Name="TitleText"
                           Text="{loc:T TextPrompt.Name}"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <!-- Field labels: shown only by the two-field form (ShowTwoAsync). -->
                <TextBlock x:Name="InputLabel"
                           FontSize="12"
                           Opacity="0.7"
                           IsVisible="False" />
                <TextBox x:Name="InputBox"
                         Classes="pill-field"
                         AutomationProperties.Name="{Binding #TitleText.Text}"
                         KeyDown="OnInputKeyDown" />
                <TextBlock x:Name="SecondLabel"
                           FontSize="12"
                           Opacity="0.7"
                           Margin="0,4,0,0"
                           IsVisible="False" />
                <TextBox x:Name="SecondBox"
                         Classes="pill-field"
                         AutomationProperties.Name="{Binding #SecondLabel.Text}"
                         IsVisible="False"
                         KeyDown="OnInputKeyDown" />
                <TextBlock x:Name="HintText"
                           FontSize="12"
                           Opacity="0.55"
                           TextWrapping="Wrap"
                           IsVisible="False" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="pill-secondary"
                        Content="{loc:T TextPrompt.Cancel}"
                        Click="OnCancelClick" />
                <Button x:Name="ConfirmButton"
                        Classes="pill-primary"
                        Content="OK"
                        Click="OnConfirmClick" />
            </StackPanel>
        </StackPanel>

    </controls:PillDialogHost>
</Window>
