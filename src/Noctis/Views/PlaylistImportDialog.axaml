<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Noctis.ViewModels"
        xmlns:loc="using:Noctis.Localization"
        xmlns:controls="using:Noctis.Controls"
        x:Class="Noctis.Views.PlaylistImportDialog"
        x:DataType="vm:PlaylistImportViewModel"
        Title="{loc:T Import.Title}"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.pi-label">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <!-- Footer status, as the editor's change summary. -->
        <Style Selector="TextBlock.pi-status">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <!-- Start panel: the drop target. The 1.5px ring is always there (transparent at
             rest) so a file dragged over only recolours it and nothing shifts. -->
        <Style Selector="Border.pi-drop">
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.pi-drop.drag">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
        </Style>

        <!-- Found / Missing chip on each row: a dot and the word on a faint tint. -->
        <Style Selector="Border.pi-chip">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="8,2,9,2" />
            <Setter Property="Background" Value="#293BB273" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pi-chip.missing">
            <Setter Property="Background" Value="#33F2A33A" />
        </Style>
        <Style Selector="Border.pi-chip Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="#3BB273" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pi-chip.missing Ellipse">
            <Setter Property="Fill" Value="#F2A33A" />
        </Style>
        <Style Selector="Border.pi-row.missing TextBlock.pi-title">
            <Setter Property="Opacity" Value="0.7" />
        </Style>

        <!-- Loading skeleton, as Find online's: a slow breath, keyed on [IsVisible=True] so a
             hidden skeleton's INFINITE clock doesn't keep ticking. -->
        <Style Selector="Border.pi-skel">
            <Setter Property="Background" Value="#17FFFFFF" />
        </Style>
        <Style Selector="StackPanel.pi-skeleton[IsVisible=True]">
            <Style.Animations>
                <Animation Duration="0:0:1.1" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.45" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <!-- Owner 10-08: the rounded pill pop-up of the Metadata editor / Find Metadata.
         PillDialogHost draws the blurred, dimmed app behind, the card with its shadow, and
         plays the open/close animation (every close path — Cancel, Esc, the view model's
         Closed, Alt+F4 — animates out once before the real close). MaxHeight, not Height:
         the card shrinks with a short list and stays bounded so the list virtualizes. -->
    <controls:PillDialogHost>

    <Grid Width="640" MaxHeight="680" RowDefinitions="Auto,*,Auto">

        <!-- Header: title and the one-line purpose. -->
        <Border Grid.Row="0"
                Padding="28,22,28,16"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="56,16,*">
                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="18" Classes="pill-well">
                    <controls:LineIcon x:Name="HeaderIcon" Data="{StaticResource MenuLineImport}" Width="22" Height="22" Opacity="0.6"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Import.Title}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="{loc:T Import.Subtitle}"
                               FontSize="13" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer: status on the left, Cancel / Create playlist on the right. -->
        <Border Grid.Row="2"
                Padding="28,14"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Classes="pi-status" Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"
                           ToolTip.Tip="{Binding StatusMessage}" />
                <Button Grid.Column="1"
                        Classes="pill-secondary"
                        Content="{Binding CancelLabel}"
                        Command="{Binding CloseCommand}"
                        MinWidth="108"
                        Margin="0,0,10,0" />
                <Button Grid.Column="2"
                        Classes="pill-primary"
                        Content="{loc:T Import.CreatePlaylist}"
                        Command="{Binding CreateCommand}"
                        IsEnabled="{Binding CanCreate}"
                        MinWidth="108" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*">

            <!-- Source: paste a link (imports as soon as it is complete) or pick a file. -->
            <StackPanel Grid.Row="0" Spacing="10" Margin="28,20,28,0">
                <Grid ColumnDefinitions="*,8,Auto,8,Auto">
                    <TextBox x:Name="LinkBox" Grid.Column="0" Classes="pill-field"
                             Text="{Binding LinkText}"
                             Watermark="{loc:T Import.LinkWatermark}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding ImportLinkCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="2" Classes="pill-primary" Width="40" Padding="0"
                            Command="{Binding ImportLinkCommand}"
                            IsEnabled="{Binding CanImportLink}"
                            ToolTip.Tip="{loc:T Import.LinkButton}"
                            AutomationProperties.Name="{loc:T Import.LinkButton}">
                        <PathIcon Data="{StaticResource ChevronRightIcon}" Width="12" Height="12"
                                  Foreground="{DynamicResource AccentForegroundBrush}" />
                    </Button>
                    <Button x:Name="ChooseFileButton" Grid.Column="4" Classes="pill-secondary"
                            Content="{loc:T Import.ChooseFile}" Padding="18,0" />
                </Grid>

                <!-- Only when needed: a link Noctis can't fetch (Spotify, Apple Music, …) says
                     what works instead; a TIDAL link without a sign-in offers the sign-in. -->
                <Border Classes="pill-well" CornerRadius="18" Padding="16,10,10,10"
                        IsVisible="{Binding HasLinkHelp}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Text="{Binding LinkHelp}" FontSize="12.5" Opacity="0.85"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="pill-primary" MinHeight="34" Padding="16,0"
                                FontSize="12.5"
                                Content="{Binding LinkHelpLabel}" Command="{Binding OpenLinkHelpCommand}"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Name of the playlist to create, once there is something to create. -->
            <StackPanel Grid.Row="1" Spacing="6" Margin="28,18,28,0" IsVisible="{Binding HasPreview}">
                <TextBlock Classes="pi-label" Text="{loc:T Import.PlaylistName}" Margin="16,0,0,0" />
                <TextBox Classes="pill-field" Text="{Binding PlaylistName}"
                         Watermark="{loc:T Import.PlaylistName}" />
            </StackPanel>

            <!-- Start: the drop target, with the formats in one muted line (details in its tip). -->
            <Border x:Name="DropZone" Grid.Row="2" Classes="pill-well pi-drop"
                    CornerRadius="22" Height="196" Margin="28,16,28,24"
                    IsVisible="{Binding ShowStart}">
                <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:LineIcon Data="{StaticResource MenuLineImport}" Width="30" Height="30" Opacity="0.35"
                              HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="{loc:T Import.DropTitle}" FontSize="14" FontWeight="SemiBold"
                               Opacity="0.8" HorizontalAlignment="Center" />
                    <StackPanel x:Name="FormatsHint" Orientation="Horizontal" Spacing="6"
                                HorizontalAlignment="Center" Background="Transparent"
                                ToolTip.Tip="{loc:T Import.FormatsTip}">
                        <TextBlock Text="{loc:T Import.Formats}" FontSize="12" Opacity="0.5"
                                   VerticalAlignment="Center" />
                        <PathIcon Data="{StaticResource InfoIcon}" Width="12" Height="12" Opacity="0.45"
                                  VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Reading / fetching and matching: skeleton rows where the list will be. -->
            <StackPanel Grid.Row="2" Classes="pi-skeleton" Spacing="6" Margin="28,16,28,24"
                        IsVisible="{Binding IsAnalyzing}">
                <Border Classes="pill-well" CornerRadius="16" Padding="16,12">
                    <StackPanel Spacing="6">
                        <Border Classes="pi-skel" Height="10" CornerRadius="5" Width="180" HorizontalAlignment="Left" />
                        <Border Classes="pi-skel" Height="8" CornerRadius="4" Width="110" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border Classes="pill-well" CornerRadius="16" Padding="16,12">
                    <StackPanel Spacing="6">
                        <Border Classes="pi-skel" Height="10" CornerRadius="5" Width="140" HorizontalAlignment="Left" />
                        <Border Classes="pi-skel" Height="8" CornerRadius="4" Width="150" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border Classes="pill-well" CornerRadius="16" Padding="16,12">
                    <StackPanel Spacing="6">
                        <Border Classes="pi-skel" Height="10" CornerRadius="5" Width="210" HorizontalAlignment="Left" />
                        <Border Classes="pi-skel" Height="8" CornerRadius="4" Width="90" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Every entry, missing first, each with its Matched / Missing chip. Right padding
                 is the overlay scrollbar's lane, so it never sits on a row. -->
            <ScrollViewer Grid.Row="2"
                          IsVisible="{Binding HasPreview}"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          Padding="28,14,28,10">
                <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}">
                    <!-- Virtualized: a long playlist is thousands of rows. -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlaylistImportViewModel+ImportRow">
                            <Border Classes="pill-well pi-row" Classes.missing="{Binding !IsMatched}"
                                    CornerRadius="16" Padding="16,9,12,9" Margin="0,0,0,6">
                                <Grid ColumnDefinitions="*,12,Auto">
                                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Classes="pi-title" Text="{Binding Title}" FontSize="13"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Artist}" FontSize="11.5" Opacity="0.55"
                                                   TextTrimming="CharacterEllipsis" IsVisible="{Binding HasArtist}" />
                                    </StackPanel>
                                    <Panel Grid.Column="2" VerticalAlignment="Center">
                                        <Border Classes="pi-chip" IsVisible="{Binding IsMatched}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse />
                                                <TextBlock Text="{loc:T Import.Matched}" FontSize="11.5" Opacity="0.85" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="pi-chip missing" IsVisible="{Binding !IsMatched}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse />
                                                <TextBlock Text="{loc:T Import.Missing}" FontSize="11.5" Opacity="0.85" />
                                            </StackPanel>
                                        </Border>
                                    </Panel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
    </controls:PillDialogHost>
</Window>
