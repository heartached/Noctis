<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.ViewModels"
             xmlns:loc="using:Noctis.Localization"
             x:Class="Noctis.Views.HandoffPromptView"
             x:DataType="vm:HandoffPromptViewModel"
             IsVisible="{Binding IsShown}"
             HorizontalAlignment="Center"
             VerticalAlignment="Bottom">
    <!-- "Continue from your phone" (Pick Up on Computer): a pill above the island with the phone's
         song, Continue and a close button. Unlike the queue toast it takes clicks, but it covers
         only itself, so the window stays usable around it. -->
    <Border MaxWidth="460"
            Background="{DynamicResource IslandBackground}"
            BorderBrush="{DynamicResource IslandBorder}"
            BorderThickness="1"
            CornerRadius="999"
            Padding="18,6,6,6"
            BoxShadow="0 6 20 0 #33000000">
        <Grid ColumnDefinitions="*,Auto,Auto">
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding Headline}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource IslandForeground}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}"
                           FontSize="12"
                           Foreground="{DynamicResource IslandForegroundSecondary}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1"
                    Name="ContinueButton"
                    Command="{Binding ContinueCommand}"
                    Content="{loc:T Handoff.Continue}"
                    Background="{DynamicResource AccentColorBrush}"
                    Foreground="{DynamicResource AccentForegroundBrush}"
                    CornerRadius="999"
                    Padding="16,6"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    Name="DismissButton"
                    Command="{Binding DismissCommand}"
                    Content="✕"
                    AutomationProperties.Name="{loc:T Handoff.Dismiss}"
                    Background="Transparent"
                    Foreground="{DynamicResource IslandForegroundSecondary}"
                    CornerRadius="999"
                    Width="28" Height="28"
                    Padding="0"
                    Margin="4,0,0,0"
                    HorizontalContentAlignment="Center"
                    VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
