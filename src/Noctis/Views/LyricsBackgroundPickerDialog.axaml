<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Noctis.Localization"
        xmlns:vm="using:Noctis.ViewModels"
        xmlns:controls="using:Noctis.Controls"
        x:Class="Noctis.Views.LyricsBackgroundPickerDialog"
        x:DataType="vm:LyricsBackgroundPickerViewModel"
        Title="{loc:T LyricsBackground.Title}"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- Settings and its pop-ups never zoom on hover (user ask 09-07). -->
        <Style Selector="Button:pointerover">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
    </Window.Styles>

    <!-- Owner 10-08: the rounded pill pop-up of the Metadata editor / YouTube downloader.
         PillDialogHost draws the blurred, dimmed app behind, the card with its shadow, and
         plays the open/close animation (Close, Esc, Alt+F4 all animate out once, and every
         route cancels a running download through Window.Closing). The card's height is fitted
         to the window in code (FitCard): steady while typing, smaller on a short window. -->
    <controls:PillDialogHost>

    <Grid x:Name="CardRoot" Width="620" Height="640" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- Styles on the card, not the window: PillDialogHost's own pill styles sit closer
             to these controls than Window.Styles, and the closer style wins. -->
        <Grid.Styles>
            <!-- Row cover (and the default's clip tile). -->
            <Style Selector="Border.lbg-art">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="ClipToBounds" Value="True" />
                <Setter Property="Background" Value="#14FFFFFF" />
            </Style>
            <!-- The one text action of a row: a compact quiet pill, the same width on every
                 row ("Choose video" / "Change") so the columns line up. -->
            <Style Selector="Button.lbg-action">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="MinWidth" Value="104" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="FontSize" Value="12.5" />
            </Style>
            <!-- Round icon pills (YouTube, Remove). -->
            <Style Selector="Button.lbg-icon">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="17" />
            </Style>
            <!-- Remove: no fill until hovered, so a row reads as one action and two glyphs
                 rather than a wall of buttons (pill-secondary's hover fill still shows). -->
            <Style Selector="Button.lbg-quiet">
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style Selector="ProgressBar.lbg-bar">
                <Setter Property="Height" Value="4" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Background" Value="#26FFFFFF" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource AccentColorBrush}" />
            </Style>
            <Style Selector="TextBlock.lbg-status">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Opacity" Value="0.5" />
            </Style>
            <Style Selector="TextBlock.lbg-status.own">
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                <Setter Property="Opacity" Value="0.9" />
            </Style>
        </Grid.Styles>

        <!-- Header: icon, title, one line of what this is. -->
        <Grid Grid.Row="0" Margin="28,22,28,0" ColumnDefinitions="56,16,*">
            <Border Grid.Column="0" Width="56" Height="56" CornerRadius="18" Classes="pill-well">
                <controls:LineIcon x:Name="HeaderIcon" Data="{StaticResource MenuLineVideo}" Width="22" Height="22" Opacity="0.6"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{loc:T LyricsBackground.Title}" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="{loc:T LyricsBackground.Subtitle}" FontSize="13" Opacity="0.6"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- The default clip, then the YouTube panel that folds out under it. -->
        <StackPanel Grid.Row="1" Margin="28,18,28,0" Spacing="10">
            <Border x:Name="DefaultWell" Classes="pill-well" Padding="12">
                <Grid ColumnDefinitions="44,12,*,10,Auto">
                    <Border Grid.Column="0" Classes="lbg-art" VerticalAlignment="Center">
                        <controls:LineIcon Data="{StaticResource MenuLineVideo}" Width="18" Height="18"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Opacity="0.35" IsVisible="{Binding !HasDefaultVideo}" />
                    </Border>
                    <Border Grid.Column="0" Classes="lbg-art" VerticalAlignment="Center"
                            Background="{DynamicResource AccentColorBrush}"
                            IsVisible="{Binding HasDefaultVideo}">
                        <controls:LineIcon Data="{StaticResource MenuLineVideo}" Width="18" Height="18"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{DynamicResource AccentForegroundBrush}" />
                    </Border>
                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T LyricsBackground.DefaultVideo}" FontSize="13.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DefaultVideoInfo}" FontSize="11.5" Opacity="0.6"
                                   TextTrimming="CharacterEllipsis" IsVisible="{Binding HasDefaultVideo}" />
                        <TextBlock Text="{loc:T LyricsBackground.NoDefaultVideo}" FontSize="11.5" Opacity="0.5"
                                   TextWrapping="Wrap" IsVisible="{Binding !HasDefaultVideo}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="DefaultChooseButton" Classes="pill-secondary lbg-action"
                                Content="{Binding DefaultChooseLabel}"
                                Command="{Binding ChooseDefaultCommand}"
                                ToolTip.Tip="{loc:T LyricsVideo.PickTitle}" />
                        <Button Classes="pill-secondary lbg-icon"
                                Command="{Binding YouTubeForDefaultCommand}"
                                IsVisible="{Binding CanUseYouTube}"
                                ToolTip.Tip="{loc:T LyricsVideo.YouTubeTip}"
                                AutomationProperties.Name="{loc:T LyricsVideo.YouTubeTip}">
                            <PathIcon Data="{StaticResource YouTubeIcon}" Width="14" Height="14" />
                        </Button>
                        <Button Classes="pill-secondary lbg-icon lbg-quiet"
                                Command="{Binding ClearDefaultCommand}"
                                IsVisible="{Binding HasDefaultVideo}"
                                ToolTip.Tip="{loc:T LyricsVideo.RemoveTip}"
                                AutomationProperties.Name="{loc:T LyricsVideo.RemoveTip}">
                            <controls:LineIcon Data="{StaticResource MenuLineTrash}" Width="16" Height="16" Opacity="0.75" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- From YouTube: link + resolution cap, downloaded video-only (the backdrop is
                 muted) and stored like a picked file, for the default or for one row. Folds
                 out with the shared Glide (height + fade + a short lift). -->
            <controls:CollapsibleContent x:Name="YouTubePanel" IsOpen="{Binding ShowYouTube}" Lift="8" Motion="Glide">
                <Border Classes="pill-well" Padding="16,14">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,8,*,10,Auto">
                            <PathIcon Grid.Column="0" Data="{StaticResource YouTubeIcon}" Width="14" Height="14"
                                      Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="{loc:T LyricsVideo.FromYouTube}" /><Run Text=" · " /><Run Text="{Binding YouTubeTargetLabel}" Foreground="{DynamicResource AccentTextBrush}" />
                            </TextBlock>
                            <Button x:Name="YouTubeCancelButton" Grid.Column="4" Classes="pill-secondary lbg-action"
                                    MinWidth="0"
                                    Content="{loc:T LyricsBackground.YouTubeClose}"
                                    Command="{Binding CloseYouTubeCommand}"
                                    IsEnabled="{Binding !IsApplying}" />
                        </Grid>

                        <!-- Link, quality, Download. -->
                        <!-- 180: "Best available" clipped to "Best availabl" at 150 (live check 10-09). -->
                        <Grid ColumnDefinitions="*,8,180,8,Auto" IsVisible="{Binding ToolInstalled}">
                            <TextBox x:Name="LinkBox" Grid.Column="0" Classes="pill-field"
                                     Text="{Binding YouTubeUrl}"
                                     Watermark="{loc:T LyricsBackground.YouTubeWatermark}"
                                     IsEnabled="{Binding !IsDownloading}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding DownloadFromYouTubeCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <ComboBox x:Name="QualityBox" Grid.Column="2" Classes="pill-field"
                                      ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding SelectedQuality}"
                                      IsEnabled="{Binding !IsDownloading}" />
                            <Button x:Name="DownloadButton" Grid.Column="4" Classes="pill-primary"
                                    Content="{loc:T LyricsBackground.Download}"
                                    Command="{Binding DownloadFromYouTubeCommand}"
                                    IsEnabled="{Binding !IsDownloading}" />
                        </Grid>

                        <!-- yt-dlp missing: one install action. -->
                        <Grid ColumnDefinitions="*,12,Auto" IsVisible="{Binding !ToolInstalled}">
                            <TextBlock Text="{loc:T LyricsBackground.NeedsYtDlp}" FontSize="12" Opacity="0.65"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button x:Name="InstallButton" Grid.Column="2" Classes="pill-primary"
                                    Command="{Binding InstallToolCommand}"
                                    IsEnabled="{Binding !IsInstallingTool}">
                                <Panel>
                                    <TextBlock Text="{loc:T LyricsBackground.InstallYtDlp}" IsVisible="{Binding !IsInstallingTool}" />
                                    <TextBlock Text="{loc:T YouTube.Installing}" IsVisible="{Binding IsInstallingTool}" />
                                </Panel>
                            </Button>
                        </Grid>

                        <!-- Progress, inline: the bar and its percentage. -->
                        <Grid ColumnDefinitions="*,10,Auto" IsVisible="{Binding IsDownloading}">
                            <ProgressBar Classes="lbg-bar" Value="{Binding DownloadProgress}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding DownloadPercentText}" FontSize="12"
                                       FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Classes="lbg-bar" Value="{Binding InstallProgress}"
                                     IsVisible="{Binding IsInstallingTool}" />

                        <TextBlock Text="{Binding YouTubeStatus}" FontSize="12" Opacity="0.65"
                                   TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding YouTubeStatus}"
                                   IsVisible="{Binding HasYouTubeStatus}" />

                        <!-- The version note; for a copy Noctis may not replace (PATH) that is
                             out of date, a small Update pill installs Noctis's own copy. -->
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasToolVersion}">
                            <TextBlock Text="{Binding ToolVersionText}" FontSize="11" Opacity="0.4"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button x:Name="UpdateToolButton" Classes="pill-secondary"
                                    Content="{loc:T YouTube.UpdateTool}"
                                    Command="{Binding InstallToolCommand}"
                                    IsVisible="{Binding ShowToolUpdate}"
                                    ToolTip.Tip="{loc:T YouTube.UpdateToolTip}"
                                    MinHeight="0" Padding="10,2" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </controls:CollapsibleContent>
        </StackPanel>

        <!-- Search, then what the list below holds. -->
        <StackPanel Grid.Row="2" Margin="28,16,28,0" Spacing="12">
            <TextBox x:Name="SearchBox" Classes="pill-field"
                     Text="{Binding SearchText}"
                     Watermark="{loc:T LyricsBackground.SearchWatermark}" />
            <TextBlock Text="{loc:T LyricsBackground.WithOwnVideo}"
                       IsVisible="{Binding ShowOverridesHeader}"
                       FontSize="11" FontWeight="Bold" Opacity="0.5" LetterSpacing="0.5" />
        </StackPanel>

        <Panel Grid.Row="3" Margin="0,8,0,0">
            <!-- Rows: cover, title, subtitle, which clip plays; one "Choose video"/"Change"
                 pill, a round YouTube pill and a quiet Remove. Right padding is the overlay
                 scrollbar's lane. -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          Padding="28,0,28,8">
                <ItemsControl x:Name="ResultsList" ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LyricsBackgroundPickItem">
                            <Border Classes="pill-well" CornerRadius="18" Padding="10,10,12,10" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="44,12,*,10,Auto">
                                    <Border Grid.Column="0" Classes="lbg-art" VerticalAlignment="Center">
                                        <Panel>
                                            <PathIcon Data="{StaticResource AlbumsIcon}" Width="16" Height="16" Opacity="0.3"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <controls:CachedImage SourcePath="{Binding ArtworkPath}"
                                                                  DecodeWidth="128"
                                                                  Stretch="UniformToFill" />
                                        </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   ToolTip.Tip="{Binding Title}" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <PathIcon Data="{StaticResource CheckmarkIcon}" Width="10" Height="10"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource AccentTextBrush}"
                                                      IsVisible="{Binding HasOwnVideo}" />
                                            <TextBlock Classes="lbg-status" Classes.own="{Binding HasOwnVideo}"
                                                       Text="{Binding StatusText}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Classes="pill-secondary lbg-action"
                                                Content="{Binding ChooseLabel}"
                                                Command="{Binding $parent[ItemsControl].((vm:LyricsBackgroundPickerViewModel)DataContext).ChooseForItemCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{loc:T LyricsVideo.PickTitle}" />
                                        <Button Classes="pill-secondary lbg-icon"
                                                Command="{Binding $parent[ItemsControl].((vm:LyricsBackgroundPickerViewModel)DataContext).YouTubeForItemCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding $parent[ItemsControl].((vm:LyricsBackgroundPickerViewModel)DataContext).CanUseYouTube}"
                                                ToolTip.Tip="{loc:T LyricsVideo.YouTubeTip}"
                                                AutomationProperties.Name="{loc:T LyricsVideo.YouTubeTip}">
                                            <PathIcon Data="{StaticResource YouTubeIcon}" Width="14" Height="14" />
                                        </Button>
                                        <!-- Drops this row's own clip: it falls back to its album's
                                             or the default. Kept in place when hidden so every
                                             row's actions line up. -->
                                        <Panel Width="34">
                                            <Button Classes="pill-secondary lbg-icon lbg-quiet"
                                                    Command="{Binding $parent[ItemsControl].((vm:LyricsBackgroundPickerViewModel)DataContext).ClearForItemCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding HasOwnVideo}"
                                                    ToolTip.Tip="{loc:T LyricsVideo.RemoveTip}"
                                                    AutomationProperties.Name="{loc:T LyricsVideo.RemoveTip}">
                                                <controls:LineIcon Data="{StaticResource MenuLineTrash}" Width="16" Height="16" Opacity="0.75" />
                                            </Button>
                                        </Panel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Nothing has its own clip yet: what to do, not a blank area. -->
            <StackPanel x:Name="EmptyPrompt" IsVisible="{Binding ShowPrompt}" Spacing="10" Margin="28,0,28,24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="24" Classes="pill-well" HorizontalAlignment="Center">
                    <PathIcon Data="{StaticResource PlayIcon}" Width="16" Height="16" Opacity="0.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{loc:T LyricsBackground.PromptTitle}" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock Text="{loc:T LyricsBackground.PromptBody}" FontSize="12" Opacity="0.55" MaxWidth="340"
                           TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>

            <!-- No results. -->
            <StackPanel x:Name="NoResults" IsVisible="{Binding ShowNoResults}" Spacing="10" Margin="28,0,28,24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="24" Classes="pill-well" HorizontalAlignment="Center">
                    <PathIcon Data="{StaticResource SearchIcon}" Width="16" Height="16" Opacity="0.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{loc:T AddSongs.NoMatches}" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock Text="{loc:T AddSongs.NothingLibraryMatchesSearch}" FontSize="12" Opacity="0.55"
                           HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </Panel>

        <!-- Footer: which clip a song plays, and Close (as the other pill pop-ups). -->
        <Border Grid.Row="4"
                Padding="28,14"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:T LyricsVideo.Order}" FontSize="12" Opacity="0.5"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button x:Name="CloseButton" Grid.Column="1"
                        Classes="pill-secondary"
                        Content="{loc:T Common.Close}"
                        Command="{Binding CloseCommand}"
                        MinWidth="108" />
            </Grid>
        </Border>
    </Grid>
    </controls:PillDialogHost>
</Window>
