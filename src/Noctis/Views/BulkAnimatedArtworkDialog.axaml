<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Noctis.Localization"
        xmlns:vm="using:Noctis.ViewModels"
        xmlns:controls="using:Noctis.Controls"
        x:Class="Noctis.Views.BulkAnimatedArtworkDialog"
        x:DataType="vm:BulkAnimatedArtworkViewModel"
        Title="{loc:T BulkArtwork.Title}"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Border.job-row">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
    </Window.Styles>

    <!-- The rounded pill pop-up (PillDialogHost), as the bulk lyrics run and Import Playlist. -->
    <controls:PillDialogHost>

    <Grid Width="620" MaxHeight="720" RowDefinitions="Auto,Auto,*,Auto">

        <Border Grid.Row="0" Padding="28,22,28,14"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding TitleText}" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="{loc:T BulkArtwork.Subtitle}" FontSize="12.5" Opacity="0.65" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <CheckBox Grid.Row="1" x:Name="RecheckBox" Margin="28,12,28,4" FontSize="12.5"
                  IsChecked="{Binding Recheck}" IsEnabled="{Binding CanChangeOptions}"
                  Content="{loc:T BulkArtwork.Recheck}" />

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="28,8,28,8">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BulkAnimatedArtworkViewModel+Row">
                        <Border Classes="job-row pill-well">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                                    <PathIcon Data="{StaticResource CheckmarkIcon}" Width="12" Height="12"
                                              Foreground="{DynamicResource AccentColorBrush}" IsVisible="{Binding Found}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="28,12,28,14"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Spacing="10">
                <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" Height="4" CornerRadius="2"
                             IsVisible="{Binding IsRunning}" />
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12.5" Opacity="0.65"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                               ToolTip.Tip="{Binding StatusMessage}" />
                    <Button Grid.Column="1" Classes="pill-secondary" Content="{loc:T BulkLyrics.Stop}"
                            Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}"
                            MinWidth="92" Margin="0,0,10,0" />
                    <Button Grid.Column="2" Classes="pill-secondary" Content="{Binding CloseText}"
                            Command="{Binding CancelCommand}" MinWidth="100" Margin="0,0,10,0" />
                    <Button x:Name="StartButton" Grid.Column="3" Classes="pill-primary" Content="{loc:T BulkArtwork.Find}"
                            Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" MinWidth="108" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
    </controls:PillDialogHost>
</Window>
