<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Noctis.Localization"
        xmlns:controls="using:Noctis.Controls"
        x:Class="Noctis.Views.RemoveFromLibraryDialog"
        Title="{loc:T RemoveFromLibrary.RemoveFromLibrary}"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False">

    <!-- Owner 10-08: the rounded pill pop-up with the blurred app behind, like the other
         pop-ups. PillDialogHost draws the blurred, dimmed owner and the card, swallows clicks
         and wheel on the backdrop, and plays the open/close animation (every close path —
         a button, Esc, Alt+F4 — animates out once). The answer is kept in Choice, never in
         Close(result), so the deferred close loses nothing. -->
    <controls:PillDialogHost>

        <!-- 500: the English detail line fits on one line (at 460 "file." wrapped alone). -->
        <StackPanel Width="500" Margin="28,24,28,22" Spacing="20">

            <StackPanel Spacing="6">
                <TextBlock x:Name="MessageText"
                           Text="{loc:T RemoveFromLibrary.RemoveFromLibrary2}"
                           FontSize="17"
                           FontWeight="Bold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="SubText"
                           FontSize="12.5"
                           Opacity="0.65"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Cancel stays the accent (the safe answer); the two removals are quiet pills. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="TrashButton"
                        Classes="pill-secondary"
                        Content="{loc:T RemoveFromLibrary.MoveRecycleBin}"
                        Click="OnTrashClick" />
                <Button Classes="pill-secondary"
                        Content="{loc:T RemoveFromLibrary.KeepFiles}"
                        Click="OnKeepClick" />
                <Button x:Name="CancelButton"
                        Classes="pill-primary"
                        Content="{loc:T RemoveFromLibrary.Cancel}"
                        Click="OnCancelClick" />
            </StackPanel>
        </StackPanel>

    </controls:PillDialogHost>
</Window>
