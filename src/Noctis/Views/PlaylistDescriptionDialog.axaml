<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Noctis.Localization"
        xmlns:vm="using:Noctis.ViewModels"
        xmlns:conv="using:Noctis.Converters"
        xmlns:controls="using:Noctis.Controls"
        x:Class="Noctis.Views.PlaylistDescriptionDialog"
        x:DataType="vm:PlaylistViewModel"
        Title="{loc:T PlaylistDescription.PlaylistDescription}"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <conv:HexColorToBrushConverter x:Key="HexColorConverter" />
    </Window.Resources>

    <!-- Same classes and values as AlbumDescriptionDialog: the two description editors are
         one design, with the playlist's cover, name and facts in the header. -->
    <Window.Styles>
        <Style Selector="TextBlock.desc-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
        <Style Selector="Border.desc-chip">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="Border.desc-chip > TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="MaxWidth" Value="220" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBox.desc-editor">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
        </Style>
        <Style Selector="Button.desc-clear">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.desc-clear:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PillFieldBackgroundPointerOver}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
    </Window.Styles>

    <!-- Owner 10-08: the rounded pill pop-up (see AlbumDescriptionDialog). Save goes through
         the view model and closes on its DescriptionSaved, never through Close(result). -->
    <controls:PillDialogHost x:Name="DialogHost">

    <Grid x:Name="CardRoot" Width="640" RowDefinitions="Auto,Auto,Auto">

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="28,24,28,16"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="84,18,*">
                <!-- Cover as on the playlist page: custom art > collage > single art > colour tile. -->
                <Border Grid.Column="0"
                        Width="84" Height="84"
                        CornerRadius="18"
                        ClipToBounds="True"
                        VerticalAlignment="Top"
                        Classes="pill-well">
                    <Panel>
                        <Border Background="{Binding PlaylistColor, Converter={StaticResource HexColorConverter}}" />
                        <PathIcon Data="{StaticResource PlaylistsIcon}"
                                  Width="28" Height="28"
                                  Foreground="{DynamicResource TertiaryTextBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding ShowFallbackIcon}" />
                        <controls:CachedImage x:Name="SingleCover"
                                              SourcePath="{Binding Art1}"
                                              DecodeWidth="256"
                                              Stretch="UniformToFill"
                                              RenderOptions.BitmapInterpolationMode="HighQuality"
                                              IsVisible="{Binding HasSingleArt}" />
                        <Grid RowDefinitions="*,*"
                              ColumnDefinitions="*,*"
                              IsVisible="{Binding HasCollageArt}">
                            <controls:CachedImage x:Name="Collage1" Grid.Row="0" Grid.Column="0"
                                                  SourcePath="{Binding Art1}"
                                                  DecodeWidth="128"
                                                  Stretch="UniformToFill" />
                            <controls:CachedImage x:Name="Collage2" Grid.Row="0" Grid.Column="1"
                                                  SourcePath="{Binding Art2}"
                                                  DecodeWidth="128"
                                                  Stretch="UniformToFill" />
                            <controls:CachedImage x:Name="Collage3" Grid.Row="1" Grid.Column="0"
                                                  SourcePath="{Binding Art3}"
                                                  DecodeWidth="128"
                                                  Stretch="UniformToFill" />
                            <controls:CachedImage x:Name="Collage4" Grid.Row="1" Grid.Column="1"
                                                  SourcePath="{Binding Art4}"
                                                  DecodeWidth="128"
                                                  Stretch="UniformToFill" />
                        </Grid>
                        <controls:CachedImage x:Name="CustomCover"
                                              SourcePath="{Binding PlaylistCoverArtPath}"
                                              DecodeWidth="256"
                                              Stretch="UniformToFill"
                                              RenderOptions.BitmapInterpolationMode="HighQuality"
                                              IsVisible="{Binding HasCustomArt}" />
                    </Panel>
                </Border>

                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Classes="one-line-explicit-title"
                               Text="{Binding Name}"
                               ToolTip.Tip="{Binding Name}"
                               FontSize="20"
                               FontWeight="Bold"
                               MaxWidth="500"
                               HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding CreatedDateDisplay}"
                               FontSize="13.5"
                               Opacity="0.7"
                               TextTrimming="CharacterEllipsis" />
                    <ItemsControl x:Name="FactChips" Margin="0,8,0,-6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Classes="desc-chip">
                                    <TextBlock Text="{Binding}" ToolTip.Tip="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The description: one filled editor (accent ring on focus). Enter is a new line;
             Ctrl+Enter saves (code-behind). -->
        <StackPanel Grid.Row="1" Margin="28,18,28,22" Spacing="8">
            <TextBlock Classes="desc-label" Text="{loc:T DescriptionDialog.Label}" />
            <TextBox x:Name="DescriptionEditor"
                     Classes="pill-area desc-editor"
                     Text="{Binding DescriptionEditorText}"
                     Watermark="{loc:T DescriptionDialog.PlaylistPlaceholder}"
                     Height="300"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <!-- Footer: count + Clear on the left, Cancel / Save on the right. -->
        <Border Grid.Row="2"
                Padding="28,14"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText"
                               FontSize="12"
                               Opacity="0.55"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center" />
                    <Button x:Name="ClearButton"
                            Classes="desc-clear"
                            Content="{loc:T DescriptionDialog.Clear}"
                            ToolTip.Tip="{loc:T DescriptionDialog.ClearTip}"
                            Click="OnClearClick" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button x:Name="CancelButton"
                            Classes="pill-secondary"
                            Content="{loc:T PlaylistDescription.Cancel}"
                            Click="OnCancelClick"
                            MinWidth="108" />
                    <Button x:Name="SaveButton"
                            Classes="pill-primary"
                            Content="{loc:T PlaylistDescription.Save}"
                            ToolTip.Tip="{loc:T DescriptionDialog.SaveTip}"
                            Command="{Binding SaveDescriptionEditCommand}"
                            MinWidth="108" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </controls:PillDialogHost>
</Window>
