<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.ViewModels"
             xmlns:m="using:Noctis.Models"
             xmlns:ctrl="using:Noctis.Controls"
             xmlns:controls="using:Noctis.Controls"
             xmlns:conv="using:Noctis.Converters"
             xmlns:helpers="using:Noctis.Helpers"
             x:Class="Noctis.Views.LibraryAlbumsView"
             x:DataType="vm:LibraryAlbumsViewModel"
             Focusable="True"
             Background="{DynamicResource AppMainBackground}">

    <UserControl.Resources>
        <conv:ArtworkPathConverter x:Key="ArtworkConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Rank numerals for the artist page's Songs pills (local copy of HomeView's style) -->
        <Style Selector="TextBlock.rank-num">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Opacity" Value="0.32"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*">
        <!-- Right margin trimmed to 2 so the vertical scrollbar sits near the window
             edge (Apple Music style) instead of being inset ~12px from it. -->
        <DockPanel Grid.Row="0" Margin="12,8,2,8">

        <!-- Content area with overlay for empty state -->
        <Grid>
            <!-- Album grid: outer ListBox virtualizes rows, inner UniformGrid lays out GridColumns per row -->
            <ListBox x:Name="AlbumListBox"
                     ItemsSource="{Binding FilteredAlbumRows}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,0,0,115"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     ScrollViewer.AllowAutoHide="False"
                     SelectionMode="Single"
                     AutoScrollToSelectedItem="False">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.Styles>
                <ListBox.DataTemplates>
                    <!-- Section header ("Songs" / "Albums") on artist pages -->
                    <DataTemplate DataType="m:ArtistSectionHeader">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="2,10,0,8" />
                    </DataTemplate>

                    <!-- Artist page Songs section: ranked pills, same look as the
                         Home tab's "Most Listened To" grid (3 per row) -->
                    <DataTemplate DataType="m:ArtistSongsRow">
                        <ItemsControl ItemsSource="{Binding Songs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:TopSongRow">
                                    <Button Classes="browse-item"
                                            Background="{DynamicResource HomeCardBackground}"
                                            BorderThickness="0"
                                            CornerRadius="6"
                                            Padding="0"
                                            Height="56"
                                            Margin="3,3"
                                            Cursor="Hand"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            helpers:DragFileBehavior.EnableFileDrag="True"
                                            ContextRequested="OnArtistSongContextRequested"
                                            Command="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).PlayArtistSongCommand}"
                                            CommandParameter="{Binding Track}">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource HomeCardHoverBackground}" />
                                            </Style>
                                        </Button.Styles>

                                        <!-- Pill content: artwork + rank + title + heart + play count -->
                                        <Grid ColumnDefinitions="56,38,*,Auto">
                                            <Border Grid.Column="0"
                                                    Width="56" Height="56"
                                                    CornerRadius="6,0,0,6"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                                <Panel>
                                                    <TextBlock Text="&#x266A;"
                                                               FontSize="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Opacity="0.2"
                                                               IsVisible="{Binding Track.AlbumArtworkPath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                                    <ctrl:CachedImage SourcePath="{Binding Track.AlbumArtworkPath}"
                                                                      Stretch="UniformToFill"
                                                                      RenderOptions.BitmapInterpolationMode="HighQuality"
                                                                      IsVisible="{Binding Track.AlbumArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </Panel>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Classes="rank-num"
                                                       Text="{Binding Rank}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <!-- Heart is a sibling of the whole text stack, not a member of the
                                                 title line: nested inside the title it centred on that line and
                                                 rode high against the two-line row (Home's rows are one line, so
                                                 the same nesting reads centred there). Mirrors Home's *,Auto
                                                 split so the 10px gap to the play count matches too. -->
                                            <Grid Grid.Column="2"
                                                  ColumnDefinitions="*,Auto"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0">
                                                <StackPanel Grid.Column="0" Spacing="1">
                                                    <TextBlock FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1">
                                                        <Run Text="{Binding Track.Title}" />
                                                        <InlineUIContainer BaselineAlignment="Center">
                                                            <Border Classes="explicit-badge compact"
                                                                    Margin="6,0,0,0"
                                                                    IsVisible="{Binding Track.IsExplicit}"
                                                                    ToolTip.Tip="Explicit">
                                                                <TextBlock Text="E"
                                                                           Classes="explicit-badge-text compact"
                                                                           FontSize="9"
                                                                           Opacity="0.9" />
                                                            </Border>
                                                        </InlineUIContainer>
                                                    </TextBlock>
                                                    <!-- Album credit so strays filed under the wrong album are spottable -->
                                                    <TextBlock Text="{Binding Track.Album}"
                                                               FontSize="11"
                                                               Opacity="0.55"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                </StackPanel>
                                                <PathIcon Grid.Column="1"
                                                          Data="{StaticResource HeartFillIcon}"
                                                          Width="14" Height="14"
                                                          Foreground="#E74856"
                                                          Margin="6,0,0,0"
                                                          VerticalAlignment="Center"
                                                          IsVisible="{Binding Track.IsFavorite}" />
                                            </Grid>
                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        Spacing="3"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,14,0"
                                                        ToolTip.Tip="Listen count">
                                                <TextBlock Text="{Binding Track.PlayCount}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Opacity="0.75"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="plays"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Opacity="0.55"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>

                    <DataTemplate DataType="m:AlbumRow">
                        <ItemsControl ItemsSource="{Binding Albums}"
                                      Height="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).TileRowHeight}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- Column count mirrors the VM's row chunk size (cover-size setting) -->
                                    <UniformGrid Columns="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).GridColumns}" Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:Album">
                                    <Button Classes="album-tile"
                                            Focusable="False"
                                            Margin="2"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            helpers:DragFileBehavior.EnableFileDrag="True"
                                            Loaded="OnAlbumTileLoaded"
                                            Command="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).OpenAlbumCommand}"
                                            CommandParameter="{Binding}">

                                        <!-- Context menu for album tiles -->
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding}" Opening="OnAlbumContextMenuOpening">
                                                <MenuItem Command="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).PlayAlbumCommand}"
                                                          CommandParameter="{Binding}"
                                                          MaxWidth="400">
                                                    <MenuItem.Header>
                                                        <TextBlock Text="Play"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontWeight="Normal"
                                                                   FontSize="14"
                                                                   FontFamily="{Binding $parent[MenuItem].FontFamily}" />
                                                    </MenuItem.Header>
                                                    <MenuItem.Icon>
                                                        <Border Width="14" Height="14" Background="{DynamicResource SystemControlForegroundBaseHighBrush}" RenderOptions.BitmapInterpolationMode="HighQuality"><Border.OpacityMask><ImageBrush Source="avares://Noctis/Assets/Icons/Play%20ICON.png" Stretch="Uniform" /></Border.OpacityMask></Border>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Shuffle"
                                                          Command="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).ShuffleAlbumCommand}"
                                                          CommandParameter="{Binding}">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{StaticResource ShuffleIcon}" Width="14" Height="14" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Play Next"
                                                          Command="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).PlayNextCommand}"
                                                          CommandParameter="{Binding}">
                                                    <MenuItem.Icon>
                                                        <Border Width="14" Height="14" Background="{DynamicResource SystemControlForegroundBaseHighBrush}" RenderOptions.BitmapInterpolationMode="HighQuality"><Border.OpacityMask><ImageBrush Source="avares://Noctis/Assets/Icons/Forward%20ICON.png" Stretch="Uniform" /></Border.OpacityMask></Border>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Add to Queue"
                                                          Command="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).AddToQueueCommand}"
                                                          CommandParameter="{Binding}">
                                                    <MenuItem.Icon>
                                                        <Border Width="17" Height="17" Background="{DynamicResource SystemControlForegroundBaseHighBrush}" RenderOptions.BitmapInterpolationMode="HighQuality"><Border.OpacityMask><ImageBrush Source="avares://Noctis/Assets/Icons/Queue%20ICON.png" Stretch="Uniform" /></Border.OpacityMask></Border>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="Add to Playlist"
                                                          Command="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).AddToNewPlaylistCommand}"
                                                          CommandParameter="{Binding}">
                                                    <MenuItem.Icon>
                                                        <Border Width="14" Height="14" Background="{DynamicResource SystemControlForegroundBaseHighBrush}" RenderOptions.BitmapInterpolationMode="HighQuality"><Border.OpacityMask><ImageBrush Source="avares://Noctis/Assets/Icons/Playlist%20icon.png" Stretch="Uniform" /></Border.OpacityMask></Border>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="Favorites"
                                                          Command="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).ToggleAlbumFavoritesCommand}"
                                                          CommandParameter="{Binding}"
                                                          IsVisible="{Binding !IsAllTracksFavorite}">
                                                    <MenuItem.Icon>
                                                        <Border Width="14" Height="14" Background="{DynamicResource SystemControlForegroundBaseHighBrush}" RenderOptions.BitmapInterpolationMode="HighQuality"><Border.OpacityMask><ImageBrush Source="avares://Noctis/Assets/Icons/Favorites%20icon.png" Stretch="Uniform" /></Border.OpacityMask></Border>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Remove from Favorites"
                                                          Command="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).ToggleAlbumFavoritesCommand}"
                                                          CommandParameter="{Binding}"
                                                          IsVisible="{Binding IsAllTracksFavorite}">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{StaticResource HeartFillIcon}" Width="14" Height="14" Foreground="#E74856" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Metadata"
                                                          Command="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).OpenMetadataCommand}"
                                                          CommandParameter="{Binding}">
                                                    <MenuItem.Icon>
                                                        <Border Width="14" Height="14" Background="{DynamicResource SystemControlForegroundBaseHighBrush}" RenderOptions.BitmapInterpolationMode="HighQuality"><Border.OpacityMask><ImageBrush Source="avares://Noctis/Assets/Icons/Metadata%20ICON.png" Stretch="Uniform" /></Border.OpacityMask></Border>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Convert Album"
                                                          Command="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).ConvertAlbumCommand}"
                                                          CommandParameter="{Binding}">
                                                    <MenuItem.Icon>
                                                        <Border Width="14" Height="14" Background="{DynamicResource SystemControlForegroundBaseHighBrush}" RenderOptions.BitmapInterpolationMode="HighQuality"><Border.OpacityMask><ImageBrush Source="avares://Noctis/Assets/Icons/Metadata%20ICON.png" Stretch="Uniform" /></Border.OpacityMask></Border>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Scan ReplayGain"
                                                          Command="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).ScanAlbumReplayGainCommand}"
                                                          CommandParameter="{Binding}">
                                                    <MenuItem.Icon>
                                                        <Border Width="14" Height="14" Background="{DynamicResource SystemControlForegroundBaseHighBrush}" RenderOptions.BitmapInterpolationMode="HighQuality"><Border.OpacityMask><ImageBrush Source="avares://Noctis/Assets/Icons/Metadata%20ICON.png" Stretch="Uniform" /></Border.OpacityMask></Border>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Show Folder"
                                                          Command="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).ShowInExplorerCommand}"
                                                          CommandParameter="{Binding}">
                                                    <MenuItem.Icon>
                                                        <Border Width="14" Height="14" Background="{DynamicResource SystemControlForegroundBaseHighBrush}" RenderOptions.BitmapInterpolationMode="HighQuality"><Border.OpacityMask><ImageBrush Source="avares://Noctis/Assets/Icons/Folder%20ICON.png" Stretch="Uniform" /></Border.OpacityMask></Border>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="Remove from Library" Classes="danger"
                                                          Command="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).RemoveFromLibraryCommand}"
                                                          CommandParameter="{Binding}">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{StaticResource TrashIcon}" Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>

                                        <StackPanel Spacing="0" HorizontalAlignment="Stretch">
                                            <!-- Album artwork: size computed once in code-behind, no per-tile Bounds binding -->
                                            <Border Width="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).TileArtworkSize}"
                                                    Height="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).TileArtworkSize}"
                                                    CornerRadius="6"
                                                    ClipToBounds="True"
                                                    Background="#1AFFFFFF">
                                                <Panel>
                                                    <!-- Placeholder -->
                                                    <TextBlock Text="&#x266A;"
                                                               FontSize="40"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Opacity="0.15"
                                                               IsVisible="{Binding ArtworkPath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                                    <!-- Async artwork loading: cache hits instant, misses load on background thread -->
                                                    <ctrl:CachedImage SourcePath="{Binding ArtworkPath}"
                                                                      DecodeWidth="768"
                                                                      Stretch="UniformToFill"
                                                                      RenderOptions.BitmapInterpolationMode="HighQuality"
                                                                      IsVisible="{Binding ArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    <!-- Favorite heart overlay (visible when any track in album is favorited) -->
                                                    <PathIcon Data="{StaticResource HeartFillIcon}"
                                                              Width="18" Height="18"
                                                              Foreground="#E74856"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Bottom"
                                                              Margin="0,0,8,8"
                                                              IsVisible="{Binding HasFavoriteTrack}" />
                                                </Panel>
                                            </Border>
                                            <!-- Album name + inline explicit badge -->
                                            <ctrl:HighlightTextBlock DisplayText="{Binding Name}"
                                                                     HighlightText="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).SearchText}"
                                                                     IsExplicit="{Binding IsExplicit}"
                                                                     Margin="0,5,0,0"
                                                                     FontSize="13"
                                                                     FontWeight="SemiBold"
                                                                     TextWrapping="Wrap"
                                                                     TextTrimming="CharacterEllipsis"
                                                                     MaxLines="2" />
                                            <!-- Artist name · release year -->
                                            <ctrl:HighlightTextBlock DisplayText="{Binding TileSubtitle}"
                                                                     HighlightText="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).SearchText}"
                                                                     FontSize="12"
                                                                     FontWeight="Bold"
                                                                     Opacity="0.55"
                                                                     TextTrimming="CharacterEllipsis"
                                                                     MaxLines="1"
                                                                     Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.DataTemplates>
            </ListBox>

            <!-- Empty state overlay -->
            <StackPanel IsVisible="{Binding !FilteredAlbumRows.Count}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock Text="No albums found"
                           FontSize="18"
                           Opacity="0.5"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <TextBlock Text="Add music folders in Settings to get started"
                           FontSize="13"
                           Opacity="0.3"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>

        </DockPanel>
    </Grid>

</UserControl>
