<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:vm="using:Noctis.ViewModels"
             xmlns:m="using:Noctis.Models"
             xmlns:ctrl="using:Noctis.Controls"
             xmlns:controls="using:Noctis.Controls"
             xmlns:conv="using:Noctis.Converters"
             xmlns:helpers="using:Noctis.Helpers"
             x:Class="Noctis.Views.LibraryAlbumsView"
             x:DataType="vm:LibraryAlbumsViewModel"
             Focusable="True"
             Classes.hover-zoom="{Binding IsHoverZoom}"
             Classes.wide-album-gap="{Binding IsWideAlbumSpacing}"
             Background="{DynamicResource AppMainBackground}">

    <UserControl.Resources>
        <conv:ArtworkPathConverter x:Key="ArtworkConverter" />
        <!-- One album tile for the row grid and the Masonry panel (GitHub #213). -->
        <DataTemplate x:Key="AlbumTileTemplate" x:DataType="m:Album">
            <!-- Margin/Padding come from the album-gap styles below (1.6.9 or wide spacing). -->
            <Button Classes="album-tile"
                    AutomationProperties.Name="{Binding Name}"
                    Focusable="False"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Top"
                    helpers:DragFileBehavior.EnableFileDrag="True"
                    Loaded="OnAlbumTileLoaded"
                    ContextRequested="OnAlbumTileContextRequested"
                    Command="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).OpenAlbumCommand}"
                    CommandParameter="{Binding}">

                <!-- Right-click / dots: one shared v2 menu built in code (OnAlbumTileContextRequested). -->
                <!-- Stretched to the row with its content on top: selected tiles in one row
                     share one plate height (GitHub #209). -->

                <StackPanel Classes="tile-text" Spacing="0" HorizontalAlignment="Stretch">
                    <!-- Album Hover Zoom (GitHub #218, Discord 11-21): only the artwork grows, round
                         its own centre, with the glow behind it; the title lines stay put.
                         Styles.axaml, .hover-zoom. -->
                    <Panel Classes="tile-art" HorizontalAlignment="Center">
                    <Border Classes="tile-glow" CornerRadius="6" />
                    <!-- Album artwork: size computed once in code-behind, no per-tile Bounds binding -->
                    <Border Width="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).TileArtworkSize}"
                            Height="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).TileArtworkSize}"
                            CornerRadius="6"
                            ClipToBounds="True"
                            Background="#1AFFFFFF">
                        <Panel>
                            <!-- Placeholder -->
                            <TextBlock Text="{loc:T LibraryAlbums.Text}"
                                       FontSize="40"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Opacity="0.15"
                                       IsVisible="{Binding ArtworkPath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                            <!-- Async artwork loading: cache hits instant, misses load on background thread -->
                            <ctrl:CachedImage SourcePath="{Binding ArtworkPath}"
                                              DecodeWidth="768"
                                              Stretch="UniformToFill"
                                              RenderOptions.BitmapInterpolationMode="HighQuality"
                                              IsVisible="{Binding ArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <!-- Hover overlay (09-13): dim + Play/Pause + dots; styles in Styles.axaml -->
                            <Border Classes="tile-dim" />
                            <Button Classes="tile-play"
                                    Command="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).TogglePlayAlbumCommand}"
                                    CommandParameter="{Binding}">
                                <Panel>
                                    <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0" IsVisible="{Binding !IsNowPlaying}"><Path Data="{StaticResource PlayIcon}" Fill="White" /></Viewbox>
                                    <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsNowPlaying}"><Path Data="{StaticResource PauseIcon}" Fill="White" /></Viewbox>
                                </Panel>
                            </Button>
                            <Button Classes="tile-more" Click="OnTileMoreClick">
                                <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource MoreDotsIcon}" Fill="White" /></Viewbox>
                            </Button>
                        </Panel>
                    </Border>
                    </Panel>
                    <!-- Title + explicit badge; the heart sits at the line's right end (09-13) -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                        <ctrl:HighlightTextBlock Grid.Column="0"
                                                 helpers:TitleWrap.Watch="True"
                                                 DisplayText="{Binding Name}"
                                                 HighlightText="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).SearchText}"
                                                 IsExplicit="{Binding IsExplicit}"
                                                 FontSize="13"
                                                 FontWeight="SemiBold"
                                                 TextWrapping="Wrap"
                                                 TextTrimming="CharacterEllipsis"
                                                 MaxLines="2" />
                        <Panel Grid.Column="1" Classes="heart-title" VerticalAlignment="Top" Margin="6,2,0,0">
                            <ctrl:HeartIcon Size="14" ShowWhenOff="False" IsFavorite="{Binding HasFavoriteTrack}" />
                        </Panel>
                    </Grid>
                    <!-- Subtitle; the heart lands here instead when the title wraps -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,1,0,0">
                        <ctrl:HighlightTextBlock Grid.Column="0"
                                                 DisplayText="{Binding CardCaption}"
                                                 HighlightText="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).SearchText}"
                                                 FontSize="12"
                                                 FontWeight="Bold"
                                                 Opacity="0.55"
                                                 TextTrimming="CharacterEllipsis"
                                                 MaxLines="1" />
                        <Panel Grid.Column="1" Classes="heart-sub" VerticalAlignment="Center" Margin="6,0,0,0">
                            <ctrl:HeartIcon Size="14" ShowWhenOff="False" IsFavorite="{Binding HasFavoriteTrack}" />
                        </Panel>
                    </Grid>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Genre / artist page sections, shown by the row grid's ListBox and above the Masonry
         cards (GitHub #259). -->
    <UserControl.DataTemplates>
        <!-- Section header ("Songs" / "Albums") on artist pages -->
        <DataTemplate DataType="m:ArtistSectionHeader">
            <TextBlock Text="{Binding Title}"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="2,10,0,8" />
        </DataTemplate>

        <!-- Artist page Songs section: ranked pills, same look as the
             Home tab's "Most Listened To" grid (3 per row) -->
        <DataTemplate DataType="m:ArtistSongsRow">
            <ItemsControl ItemsSource="{Binding Songs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:TopSongRow">
                        <Button Classes="browse-item"
                                Background="{DynamicResource HomeCardBackground}"
                                BorderThickness="0"
                                CornerRadius="6"
                                Padding="0"
                                Height="56"
                                Margin="3,3"
                                Cursor="Hand"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                helpers:DragFileBehavior.EnableFileDrag="True"
                                ContextRequested="OnArtistSongContextRequested"
                                Command="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).PlayArtistSongCommand}"
                                CommandParameter="{Binding Track}">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource HomeCardHoverBackground}" />
                                </Style>
                            </Button.Styles>

                            <!-- Pill content: artwork + rank + title + heart + play count -->
                            <Grid ColumnDefinitions="56,38,*,Auto">
                                <Border Grid.Column="0"
                                        Width="56" Height="56"
                                        CornerRadius="6,0,0,6"
                                        ClipToBounds="True"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                    <Panel>
                                        <TextBlock Text="{loc:T LibraryAlbums.Text}"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.2"
                                                   IsVisible="{Binding Track.AlbumArtworkPath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                        <ctrl:CachedImage SourcePath="{Binding Track.AlbumArtworkPath}"
                                                          Stretch="UniformToFill"
                                                          RenderOptions.BitmapInterpolationMode="HighQuality"
                                                          IsVisible="{Binding Track.AlbumArtworkPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </Panel>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Classes="rank-num"
                                           Classes.gold="{Binding IsTop}"
                                           Classes.silver="{Binding IsSecond}"
                                           Classes.bronze="{Binding IsThird}"
                                           Text="{Binding Rank}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <!-- Heart is a sibling of the whole text stack, not a member of the
                                     title line: nested inside the title it centred on that line and
                                     rode high against the two-line row (Home's rows are one line, so
                                     the same nesting reads centred there). Mirrors Home's *,Auto
                                     split so the 10px gap to the play count matches too. -->
                                <Grid Grid.Column="2"
                                      ColumnDefinitions="*,Auto"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0">
                                    <StackPanel Grid.Column="0" Spacing="1">
                                        <TextBlock FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1">
                                            <Run Text="{Binding Track.Title}" />
                                            <InlineUIContainer BaselineAlignment="Center">
                                                <Border Classes="explicit-badge compact"
                                                        Margin="6,0,0,0"
                                                        IsVisible="{Binding Track.IsExplicit}"
                                                        ToolTip.Tip="{loc:T LibraryAlbums.ExplicitTip}">
                                                    <TextBlock Text="E"
                                                               Classes="explicit-badge-text compact"
                                                               FontSize="8"
                                                               Opacity="0.9" />
                                                </Border>
                                            </InlineUIContainer>
                                        </TextBlock>
                                        <!-- Album credit so strays filed under the wrong album are spottable -->
                                        <TextBlock Text="{Binding Track.Album}"
                                                   FontSize="11"
                                                   Opacity="0.55"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />
                                    </StackPanel>
                                    <ctrl:HeartIcon Grid.Column="1" Size="14" ShowWhenOff="False"
                                    Margin="6,0,0,0" VerticalAlignment="Center"
                                    IsFavorite="{Binding Track.IsFavorite}" />
                                </Grid>
                                <StackPanel Grid.Column="3"
                                            Orientation="Horizontal"
                                            Spacing="3"
                                            VerticalAlignment="Center"
                                            Margin="0,0,14,0"
                                            ToolTip.Tip="{loc:T LibraryAlbums.ListenCountTip}">
                                    <TextBlock Text="{Binding Track.PlayCount}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Opacity="0.75"
                                               VerticalAlignment="Center" />
                                    <TextBlock IsVisible="{Binding Track.PlayCount, Converter={x:Static conv:PlayCountConverters.IsNotOne}}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Opacity="0.55"
                                               VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{x:Static conv:PluralWordConverter.Instance}" ConverterParameter="LibraryAlbums.Plays">
                                                <Binding Path="Track.PlayCount" />
                                                <ReflectionBinding Path="[LibraryAlbums.Plays]" Source="{x:Static loc:Loc.Instance}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="{loc:T Common.Play}"
                                               IsVisible="{Binding Track.PlayCount, Converter={x:Static conv:PlayCountConverters.IsOne}}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Opacity="0.55"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <!-- Album spacing. Default = 1.6.9: 4px of padding round each cover, so neighbouring
             covers sit 8px apart (AlbumGridMetrics.ClassicTileChrome), and every row is one
             height (TileRowHeight). Settings › "Wider spacing between albums" (.wide-album-gap)
             keeps GitHub #210: 3px side / 2px top-bottom margins + 6px padding, and each grid
             row (ListBoxItem) adds 1px all round (app style), so cover-to-cover and
             caption-to-next-cover are both 18px; the 13px top margin puts the first cover as
             far from the top as from the left (22px). The Masonry panel shares the tile
             template, so it follows the same gap. -->
        <Style Selector="Button.album-tile">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector=".wide-album-gap Button.album-tile">
            <Setter Property="Margin" Value="3,2" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style Selector="DockPanel.albums-dock">
            <Setter Property="Margin" Value="12,8,2,8" />
        </Style>
        <Style Selector=".wide-album-gap DockPanel.albums-dock">
            <Setter Property="Margin" Value="12,13,2,8" />
        </Style>
        <!-- Rank numerals for the artist page's Songs pills (local copy of HomeView's style) -->
        <Style Selector="TextBlock.rank-num">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Opacity" Value="0.32"/>
        </Style>
        <!-- Podium: #1 gold, #2 silver, #3 bronze (brushes in Styles.axaml). -->
        <Style Selector="TextBlock.rank-num.gold">
            <Setter Property="Foreground" Value="{DynamicResource RankGoldBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="TextBlock.rank-num.silver">
            <Setter Property="Foreground" Value="{DynamicResource RankSilverBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="TextBlock.rank-num.bronze">
            <Setter Property="Foreground" Value="{DynamicResource RankBronzeBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*">
        <!-- Right margin trimmed to 2 so the vertical scrollbar sits near the window
             edge (Apple Music style) instead of being inset ~12px from it. -->
        <!-- Margin: DockPanel.albums-dock styles above (8px top, 13px with wide spacing). -->
        <DockPanel Grid.Row="0" Classes="albums-dock">

        <!-- Content area with overlay for empty state -->
        <Grid>
            <!-- Album grid: outer ListBox virtualizes rows, inner UniformGrid lays out GridColumns per row -->
            <ListBox x:Name="AlbumListBox"
                     IsVisible="{Binding IsRowGridView}"
                     ItemsSource="{Binding FilteredAlbumRows}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,0,0,115"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     ScrollViewer.AllowAutoHide="False"
                     SelectionMode="Single"
                     AutoScrollToSelectedItem="False">
                <!-- Rows scrolled off stay in the tree and take the next albums (11-14). -->
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctrl:RetainingVirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <!-- Unclipped (an Avalonia 12 TemplatedControl clips to its bounds): the
                         hovered cover's grow and glow run past its row (Album Hover Zoom). -->
                    <Style Selector="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="ClipToBounds" Value="False" />
                    </Style>
                </ListBox.Styles>
                <ListBox.DataTemplates>
                    <DataTemplate DataType="m:AlbumRow">
                        <!-- One height for every row (1.6.9): cover + 64, room for a two-line
                             title. With wide spacing TileRowHeight is NaN and rows size to their
                             tallest caption (GitHub #210). -->
                        <!-- Column count mirrors the VM's row chunk size (cover-size setting). A row
                             re-used for other albums keeps its tiles (TileRow, 11-14). -->
                        <ctrl:TileRow Items="{Binding Albums}" ItemTemplate="{StaticResource AlbumTileTemplate}"
                                      Height="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).TileRowHeight}"
                                      Columns="{Binding $parent[UserControl].((vm:LibraryAlbumsViewModel)DataContext).GridColumns}" Rows="1" />
                    </DataTemplate>
                </ListBox.DataTemplates>
            </ListBox>

            <!-- Masonry layout (GitHub #213): the same filtered, sorted albums stacked per
                 column by their real height. MasonryAlbumPanel realizes only the tiles near the
                 viewport; the bottom padding clears the floating playback bar as the grid's does. -->
            <ScrollViewer x:Name="MasonryScroller"
                          IsVisible="{Binding IsMasonryView}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Visible"
                          AllowAutoHide="False"
                          Background="Transparent">
                <!-- A genre page's Songs section (header, song rows, "Albums") scrolls above the
                     cards, as in the row grid (GitHub #259). The cards draw above it: a hovered
                     first-row cover grows over the "Albums" header. -->
                <StackPanel>
                    <ItemsControl x:Name="MasonrySections"
                                  ItemsSource="{Binding MasonrySectionRows}"
                                  IsVisible="{Binding MasonrySectionRows.Count}"
                                  Margin="1,1,1,0" />
                    <ctrl:MasonryAlbumPanel x:Name="MasonryPanel"
                                            ZIndex="1"
                                            Margin="1,1,1,115"
                                            Spacing="2"
                                            Albums="{Binding CarouselAlbums}"
                                            Columns="{Binding GridColumns}"
                                            ArtworkSize="{Binding TileArtworkSize}"
                                            ItemTemplate="{StaticResource AlbumTileTemplate}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Carousel layout (GitHub #149, top-bar View menu): the same filtered, sorted
                 albums one at a time, Cover Flow style. Clicking the centred album opens it,
                 like a grid tile. Bottom margin clears the floating playback bar. GitHub #244:
                 the row runs on to both window edges (under the sidebar rail too). -->
            <ctrl:AlbumCarousel x:Name="AlbumCarousel"
                                IsVisible="{Binding IsCarouselView}"
                                Albums="{Binding CarouselAlbums}"
                                CaseStyle="{Binding CarouselStyle}"
                                CenterAlbum="{Binding CarouselCenterAlbum}"
                                OpenCommand="{Binding OpenAlbumCommand}"
                                BleedToWindowEdges="True"
                                Margin="0,4,10,110" />

            <!-- Empty state overlay. With a search or a Type / Quality filter on, the library is
                 not empty: say nothing matches instead of "add music folders" (live check 10-10:
                 Type → Live Albums on a library without any read "Add music folders in Settings"). -->
            <StackPanel IsVisible="{Binding !FilteredAlbumRows.Count}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock Text="{loc:T LibraryAlbums.NoAlbumsFound}"
                           IsVisible="{Binding !HasActiveFilter}"
                           FontSize="18"
                           Opacity="0.5"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <!-- A genre or artist page with nothing left (its genre split away by Genre Tag
                     Separators, #260) is not an empty library either. -->
                <TextBlock Text="{loc:T LibraryAlbums.AddMusicFoldersSettings}"
                           FontSize="13"
                           Opacity="0.3"
                           HorizontalAlignment="Center"
                           TextAlignment="Center">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!HasActiveFilter" />
                            <Binding Path="!IsPageFiltered" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
                <TextBlock Text="{loc:T LibraryAlbums.NoFilterMatches}"
                           IsVisible="{Binding HasActiveFilter}"
                           FontSize="18"
                           Opacity="0.5"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <TextBlock Text="{loc:T LibraryAlbums.NoFilterMatchesHint}"
                           IsVisible="{Binding HasActiveFilter}"
                           FontSize="13"
                           Opacity="0.3"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>

            <!-- Rubber-band selection (GitHub #226): placed from code while a drag that began
                 on empty space (page margins, the gaps between covers) sweeps the grid. -->
            <Canvas x:Name="BandLayer" IsHitTestVisible="False" ClipToBounds="True">
                <Border x:Name="BandRect"
                        IsVisible="False"
                        CornerRadius="3"
                        BorderThickness="1"
                        Background="{DynamicResource SelectionFillBrush}"
                        BorderBrush="{DynamicResource SelectionStrokeBrush}" />
            </Canvas>
        </Grid>

        </DockPanel>
    </Grid>

</UserControl>
