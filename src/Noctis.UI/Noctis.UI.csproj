<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Shared Avalonia look: themes, styles, icons, fonts, converters, and the
         controls and helpers that carry no desktop-only dependency. The desktop app
         and the Android head both reference it; Android cannot reference the desktop
         project (Windows TFM, LibVLC, WASAPI, Whisper). Resources are addressed as
         avares://Noctis.UI/Assets/... -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Noctis</RootNamespace>
    <AssemblyName>Noctis.UI</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>CS0067;MVVMTK0039;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Noctis" />
    <InternalsVisibleTo Include="Noctis.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Labs.Lottie" Version="12.0.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Noctis.Core\Noctis.Core.csproj" />
  </ItemGroup>

</Project>
