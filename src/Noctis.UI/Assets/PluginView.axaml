<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Noctis.Controls"
        xmlns:helpers="using:Noctis.Helpers">
    <!--
        Noctis's look for a plugin's own window (owner 10-29: plugin windows must match the app).
        PluginViewWindow adds this file to its Styles (PluginViewTheme.Apply), so every plugin view,
        official or not, gets it without referencing anything but the plugin SDK:

          CheckBox                 the round pill switch of Settings (label left, switch right)
          Button, ToggleButton     rounded pills; TextBox (single line) a rounded pill field
          ComboBox                 a pill; its drop-down list is frosted glass over the window
          ContextMenu, MenuFlyout  frosted glass over the window (the app's menu card, blurred);
                                   a MenuFlyout filled in its Opening event shows its rows
          every Popup              drawn in the window's overlay layer, so the glass can see what
                                   is behind it (a separate native popup window cannot be frosted)

        Plus the pop-up design's classes (PillDialog.axaml: pill-primary, pill-secondary,
        pill-field, pill-well ...) and two for a pop-up inside a view, like PillDialogHost:
          ContentControl.plugin-backdrop   fills the view: the view behind it blurred and dimmed
          Border.plugin-dialog             the floating card on top

        A plugin's own Styles still win over these (they sit closer to its controls).
    -->

    <StyleInclude Source="avares://Noctis.UI/Assets/PillDialog.axaml" />

    <!-- ── Pop-ups in the window's overlay layer, so they can be frosted ── -->
    <Style Selector="Popup">
        <Setter Property="ShouldUseOverlayLayer" Value="True" />
    </Style>

    <!-- ── Menus: the app's menu card as frosted glass ── -->
    <!-- A MenuFlyout that fills itself in Opening shows its rows (Helpers/MenuFlyoutItemsSync.cs). -->
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="(helpers:MenuFlyoutItemsSync.Enable)" Value="True" />
    </Style>
    <Style Selector="ContextMenu, MenuFlyoutPresenter">
        <Setter Property="(helpers:MenuOpenAnimation.UseFade)" Value="True" />
        <Setter Property="Background" Value="{DynamicResource AppSidebarBackground}" />
        <Setter Property="Template">
            <ControlTemplate>
                <controls:GlassPanel Name="PluginGlass"
                                     UseAppGlass="False" IsGlassActive="True"
                                     BlurRadius="18" GlassTintOpacity="0.72"
                                     Background="{TemplateBinding Background}"
                                     CornerRadius="{TemplateBinding CornerRadius}"
                                     Padding="{TemplateBinding Padding}"
                                     MaxWidth="{TemplateBinding MaxWidth}"
                                     HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                     Fade="{TemplateBinding (helpers:MenuOpenAnimation.Fade)}">
                    <ScrollViewer Opacity="{TemplateBinding (helpers:MenuOpenAnimation.Fade)}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                        KeyboardNavigation.TabNavigation="Continue"
                                        Grid.IsSharedSizeScope="True" />
                    </ScrollViewer>
                </controls:GlassPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ── CheckBox: the Settings switch (LottieToggle's 52 x 26 track and 20 px knob) ── -->
    <Style Selector="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto" Background="{TemplateBinding Background}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      Padding="{TemplateBinding Padding}"
                                      Margin="0,0,14,0"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Border Name="SwitchTrack" Grid.Column="1" Width="52" Height="26" CornerRadius="13"
                            VerticalAlignment="Center" BorderThickness="1.5" BorderBrush="Transparent"
                            Background="{DynamicResource ToggleTrackOffBrush}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
                            </Transitions>
                        </Border.Transitions>
                        <Border Name="SwitchKnob" Width="20" Height="20" CornerRadius="10"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1.5,0,0,0"
                                Background="{DynamicResource ToggleKnobOffBrush}">
                            <Border.Transitions>
                                <Transitions>
                                    <ThicknessTransition Property="Margin" Duration="0:0:0.18" Easing="CubicEaseOut" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#SwitchTrack">
        <Setter Property="Background" Value="{DynamicResource AccentColorBrush}" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#SwitchKnob">
        <Setter Property="Margin" Value="27.5,0,0,0" />
        <Setter Property="Background" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>
    <Style Selector="CheckBox:focus-visible /template/ Border#SwitchTrack">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Style Selector="CheckBox:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- ── Buttons and single-line text boxes: rounded pills ── -->
    <Style Selector="Button, ToggleButton">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TextBox[AcceptsReturn=False]">
        <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="TextBox[AcceptsReturn=False] /template/ Border#PART_BorderElement">
        <Setter Property="CornerRadius" Value="999" />
    </Style>

    <!-- ── ComboBox: a pill, and its list frosted over the window ── -->
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="16,8,12,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{DynamicResource PillFieldBackground}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,32">
                    <Border Name="Background" Grid.ColumnSpan="2"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                    <Border Name="HighlightBackground" Grid.ColumnSpan="2" IsVisible="False"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                    <TextBlock Name="PlaceholderTextBlock"
                               Margin="{TemplateBinding Padding}"
                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                               Text="{TemplateBinding PlaceholderText}"
                               Foreground="{TemplateBinding PlaceholderForeground}"
                               Opacity="0.6"
                               IsVisible="{TemplateBinding SelectionBoxItem, Converter={x:Static ObjectConverters.IsNull}}" />
                    <ContentControl Name="ContentPresenter"
                                    Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    <PathIcon Name="DropDownGlyph" Grid.Column="1" Width="11" Height="11" Margin="0,0,14,0"
                              HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.7"
                              Data="M1939 486L2029 576L1024 1581L19 576L109 486L1024 1401L1939 486Z" />
                    <Popup Name="PART_Popup"
                           WindowManagerAddShadowHint="False"
                           IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                           MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                           MaxHeight="{TemplateBinding MaxDropDownHeight}"
                           PlacementTarget="Background"
                           Placement="BottomEdgeAlignedLeft"
                           VerticalOffset="4"
                           IsLightDismissEnabled="True"
                           InheritsTransform="True">
                        <controls:GlassPanel Name="PopupBorder"
                                             UseAppGlass="False" IsGlassActive="True"
                                             BlurRadius="18" GlassTintOpacity="0.72"
                                             Background="{DynamicResource AppSidebarBackground}"
                                             CornerRadius="18" Padding="4">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </controls:GlassPanel>
                    </Popup>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource PillFieldBackgroundPointerOver}" />
    </Style>
    <Style Selector="ComboBox:dropdownopen /template/ Border#Background, ComboBox:focus-visible /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
    </Style>
    <Style Selector="ComboBox:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="ComboBox ComboBoxItem">
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="ComboBox ComboBoxItem /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="999" />
    </Style>

    <!-- ── A pop-up inside a view (PillDialogHost's look) ── -->
    <!-- The view behind, blurred and dimmed: put it over the view, under the card. Background is
         the dim (the plugin sets it, so an older Noctis without this file still dims). -->
    <Style Selector="ContentControl.plugin-backdrop">
        <Setter Property="Template">
            <ControlTemplate>
                <controls:GlassPanel Name="BackdropGlass"
                                     UseAppGlass="False" IsGlassActive="True"
                                     BlurRadius="22" EdgeBrush="{x:Null}" EdgeThickness="0"
                                     GlassTint="Black" GlassTintOpacity="0.32"
                                     Background="{TemplateBinding Background}">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </controls:GlassPanel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Border.plugin-dialog">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PillDialogRimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="BoxShadow" Value="0 18 48 0 #66000000" />
    </Style>
</Styles>
