<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ More menu line icons (context menu v2, 10-09) ═══
         Same rules as the "Menu line icons" block in Icons.axaml: open strokes on a 24 grid,
         drawn by MenuV2.LineIcon (StrokeThickness 2.25 in a 16px Viewbox = 1.5px). Used by the
         folder, playlist and sidebar menus. Merged next to Icons.axaml (App.axaml), which owns
         every other MenuLine* key: only keys Icons.axaml does not have belong here. -->

    <!-- Remove from Playlist: the Add to Playlist list with a minus instead of a plus -->
    <StreamGeometry x:Key="MenuLinePlaylistRemove">M4.5 6h11M4.5 11h11M4.5 16h6.5M14 17h7</StreamGeometry>
    <!-- View Playlist: a list with a note -->
    <StreamGeometry x:Key="MenuLinePlaylist">M4.5 6h11M4.5 11h11M4.5 16h6M17 17.5V9.5l3 1M17 17.5a2 2 0 1 1-4 0a2 2 0 0 1 4 0Z</StreamGeometry>
    <!-- Show in Library: an eye -->
    <StreamGeometry x:Key="MenuLineEye">M2.8 12C4.7 8 8 5.8 12 5.8C16 5.8 19.3 8 21.2 12C19.3 16 16 18.2 12 18.2C8 18.2 4.7 16 2.8 12ZM12 14.8a2.8 2.8 0 1 0 0-5.6a2.8 2.8 0 0 0 0 5.6Z</StreamGeometry>
    <!-- Hide from Library: the eye, struck through -->
    <StreamGeometry x:Key="MenuLineEyeOff">M2.8 12C4.7 8 8 5.8 12 5.8C16 5.8 19.3 8 21.2 12C19.3 16 16 18.2 12 18.2C8 18.2 4.7 16 2.8 12ZM12 14.8a2.8 2.8 0 1 0 0-5.6a2.8 2.8 0 0 0 0 5.6ZM4.5 4.5l15 15</StreamGeometry>
    <!-- Export: an arrow out of a tray (the mirror of MenuLineImport in Icons.axaml) -->
    <StreamGeometry x:Key="MenuLineExport">M12 15V4.5M8 8.5l4-4l4 4M4.5 14v4a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5v-4</StreamGeometry>
    <!-- Drag grip (playlist row hover): six dots, zero-length strokes whose round caps are the
         dots; draw it with a heavier stroke (LineIcon StrokeThickness ~3.6) so they read. -->
    <StreamGeometry x:Key="LineGrip">M9 6.5h.01M15 6.5h.01M9 12h.01M15 12h.01M9 17.5h.01M15 17.5h.01</StreamGeometry>
    <!-- Remove from Folder: the folder with a minus -->
    <StreamGeometry x:Key="MenuLineFolderRemove">M3.5 7.2A1.7 1.7 0 0 1 5.2 5.5h3.6c.5 0 .9.2 1.2.5l1.4 1.5h7.4a1.7 1.7 0 0 1 1.7 1.7v8.6a1.7 1.7 0 0 1-1.7 1.7H5.2a1.7 1.7 0 0 1-1.7-1.7ZM9.5 13.5h5</StreamGeometry>
</ResourceDictionary>
