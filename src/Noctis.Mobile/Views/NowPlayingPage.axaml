<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:controls="using:Noctis.Controls"
             xmlns:conv="using:Noctis.Converters"
             x:Class="Noctis.Mobile.Views.NowPlayingPage"
             x:DataType="vm:ShellViewModel"
             Background="#FF121214"
             Foreground="White">

    <UserControl.Resources>
        <conv:PreBlurredArtworkConverter x:Key="PreBlur" />
    </UserControl.Resources>

    <!-- Always dark (ruling 8): white controls over the blurred cover and scrim. -->
    <UserControl.Styles>
        <Style Selector="Button.icon, Button.round, Button.row">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.round">
            <Setter Property="Background" Value="#26FFFFFF" />
        </Style>
        <Style Selector="Button.dim">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="TextBlock.np-sub">
            <Setter Property="Foreground" Value="#B3FFFFFF" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- Blurred once per cover (PreBlurredArtworkConverter) from the visible cover's own bitmap. -->
        <Image Name="Backdrop" Source="{Binding #Artwork.Source, Converter={StaticResource PreBlur}}"
               Stretch="UniformToFill" IsHitTestVisible="False" />
        <Border Background="#99000000" IsHitTestVisible="False" />

        <Border Padding="{Binding SafeArea}">
            <!-- Portrait: one column. Landscape (the code-behind, on resize): the cover on the
                 left across every row, the controls on the right. -->
            <Grid Name="Layout" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="24,4,24,12">
                <Button Grid.Row="0" Classes="icon" HorizontalAlignment="Left" Command="{Binding CloseNowPlayingCommand}">
                    <PathIcon Data="{DynamicResource PhChevronDown}" Width="26" Height="26" />
                </Button>

                <!-- A fixed 320 box scaled to the row: shrinks in landscape instead of pushing the transport off screen. -->
                <Viewbox Grid.Row="1" Name="ArtworkBox" Stretch="Uniform" Margin="0,8">
                    <Border Classes="art" Width="320" Height="320" CornerRadius="14">
                        <Panel>
                            <PathIcon Data="{DynamicResource SongsIcon}" Width="72" Height="72" Opacity="0.4" />
                            <controls:CachedImage Name="Artwork" SourcePath="{Binding Player.CurrentTrack.AlbumArtworkPath}"
                                                  DecodeWidth="768" ClearOnSourceChange="False" Stretch="UniformToFill" />
                        </Panel>
                    </Border>
                </Viewbox>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Name="TitleText" Text="{Binding Player.CurrentTrack.Title}" FontSize="21" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Name="ArtistButton" Classes="row" HorizontalAlignment="Left" Command="{Binding OpenCurrentArtistCommand}">
                            <TextBlock Classes="np-sub" Text="{Binding Player.CurrentTrack.Artist}" FontSize="16" TextTrimming="CharacterEllipsis" />
                        </Button>
                    </StackPanel>
                    <Button Grid.Column="1" Name="FavouriteButton" Classes="icon" Command="{Binding ToggleCurrentFavouriteCommand}">
                        <controls:HeartIcon IsFavorite="{Binding Player.CurrentTrack.IsFavorite}" Size="26"
                                           Glyph="{DynamicResource PhHeartFill}" OffGlyph="{DynamicResource PhHeart}" />
                    </Button>
                    <Button Grid.Column="2" Name="NowPlayingMore" Classes="icon" Command="{Binding OpenCurrentTrackSheetCommand}">
                        <PathIcon Data="{DynamicResource PhMore}" Width="24" Height="24" />
                    </Button>
                </Grid>

                <Grid Grid.Row="3" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
                    <!-- The pointer handlers are registered in the code-behind with Tunnel routing,
                         not as XAML event attributes; see NowPlayingPage.axaml.cs for why. -->
                    <Slider Name="SeekBar" Minimum="0" Maximum="{Binding Player.Duration.TotalSeconds}"
                            Value="{Binding Player.Position.TotalSeconds, Mode=OneWay}" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,*">
                        <TextBlock Name="ElapsedText" Classes="np-sub" FontSize="12" Text="{Binding Player.ElapsedText}" />
                        <TextBlock Grid.Column="1" Name="RemainingText" Classes="np-sub" FontSize="12" HorizontalAlignment="Right"
                                   Text="{Binding Player.RemainingText}" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,*" Margin="0,4">
                    <Button Grid.Column="1" Name="ShuffleButton" Classes="icon" Classes.dim="{Binding !Player.IsShuffleEnabled}"
                            Command="{Binding Player.ToggleShuffleCommand}">
                        <PathIcon Data="{DynamicResource PhShuffle}" Width="24" Height="24" />
                    </Button>
                    <Button Grid.Column="2" Name="PreviousButton" Classes="icon" Width="60" Height="60" Margin="12,0"
                            Command="{Binding Player.PreviousCommand}">
                        <PathIcon Data="{DynamicResource PhRewindFill}" Width="44" Height="44" />
                    </Button>
                    <Button Grid.Column="3" Name="PlayPauseButton" Classes="icon" Width="72" Height="72" CornerRadius="36"
                            Command="{Binding Player.TogglePlayPauseCommand}">
                        <Panel>
                            <PathIcon Data="{DynamicResource PhPlayFill}" Width="54" Height="54" IsVisible="{Binding !Player.IsPlaying}" />
                            <PathIcon Data="{DynamicResource PhPauseFill}" Width="54" Height="54" IsVisible="{Binding Player.IsPlaying}" />
                        </Panel>
                    </Button>
                    <Button Grid.Column="4" Name="NextButton" Classes="icon" Width="60" Height="60" Margin="12,0"
                            Command="{Binding Player.NextCommand}">
                        <PathIcon Data="{DynamicResource PhForwardFill}" Width="44" Height="44" />
                    </Button>
                    <Button Grid.Column="5" Name="RepeatButton" Classes="icon" Classes.dim="{Binding !Player.IsRepeatOn}"
                            Command="{Binding Player.CycleRepeatCommand}">
                        <Panel>
                            <PathIcon Data="{DynamicResource PhRepeat}" Width="24" Height="24" IsVisible="{Binding !Player.IsRepeatOne}" />
                            <PathIcon Data="{DynamicResource PhRepeatOne}" Width="24" Height="24" IsVisible="{Binding Player.IsRepeatOne}" />
                        </Panel>
                    </Button>
                </Grid>

                <Grid Grid.Row="5" Name="VolumeRow" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding Player.HasVolumeControl}">
                    <PathIcon Data="{DynamicResource PhVolumeLow}" Width="22" Height="22" Opacity="0.7" />
                    <Slider Grid.Column="1" Name="VolumeSlider" Minimum="0" Maximum="1" Margin="10,0"
                            Value="{Binding Player.VolumeLevel}" />
                    <PathIcon Grid.Column="2" Data="{DynamicResource PhVolumeHigh}" Width="22" Height="22" Opacity="0.7" />
                </Grid>

                <StackPanel Grid.Row="6">
                    <TextBlock Name="ErrorLine" Text="{Binding Player.ErrorText}" Foreground="#E74856" FontSize="12" TextWrapping="Wrap"
                               IsVisible="{Binding Player.ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                        <Button Grid.Column="0" Name="LyricsButton" Classes="icon" HorizontalAlignment="Center" Command="{Binding ToggleLyricsCommand}">
                            <PathIcon Data="{DynamicResource PhLyrics}" />
                        </Button>
                        <Button Grid.Column="1" Name="OutputButton" Classes="icon" HorizontalAlignment="Center" Command="{Binding ShowOutputCommand}">
                            <PathIcon Data="{DynamicResource PhVolumeHigh}" />
                        </Button>
                        <Button Grid.Column="2" Name="QueueButton" Classes="icon" HorizontalAlignment="Center" Command="{Binding ToggleQueueCommand}">
                            <PathIcon Data="{DynamicResource PhList}" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Panel>
</UserControl>
