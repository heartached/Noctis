<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:controls="using:Noctis.Controls"
             xmlns:conv="using:Noctis.Converters"
             xmlns:views="using:Noctis.Mobile.Views"
             xmlns:models="using:Noctis.Models"
             x:Class="Noctis.Mobile.Views.NowPlayingPage"
             x:DataType="vm:ShellViewModel"
             Background="#FF121214"
             Foreground="White">

    <UserControl.Resources>
        <conv:PreBlurredArtworkConverter x:Key="PreBlur" />
        <!-- The quality badge's ink: a shade under the title's white, over the capsule's veil. -->
        <SolidColorBrush x:Key="NowPlayingBadgeText" Color="#E0FFFFFF" />
    </UserControl.Resources>

    <!-- Always dark (ruling 8): white controls over the blurred cover and scrim. Laid out as
         Apple Music's (owner 10-13): title and artist with a plain ⋯ beside them, the timeline,
         one row of filled transport glyphs, the volume, then Lyrics / Output / Queue. -->
    <UserControl.Styles>
        <Style Selector="Button.icon, Button.row">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.np-sub">
            <Setter Property="Foreground" Value="#99FFFFFF" />
        </Style>
        <Style Selector="TextBlock.np-time">
            <Setter Property="Foreground" Value="#80FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.transport">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="72" />
            <Setter Property="CornerRadius" Value="36" />
        </Style>
        <!-- The quality badge: a capsule of the menus' hairline over a breath of white (the
             MenuGlass family's dark edge and veil, without the frost: nothing to re-snapshot),
             with a tap target taller than it looks. -->
        <Style Selector="Button.np-badge">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style Selector="Border.np-badge-pill">
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="BorderBrush" Value="#2EFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="9,3,10,3" />
            <Setter Property="Height" Value="23" />
        </Style>
        <!-- Shuffle and Repeat at the transport's ends (beta 2: testers could not find them in
             the Queue). Plain glyphs, dimmed while off; on, full white over a faint white square
             (the Queue pill's on state, in Now Playing's always-white ink). 36 wide so the row
             still fits a 360 dp phone: 3 x 80 + 2 x 36 = 312, the column between the margins. -->
        <Style Selector="Button.icon.np-mode">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.icon.np-mode PathIcon">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="#8CFFFFFF" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon.np-mode Border.np-mode-wash">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#2EFFFFFF" />
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.icon.np-mode.on Border.np-mode-wash">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Button.icon.np-mode.on PathIcon">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- The bottom row = the desktop player bar's Lyrics, Volume and Queue buttons, their
             glyphs and proportions: Lyrics and Queue in one box, the speaker at 16 of their 18. -->
        <Style Selector="Button.icon.bottom PathIcon">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
        </Style>
        <Style Selector="Button.icon.bottom PathIcon.speaker">
            <Setter Property="Width" Value="21.3" />
            <Setter Property="Height" Value="21.3" />
        </Style>
        <!-- The cover sits back while paused and comes forward when playing (Apple's). Nothing
             per-frame drives the class: IsPlaying changes only on play/pause. -->
        <Style Selector="Border#ArtworkFrame">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.45">
                        <TransformOperationsTransition.Easing>
                            <views:GlideEase />
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#ArtworkFrame.paused">
            <Setter Property="RenderTransform" Value="scale(0.8)" />
        </Style>
        <!-- Vinyl or CD: the square cover stays in the tree, unseen (it decodes the artwork the
             disc prints and the wash blurs), and the disc takes its place. The disc sits back a
             little while paused too, less than the cover: its stopping says the rest. -->
        <Style Selector="Border#ArtworkFrame.disc">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Panel#DiscStage">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.45">
                        <TransformOperationsTransition.Easing>
                            <views:GlideEase />
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#ArtworkGhostFrame">
            <Setter Property="Width" Value="320" />
            <Setter Property="Height" Value="320" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Border#ArtworkGhostFrame.disc">
            <Setter Property="Width" Value="296" />
            <Setter Property="Height" Value="296" />
            <Setter Property="CornerRadius" Value="148" />
        </Style>
        <Style Selector="Panel#DiscStage.paused">
            <Setter Property="RenderTransform" Value="scale(0.92)" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- The wash (owner 10-14, after Apple Music's Now Playing): the cover's colours carry on
             below it as a soft wash that darkens toward the bottom, no edge and no bands. Three
             static layers, drawn once per cover and never per frame:
             1. the cover blurred to colour alone (PreBlurredArtworkConverter's "wash": 128 px,
                three times the lyrics backdrop's blur) and stretched over the whole screen - the
                cover's top colours at the top, its bottom colours at the bottom, nothing cropped;
             2. a vertical shade: light where the cover sits, darker from the title down, darkest
                under the transport and the bottom icons, so white text and glyphs read on any
                cover (Apple's reference, measured: its wash falls to a third of its brightness
                between the cover's foot and the screen's); gradient stops close together, so each
                step is small (MobileNowPlayingPageTests checks the shade and the dither);
             3. a tile of faint noise (NowPlayingPage.axaml.cs, +-5/255): an 8-bit gradient this
                long otherwise lands in visible bands; a hair of noise breaks them up. -->
        <Image Name="Backdrop" Source="{Binding #Artwork.Source, Converter={StaticResource PreBlur}, ConverterParameter=wash}"
               Stretch="Fill" IsHitTestVisible="False" />
        <Border Name="WashShade" IsHitTestVisible="False" Opacity="{Binding NowPlayingShadeOpacity}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#4D000000" />
                    <GradientStop Offset="0.30" Color="#59000000" />
                    <GradientStop Offset="0.45" Color="#73000000" />
                    <GradientStop Offset="0.58" Color="#8F000000" />
                    <GradientStop Offset="0.72" Color="#A6000000" />
                    <GradientStop Offset="0.86" Color="#B5000000" />
                    <GradientStop Offset="1" Color="#BF000000" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border Name="WashDither" IsHitTestVisible="False" />
        <!-- Settings › Appearance › Now Playing Background: darker lays black over the wash
             (ShellViewModel.NowPlayingDimOpacity), brighter thins the shade itself. -->
        <Border Name="WashDim" Background="Black" IsHitTestVisible="False" Opacity="{Binding NowPlayingDimOpacity}" />

        <Border Padding="{Binding SafeArea}">
            <!-- Portrait: one column. Landscape (the code-behind, on resize): the cover on the
                 left across every row, the controls on the right. -->
            <Grid Name="Layout" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="24,0,24,8">
                <!-- Apple's grabber: tap to close (Back closes too). -->
                <Button Grid.Row="0" Name="GrabberButton" Classes="row" HorizontalAlignment="Center" Width="96" Height="32"
                        Command="{Binding CloseNowPlayingCommand}" AutomationProperties.Name="{loc:T Common.Close}">
                    <Border Width="40" Height="5" CornerRadius="2.5" Background="#59FFFFFF"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- A fixed 320 box scaled to the row: shrinks in landscape instead of pushing the transport off screen.
                     Not clipped: the box is exactly the cover's size, and a Viewbox clips by default, which cut
                     the cover's shadow off at its square bounds - only the slivers round the corners showed,
                     square-cornered (beta 2, "the corners on the cover have a sharp edge shadow"). -->
                <Viewbox Grid.Row="1" Name="ArtworkBox" Stretch="Uniform" Margin="0,8" ClipToBounds="False">
                  <Panel Width="320" Height="320">
                    <Border Name="ArtworkFrame" Width="320" Height="320" CornerRadius="10"
                            BoxShadow="0 10 28 0 #66000000" Classes.paused="{Binding !Player.IsPlaying}"
                            Classes.disc="{Binding ShowsDiscArtwork}">
                        <Border Classes="art" CornerRadius="10">
                            <Panel>
                                <PathIcon Data="{DynamicResource SongsIcon}" Width="72" Height="72" Opacity="0.4" />
                                <controls:CachedImage Name="Artwork" SourcePath="{Binding Player.CurrentTrack.AlbumArtworkPath}"
                                                      DecodeWidth="768" ClearOnSourceChange="False" Stretch="UniformToFill" />
                            </Panel>
                        </Border>
                    </Border>
                    <!-- Settings › Appearance › Now Playing Artwork: the cover on a record or a CD
                         (DiscArtwork: painted once per cover, turned on the compositor). The
                         shadow is a round border's, so the CD's hole stays see-through; the disc sits
                         12 in from the cover's edges so all of its shadow fits inside the box (the
                         row clips at it, and a cut shadow shows as a seam). -->
                    <Panel Name="DiscStage" Margin="12" IsVisible="{Binding ShowsDiscArtwork}" Classes.paused="{Binding !Player.IsPlaying}">
                        <Border Name="DiscShadow" CornerRadius="148" BoxShadow="0 4 11 0 #8C000000" IsHitTestVisible="False" />
                        <views:DiscArtwork Name="Disc" Kind="{Binding NowPlayingArtwork}" Source="{Binding #Artwork.Source}"
                                           IsSpinning="{Binding Player.IsPlaying}" IsVisible="{Binding ShowsDiscArtwork}" />
                    </Panel>
                  </Panel>
                </Viewbox>

                <!-- The cover a sideways swipe brings in (TrackSwipeGesture): the next song's from
                     the right, the previous one's from the left, round on the record and CD
                     styles. Unseen until the finger moves; its image's data is that Track. -->
                <Viewbox Grid.Row="1" Name="ArtworkGhostBox" Stretch="Uniform" Margin="0,8"
                         IsVisible="False" IsHitTestVisible="False">
                  <Panel Width="320" Height="320">
                    <Border Name="ArtworkGhostFrame" Classes="art"
                            Classes.disc="{Binding ShowsDiscArtwork}">
                        <Panel>
                            <PathIcon Data="{DynamicResource SongsIcon}" Width="72" Height="72" Opacity="0.4" />
                            <controls:CachedImage Name="GhostArtwork" x:DataType="models:Track" SourcePath="{Binding AlbumArtworkPath}"
                                                  DecodeWidth="768" Stretch="UniformToFill" />
                        </Panel>
                    </Border>
                  </Panel>
                </Viewbox>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <!-- Left-aligned so the explicit badge follows the title, not the row's end. -->
                        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                            <TextBlock Name="TitleText" Text="{Binding Player.CurrentTrack.Title}" FontSize="20" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Name="TitleExplicit" Classes="explicit-badge" Margin="8,0,0,0"
                                    IsVisible="{Binding Player.CurrentTrack.IsExplicit, FallbackValue=False}">
                                <TextBlock Text="E" Classes="explicit-badge-text" FontSize="10" Opacity="0.9" />
                            </Border>
                        </Grid>
                        <!-- Apple's: a tap pops Go to Album / Go to Artist out of the artist (PopMenu). -->
                        <Button Name="ArtistButton" Classes="row" HorizontalAlignment="Left" Command="{Binding OpenCurrentLinksCommand}">
                            <TextBlock Classes="np-sub" Text="{Binding Player.CurrentTrack.Artist}" FontSize="20" TextTrimming="CharacterEllipsis" />
                        </Button>
                    </StackPanel>
                    <!-- A sleep timer is set: what is left, on the quality badge's capsule; a tap
                         opens its choices (Turn Off Timer among them) out of it. -->
                    <Button Grid.Column="1" Name="SleepTimerPill" Classes="row np-badge" Margin="8,0,0,0"
                            Command="{Binding ShowSleepTimerMenuCommand}" IsVisible="{Binding Player.HasSleepTimer}"
                            AutomationProperties.Name="{Binding Player.SleepTimerStatus}">
                        <Border Classes="np-badge-pill">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Data="{DynamicResource PhTimer}" Width="13" Height="13" VerticalAlignment="Center"
                                          Foreground="{DynamicResource NowPlayingBadgeText}" />
                                <TextBlock Name="SleepTimerText" Text="{Binding Player.SleepTimerRemainingText}" FontSize="12"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource NowPlayingBadgeText}" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <!-- Favourite and the rest live in the ⋯ menu (Apple's). -->
                    <Button Grid.Column="2" Name="NowPlayingMore" Classes="icon" Margin="8,0,-10,0" VerticalAlignment="Center"
                            Command="{Binding OpenNowPlayingMenuCommand}" AutomationProperties.Name="{loc:T Mobile.More}">
                        <PathIcon Data="{DynamicResource PhMore}" Width="26" Height="26" />
                    </Button>
                </Grid>

                <Grid Grid.Row="3" RowDefinitions="Auto,Auto" Margin="0,10,0,0">
                    <!-- Seeks on release only (the code-behind); the times follow the drag. -->
                    <views:CapsuleSlider Name="SeekBar" Height="30" Minimum="0" Maximum="{Binding Player.Duration.TotalSeconds}"
                                         Value="{Binding Player.Position.TotalSeconds, Mode=OneWay}"
                                         AutomationProperties.Name="{loc:T Mobile.PlaybackPosition}" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" Margin="0,-4,0,0">
                        <TextBlock Name="ElapsedText" Classes="np-time" Text="{Binding Player.ElapsedText}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <!-- The quality badge (owner 10-14): the playing file's class between the
                             times - Hi-Res Lossless, Lossless or the codec (AAC, MP3...), the
                             desktop's label, beside the desktop's waveform as on the PC (every
                             label, lossless or not) - on a quiet capsule of the
                             menus' hairline over a breath of white, the text a shade under full
                             white so it sits back from the times. A tap opens the quality card
                             (ShowQualityCard), which grows out of it. -->
                        <Button Grid.Column="1" Name="QualityBadge" Classes="row np-badge" Command="{Binding ShowQualityCardCommand}"
                                IsVisible="{Binding Player.HasQuality}" AutomationProperties.Name="{loc:T Mobile.AudioQuality}">
                            <Border Name="QualityPill" Classes="np-badge-pill">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Viewbox Name="QualityGlyph" Width="16" Height="11" Margin="0,1,0,0" VerticalAlignment="Center">
                                        <Path Data="{DynamicResource PhLossless}" Fill="{DynamicResource NowPlayingBadgeText}" />
                                    </Viewbox>
                                    <TextBlock Name="QualityBadgeText" Text="{Binding Player.Quality.Label}" FontSize="12"
                                               FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource NowPlayingBadgeText}" />
                                </StackPanel>
                            </Border>
                        </Button>
                        <TextBlock Grid.Column="2" Name="RemainingText" Classes="np-time" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Player.RemainingText}" />
                    </Grid>
                </Grid>

                <!-- Filled glyphs, no circle, Play/Pause a little larger than the skips: the desktop
                     player bar's 18 and 20, here 36 and 40 (owner 11-08: a little smaller; the Queue pill: 30 and 33).
                     Shuffle and Repeat at the row's ends (np-mode), as on the Queue pill too. -->
                <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto,*" Margin="0,14">
                    <Button Grid.Column="0" Name="ShuffleButton" Classes="icon np-mode" HorizontalAlignment="Left"
                            Classes.on="{Binding Player.IsShuffleEnabled}"
                            Command="{Binding Player.ToggleShuffleCommand}" AutomationProperties.Name="{loc:T Mobile.Shuffle}">
                        <Panel>
                            <Border Classes="np-mode-wash" />
                            <PathIcon Data="{DynamicResource PhShuffle}" />
                        </Panel>
                    </Button>
                    <Button Grid.Column="1" Name="PreviousButton" Classes="icon transport tx"
                            Command="{Binding Player.PreviousCommand}" AutomationProperties.Name="{loc:T Mobile.Previous}">
                        <controls:TransportGlyph Kind="Previous" Width="36" Height="36" />
                    </Button>
                    <Button Grid.Column="2" Name="PlayPauseButton" Classes="icon transport tx"
                            Command="{Binding Player.TogglePlayPauseCommand}" AutomationProperties.Name="{loc:T Mobile.PlayPause}">
                        <controls:TransportGlyph Kind="PlayPause" Width="40" Height="40" IsPlaying="{Binding Player.IsPlaying}" />
                    </Button>
                    <Button Grid.Column="3" Name="NextButton" Classes="icon transport tx"
                            Command="{Binding Player.NextCommand}" AutomationProperties.Name="{loc:T Mobile.Next}">
                        <controls:TransportGlyph Kind="Next" Width="36" Height="36" />
                    </Button>
                    <Button Grid.Column="4" Name="RepeatButton" Classes="icon np-mode" HorizontalAlignment="Right"
                            Classes.on="{Binding Player.IsRepeatOn}"
                            Command="{Binding Player.CycleRepeatCommand}" AutomationProperties.Name="{loc:T Mobile.Repeat}">
                        <Panel>
                            <Border Classes="np-mode-wash" />
                            <PathIcon Data="{DynamicResource PhRepeat}" IsVisible="{Binding !Player.IsRepeatOne}" />
                            <PathIcon Name="RepeatOneGlyph" Data="{DynamicResource PhRepeatOne}" IsVisible="{Binding Player.IsRepeatOne}" />
                        </Panel>
                    </Button>
                </Grid>

                <Grid Grid.Row="5" Name="VolumeRow" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding Player.HasVolumeControl}">
                    <PathIcon Data="{DynamicResource PhVolumeLow}" Width="18" Height="18" Opacity="0.6" />
                    <views:CapsuleSlider Grid.Column="1" Name="VolumeSlider" Height="30" Minimum="0" Maximum="1" Margin="10,0"
                                         Value="{Binding Player.VolumeLevel, Mode=TwoWay}" AutomationProperties.Name="{loc:T Mobile.Volume}" />
                    <PathIcon Grid.Column="2" Data="{DynamicResource PhVolumeHigh}" Width="18" Height="18" Opacity="0.6" />
                </Grid>

                <StackPanel Grid.Row="6">
                    <TextBlock Name="ErrorLine" Text="{Binding Player.ErrorText}" Foreground="#E74856" FontSize="12" TextWrapping="Wrap"
                               IsVisible="{Binding Player.ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Grid ColumnDefinitions="*,*,*" Margin="0,12,0,0">
                        <Button Grid.Column="0" Name="LyricsButton" Classes="icon bottom" HorizontalAlignment="Center"
                                Command="{Binding ToggleLyricsCommand}" AutomationProperties.Name="{loc:T Tab.Lyrics}">
                            <PathIcon Data="{DynamicResource PhLyrics}" />
                        </Button>
                        <Button Grid.Column="1" Name="OutputButton" Classes="icon bottom" HorizontalAlignment="Center"
                                Command="{Binding ShowOutputCommand}" AutomationProperties.Name="{loc:T Mobile.Output}">
                            <PathIcon Classes="speaker" Data="{DynamicResource PhVolumeHigh}" />
                        </Button>
                        <Button Grid.Column="2" Name="QueueButton" Classes="icon bottom" HorizontalAlignment="Center"
                                Command="{Binding ToggleQueueCommand}" AutomationProperties.Name="{loc:T Tab.Queue}">
                            <PathIcon Data="{DynamicResource PhQueue}" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Panel>
</UserControl>
