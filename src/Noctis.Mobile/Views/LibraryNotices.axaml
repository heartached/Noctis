<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:views="using:Noctis.Mobile.Views"
             x:Class="Noctis.Mobile.Views.LibraryNotices"
             x:DataType="vm:ShellViewModel">

    <!-- The library's notices at the top of the Home and Library tabs: the first-run folder
         card, the reconnect card, the scan's progress. The pages hide this control itself when
         there is none (Library.HasNotice): a visible empty one still took its page's Spacing,
         22 dp of blank above the first row. -->
    <StackPanel Name="NoticeCards" Margin="20,0" Spacing="14">
        <Border Name="ConnectCard" Classes="card" Padding="16" IsVisible="{Binding Library.ShowConnectCard}">
            <StackPanel Spacing="10">
                <TextBlock Classes="section" Text="{loc:T Mobile.Notice.AddMusicTitle}" />
                <TextBlock Classes="subtle" TextWrapping="Wrap"
                           Text="{loc:T Mobile.Notice.AddMusicText}" />
                <Button Classes="pill-accent" Content="{loc:T Mobile.Notice.ChooseFolder}" Command="{Binding Library.AddFolderCommand}" />
            </StackPanel>
        </Border>

        <Border Name="ReconnectCard" Classes="card" Padding="16" IsVisible="{Binding Library.NeedsReconnect}">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding Library.StatusText}" TextWrapping="Wrap" />
                <Button Classes="pill" Content="{loc:T Mobile.Notice.ReconnectFolder}" Command="{Binding Library.AddFolderCommand}" />
            </StackPanel>
        </Border>

        <!-- Indeterminate only while scanning, not merely hidden: a hidden indeterminate bar's
             endless animation is paused but stays on the global clock, which keeps Avalonia
             rendering a frame every 16 ms on an idle screen (one bar each on Home and Library). -->
        <StackPanel Spacing="4" IsVisible="{Binding Library.IsScanning}">
            <ProgressBar IsIndeterminate="{Binding Library.IsScanning}" />
            <TextBlock Classes="subtle" Text="{Binding Library.ScanProgress, Converter={x:Static views:LocFormat.Count}, ConverterParameter=Mobile.Notice.ScanningFiles}" />
        </StackPanel>
    </StackPanel>
</UserControl>
