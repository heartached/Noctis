<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:models="using:Noctis.Models"
             xmlns:controls="using:Noctis.Controls"
             xmlns:views="using:Noctis.Mobile.Views"
             x:Class="Noctis.Mobile.Views.ContextSheet"
             x:DataType="vm:ShellViewModel"
             IsVisible="False">

    <UserControl.Styles>
        <Style Selector="Button.sheet-action">
            <Setter Property="Height" Value="52" />
        </Style>
        <Style Selector="Button.sheet-action PathIcon">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.sheet-action TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- The text in the glass's own colours, as the menu's: the card can wear another theme than
             the app's (Now Playing's dark glass). -->
        <Style Selector="Border#SheetCard Button.sheet-action">
            <Setter Property="Foreground" Value="{DynamicResource MenuGlassText}" />
        </Style>
        <Style Selector="Border#SheetCard TextBlock.row-title, Border#SheetCard TextBlock.section">
            <Setter Property="Foreground" Value="{DynamicResource MenuGlassText}" />
        </Style>
        <Style Selector="Border#SheetCard TextBlock.row-sub">
            <Setter Property="Foreground" Value="{DynamicResource MenuGlassSecondaryText}" />
        </Style>
        <!-- The new playlist's name: a pill of the glass's own fill with the glass's text, as the
             search field on a page (Fluent's TextBox was a grey box: #BFBFBF on the light glass,
             near-black on the dark, its placeholder 2-2.6:1). No border or accent ring, at rest or
             focused. -->
        <Style Selector="TextBox.glass-field">
            <Setter Property="Background" Value="{DynamicResource MenuGlassFieldFill}" />
            <Setter Property="Foreground" Value="{DynamicResource MenuGlassText}" />
            <Setter Property="CaretBrush" Value="{DynamicResource MenuGlassText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.glass-field:pointerover /template/ Border#PART_BorderElement, TextBox.glass-field:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource MenuGlassFieldFill}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.glass-field:pointerover, TextBox.glass-field:focus">
            <Setter Property="Foreground" Value="{DynamicResource MenuGlassText}" />
        </Style>
        <Style Selector="TextBox.glass-field /template/ TextBlock#PART_Placeholder, TextBox.glass-field /template/ TextBlock#PART_FloatingPlaceholder, TextBox.glass-field:focus /template/ TextBlock#PART_Placeholder, TextBox.glass-field:pointerover /template/ TextBlock#PART_Placeholder">
            <Setter Property="Foreground" Value="{DynamicResource MenuGlassSecondaryText}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- A tap on the dim area above the card dismisses it, as on every Android bottom sheet. -->
        <Border Name="Scrim" Background="#99000000" PointerPressed="OnScrimPressed" />

        <!-- The menu's glass (MenuGlass), floating above the gesture bar with the menu's pop
             (PopMenu.PopFrom/PopIn/PopOut), rising out of the bottom edge. It stays a bottom sheet
             rather than a page of the menu: the list can be long and its "New playlist" box brings
             up the keyboard, which the card rides above (OnInputPaneChanged). It wears the theme
             of the menu it came from. -->
        <Border Name="SheetCard" VerticalAlignment="Bottom" MaxHeight="640" Padding="{Binding BottomSafePadding}">
            <ThemeVariantScope Name="SheetScope">
                <Panel Name="SheetPop" Margin="8,0,8,8">
                    <views:MenuGlass Name="SheetGlass">
                        <ScrollViewer Name="SheetBody" HorizontalScrollBarVisibility="Disabled">
                            <ContentControl Name="SheetContent" Margin="20,16,20,16">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ContextSheetViewModel">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                                                <Border Classes="art" Classes.artist="{Binding IsArtist}" Width="52" Height="52">
                                                    <Panel>
                                                        <PathIcon Data="{DynamicResource SongsIcon}" Width="20" Height="20" Opacity="0.5" />
                                                        <controls:CachedImage SourcePath="{Binding ArtworkPath}" DecodeWidth="128" Stretch="UniformToFill" />
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Classes="row-title" FontSize="16" Text="{Binding Title}" />
                                                    <TextBlock Classes="row-sub" Text="{Binding Subtitle}" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Name="PlaylistPicker" Spacing="6" IsVisible="{Binding IsPickingPlaylist}">
                                                <TextBlock Classes="section" FontSize="16" Text="{loc:T Mobile.AddToPlaylist}" />
                                                <ItemsControl ItemsSource="{Binding Playlists}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:Playlist">
                                                            <Button Classes="row sheet-action"
                                                                    Command="{Binding $parent[ItemsControl].((vm:ContextSheetViewModel)DataContext).AddToPlaylistCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <Grid ColumnDefinitions="40,*"><PathIcon Data="{DynamicResource PhPlaylist}" /><TextBlock Grid.Column="1" Text="{Binding Name}" /></Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBox Name="NewPlaylistBox" Classes="glass-field" Text="{Binding NewPlaylistName}" PlaceholderText="{loc:T Mobile.NewPlaylist}" />
                                                    <Button Grid.Column="1" Classes="pill-accent" Margin="8,0,0,0" Content="{loc:T Common.Create}"
                                                            Command="{Binding CreatePlaylistCommand}" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </ScrollViewer>
                    </views:MenuGlass>
                </Panel>
            </ThemeVariantScope>
        </Border>
    </Grid>
</UserControl>
