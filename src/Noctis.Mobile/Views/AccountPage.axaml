<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:controls="using:Noctis.Controls"
             xmlns:views="using:Noctis.Mobile.Views"
             x:Class="Noctis.Mobile.Views.AccountPage"
             x:DataType="vm:AccountPageViewModel">

    <!-- Apple Music's account sheet, in Settings' calm: a plain title and the round close, a
         hairline under them once the page scrolls. Signed out: a hero (the desktop's phone
         glyph, one line of why), the three steps on the computer, the address / name /
         password card with each field's error under it, and the accent Sign In that shows its
         progress. Signed in: the profile card (the account; under it the computer, its last
         sync and the accent Sync now), Download everything with its status, the Downloaded
         row, then three action tiles (Send to computer, Remove downloads, Sign out). Shared
         look: GroupedStyles.axaml. -->

    <UserControl.Resources>
        <!-- Destructive actions: the red of the glass prompt's destructive pill (PromptSheet). -->
        <SolidColorBrush x:Key="AccountDangerBrush" Color="#E5484D" />
        <!-- Sign out: a door bracket with an arrow leaving it, drawn on the 24-grid like
             PhoneIcons.axaml (the corner anchors keep its box). The desktop has no sign-out glyph. -->
        <StreamGeometry x:Key="AccountSignOutIcon">M0 0ZM24 24ZM10 3.1L6 3.1Q3.1 3.1 3.1 6L3.1 18Q3.1 20.9 6 20.9L10 20.9Q10.9 20.9 10.9 20Q10.9 19.1 10 19.1L6 19.1Q4.9 19.1 4.9 18L4.9 6Q4.9 4.9 6 4.9L10 4.9Q10.9 4.9 10.9 4Q10.9 3.1 10 3.1ZM9 11.1L18.03 11.1L15.36 8.43Q15.1 8.17 15.1 7.8Q15.1 7.43 15.36 7.16Q15.63 6.9 16 6.9Q16.37 6.9 16.64 7.16L20.84 11.36Q21.1 11.63 21.1 12Q21.1 12.37 20.84 12.64L16.64 16.84Q16.37 17.1 16 17.1Q15.63 17.1 15.36 16.84Q15.1 16.57 15.1 16.2Q15.1 15.83 15.36 15.57L18.03 12.9L9 12.9Q8.1 12.9 8.1 12Q8.1 11.1 9 11.1Z</StreamGeometry>
        <!-- Send phone songs to computer: PhDownload's ring with its arrow turned up (mirrored
             about the middle), so the two directions read as a pair. -->
        <StreamGeometry x:Key="AccountSendIcon">M0 0ZM24 24ZM19.07 19.07Q16.14 22 12 22Q7.86 22 4.93 19.07Q2 16.14 2 12Q2 7.86 4.93 4.93Q7.86 2 12 2Q16.14 2 19.07 4.93Q22 7.86 22 12Q22 16.14 19.07 19.07ZM17.8 6.2Q15.4 3.8 12 3.8Q8.6 3.8 6.2 6.2Q3.8 8.6 3.8 12Q3.8 15.4 6.2 17.8Q8.6 20.2 12 20.2Q15.4 20.2 17.8 17.8Q20.2 15.4 20.2 12Q20.2 8.6 17.8 6.2ZM9.88 10.99L11.1 9.77L11.1 16.7Q11.1 17.07 11.36 17.34Q11.63 17.6 12 17.6Q12.37 17.6 12.64 17.34Q12.9 17.07 12.9 16.7L12.9 9.77L14.12 10.99Q14.38 11.26 14.76 11.26Q15.13 11.26 15.39 10.99Q15.66 10.73 15.66 10.36Q15.66 9.98 15.39 9.72L12.64 6.96Q12.37 6.7 12 6.7Q11.63 6.7 11.36 6.96L8.61 9.72Q8.34 9.98 8.34 10.36Q8.34 10.73 8.61 10.99Q8.87 11.26 9.24 11.26Q9.62 11.26 9.88 10.99Z</StreamGeometry>
        <!-- The desktop's account card glyphs (SettingsView.axaml), the same keys and shapes:
             the phone of its Connect a phone button, the eye on its passwords. -->
        <StreamGeometry x:Key="AccountPhoneIcon">M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z</StreamGeometry>
        <!-- Scan QR Code: Material's qr_code_scanner (Apache-2.0), on the same 24-grid. -->
        <StreamGeometry x:Key="AccountQrIcon">M9.5 6.5v3h-3v-3h3M11 5H5v6h6V5zm-1.5 9.5v3h-3v-3h3M11 13H5v6h6v-6zm6.5-6.5v3h-3v-3h3M19 5h-6v6h6V5zm-6 8h1.5v1.5H13V13zm1.5 1.5H16V16h-1.5v-1.5zM16 13h1.5v1.5H16V13zm-3 3h1.5v1.5H13V16zm1.5 1.5H16V19h-1.5v-1.5zM16 16h1.5v1.5H16V16zm1.5-1.5H19V16h-1.5v-1.5zm0 3H19V19h-1.5v-1.5zM22 7h-2V4h-3V2h5v5zm0 15v-5h-2v3h-3v2h5zM2 22h5v-2H4v-3H2v5zM2 2v5h2V4h3V2H2z</StreamGeometry>
        <StreamGeometry x:Key="AccountEyeIcon">M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z</StreamGeometry>
        <StreamGeometry x:Key="AccountEyeOffIcon">M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://Noctis.Mobile/Views/GroupedStyles.axaml" />

        <!-- Header as Settings': no glyph, the title near the cards' edge; the hairline under it
             shows once content scrolls beneath (AccountPage.axaml.cs). -->
        <Style Selector="Grid.account-header TextBlock.sheet-title">
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style Selector="Border.header-hairline">
            <Setter Property="Height" Value="0.5" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Background" Value="{DynamicResource PhoneSeparatorBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Hero: the desktop's phone glyph on a card-coloured disc, a one-line title, why. -->
        <Style Selector="Border.hero-disc">
            <Setter Property="Width" Value="84" />
            <Setter Property="Height" Value="84" />
            <Setter Property="CornerRadius" Value="42" />
            <Setter Property="Background" Value="{DynamicResource PhoneCardBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.hero-disc views|GridIcon">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextExactBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.hero-title">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="8,16,8,0" />
        </Style>
        <Style Selector="TextBlock.hero-text">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource PhoneSecondaryTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="24,6,24,0" />
        </Style>
        <!-- A small grey caption over a card ("How to connect"), as on Settings' pushed pages. -->
        <Style Selector="TextBlock.group-caption">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource PhoneSecondaryTextBrush}" />
            <Setter Property="Margin" Value="16,0,16,7" />
        </Style>

        <!-- The steps on the computer: a numbered accent disc, the step as the row's text. -->
        <Style Selector="Grid.step-row">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Margin" Value="16,0" />
        </Style>
        <Style Selector="Border.step-number">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.step-number TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.step-row TextBlock.row-label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="14,10,0,10" />
        </Style>
        <!-- Under the steps, the hairline starts at the text (16 + 26 + 14). -->
        <Style Selector="Border.row-separator.step">
            <Setter Property="Margin" Value="56,0,16,0" />
        </Style>

        <!-- Sign-in fields: one per row of the card, a small grey label over a borderless field,
             iOS-style, the field's error in red under it. Fluent's TextBox paints a box and a
             focus underline in every state. -->
        <Style Selector="StackPanel.field-row">
            <Setter Property="Margin" Value="16,9,8,7" />
            <Setter Property="Spacing" Value="1" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource PhoneSecondaryTextBrush}" />
        </Style>
        <Style Selector="TextBlock.field-error">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource AccountDangerBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,8,4" />
        </Style>
        <Style Selector="TextBox.inline-field">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.inline-field /template/ Border#PART_BorderElement, TextBox.inline-field:pointerover /template/ Border#PART_BorderElement, TextBox.inline-field:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.inline-field:focus">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="Border.field-separator">
            <Setter Property="Height" Value="0.5" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource PhoneSeparatorBrush}" />
        </Style>
        <!-- The eye sits inside the field's own height: a 44 dp target that keeps the password
             row as tall as the other two (it stood 10 dp taller). -->
        <Style Selector="ToggleButton.reveal">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.reveal:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.reveal:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.reveal:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.reveal views|GridIcon">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="{DynamicResource PhoneSecondaryTextBrush}" />
        </Style>

        <!-- The one primary action (Sign In, Trust and Sign In): a filled accent capsule. While
             it works it keeps its colour and shows the spinner and what it is doing. -->
        <Style Selector="Button.primary-action">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="26" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15">
                        <DoubleTransition.Easing><CubicEaseOut /></DoubleTransition.Easing>
                    </DoubleTransition>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16">
                        <TransformOperationsTransition.Easing><CubicEaseOut /></TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.primary-action:pressed">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <Style Selector="Button.primary-action:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Button.primary-action.busy:disabled">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.primary-action /template/ ContentPresenter#PART_ContentPresenter, Button.primary-action:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary-action:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.primary-action:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        </Style>
        <Style Selector="Button.primary-action views|GridIcon">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        </Style>
        <Style Selector="Button.primary-action TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- The desktop's rotating-arc spinner (LyricShareDialog's loading-spinner), on the accent.
             Animated only while shown: an ungated INFINITE clock keeps ticking hidden. -->
        <Style Selector="Ellipse.spinner">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stroke" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="StrokeThickness" Value="2.2" />
            <Setter Property="StrokeDashArray" Value="16,7" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Ellipse.spinner[IsVisible=True]">
            <Style.Animations>
                <Animation Duration="0:0:0.85" IterationCount="INFINITE" Easing="LinearEasing">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- A plain text button under the primary one (Cancel). -->
        <Style Selector="Button.text-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Padding" Value="20,0" />
        </Style>
        <Style Selector="Button.text-action:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.text-action:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.text-action:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.text-action:pressed">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Button.text-action TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>

        <!-- The security code to compare, large enough to read off line by line. -->
        <Style Selector="SelectableTextBlock.fingerprint">
            <Setter Property="FontFamily" Value="monospace, Consolas, Courier New" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="16,16" />
        </Style>

        <!-- The profile card's computer row: the small badge sits under the large avatar's centre,
             the text lines up with the name above (16 + 56 + 14). -->
        <Style Selector="Border.computer-badge">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Margin" Value="11,0,25,0" />
            <Setter Property="Background" Value="{DynamicResource PhoneFillBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.computer-badge views|GridIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.row-action">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <!-- A running sync or download: its row stays readable (a disabled row greys to 0.45, which
             left the stage text and the bar faint), its action greys, a thin accent bar under it. -->
        <Style Selector="Button.row.working:disabled">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.row.working:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="Button.accent-card.working TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PhoneSecondaryTextBrush}" />
        </Style>
        <Style Selector="ProgressBar.thin">
            <Setter Property="Height" Value="3" />
            <Setter Property="MinHeight" Value="3" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextExactBrush}" />
            <Setter Property="Background" Value="{DynamicResource PhoneFillBrush}" />
        </Style>

        <!-- A greyed tile (Remove downloads with nothing downloaded) keeps its card's colour:
             Fluent filled the disabled presenter grey. -->
        <Style Selector="Button.action-tile:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
        </Style>
        <!-- Leaving and removing: the tiles in red (their questions ask on the glass prompt, PromptSheet). -->
        <Style Selector="Button.action-tile.danger views|GridIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccountDangerBrush}" />
        </Style>
        <Style Selector="Button.action-tile.danger TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccountDangerBrush}" />
        </Style>
    </UserControl.Styles>

    <Panel Classes="grouped-root">
        <Border Name="PageBackdrop" Classes="grouped-backdrop" />
        <Grid RowDefinitions="Auto,*">
            <Panel Grid.Row="0">
                <Grid Classes="sheet-header account-header" ColumnDefinitions="*,Auto">
                    <TextBlock Name="AccountTitle" Classes="sheet-title" Text="{Binding Title}" />
                    <Button Grid.Column="1" Name="CloseButton" Classes="sheet-close" AutomationProperties.Name="{loc:T Mobile.BackToSettings}"
                            Command="{Binding Shell.NavigateBackCommand}">
                        <views:GridIcon Data="{DynamicResource PhClose}" />
                    </Button>
                </Grid>
                <Border Name="HeaderHairline" Classes="header-hairline" Opacity="0" />
            </Panel>

            <ScrollViewer Name="PageScroll" Classes="page-scroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Name="PageContent" Classes="grouped-content">

                    <!-- Signed out: why, then the two ways in, each as short numbered steps. First
                         Scan QR Code (the computer's Connect a phone shows the code; no typing, no
                         code to compare: the QR carries the pin), then Enter manually: the
                         address, email and password. The address stays a field: the computer is
                         not discoverable on the network. -->
                    <StackPanel Name="SignInForm" Spacing="28" IsVisible="{Binding IsFormVisible}">
                        <StackPanel Name="SignInHero" Margin="0,4,0,0">
                            <Border Classes="hero-disc">
                                <views:GridIcon Data="{StaticResource AccountPhoneIcon}" />
                            </Border>
                            <TextBlock Classes="hero-title" Text="{loc:T Mobile.Account.SignInTitle}" />
                            <TextBlock Classes="hero-text" Text="{loc:T Mobile.Account.SignInSubtitle}" />
                        </StackPanel>

                        <StackPanel Name="ScanQrSection" IsVisible="{Binding CanScanQr}">
                            <TextBlock Classes="group-caption" Text="{loc:T Mobile.Account.ScanQrHeader}" />
                            <Border Classes="group-card">
                                <StackPanel>
                                    <Grid Classes="step-row" ColumnDefinitions="Auto,*">
                                        <Border Classes="step-number"><TextBlock Text="1" /></Border>
                                        <TextBlock Grid.Column="1" Classes="row-label" Text="{loc:T Mobile.Account.QrStep1}" />
                                    </Grid>
                                    <Border Classes="row-separator step" />
                                    <Grid Classes="step-row" ColumnDefinitions="Auto,*">
                                        <Border Classes="step-number"><TextBlock Text="2" /></Border>
                                        <TextBlock Grid.Column="1" Classes="row-label" Text="{loc:T Mobile.Account.QrStep2}" />
                                    </Grid>
                                    <Border Classes="row-separator step" />
                                    <Grid Classes="step-row" ColumnDefinitions="Auto,*">
                                        <Border Classes="step-number"><TextBlock Text="3" /></Border>
                                        <TextBlock Grid.Column="1" Classes="row-label" Text="{loc:T Mobile.Account.QrStep3}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Button Name="ScanQrButton" Classes="primary-action" Classes.busy="{Binding IsSigningInByQr}" Margin="0,22,0,0"
                                    Command="{Binding ScanQrCodeCommand}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{loc:T Mobile.Account.ScanQrButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Classes="spinner" IsVisible="{Binding IsSigningInByQr}">
                                        <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <views:GridIcon Data="{StaticResource AccountQrIcon}" IsVisible="{Binding !IsSigningInByQr}" />
                                    <TextBlock Text="{loc:T Mobile.Account.ScanQrButton}" IsVisible="{Binding !IsSigningInByQr}" />
                                    <TextBlock Text="{Binding StatusText}" IsVisible="{Binding IsSigningInByQr}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Name="HowToConnect">
                            <TextBlock Classes="group-caption" Text="{loc:T Mobile.Account.ManualHeader}" />
                            <Border Classes="group-card">
                                <StackPanel>
                                    <Grid Classes="step-row" ColumnDefinitions="Auto,*">
                                        <Border Classes="step-number"><TextBlock Text="1" /></Border>
                                        <TextBlock Grid.Column="1" Classes="row-label" Text="{loc:T Mobile.Account.ManualStep1}" />
                                    </Grid>
                                    <Border Classes="row-separator step" />
                                    <Grid Classes="step-row" ColumnDefinitions="Auto,*">
                                        <Border Classes="step-number"><TextBlock Text="2" /></Border>
                                        <TextBlock Grid.Column="1" Classes="row-label" Text="{loc:T Mobile.Account.ManualStep2}" />
                                    </Grid>
                                    <Border Classes="row-separator step" />
                                    <Grid Classes="step-row" ColumnDefinitions="Auto,*">
                                        <Border Classes="step-number"><TextBlock Text="3" /></Border>
                                        <TextBlock Grid.Column="1" Classes="row-label" Text="{loc:T Mobile.Account.ManualStep3}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel>
                            <Border Classes="group-card">
                                <StackPanel>
                                    <StackPanel Classes="field-row">
                                        <TextBlock Classes="field-label" Text="{loc:T Mobile.Account.ServerAddress}" />
                                        <TextBox Name="ServerAddressBox" Classes="inline-field" Text="{Binding ServerAddress}"
                                                 PlaceholderText="192.168.1.20" AutomationProperties.Name="{loc:T Mobile.Account.ServerAddress}"
                                                 TextInputOptions.ContentType="Url" TextInputOptions.AutoCapitalization="False"
                                                 TextInputOptions.ShowSuggestions="False" TextInputOptions.ReturnKeyType="Next" />
                                        <TextBlock Name="AddressErrorLabel" Classes="field-error" Text="{Binding ErrorText}"
                                                   IsVisible="{Binding HasAddressError}" />
                                    </StackPanel>
                                    <Border Classes="field-separator" />
                                    <StackPanel Classes="field-row">
                                        <TextBlock Classes="field-label" Text="{loc:T Mobile.Account.EmailOrUsername}" />
                                        <TextBox Name="UserNameBox" Classes="inline-field" Text="{Binding UserName}"
                                                 PlaceholderText="you@example.com" AutomationProperties.Name="{loc:T Mobile.Account.EmailOrUsername}"
                                                 TextInputOptions.ContentType="Email" TextInputOptions.ReturnKeyType="Next"
                                                 TextInputOptions.AutoCapitalization="False" TextInputOptions.ShowSuggestions="False" />
                                    </StackPanel>
                                    <Border Classes="field-separator" />
                                    <StackPanel Classes="field-row" Margin="16,9,4,7">
                                        <TextBlock Classes="field-label" Text="{loc:T Mobile.Account.Password}" />
                                        <!-- Sensitive: keyboards neither learn it nor show it in suggestions. -->
                                        <TextBox Name="PasswordBox" Classes="inline-field" Text="{Binding Password}" PasswordChar="•"
                                                 AutomationProperties.Name="{loc:T Mobile.Account.Password}" PlaceholderText="{loc:T Mobile.Account.Required}"
                                                 RevealPassword="{Binding #RevealPasswordToggle.IsChecked}"
                                                 TextInputOptions.ContentType="Password" TextInputOptions.IsSensitive="True"
                                                 TextInputOptions.ReturnKeyType="Go">
                                            <TextBox.InnerRightContent>
                                                <ToggleButton Name="RevealPasswordToggle" Classes="reveal" AutomationProperties.Name="{loc:T Mobile.Account.ShowPassword}">
                                                    <Panel>
                                                        <views:GridIcon Data="{StaticResource AccountEyeIcon}" IsVisible="{Binding !#RevealPasswordToggle.IsChecked}" />
                                                        <views:GridIcon Data="{StaticResource AccountEyeOffIcon}" IsVisible="{Binding #RevealPasswordToggle.IsChecked}" />
                                                    </Panel>
                                                </ToggleButton>
                                            </TextBox.InnerRightContent>
                                        </TextBox>
                                        <TextBlock Name="CredentialsErrorLabel" Classes="field-error" Text="{Binding ErrorText}"
                                                   IsVisible="{Binding HasCredentialsError}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button Name="SignInButton" Classes="primary-action" Classes.busy="{Binding IsFormBusy}" Margin="0,22,0,0"
                                    Command="{Binding SignInCommand}" IsEnabled="{Binding CanSignIn}" AutomationProperties.Name="{loc:T Mobile.Account.SignIn}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Classes="spinner" IsVisible="{Binding IsFormBusy}">
                                        <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock Name="SignInLabel" Text="{loc:T Mobile.Account.SignIn}" IsVisible="{Binding !IsFormBusy}" />
                                    <TextBlock Name="SignInStatus" Text="{Binding StatusText}" IsVisible="{Binding IsFormBusy}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Trust on first use: the user compares the code with the computer's before
                         the password is sent. -->
                    <StackPanel Name="FingerprintCard" IsVisible="{Binding IsConfirmingFingerprint}">
                        <StackPanel Margin="0,4,0,0">
                            <Border Classes="hero-disc">
                                <views:GridIcon Data="{StaticResource AccountPhoneIcon}" />
                            </Border>
                            <TextBlock Classes="hero-title" Text="{loc:T Mobile.Account.CheckCodeTitle}" />
                            <TextBlock Classes="hero-text"
                                       Text="{loc:T Mobile.Account.CheckCodeText}" />
                        </StackPanel>
                        <Border Classes="group-card" Margin="0,24,0,0">
                            <SelectableTextBlock Name="FingerprintText" Classes="fingerprint" Text="{Binding FingerprintDisplay}" />
                        </Border>
                        <Button Name="TrustButton" Classes="primary-action" Classes.busy="{Binding IsBusy}" Margin="0,22,0,0"
                                Command="{Binding TrustAndSignInCommand}" IsEnabled="{Binding IsIdle}"
                                AutomationProperties.Name="{loc:T Mobile.Account.TrustAndSignIn}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Classes="spinner" IsVisible="{Binding IsBusy}">
                                    <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                                </Ellipse>
                                <TextBlock Text="{loc:T Mobile.Account.TrustAndSignIn}" IsVisible="{Binding IsIdle}" />
                                <TextBlock Text="{Binding StatusText}" IsVisible="{Binding IsBusy}" />
                            </StackPanel>
                        </Button>
                        <Button Name="CancelFingerprintButton" Classes="text-action" Margin="0,6,0,0"
                                Command="{Binding CancelFingerprintCommand}" IsEnabled="{Binding IsIdle}">
                            <TextBlock Text="{loc:T Mobile.Cancel}" />
                        </Button>
                    </StackPanel>

                    <TextBlock Name="StatusLabel" Classes="group-footnote" Margin="16,0" Text="{Binding StatusText}"
                               IsVisible="{Binding ShowStatusLine}" />
                    <TextBlock Name="ErrorLabel" Classes="group-footnote" Margin="16,0" Foreground="{DynamicResource AccountDangerBrush}"
                               Text="{Binding ErrorText}" IsVisible="{Binding HasGeneralError}" />

                    <!-- Signed in. -->
                    <StackPanel Name="SignedInPanel" Spacing="28" IsVisible="{Binding IsSignedIn}">

                        <!-- Who: the desktop's profile picture (else initials on the accent), its profile
                             name (else the email), the email under it; then the computer, the last
                             sync (or the running one, with its bar) and the accent Sync now. -->
                        <Border Name="AccountHeader" Classes="group-card">
                            <StackPanel>
                                <Grid ColumnDefinitions="Auto,*" MinHeight="84" Margin="16,12">
                                    <Border Name="AvatarCircle" Classes="avatar large">
                                        <Panel>
                                            <TextBlock Name="AvatarInitials" Classes="initials" Text="{Binding Initials}" IsVisible="{Binding ShowInitials}" />
                                            <views:GridIcon Name="AvatarGlyph" Data="{DynamicResource PhPerson}" IsVisible="{Binding ShowPersonGlyph}" />
                                            <controls:CachedImage Name="AvatarImage" SourcePath="{Binding AvatarPath}" IsVisible="{Binding HasAvatar}"
                                                                  DecodeWidth="224" Stretch="UniformToFill" />
                                        </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Name="AccountNameLabel" Classes="profile-name" Text="{Binding DisplayName}" />
                                        <TextBlock Name="EmailLabel" Classes="profile-sub" Text="{Binding EmailText}"
                                                   IsVisible="{Binding HasEmailText}" />
                                    </StackPanel>
                                </Grid>
                                <Border Classes="row-separator" Margin="86,0,16,0" />
                                <Button Name="SyncNowButton" Classes="row" Classes.working="{Binding IsSyncing}" Command="{Binding SyncNowCommand}"
                                        IsEnabled="{Binding CanSync}" AutomationProperties.Name="{loc:T Mobile.Account.SyncNow}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="64" Margin="16,0">
                                        <!-- The desktop's Account & Sync glyph: this row is the sync with it. -->
                                        <Border Classes="computer-badge">
                                            <views:GridIcon Data="{DynamicResource SyncIcon}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,10">
                                            <TextBlock Name="AccountLabel" Classes="row-label" Text="{Binding ComputerName}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Name="SyncLabel" Classes="row-sub" Text="{Binding SyncText}"
                                                       IsVisible="{Binding SyncText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <TextBlock Name="LastSyncLabel" Classes="row-sub" Text="{Binding LastSyncText}"
                                                       IsVisible="{Binding SyncText, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                            <!-- Indeterminate only while shown: hidden, its endless animation
                                                 still keeps Avalonia drawing every 16 ms (LibraryNotices). -->
                                            <ProgressBar Name="SyncProgress" Classes="thin" Margin="0,7,0,1" Value="{Binding SyncFraction}"
                                                         IsVisible="{Binding IsSyncing}">
                                                <ProgressBar.IsIndeterminate>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="IsSyncing" />
                                                        <Binding Path="!IsSyncCounted" />
                                                    </MultiBinding>
                                                </ProgressBar.IsIndeterminate>
                                            </ProgressBar>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Classes="row-action" Text="{loc:T Mobile.Account.SyncNow}" IsVisible="{Binding ShowSyncAction}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- The desktop's library on this phone: everything for offline, its status under it. -->
                        <StackPanel IsVisible="{Binding CanUseServer}">
                            <Border Classes="group-card">
                                <StackPanel>
                                    <Button Name="DownloadAllButton" Classes="row accent-card" Classes.working="{Binding IsDownloading}" Command="{Binding DownloadAllCommand}"
                                            IsEnabled="{Binding CanDownload}" AutomationProperties.Name="{loc:T Mobile.Account.DownloadEverything}">
                                        <TextBlock Text="{loc:T Mobile.Account.DownloadEverything}" />
                                    </Button>
                                    <ProgressBar Name="DownloadProgress" Classes="thin" Margin="16,0,16,14" Value="{Binding DownloadFraction}"
                                                 IsVisible="{Binding IsDownloading}">
                                        <ProgressBar.IsIndeterminate>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="IsDownloading" />
                                                <Binding Path="!IsDownloadCounted" />
                                            </MultiBinding>
                                        </ProgressBar.IsIndeterminate>
                                    </ProgressBar>
                                </StackPanel>
                            </Border>
                            <TextBlock Name="DownloadLabel" Classes="group-footnote" Text="{Binding DownloadText}"
                                       IsVisible="{Binding DownloadText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Classes="group-footnote" Text="{loc:T Mobile.Account.DownloadEverythingHint}"
                                       IsVisible="{Binding DownloadText, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                        </StackPanel>

                        <!-- Not a button: nothing to open, the row only reports. -->
                        <Border Classes="group-card">
                            <Grid Name="StorageRow" Classes="setting-row" ColumnDefinitions="Auto,*,Auto"
                                  AutomationProperties.Name="{Binding StorageText}">
                                <views:GridIcon Classes="row-icon" Data="{DynamicResource PhDownload}" />
                                <TextBlock Grid.Column="1" Classes="row-label" Text="{loc:T Mobile.Downloaded}" />
                                <TextBlock Grid.Column="2" Name="StorageLabel" Classes="row-value" Text="{Binding StorageValue}" />
                            </Grid>
                        </Border>

                        <!-- The three actions: the phone's own songs to the computer (tapped again while
                             sending, stops), removing the downloads, signing out. Both of the last ask first. -->
                        <StackPanel>
                            <Grid ColumnDefinitions="*,12,*,12,*">
                                <Button Name="SendSongsButton" Classes="action-tile" Command="{Binding SendSongsCommand}"
                                        IsEnabled="{Binding CanUpload}" AutomationProperties.Name="{Binding UploadLabel}">
                                    <StackPanel>
                                        <views:GridIcon Data="{StaticResource AccountSendIcon}" />
                                        <TextBlock Name="SendSongsLabel" Text="{Binding UploadTileLabel}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Name="RemoveDownloadsButton" Classes="action-tile danger"
                                        Command="{Binding AskRemoveDownloadsCommand}"
                                        IsEnabled="{Binding CanRemoveDownloads}" AutomationProperties.Name="{loc:T Mobile.Account.RemoveAllDownloads}">
                                    <StackPanel>
                                        <views:GridIcon Data="{DynamicResource PhTrash}" />
                                        <TextBlock Text="{loc:T Mobile.Account.RemoveDownloads}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="4" Name="SignOutButton" Classes="action-tile danger" Command="{Binding AskSignOutCommand}"
                                        IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{loc:T Mobile.Account.SignOut}">
                                    <StackPanel>
                                        <views:GridIcon Data="{StaticResource AccountSignOutIcon}" />
                                        <TextBlock Text="{loc:T Mobile.Account.SignOut}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Name="UploadLabel" Classes="group-footnote" Text="{Binding UploadText}"
                                       IsVisible="{Binding UploadText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Panel>
</UserControl>
