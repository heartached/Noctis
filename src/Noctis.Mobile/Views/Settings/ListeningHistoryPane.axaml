<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:controls="using:Noctis.Controls"
             xmlns:views="using:Noctis.Mobile.Views"
             x:Class="Noctis.Mobile.Views.ListeningHistoryPane"
             x:DataType="vm:ListeningHistoryViewModel">

    <!-- Listening History, the content of a page pushed inside the Settings sheet (the sheet draws
         the header and Back): this week's time and plays over seven day bars (today in the accent),
         the last three songs with Show All, then Keep History, Share with Computer and Clear.
         Everything is the phone's own play log. Shared look: GroupedStyles.axaml. -->

    <UserControl.Styles>
        <Style Selector="Border.row-separator.plain">
            <Setter Property="Margin" Value="16,0" />
        </Style>
        <Style Selector="TextBlock.group-caption">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource PhoneSecondaryTextBrush}" />
            <Setter Property="Margin" Value="16,0,16,7" />
        </Style>
        <Style Selector="TextBlock.week-total">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Border.day-bar">
            <Setter Property="Background" Value="{DynamicResource PhoneSeparatorBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="5,0" />
        </Style>
        <Style Selector="Border.day-bar.today">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}" />
        </Style>
        <Style Selector="TextBlock.day-label">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource PhoneSecondaryTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="TextBlock.day-label.today">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="Border.history-art">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="{DynamicResource PhoneSeparatorBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Classes="grouped-content">
        <!-- This Week: the time and plays, then one bar per day. -->
        <Border Name="WeekCard" Classes="group-card">
            <StackPanel Margin="16,14,16,16">
                <!-- Left, as the total under it: the sheet caps a row-value's width (220), which
                     centred a stretched caption in the wide card. -->
                <TextBlock Name="WeekCaption" Classes="row-value" Margin="0" HorizontalAlignment="Left" FontWeight="SemiBold" Text="{loc:T Mobile.History.ThisWeek}" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <TextBlock Name="WeekTotalLabel" Classes="week-total" Text="{Binding WeekTotal}" />
                    <TextBlock Name="WeekPlaysLabel" Classes="row-value" Margin="0,0,0,5" VerticalAlignment="Bottom"
                               FontWeight="SemiBold" Text="{Binding WeekPlays}" />
                </StackPanel>
                <ItemsControl Name="DayBars" Margin="0,14,0,0" ItemsSource="{Binding Bars}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryBar">
                            <StackPanel VerticalAlignment="Bottom" AutomationProperties.Name="{Binding Name}">
                                <Border Classes="day-bar" Classes.today="{Binding IsToday}" Height="{Binding Height}" />
                                <TextBlock Classes="day-label" Classes.today="{Binding IsToday}" Text="{Binding Label}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Recently Played: the last three songs, then Show All. -->
        <StackPanel Name="RecentSection">
            <TextBlock Classes="group-caption" FontWeight="SemiBold" Text="{loc:T Mobile.RecentlyPlayed}" />
            <Border Name="RecentCard" Classes="group-card">
                <StackPanel>
                    <ItemsControl Name="RecentList" ItemsSource="{Binding Recent}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryRow">
                                <StackPanel>
                                    <Grid ColumnDefinitions="Auto,*,Auto" Height="60" Margin="12,0,16,0">
                                        <Border Classes="history-art" Width="44" Height="44">
                                            <controls:CachedImage SourcePath="{Binding Track.AlbumArtworkPath}" DecodeWidth="128" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Classes="row-title" Text="{Binding Track.Title}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="row-sub" Margin="0" Text="{Binding Track.Artist}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Classes="row-value" FontSize="15" Text="{Binding When}" />
                                    </Grid>
                                    <Border Classes="row-separator plain" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Name="NoRecentRow" Classes="setting-row" IsVisible="{Binding !HasRecent}">
                        <TextBlock Classes="row-label" Foreground="{DynamicResource PhoneSecondaryTextBrush}" Text="{loc:T Mobile.History.NothingPlayed}" />
                    </Grid>
                    <Button Name="ShowAllButton" Classes="row accent-row" Command="{Binding ShowAllCommand}"
                            IsVisible="{Binding HasRecent}" AutomationProperties.Name="{loc:T Mobile.ShowAll}">
                        <Grid Classes="setting-row" ColumnDefinitions="*">
                            <TextBlock Classes="row-label" Text="{loc:T Mobile.ShowAll}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- History: how long plays are kept, and whether the computer hears of them. -->
        <StackPanel>
            <TextBlock Classes="group-caption" FontWeight="SemiBold" Text="{loc:T Mobile.History.Header}" />
            <Border Classes="group-card">
                <StackPanel>
                    <Button Name="KeepRow" Classes="row" Command="{Binding ChooseKeepCommand}" AutomationProperties.Name="{loc:T Mobile.History.Keep}">
                        <Grid Classes="setting-row" ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Classes="row-label" Text="{loc:T Mobile.History.Keep}" />
                            <TextBlock Grid.Column="1" Name="KeepValueLabel" Classes="row-value" HorizontalAlignment="Right" Text="{Binding KeepText}" />
                            <views:GridIcon Grid.Column="2" Classes="row-trailing" StrokeThickness="2" Data="{DynamicResource SetIconUpDown}" />
                        </Grid>
                    </Button>
                    <Border Classes="row-separator plain" />
                    <Button Name="CountRow" Classes="row" Command="{Binding ChooseCountCommand}" AutomationProperties.Name="{loc:T Mobile.History.CountAfter}">
                        <Grid Classes="setting-row" ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Classes="row-label" Text="{loc:T Mobile.History.CountAfter}" />
                            <TextBlock Grid.Column="1" Name="CountValueLabel" Classes="row-value" HorizontalAlignment="Right" Text="{Binding CountText}" />
                            <views:GridIcon Grid.Column="2" Classes="row-trailing" StrokeThickness="2" Data="{DynamicResource SetIconUpDown}" />
                        </Grid>
                    </Button>
                    <StackPanel IsVisible="{Binding HasAccount}">
                        <Border Classes="row-separator plain" />
                        <ToggleButton Name="ShareSwitch" Classes="switch-row" AutomationProperties.Name="{loc:T Mobile.History.Share}"
                                      IsChecked="{Binding ShareWithComputer}">
                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                <TextBlock Classes="row-label" Text="{loc:T Mobile.History.Share}" />
                                <TextBlock Classes="row-sub" Text="{loc:T Mobile.History.ShareHint}" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel>
            <Border Classes="group-card">
                <Button Name="ClearButton" Classes="row accent-row" Command="{Binding AskClearCommand}" AutomationProperties.Name="{loc:T Mobile.History.ClearName}">
                    <Grid Classes="setting-row" ColumnDefinitions="*">
                        <TextBlock Classes="row-label" Text="{loc:T Mobile.History.ClearRow}" />
                    </Grid>
                </Button>
            </Border>
            <TextBlock Classes="group-footnote" Text="{loc:T Mobile.History.ClearHint}" />
        </StackPanel>
    </StackPanel>
</UserControl>
