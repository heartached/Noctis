<controls:GlassPanel xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:vm="using:Noctis.Mobile.ViewModels"
                     xmlns:loc="using:Noctis.Localization"
                     xmlns:controls="using:Noctis.Controls"
                     x:Class="Noctis.Mobile.Views.ListTools"
                     x:DataType="vm:SongListPageViewModel"
                     Classes="header-glass" Width="NaN" IsVisible="{Binding HasSongs}">
    <!-- A song list's tools, in one glass pill beside its title (the Library header's pill):
         sort and filter (the search is the page's own field, FindField, as on Artists). Each lights up while it changes what is shown.
         The pill is the control itself rather than glass inside a UserControl: wrapped, its
         shadow was cut off square at the UserControl's edges on the device. -->
    <StackPanel Orientation="Horizontal" Margin="4,0">
        <!-- Select mode (ticks, then act on several songs at once). -->
        <Button Name="ListSelectButton" Classes="glass-round" Classes.on="{Binding Selection.IsActive}"
                Command="{Binding BeginSelectCommand}" AutomationProperties.Name="{loc:T Mobile.Select}">
            <PathIcon Data="{DynamicResource PhSelect}" />
        </Button>
        <Button Name="ListSortButton" Classes="glass-round" Classes.on="{Binding IsSorted}" Command="{Binding ShowSortMenuCommand}">
            <PathIcon Data="{DynamicResource PhSort}" />
        </Button>
        <Button Name="ListFilterButton" Classes="glass-round" Classes.on="{Binding IsFiltered}" Command="{Binding ShowFilterMenuCommand}"
                IsVisible="{Binding HasFilters}">
            <PathIcon Data="{DynamicResource PhFilter}" />
        </Button>
    </StackPanel>
</controls:GlassPanel>
