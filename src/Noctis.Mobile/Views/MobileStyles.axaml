<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Noctis.Controls"
        xmlns:views="using:Noctis.Mobile.Views">
    <!-- Phone-wide styles, included once by ShellView so every page, overlay and test mount
         gets them. Colours are DynamicResources from Noctis.UI's theme dictionaries: they
         resolve on the device (AndroidApp.axaml merges Styles.axaml and the overlays) and
         stay unset in the headless tests, whose app loads only Fluent. -->

    <!-- Touch has no hover. Noctis.UI's Styles.axaml zooms every Button on :pointerover
         (scale 1.045) and on a phone :pointerover means "finger down", so every tapped
         control swelled (the Phase 3 lyric-line flash). -->
    <Style Selector="Button:pointerover">
        <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>

    <!-- Overlay scroll bars. Noctis.UI's Styles.axaml pins every ScrollViewer and ScrollBar to
         AllowAutoHide=False for the desktop's persistent bars, and a bar that never hides
         reserves its width: every phone page stopped ~16 dp short of the right edge, heroes
         and rails included. Fluent's auto-hide bar floats over the content instead. -->
    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="True" />
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="True" />
    </Style>
    <!-- Android's indicator: unseen at rest, shown while the list moves, faded out a second
         after it stops (ScrollBarFade sets "scrolling"). -->
    <Style Selector="ScrollViewer /template/ ScrollBar">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ScrollViewer.scrolling /template/ ScrollBar">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Text. Noctis.UI's Styles.axaml sets every TextBlock to the Inter SemiBold face (the
         desktop's look), a single-weight family, so no FontWeight below Bold could show on the
         phone: list labels, rows and captions all read semibold where Apple's are regular. The
         phone sets the full Inter family (WithInterFont) back, so each weight is its own. -->
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="fonts:Inter#Inter, $Default" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.subtle">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource PhoneSecondaryTextBrush}" />
    </Style>
    <Style Selector="TextBlock.row-title">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.row-sub">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource PhoneSecondaryTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- A song row's rating stars in the artist line's grey, a favourite's heart in the accent. -->
    <Style Selector="views|RowMark">
        <Setter Property="Foreground" Value="{DynamicResource PhoneSecondaryTextBrush}" />
        <Setter Property="HeartBrush" Value="{DynamicResource AccentTextExactBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A list row's hairline, from the text to the edge (Apple's inset separator), and its
         small grey chevron. -->
    <Style Selector="Border.hairline">
        <Setter Property="Height" Value="0.5" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Background" Value="{DynamicResource PhoneSeparatorBrush}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="PathIcon.list-chevron">
        <Setter Property="Width" Value="19" />
        <Setter Property="Height" Value="19" />
        <Setter Property="Margin" Value="0,0,-5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource PhoneChevronBrush}" />
    </Style>

    <!-- Surfaces -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource PhoneGroupedBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Border.art">
        <Setter Property="Background" Value="{DynamicResource PhoneFillBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.explicit">
        <Setter Property="Background" Value="#59808080" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The explicit badge (Noctis.UI's explicit-badge, its white "E"): the palette's fill, Apple's
         secondary grey on Light, where the desktop's half-grey over white left the "E" unreadable. -->
    <Style Selector="Border.explicit-badge">
        <Setter Property="Background" Value="{DynamicResource PhoneExplicitBadgeBrush}" />
    </Style>
    <Style Selector="Border.explicit TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Buttons. Fluent repaints the template's ContentPresenter on :pointerover/:pressed with
         its own ButtonBackgroundPointerOver/…Pressed brushes, which beat a Background set on
         the Button; each phone class keeps its own look through both states and dims instead. -->
    <Style Selector="Button.row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon PathIcon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="Button.round">
        <Setter Property="Background" Value="#33808080" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.round PathIcon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>
    <!-- Pills: a full 44 dp touch target with round ends, semibold label, centred content. -->
    <Style Selector="Button.pill">
        <Setter Property="Background" Value="{DynamicResource PhoneFillBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- On a card the fill is the card's own colour in Ink, Smoke and Dark (#1C1C1E on #1C1C1E),
         so the pill had no shape at all ("Choose folder", dark mode). The raised card colour
         shows it in every theme. -->
    <Style Selector="Border.card Button.pill">
        <Setter Property="Background" Value="{DynamicResource PhoneCardBrush}" />
    </Style>
    <Style Selector="Button.pill-accent">
        <Setter Property="Background" Value="{DynamicResource AccentColorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pill PathIcon, Button.pill-accent PathIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pill-accent PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>
    <!-- Library chips: an icon pill; the selected one turns accent and its name slides out. -->
    <Style Selector="Button.chip">
        <Setter Property="Background" Value="{DynamicResource PhoneFillBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <!-- The colour change on selection, plus the press feedback (see the end of this file). -->
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.22" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.12">
                    <DoubleTransition.Easing><CubicEaseOut /></DoubleTransition.Easing>
                </DoubleTransition>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16">
                    <TransformOperationsTransition.Easing><CubicEaseOut /></TransformOperationsTransition.Easing>
                </TransformOperationsTransition>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.chip.selected">
        <Setter Property="Background" Value="{DynamicResource AccentColorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>
    <!-- Icon boxes are the 24-grid (the glyphs carry its corners, see PhoneIcons.axaml); a
         negative margin keeps the layout footprint of the old, tightly cropped box. -->
    <Style Selector="Button.chip PathIcon">
        <Setter Property="Width" Value="21" />
        <Setter Property="Height" Value="21" />
        <Setter Property="Margin" Value="-2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chip TextBlock.chip-label">
        <Setter Property="MaxWidth" Value="0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="MaxWidth" Duration="0:0:0.28">
                    <DoubleTransition.Easing><CubicEaseOut /></DoubleTransition.Easing>
                </DoubleTransition>
                <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
                <ThicknessTransition Property="Margin" Duration="0:0:0.28">
                    <ThicknessTransition.Easing><CubicEaseOut /></ThicknessTransition.Easing>
                </ThicknessTransition>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.chip.selected TextBlock.chip-label">
        <Setter Property="MaxWidth" Value="160" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Margin" Value="7,0,0,0" />
    </Style>
    <!-- Text chips (Search's scopes): the library chip's shape with a label that always shows. -->
    <Style Selector="Button.text-chip">
        <Setter Property="Background" Value="{DynamicResource PhoneFillBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.22" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.text-chip.selected">
        <Setter Property="Background" Value="{DynamicResource AccentColorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>
    <!-- A page tool that is on (a filter in use). -->
    <Style Selector="Button.icon.on PathIcon, Button.glass-round.on PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextExactBrush}" />
    </Style>
    <!-- The long-press sheet's quick actions: an icon over a short label, four across. -->
    <Style Selector="Button.sheet-tile">
        <Setter Property="Background" Value="{DynamicResource HomeCardBackground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="4,10" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="MinHeight" Value="68" />
        <!-- Fill the grid cell both ways: a two-line label ("Add to Playlist") makes its cell
             taller, and every tile in the row takes that same height. -->
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.sheet-tile PathIcon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.sheet-tile TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="Button.sheet-tile.on PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextExactBrush}" />
    </Style>

    <!-- A Library section title: accent icon, title, a small chevron; the whole row opens the list. -->
    <Style Selector="Button.section-header">
        <Setter Property="Margin" Value="20,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="0,2" />
    </Style>
    <Style Selector="Button.section-header PathIcon">
        <Setter Property="Width" Value="21" />
        <Setter Property="Height" Value="21" />
        <Setter Property="Margin" Value="-2,-2,6,-2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextExactBrush}" />
    </Style>
    <!-- The chevron's 11u-tall glyph at the old 12 dp: a 26 box in the old 12x12 footprint. -->
    <Style Selector="Button.section-header PathIcon.chevron">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="-1,-5,-7,-7" />
        <Setter Property="Foreground" Value="{DynamicResource PhoneChevronBrush}" />
    </Style>
    <Style Selector="Button.section-header TextBlock.section">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Liquid Glass (iOS 26) on the phone's floating chrome: the tab capsule, the mini
         player, the folded round buttons, the Queue's control pill. A light frost, so what
         passes beneath stays recognisable; a rim that refracts it like the curved edge of a
         lens (GlassPanel.Refraction); a hairline outline all the way round (Apple's: a faint
         dark rim on light glass, a faint light one on dark), a soft rim light and shadow. The
         tint and outline are the palette's (MobileTheme.BuildPalette), the luminance range
         ShellView's theme resources. Dark content under the light glass is lifted under a white
         veil (BackdropLift), as the menus' glass is: scaling its colour up to the floor turned a
         dark brown cover peach and orange under the tab bar and the mini player. -->
    <Style Selector="controls|GlassPanel.liquid">
        <Setter Property="UseAppGlass" Value="False" />
        <Setter Property="IsGlassActive" Value="True" />
        <Setter Property="BlurRadius" Value="1.5" />
        <Setter Property="Refraction" Value="20" />
        <Setter Property="RefractionAmount" Value="26" />
        <Setter Property="Saturation" Value="1.3" />
        <Setter Property="Specular" Value="0.35" />
        <Setter Property="BackdropMinLuminance" Value="{DynamicResource GlassBarMinLuminance}" />
        <Setter Property="BackdropMaxLuminance" Value="{DynamicResource GlassBarMaxLuminance}" />
        <Setter Property="BackdropLift" Value="1" />
        <Setter Property="BoxShadow" Value="0 6 20 0 #1F000000" />
        <Setter Property="Background" Value="{DynamicResource PhoneChromeBrush}" />
        <Setter Property="EdgeBrush" Value="{DynamicResource PhoneChromeOutlineBrush}" />
        <Setter Property="EdgeThickness" Value="1" />
    </Style>
    <!-- A round bubble bends light over a shorter rim. -->
    <Style Selector="controls|GlassPanel.liquid.bubble">
        <Setter Property="Refraction" Value="16" />
        <Setter Property="RefractionAmount" Value="21" />
    </Style>

    <!-- Liquid Glass in a page header: the tools pill and the profile circle (Apple's 44 pt). -->
    <Style Selector="controls|GlassPanel.header-glass">
        <Setter Property="UseAppGlass" Value="False" />
        <Setter Property="IsGlassActive" Value="True" />
        <Setter Property="BlurRadius" Value="1.5" />
        <Setter Property="Refraction" Value="11" />
        <Setter Property="RefractionAmount" Value="14" />
        <Setter Property="Saturation" Value="1.3" />
        <Setter Property="Specular" Value="0.35" />
        <Setter Property="BackdropMinLuminance" Value="{DynamicResource GlassBarMinLuminance}" />
        <Setter Property="BackdropMaxLuminance" Value="{DynamicResource GlassBarMaxLuminance}" />
        <Setter Property="BackdropLift" Value="1" />
        <Setter Property="BoxShadow" Value="0 3 12 0 #14000000" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Background" Value="{DynamicResource PhoneChromeBrush}" />
        <Setter Property="EdgeBrush" Value="{DynamicResource PhoneChromeOutlineBrush}" />
        <Setter Property="EdgeThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.glass-round">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.glass-round PathIcon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>
    <!-- A word in a header glass pill (Select mode's Select All and Done); Done in the accent. -->
    <Style Selector="Button.glass-text">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.glass-text.accent">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.glass-text.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <!-- Select mode's check circle on a song row: a grey ring, the accent disc once ticked. -->
    <Style Selector="views|SelectCheck">
        <Setter Property="RingBrush" Value="{DynamicResource PhoneSecondaryTextBrush}" />
        <Setter Property="FillBrush" Value="{DynamicResource AccentColorBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A rail or grid cover (RailTile): rounded square; artists override to a circle below. -->
    <Style Selector="Border.art.rail">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.art.artist">
        <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.tile">
        <Setter Property="Background" Value="{DynamicResource HomeCardBackground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Height" Value="84" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.tile-icon">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Background" Value="{DynamicResource AccentColorBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.tile-icon PathIcon">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.tile-count">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="TextBlock.tile-label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style Selector="Button.tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Tab colours sit on the icon and label themselves, so Fluent's presenter Foreground
         swap on :pointerover cannot reach them. Apple's bar: filled glyphs in the text colour,
         small medium labels, the selected tab in the accent. The phone's accent glyphs and
         labels take AccentTextExactBrush, the accent itself unless it lacks contrast: the
         desktop's AccentTextBrush mixes it 55 % toward white on dark themes, and the red
         icons Apple keeps in dark came out pale pink. -->
    <Style Selector="Button.tab PathIcon">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="-1" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style Selector="Button.tab TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <!-- A long translated label shrinks first (FitWidth in ShellView), then trims. -->
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style Selector="Button.tab.selected PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextExactBrush}" />
    </Style>
    <Style Selector="Button.tab.selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextExactBrush}" />
    </Style>
    <!-- The folded bar's round buttons: one glyph, a touch smaller. -->
    <Style Selector="Button.tab.bubble PathIcon">
        <Setter Property="Width" Value="25" />
        <Setter Property="Height" Value="25" />
    </Style>

    <!-- The mini player's Play and Next: Apple's filled glyphs; Next greys out with nothing
         after the current song. Apple draws both at one height, about 0.3 of the bar: sized by
         the drawn glyph, not the box, so 15.5 dp tall each. Play and Pause stand 18 of the
         24-grid's units (box 20.7), the Forward pair 12.73 (box 29.2). 44 dp touch targets. -->
    <Style Selector="Button.icon.mini">
        <Setter Property="Width" Value="44" />
    </Style>
    <Style Selector="Button.icon.mini PathIcon, Button.icon.mini controls|TransportGlyph">
        <Setter Property="Width" Value="20.7" />
        <Setter Property="Height" Value="20.7" />
    </Style>
    <Style Selector="Button.icon.mini PathIcon.forward, Button.icon.mini controls|TransportGlyph.forward">
        <Setter Property="Width" Value="29.2" />
        <Setter Property="Height" Value="29.2" />
    </Style>
    <!-- Play and Next draw one height, so they share one press circle. -->
    <Style Selector="Button.icon.mini controls|TransportGlyph">
        <Setter Property="HighlightSize" Value="36" />
    </Style>
    <Style Selector="Button.icon.mini.unavailable PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Opacity" Value="0.3" />
    </Style>
    <Style Selector="Button.icon.mini.unavailable controls|TransportGlyph">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Opacity" Value="0.3" />
    </Style>

    <!-- A tab page's header (Library, Favorites, Playlists, Search): the large title, then the
         page's glass tools and the profile circle at the right. -->
    <Style Selector="Grid.tab-header">
        <Setter Property="Margin" Value="20,8,16,10" />
        <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="Grid.tab-header TextBlock.title">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Apple's search field: a filled capsule, the magnifier at its start, no border and no
         accent ring on focus (Fluent's TextBox draws both through its template's border, at
         rest, on hover and on focus). -->
    <Style Selector="TextBox.search-field">
        <Setter Property="Background" Value="{DynamicResource PhoneFillBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="6,0,12,0" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="InnerLeftContent">
            <Template>
                <PathIcon Data="{DynamicResource PhSearch}" Width="19" Height="19" Margin="12,0,0,0"
                          Foreground="{DynamicResource PhoneSecondaryTextBrush}" />
            </Template>
        </Setter>
    </Style>
    <Style Selector="TextBox.search-field:pointerover /template/ Border#PART_BorderElement, TextBox.search-field:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource PhoneFillBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.search-field /template/ TextBlock#PART_Placeholder, TextBox.search-field /template/ TextBlock#PART_FloatingPlaceholder">
        <Setter Property="Foreground" Value="{DynamicResource PhoneSecondaryTextBrush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- A tab page's main list: content scrolls under the floating glass bar, so the list
         ends ShellBottomInset (kept current by ShellView) below its last row. -->
    <Style Selector="ScrollViewer.page-scroll">
        <Setter Property="Padding" Value="{DynamicResource ShellBottomInset}" />
    </Style>

    <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.row:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.round:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.round:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.pill:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.pill-accent:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.pill-accent:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.chip:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tile:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tab:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.text-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.text-chip:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.sheet-tile:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.sheet-tile:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
        <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
        <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <!-- Greyed (disabled) too: Fluent fills a disabled button's presenter with its grey, which put a
         grey disc behind the mini player's Next with nothing to skip to. The glyph dims instead
         (Button.icon.mini.unavailable); the foreground stays Fluent's disabled grey. -->
    <Style Selector="Button.row:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.round:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.glass-round:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.pill:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.chip:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.tile:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.tab:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.text-chip:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.sheet-tile:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
        <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
    </Style>
    <!-- Press feedback, the way Apple's controls answer a touch: the button dims and settles a
         touch smaller, easing in and back out, instead of jumping to 70 % opacity. Both ease on
         the button itself (TransformOperationsTransition: an Animation cannot drive RenderTransform
         here). Nothing in code sets these buttons' RenderTransform, so the transition only ever
         carries the press. Full-width rows only dim: a row shrinking reads as a glitch. -->
    <Style Selector="Button.icon, Button.round, Button.glass-round, Button.pill, Button.pill-accent, Button.tile, Button.tab">
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12">
                    <DoubleTransition.Easing><CubicEaseOut /></DoubleTransition.Easing>
                </DoubleTransition>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16">
                    <TransformOperationsTransition.Easing><CubicEaseOut /></TransformOperationsTransition.Easing>
                </TransformOperationsTransition>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.row">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12">
                    <DoubleTransition.Easing><CubicEaseOut /></DoubleTransition.Easing>
                </DoubleTransition>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.icon:pressed, Button.round:pressed, Button.glass-round:pressed, Button.pill:pressed, Button.pill-accent:pressed, Button.chip:pressed, Button.tile:pressed, Button.tab:pressed, Button.text-chip:pressed, Button.sheet-tile:pressed">
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <Style Selector="Button.row:pressed">
        <Setter Property="Opacity" Value="0.6" />
    </Style>
    <!-- Previous / Play-Pause / Next (tx): Apple Music's own press instead - a circle fades in
         behind the glyph and the glyph dips and springs back (TransportGlyph) - so the button
         itself neither dims nor shrinks. Declared after the press above so it wins. -->
    <Style Selector="Button.icon.tx:pressed">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
</Styles>
