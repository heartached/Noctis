<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:views="using:Noctis.Mobile.Views"
             x:Class="Noctis.Mobile.Views.RailGridPage"
             x:DataType="vm:RailGridPageViewModel">
    <Grid RowDefinitions="Auto,*">
        <!-- The shared header (PageHeader): "‹ Library" over the large title. -->
        <views:PageHeader Grid.Row="0" Name="Header" />

        <TextBlock Grid.Row="1" Name="EmptyText" Classes="subtle" Text="{loc:T Mobile.NothingHere}" HorizontalAlignment="Center"
                   Margin="0,40,0,0" IsVisible="{Binding !HasItems}" />

        <ScrollViewer Classes="page-scroll" Grid.Row="1" views:ScrollMemory.IsEnabled="True" HorizontalScrollBarVisibility="Disabled">
            <!-- Rows built once and handed the next row (RowItemsControl), tiles built once per
                 row and handed the next item (SlotRow), as the Albums page's grid. -->
            <views:RowItemsControl Name="RailGrid" ItemsSource="{Binding Rows}" Margin="14,4,14,16">
                <views:RowItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </views:RowItemsControl.ItemsPanel>
                <views:RowItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RailGridRow">
                        <views:SlotRow Items="{Binding Items}" Columns="3">
                            <views:SlotRow.ItemTemplate>
                                <DataTemplate x:DataType="vm:RailItem">
                                    <Button Classes="row" Margin="6,0,6,14" VerticalAlignment="Top"
                                            views:LongPress.Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenRailItemSheetCommand}"
                                            Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenRailItemCommand}"
                                            CommandParameter="{Binding}">
                                        <views:RailTile />
                                    </Button>
                                </DataTemplate>
                            </views:SlotRow.ItemTemplate>
                        </views:SlotRow>
                    </DataTemplate>
                </views:RowItemsControl.ItemTemplate>
            </views:RowItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
