<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Noctis.Models"
             xmlns:controls="using:Noctis.Controls"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:views="using:Noctis.Mobile.Views"
             x:Class="Noctis.Mobile.Views.SongRow"
             x:DataType="models:Track">
    <!-- One song: cover, title, artist, explicit badge, then the overflow button. No heart button
         on the row (owner 10-19, the album page's rule): Favorite is the first tile of the ⋯ menu.
         The artist line ends in the small RowMark (stars or a heart, as Settings chooses). -->
    <Grid Name="RowGrid" ColumnDefinitions="Auto,*,Auto" Height="60" Margin="8,0">
        <Border Classes="art" Width="44" Height="44">
            <Panel>
                <PathIcon Data="{DynamicResource SongsIcon}" Width="18" Height="18" Opacity="0.5" />
                <controls:CachedImage SourcePath="{Binding AlbumArtworkPath}" DecodeWidth="128" Stretch="UniformToFill" />
            </Panel>
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
            <!-- Left-aligned, so the badge follows the title (the album rows' rule), not the row's end. -->
            <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                <TextBlock Name="RowTitle" Classes="row-title" Text="{Binding Title}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="1" Name="ExplicitBadge" Classes="explicit-badge compact" Margin="6,0,0,0"
                        IsVisible="{Binding IsExplicit}">
                    <TextBlock Text="E" Classes="explicit-badge-text compact" FontSize="8" Opacity="0.9" />
                </Border>
            </Grid>
            <!-- The artist, and at the line's end the song's stars or heart (Settings › Library ›
                 Show in Song Rows); without one the mark takes no room. -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="row-sub" Text="{Binding Artist}" />
                <views:RowMark Grid.Column="1" Name="RowMark" Margin="6,0,0,0" />
            </Grid>
        </StackPanel>
        <Button Grid.Column="2" Name="MoreButton" Classes="icon" Width="36" Height="36"
                IsVisible="{Binding $parent[views:SongRow].IsMenuVisible}"
                Command="{Binding $parent[views:SongRow].MenuCommand}"
                CommandParameter="{Binding}">
            <!-- Button.icon's 24 box, as every other row's ⋯ (album, artist, queue). -->
            <PathIcon Data="{DynamicResource PhMore}" />
        </Button>
    </Grid>
</UserControl>
