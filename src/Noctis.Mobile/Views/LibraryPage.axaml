<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:views="using:Noctis.Mobile.Views"
             xmlns:models="using:Noctis.Models"
             xmlns:controls="using:Noctis.Controls"
             xmlns:loc="using:Noctis.Localization"
             x:Class="Noctis.Mobile.Views.LibraryPage"
             x:DataType="vm:ShellViewModel">

    <UserControl.Resources>
        <!-- One rail tile: three covers across with the fourth peeking, like Apple's Library. -->
        <DataTemplate x:Key="RailTileTemplate" x:DataType="vm:RailItem">
            <Button Classes="row" Width="112" VerticalAlignment="Top"
                    views:LongPress.Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenRailItemSheetCommand}"
                    Command="{Binding $parent[views:LibraryPage].((vm:ShellViewModel)DataContext).OpenRailItemCommand}"
                    CommandParameter="{Binding}">
                <views:RailTile />
            </Button>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="RailPanel">
            <StackPanel Orientation="Horizontal" Spacing="12" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" Name="LibraryHeader" ColumnDefinitions="*,Auto,Auto" Margin="20,10,16,8">
            <TextBlock Classes="title" Text="{loc:T Tab.Library}" VerticalAlignment="Center" />
            <!-- Round glass buttons, as on Apple's Library: the … menu and the profile (Settings). -->
            <controls:GlassPanel Grid.Column="1" Classes="header-glass" Margin="0,0,10,0">
                <Button Name="LibraryMoreButton" Classes="glass-round">
                    <PathIcon Data="{DynamicResource LibMoreIcon}" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Add Folder…" Command="{Binding Library.AddFolderCommand}" />
                            <MenuItem Header="Rescan Library" Command="{Binding Library.RescanCommand}" />
                            <MenuItem Header="Settings" Command="{Binding OpenSettingsCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </controls:GlassPanel>
            <controls:GlassPanel Grid.Column="2" Classes="header-glass">
                <Button Name="LibraryProfileButton" Classes="glass-round" Command="{Binding OpenSettingsCommand}">
                    <PathIcon Data="{DynamicResource PersonIcon}" />
                </Button>
            </controls:GlassPanel>
        </Grid>

        <!-- Chips: All Music, then icon-only views; the selected chip grows to show its name. -->
        <ScrollViewer Grid.Row="1" Name="ChipScroll" Margin="0,0,0,10" IsVisible="{Binding Library.HasFolders}"
                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="20,0">
                <Button Name="AllMusicChip" Classes="chip" Classes.selected="{Binding IsAllMusicChip}"
                        Command="{Binding SelectLibraryChipCommand}" CommandParameter="{x:Static vm:LibraryChip.AllMusic}">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="{DynamicResource ChipAllMusicIcon}" />
                        <TextBlock Classes="chip-label" Text="All Music" />
                    </StackPanel>
                </Button>
                <Button Name="PlaylistsChip" Classes="chip" Classes.selected="{Binding IsPlaylistsChip}"
                        Command="{Binding SelectLibraryChipCommand}" CommandParameter="{x:Static vm:LibraryChip.Playlists}">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="{DynamicResource ChipPlaylistsIcon}" />
                        <TextBlock Classes="chip-label" Text="{loc:T Nav.Playlists}" />
                    </StackPanel>
                </Button>
                <Button Name="ArtistsChip" Classes="chip" Classes.selected="{Binding IsArtistsChip}"
                        Command="{Binding SelectLibraryChipCommand}" CommandParameter="{x:Static vm:LibraryChip.Artists}">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="{DynamicResource ChipArtistsIcon}" />
                        <TextBlock Classes="chip-label" Text="{loc:T Nav.Artists}" />
                    </StackPanel>
                </Button>
                <Button Name="AlbumsChip" Classes="chip" Classes.selected="{Binding IsAlbumsChip}"
                        Command="{Binding SelectLibraryChipCommand}" CommandParameter="{x:Static vm:LibraryChip.Albums}">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="{DynamicResource ChipAlbumsIcon}" />
                        <TextBlock Classes="chip-label" Text="{loc:T Nav.Albums}" />
                    </StackPanel>
                </Button>
                <Button Name="SongsChip" Classes="chip" Classes.selected="{Binding IsSongsChip}"
                        Command="{Binding SelectLibraryChipCommand}" CommandParameter="{x:Static vm:LibraryChip.Songs}">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="{DynamicResource ChipSongsIcon}" />
                        <TextBlock Classes="chip-label" Text="{loc:T Nav.Songs}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <Panel Grid.Row="2">
            <ScrollViewer Classes="page-scroll" Name="LibraryScroll" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsAllMusicChip}">
                <!-- No side margin here: rails scroll edge to edge; headers and cards inset themselves. -->
                <StackPanel Name="LibraryContent" Margin="0,4,0,24" Spacing="22">
                    <StackPanel Name="NoticeCards" Margin="20,0" Spacing="14" IsVisible="{Binding Library.HasNotice}">
                        <Border Name="ConnectCard" Classes="card" Padding="16" IsVisible="{Binding Library.ShowConnectCard}">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="section" Text="Add your music" />
                                <TextBlock Classes="subtle" TextWrapping="Wrap"
                                           Text="Pick the folder your music lives in. Noctis reads it in place and never uploads anything." />
                                <Button Classes="pill-accent" Content="Choose folder" Command="{Binding Library.AddFolderCommand}" />
                            </StackPanel>
                        </Border>

                        <Border Name="ReconnectCard" Classes="card" Padding="16" IsVisible="{Binding Library.NeedsReconnect}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Library.StatusText}" TextWrapping="Wrap" />
                                <Button Classes="pill" Content="Reconnect folder" Command="{Binding Library.AddFolderCommand}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="4" IsVisible="{Binding Library.IsScanning}">
                            <ProgressBar IsIndeterminate="True" />
                            <TextBlock Classes="subtle" Text="{Binding Library.ScanProgress, StringFormat='Scanning… {0} files'}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Pinned: always shown once there is music, so the pin system is discoverable. -->
                    <StackPanel Name="PinnedSection" Spacing="10" IsVisible="{Binding Library.HasFolders}">
                        <Button Name="PinnedHeader" Classes="row section-header" Command="{Binding OpenPinnedCommand}">
                            <StackPanel Orientation="Horizontal">
                                <PathIcon Data="{DynamicResource LibPinIcon}" />
                                <TextBlock Classes="section" Text="Pinned" />
                                <PathIcon Classes="chevron" Data="{DynamicResource LibChevronIcon}" />
                            </StackPanel>
                        </Button>
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding Library.HasPinned}">
                            <ItemsControl Name="PinnedRail" Margin="20,0" ItemsSource="{Binding Library.PinnedRail}"
                                          ItemTemplate="{StaticResource RailTileTemplate}" ItemsPanel="{StaticResource RailPanel}" />
                        </ScrollViewer>
                        <Border Name="PinnedHint" Classes="card" Margin="20,0" Padding="16,14" IsVisible="{Binding !Library.HasPinned}">
                            <TextBlock Classes="subtle" TextWrapping="Wrap"
                                       Text="Long-press an album, artist, playlist or song and choose Pin to keep it here." />
                        </Border>
                    </StackPanel>

                    <StackPanel Name="RecentlyAddedSection" Spacing="10" IsVisible="{Binding Library.HasRecentlyAdded}">
                        <Button Name="RecentlyAddedHeader" Classes="row section-header" Command="{Binding OpenRecentlyAddedCommand}">
                            <StackPanel Orientation="Horizontal">
                                <PathIcon Data="{DynamicResource LibRecentlyAddedIcon}" />
                                <TextBlock Classes="section" Text="Recently Added" />
                                <PathIcon Classes="chevron" Data="{DynamicResource LibChevronIcon}" />
                            </StackPanel>
                        </Button>
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl Name="RecentlyAddedRail" Margin="20,0" ItemsSource="{Binding Library.RecentlyAddedRail}"
                                          ItemTemplate="{StaticResource RailTileTemplate}" ItemsPanel="{StaticResource RailPanel}" />
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel Name="OnRepeatSection" Spacing="10" IsVisible="{Binding Library.HasOnRepeat}">
                        <Button Name="OnRepeatHeader" Classes="row section-header" Command="{Binding OpenOnRepeatCommand}">
                            <StackPanel Orientation="Horizontal">
                                <PathIcon Data="{DynamicResource LibOnRepeatIcon}" />
                                <TextBlock Classes="section" Text="On Repeat" />
                                <PathIcon Classes="chevron" Data="{DynamicResource LibChevronIcon}" />
                            </StackPanel>
                        </Button>
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl Name="OnRepeatRail" Margin="20,0" ItemsSource="{Binding Library.OnRepeatRail}"
                                          ItemTemplate="{StaticResource RailTileTemplate}" ItemsPanel="{StaticResource RailPanel}" />
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel Name="RecentlyPlayedSection" Spacing="10" IsVisible="{Binding Library.HasShelf}">
                        <Button Name="RecentlyPlayedHeader" Classes="row section-header" Command="{Binding OpenRecentlyPlayedCommand}">
                            <StackPanel Orientation="Horizontal">
                                <PathIcon Data="{DynamicResource LibRecentlyPlayedIcon}" />
                                <TextBlock Classes="section" Text="Recently Played" />
                                <PathIcon Classes="chevron" Data="{DynamicResource LibChevronIcon}" />
                            </StackPanel>
                        </Button>
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl Name="RecentlyPlayedRail" Margin="20,0" ItemsSource="{Binding Library.RecentlyPlayedRail}"
                                          ItemTemplate="{StaticResource RailTileTemplate}" ItemsPanel="{StaticResource RailPanel}" />
                        </ScrollViewer>
                    </StackPanel>

                    <TextBlock Name="StatusLine" Classes="subtle" Margin="20,0" TextWrapping="Wrap" Text="{Binding Library.StatusText}"
                               IsVisible="{Binding Library.ShowStatusLine}" />
                </StackPanel>
            </ScrollViewer>

            <!-- The embedded list under a non-"All Music" chip; its view comes from ShellView's DataTemplates. -->
            <ContentControl Name="ChipHost" Content="{Binding LibraryChipPage}" IsVisible="{Binding !IsAllMusicChip}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Panel>
    </Grid>
</UserControl>
