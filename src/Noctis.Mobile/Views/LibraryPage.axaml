<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:views="using:Noctis.Mobile.Views"
             xmlns:models="using:Noctis.Models"
             xmlns:controls="using:Noctis.Controls"
             xmlns:loc="using:Noctis.Localization"
             x:Class="Noctis.Mobile.Views.LibraryPage"
             x:DataType="vm:ShellViewModel">

    <UserControl.Resources>
        <!-- One rail: a section title over a horizontal strip of RailTiles. -->
        <DataTemplate x:Key="RailTileTemplate" x:DataType="vm:RailItem">
            <Button Classes="row" Width="140"
                    Command="{Binding $parent[views:LibraryPage].((vm:ShellViewModel)DataContext).OpenRailItemCommand}"
                    CommandParameter="{Binding}">
                <views:RailTile />
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" Name="LibraryHeader" ColumnDefinitions="*,Auto" Margin="20,12,12,8">
            <TextBlock Classes="title" Text="{loc:T Tab.Library}" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" Name="ChipScroll" Margin="0,0,0,8" IsVisible="{Binding Library.HasFolders}"
                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="20,0">
                <Button Name="AllMusicChip" Classes="chip" Classes.selected="{Binding IsAllMusicChip}" Content="All Music"
                        Command="{Binding SelectLibraryChipCommand}" CommandParameter="{x:Static vm:LibraryChip.AllMusic}" />
                <Button Name="PlaylistsChip" Classes="chip" Classes.selected="{Binding IsPlaylistsChip}" Content="{loc:T Nav.Playlists}"
                        Command="{Binding SelectLibraryChipCommand}" CommandParameter="{x:Static vm:LibraryChip.Playlists}" />
                <Button Name="AlbumsChip" Classes="chip" Classes.selected="{Binding IsAlbumsChip}" Content="{loc:T Nav.Albums}"
                        Command="{Binding SelectLibraryChipCommand}" CommandParameter="{x:Static vm:LibraryChip.Albums}" />
                <Button Name="ArtistsChip" Classes="chip" Classes.selected="{Binding IsArtistsChip}" Content="{loc:T Nav.Artists}"
                        Command="{Binding SelectLibraryChipCommand}" CommandParameter="{x:Static vm:LibraryChip.Artists}" />
                <Button Name="SongsChip" Classes="chip" Classes.selected="{Binding IsSongsChip}" Content="{loc:T Nav.Songs}"
                        Command="{Binding SelectLibraryChipCommand}" CommandParameter="{x:Static vm:LibraryChip.Songs}" />
            </StackPanel>
        </ScrollViewer>

        <Panel Grid.Row="2">
            <ScrollViewer Name="LibraryScroll" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsAllMusicChip}">
                <StackPanel Name="LibraryContent" Margin="20,0,20,24" Spacing="14">
                    <Border Name="ConnectCard" Classes="card" Padding="16" IsVisible="{Binding Library.ShowConnectCard}">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="section" Text="Add your music" />
                            <TextBlock Classes="subtle" TextWrapping="Wrap"
                                       Text="Pick the folder your music lives in. Noctis reads it in place and never uploads anything." />
                            <Button Classes="pill-accent" Content="Choose folder" Command="{Binding Library.AddFolderCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Name="ReconnectCard" Classes="card" Padding="16" IsVisible="{Binding Library.NeedsReconnect}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding Library.StatusText}" TextWrapping="Wrap" />
                            <Button Classes="pill" Content="Reconnect folder" Command="{Binding Library.AddFolderCommand}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="4" IsVisible="{Binding Library.IsScanning}">
                        <ProgressBar IsIndeterminate="True" />
                        <TextBlock Classes="subtle" Text="{Binding Library.ScanProgress, StringFormat='Scanning… {0} files'}" />
                    </StackPanel>

                    <Grid Name="Tiles" ColumnDefinitions="*,12,*" RowDefinitions="Auto,12,Auto,12,Auto" IsVisible="{Binding Library.HasFolders}">
                        <Button Grid.Row="0" Grid.Column="0" Name="SongsTile" Classes="tile" Command="{Binding OpenSongsCommand}">
                            <Grid>
                                <Border Classes="tile-icon"><PathIcon Data="{DynamicResource SongsIcon}" /></Border>
                                <TextBlock Classes="tile-count" Text="{Binding Library.SongCount}" />
                                <TextBlock Classes="tile-label" Text="{loc:T Nav.Songs}" />
                            </Grid>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="2" Name="AlbumsTile" Classes="tile" Command="{Binding OpenAlbumsCommand}">
                            <Grid>
                                <Border Classes="tile-icon"><PathIcon Data="{DynamicResource AlbumsIcon}" /></Border>
                                <TextBlock Classes="tile-count" Text="{Binding Library.AlbumCount}" />
                                <TextBlock Classes="tile-label" Text="{loc:T Nav.Albums}" />
                            </Grid>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="0" Name="ArtistsTile" Classes="tile" Command="{Binding OpenArtistsCommand}">
                            <Grid>
                                <Border Classes="tile-icon"><PathIcon Data="{DynamicResource ArtistsIcon}" /></Border>
                                <TextBlock Classes="tile-count" Text="{Binding Library.ArtistCount}" />
                                <TextBlock Classes="tile-label" Text="{loc:T Nav.Artists}" />
                            </Grid>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="2" Name="PlaylistsTile" Classes="tile" Command="{Binding OpenPlaylistsCommand}">
                            <Grid>
                                <Border Classes="tile-icon"><PathIcon Data="{DynamicResource PlaylistsIcon}" /></Border>
                                <TextBlock Classes="tile-count" Text="{Binding Library.PlaylistCount}" />
                                <TextBlock Classes="tile-label" Text="{loc:T Nav.Playlists}" />
                            </Grid>
                        </Button>
                        <Button Grid.Row="4" Grid.Column="0" Name="RecentlyAddedTile" Classes="tile" Command="{Binding OpenRecentlyAddedCommand}">
                            <Grid>
                                <Border Classes="tile-icon"><PathIcon Data="{DynamicResource AddIcon}" /></Border>
                                <TextBlock Classes="tile-count" Text="{Binding Library.RecentlyAddedCount}" />
                                <TextBlock Classes="tile-label" Text="Recently Added" />
                            </Grid>
                        </Button>
                        <Button Grid.Row="4" Grid.Column="2" Name="FavouritesTile" Classes="tile" Command="{Binding OpenFavouritesCommand}">
                            <Grid>
                                <Border Classes="tile-icon"><PathIcon Data="{DynamicResource HeartFillIcon}" /></Border>
                                <TextBlock Classes="tile-count" Text="{Binding Library.FavoriteCount}" />
                                <TextBlock Classes="tile-label" Text="{loc:T Nav.Favorites}" />
                            </Grid>
                        </Button>
                    </Grid>

                    <StackPanel Name="ShelfSection" Spacing="8" IsVisible="{Binding Library.HasShelf}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="section" Text="Shelf" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Name="ShelfLayoutToggle" Classes="icon" Command="{Binding Library.ToggleShelfLayoutCommand}">
                                <Panel>
                                    <PathIcon Data="{DynamicResource PlaylistsIcon}" IsVisible="{Binding Library.IsShelfGrid}" />
                                    <PathIcon Data="{DynamicResource GridViewIcon}" IsVisible="{Binding !Library.IsShelfGrid}" />
                                </Panel>
                            </Button>
                        </Grid>
                        <ScrollViewer Name="ShelfGrid" IsVisible="{Binding Library.IsShelfGrid}"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Library.Shelf}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Album">
                                        <Button Classes="row" Width="160"
                                                Command="{Binding $parent[views:LibraryPage].((vm:ShellViewModel)DataContext).OpenAlbumCommand}"
                                                CommandParameter="{Binding}">
                                            <views:AlbumTile />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <ItemsControl Name="ShelfList" ItemsSource="{Binding Library.Shelf}" IsVisible="{Binding !Library.IsShelfGrid}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Album">
                                    <Button Classes="row"
                                            Command="{Binding $parent[views:LibraryPage].((vm:ShellViewModel)DataContext).OpenAlbumCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*" Height="64">
                                            <Border Classes="art" Width="52" Height="52">
                                                <Panel>
                                                    <PathIcon Data="{DynamicResource AlbumsIcon}" Width="20" Height="20" Opacity="0.4" />
                                                    <controls:CachedImage SourcePath="{Binding ArtworkPath}" DecodeWidth="128" Stretch="UniformToFill" />
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Classes="row-title" Text="{Binding Name}" />
                                                <TextBlock Classes="row-sub" Text="{Binding Artist}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding Library.HasPinned}">
                        <TextBlock Classes="section" Text="Pinned" />
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl Name="PinnedRail" ItemsSource="{Binding Library.PinnedRail}" ItemTemplate="{StaticResource RailTileTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding Library.HasRecentlyAdded}">
                        <TextBlock Classes="section" Text="Recently Added" />
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl Name="RecentlyAddedRail" ItemsSource="{Binding Library.RecentlyAddedRail}" ItemTemplate="{StaticResource RailTileTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding Library.HasOnRepeat}">
                        <TextBlock Classes="section" Text="On Repeat" />
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl Name="OnRepeatRail" ItemsSource="{Binding Library.OnRepeatRail}" ItemTemplate="{StaticResource RailTileTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Until Settings (B11) takes them over. -->
                    <StackPanel Name="FolderActions" Orientation="Horizontal" Spacing="8" IsVisible="{Binding Library.HasFolders}">
                        <Button Classes="pill" Content="Add folder" Command="{Binding Library.AddFolderCommand}" />
                        <Button Classes="pill" Content="Rescan" Command="{Binding Library.RescanCommand}" />
                    </StackPanel>

                    <TextBlock Name="StatusLine" Classes="subtle" TextWrapping="Wrap" Text="{Binding Library.StatusText}"
                               IsVisible="{Binding Library.ShowStatusLine}" />
                </StackPanel>
            </ScrollViewer>

            <!-- The embedded list under a non-"All Music" chip; its view comes from ShellView's DataTemplates. -->
            <ContentControl Name="ChipHost" Content="{Binding LibraryChipPage}" IsVisible="{Binding !IsAllMusicChip}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Panel>
    </Grid>
</UserControl>
