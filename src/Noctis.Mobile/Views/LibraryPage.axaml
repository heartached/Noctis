<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:loc="using:Noctis.Localization"
             x:Class="Noctis.Mobile.Views.LibraryPage"
             x:DataType="vm:ShellViewModel">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Name="LibraryHeader" ColumnDefinitions="*,Auto" Margin="20,12,12,8">
            <TextBlock Classes="title" Text="{loc:T Tab.Library}" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" Name="LibraryScroll" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Name="LibraryContent" Margin="20,0,20,24" Spacing="14">
                <Border Name="ConnectCard" Classes="card" Padding="16" IsVisible="{Binding Library.ShowConnectCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="section" Text="Add your music" />
                        <TextBlock Classes="subtle" TextWrapping="Wrap"
                                   Text="Pick the folder your music lives in. Noctis reads it in place and never uploads anything." />
                        <Button Classes="pill-accent" Content="Choose folder" Command="{Binding Library.AddFolderCommand}" />
                    </StackPanel>
                </Border>

                <Border Name="ReconnectCard" Classes="card" Padding="16" IsVisible="{Binding Library.NeedsReconnect}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding Library.StatusText}" TextWrapping="Wrap" />
                        <Button Classes="pill" Content="Reconnect folder" Command="{Binding Library.AddFolderCommand}" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="4" IsVisible="{Binding Library.IsScanning}">
                    <ProgressBar IsIndeterminate="True" />
                    <TextBlock Classes="subtle" Text="{Binding Library.ScanProgress, StringFormat='Scanning… {0} files'}" />
                </StackPanel>

                <Grid Name="Tiles" ColumnDefinitions="*,12,*" RowDefinitions="Auto,12,Auto,12,Auto" IsVisible="{Binding Library.HasFolders}">
                    <Button Grid.Row="0" Grid.Column="0" Name="SongsTile" Classes="tile" Command="{Binding OpenSongsCommand}">
                        <Grid>
                            <Border Classes="tile-icon"><PathIcon Data="{DynamicResource SongsIcon}" /></Border>
                            <TextBlock Classes="tile-count" Text="{Binding Library.SongCount}" />
                            <TextBlock Classes="tile-label" Text="{loc:T Nav.Songs}" />
                        </Grid>
                    </Button>
                    <Button Grid.Row="0" Grid.Column="2" Name="AlbumsTile" Classes="tile" Command="{Binding OpenAlbumsCommand}">
                        <Grid>
                            <Border Classes="tile-icon"><PathIcon Data="{DynamicResource AlbumsIcon}" /></Border>
                            <TextBlock Classes="tile-count" Text="{Binding Library.AlbumCount}" />
                            <TextBlock Classes="tile-label" Text="{loc:T Nav.Albums}" />
                        </Grid>
                    </Button>
                    <Button Grid.Row="2" Grid.Column="0" Name="ArtistsTile" Classes="tile" Command="{Binding OpenArtistsCommand}">
                        <Grid>
                            <Border Classes="tile-icon"><PathIcon Data="{DynamicResource ArtistsIcon}" /></Border>
                            <TextBlock Classes="tile-count" Text="{Binding Library.ArtistCount}" />
                            <TextBlock Classes="tile-label" Text="{loc:T Nav.Artists}" />
                        </Grid>
                    </Button>
                    <Button Grid.Row="2" Grid.Column="2" Name="PlaylistsTile" Classes="tile" Command="{Binding OpenPlaylistsCommand}">
                        <Grid>
                            <Border Classes="tile-icon"><PathIcon Data="{DynamicResource PlaylistsIcon}" /></Border>
                            <TextBlock Classes="tile-count" Text="{Binding Library.PlaylistCount}" />
                            <TextBlock Classes="tile-label" Text="{loc:T Nav.Playlists}" />
                        </Grid>
                    </Button>
                    <Button Grid.Row="4" Grid.Column="0" Name="RecentlyAddedTile" Classes="tile" Command="{Binding OpenRecentlyAddedCommand}">
                        <Grid>
                            <Border Classes="tile-icon"><PathIcon Data="{DynamicResource AddIcon}" /></Border>
                            <TextBlock Classes="tile-count" Text="{Binding Library.RecentlyAddedCount}" />
                            <TextBlock Classes="tile-label" Text="Recently Added" />
                        </Grid>
                    </Button>
                    <Button Grid.Row="4" Grid.Column="2" Name="FavouritesTile" Classes="tile" Command="{Binding OpenFavouritesCommand}">
                        <Grid>
                            <Border Classes="tile-icon"><PathIcon Data="{DynamicResource HeartFillIcon}" /></Border>
                            <TextBlock Classes="tile-count" Text="{Binding Library.FavoriteCount}" />
                            <TextBlock Classes="tile-label" Text="{loc:T Nav.Favorites}" />
                        </Grid>
                    </Button>
                </Grid>

                <!-- Until Settings (B11) takes them over. -->
                <StackPanel Name="FolderActions" Orientation="Horizontal" Spacing="8" IsVisible="{Binding Library.HasFolders}">
                    <Button Classes="pill" Content="Add folder" Command="{Binding Library.AddFolderCommand}" />
                    <Button Classes="pill" Content="Rescan" Command="{Binding Library.RescanCommand}" />
                </StackPanel>

                <TextBlock Name="StatusLine" Classes="subtle" TextWrapping="Wrap" Text="{Binding Library.StatusText}"
                           IsVisible="{Binding Library.ShowStatusLine}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
