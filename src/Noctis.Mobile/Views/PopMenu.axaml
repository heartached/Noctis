<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:views="using:Noctis.Mobile.Views"
             x:Class="Noctis.Mobile.Views.PopMenu"
             x:DataType="vm:ShellViewModel"
             IsVisible="False">

    <!-- Every ⋯ menu on the phone (owner 10-13), Apple Music's: a Liquid Glass card that pops out
         of the ⋯ button (or the held row or tile), three tiles on top and the rest as rows with
         inset hairlines. The desktop menus' glyphs (PhoneIcons). The sort and filter menus and the
         album's quality note are this card too (OptionsMenuViewModel), and the card is MenuGlass,
         the one glass every pop-up is made of. Opened, placed and closed by the code-behind, which
         plays the desktop menu's pop. -->
    <UserControl.Styles>
        <Style Selector="Button.np-tile, Button.np-row">
            <Setter Property="Foreground" Value="{DynamicResource MenuGlassText}" />
        </Style>
        <Style Selector="Button.np-tile">
            <Setter Property="Padding" Value="2,10,2,8" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style Selector="Button.np-tile PathIcon">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.np-tile TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxLines" Value="2" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
        <!-- Apple's context menu size: 44 tall rows on a 250 wide card (52/290 read oversized). -->
        <Style Selector="Button.np-row">
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <!-- Delete Playlist, Remove from Playlist: the glass's red (MenuGlassDestructive). -->
        <Style Selector="Button.np-row.np-danger">
            <Setter Property="Foreground" Value="{DynamicResource MenuGlassDestructive}" />
        </Style>
        <!-- The Rate row's stars: the glass's text colour, a little smaller than a row's glyph. -->
        <Style Selector="Button.np-star">
            <Setter Property="Foreground" Value="{DynamicResource MenuGlassText}" />
        </Style>
        <Style Selector="Button.np-star PathIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>
        <Style Selector="Button.np-row PathIcon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.np-row TextBlock.np-label">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Button.np-row TextBlock.np-detail">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource MenuGlassSecondaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxLines" Value="2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- The sort and filter menus' rows: Apple's shorter option rows, the tick in the lead column. -->
        <Style Selector="Button.np-option">
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="Button.np-option PathIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>
        <Style Selector="TextBlock.np-note">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource MenuGlassSecondaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <!-- Apple's band between a menu's groups (the sort order, then its direction). -->
        <Style Selector="Border.np-gap">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="{DynamicResource MenuGlassGroupGap}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <!-- Inset hairlines over each row after the first: from the label to the card's edge, as
             Apple's (so a hidden row never leaves a line at the card's foot). -->
        <Style Selector="Border.np-line">
            <Setter Property="Height" Value="0.6" />
            <Setter Property="Background" Value="{DynamicResource MenuGlassHairline}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- Apple's light dim behind an open menu, fading with the card (PopMenu.PopIn/PopOut);
             a flat colour, no blur: cheap on a mid-range phone. -->
        <Border Name="Dim" Background="#2E000000" Opacity="0" IsHitTestVisible="False" />
        <!-- A tap anywhere off the card closes it (and goes no further). -->
        <Border Name="Catcher" Background="Transparent" PointerPressed="OnCatcherPressed" />

        <ThemeVariantScope Name="Scope">
            <Panel Name="Card" Width="250" HorizontalAlignment="Left" VerticalAlignment="Top">
                <views:MenuGlass Name="Glass">
                    <Panel>
                        <ScrollViewer Name="Body" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                            <ContentControl Name="MenuContent">
                                <ContentControl.DataTemplates>
                                    <!-- A song, album, playlist or artist. -->
                                    <DataTemplate DataType="vm:ContextSheetViewModel">
                                        <StackPanel Name="Rows" Margin="0,6,0,6">
                                            <UniformGrid Name="Tiles" Rows="1" Margin="8,0">
                                                <Button Name="MenuFavourite" Classes="row np-tile" Command="{Binding ToggleFavouriteCommand}"
                                                        IsVisible="{Binding CanFavourite}" AutomationProperties.Name="{Binding FavouriteLabel}">
                                                    <StackPanel>
                                                        <Panel HorizontalAlignment="Center">
                                                            <PathIcon Data="{DynamicResource PhMenuHeart}" IsVisible="{Binding !IsFavourite}" />
                                                            <PathIcon Data="{DynamicResource PhMenuHeartFill}" IsVisible="{Binding IsFavourite}" />
                                                        </Panel>
                                                        <TextBlock Text="{Binding FavouriteTileLabel}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Name="MenuAddToPlaylist" Classes="row np-tile" Command="{Binding ShowPlaylistsCommand}">
                                                    <StackPanel>
                                                        <PathIcon Data="{DynamicResource PhAddToPlaylist}" />
                                                        <TextBlock Text="{loc:T Mobile.AddToPlaylist}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Name="MenuPlayNext" Classes="row np-tile" Command="{Binding PlayNextCommand}">
                                                    <StackPanel>
                                                        <PathIcon Data="{DynamicResource PhPlayNext}" />
                                                        <TextBlock Text="{loc:T Mobile.PlayNext}" />
                                                    </StackPanel>
                                                </Button>
                                            </UniformGrid>
                                            <Border Classes="np-line" Margin="20,2,20,0" />

                                            <Button Name="MenuAddToQueue" Classes="row np-row" Command="{Binding AddToQueueCommand}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhAddToQueue}" />
                                                    <TextBlock Grid.Column="1" Classes="np-label" Text="{loc:T Mobile.AddToQueue}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                            <!-- Just before the playing song (Previous plays it): Add to Queue's glyph upside down. -->
                                            <Button Name="MenuAddBeforeCurrent" Classes="row np-row" Command="{Binding AddBeforeCurrentCommand}"
                                                    IsVisible="{Binding CanAddBeforeCurrent}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhAddToQueue}" RenderTransform="scale(1,-1)" />
                                                    <!-- Two lines rather than trimmed: the longer translations do not fit the card in one. -->
                                                    <TextBlock Grid.Column="1" Classes="np-label" Text="{loc:T Mobile.AddBeforeCurrent}" VerticalAlignment="Center"
                                                               TextWrapping="Wrap" MaxLines="2" Margin="0,8,12,8" />
                                                    <Border Grid.Column="1" Classes="np-line" />
                                                </Grid>
                                            </Button>
                                            <!-- A song list's Select mode, this song ticked first (an album's: none yet). -->
                                            <Button Name="MenuSelect" Classes="row np-row" Command="{Binding SelectCommand}" IsVisible="{Binding CanSelect}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhSelect}" />
                                                    <TextBlock Grid.Column="1" Classes="np-label" Text="{loc:T Mobile.Select}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Classes="np-line" />
                                                </Grid>
                                            </Button>
                                            <!-- A song's rating: five stars (a tap sets it) and Clear while it has one. -->
                                            <Grid Name="MenuRate" ColumnDefinitions="56,*,Auto" MinHeight="44" IsVisible="{Binding CanRate}">
                                                <PathIcon Data="{DynamicResource PhStar}" Width="20" Height="20" Foreground="{DynamicResource MenuGlassText}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <ItemsControl Grid.Column="1" Name="MenuRateStars" ItemsSource="{Binding Stars}" VerticalAlignment="Center"
                                                              AutomationProperties.Name="{loc:T Mobile.Rate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:RateStar">
                                                            <Button Classes="row np-star" Width="30" Height="40" Padding="0"
                                                                    Command="{Binding $parent[ItemsControl].((vm:ContextSheetViewModel)DataContext).RateCommand}"
                                                                    CommandParameter="{Binding Value}" AutomationProperties.Name="{Binding AccessibleName}">
                                                                <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <PathIcon Data="{DynamicResource PhStar}" IsVisible="{Binding !IsOn}" />
                                                                    <PathIcon Data="{DynamicResource PhStarFill}" IsVisible="{Binding IsOn}" />
                                                                </Panel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Grid.Column="2" Name="MenuClearRating" Classes="row np-star" Width="36" Height="40" Padding="0" Margin="0,0,8,0"
                                                        Command="{Binding ClearRatingCommand}" IsVisible="{Binding IsRated}" AutomationProperties.Name="{loc:T Mobile.ClearRating}">
                                                    <PathIcon Data="{DynamicResource PhClose}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>
                                                <Border Grid.Column="1" Grid.ColumnSpan="2" Classes="np-line" />
                                            </Grid>
                                            <Button Name="MenuDownload" Classes="row np-row" Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhDownload}" />
                                                    <TextBlock Grid.Column="1" Classes="np-label" Text="{Binding DownloadLabel}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Classes="np-line" />
                                                </Grid>
                                            </Button>
                                            <Button Name="MenuRemoveDownload" Classes="row np-row" Command="{Binding RemoveDownloadCommand}" IsVisible="{Binding CanRemoveDownload}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhTrash}" />
                                                    <TextBlock Grid.Column="1" Classes="np-label" Text="{Binding RemoveDownloadLabel}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Classes="np-line" />
                                                </Grid>
                                            </Button>
                                            <Button Name="MenuPin" Classes="row np-row" Command="{Binding TogglePinCommand}" IsVisible="{Binding CanPin}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhPin}" />
                                                    <TextBlock Grid.Column="1" Classes="np-label" Text="{Binding PinLabel}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Classes="np-line" />
                                                </Grid>
                                            </Button>
                                            <!-- The desktop's Snooze for a Month (MenuLineSnooze); Unsnooze on a snoozed song. -->
                                            <Button Name="MenuSnooze" Classes="row np-row" Command="{Binding ToggleSnoozeCommand}" IsVisible="{Binding CanSnooze}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhSnooze}" />
                                                    <TextBlock Grid.Column="1" Classes="np-label" Text="{Binding SnoozeLabel}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Classes="np-line" />
                                                </Grid>
                                            </Button>
                                            <!-- Out of the library, back from Settings › Hidden (the desktop's Hide Folder eye, MenuLineEyeOff). -->
                                            <Button Name="MenuHide" Classes="row np-row" Command="{Binding HideCommand}" IsVisible="{Binding CanHide}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhHide}" />
                                                    <TextBlock Grid.Column="1" Classes="np-label" Text="{loc:T Mobile.HideSong}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Classes="np-line" />
                                                </Grid>
                                            </Button>
                                            <Button Name="MenuGoToAlbum" Classes="row np-row" Command="{Binding GoToAlbumCommand}" IsVisible="{Binding CanGoToAlbum}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhAlbum}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,9,16,9">
                                                        <TextBlock Classes="np-label" Text="{loc:T Mobile.GoToAlbum}" />
                                                        <TextBlock Classes="np-detail" Text="{Binding Track.Album}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Classes="np-line" />
                                                </Grid>
                                            </Button>
                                            <Button Name="MenuGoToArtist" Classes="row np-row" Command="{Binding GoToArtistCommand}" IsVisible="{Binding CanGoToArtist}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhArtist}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,9,16,9">
                                                        <TextBlock Classes="np-label" Text="{loc:T Mobile.GoToArtist}" />
                                                        <TextBlock Classes="np-detail" Text="{Binding ArtistLine}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Classes="np-line" />
                                                </Grid>
                                            </Button>
                                            <Button Name="MenuLyrics" Classes="row np-row" Command="{Binding ShowLyricsCommand}" IsVisible="{Binding CanShowLyrics}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhLyrics}" />
                                                    <TextBlock Grid.Column="1" Classes="np-label" Text="{loc:T Tab.Lyrics}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Classes="np-line" />
                                                </Grid>
                                            </Button>
                                            <!-- The playing song's menu: the sleep timer's choices (the desktop's clock glyph, MenuLineTimer). -->
                                            <Button Name="MenuSleepTimer" Classes="row np-row" Command="{Binding ShowSleepTimerCommand}" IsVisible="{Binding CanSleepTimer}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhTimer}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,9,16,9">
                                                        <TextBlock Classes="np-label" Text="{loc:T Mobile.SleepTimer}" />
                                                        <TextBlock Classes="np-detail" Text="{Binding SleepTimerDetail}" IsVisible="{Binding HasSleepTimerDetail}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Classes="np-line" />
                                                </Grid>
                                            </Button>
                                            <!-- A playlist's own edits, the desktop's glyphs (MenuLineEdit, MenuLineTrash,
                                                 MenuLinePlaylistRemove); the destructive rows last, in red, as the
                                                 desktop's v2 menus and Apple's. -->
                                            <Button Name="MenuRename" Classes="row np-row" Command="{Binding RenamePlaylistCommand}" IsVisible="{Binding CanEditPlaylist}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhEdit}" />
                                                    <TextBlock Grid.Column="1" Classes="np-label" Text="{loc:T Mobile.Rename}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Classes="np-line" />
                                                </Grid>
                                            </Button>
                                            <!-- Change Cover: a picture from the phone (the desktop's Change cover); Remove
                                                 Cover while it has one, back to the first song's. -->
                                            <Button Name="MenuChangeCover" Classes="row np-row" Command="{Binding ChangeCoverCommand}" IsVisible="{Binding CanChangeCover}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhAlbum}" />
                                                    <TextBlock Grid.Column="1" Classes="np-label" Text="{loc:T Mobile.ChangeCover}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Classes="np-line" />
                                                </Grid>
                                            </Button>
                                            <Button Name="MenuRemoveCover" Classes="row np-row" Command="{Binding RemoveCoverCommand}" IsVisible="{Binding CanRemoveCover}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhClose}" />
                                                    <TextBlock Grid.Column="1" Classes="np-label" Text="{loc:T Mobile.RemoveCover}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Classes="np-line" />
                                                </Grid>
                                            </Button>
                                            <Button Name="MenuRemoveFromPlaylist" Classes="row np-row np-danger" Command="{Binding RemoveFromPlaylistCommand}"
                                                    IsVisible="{Binding CanRemoveFromPlaylist}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhPlaylistRemove}" />
                                                    <TextBlock Grid.Column="1" Classes="np-label" Text="{loc:T Mobile.RemoveFromPlaylist}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Classes="np-line" />
                                                </Grid>
                                            </Button>
                                            <Button Name="MenuDeletePlaylist" Classes="row np-row np-danger" Command="{Binding DeletePlaylistCommand}"
                                                    IsVisible="{Binding CanEditPlaylist}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhTrash}" />
                                                    <TextBlock Grid.Column="1" Classes="np-label" Text="{loc:T Mobile.DeletePlaylist}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Classes="np-line" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>

                                    <!-- The Library tab's ⋯: the desktop's three library actions. -->
                                    <DataTemplate DataType="vm:LibraryMenuViewModel">
                                        <StackPanel Name="LibraryRows" Margin="0,6,0,6">
                                            <Button Name="MenuAddFolder" Classes="row np-row" Command="{Binding AddFolderCommand}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhFolder}" />
                                                    <TextBlock Grid.Column="1" Classes="np-label" Text="{loc:T Mobile.AddFolderMenu}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                            <Button Name="MenuRescan" Classes="row np-row" Command="{Binding RescanCommand}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhRescan}" />
                                                    <TextBlock Grid.Column="1" Classes="np-label" Text="{loc:T Mobile.RescanLibrary}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Classes="np-line" />
                                                </Grid>
                                            </Button>
                                            <Button Name="MenuSettings" Classes="row np-row" Command="{Binding OpenSettingsCommand}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhSettings}" />
                                                    <TextBlock Grid.Column="1" Classes="np-label" Text="{loc:T Nav.Settings}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Classes="np-line" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                    <!-- Now Playing's artist line (Apple's bubble): the ⋯ menu's two
                                         rows, out of the artist, nothing else (no hairline, as Apple's). -->
                                    <DataTemplate DataType="vm:TrackLinksMenuViewModel">
                                        <StackPanel Name="LinkRows" Margin="0,6,0,6">
                                            <Button Name="LinkGoToAlbum" Classes="row np-row" Command="{Binding GoToAlbumCommand}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhAlbum}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,9,16,9">
                                                        <TextBlock Classes="np-label" Text="{loc:T Mobile.GoToAlbum}" />
                                                        <TextBlock Classes="np-detail" Text="{Binding AlbumLine}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                            <Button Name="LinkGoToArtist" Classes="row np-row" Command="{Binding GoToArtistCommand}">
                                                <Grid ColumnDefinitions="56,*">
                                                    <PathIcon Data="{DynamicResource PhArtist}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,9,16,9">
                                                        <TextBlock Classes="np-label" Text="{loc:T Mobile.GoToArtist}" />
                                                        <TextBlock Classes="np-detail" Text="{Binding ArtistLine}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                    <!-- Now Playing's quality badge: what the playing file is - its class
                                         under the desktop's waveform (every class, as the badge), the
                                         technical line, one plain line on what it means, then OK on its own
                                         row. Compact (owner 10-18): a small note, not a dialog. Centred
                                         over the badge (the code-behind), growing out of it. -->
                                    <DataTemplate DataType="vm:QualityCardViewModel">
                                        <StackPanel Name="QualityRows" Margin="0,2,0,2">
                                            <StackPanel Name="QualityNote" Margin="16,12,16,10" Spacing="2">
                                                <Viewbox Name="QualityGlyph" Width="32" Height="18" Margin="0,0,0,6"
                                                         HorizontalAlignment="Center">
                                                    <Path Data="{DynamicResource PhLossless}" Fill="{DynamicResource MenuGlassText}" />
                                                </Viewbox>
                                                <TextBlock Name="QualityLabel" Text="{Binding Label}" FontSize="17" FontWeight="SemiBold"
                                                           TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MenuGlassText}" />
                                                <TextBlock Name="QualityDetail" Text="{Binding Detail}" FontSize="13" TextAlignment="Center"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource MenuGlassSecondaryText}"
                                                           IsVisible="{Binding HasDetail}" />
                                                <TextBlock Name="QualityMeaning" Classes="np-note" Text="{Binding Meaning}" TextAlignment="Center"
                                                           FontSize="13" Margin="0,6,0,0" />
                                            </StackPanel>
                                            <Button Name="QualityDone" Classes="row np-row" MinHeight="44" Command="{Binding DoneCommand}" AutomationProperties.Name="{loc:T Mobile.OK}">
                                                <Panel>
                                                    <Border Classes="np-line" Margin="16,0,16,0" />
                                                    <TextBlock Text="{loc:T Mobile.OK}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource MenuGlassText}" />
                                                </Panel>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                    <!-- A sort or filter menu (Apple's: the choice in use ticked, a band
                                         between groups), or a note with no choices (an album's quality). -->
                                    <DataTemplate DataType="vm:OptionsMenuViewModel">
                                        <StackPanel Name="OptionRows" Margin="0,6,0,6">
                                            <StackPanel Name="OptionNote" IsVisible="{Binding HasTitle}" Margin="20,10,20,10" Spacing="4">
                                                <TextBlock Classes="np-label" Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Classes="np-detail" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                                                <TextBlock Classes="np-note" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
                                            </StackPanel>
                                            <ItemsControl Name="OptionItems" ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:OptionsMenuItem">
                                                        <StackPanel>
                                                            <Border Classes="np-gap" IsVisible="{Binding StartsGroup}" />
                                                            <Button Classes="row np-row np-option" Command="{Binding PickCommand}"
                                                                    AutomationProperties.Name="{Binding AccessibleName}">
                                                                <Grid ColumnDefinitions="48,*">
                                                                    <PathIcon Data="{DynamicResource PhCheck}" IsVisible="{Binding IsChecked}" />
                                                                    <TextBlock Grid.Column="1" Classes="np-label" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                                                    <Border Grid.Column="1" Classes="np-line" IsVisible="{Binding HasLine}" />
                                                                </Grid>
                                                            </Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ContentControl.DataTemplates>
                            </ContentControl>
                        </ScrollViewer>
                    </Panel>
                </views:MenuGlass>
            </Panel>
        </ThemeVariantScope>
    </Panel>
</UserControl>
