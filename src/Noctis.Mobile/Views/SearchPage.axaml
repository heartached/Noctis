<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:views="using:Noctis.Mobile.Views"
             xmlns:models="using:Noctis.Models"
             xmlns:controls="using:Noctis.Controls"
             x:Class="Noctis.Mobile.Views.SearchPage"
             x:DataType="vm:SearchPageViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- The title, with the sort menu in the header's glass pill (as Library's tools are), so
             the chip row below has the full width to scroll in. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Classes="tab-header">
            <views:FitWidth Name="SearchTitleFit" VerticalAlignment="Center">
                <TextBlock Name="SearchTitle" Classes="title" Text="{loc:T Mobile.Search}" TextTrimming="CharacterEllipsis" />
            </views:FitWidth>
            <controls:GlassPanel Grid.Column="1" Name="SortGlass" Classes="header-glass" IsVisible="{Binding HasQuery}">
                <Button Name="SortButton" Classes="glass-round" Classes.on="{Binding IsSorted}" Command="{Binding ShowSortMenuCommand}">
                    <PathIcon Data="{DynamicResource PhSort}" />
                </Button>
            </controls:GlassPanel>
            <views:ProfileButton Grid.Column="2" Name="SearchProfile" Margin="10,0,0,0" VerticalAlignment="Center"
                                 AvatarPath="{Binding Shell.ProfileAvatarPath}" Command="{Binding Shell.OpenSettingsCommand}" />
        </Grid>
        <!-- Apple's search field: a filled capsule with the magnifier, no border (MobileStyles). -->
        <TextBox Grid.Row="1" Name="SearchBox" Classes="search-field" Margin="16,0,16,12" Text="{Binding Query}"
                 PlaceholderText="{loc:T Mobile.Search.Placeholder}" />

        <!-- A chip per kind of result, with its icon, right under the box. -->
        <ScrollViewer Grid.Row="2" Name="ScopeBar" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      Margin="0,0,0,6" IsVisible="{Binding HasQuery}">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0">
                <Button Name="ScopeAll" Classes="text-chip" Classes.selected="{Binding IsAllScope}"
                        Command="{Binding SetScopeCommand}" CommandParameter="{x:Static vm:SearchScope.All}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{DynamicResource ChipAllMusicIcon}" Width="17" Height="17" />
                        <TextBlock Text="{loc:T Mobile.Search.All}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Name="ScopeSongs" Classes="text-chip" Classes.selected="{Binding IsSongsScope}"
                        Command="{Binding SetScopeCommand}" CommandParameter="{x:Static vm:SearchScope.Songs}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{DynamicResource ChipSongsIcon}" Width="17" Height="17" />
                        <TextBlock Text="{loc:T Nav.Songs}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Name="ScopeAlbums" Classes="text-chip" Classes.selected="{Binding IsAlbumsScope}"
                        Command="{Binding SetScopeCommand}" CommandParameter="{x:Static vm:SearchScope.Albums}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{DynamicResource ChipAlbumsIcon}" Width="17" Height="17" />
                        <TextBlock Text="{loc:T Nav.Albums}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Name="ScopeArtists" Classes="text-chip" Classes.selected="{Binding IsArtistsScope}"
                        Command="{Binding SetScopeCommand}" CommandParameter="{x:Static vm:SearchScope.Artists}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{DynamicResource ChipArtistsIcon}" Width="17" Height="17" />
                        <TextBlock Text="{loc:T Nav.Artists}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Name="ScopePlaylists" Classes="text-chip" Classes.selected="{Binding IsPlaylistsScope}"
                        Command="{Binding SetScopeCommand}" CommandParameter="{x:Static vm:SearchScope.Playlists}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{DynamicResource ChipPlaylistsIcon}" Width="17" Height="17" />
                        <TextBlock Text="{loc:T Nav.Playlists}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Name="SearchPrompt" Classes="subtle" Text="{loc:T Mobile.Search.Hint}" HorizontalAlignment="Center"
                   Margin="0,40,0,0" IsVisible="{Binding ShowPrompt}" />
        <TextBlock Grid.Row="3" Name="NoResults" Classes="subtle" Text="{loc:T Mobile.Search.NoResults}" HorizontalAlignment="Center"
                   Margin="0,40,0,0" IsVisible="{Binding ShowNoResults}" />

        <ScrollViewer Classes="page-scroll" Grid.Row="3" Name="ResultsScroll" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasQuery}">
            <StackPanel Margin="12,0,12,24" Spacing="14">
                <!-- The artist the query names: their photo, Play and Shuffle, and their most played songs. -->
                <Border Name="FeaturedCard" Classes="card" CornerRadius="18" Padding="12" IsVisible="{Binding HasFeatured}"
                        Background="{DynamicResource PhoneGroupedBackgroundBrush}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Classes="row" Name="FeaturedArtistButton" Grid.ColumnSpan="2"
                                    Command="{Binding OpenArtistCommand}" CommandParameter="{Binding Featured}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Classes="art" Width="64" Height="64" CornerRadius="32">
                                        <Panel>
                                            <PathIcon Data="{DynamicResource ArtistsIcon}" Width="24" Height="24" Opacity="0.5" />
                                            <controls:CachedImage SourcePath="{Binding Featured.ArtworkPath}" DecodeWidth="256" PixelExact="True" Stretch="UniformToFill" />
                                        </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Classes="row-title" FontSize="18" FontWeight="Bold" Text="{Binding Featured.Name}" />
                                        <TextBlock Classes="row-sub" Text="{loc:T Mobile.Artist}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Name="FeaturedShuffle" Classes="icon" Command="{Binding ShuffleFeaturedCommand}">
                                    <PathIcon Data="{DynamicResource PhShuffle}" />
                                </Button>
                                <Button Name="FeaturedPlay" Classes="pill-accent" Padding="14,0" Command="{Binding PlayFeaturedCommand}">
                                    <PathIcon Data="{DynamicResource PhPlayFill}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <views:RowItemsControl Name="FeaturedSongResults" ItemsSource="{Binding FeaturedSongs}" Margin="-8,0">
                            <views:RowItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </views:RowItemsControl.ItemsPanel>
                            <views:RowItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Track">
                                    <Button Classes="row"
                                            Command="{Binding $parent[views:SearchPage].((vm:SearchPageViewModel)DataContext).PlayFeaturedSongCommand}"
                                            CommandParameter="{Binding}"
                                            views:LongPress.Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenTrackSheetCommand}">
                                        <views:SongRow MenuCommand="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenTrackSheetCommand}" />
                                    </Button>
                                </DataTemplate>
                            </views:RowItemsControl.ItemTemplate>
                        </views:RowItemsControl>
                    </StackPanel>
                </Border>

                <!-- Songs first: a search is usually for a song. The result lists are RowItemsControls
                     on a VirtualizingStackPanel: a keystroke that changes the results rebinds the
                     rows already built instead of building every row again (11-06: 130-440 ms of
                     layout a keystroke on the emulator). -->
                <StackPanel Spacing="4" IsVisible="{Binding HasSongs}">
                    <Button Classes="row" Name="SongsHeader" Command="{Binding SetScopeCommand}" CommandParameter="{x:Static vm:SearchScope.Songs}"
                            IsHitTestVisible="{Binding IsAllScope}">
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0">
                            <TextBlock Classes="section" Text="{loc:T Nav.Songs}" />
                            <PathIcon Data="{DynamicResource PhChevronRight}" Width="18" Height="18" Opacity="0.6" IsVisible="{Binding IsAllScope}" />
                        </StackPanel>
                    </Button>
                    <views:RowItemsControl Name="SongResults" ItemsSource="{Binding Songs}">
                        <views:RowItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </views:RowItemsControl.ItemsPanel>
                        <views:RowItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Track">
                                <Button Classes="row"
                                        Command="{Binding $parent[views:SearchPage].((vm:SearchPageViewModel)DataContext).PlaySongCommand}"
                                        CommandParameter="{Binding}"
                                        views:LongPress.Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenTrackSheetCommand}">
                                    <views:SongRow MenuCommand="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenTrackSheetCommand}" />
                                </Button>
                            </DataTemplate>
                        </views:RowItemsControl.ItemTemplate>
                    </views:RowItemsControl>
                </StackPanel>

                <StackPanel Spacing="8" IsVisible="{Binding HasAlbums}">
                    <Button Classes="row" Name="AlbumsHeader" Command="{Binding SetScopeCommand}" CommandParameter="{x:Static vm:SearchScope.Albums}"
                            IsHitTestVisible="{Binding IsAllScope}">
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0">
                            <TextBlock Classes="section" Text="{loc:T Nav.Albums}" />
                            <PathIcon Data="{DynamicResource PhChevronRight}" Width="18" Height="18" Opacity="0.6" IsVisible="{Binding IsAllScope}" />
                        </StackPanel>
                    </Button>
                    <!-- Virtualised sideways (the artist page's rails): every keystroke used to
                         realise all twelve tiles, each decoding its cover, for the three that fit. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding ShowAlbumRow}">
                        <views:RowItemsControl Name="AlbumResults" ItemsSource="{Binding Albums}" Margin="8,0,-4,0">
                            <views:RowItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </views:RowItemsControl.ItemsPanel>
                            <views:RowItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Album">
                                    <Button Classes="row" Width="140" Margin="0,0,12,0"
                                            Command="{Binding $parent[views:SearchPage].((vm:SearchPageViewModel)DataContext).Shell.OpenAlbumCommand}"
                                            CommandParameter="{Binding}"
                                            views:LongPress.Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenAlbumSheetCommand}">
                                        <views:AlbumTile />
                                    </Button>
                                </DataTemplate>
                            </views:RowItemsControl.ItemTemplate>
                        </views:RowItemsControl>
                    </ScrollViewer>
                    <!-- The Albums chip: every match as a two-column grid. -->
                    <ItemsControl Name="AlbumGridResults" ItemsSource="{Binding Albums}" Margin="4,0" IsVisible="{Binding ShowAlbumGrid}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Album">
                                <Button Classes="row" Margin="6,0,6,14"
                                        Command="{Binding $parent[views:SearchPage].((vm:SearchPageViewModel)DataContext).Shell.OpenAlbumCommand}"
                                        CommandParameter="{Binding}"
                                        views:LongPress.Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenAlbumSheetCommand}">
                                    <views:AlbumTile />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding HasArtists}">
                    <Button Classes="row" Name="ArtistsHeader" Command="{Binding SetScopeCommand}" CommandParameter="{x:Static vm:SearchScope.Artists}"
                            IsHitTestVisible="{Binding IsAllScope}">
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0">
                            <TextBlock Classes="section" Text="{loc:T Nav.Artists}" />
                            <PathIcon Data="{DynamicResource PhChevronRight}" Width="18" Height="18" Opacity="0.6" IsVisible="{Binding IsAllScope}" />
                        </StackPanel>
                    </Button>
                    <views:RowItemsControl Name="ArtistResults" ItemsSource="{Binding Artists}">
                        <views:RowItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </views:RowItemsControl.ItemsPanel>
                        <views:RowItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ArtistListItem">
                                <Button Classes="row"
                                        Command="{Binding $parent[views:SearchPage].((vm:SearchPageViewModel)DataContext).OpenArtistCommand}"
                                        CommandParameter="{Binding}"
                                        views:LongPress.Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenArtistSheetCommand}">
                                    <Grid ColumnDefinitions="Auto,*" Height="60" Margin="8,0">
                                        <Border Classes="art" Width="44" Height="44" CornerRadius="22">
                                            <Panel>
                                                <PathIcon Data="{DynamicResource ArtistsIcon}" Width="18" Height="18" Opacity="0.5" />
                                                <controls:CachedImage SourcePath="{Binding ArtworkPath}" DecodeWidth="128" Stretch="UniformToFill" />
                                            </Panel>
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="row-title" Margin="12,0,8,0" VerticalAlignment="Center" Text="{Binding Name}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </views:RowItemsControl.ItemTemplate>
                    </views:RowItemsControl>
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding HasPlaylists}">
                    <Button Classes="row" Name="PlaylistsHeader" Command="{Binding SetScopeCommand}" CommandParameter="{x:Static vm:SearchScope.Playlists}"
                            IsHitTestVisible="{Binding IsAllScope}">
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0">
                            <TextBlock Classes="section" Text="{loc:T Nav.Playlists}" />
                            <PathIcon Data="{DynamicResource PhChevronRight}" Width="18" Height="18" Opacity="0.6" IsVisible="{Binding IsAllScope}" />
                        </StackPanel>
                    </Button>
                    <views:RowItemsControl Name="PlaylistResults" ItemsSource="{Binding Playlists}">
                        <views:RowItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </views:RowItemsControl.ItemsPanel>
                        <views:RowItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlaylistResult">
                                <Button Classes="row"
                                        Command="{Binding $parent[views:SearchPage].((vm:SearchPageViewModel)DataContext).Shell.OpenPlaylistCommand}"
                                        CommandParameter="{Binding Playlist}"
                                        views:LongPress.Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenPlaylistSheetCommand}"
                                        views:LongPress.CommandParameter="{Binding Playlist}">
                                    <Grid ColumnDefinitions="Auto,*" Height="60" Margin="8,0">
                                        <Border Classes="art" Width="44" Height="44">
                                            <Panel>
                                                <PathIcon Data="{DynamicResource ChipPlaylistsIcon}" Width="18" Height="18" Opacity="0.5" />
                                                <controls:CachedImage SourcePath="{Binding ArtworkPath}" DecodeWidth="128" Stretch="UniformToFill" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Classes="row-title" Text="{Binding Name}" />
                                            <TextBlock Classes="row-sub" Text="{Binding Subtitle}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </views:RowItemsControl.ItemTemplate>
                    </views:RowItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
