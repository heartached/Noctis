<controls:GlassPanel xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
                     xmlns:vm="using:Noctis.Mobile.ViewModels"
                     xmlns:controls="using:Noctis.Controls"
                     x:Class="Noctis.Mobile.Views.PlaylistTools"
                     x:DataType="vm:PlaylistListPageViewModel"
                     Classes="header-glass" Width="NaN">
    <!-- The playlist list's tools, in the same glass pill as a song list's (ListTools): sort (lit
         while it changes the order) and New Playlist. The search is the page's own field
         (FindField), as on Artists, Albums and Songs. -->
    <StackPanel Orientation="Horizontal" Margin="4,0">
        <Button Name="PlaylistSortButton" Classes="glass-round" Classes.on="{Binding IsSorted}" Command="{Binding ShowSortMenuCommand}"
                IsVisible="{Binding HasPlaylists}"
                AutomationProperties.Name="{loc:T Mobile.Playlists.SortName}">
            <PathIcon Data="{DynamicResource PhSort}" />
        </Button>
        <!-- New Playlist: a name, then the empty playlist joins the list (a song's ⋯ › Add to
             Playlist makes one too, with that song). -->
        <Button Name="NewPlaylistButton" Classes="glass-round" Command="{Binding Shell.AskNewPlaylistCommand}"
                AutomationProperties.Name="{loc:T Mobile.Playlists.New}">
            <PathIcon Data="{DynamicResource PhPlus}" />
        </Button>
        <!-- The list's ⋯ (Import Playlist), there with no playlists yet too: an Android-only
             listener's way to bring playlists in. -->
        <Button Name="PlaylistsMoreButton" Classes="glass-round" Command="{Binding Shell.ShowPlaylistsMenuCommand}"
                IsVisible="{Binding Shell.CanImportPlaylists}" AutomationProperties.Name="{loc:T Mobile.More}">
            <PathIcon Data="{DynamicResource PhMore}" />
        </Button>
    </StackPanel>
</controls:GlassPanel>
