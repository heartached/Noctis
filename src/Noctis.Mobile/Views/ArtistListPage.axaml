<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:views="using:Noctis.Mobile.Views"
             xmlns:controls="using:Noctis.Controls"
             xmlns:loc="using:Noctis.Localization"
             x:Class="Noctis.Mobile.Views.ArtistListPage"
             x:DataType="vm:ArtistListPageViewModel">

    <UserControl.Styles>
        <!-- One artist: a circle (the cover, else initials on a soft tint) and the name. -->
        <Style Selector="Border.avatar">
            <Setter Property="Width" Value="104" />
            <Setter Property="Height" Value="104" />
            <Setter Property="CornerRadius" Value="52" />
            <Setter Property="ClipToBounds" Value="True" />
            <!-- A hairline edge, so a white cover still reads as a circle on the light page. -->
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="BorderBrush" Value="#2E808080" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.initials">
            <Setter Property="FontSize" Value="36" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.artist-name">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="Margin" Value="4,8,4,0" />
        </Style>

        <!-- The A–Z strip: small accent letters down the right edge. -->
        <Style Selector="TextBlock.index-letter">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="14" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextExactBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- The shared header (PageHeader): "‹ Library" over the large title. -->
        <views:PageHeader Grid.Row="0" Name="Header" />

        <!-- "Find in Artists": the list pages' shared field (FindField), as on Albums and Songs. -->
        <views:FindField Grid.Row="1" Name="FindField" Text="{Binding Query}" Placeholder="{loc:T Mobile.Artists.Find}"
                         IsVisible="{Binding HasArtists}" />

        <TextBlock Grid.Row="2" Name="NoArtistsText" Classes="subtle" Text="{loc:T Mobile.Artists.None}" HorizontalAlignment="Center"
                   Margin="0,40,0,0" IsVisible="{Binding !HasArtists}" />
        <TextBlock Grid.Row="2" Name="NoResultsText" Classes="subtle" Text="{loc:T Mobile.Artists.NoMatch}" HorizontalAlignment="Center"
                   Margin="0,40,0,0" IsVisible="{Binding ShowNoResults}" />

        <!-- Rows of three, virtualised; each row is ArtistListPageViewModel.RowHeight tall so a
             letter's row sits at row × height. Right margin leaves the strip its lane. -->
        <ScrollViewer Grid.Row="2" Classes="page-scroll" Name="ArtistScroll" views:ScrollMemory.IsEnabled="True"
                      HorizontalScrollBarVisibility="Disabled">
            <views:RowItemsControl Name="ArtistGrid" ItemsSource="{Binding Rows}" Margin="10,4,26,16">
                <views:RowItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </views:RowItemsControl.ItemsPanel>
                <views:RowItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ArtistGridRow">
                        <!-- Circles built once per row and handed the next artist (SlotRow). -->
                        <views:SlotRow Items="{Binding Artists}" Height="{x:Static vm:ArtistListPageViewModel.RowHeight}"
                                       Columns="{x:Static vm:ArtistListPageViewModel.Columns}">
                            <views:SlotRow.ItemTemplate>
                                <DataTemplate x:DataType="vm:ArtistListItem">
                                    <Button Classes="row" VerticalAlignment="Top"
                                            views:LongPress.Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenArtistSheetCommand}"
                                            Command="{Binding $parent[views:ArtistListPage].((vm:ArtistListPageViewModel)DataContext).OpenCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <Border Classes="avatar" Background="{Binding PlaceholderBrush}">
                                                <Panel>
                                                    <TextBlock Classes="initials" Text="{Binding Initials}" />
                                                    <controls:CachedImage SourcePath="{Binding ArtworkPath}" DecodeWidth="288" Stretch="UniformToFill" />
                                                </Panel>
                                            </Border>
                                            <TextBlock Classes="artist-name" Text="{Binding Name}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </views:SlotRow.ItemTemplate>
                        </views:SlotRow>
                    </DataTemplate>
                </views:RowItemsControl.ItemTemplate>
            </views:RowItemsControl>
        </ScrollViewer>

        <!-- The A–Z strip, centred in the part of the page the floating bar does not cover.
             A press or a slide along it jumps the grid (code-behind). -->
        <Panel Grid.Row="2" Margin="{DynamicResource ShellBottomInset}" HorizontalAlignment="Right" IsVisible="{Binding ShowIndex}">
            <Border Name="IndexStrip" Width="26" Background="Transparent" VerticalAlignment="Center" Padding="0,4"
                    PointerPressed="OnIndexPressed" PointerMoved="OnIndexMoved"
                    PointerReleased="OnIndexReleased" PointerCaptureLost="OnIndexCaptureLost">
                <ItemsControl Name="IndexLetters" ItemsSource="{Binding IndexLetters}" IsHitTestVisible="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Classes="index-letter" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Panel>
    </Grid>
</UserControl>
