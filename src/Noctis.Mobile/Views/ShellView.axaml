<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:views="using:Noctis.Mobile.Views"
             xmlns:controls="using:Noctis.Controls"
             xmlns:loc="using:Noctis.Localization"
             x:Class="Noctis.Mobile.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="{DynamicResource AppWindowBackgroundBrush}">

    <UserControl.Styles>
        <StyleInclude Source="avares://Noctis.Mobile/Views/MobileStyles.axaml" />
    </UserControl.Styles>

    <!-- One template per page view model: PageHost (and the Playlists/Favorites tab roots)
         resolve the page's view here. -->
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:SongListPageViewModel">
            <views:SongListPage />
        </DataTemplate>
        <DataTemplate DataType="vm:AlbumGridPageViewModel">
            <views:AlbumGridPage />
        </DataTemplate>
        <DataTemplate DataType="vm:ArtistListPageViewModel">
            <views:ArtistListPage />
        </DataTemplate>
        <DataTemplate DataType="vm:PlaylistListPageViewModel">
            <views:PlaylistListPage />
        </DataTemplate>
        <DataTemplate DataType="vm:AlbumPageViewModel">
            <views:AlbumPage />
        </DataTemplate>
        <DataTemplate DataType="vm:ArtistPageViewModel">
            <views:ArtistPage />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsPageViewModel">
            <views:SettingsPage />
        </DataTemplate>
        <DataTemplate DataType="vm:RailGridPageViewModel">
            <views:RailGridPage />
        </DataTemplate>
        <DataTemplate DataType="vm:AccountPageViewModel">
            <views:AccountPage />
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Noctis.Mobile/Views/TabIcons.axaml" />
                <ResourceInclude Source="avares://Noctis.Mobile/Views/LibraryIcons.axaml" />
                <ResourceInclude Source="avares://Noctis.Mobile/Views/PhoneIcons.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Liquid Glass bar surfaces: the tint over the frost (its opacity is the tint
                     strength), the selected tab's pill, the light rim along the edge, the sheen
                     on the upper half, and the scrim content fades into behind the bar. -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="GlassBarTint" Color="#1C1C1F" Opacity="0.55" />
                    <SolidColorBrush x:Key="GlassBarPill" Color="#FFFFFF" Opacity="0.12" />
                    <LinearGradientBrush x:Key="GlassBarEdge" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#70FFFFFF" />
                        <GradientStop Offset="0.45" Color="#1AFFFFFF" />
                        <GradientStop Offset="1" Color="#30FFFFFF" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GlassBarSheen" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#1FFFFFFF" />
                        <GradientStop Offset="0.5" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GlassBarScrim" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="1" Color="#70000000" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="GlassBarTint" Color="#F7F7FA" Opacity="0.5" />
                    <SolidColorBrush x:Key="GlassBarPill" Color="#000000" Opacity="0.07" />
                    <LinearGradientBrush x:Key="GlassBarEdge" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#FFFFFFFF" />
                        <GradientStop Offset="0.5" Color="#1A000000" />
                        <GradientStop Offset="1" Color="#38000000" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GlassBarSheen" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#66FFFFFF" />
                        <GradientStop Offset="0.5" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GlassBarScrim" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#00FFFFFF" />
                        <GradientStop Offset="1" Color="#4DFFFFFF" />
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Kept current by ShellView: how far a page's last row must scroll to clear the bar. -->
            <Thickness x:Key="ShellBottomInset">0,0,0,160</Thickness>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The tab content fills the screen and scrolls UNDER the floating glass bar (pages pad
         their lists by ShellBottomInset). The bottom chrome is laid over it; the code-behind
         lays out its parts for the expanded and folded states and animates between them.
         The overlays are declared last, in z-order: Now Playing, then Lyrics and Queue above
         it, then the long-press sheet above everything. The chrome belongs to the tab layer,
         so it is declared before the overlays — after them it would paint over the Queue
         page the moment anything other than Now Playing opens the queue. The one exception
         is the Queue sheet, which keeps the tab bar under it (the owner's mockup): the
         code-behind raises the chrome over the overlays while the Queue page is on screen. -->
    <Grid>
        <Panel Name="TabContent" Margin="{Binding TopSafePadding}">
            <views:LibraryPage DataContext="{Binding}" IsVisible="{Binding IsLibraryRootVisible}" />
            <views:SearchPage DataContext="{Binding Search}" IsVisible="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).IsSearchRootVisible}" />
            <Grid Name="PlaylistsRoot" RowDefinitions="Auto,*" IsVisible="{Binding IsPlaylistsRootVisible}">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,12,12,8">
                    <TextBlock Name="PlaylistsTitle" Classes="title" Text="{loc:T Nav.Playlists}" />
                    <Button Grid.Column="1" Classes="icon" VerticalAlignment="Top" Command="{Binding OpenSettingsCommand}">
                        <PathIcon Data="{DynamicResource PhPerson}" />
                    </Button>
                </Grid>
                <ContentControl Grid.Row="1" Name="PlaylistsHost" Content="{Binding PlaylistsRoot}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Grid>
            <Grid Name="FavoritesRoot" RowDefinitions="Auto,*" IsVisible="{Binding IsFavoritesRootVisible}">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,12,12,8">
                    <TextBlock Name="FavoritesTitle" Classes="title" Text="{loc:T Nav.Favorites}" />
                    <Button Grid.Column="1" Classes="icon" VerticalAlignment="Top" Command="{Binding OpenSettingsCommand}">
                        <PathIcon Data="{DynamicResource PhPerson}" />
                    </Button>
                </Grid>
                <ContentControl Grid.Row="1" Name="FavoritesHost" Content="{Binding FavoritesRoot}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Grid>
            <ContentControl Name="PageHost" Content="{Binding CurrentPage}" IsVisible="{Binding HasPage}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Panel>

        <!-- Content fades into the bar rather than ending in a hard line behind it. -->
        <Border Name="BottomScrim" VerticalAlignment="Bottom" Height="150" IsHitTestVisible="False"
                Background="{DynamicResource GlassBarScrim}" />
        <!-- On a cover-tinted page (album, artist) the same fade, into the page colour. -->
        <Border Name="PageScrim" VerticalAlignment="Bottom" Height="150" IsHitTestVisible="False" IsVisible="False" />

        <Panel Name="BottomChrome" VerticalAlignment="Bottom" Margin="{Binding BottomSafePadding}">
            <Panel Name="ChromeHost" Margin="14,0,14,8" VerticalAlignment="Bottom">

                <!-- The tab capsule. Expanded it spans the row and holds the four tabs; folded it
                     shrinks to a round button showing the current tab. Its content clips to it
                     (the full-width tab row while folded), the glass itself does not: its shadow
                     falls outside. -->
                <controls:GlassPanel Name="TabCapsule" Classes="liquid" CornerRadius="32"
                                     HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <Panel ClipToBounds="True">
                        <Border Name="TabSheen" Background="{DynamicResource GlassBarSheen}" CornerRadius="32" IsHitTestVisible="False" />
                        <Panel Name="TabRow" HorizontalAlignment="Left">
                            <!-- The selected tab's glass droplet: the host slides between tabs, the
                                 droplet lifts while it travels (ShellView.LiftSelectionPill). -->
                            <Panel Name="SelectionPillHost" HorizontalAlignment="Left" Margin="0,5" IsHitTestVisible="False">
                                <views:GlassDroplet Name="SelectionPill" Background="{DynamicResource GlassBarPill}" CornerRadius="27"
                                                    UseAppGlass="False" IsGlassActive="True" BlurRadius="0" EdgeThickness="0" />
                            </Panel>
                            <Grid Name="TabBar" ColumnDefinitions="*,*,*,*">
                                <Button Grid.Column="0" Name="LibraryTab" Classes="tab" Classes.selected="{Binding IsLibrarySelected}"
                                        Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:MobileTab.Library}">
                                    <StackPanel Spacing="3">
                                        <Panel>
                                            <PathIcon Classes="off" Data="{DynamicResource TabLibraryIcon}" />
                                            <PathIcon Classes="on" Data="{DynamicResource TabLibraryFilledIcon}" />
                                        </Panel>
                                        <TextBlock Text="{loc:T Tab.Library}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Name="FavoritesTab" Classes="tab" Classes.selected="{Binding IsFavoritesSelected}"
                                        Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:MobileTab.Favorites}">
                                    <StackPanel Spacing="3">
                                        <Panel>
                                            <PathIcon Classes="off" Data="{DynamicResource TabFavoritesIcon}" />
                                            <PathIcon Classes="on" Data="{DynamicResource TabFavoritesFilledIcon}" />
                                        </Panel>
                                        <TextBlock Text="{loc:T Nav.Favorites}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Name="PlaylistsTab" Classes="tab" Classes.selected="{Binding IsPlaylistsSelected}"
                                        Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:MobileTab.Playlists}">
                                    <StackPanel Spacing="3">
                                        <Panel>
                                            <PathIcon Classes="off" Data="{DynamicResource TabPlaylistsIcon}" />
                                            <PathIcon Classes="on" Data="{DynamicResource TabPlaylistsFilledIcon}" />
                                        </Panel>
                                        <TextBlock Text="{loc:T Nav.Playlists}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Name="SearchTab" Classes="tab" Classes.selected="{Binding IsSearchSelected}"
                                        Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:MobileTab.Search}">
                                    <StackPanel Spacing="3">
                                        <Panel>
                                            <PathIcon Classes="off" Data="{DynamicResource TabSearchIcon}" />
                                            <PathIcon Classes="on" Data="{DynamicResource TabSearchFilledIcon}" />
                                        </Panel>
                                        <TextBlock Text="Search" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Panel>

                        <!-- Folded: the current tab's icon; a tap unfolds the bar. -->
                        <Button Name="CollapsedTabButton" Classes="tab selected" HorizontalAlignment="Left"
                                Command="{Binding ExpandTabBarCommand}">
                            <Panel>
                                <PathIcon Data="{DynamicResource TabLibraryFilledIcon}" IsVisible="{Binding IsLibrarySelected}" />
                                <PathIcon Data="{DynamicResource TabFavoritesFilledIcon}" IsVisible="{Binding IsFavoritesSelected}" />
                                <PathIcon Data="{DynamicResource TabPlaylistsFilledIcon}" IsVisible="{Binding IsPlaylistsSelected}" />
                                <PathIcon Data="{DynamicResource TabSearchFilledIcon}" IsVisible="{Binding IsSearchSelected}" />
                            </Panel>
                        </Button>
                    </Panel>
                </controls:GlassPanel>

                <!-- Folded only: the round Search button at the right end of the row. -->
                <controls:GlassPanel Name="SearchBubble" Classes="liquid bubble" CornerRadius="30"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Fade="0">
                    <!-- Fade covers only the glass itself; the sheen and button fade with this panel. -->
                    <Panel Name="SearchBubbleContent" Opacity="0">
                        <Border Background="{DynamicResource GlassBarSheen}" CornerRadius="30" IsHitTestVisible="False" />
                        <Button Name="MiniSearchButton" Classes="tab selected"
                                Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:MobileTab.Search}">
                            <PathIcon Data="{DynamicResource TabSearchFilledIcon}" />
                        </Button>
                    </Panel>
                </controls:GlassPanel>

                <!-- The mini player: its own capsule above the tabs, or inline between the two
                     round buttons when the bar is folded. -->
                <controls:GlassPanel Name="MiniBar" Classes="liquid" CornerRadius="30" VerticalAlignment="Bottom"
                                     IsVisible="{Binding IsMiniBarVisible}">
                    <Panel>
                        <Border Background="{DynamicResource GlassBarSheen}" CornerRadius="30" IsHitTestVisible="False" />
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="13,0,6,0">
                            <!-- Stretch both ways: Fluent sets Left/Center, which shrank the tap target
                                 to the title text on device (MiniBar_TitleButton_FillsTheWholeRow). -->
                            <Button Grid.Column="0" Classes="row" VerticalAlignment="Stretch"
                                    Command="{Binding OpenNowPlayingCommand}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Classes="art" Name="MiniArt" Width="38" Height="38" CornerRadius="8">
                                        <Panel>
                                            <PathIcon Data="{DynamicResource SongsIcon}" Width="16" Height="16" Opacity="0.5" />
                                            <controls:CachedImage Name="MiniArtwork" SourcePath="{Binding Player.CurrentTrack.AlbumArtworkPath}"
                                                                  DecodeWidth="128" ClearOnSourceChange="False" Stretch="UniformToFill" />
                                        </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Player.CurrentTrack.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Player.CurrentTrack.Artist}" Classes="subtle" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Grid.Column="1" Name="MiniPlayButton" Classes="icon" Command="{Binding Player.TogglePlayPauseCommand}">
                                <Panel>
                                    <PathIcon Data="{DynamicResource PhPlayFill}" Width="30" Height="30" IsVisible="{Binding !Player.IsPlaying}" />
                                    <PathIcon Data="{DynamicResource PhPauseFill}" Width="30" Height="30" IsVisible="{Binding Player.IsPlaying}" />
                                </Panel>
                            </Button>
                            <!-- Expanded only, like Apple's: the folded row has room for Play alone. -->
                            <Button Grid.Column="2" Name="MiniNextButton" Classes="icon" Command="{Binding Player.NextCommand}">
                                <PathIcon Data="{DynamicResource PhForwardFill}" Width="30" Height="30" />
                            </Button>
                        </Grid>
                    </Panel>
                </controls:GlassPanel>
            </Panel>
        </Panel>

        <!-- Always dark (ruling 8), whatever the app theme: the scope makes Fluent's slider
             tracks and theme-brushed icons resolve their dark resources over the dark scrim.
             It has no background, so it hit-tests only through a visible page. -->
        <ThemeVariantScope RequestedThemeVariant="Dark">
            <Panel>
                <views:NowPlayingPage Name="NowPlaying"
                                      DataContext="{Binding}"
                                      IsVisible="{Binding IsNowPlayingOpen}" />

                <views:LyricsPage DataContext="{Binding}"
                                  IsVisible="{Binding IsLyricsOpen}" />
            </Panel>
        </ThemeVariantScope>

        <!-- Outside the dark scope: the Queue sheet follows the app theme (light frosted glass
             under Light). -->
        <views:QueuePage Name="QueueSheet"
                         DataContext="{Binding}"
                         IsVisible="{Binding IsQueueOpen}" />

        <!-- Above everything, the tab bar too: ShellView raises the bar over the Queue (ZIndex 1). -->
        <views:ContextSheet Name="Sheet" DataContext="{Binding}" ZIndex="2"
                            IsVisible="{Binding IsSheetOpen}" />
    </Grid>
</UserControl>
