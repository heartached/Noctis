<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:controls="using:Noctis.Controls"
             xmlns:views="using:Noctis.Mobile.Views"
             x:Class="Noctis.Mobile.Views.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">

    <!-- Settings as Apple Music's account sheet: few things on the top level, each calm. The
         profile card with a grey note under it; the Look tiles (System / Light / Dark, each a
         live mini preview of that theme); plain rows into Music Folders, Appearance and Lyrics
         (text, a grey value, a chevron: no icons); then the actions, the only accent rows, each
         with its note. Music Folders, Appearance and Lyrics are pages pushed inside the sheet:
         they slide in from the right under a back button. Shared look: GroupedStyles.axaml. -->

    <UserControl.Resources>
        <!-- A Look tile's mini preview: a theme's grouped page with two cards on it, the first
             carrying the accent. It fills the rim's inside (56 x 38), and its padding leaves the
             two cards (13 + 4 + 11) exactly that height, so nothing is cut at the edges. -->
        <DataTemplate x:Key="LookPreviewTemplate" x:DataType="vm:LookPreview">
            <Border CornerRadius="8" Background="{Binding Page}" Padding="6,5">
                <StackPanel Spacing="4">
                    <Border Height="13" CornerRadius="4" Background="{Binding Card}">
                        <Ellipse Width="6" Height="6" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Fill="{DynamicResource AccentColorBrush}" />
                    </Border>
                    <Border Height="11" CornerRadius="4" Background="{Binding Card}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://Noctis.Mobile/Views/GroupedStyles.axaml" />

        <!-- A little more air between groups than Account's. -->
        <Style Selector="StackPanel.grouped-content">
            <Setter Property="Spacing" Value="30" />
        </Style>

        <!-- Header: no glyph, so the title starts near the cards' edge; a pushed page puts its
             back button there. The hairline under it shows once content scrolls beneath. -->
        <Style Selector="Grid.settings-header TextBlock.sheet-title">
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style Selector="Grid.settings-header.sub TextBlock.sheet-title">
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <Style Selector="Border.header-hairline">
            <Setter Property="Height" Value="0.5" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Background" Value="{DynamicResource PhoneSeparatorBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <!-- The profile card: taller, the avatar first. The inset is the grid's margin: a Button
             padding loses to MobileStyles' Button.row (Padding 0), which sat the avatar flush on
             the card's edge. No picture: initials or the person glyph on a neutral disc. -->
        <Style Selector="Grid.profile-row">
            <Setter Property="MinHeight" Value="80" />
            <Setter Property="Margin" Value="16,12" />
        </Style>
        <Style Selector="Border.avatar.neutral">
            <Setter Property="Background" Value="{DynamicResource PhoneSeparatorBrush}" />
        </Style>
        <!-- The grey line wraps rather than cut off the invitation's last words. -->
        <Style Selector="Grid.profile-row TextBlock.profile-sub">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
        <Style Selector="Border.avatar.neutral TextBlock.initials">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="Border.avatar.neutral views|GridIcon">
            <Setter Property="Foreground" Value="{DynamicResource PhoneSecondaryTextBrush}" />
        </Style>

        <!-- Plain rows (navigation, choices, toggles) have no icon: their hairline starts under
             the text, 16 dp in. -->
        <Style Selector="Border.row-separator.plain">
            <Setter Property="Margin" Value="16,0" />
        </Style>
        <Style Selector="TextBlock.row-value">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- A small grey caption over a card on a pushed page ("Dark Style"). -->
        <Style Selector="TextBlock.group-caption">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource PhoneSecondaryTextBrush}" />
            <Setter Property="Margin" Value="16,0,16,7" />
        </Style>
        <!-- The Music Folders row's mark for a folder that lost its access. -->
        <Style Selector="Ellipse.warning-dot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="#E5484D" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- The footer: the version, small and grey, centred under everything. -->
        <Style Selector="TextBlock.version-footer">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource PhoneSecondaryTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>

        <!-- Look tiles: three equal cards, each a mini preview over its name. The chosen one
             takes an accent outline and an accent name. -->
        <Style Selector="Button.look-tile">
            <Setter Property="Background" Value="{DynamicResource PhoneCardBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="0,14,0,11" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12">
                        <DoubleTransition.Easing><CubicEaseOut /></DoubleTransition.Easing>
                    </DoubleTransition>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16">
                        <TransformOperationsTransition.Easing><CubicEaseOut /></TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.look-tile:pressed">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="RenderTransform" Value="scale(0.96)" />
        </Style>
        <Style Selector="Button.look-tile.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTextExactBrush}" />
        </Style>
        <Style Selector="Button.look-tile:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.look-tile:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
            <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        </Style>
        <Style Selector="Button.look-tile TextBlock.look-name">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,9,0,0" />
        </Style>
        <Style Selector="Button.look-tile.selected TextBlock.look-name">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- The preview's thin rim, so the light one still reads on a white card. -->
        <Style Selector="Border.look-preview">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="BorderBrush" Value="{DynamicResource PhoneSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Check lists (Dark Style): Apple's rows, the chosen one with an accent checkmark.
             Fluent's ListBoxItem repaints its presenter on pointerover / pressed / selected (a
             touch), and Noctis.UI's Styles.axaml clears every ListBoxItem's selected look, so
             every state is set here. -->
        <Style Selector="ListBox.check-list, ListBox.swatches">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.check-list:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="ListBox.check-list ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.check-list ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, ListBox.check-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.check-list ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.check-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.check-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.check-list ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.check-list ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="ListBox.check-list ListBoxItem:nth-child(1) Border.row-separator">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBox.check-list views|GridIcon.check">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextExactBrush}" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ListBox.check-list ListBoxItem:selected views|GridIcon.check">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Accent swatches: nine dots, five over four centred under them, each cell a full
             touch target (a fifth of the card by 48); the chosen one gets a ring and a tick. -->
        <Style Selector="ListBox.swatches">
            <Setter Property="Margin" Value="8,10" />
        </Style>
        <Style Selector="ListBox.swatches ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Height" Value="48" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.swatches ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, ListBox.swatches ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.swatches ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.swatches ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.swatches ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.swatches ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.swatches ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.swatches Ellipse.swatch-ring, ListBox.swatches PathIcon.swatch-tick">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ListBox.swatches ListBoxItem:selected Ellipse.swatch-ring, ListBox.swatches ListBoxItem:selected PathIcon.swatch-tick">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Music Folders: a folder whose access was lost, or that the last scan could not reach, reads as a warning. -->
        <Style Selector="TextBlock.folder-lost, TextBlock.folder-unavailable">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="#E5484D" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="ItemsControl#FolderList ContentPresenter:nth-child(1) Border.row-separator">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- A folder's Remove: a red bin at the row's end, a full finger wide. -->
        <Style Selector="Button.folder-remove">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,0,-10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.folder-remove views|GridIcon">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="#E5484D" />
        </Style>
        <Style Selector="Button.folder-remove:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.folder-remove:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.folder-remove:pressed">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <!-- Removing a folder asks first (AccountPage's "are you sure?" card): the question, then its rows. -->
        <Style Selector="TextBlock.confirm-text">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="16,14,16,10" />
        </Style>
        <Style Selector="Border.confirm-separator">
            <Setter Property="Height" Value="0.5" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource PhoneSeparatorBrush}" />
        </Style>
        <Style Selector="Button.confirm-row">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="16,0" />
        </Style>
        <Style Selector="Button.confirm-row TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.confirm-row.danger TextBlock">
            <Setter Property="Foreground" Value="#E5484D" />
        </Style>

        <!-- The Windows Settings slider (SettingsView's accent-slider): an 8 dp round-ended track,
             the accent filling up to a round thumb, the rest a soft grey. A SmoothSlider, as on
             the desktop: the thumb follows the finger, the setting moves in whole steps.
             The thumb is a 44 dp touch box with the 26 dp circle centred in it (10-13): the
             circle's shadow was cut to a square at the circle's own edges (the thumb clips to
             its bounds), so the box leaves the shadow 9 dp on every side. The slider sits 7 dp
             outside the row's 16 dp inset so the circle still lines up with the text at either
             end. Each bar's outer end sits 10 dp in, as far in as its inner end tucks under the
             circle, so at the minimum the accent bar is 0 wide (at 9 dp it was 1 dp, a red sliver
             left of the circle) and at the maximum the grey one is. -->
        <Style Selector="Slider.accent-slider">
            <Setter Property="Foreground" Value="{DynamicResource AccentColorBrush}" />
            <Setter Property="Height" Value="44" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TickPlacement" Value="None" />
        </Style>
        <Style Selector="Slider.accent-slider /template/ Track">
            <Setter Property="Height" Value="8" />
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border />
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- 1 dp under the circle, as on Windows: the ends meet it without a notch. The circle
             sits 9 dp inside the thumb's box, so the inner ends reach 10 dp into the box. -->
        <Style Selector="Slider.accent-slider /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Margin" Value="10,0,-10,0" />
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Margin" Value="-10,0,10,0" />
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton /template/ Border">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}" />
            <Setter Property="Height" Value="8" />
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton#PART_DecreaseButton /template/ Border">
            <Setter Property="CornerRadius" Value="4,0,0,4" />
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton#PART_IncreaseButton /template/ Border">
            <Setter Property="Background" Value="{DynamicResource PhoneFillBrush}" />
            <Setter Property="CornerRadius" Value="0,4,4,0" />
        </Style>
        <Style Selector="Slider.accent-slider /template/ Thumb">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- The circle centred in its box (the shadow fits inside), with a hairline rim
                         and a firmer shadow: on Light's white card the white circle was white on
                         white, only a faint shadow showing it. -->
                    <Panel Background="Transparent">
                        <Border Name="PART_Circle" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{TemplateBinding Background}" CornerRadius="999"
                                BorderBrush="{DynamicResource PhoneChromeOutlineBrush}" BorderThickness="1"
                                BoxShadow="0 1 5 0 #4D000000" />
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Panel Classes="grouped-root">
        <Border Name="PageBackdrop" Classes="grouped-backdrop" />
        <Grid RowDefinitions="Auto,*">
            <Panel Grid.Row="0">
                <Grid Classes="sheet-header settings-header" Classes.sub="{Binding IsSubPane}" ColumnDefinitions="Auto,*,Auto">
                    <Button Name="BackButton" Classes="sheet-close" AutomationProperties.Name="Back to Settings"
                            IsVisible="{Binding IsSubPane}" Command="{Binding ShowMainCommand}">
                        <views:GridIcon Data="{DynamicResource PhBack}" />
                    </Button>
                    <TextBlock Grid.Column="1" Name="SettingsTitle" Classes="sheet-title" Text="{Binding HeaderTitle}" />
                    <Button Grid.Column="2" Name="CloseButton" Classes="sheet-close" AutomationProperties.Name="Close"
                            Command="{Binding Shell.NavigateBackCommand}">
                        <views:GridIcon Data="{DynamicResource PhClose}" />
                    </Button>
                </Grid>
                <Border Name="HeaderHairline" Classes="header-hairline" Opacity="0" />
            </Panel>

            <!-- The top level and the pushed page share the area; SettingsPage.axaml.cs slides
                 one over the other. -->
            <Panel Grid.Row="1" Name="PaneHost" ClipToBounds="True">
                <ScrollViewer Name="MainScroll" Classes="page-scroll" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Classes="grouped-content">

                        <!-- Profile: only where the head wires an account service (Shell.Account).
                             The picture (else initials, else the person glyph), the name, the
                             computer and its last sync; the chevron into Account. -->
                        <StackPanel Name="AccountGroup" IsVisible="{Binding Shell.HasAccount}">
                            <Border Name="AccountCard" Classes="group-card">
                                <Button Name="AccountRow" Classes="row" Command="{Binding Shell.OpenAccountCommand}"
                                        AutomationProperties.Name="{Binding AccountRowText}">
                                    <Grid Classes="profile-row" ColumnDefinitions="Auto,*,Auto">
                                        <Border Name="ProfileAvatar" Classes="avatar large neutral">
                                            <Panel>
                                                <TextBlock Classes="initials" Text="{Binding AccountInitials}" IsVisible="{Binding ShowAccountInitials}" />
                                                <views:GridIcon Data="{DynamicResource PhPerson}" IsVisible="{Binding ShowAccountGlyph}" />
                                                <controls:CachedImage SourcePath="{Binding AccountAvatarPath}" IsVisible="{Binding HasAccountAvatar}"
                                                                      DecodeWidth="224" Stretch="UniformToFill" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Name="AccountRowLabel" Classes="profile-name" Text="{Binding AccountTitle}" />
                                            <TextBlock Name="AccountRowSub" Classes="profile-sub" Text="{Binding AccountSubtitle}" />
                                        </StackPanel>
                                        <views:GridIcon Grid.Column="2" Classes="row-chevron" Data="{DynamicResource PhChevronRight}" />
                                    </Grid>
                                </Button>
                            </Border>
                            <TextBlock Name="AccountFootnote" Classes="group-footnote" Text="{Binding AccountFootnote}" />
                        </StackPanel>

                        <!-- Look: System / Light / Dark, each a live preview; a tap applies it. -->
                        <Grid Name="LookTiles" ColumnDefinitions="*,12,*,12,*">
                            <Button Name="LookSystem" Classes="look-tile" Classes.selected="{Binding IsSystemLook}"
                                    Command="{Binding ChooseAppearanceCommand}" CommandParameter="System"
                                    AutomationProperties.Name="Look: System">
                                <StackPanel>
                                    <!-- Half Light, half the dark style: whichever the phone is in. -->
                                    <Border Classes="look-preview">
                                        <Panel>
                                            <ContentControl Content="{Binding DarkPreview}" ContentTemplate="{StaticResource LookPreviewTemplate}" />
                                            <Border Width="28" HorizontalAlignment="Left" ClipToBounds="True">
                                                <Canvas>
                                                    <ContentControl Width="56" Height="38" Content="{Binding LightPreview}" ContentTemplate="{StaticResource LookPreviewTemplate}" />
                                                </Canvas>
                                            </Border>
                                        </Panel>
                                    </Border>
                                    <TextBlock Classes="look-name" Text="System" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Name="LookLight" Classes="look-tile" Classes.selected="{Binding IsLightLook}"
                                    Command="{Binding ChooseAppearanceCommand}" CommandParameter="Light"
                                    AutomationProperties.Name="Look: Light">
                                <StackPanel>
                                    <Border Classes="look-preview">
                                        <ContentControl Content="{Binding LightPreview}" ContentTemplate="{StaticResource LookPreviewTemplate}" />
                                    </Border>
                                    <TextBlock Classes="look-name" Text="Light" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" Name="LookDark" Classes="look-tile" Classes.selected="{Binding IsDarkLook}"
                                    Command="{Binding ChooseAppearanceCommand}" CommandParameter="Dark"
                                    AutomationProperties.Name="Look: Dark">
                                <StackPanel>
                                    <Border Classes="look-preview">
                                        <ContentControl Content="{Binding DarkPreview}" ContentTemplate="{StaticResource LookPreviewTemplate}" />
                                    </Border>
                                    <TextBlock Classes="look-name" Text="Dark" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Into the pages: plain text, the current value in grey, a chevron. -->
                        <Border Name="PagesCard" Classes="group-card">
                            <StackPanel>
                                <Button Name="FoldersRow" Classes="row" Command="{Binding OpenPaneCommand}"
                                        CommandParameter="{x:Static vm:SettingsPane.Folders}" AutomationProperties.Name="Music Folders">
                                    <Grid Classes="setting-row" ColumnDefinitions="*,Auto,Auto,Auto">
                                        <TextBlock Classes="row-label" Text="Music Folders" />
                                        <Ellipse Grid.Column="1" Name="FolderWarningDot" Classes="warning-dot" IsVisible="{Binding HasLostFolder}" />
                                        <TextBlock Grid.Column="2" Name="FoldersValueLabel" Classes="row-value" Text="{Binding FoldersValue}" />
                                        <views:GridIcon Grid.Column="3" Classes="row-chevron" Data="{DynamicResource PhChevronRight}" />
                                    </Grid>
                                </Button>
                                <Border Classes="row-separator plain" />
                                <Button Name="AppearanceRow" Classes="row" Command="{Binding OpenPaneCommand}"
                                        CommandParameter="{x:Static vm:SettingsPane.Appearance}" AutomationProperties.Name="Appearance">
                                    <Grid Classes="setting-row" ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Classes="row-label" Text="Appearance" />
                                        <TextBlock Grid.Column="1" Name="AppearanceValueLabel" Classes="row-value" HorizontalAlignment="Right"
                                                   Text="{Binding AppearanceValue}" />
                                        <views:GridIcon Grid.Column="2" Classes="row-chevron" Data="{DynamicResource PhChevronRight}" />
                                    </Grid>
                                </Button>
                                <Border Classes="row-separator plain" />
                                <Button Name="LyricsRow" Classes="row" Command="{Binding OpenPaneCommand}"
                                        CommandParameter="{x:Static vm:SettingsPane.Lyrics}" AutomationProperties.Name="Lyrics">
                                    <Grid Classes="setting-row" ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Classes="row-label" Text="Lyrics" />
                                        <TextBlock Grid.Column="1" Name="LyricsValueLabel" Classes="row-value" HorizontalAlignment="Right"
                                                   Text="{Binding LyricsValue}" />
                                        <views:GridIcon Grid.Column="2" Classes="row-chevron" Data="{DynamicResource PhChevronRight}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Rescan: one accent row, the scan's state (or why it is off) under it. -->
                        <StackPanel>
                            <Border Classes="group-card">
                                <Button Name="RescanButton" Classes="row accent-row" Command="{Binding Shell.Library.RescanCommand}"
                                        IsEnabled="{Binding CanRescan}">
                                    <Grid Classes="setting-row">
                                        <TextBlock Classes="row-label" Text="Rescan Library" />
                                    </Grid>
                                </Button>
                            </Border>
                            <TextBlock Name="ScanStatusLabel" Classes="group-footnote" Text="{Binding RescanFootnote}"
                                       IsVisible="{Binding RescanFootnote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <!-- Export Logs: the log, for a bug report. -->
                        <StackPanel>
                            <Border Name="AdvancedCard" Classes="group-card">
                                <Button Name="ExportLogsButton" Classes="row accent-row" Command="{Binding ExportLogsCommand}">
                                    <Grid Classes="setting-row">
                                        <TextBlock Classes="row-label" Text="Export Logs" />
                                    </Grid>
                                </Button>
                            </Border>
                            <TextBlock Name="ExportStatusLabel" Classes="group-footnote" Text="{Binding ExportFootnote}" />
                        </StackPanel>

                        <TextBlock Name="VersionLabel" Classes="version-footer" Text="{Binding VersionText}" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Name="SubScroll" Classes="page-scroll" HorizontalScrollBarVisibility="Disabled" IsVisible="False">
                    <Panel>
                        <!-- Music Folders: each folder with its Remove, then Add Folder, then Scan on Startup. -->
                        <StackPanel Name="FoldersPane" Classes="grouped-content" IsVisible="{Binding ShowsFoldersPane}">
                            <StackPanel>
                                <Border Name="FoldersCard" Classes="group-card">
                                    <StackPanel>
                                        <ItemsControl Name="FolderList" ItemsSource="{Binding FolderRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SettingsFolder">
                                                    <StackPanel>
                                                        <Border Classes="row-separator plain" />
                                                        <Grid Classes="setting-row" ColumnDefinitions="*,Auto">
                                                            <StackPanel VerticalAlignment="Center" Margin="0,10">
                                                                <TextBlock Classes="row-label" Text="{Binding Title}" />
                                                                <TextBlock Classes="row-sub" Text="{Binding Name}" IsVisible="{Binding ShowsPath}" />
                                                                <TextBlock Classes="folder-lost" IsVisible="{Binding AccessLost}"
                                                                           Text="Access lost. Add this folder again to play its songs." />
                                                                <TextBlock Classes="folder-unavailable" IsVisible="{Binding Unavailable}"
                                                                           Text="Not available. Reconnect its storage, then rescan." />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Classes="folder-remove"
                                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsPageViewModel)DataContext).AskRemoveFolderCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    AutomationProperties.Name="{Binding Title, StringFormat='Remove {0}'}">
                                                                <views:GridIcon Data="{DynamicResource PhTrash}" />
                                                            </Button>
                                                        </Grid>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Name="NoFoldersRow" Classes="setting-row" IsVisible="{Binding !Shell.Library.HasFolders}">
                                            <TextBlock Classes="row-label" Foreground="{DynamicResource PhoneSecondaryTextBrush}"
                                                       Text="No Music Folders Yet" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <TextBlock Classes="group-footnote" Text="Your library on this phone is the music in these folders." />
                            </StackPanel>
                            <!-- Remove asks first. -->
                            <Border Name="RemoveFolderCard" Classes="group-card" IsVisible="{Binding IsConfirmingRemoveFolder}">
                                <StackPanel>
                                    <TextBlock Name="RemoveFolderQuestion" Classes="confirm-text" Text="{Binding RemoveFolderQuestion}" />
                                    <Border Classes="confirm-separator" />
                                    <Button Name="ConfirmRemoveFolderButton" Classes="row confirm-row danger" Command="{Binding ConfirmRemoveFolderCommand}">
                                        <TextBlock Text="Remove Folder" FontWeight="SemiBold" />
                                    </Button>
                                    <Border Classes="confirm-separator" />
                                    <Button Name="CancelRemoveFolderButton" Classes="row confirm-row" Command="{Binding CancelRemoveFolderCommand}">
                                        <TextBlock Text="Cancel" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <StackPanel>
                                <Border Classes="group-card">
                                    <Button Name="AddFolderButton" Classes="row accent-row" Command="{Binding Shell.Library.AddFolderCommand}"
                                            AutomationProperties.Name="Add Folder">
                                        <Grid Classes="setting-row" ColumnDefinitions="Auto,*">
                                            <views:GridIcon Classes="row-icon" Data="{DynamicResource AddIcon}" />
                                            <TextBlock Grid.Column="1" Classes="row-label" Text="Add Folder" />
                                        </Grid>
                                    </Button>
                                </Border>
                                <TextBlock Name="FoldersFootnoteLabel" Classes="group-footnote" Text="{Binding FoldersFootnote}" />
                            </StackPanel>
                            <StackPanel>
                                <Border Classes="group-card">
                                    <ToggleButton Name="ScanOnStartupSwitch" Classes="switch-row" AutomationProperties.Name="Scan on Startup"
                                                  IsChecked="{Binding Shell.Library.ScanOnStartup}">
                                        <TextBlock Classes="row-label" Text="Scan on Startup" />
                                    </ToggleButton>
                                </Border>
                                <TextBlock Classes="group-footnote" Text="Looks for new songs in these folders each time Noctis opens." />
                            </StackPanel>
                        </StackPanel>

                        <!-- Appearance: the dark style as a check list, the accent, then the player bar. -->
                        <StackPanel Name="AppearancePane" Classes="grouped-content" IsVisible="{Binding ShowsAppearancePane}">
                            <StackPanel Name="DarkThemeSection">
                                <TextBlock Classes="group-caption" Text="Dark Style" />
                                <Border Classes="group-card">
                                    <ListBox Name="DarkThemeList" Classes="check-list" ItemsSource="{Binding DarkThemes}"
                                             SelectedItem="{Binding DarkTheme}" IsEnabled="{Binding ShowsDarkThemes}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <StackPanel>
                                                    <Border Classes="row-separator plain" />
                                                    <Grid Classes="setting-row" ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="row-label" Text="{Binding}" />
                                                        <views:GridIcon Grid.Column="1" Classes="check" Data="{DynamicResource PhCheck}" />
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                                <TextBlock Name="DarkStyleFootnote" Classes="group-footnote" Text="{Binding DarkStyleFootnote}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Classes="group-caption" Text="Accent Colour" />
                                <Border Classes="group-card">
                                    <ListBox Name="AccentList" Classes="swatches" ItemsSource="{Binding AccentChoices}" SelectedItem="{Binding SelectedAccent}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <views:CenteredRowsPanel Columns="5" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AccentSwatch">
                                                <Panel Width="38" Height="38" AutomationProperties.Name="{Binding Name}">
                                                    <Ellipse Classes="swatch-ring" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" />
                                                    <!-- The hairline rim keeps a pale swatch (Gold) round on a white card. -->
                                                    <Ellipse Width="30" Height="30" Fill="{Binding Brush}"
                                                             Stroke="{DynamicResource PhoneChromeOutlineBrush}" StrokeThickness="1" />
                                                    <PathIcon Classes="swatch-tick" Data="{DynamicResource CheckmarkIcon}" Width="14" Height="14"
                                                              Foreground="{DynamicResource AccentForegroundBrush}" />
                                                </Panel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                                <TextBlock Classes="group-footnote" Text="{Binding AccentName, StringFormat='{}{0}. The accent colours buttons, switches and highlights.'}" />
                            </StackPanel>
                            <!-- Album and artist pages in a deep shade of the cover's colour (on by
                                 default); off, the theme's plain pages. The shell applies it at once
                                 (the open pages follow it) and saves it. -->
                            <StackPanel>
                                <TextBlock Classes="group-caption" Text="Album Colours" />
                                <Border Name="ArtworkColoursCard" Classes="group-card">
                                    <ToggleButton Name="ArtworkColoursSwitch" Classes="switch-row" AutomationProperties.Name="Colour Pages from Artwork"
                                                  IsChecked="{Binding Shell.ArtworkPageColors}">
                                        <TextBlock Classes="row-label" Text="Colour Pages from Artwork" />
                                    </ToggleButton>
                                </Border>
                                <TextBlock Classes="group-footnote"
                                           Text="Album and artist pages take a deep shade of the cover's colour, with white text. Off, they use the plain Light or Dark theme." />
                            </StackPanel>
                            <!-- The mini player's progress, both off by default (Apple's plain glass
                                 capsule); the shell applies each switch at once and saves it. -->
                            <StackPanel>
                                <TextBlock Classes="group-caption" Text="Player Bar" />
                                <Border Name="PlayerBarCard" Classes="group-card">
                                    <StackPanel>
                                        <ToggleButton Name="ProgressColourSwitch" Classes="switch-row" AutomationProperties.Name="Progress Colour"
                                                      IsChecked="{Binding Shell.ShowMiniProgressFill}">
                                            <TextBlock Classes="row-label" Text="Progress Colour" />
                                        </ToggleButton>
                                        <Border Classes="row-separator plain" />
                                        <ToggleButton Name="ProgressLineSwitch" Classes="switch-row" AutomationProperties.Name="Progress Line"
                                                      IsChecked="{Binding Shell.ShowMiniProgressLine}">
                                            <TextBlock Classes="row-label" Text="Progress Line" />
                                        </ToggleButton>
                                    </StackPanel>
                                </Border>
                                <TextBlock Classes="group-footnote"
                                           Text="Progress Colour fills the player bar in the cover's colour as the song plays. Progress Line draws a thin line along its bottom edge. With both off the bar is plain glass." />
                            </StackPanel>
                        </StackPanel>

                        <!-- Lyrics: the desktop's lyrics display settings that the phone's lyrics
                             page honours: the extra lines, the text size and the dimmed lines'
                             floor, joining split words, then the desktop's first online source
                             (LRCLIB) for songs with no lyrics of their own. (The desktop's other
                             sources, backgrounds, visualizer and fullscreen focus have nothing
                             to act on here.) -->
                        <StackPanel Name="LyricsPane" Classes="grouped-content" IsVisible="{Binding ShowsLyricsPane}">
                            <StackPanel>
                                <Border Name="LyricsCard" Classes="group-card">
                                    <StackPanel>
                                        <ToggleButton Name="TranslationSwitch" Classes="switch-row" AutomationProperties.Name="Show Translations"
                                                      IsChecked="{Binding Shell.Lyrics.ShowTranslation}">
                                            <TextBlock Classes="row-label" Text="Show Translations" />
                                        </ToggleButton>
                                        <Border Classes="row-separator plain" />
                                        <ToggleButton Name="RomajiSwitch" Classes="switch-row" AutomationProperties.Name="Show Romanization"
                                                      IsChecked="{Binding Shell.Lyrics.ShowRomanization}">
                                            <TextBlock Classes="row-label" Text="Show Romanization" />
                                        </ToggleButton>
                                        <Border Classes="row-separator plain" />
                                        <ToggleButton Name="BackgroundVocalsSwitch" Classes="switch-row" AutomationProperties.Name="Show Background Vocals"
                                                      IsChecked="{Binding Shell.Lyrics.ShowBackgroundVocals}">
                                            <TextBlock Classes="row-label" Text="Show Background Vocals" />
                                        </ToggleButton>
                                    </StackPanel>
                                </Border>
                                <TextBlock Classes="group-footnote" Text="Shown under a line, in smaller text, when the song's lyrics have them." />
                            </StackPanel>
                            <StackPanel>
                                <Border Name="LyricsSizeCard" Classes="group-card">
                                    <StackPanel>
                                        <Grid Classes="setting-row" ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="row-label" Text="Text Size" />
                                            <TextBlock Grid.Column="1" Name="LyricsSizeLabel" Classes="row-value"
                                                       Text="{Binding LyricsTextScale, StringFormat={}{0:P0}}" />
                                        </Grid>
                                        <controls:SmoothSlider Name="LyricsSizeSlider" Classes="accent-slider" Margin="7,-12,7,6"
                                                               Minimum="0.8" Maximum="1.6" Step="0.1" SteppedValue="{Binding LyricsTextScale}"
                                                               AutomationProperties.Name="Lyrics text size" />
                                        <Border Classes="row-separator plain" />
                                        <Grid Classes="setting-row" ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="row-label" Text="Minimum Line Opacity" />
                                            <TextBlock Grid.Column="1" Name="LyricsOpacityLabel" Classes="row-value"
                                                       Text="{Binding Shell.Lyrics.MinLineOpacity, StringFormat={}{0}%}" />
                                        </Grid>
                                        <controls:SmoothSlider Name="LyricsOpacitySlider" Classes="accent-slider" Margin="7,-12,7,6"
                                                               Minimum="0" Maximum="60" Step="1" SteppedValue="{Binding Shell.Lyrics.MinLineOpacity}"
                                                               AutomationProperties.Name="Minimum line opacity" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Classes="group-footnote" Text="Keeps every line faintly visible, so you can tap any line to jump there. 0% hides lines far from the current one." />
                            </StackPanel>
                            <StackPanel>
                                <Border Classes="group-card">
                                    <ToggleButton Name="JoinWordsSwitch" Classes="switch-row" AutomationProperties.Name="Join Split Words"
                                                  IsChecked="{Binding Shell.Lyrics.JoinSplitWords}">
                                        <TextBlock Classes="row-label" Text="Join Split Words" />
                                    </ToggleButton>
                                </Border>
                                <TextBlock Classes="group-footnote" Text="Keeps words whole when TTML lyrics split them into syllables." />
                            </StackPanel>
                            <StackPanel>
                                <Border Classes="group-card">
                                    <ToggleButton Name="FindOnlineSwitch" Classes="switch-row" AutomationProperties.Name="Find Lyrics Online"
                                                  IsChecked="{Binding Shell.Lyrics.FindLyricsOnline}">
                                        <TextBlock Classes="row-label" Text="Find Lyrics Online" />
                                    </ToggleButton>
                                </Border>
                                <TextBlock Classes="group-footnote" Text="When a song has no lyrics file or lyrics in its tags, asks LRCLIB by its title, artist and length, as the desktop app does. Found lyrics are kept on the phone." />
                            </StackPanel>
                        </StackPanel>
                    </Panel>
                </ScrollViewer>
            </Panel>
        </Grid>
    </Panel>
</UserControl>
