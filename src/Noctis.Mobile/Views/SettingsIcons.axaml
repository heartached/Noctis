<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Settings' row glyphs, the approved mockup's own 24-grid line drawings (settings.html). Each is a
         GridIcon with StrokeThickness 1.8 (round caps and joins), so they are stroked, not filled:
         unlike PhoneIcons they do not span the whole grid and are not in the icon-set test. The
         theme glyph (a ring and a half disc) is the one filled outline. -->
    <StreamGeometry x:Key="SetIconBackground">M8 3H16A4 4 0 0 1 20 7V17A4 4 0 0 1 16 21H8A4 4 0 0 1 4 17V7A4 4 0 0 1 8 3Z M4 14c3-2 6 1 9-1s5-1 7 0</StreamGeometry>
    <!-- Filled: the ring (outer clockwise, inner counter-clockwise) and the left half disc. -->
    <StreamGeometry x:Key="SetIconTheme">M12 3.1A8.9 8.9 0 1 1 12 20.9A8.9 8.9 0 1 1 12 3.1Z M12 4.9A7.1 7.1 0 1 0 12 19.1A7.1 7.1 0 1 0 12 4.9Z M12 20A8 8 0 0 1 12 4Z</StreamGeometry>
    <StreamGeometry x:Key="SetIconAccent">M12 3a9 9 0 1 0 0 18c1.4 0 2-1 2-2 0-1.4-1.2-1.6-1.2-3S14 14 15.5 14H18a3 3 0 0 0 3-3c0-4.4-4-8-9-8z M6.5 11a1 1 0 1 0 2 0a1 1 0 1 0-2 0 M9 7a1 1 0 1 0 2 0a1 1 0 1 0-2 0 M14 7.5a1 1 0 1 0 2 0a1 1 0 1 0-2 0</StreamGeometry>
    <StreamGeometry x:Key="SetIconDisc">M12 3.5A8.5 8.5 0 1 1 12 20.5A8.5 8.5 0 1 1 12 3.5Z M12 9.6A2.4 2.4 0 1 1 12 14.4A2.4 2.4 0 1 1 12 9.6Z M7.2 9.4A5.6 5.6 0 0 1 9.4 7.2</StreamGeometry>
    <!-- Smooth Motion: three speed lines trailing a circle. -->
    <StreamGeometry x:Key="SetIconMotion">M15 6.5A5.5 5.5 0 1 1 15 17.5A5.5 5.5 0 1 1 15 6.5Z M3 8.5h5 M2 12h5.5 M3 15.5h5</StreamGeometry>
    <StreamGeometry x:Key="SetIconPlayerBar">M8.5 7H15.5A5.5 5.5 0 0 1 15.5 18H8.5A5.5 5.5 0 0 1 8.5 7Z M7 12.5h6</StreamGeometry>
    <StreamGeometry x:Key="SetIconFolder">M3 7.5A2.5 2.5 0 0 1 5.5 5H9l2 2h7.5A2.5 2.5 0 0 1 21 9.5v7a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 16.5z</StreamGeometry>
    <StreamGeometry x:Key="SetIconDownload">M12 4v11M7.5 10.5L12 15l4.5-4.5M5 19h14</StreamGeometry>
    <StreamGeometry x:Key="SetIconRescan">M5 12a7 7 0 0 1 12-4.9M19 12a7 7 0 0 1-12 4.9M17 3.5v3.8h-3.8M7 20.5v-3.8h3.8</StreamGeometry>
    <StreamGeometry x:Key="SetIconLyrics">M4 6h10M4 11h10M4 16h6 M18 5v10.5 M13.7 16a2.3 2.3 0 1 0 4.6 0a2.3 2.3 0 1 0-4.6 0</StreamGeometry>
    <StreamGeometry x:Key="SetIconScrobbling">M4 18V9M9 18V5M14 18v-6M19 18V8</StreamGeometry>
    <StreamGeometry x:Key="SetIconHistory">M4 12a8 8 0 1 0 16 0a8 8 0 1 0-16 0Z M12 7.5V12l3 2</StreamGeometry>
    <!-- Played Songs in Queue: queue lines with an arrow up beside them (played songs stay above). -->
    <StreamGeometry x:Key="SetIconQueueHistory">M10 6h10M10 12h10M10 18h10 M5 18V6 M2.5 8.5L5 6l2.5 2.5</StreamGeometry>
    <StreamGeometry x:Key="SetIconPickUp">M5 4H14A2 2 0 0 1 16 6V12A2 2 0 0 1 14 14H5A2 2 0 0 1 3 12V6A2 2 0 0 1 5 4Z M16.6 9H19.4A1.6 1.6 0 0 1 21 10.6V18.4A1.6 1.6 0 0 1 19.4 20H16.6A1.6 1.6 0 0 1 15 18.4V10.6A1.6 1.6 0 0 1 16.6 9Z M7 18h5</StreamGeometry>
    <StreamGeometry x:Key="SetIconWarning">M12 3l9 16H3z M12 10v4M12 16.8v.2</StreamGeometry>
    <StreamGeometry x:Key="SetIconDoc">M7 3h7l4 4v14H7z M14 3v4h4M10 12h5M10 16h5</StreamGeometry>
    <StreamGeometry x:Key="SetIconShield">M12 3l7 3v6c0 4.5-3 7.6-7 9c-4-1.4-7-4.5-7-9V6z M9 12l2 2l4-4</StreamGeometry>
    <StreamGeometry x:Key="SetIconStar">M12 3.6L14.29 9.44L20.56 9.82L15.71 13.81L17.29 19.88L12 16.5L6.71 19.88L8.29 13.81L3.44 9.82L9.71 9.44Z</StreamGeometry>
    <StreamGeometry x:Key="SetIconGlobe">M3.5 12a8.5 8.5 0 1 0 17 0a8.5 8.5 0 1 0-17 0Z M3.5 12h17M12 3.5c2.5 2.5 2.5 14.5 0 17M12 3.5c-2.5 2.5-2.5 14.5 0 17</StreamGeometry>
    <!-- The row's trailing marks: a link that leaves the app, and the Theme row's up/down pair. -->
    <StreamGeometry x:Key="SetIconExternal">M6 18l12-12M8 6h10v10</StreamGeometry>
    <StreamGeometry x:Key="SetIconUpDown">M8 10l4-4 4 4M8 14l4 4 4-4</StreamGeometry>
    <!-- Library › Hidden: the desktop's Hide Folder eye (MenuLineEyeOff). -->
    <StreamGeometry x:Key="SetIconHidden">M2.8 12C4.7 8 8 5.8 12 5.8C16 5.8 19.3 8 21.2 12C19.3 16 16 18.2 12 18.2C8 18.2 4.7 16 2.8 12ZM12 14.8a2.8 2.8 0 1 0 0-5.6a2.8 2.8 0 0 0 0 5.6ZM4.5 4.5l15 15</StreamGeometry>
</ResourceDictionary>
