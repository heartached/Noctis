<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:views="using:Noctis.Mobile.Views"
             xmlns:models="using:Noctis.Models"
             x:Class="Noctis.Mobile.Views.AlbumGridPage"
             x:DataType="vm:AlbumGridPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <!-- The shared header (PageHeader): "‹ Library" over the large title. -->
        <views:PageHeader Grid.Row="0" Name="Header" IsVisible="{Binding !IsEmbedded}" />

        <!-- "Find in Albums": the list pages' shared field (FindField), by album title or artist. -->
        <views:FindField Grid.Row="1" Name="AlbumFindField" Text="{Binding Query}" Placeholder="{loc:T Mobile.Albums.Find}"
                         IsVisible="{Binding HasAlbums}" />

        <TextBlock Grid.Row="2" Classes="subtle" Text="{loc:T Mobile.NoAlbums}" HorizontalAlignment="Center"
                   Margin="0,40,0,0" IsVisible="{Binding !HasAlbums}" />
        <TextBlock Grid.Row="2" Name="NoAlbumResultsText" Classes="subtle" Text="{loc:T Mobile.Albums.NoMatch}" HorizontalAlignment="Center"
                   Margin="0,40,0,0" IsVisible="{Binding ShowNoResults}" />

        <ScrollViewer Classes="page-scroll" Grid.Row="2" views:ScrollMemory.IsEnabled="True" HorizontalScrollBarVisibility="Disabled">
            <!-- Rows built once and handed the next row (RowItemsControl), tiles built once per
                 row and handed the next album (SlotRow): a fling only rebinds. -->
            <views:RowItemsControl Name="AlbumRows" ItemsSource="{Binding Rows}" Margin="14,0,14,16">
                <views:RowItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </views:RowItemsControl.ItemsPanel>
                <views:RowItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:AlbumRow">
                        <views:SlotRow Items="{Binding Albums}" Columns="2">
                            <views:SlotRow.ItemTemplate>
                                <DataTemplate x:DataType="models:Album">
                                    <Button Classes="row" Margin="6"
                                            views:LongPress.Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenAlbumSheetCommand}"
                                            Command="{Binding $parent[views:AlbumGridPage].((vm:AlbumGridPageViewModel)DataContext).Shell.OpenAlbumCommand}"
                                            CommandParameter="{Binding}">
                                        <views:AlbumTile />
                                    </Button>
                                </DataTemplate>
                            </views:SlotRow.ItemTemplate>
                        </views:SlotRow>
                    </DataTemplate>
                </views:RowItemsControl.ItemTemplate>
            </views:RowItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
