<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:models="using:Noctis.Models"
             xmlns:controls="using:Noctis.Controls"
             xmlns:conv="using:Noctis.Converters"
             xmlns:views="using:Noctis.Mobile.Views"
             x:Class="Noctis.Mobile.Views.QueuePage"
             x:DataType="vm:ShellViewModel"
             Foreground="{DynamicResource QueueText}">

    <!-- The sheet follows the app theme (it sits outside ShellView's always-dark scope): light
         frosted glass with dark text under Light, the dark frost under Dark. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <conv:PreBlurredArtworkConverter x:Key="PreBlur" />
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="QueueSheetBase" Color="#FF121214" />
                    <SolidColorBrush x:Key="QueueSheetScrim" Color="#A6000000" />
                    <SolidColorBrush x:Key="QueueText" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="QueueSubtleText" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="QueueRule" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="QueueCloseFill" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="QueueGrabber" Color="#99FFFFFF" />
                    <x:Double x:Key="QueueAccentWash">0.22</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="QueueSheetBase" Color="#FFF2F2F5" />
                    <SolidColorBrush x:Key="QueueSheetScrim" Color="#BFF7F7F9" />
                    <SolidColorBrush x:Key="QueueText" Color="#FF1C1C1E" />
                    <SolidColorBrush x:Key="QueueSubtleText" Color="#7A000000" />
                    <SolidColorBrush x:Key="QueueRule" Color="#1F000000" />
                    <SolidColorBrush x:Key="QueueCloseFill" Color="#14000000" />
                    <SolidColorBrush x:Key="QueueGrabber" Color="#4D000000" />
                    <x:Double x:Key="QueueAccentWash">0.15</x:Double>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.icon, Button.round, Button.pill">
            <Setter Property="Foreground" Value="{DynamicResource QueueText}" />
        </Style>
        <Style Selector="TextBlock.row-sub, TextBlock.subtle">
            <Setter Property="Foreground" Value="{DynamicResource QueueSubtleText}" />
        </Style>
        <!-- The current track: title over artist beside a small cover (Apple's queue). -->
        <Style Selector="TextBlock.now-title">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.now-sub">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource QueueSubtleText}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- The list's title (Apple's "Playing Next"), with where it plays from under it. -->
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="LineHeight" Value="25" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.section-sub">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="Foreground" Value="{DynamicResource QueueSubtleText}" />
        </Style>
        <!-- Rows as the mockup sets them: a regular-weight title over the artist and album in
             one grey. -->
        <Style Selector="TextBlock.row-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="TextBlock.row-album">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource QueueSubtleText}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Border.sep">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource QueueRule}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- The round glass close button. -->
        <Style Selector="Button.round.close">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource QueueCloseFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBarEdge}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.round.close PathIcon">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
        </Style>
        <!-- Clear: accent text at the end of the Up Next title; its padding hangs past the
             margin so the word itself lines up with the sheet's right edge, the tap target a
             full 44 tall. -->
        <Style Selector="Button.pill.clear">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,-10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- The control pill = the desktop's player bar (PlaybackBarView): one row of plain glyphs
             in one box size - Repeat, Previous, Next, Shuffle, Queue and ⋯ all drawn in the skip
             buttons' box, Play/Pause a little larger (the desktop's 18 and 20, here 24 and 26.7;
             owner 10-20: "a little smaller" than the first 30 and 33).
             A mode that is on (and Queue, whose sheet is open) turns the glyph accent over the
             desktop's faint accent square (28 of 34 there, corner 8; the same proportions here).
             The wash is its own layer so the glyph keeps the full accent. -->
        <Style Selector="Button.icon.pill-btn">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.icon.pill-btn PathIcon, Button.icon.pill-btn controls|TransportGlyph">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon.pill-btn PathIcon.play, Button.icon.pill-btn controls|TransportGlyph.play">
            <Setter Property="Width" Value="26.7" />
            <Setter Property="Height" Value="26.7" />
        </Style>
        <Style Selector="Button.icon.pill-btn Border.wash">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}" />
            <Setter Property="Opacity" Value="{DynamicResource QueueAccentWash}" />
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.icon.pill-btn.on Border.wash">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Button.icon.pill-btn.on PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>

        <!-- "Currently playing" equalizer: four bars at rest, bouncing while the class
             "playing" is on (the code-behind sets it only while a track plays AND the sheet
             is up, so nothing animates behind a hidden page). Height, not a transform: a
             style animation of RenderTransform does not run here (repo trap). -->
        <Style Selector="Panel#EqBars > Border">
            <Setter Property="Width" Value="2.5" />
            <Setter Property="CornerRadius" Value="1.25" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="Panel#EqBars.playing > Border.b1">
            <Style.Animations>
                <Animation Duration="0:0:0.45" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Height" Value="3" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Height" Value="11" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Panel#EqBars.playing > Border.b2">
            <Style.Animations>
                <Animation Duration="0:0:0.6" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Height" Value="12" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Height" Value="4" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Panel#EqBars.playing > Border.b3">
            <Style.Animations>
                <Animation Duration="0:0:0.5" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Height" Value="5" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Height" Value="12" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Panel#EqBars.playing > Border.b4">
            <Style.Animations>
                <Animation Duration="0:0:0.7" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Height" Value="9" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Height" Value="3" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <!-- No background of its own: only the sheet takes touches, and the code-behind turns
         that off while the sheet slides away. -->
    <Panel>
        <Border Name="Dim" Background="#73000000" IsHitTestVisible="False" Opacity="0" />

        <!-- A page sheet: a sliver of the page underneath stays visible above it. -->
        <Panel Margin="{Binding TopSafePadding}">
            <Border Name="Sheet" Margin="0,10,0,0" CornerRadius="14,14,0,0" ClipToBounds="True"
                    Background="{DynamicResource QueueSheetBase}">
                <Panel>
                    <!-- Blurred once per cover (PreBlurredArtworkConverter) from the header cover's own bitmap
                         (the list's current row's while the header's is hidden: the code-behind). -->
                    <Image Name="Backdrop" Source="{Binding #NowArtwork.Source, Converter={StaticResource PreBlur}}"
                           Stretch="UniformToFill" IsHitTestVisible="False" />
                    <Border Name="Scrim" Background="{DynamicResource QueueSheetScrim}" IsHitTestVisible="False" />

                    <Grid Name="Layout" RowDefinitions="Auto,Auto,Auto,*">
                        <!-- Both the grabber and ✕ close the sheet. -->
                        <Grid Name="TopBar" Height="44">
                            <Button Name="QueueGrabber" Classes="icon" Width="64" Height="28" VerticalAlignment="Top"
                                    HorizontalAlignment="Center" Command="{Binding ToggleQueueCommand}">
                                <PathIcon Data="{DynamicResource QueueGrabberIcon}" Width="40" Height="40" Margin="-5,-15"
                                          Foreground="{DynamicResource QueueGrabber}" />
                            </Button>
                            <Button Name="QueueCloseButton" Classes="round close" HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom" Margin="0,0,16,0" Command="{Binding ToggleQueueCommand}">
                                <PathIcon Data="{DynamicResource QueueCloseIcon}" />
                            </Button>
                        </Grid>

                        <!-- Apple's queue: the current track as a row of its own (a small cover, the
                             title over the artist, the playing bars at its end), then the list's title,
                             Up Next with Clear at its end, and under it where the queue plays from and
                             the track's place in it. Unknown lines hide. -->
                        <!-- Shown while a track is loaded (the code-behind: with the History on, the list's own row takes its place in portrait). -->
                        <Grid Grid.Row="1" Name="NowRow" ColumnDefinitions="Auto,*,Auto" Margin="20,4,20,0" IsVisible="False">
                            <!-- The shadow on an outer border: the cover itself clips to its corners. -->
                            <Border Width="64" Height="64" CornerRadius="8" VerticalAlignment="Top"
                                    BoxShadow="0 3 10 0 #33000000">
                                <Border Name="NowCover" Classes="art" CornerRadius="8">
                                    <Panel>
                                        <PathIcon Data="{DynamicResource SongsIcon}" Width="24" Height="24" Opacity="0.4" />
                                        <controls:CachedImage Name="NowArtwork" SourcePath="{Binding Player.CurrentTrack.AlbumArtworkPath}"
                                                              DecodeWidth="384" ClearOnSourceChange="False" Stretch="UniformToFill" />
                                    </Panel>
                                </Border>
                            </Border>
                            <StackPanel Grid.Column="1" Name="NowText" Margin="14,0,12,0" VerticalAlignment="Center">
                                <!-- Left-aligned, so the explicit badge follows the title, not the row's end. -->
                                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                                    <TextBlock Name="NowTitle" Classes="now-title" Text="{Binding Player.CurrentTrack.Title}" MaxLines="1" />
                                    <Border Grid.Column="1" Name="NowExplicit" Classes="explicit-badge compact" Margin="6,0,0,0"
                                            IsVisible="{Binding Player.CurrentTrack.IsExplicit, FallbackValue=False}">
                                        <TextBlock Text="E" Classes="explicit-badge-text compact" FontSize="8" Opacity="0.9" />
                                    </Border>
                                </Grid>
                                <TextBlock Name="NowArtist" Classes="now-sub" Text="{Binding Player.CurrentTrack.Artist}" />
                            </StackPanel>
                            <Panel Grid.Column="2" Name="EqBars" Width="14" Height="12" VerticalAlignment="Center">
                                <Border Classes="b1" Height="6" />
                                <Border Classes="b2" Height="10" Margin="3.8,0,0,0" />
                                <Border Classes="b3" Height="7" Margin="7.6,0,0,0" />
                                <Border Classes="b4" Height="9" Margin="11.4,0,0,0" />
                            </Panel>
                        </Grid>

                        <!-- The title row keeps Clear's height when Clear hides: the line under it does not jump. -->
                        <Grid Grid.Row="2" Name="UpNextHeader" ColumnDefinitions="*,Auto" Margin="20,20,20,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="32" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Name="UpNextLabel" Classes="section" Text="{loc:T Mobile.Queue.UpNext}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Name="ClearButton" Classes="pill clear" Content="{loc:T Mobile.Queue.Clear}" VerticalAlignment="Center"
                                    Command="{Binding Player.ClearUpNextCommand}" IsVisible="{Binding Player.HasUpNext}" />
                            <!-- One line: "Playing from X · Track N of M"; the source trims first. -->
                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" HorizontalAlignment="Left">
                                <TextBlock Name="SourceLine" Classes="section-sub" Text="{Binding Player.PlayingFromText}" TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding Player.HasSourceLabel}" />
                                <TextBlock Grid.Column="1" Name="SourceDot" Classes="section-sub" Text=" · ">
                                    <TextBlock.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="Player.HasSourceLabel" />
                                            <Binding Path="Player.HasQueuePosition" />
                                        </MultiBinding>
                                    </TextBlock.IsVisible>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Name="PositionLine" Classes="section-sub" Text="{Binding Player.QueuePositionText}"
                                           IsVisible="{Binding Player.HasQueuePosition}" />
                            </Grid>
                        </Grid>

                        <!-- Runs to the bottom of the sheet: in portrait the rows scroll under the control
                             pill, and the bottom padding (code-behind, it follows the safe area) lets the
                             last one clear it. -->
                        <ScrollViewer Grid.Row="3" Name="QueueScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                          <!-- With Settings › Played Songs in Queue on, the queue is one list (Discord 11-07):
                               the songs already played (dimmed, oldest first, a tap plays one again), the
                               current track as a highlighted row, then Up Next under its title, which the
                               code-behind moves in here. Every row but the current one has a drag handle,
                               and a row dragged past the current one goes in before or after it. -->
                          <StackPanel Name="QueueContent">
                            <StackPanel Name="HistorySection">
                                <StackPanel.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="ShowQueueHistory" />
                                        <Binding Path="Player.HasPlayedSongs" />
                                    </MultiBinding>
                                </StackPanel.IsVisible>
                                <!-- Hide folds the played songs to this title for the rest of the run. -->
                                <Grid Name="HistoryHeader" ColumnDefinitions="*,Auto" Margin="20,8,20,2" MinHeight="32">
                                    <TextBlock Name="HistoryLabel" Classes="section" Text="{loc:T Mobile.Queue.History}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Name="HistoryToggleButton" Classes="pill clear" Content="{Binding QueueHistoryToggleText}"
                                            VerticalAlignment="Center" Command="{Binding ToggleQueueHistoryCollapsedCommand}" />
                                </Grid>
                                <!-- A plain StackPanel: History holds at most 50 songs, and a drop needs every row laid out. -->
                                <ItemsControl Name="HistoryList" ItemsSource="{Binding Player.PlayedSongs}" IsVisible="{Binding !IsQueueHistoryCollapsed}"
                                              ClipToBounds="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:QueueHistoryItem">
                                            <Button Classes="row history-row" Height="56"
                                                    Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).Player.PlayFromHistoryCommand}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Track.Title}">
                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,0,6,0">
                                                    <Border Classes="art" Width="44" Height="44" CornerRadius="6" Opacity="0.55">
                                                        <Panel>
                                                            <PathIcon Data="{DynamicResource SongsIcon}" Width="16" Height="16" Opacity="0.5" />
                                                            <controls:CachedImage SourcePath="{Binding Track.AlbumArtworkPath}" DecodeWidth="128" Stretch="UniformToFill" />
                                                        </Panel>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Opacity="0.55">
                                                        <TextBlock Classes="row-title" Text="{Binding Track.Title}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Classes="row-sub" Text="{Binding Track.Artist}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Name="DragHandle" Width="44" Background="Transparent"
                                                            PointerPressed="OnHandlePressed" PointerMoved="OnHandleMoved"
                                                            PointerReleased="OnHandleReleased" PointerCaptureLost="OnHandleCaptureLost">
                                                        <PathIcon Data="{DynamicResource QueueReorderIcon}" Width="24" Height="24"
                                                                  Foreground="{DynamicResource QueueSubtleText}" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <!-- The current track in the list: a highlighted row between the two, no handle. -->
                            <Border Name="NowInline" Height="64" Margin="8,4,8,0" CornerRadius="12" IsVisible="False">
                                <Panel>
                                    <Border Background="{DynamicResource AccentColorBrush}" Opacity="{DynamicResource QueueAccentWash}" CornerRadius="12" />
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0,16,0">
                                        <Border Classes="art" Width="48" Height="48" CornerRadius="6">
                                            <Panel>
                                                <PathIcon Data="{DynamicResource SongsIcon}" Width="18" Height="18" Opacity="0.5" />
                                                <controls:CachedImage Name="NowInlineArtwork" SourcePath="{Binding Player.CurrentTrack.AlbumArtworkPath}"
                                                                      DecodeWidth="384" ClearOnSourceChange="False" Stretch="UniformToFill" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Name="NowInlineTitle" Classes="row-title" FontWeight="SemiBold" Text="{Binding Player.CurrentTrack.Title}"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="row-sub" Text="{Binding Player.CurrentTrack.Artist}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <views:PlayingBars Grid.Column="2" Name="NowInlineBars" VerticalAlignment="Center"
                                                           Fill="{DynamicResource AccentTextBrush}" IsPlaying="{Binding Player.IsPlaying}" />
                                    </Grid>
                                </Panel>
                            </Border>
                            <!-- Unclipped (the theme clips an ItemsControl): a row dragged above the current
                                 row was cut off at the list's top edge and vanished (emulator, 11-07). -->
                            <ItemsControl Name="QueueList" ItemsSource="{Binding Player.UpNext}" ClipToBounds="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Track">
                                        <!-- Transparent background: the whole row must hit-test for the swipe. -->
                                        <Border Classes="queue-row" Height="68" Background="Transparent"
                                                PointerPressed="OnRowPressed" PointerMoved="OnRowMoved"
                                                PointerReleased="OnRowReleased" PointerCaptureLost="OnRowCaptureLost">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,0,6,0">
                                                <Border Classes="art" Width="52" Height="52" CornerRadius="6">
                                                    <Panel>
                                                        <PathIcon Data="{DynamicResource SongsIcon}" Width="18" Height="18" Opacity="0.5" />
                                                        <controls:CachedImage SourcePath="{Binding AlbumArtworkPath}" DecodeWidth="128" Stretch="UniformToFill" />
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                                                        <TextBlock Classes="row-title" Text="{Binding Title}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="1" Name="RowExplicit" Classes="explicit-badge compact" Margin="6,0,0,0"
                                                                IsVisible="{Binding IsExplicit}">
                                                            <TextBlock Text="E" Classes="explicit-badge-text compact" FontSize="8" Opacity="0.9" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Classes="row-sub" Text="{Binding Artist}" />
                                                    <TextBlock Classes="row-album" Text="{Binding Album}" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Name="DragHandle" Width="44" Background="Transparent"
                                                        PointerPressed="OnHandlePressed" PointerMoved="OnHandleMoved"
                                                        PointerReleased="OnHandleReleased" PointerCaptureLost="OnHandleCaptureLost">
                                                    <PathIcon Data="{DynamicResource QueueReorderIcon}" Width="24" Height="24"
                                                              Foreground="{DynamicResource QueueSubtleText}" />
                                                </Border>
                                                <Border Grid.Column="1" Grid.ColumnSpan="2" Classes="sep" VerticalAlignment="Bottom" Margin="12,0,14,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Name="EmptyQueue" Classes="subtle" Text="{loc:T Mobile.Queue.Empty}" HorizontalAlignment="Center"
                                       Margin="0,32,0,0" IsVisible="{Binding !Player.HasUpNext}" />
                          </StackPanel>
                        </ScrollViewer>

                        <!-- The floating Liquid Glass control pill above the navigation bar: over the end of
                             the list, or under the current track once landscape splits the layout in two
                             columns (the code-behind keeps its margin on the safe area). -->
                        <Panel Grid.Row="3" Name="PillHost" VerticalAlignment="Bottom">
                            <controls:GlassPanel Name="ControlPill" Classes="liquid" CornerRadius="28" Height="56" Margin="20,0,20,12">
                                <Panel>
                                    <Border Background="{DynamicResource GlassBarSheen}" CornerRadius="28" IsHitTestVisible="False" />
                                    <Grid ColumnDefinitions="*,*,*,*,*,*,*" Margin="8,0">
                                        <Button Grid.Column="0" Name="QueueListButton" Classes="icon pill-btn on"
                                                Command="{Binding ToggleQueueCommand}" AutomationProperties.Name="{loc:T Tab.Queue}">
                                            <Panel>
                                                <Border Classes="wash" />
                                                <PathIcon Data="{DynamicResource PhQueue}" />
                                            </Panel>
                                        </Button>
                                        <Button Grid.Column="1" Name="QueueRepeatButton" Classes="icon pill-btn" Classes.on="{Binding Player.IsRepeatOn}"
                                                Command="{Binding Player.CycleRepeatCommand}" AutomationProperties.Name="{loc:T Mobile.Repeat}">
                                            <Panel>
                                                <Border Classes="wash" />
                                                <PathIcon Data="{DynamicResource PhRepeat}" IsVisible="{Binding !Player.IsRepeatOne}" />
                                                <PathIcon Name="RepeatOneGlyph" Data="{DynamicResource PhRepeatOne}" IsVisible="{Binding Player.IsRepeatOne}" />
                                            </Panel>
                                        </Button>
                                        <Button Grid.Column="2" Name="QueuePreviousButton" Classes="icon pill-btn tx"
                                                Command="{Binding Player.PreviousCommand}" AutomationProperties.Name="{loc:T Mobile.Previous}">
                                            <controls:TransportGlyph Kind="Previous" />
                                        </Button>
                                        <Button Grid.Column="3" Name="QueuePlayPauseButton" Classes="icon pill-btn tx"
                                                Command="{Binding Player.TogglePlayPauseCommand}" AutomationProperties.Name="{loc:T Mobile.PlayPause}">
                                            <controls:TransportGlyph Classes="play" Kind="PlayPause" IsPlaying="{Binding Player.IsPlaying}" />
                                        </Button>
                                        <Button Grid.Column="4" Name="QueueNextButton" Classes="icon pill-btn tx"
                                                Command="{Binding Player.NextCommand}" AutomationProperties.Name="{loc:T Mobile.Next}">
                                            <controls:TransportGlyph Kind="Next" />
                                        </Button>
                                        <Button Grid.Column="5" Name="QueueShuffleButton" Classes="icon pill-btn" Classes.on="{Binding Player.IsShuffleEnabled}"
                                                Command="{Binding Player.ToggleShuffleCommand}" AutomationProperties.Name="{loc:T Mobile.Shuffle}">
                                            <Panel>
                                                <Border Classes="wash" />
                                                <PathIcon Data="{DynamicResource PhShuffle}" />
                                            </Panel>
                                        </Button>
                                        <Button Grid.Column="6" Name="QueueMoreButton" Classes="icon pill-btn"
                                                Command="{Binding OpenCurrentTrackSheetCommand}" AutomationProperties.Name="{loc:T Mobile.More}">
                                            <PathIcon Data="{DynamicResource PhMore}" />
                                        </Button>
                                    </Grid>
                                </Panel>
                            </controls:GlassPanel>
                        </Panel>
                    </Grid>
                </Panel>
            </Border>
        </Panel>
    </Panel>
</UserControl>
