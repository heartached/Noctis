<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:views="using:Noctis.Mobile.Views"
             xmlns:loc="using:Noctis.Localization"
             x:Class="Noctis.Mobile.Views.HomePage"
             x:DataType="vm:ShellViewModel">

    <!-- The Home tab root (the start tab, Apple Music's Home for an offline player): what the
         user listens to — Pinned, Recently Played, On Repeat — as rails. The Library tab keeps
         the lists themselves and Recently Added. -->
    <UserControl.Resources>
        <!-- One rail tile: three covers across with the fourth peeking, like the Library's. -->
        <DataTemplate x:Key="RailTileTemplate" x:DataType="vm:RailItem">
            <Button Classes="row" Width="140" VerticalAlignment="Top"
                    views:LongPress.Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenRailItemSheetCommand}"
                    Command="{Binding $parent[views:HomePage].((vm:ShellViewModel)DataContext).OpenRailItemCommand}"
                    CommandParameter="{Binding}">
                <views:RailTile />
            </Button>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="RailPanel">
            <StackPanel Orientation="Horizontal" Spacing="12" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Name="HomeHeader" ColumnDefinitions="*,Auto" Classes="tab-header">
            <views:FitWidth Name="HomeTitleFit" VerticalAlignment="Center">
                <TextBlock Name="HomeTitle" Classes="title" Text="{loc:T Nav.Home}" TextTrimming="CharacterEllipsis" />
            </views:FitWidth>
            <views:ProfileButton Grid.Column="1" Name="HomeProfile" VerticalAlignment="Center"
                                 AvatarPath="{Binding ProfileAvatarPath}" Command="{Binding OpenSettingsCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="1" Classes="page-scroll" Name="HomeScroll" HorizontalScrollBarVisibility="Disabled">
            <!-- No side margin here: rails scroll edge to edge; headers and cards inset themselves. -->
            <StackPanel Name="HomeContent" Margin="0,0,0,24" Spacing="22">
                <!-- The start tab: a new phone lands here, so the first-run card shows here too. -->
                <views:LibraryNotices IsVisible="{Binding Library.HasNotice}" />

                <!-- Pinned: always shown once there is music, so the pin system is discoverable. -->
                <StackPanel Name="PinnedSection" Spacing="10" IsVisible="{Binding Library.ShowSections}">
                    <!-- Nothing pinned: no ›, and no tap into an empty page; the hint card says how. -->
                    <Button Name="PinnedHeader" Classes="row section-header" Command="{Binding OpenPinnedCommand}"
                            IsHitTestVisible="{Binding Library.HasPinned}">
                        <StackPanel Orientation="Horizontal">
                            <PathIcon Data="{DynamicResource LibPinIcon}" />
                            <TextBlock Classes="section" Text="{loc:T Mobile.Pinned}" />
                            <PathIcon Name="PinnedChevron" Classes="chevron" Data="{DynamicResource LibChevronIcon}" IsVisible="{Binding Library.HasPinned}" />
                        </StackPanel>
                    </Button>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding Library.HasPinned}">
                        <ItemsControl Name="PinnedRail" Margin="20,0" ItemsSource="{Binding Library.PinnedRail}"
                                      ItemTemplate="{StaticResource RailTileTemplate}" ItemsPanel="{StaticResource RailPanel}" />
                    </ScrollViewer>
                    <Border Name="PinnedHint" Classes="card" Margin="20,0" Padding="16,14" IsVisible="{Binding !Library.HasPinned}">
                        <TextBlock Classes="subtle" TextWrapping="Wrap"
                                   Text="{loc:T Mobile.Home.PinnedHint}" />
                    </Border>
                </StackPanel>

                <StackPanel Name="RecentlyPlayedSection" Spacing="10" IsVisible="{Binding Library.HasShelf}">
                    <Button Name="RecentlyPlayedHeader" Classes="row section-header" Command="{Binding OpenRecentlyPlayedCommand}">
                        <StackPanel Orientation="Horizontal">
                            <PathIcon Data="{DynamicResource LibRecentlyPlayedIcon}" />
                            <TextBlock Classes="section" Text="{loc:T Mobile.RecentlyPlayed}" />
                            <PathIcon Classes="chevron" Data="{DynamicResource LibChevronIcon}" />
                        </StackPanel>
                    </Button>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl Name="RecentlyPlayedRail" Margin="20,0" ItemsSource="{Binding Library.RecentlyPlayedRail}"
                                      ItemTemplate="{StaticResource RailTileTemplate}" ItemsPanel="{StaticResource RailPanel}" />
                    </ScrollViewer>
                </StackPanel>

                <StackPanel Name="OnRepeatSection" Spacing="10" IsVisible="{Binding Library.HasOnRepeat}">
                    <Button Name="OnRepeatHeader" Classes="row section-header" Command="{Binding OpenOnRepeatCommand}">
                        <StackPanel Orientation="Horizontal">
                            <PathIcon Data="{DynamicResource LibOnRepeatIcon}" />
                            <TextBlock Classes="section" Text="{loc:T Mobile.OnRepeat}" />
                            <PathIcon Classes="chevron" Data="{DynamicResource LibChevronIcon}" />
                        </StackPanel>
                    </Button>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl Name="OnRepeatRail" Margin="20,0" ItemsSource="{Binding Library.OnRepeatRail}"
                                      ItemTemplate="{StaticResource RailTileTemplate}" ItemsPanel="{StaticResource RailPanel}" />
                    </ScrollViewer>
                </StackPanel>

                <!-- From Your Last.fm (GitHub #177): mixes of library songs only, from the charts of
                     the Last.fm account connected on this phone. Only while one is and Settings ›
                     Scrobbling › Mixes and Recommendations is on. A tile opens the mix's songs. -->
                <StackPanel Name="LastFmSection" Spacing="10" IsVisible="{Binding LastFm.IsSectionVisible}">
                    <Button Name="LastFmHeader" Classes="row section-header" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <PathIcon Data="{DynamicResource ChipSongsIcon}" />
                            <TextBlock Classes="section" Text="{loc:T Mobile.LastFm.Title}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Name="LastFmStatusLabel" Classes="subtle" Margin="20,-4,20,0" TextWrapping="Wrap"
                               Text="{Binding LastFm.Status}" IsVisible="{Binding LastFm.HasStatus}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl Name="LastFmRail" Margin="20,0" ItemsSource="{Binding LastFm.Mixes}"
                                      ItemTemplate="{StaticResource RailTileTemplate}" ItemsPanel="{StaticResource RailPanel}" />
                    </ScrollViewer>
                </StackPanel>

                <!-- Discover on Last.fm: artists and albums the library lacks. A row only opens its
                     Last.fm page in the browser. -->
                <StackPanel Name="LastFmDiscoverSection" Spacing="10" IsVisible="{Binding LastFm.IsDiscoverVisible}">
                    <Button Name="LastFmDiscoverHeader" Classes="row section-header" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <PathIcon Data="{DynamicResource ChipArtistsIcon}" />
                            <TextBlock Classes="section" Text="{loc:T Mobile.LastFm.Discover}" />
                        </StackPanel>
                    </Button>
                    <Border Classes="card" Margin="20,0" ClipToBounds="True">
                        <ItemsControl Name="LastFmDiscoverList" ItemsSource="{Binding LastFm.Discover}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LastFmDiscoverEntry">
                                    <Button Classes="row" AutomationProperties.Name="{Binding AccessibleName}"
                                            Command="{Binding $parent[views:HomePage].((vm:ShellViewModel)DataContext).LastFm.OpenDiscoverCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,10">
                                            <PathIcon Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource AccentTextExactBrush}"
                                                      Data="{DynamicResource ChipArtistsIcon}" IsVisible="{Binding !IsAlbum}" />
                                            <PathIcon Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"
                                                      Foreground="{DynamicResource AccentTextExactBrush}"
                                                      Data="{DynamicResource ChipAlbumsIcon}" IsVisible="{Binding IsAlbum}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Classes="row-title" Text="{Binding Title}" />
                                                <TextBlock Classes="row-sub" Text="{Binding Detail}" />
                                            </StackPanel>
                                            <PathIcon Grid.Column="2" Classes="list-chevron" Data="{DynamicResource LibChevronIcon}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
