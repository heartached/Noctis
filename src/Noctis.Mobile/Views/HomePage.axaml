<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:views="using:Noctis.Mobile.Views"
             xmlns:models="using:Noctis.Models"
             xmlns:controls="using:Noctis.Controls"
             xmlns:loc="using:Noctis.Localization"
             x:Class="Noctis.Mobile.Views.HomePage"
             x:DataType="vm:HomePageViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="AlbumRailTemplate" x:DataType="models:Album">
            <Button Classes="row" Width="140"
                    Command="{Binding $parent[views:HomePage].((vm:HomePageViewModel)DataContext).Shell.OpenAlbumCommand}"
                    CommandParameter="{Binding}"
                    views:LongPress.Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenAlbumSheetCommand}">
                <views:AlbumTile />
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Name="HomeHeader" ColumnDefinitions="*,Auto" Margin="20,12,12,8">
            <StackPanel>
                <TextBlock Name="HomeTitle" Classes="title" Text="{loc:T Nav.Home}" />
                <TextBlock Name="Greeting" Classes="subtle" FontSize="15" Text="{Binding Greeting}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,0,20,24" Spacing="18">
                <Border Name="HomeEmpty" Classes="card" Padding="16" IsVisible="{Binding IsEmpty}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="section" Text="Nothing here yet" />
                        <TextBlock Classes="subtle" TextWrapping="Wrap"
                                   Text="Play something and it shows up here: your last songs, the albums you've been playing and what you added recently." />
                        <Button Classes="pill-accent" Content="Go to Library"
                                Command="{Binding Shell.SelectTabCommand}" CommandParameter="{x:Static vm:MobileTab.Library}" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="4" IsVisible="{Binding HasLastPlayed}">
                    <TextBlock Classes="section" Text="Last Played" />
                    <ItemsControl Name="LastPlayedList" ItemsSource="{Binding LastPlayed}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HomeSongRow">
                                <Button Classes="row"
                                        Command="{Binding $parent[views:HomePage].((vm:HomePageViewModel)DataContext).PlayLastPlayedCommand}"
                                        CommandParameter="{Binding}"
                                        views:LongPress.Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenTrackSheetCommand}"
                                        views:LongPress.CommandParameter="{Binding Track}">
                                    <Grid ColumnDefinitions="28,Auto,*" Height="56">
                                        <TextBlock Classes="subtle" FontSize="15" FontWeight="SemiBold" Text="{Binding Number}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Classes="art" Width="44" Height="44">
                                            <Panel>
                                                <PathIcon Data="{DynamicResource SongsIcon}" Width="18" Height="18" Opacity="0.5" />
                                                <controls:CachedImage SourcePath="{Binding Track.AlbumArtworkPath}" DecodeWidth="128" Stretch="UniformToFill" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Classes="row-title" Text="{Binding Track.Title}" />
                                            <TextBlock Classes="row-sub" Text="{Binding Track.Artist}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="8" IsVisible="{Binding HasRecentlyPlayed}">
                    <TextBlock Classes="section" Text="Recently Played" />
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl Name="RecentlyPlayedRail" ItemsSource="{Binding RecentlyPlayedAlbums}" ItemTemplate="{StaticResource AlbumRailTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel Spacing="8" IsVisible="{Binding HasRecentlyAdded}">
                    <TextBlock Classes="section" Text="Recently Added" />
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl Name="RecentlyAddedRail" ItemsSource="{Binding RecentlyAddedAlbums}" ItemTemplate="{StaticResource AlbumRailTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
