<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:views="using:Noctis.Mobile.Views"
             xmlns:controls="using:Noctis.Controls"
             x:Class="Noctis.Mobile.Views.AlbumPage"
             x:DataType="vm:AlbumPageViewModel"
             Background="{Binding Tint.Background}"
             Classes.tinted="{Binding Tint.HasTint}"
             Classes.light="{Binding Tint.IsLight}">

    <!-- Text follows the theme until a cover tints the page, then white, or near-black on a
         light cover (the desktop album page's rule). Set by style, not locally, so the
         tinted classes can override it; rows are Buttons, whose presenter takes the Button's
         Foreground, hence the Button.row setters. -->
    <UserControl.Styles>
        <Style Selector="views|AlbumPage">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="views|AlbumPage.tinted">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="views|AlbumPage.tinted.light">
            <Setter Property="Foreground" Value="#111111" />
        </Style>
        <Style Selector="views|AlbumPage Button.row, views|AlbumPage Button.icon">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="views|AlbumPage.tinted Button.row, views|AlbumPage.tinted Button.icon">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="views|AlbumPage.tinted.light Button.row, views|AlbumPage.tinted.light Button.icon">
            <Setter Property="Foreground" Value="#111111" />
        </Style>
        <Style Selector="views|AlbumPage.tinted TextBlock.subtle, views|AlbumPage.tinted TextBlock.row-sub">
            <Setter Property="Foreground" Value="#B0FFFFFF" />
        </Style>
        <Style Selector="views|AlbumPage.tinted.light TextBlock.subtle, views|AlbumPage.tinted.light TextBlock.row-sub">
            <Setter Property="Foreground" Value="#80000000" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Classes="page-scroll" Name="AlbumScroll" views:ScrollMemory.IsEnabled="True" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,24">
            <Button Classes="icon" Margin="8,4,0,0" HorizontalAlignment="Left" Command="{Binding Shell.NavigateBackCommand}">
                <PathIcon Data="{DynamicResource ChevronLeftIcon}" />
            </Button>

            <Viewbox Margin="48,4,48,0" MaxWidth="340" Stretch="Uniform">
                <Border Classes="art" Width="300" Height="300" CornerRadius="12">
                    <Panel>
                        <PathIcon Name="ArtPlaceholder" Data="{DynamicResource AlbumsIcon}" Width="72" Height="72" Opacity="0.4"
                                  IsVisible="{Binding !HasArtwork}" />
                        <controls:CachedImage Name="AlbumArt" SourcePath="{Binding Album.ArtworkPath}" DecodeWidth="768"
                                              ClearOnSourceChange="False" Stretch="UniformToFill" />
                    </Panel>
                </Border>
            </Viewbox>

            <TextBlock Name="AlbumTitle" Text="{Binding Album.Name}" FontSize="22" FontWeight="Bold"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="24,16,24,0" />
            <Button Name="ArtistLink" Classes="row" HorizontalAlignment="Center" Command="{Binding OpenArtistCommand}">
                <TextBlock Text="{Binding Album.Artist}" FontSize="17" TextAlignment="Center" Margin="0,2" />
            </Button>
            <TextBlock Name="MetaLine" Classes="subtle" Text="{Binding MetaLine}" HorizontalAlignment="Center"
                       IsVisible="{Binding HasMetaLine}" />

            <Grid ColumnDefinitions="*,Auto,Auto,Auto,*" Margin="0,16,0,8">
                <Button Grid.Column="1" Name="ShuffleButton" Classes="round" Command="{Binding ShuffleCommand}">
                    <PathIcon Data="{DynamicResource ShuffleIcon}" />
                </Button>
                <Button Grid.Column="2" Name="PlayButton" Classes="pill-accent" Margin="16,0" MinWidth="140"
                        HorizontalContentAlignment="Center" Command="{Binding PlayCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{DynamicResource PlayIcon}" Width="14" Height="14" />
                        <TextBlock Text="Play" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Name="MoreButton" Classes="round" Command="{Binding MoreCommand}">
                    <PathIcon Data="{DynamicResource MoreDotsIcon}" />
                </Button>
            </Grid>

            <!-- Virtualised like the other lists: a box set would otherwise realise every row at
                 page open. The panel still virtualises under the header, inside AlbumScroll,
                 because VirtualizingStackPanel works from the effective viewport. -->
            <ItemsControl Name="TrackList" ItemsSource="{Binding Tracks}" Margin="12,8,12,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlbumTrackRow">
                        <Button Classes="row"
                                Command="{Binding $parent[views:AlbumPage].((vm:AlbumPageViewModel)DataContext).PlayTrackCommand}"
                                CommandParameter="{Binding}"
                                views:LongPress.Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenTrackSheetCommand}"
                                views:LongPress.CommandParameter="{Binding Track}">
                            <Grid ColumnDefinitions="36,*,Auto,Auto" Height="52" Margin="8,0">
                                <TextBlock Classes="subtle" Text="{Binding Number}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="row-title" Text="{Binding Track.Title}" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Classes="explicit" IsVisible="{Binding Track.IsExplicit}">
                                    <TextBlock Text="E" />
                                </Border>
                                <Button Grid.Column="3" Classes="icon" Width="36" Height="36"
                                        Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenTrackSheetCommand}"
                                        CommandParameter="{Binding Track}">
                                    <PathIcon Data="{DynamicResource MoreDotsIcon}" Width="16" Height="16" />
                                </Button>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Name="Footer" Classes="subtle" Text="{Binding FooterText}" Margin="20,16,20,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
