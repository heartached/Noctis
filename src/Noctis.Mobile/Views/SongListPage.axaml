<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:views="using:Noctis.Mobile.Views"
             xmlns:models="using:Noctis.Models"
             xmlns:controls="using:Noctis.Controls"
             x:Class="Noctis.Mobile.Views.SongListPage"
             x:DataType="vm:SongListPageViewModel">
    <Grid Name="PageGrid" RowDefinitions="Auto,Auto,*">
        <!-- The shared header (PageHeader, the Artists page's look): "‹ Library" with the tools'
             pill at its right, the large title below. Embedded (the Favorites tab), the tab's own
             header carries the title and the same pill. Select mode's bar (Select All,
             "3 Selected", Done) takes the back row's place; the title stays. -->
        <views:PageHeader Grid.Row="0" Name="Header" IsVisible="{Binding !IsEmbedded}" IsNavHidden="{Binding Selection.IsActive}">
            <views:PageHeader.Tools>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <views:ListTools VerticalAlignment="Center" />
                    <!-- A playlist's page: its ⋯ in a round glass button (Apple's), the playlist's menu with
                         Rename and Delete Playlist. Shown on an empty playlist too, where the tools are not. -->
                    <controls:GlassPanel Classes="header-glass" IsVisible="{Binding IsPlaylist}">
                        <Button Name="PlaylistMoreButton" Classes="glass-round" Command="{Binding ShowPlaylistMenuCommand}"
                                AutomationProperties.Name="{loc:T Mobile.More}">
                            <PathIcon Data="{DynamicResource PhMore}" />
                        </Button>
                    </controls:GlassPanel>
                </StackPanel>
            </views:PageHeader.Tools>
        </views:PageHeader>
        <views:SelectionHeader Grid.Row="0" Name="SelectBar" DataContext="{Binding Selection}" Margin="16,4,16,8" VerticalAlignment="Top" />

        <!-- The list's search (the Artists page's field, FindField), then Play and Shuffle, which
             play what the list shows (the header's pill sorts and filters it); the count says
             how much of the list that is. A playlist's page moves it into the scroller under the
             cover (SongListPage.axaml.cs), so it scrolls away with the cover. -->
        <StackPanel Grid.Row="1" Name="ListTop" IsVisible="{Binding HasSongs}">
            <views:FindField Name="ListFindField" Text="{Binding FilterText}" Placeholder="{loc:T Mobile.SongList.Find}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="20,0,20,8">
                <Button Classes="pill-accent" Command="{Binding PlayAllCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{DynamicResource PhPlayFill}" Width="20" Height="20" />
                        <TextBlock Text="{loc:T Mobile.Play}" />
                    </StackPanel>
                </Button>
                <Button Classes="pill" Command="{Binding ShuffleAllCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{DynamicResource PhShuffle}" Width="20" Height="20" />
                        <TextBlock Text="{loc:T Mobile.Shuffle}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <!-- Its own line: the toolbar has no room left for it on a phone. -->
            <TextBlock Name="CountLabel" Classes="subtle" FontSize="13" Margin="22,0,20,4" Text="{Binding CountText}" />
        </StackPanel>

        <ScrollViewer Classes="page-scroll" Grid.Row="2" Name="SongScroll" views:ScrollMemory.IsEnabled="True" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Name="ScrollBody">
                <!-- A playlist's page: its cover over the list, the album page's artwork look (the
                     rounded art square, the placeholder glyph under it), centred; sized from the
                     page's width (SongListPage.axaml.cs). Custom cover first, else what the
                     playlist's tiles show. -->
                <Border Name="PlaylistCover" Classes="art" CornerRadius="10" IsVisible="{Binding IsPlaylist}" HorizontalAlignment="Center"
                        Width="240" Height="240" Margin="0,4,0,16">
                    <Panel>
                        <PathIcon Name="PlaylistCoverPlaceholder" Data="{DynamicResource PlaylistsIcon}" Width="72" Height="72" Opacity="0.4" />
                        <controls:CachedImage Name="PlaylistCoverArt" SourcePath="{Binding CoverPath}" DecodeWidth="1024" Stretch="UniformToFill" />
                    </Panel>
                </Border>
                <TextBlock Name="EmptyText" Classes="subtle" Text="{Binding EmptyText}" HorizontalAlignment="Center"
                           Margin="0,40,0,0" IsVisible="{Binding ShowEmpty}" />
                <views:RowItemsControl Name="SongList" ItemsSource="{Binding Songs}" Margin="12,0,12,16">
                    <views:RowItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </views:RowItemsControl.ItemsPanel>
                    <views:RowItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <!-- The row's ⋯ and a long press: the page's song menu (on a playlist's page
                                 it offers Remove from Playlist; Select starts Select mode). In Select mode
                                 the check circle leads the row, a tap ticks it and the ⋯ steps aside. -->
                            <Button Classes="row"
                                    views:LongPress.Command="{Binding $parent[views:SongListPage].((vm:SongListPageViewModel)DataContext).OpenSongMenuCommand}"
                                    Command="{Binding $parent[views:SongListPage].((vm:SongListPageViewModel)DataContext).PlayCommand}"
                                    CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <views:SelectCheck Name="RowCheck" Margin="8,0,-8,0" Track="{Binding}"
                                                       Selection="{Binding $parent[views:SongListPage].((vm:SongListPageViewModel)DataContext).Selection}" />
                                    <views:SongRow Grid.Column="1"
                                                   MenuCommand="{Binding $parent[views:SongListPage].((vm:SongListPageViewModel)DataContext).OpenSongMenuCommand}"
                                                   IsMenuVisible="{Binding !$parent[views:SongListPage].((vm:SongListPageViewModel)DataContext).Selection.IsActive}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </views:RowItemsControl.ItemTemplate>
                </views:RowItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
