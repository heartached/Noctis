<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:views="using:Noctis.Mobile.Views"
             xmlns:models="using:Noctis.Models"
             x:Class="Noctis.Mobile.Views.SongListPage"
             x:DataType="vm:SongListPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="8,4,20,0" IsVisible="{Binding !IsEmbedded}">
            <Button Classes="icon" Command="{Binding Shell.NavigateBackCommand}">
                <PathIcon Data="{DynamicResource ChevronLeftIcon}" />
            </Button>
            <TextBlock Grid.Column="1" Classes="title" FontSize="26" Text="{Binding Title}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="20,8,20,8" IsVisible="{Binding HasSongs}">
            <Button Classes="pill-accent" Command="{Binding PlayAllCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{DynamicResource PlayIcon}" Width="14" Height="14" />
                    <TextBlock Text="Play" />
                </StackPanel>
            </Button>
            <Button Classes="pill" Command="{Binding ShuffleAllCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{DynamicResource ShuffleIcon}" Width="14" Height="14" />
                    <TextBlock Text="Shuffle" />
                </StackPanel>
            </Button>
            <TextBlock Classes="subtle" VerticalAlignment="Center" Text="{Binding CountText}" />
        </StackPanel>

        <TextBlock Grid.Row="2" Name="EmptyText" Classes="subtle" Text="No songs" HorizontalAlignment="Center"
                   Margin="0,40,0,0" IsVisible="{Binding !HasSongs}" />

        <ScrollViewer Classes="page-scroll" Grid.Row="2" Name="SongScroll" views:ScrollMemory.IsEnabled="True" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="SongList" ItemsSource="{Binding Songs}" Margin="12,0,12,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Button Classes="row"
                                views:LongPress.Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenTrackSheetCommand}"
                                Command="{Binding $parent[views:SongListPage].((vm:SongListPageViewModel)DataContext).PlayCommand}"
                                CommandParameter="{Binding}">
                            <views:SongRow />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
